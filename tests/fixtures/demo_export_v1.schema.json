{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hadavin:demo-export:1",
  "title": "hadavin.demo-export/1",
  "description": "Frozen console input of the Hadavin demos. Unknown keys are rejected. Money = integer string in minor units plus ISO-4217 currency (inside args/evidence). Time is UTC.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "banner", "demo", "run", "cases", "approvals", "audit", "adapter_calls", "scorecard", "registry", "honesty"],
  "properties": {
    "schema": {"const": "hadavin.demo-export/1"},
    "banner": {"const": "prototype, sample data"},
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "version", "core_commit", "kit_commit"],
      "properties": {
        "slug": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 40},
        "core_commit": {"$ref": "#/$defs/commit"},
        "kit_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "ts", "model", "mode", "prompt_sha256", "config_hash", "dataset_sha256", "seed", "level"],
      "properties": {
        "run_id": {"$ref": "#/$defs/slug"},
        "ts": {"$ref": "#/$defs/ts"},
        "model": {"type": "string", "minLength": 1, "maxLength": 120},
        "mode": {"enum": ["scripted", "live"]},
        "prompt_sha256": {"$ref": "#/$defs/hex64"},
        "config_hash": {"$ref": "#/$defs/hex64"},
        "dataset_sha256": {"$ref": "#/$defs/hex64"},
        "seed": {"type": "integer", "minimum": 0},
        "level": {"enum": ["shadow", "suggest"]}
      }
    },
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain", "events", "verify"],
      "properties": {
        "chain": {"const": "hash-chain/1"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/audit_event"}},
        "verify": {
          "type": "object",
          "additionalProperties": false,
          "required": ["events", "matched", "ok", "text"],
          "properties": {
            "events": {"type": "integer", "minimum": 0},
            "matched": {"type": "integer", "minimum": 0},
            "ok": {"type": "boolean"},
            "text": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "adapter_calls": {"type": "array", "items": {"$ref": "#/$defs/adapter_call"}},
    "scorecard": {"$ref": "#/$defs/scorecard"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "owner_role", "level", "tools", "readiness"],
      "properties": {
        "agent_id": {"$ref": "#/$defs/slug"},
        "owner_role": {"$ref": "#/$defs/text"},
        "level": {"enum": ["shadow", "suggest"]},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "risk", "needs_approval", "rules"],
            "properties": {
              "name": {"$ref": "#/$defs/text"},
              "risk": {"enum": ["read", "draft", "money"]},
              "needs_approval": {"type": "boolean"},
              "rules": {"type": "array", "items": {"$ref": "#/$defs/text"}}
            }
          }
        },
        "readiness": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "status", "evidence"],
            "properties": {
              "check": {"$ref": "#/$defs/text"},
              "status": {"enum": ["pass", "fail", "na"]},
              "evidence": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "honesty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic", "adapters", "notes"],
      "properties": {
        "synthetic": {"const": true},
        "adapters": {"const": "fake"},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "maxLength": 2000},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
    "commit": {"type": "string", "pattern": "^([0-9a-f]{7,40}|uncommitted)$"},
    "hex64": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "usd": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "bucket", "split", "input_summary", "expected", "outcome", "correct", "wrong_confident", "hard_zero_flags", "steps", "approval_id", "audit_event_ids"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+-[ehta]-[0-9]{3}$"},
        "bucket": {"enum": ["easy", "hard", "trap", "abstain"]},
        "split": {"enum": ["dev", "test"]},
        "input_summary": {"$ref": "#/$defs/text"},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "checks"],
          "properties": {
            "outcome": {"enum": ["act", "abstain", "refuse"]},
            "checks": {"type": "array", "items": {"$ref": "#/$defs/text"}}
          }
        },
        "outcome": {"enum": ["proposed", "approved", "rejected", "auto_allowed", "blocked", "abstained", "failed", "unknown"]},
        "correct": {"type": "boolean"},
        "wrong_confident": {"type": "boolean"},
        "hard_zero_flags": {"type": "array", "items": {"$ref": "#/$defs/slug"}},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "approval_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]{0,79}$"},
        "audit_event_ids": {"type": "array", "items": {"$ref": "#/$defs/slug"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "kind", "name", "args_summary", "rule_id", "decision", "reason", "confidence", "ms", "cost_usd", "source_value", "model_value"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["model", "tool", "gate", "approval", "adapter"]},
        "name": {"$ref": "#/$defs/text"},
        "args_summary": {"type": "object"},
        "rule_id": {"type": ["string", "null"], "pattern": "^R-[A-Z0-9]+-[0-9]{3}$"},
        "decision": {"enum": ["allow", "deny", "needs_approval", null]},
        "reason": {"$ref": "#/$defs/text"},
        "confidence": {"type": "object"},
        "ms": {"type": "integer", "minimum": 0},
        "cost_usd": {"$ref": "#/$defs/usd"},
        "source_value": {"$ref": "#/$defs/scalar"},
        "model_value": {"$ref": "#/$defs/scalar"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "case_id", "action", "args", "idempotency_key", "tier", "rule_id", "evidence", "requested_at", "status", "approvers", "executed"],
      "properties": {
        "approval_id": {"$ref": "#/$defs/slug"},
        "case_id": {"type": "string", "pattern": "^[a-z0-9]+-[ehta]-[0-9]{3}$"},
        "action": {"$ref": "#/$defs/text"},
        "args": {"type": "object"},
        "idempotency_key": {"$ref": "#/$defs/hex64"},
        "tier": {"enum": ["auto", "human", "four_eyes", "blocked"]},
        "rule_id": {"type": "string", "pattern": "^R-[A-Z0-9]+-[0-9]{3}$"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {"label": {"$ref": "#/$defs/text"}, "value": {"$ref": "#/$defs/text"}}
          }
        },
        "requested_at": {"$ref": "#/$defs/ts"},
        "status": {"enum": ["pending", "approved", "rejected", "expired"]},
        "approvers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "decision", "ts", "sig_ok"],
            "properties": {
              "role": {"$ref": "#/$defs/text"},
              "decision": {"enum": ["approve", "reject"]},
              "ts": {"$ref": "#/$defs/ts"},
              "sig_ok": {"type": "boolean"}
            }
          }
        },
        "executed": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["port", "call_id", "result", "ts"],
          "properties": {
            "port": {"$ref": "#/$defs/text"},
            "call_id": {"$ref": "#/$defs/slug"},
            "result": {"enum": ["ok", "error", "duplicate_ignored", "unknown"]},
            "ts": {"$ref": "#/$defs/ts"}
          }
        }
      }
    },
    "audit_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "event_id", "ts", "type", "actor", "case_id", "summary", "prev_sha256", "sha256"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "event_id": {"$ref": "#/$defs/slug"},
        "ts": {"$ref": "#/$defs/ts"},
        "type": {"enum": ["intent", "gate", "approval", "outcome", "adapter_call", "deny"]},
        "actor": {"type": "string", "pattern": "^(agent|system|human:[a-z0-9_-]{1,40})$"},
        "case_id": {"type": "string", "pattern": "^([a-z0-9]+-[ehta]-[0-9]{3})?$"},
        "summary": {"$ref": "#/$defs/text"},
        "prev_sha256": {"$ref": "#/$defs/hex64"},
        "sha256": {"$ref": "#/$defs/hex64"}
      }
    },
    "adapter_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "port", "op", "idempotency_key", "ts", "outcome", "fault"],
      "properties": {
        "call_id": {"$ref": "#/$defs/slug"},
        "port": {"$ref": "#/$defs/text"},
        "op": {"$ref": "#/$defs/text"},
        "idempotency_key": {"$ref": "#/$defs/hex64"},
        "ts": {"$ref": "#/$defs/ts"},
        "outcome": {"enum": ["applied", "duplicate_ignored", "fault_injected"]},
        "fault": {"type": ["string", "null"], "maxLength": 200}
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["split", "label", "n", "n_answered", "pass_rate", "k", "pass_k", "confident_wrong", "false_abstain", "wrong_and_allowed", "coverage", "abstention", "hard_zeros", "hard_zero_defs", "verdict", "verdict_text", "thresholds", "cost_usd", "latency_ms", "disclaimer", "lock_sha256"],
      "properties": {
        "split": {"enum": ["dev", "test"]},
        "label": {"type": "string", "maxLength": 40},
        "n": {"type": "integer", "minimum": 0},
        "n_answered": {"type": "integer", "minimum": 0},
        "pass_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "k": {"type": "integer", "minimum": 1},
        "pass_k": {"$ref": "#/$defs/rate"},
        "confident_wrong": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "n_answered", "rate", "upper_bound", "items"],
          "properties": {
            "x": {"type": "integer", "minimum": 0},
            "n_answered": {"type": "integer", "minimum": 0},
            "rate": {"$ref": "#/$defs/rate"},
            "upper_bound": {"$ref": "#/$defs/rate"},
            "items": {"type": "array", "items": {"type": "string"}}
          }
        },
        "false_abstain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "n_should_answer", "rate"],
          "properties": {
            "x": {"type": "integer", "minimum": 0},
            "n_should_answer": {"type": "integer", "minimum": 0},
            "rate": {"$ref": "#/$defs/rate"}
          }
        },
        "wrong_and_allowed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "n"],
          "properties": {"x": {"type": "integer", "minimum": 0}, "n": {"type": "integer", "minimum": 0}}
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answered_correct", "definite"],
          "properties": {"answered_correct": {"type": "integer", "minimum": 0}, "definite": {"type": "integer", "minimum": 0}}
        },
        "abstention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["precision", "recall"],
          "properties": {"precision": {"$ref": "#/$defs/rate"}, "recall": {"$ref": "#/$defs/rate"}}
        },
        "hard_zeros": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "hard_zero_defs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "meaning"],
            "properties": {"key": {"$ref": "#/$defs/slug"}, "meaning": {"$ref": "#/$defs/text"}}
          }
        },
        "verdict": {"enum": ["green", "amber", "not_demonstrated", "aborted"]},
        "verdict_text": {"$ref": "#/$defs/text"},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["green_max_upper", "amber_max_upper"],
          "properties": {
            "green_max_upper": {"type": "number", "minimum": 0, "maximum": 1},
            "amber_max_upper": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "cost_usd": {"$ref": "#/$defs/usd"},
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95"],
          "properties": {"p50": {"type": "integer", "minimum": 0}, "p95": {"type": "integer", "minimum": 0}}
        },
        "disclaimer": {"$ref": "#/$defs/text"},
        "lock_sha256": {"$ref": "#/$defs/hex64"}
      }
    }
  }
}
