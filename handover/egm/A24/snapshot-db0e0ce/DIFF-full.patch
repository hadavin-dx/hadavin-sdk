+/tools/scan_suppressions.txt @veerarakesh56
+/tools/scan_allowlist.txt @veerarakesh56
+/tools/scan_banned_extra.txt @veerarakesh56
+/tests/fixtures/*golden* @veerarakesh56
+/.github/ @veerarakesh56
+/.gitleaks* @veerarakesh56
+/tests/test_scan_repo.py @veerarakesh56
+/tests/test_scan_repo_mutations.py @veerarakesh56
+/tests/test_ci_gitleaks_scope.py @veerarakesh56
+/tests/test_ci_toolpath_step.py @veerarakesh56
+/pyproject.toml @veerarakesh56
