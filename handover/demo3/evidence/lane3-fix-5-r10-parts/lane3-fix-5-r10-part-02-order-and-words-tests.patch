+_READ_PID_FILE = re.compile(r"^read_pid_file\(\) \{\n.*?^\}\n", re.M | re.S)
+
+
+def _read_pid_file_result(path: Path) -> str:
+    """Run reset.sh's read_pid_file alone under a UTF-8 setting and return what it leaves in $pid."""
+    match = _READ_PID_FILE.search((REPO / "scripts" / SH).read_text(encoding="utf-8"))
+    assert match, "read_pid_file is not in reset.sh"
+    bash = _utf8_bash() or "bash"
+    done = subprocess.run(  # noqa: S603 (a fixed bash line, the path is an argument)
+        [bash, "-c", match.group(0) + 'read_pid_file "$1"; printf "%s" "$pid"', "bash", str(path)],
+        env={**os.environ, "LC_ALL": "C.UTF-8"},
+        capture_output=True,
+        check=False,
+    )
+    assert done.returncode == 0, done.stderr
+    return done.stdout.decode("latin-1")
+
