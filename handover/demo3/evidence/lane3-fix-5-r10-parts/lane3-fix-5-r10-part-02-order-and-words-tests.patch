+@_posix
+@pytest.mark.parametrize("name", ["reset.sh", "start_all.sh"])
+def test_the_guard_line_refuses_a_shell_that_runs_double_brackets_but_has_no_bash_version_info(name: str) -> None:
+    """zsh and busybox ash run `[[ ]]` but are not bash (neither is installed here). The guard's own test line is run in
+    bash with the variable name replaced by one that does not exist: it must say no."""
+    text = (REPO / "scripts" / name).read_text(encoding="utf-8")
+    line = next(row for row in text.splitlines() if row.startswith("case ") and "bash)" in row)
+    inner = re.search(r"eval '([^']*)'", line)
+    assert inner is not None
+    probe = (
+        f"(eval '{inner.group(1).replace('BASH_VERSINFO', 'NO_SUCH_VARIABLE')}') 2>/dev/null && echo bash || echo no"
+    )
+    done = subprocess.run(  # noqa: S603 (a fixed bash line)
+        [shutil.which("bash") or "bash", "-c", probe], capture_output=True, text=True, check=False
+    )
+    assert done.stdout.strip() == "no", done.stdout
