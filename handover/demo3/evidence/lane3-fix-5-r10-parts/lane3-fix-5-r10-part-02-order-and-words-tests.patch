+def _utf8_bash() -> str | None:
+    """A bash whose UTF-8 setting counts the ideographic space (U+3000) as one space character, or None."""
+    bash = shutil.which("bash") or "bash"
+    probe = subprocess.run(  # noqa: S603 (a fixed bash line)
+        [bash, "-c", "[[ $'\\u3000' == [[:space:]] ]] && echo yes"],
+        env={**os.environ, "LC_ALL": "C.UTF-8"},
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return bash if probe.stdout.strip() == "yes" else None
+
+
+_UTF8_BASH_MISSING = (
+    "this bash has no UTF-8 setting that treats the ideographic space as a space (the two readings cannot differ)"
+)
+# a skip is a failure in the stack run (DPLD_REQUIRE_SCAN=1), as a missing gitleaks is: the locale tests must run there
+_NEEDS_UTF8_BASH = pytest.mark.skipif(
+    WINDOWS or (_utf8_bash() is None and os.environ.get("DPLD_REQUIRE_SCAN") != "1"), reason=_UTF8_BASH_MISSING
+)
+
+
+@_posix
+@pytest.mark.skipif(
+    os.environ.get("DPLD_REQUIRE_SCAN") != "1", reason="only the stack run (DPLD_REQUIRE_SCAN=1) needs this"
+)
+def test_the_stack_run_has_a_bash_with_a_utf8_setting_so_the_locale_tests_run() -> None:
+    assert _utf8_bash() is not None, _UTF8_BASH_MISSING
+
+
+@_posix
+@_NEEDS_UTF8_BASH
+@pytest.mark.parametrize("r", [0, 1, 2])
+def test_reset_sh_counts_bytes_not_characters_of_the_pid_file_whatever_the_language_setting(book: Path, r: int) -> None:
+    """The desk's own number, plain spaces (3 more for each step of r; the base count is chosen
+    so that the 67-byte cut falls between two characters, whatever the digit count of the number; the old test passed
+    or failed by pid luck). In a UTF-8 setting that counts characters the file would trim to the desk's number and
+    stop it; the script reads, counts and trims in the C locale (64 bytes or more is stale) and stops nothing."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    number = str(desk.pid)
+    content = number.encode() + b" " * ((67 - len(number)) % 3 + 3 * r) + "\u3000".encode() * 30
+    (book.parent / "desk.pid").write_bytes(content)
+    try:
+        done = reset_run(SH, book, LC_ALL="C.UTF-8", **reset_ports())
+        still_running = desk.poll() is None
+        returncode = desk.returncode
+    finally:
+        _end(desk)
+    assert done.returncode == 0 and still_running, (
+        done.returncode,
+        still_running,
+        returncode,
+        len(content),
+        done.stdout,
+        done.stderr,
+    )
+    assert not (book.parent / "desk.pid").exists()
+
