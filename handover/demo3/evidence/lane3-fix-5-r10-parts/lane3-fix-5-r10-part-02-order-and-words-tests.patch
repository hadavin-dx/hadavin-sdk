+@_posix
+def test_reset_sh_refuses_with_exit_5_and_keeps_every_file_when_it_may_not_signal_the_desk(book: Path) -> None:
+    """End to end: the desk stand-in belongs to this user (root), reset.sh runs as user 65534 and its kill is refused.
+    The desk must not read as stopped: exit 5 "did not stop in time", the desk still runs, nothing is deleted."""
+    if not _as_nobody_can_run_bash():
+        pytest.skip("cannot run as user 65534 here (no setpriv, or kill -0 on process 1 is not refused for it)")
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    for folder in (book.parent.parent, book.parent, book.parent / "stub-tree"):
+        folder.chmod(0o755)  # user 65534 must be able to read them
+    try:
+        done = subprocess.run(  # noqa: S603 (setpriv and this repository's script)
+            [*_NOBODY, "bash", str(REPO / "scripts" / SH)],
+            cwd=REPO,
+            env={
+                **os.environ,
+                **reset_ports(),
+                "DESK_DB_PATH": str(book),
+                "RESET_STOP_WAIT_SECONDS": "1",
+                "PATH": str(Path(sys.executable).parent) + os.pathsep + os.environ["PATH"],
+                "PYTHONDONTWRITEBYTECODE": "1",
+            },
+            capture_output=True,
+            text=True,
+            timeout=120,
+            check=False,
+        )
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert done.returncode == 5 and "did not stop in time" in done.stderr, (done.returncode, done.stdout, done.stderr)
+    assert still_running and (book.parent / "desk.pid").exists() and reset_kept(book)
