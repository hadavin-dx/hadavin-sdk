+@_posix
+def test_reset_sh_treats_a_process_that_ends_during_the_look_as_stopped_not_as_another_program(
+    book: Path, tmp_path: Path
+) -> None:
+    """Pass 2 looks at the desk (alive), reads its command line, and looks again before it says "another program". A
+    stand-in `ps` kills the desk during the first look (the first `ps -p ... -o stat=`) and answers "S": the command
+    line is then empty, so it is not the desk any more. The second look must find it ended (Z) and go on: exit 0, the
+    pid file deleted, no "another program" line. Without the second look the old text refused with exit 6."""
+    real_ps = shutil.which("ps")
+    if real_ps is None:
+        pytest.skip("ps is not installed")
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    folder = tmp_path / "bin"
+    folder.mkdir()
+    fake = folder / "ps"
+    fake.write_text(
+        "#!/usr/bin/env bash\n"
+        f'state="{folder}/first-look"\n'
+        'if [[ "$*" == *"-o stat="* && ! -e "$state" ]]; then\n'
+        '  : > "$state"; kill -9 "$2"; sleep 0.3; echo S; exit 0\n'
+        "fi\n"
+        f'exec "{real_ps}" "$@"\n',
+        encoding="utf-8",
+    )
+    fake.chmod(0o755)
+    try:
+        done = reset_run(SH, book, first_on_path=folder, **reset_ports())
+        killed = desk.wait(timeout=10)
+    finally:
+        _end(desk)
+    assert (folder / "first-look").exists(), "the stand-in ps never saw the first look"
+    assert killed == -9
+    assert done.returncode == 0, (done.returncode, done.stdout, done.stderr)
+    assert "another program" not in done.stderr and not (book.parent / "desk.pid").exists()
+
