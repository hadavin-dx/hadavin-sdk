+@_posix
+def test_reset_sh_keeps_the_utf16_pid_file_of_a_running_desk_when_the_port_check_refuses(book: Path) -> None:
+    """A pid file saved as UTF-16 is stale (nothing is stopped for it). The desk it names really runs and holds the
+    port: exit 4, the desk still runs, and the pid file is kept as the only clue (the old order deleted it first)."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_bytes(str(desk.pid).encode("utf-16"))
+    try:
+        with bound_socket() as listener:
+            listener.listen(1)
+            done = reset_run(SH, book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert done.returncode == 4 and still_running, (done.returncode, done.stdout, done.stderr)
+    assert pidfile.exists() and reset_kept(book)
