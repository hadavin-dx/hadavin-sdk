+"""Port numbers for tests, without any import of the demo folder (so a test file that is not about the demo can use
+it, and the removable demo folder stays removable). support.py re-exports these names."""
+
+from __future__ import annotations
+
+import os
+import re
+import secrets
+import socket
+
+from lead_desk.config import Config
+
+HOST = Config().bind  # the one definition of the loopback host for tests (support.py imports it)
+_ATTEMPTS = 100  # how often a number is asked for again when the operating system hands out one that is taken
+
+_RANGE_START = 20000  # xdist workers draw their port numbers from 20000 up, one block each (see worker_port_range)
+_RANGE_END = 32767  # below 32768, where Linux starts its own numbers (Windows, macOS: 49152)
+_RANGE_WIDTH = 5000  # widest block of one worker (narrower when there are more workers)
+_HALF = (_RANGE_END - _RANGE_START + 1) // 2  # first half: the workers xdist starts first; second half: restarted ones
+_SLICES = 16  # most parts a block is cut into, one part per process number remainder (see session_window)
+_MIN_SLICE = 32  # a part is never narrower than this many numbers
+_MAX_WORKERS = 256  # a count above this (or a missing count) is treated as this many: the blocks stay disjoint
+
+
+def worker_port_range(worker: str | None, count: str | None) -> tuple[int, int] | None:
+    """The block of port numbers (first, last) that xdist worker `worker` ("gw0", "gw1", ...) draws from, or None when
+    the tests run in one process (then the operating system chooses, as before).
+    `count` is PYTEST_XDIST_WORKER_COUNT. The width is the same for every worker of a run (it depends on the count
+    only), so no block depends on which worker asks. Workers 0 to count-1 get the first half, one block each. When a
+    worker dies xdist starts gw<count>, gw<count+1> ...: those get the second half, block (number - count) mod count, so
+    a restarted worker never overlaps a first worker that is still alive. Two restarted workers share a block only when
+    one of them outlives `count` later restarts. A missing or odd count is treated as the largest supported count."""
+    found = re.fullmatch(r"gw(\d+)", worker or "")
+    if found is None:
+        return None
+    number = int(found.group(1))
+    total = int(count) if count and count.isdigit() and int(count) > 0 else _MAX_WORKERS
+    total = min(total, _MAX_WORKERS)
+    width = min(_RANGE_WIDTH, _HALF // total)
+    if number < total:
+        first = _RANGE_START + number * width
+    else:
+        first = _RANGE_START + _HALF + ((number - total) % total) * width
+    return first, first + width - 1
+
+
+def session_window(block: tuple[int, int], pid: int) -> tuple[int, int]:
+    """The part of a worker's block that the process with number `pid` draws from. Two pytest runs on one machine
+    both have a gw0 with the same block; the block is cut into up to 16 equal parts (none narrower than 32 numbers) and
+    a process uses part pid % parts, so two runs share a part only when their process numbers are equal modulo the
+    number of parts. A block too narrow to cut (many workers) is used whole."""
+    first, last = block
+    width = last - first + 1
+    parts = max(1, min(_SLICES, width // _MIN_SLICE))
+    size = width // parts
+    index = pid % parts
+    low = first + index * size
+    return low, (last if index == parts - 1 else low + size - 1)
+
+
+def _draw(window: tuple[int, int]) -> socket.socket | None:
+    for _ in range(_ATTEMPTS * 5):
+        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        try:
+            s.bind((HOST, window[0] + secrets.randbelow(window[1] - window[0] + 1)))
+        except OSError:
+            s.close()
+            continue
+        return s
+    return None
+
+
+def bound_socket() -> socket.socket:
+    """A socket bound to a number the operating system chose (bind to port 0); it does not listen. Under xdist the
+    number is drawn from this worker's own block instead (worker_port_range); a number that is taken is skipped."""
+    block = worker_port_range(os.environ.get("PYTEST_XDIST_WORKER"), os.environ.get("PYTEST_XDIST_WORKER_COUNT"))
+    if block is None:
+        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+        s.bind((HOST, 0))  # the one place that binds to port 0 (checked in test_port_helpers.py)
+        return s
+    # this process's part of the block first (two runs at once rarely meet), then the whole block
+    for window in (session_window(block, os.getpid()), block):
+        s = _draw(window)
+        if s is not None:
+            return s
+    raise AssertionError(f"no free port number in {block[0]}-{block[1]}")
