+def test_no_test_binds_to_port_0_by_itself_except_the_listed_servers_that_keep_their_socket() -> None:
+    """A bind to port 0 that is closed and bound again later (free_port) gets a number that no worker block knows
+    about, so tests ask bound_socket() (or free_port() / held_port()). The only direct sites left are servers that keep
+    their own socket; each file is listed with its count and the reason, so a new site fails here."""
+    found = _direct_sites()
+    surplus = {name: lines for name, lines in found.items() if name not in _ALLOWED_SITES}
+    assert not surplus, f"direct binds to port 0 (use bound_socket, or list them with a reason): {surplus}"
+    for name, (count, reason) in _ALLOWED_SITES.items():
+        assert len(found.get(name, [])) == count, (name, count, found.get(name))
+        assert reason and len(reason) > 40, name
+
+
+_HOSTISH = re.compile(r"host|addr|bind|^ip$|^loopback$", re.IGNORECASE)
+_ALL_INTERFACES = ".".join(["0"] * 4)  # text to recognise, built from parts; nothing is bound
+_HOST_TEXTS = {"", "localhost", "::1", "::", _ALL_INTERFACES}
+
+
+def _hostish(node: ast.AST) -> bool:
+    """The first part of a (host, port) pair: a name or attribute that says host/address (HOST, self.host, cfg.HOST), or
+    a text that is an address (127.0.0.1, localhost, ::1, the empty text)."""
+    if isinstance(node, ast.Name):
+        return bool(_HOSTISH.search(node.id))
+    if isinstance(node, ast.Attribute):
+        return bool(_HOSTISH.search(node.attr))
+    if isinstance(node, ast.Constant) and isinstance(node.value, str):
+        return node.value in _HOST_TEXTS or bool(re.fullmatch(r"\d{1,3}(\.\d{1,3}){3}", node.value))
+    return False
+
+
+def _is_zero_port_pair(node: ast.AST) -> bool:
+    """(host, 0): a pair whose second part is the number 0 and whose first part says host or is an address."""
+    return (
+        isinstance(node, ast.Tuple)
+        and len(node.elts) == 2
+        and isinstance(node.elts[1], ast.Constant)
+        and node.elts[1].value == 0
+        and type(node.elts[1].value) is int
+        and _hostish(node.elts[0])
+    )
+
+
+def _ast_sites(text: str) -> list[int]:
+    """The class, not the line shape. Counted (once per pair, by its line): a (host, 0) pair anywhere inside the
+    arguments of a call (a bind, a server constructor, over several lines, nested in other parentheses or lists), a
+    pair that is assigned (plain or annotated) to a name or returned, and start_server/serve given the port 0 (by
+    position or as port=0). A stand-in's server_address attribute binds nothing and is left out."""
+    lines: set[int] = set()
+
+    def pairs_in(node: ast.AST) -> None:
+        for inner in ast.walk(node):
+            if _is_zero_port_pair(inner):
+                lines.add(inner.lineno)
+
+    tree = ast.parse(text)
+    standins = [  # the body of a `server_address` property: it only reports an address
+        (f.lineno, f.end_lineno or f.lineno)
+        for f in ast.walk(tree)
+        if isinstance(f, ast.FunctionDef) and f.name == "server_address"
+    ]
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Return) and any(a <= node.lineno <= b for a, b in standins):
+            continue
+        if isinstance(node, ast.Call):
+            for arg in [*node.args, *(k.value for k in node.keywords)]:
+                pairs_in(arg)
+            name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
+            if name in ("start_server", "serve"):
+                zeros = [
+                    a for a in node.args[1:] if isinstance(a, ast.Constant) and a.value == 0 and type(a.value) is int
+                ]
+                zeros += [
+                    k.value
+                    for k in node.keywords
+                    if k.arg == "port" and isinstance(k.value, ast.Constant) and k.value.value == 0
+                ]
+                if zeros:
+                    lines.add(node.lineno)
+        elif isinstance(node, ast.Assign) and all(
+            isinstance(t, ast.Name) and t.id != "server_address" for t in node.targets
+        ):
+            pairs_in(node.value)
+        elif isinstance(node, ast.AnnAssign) and node.value is not None:
+            if not (isinstance(node.target, ast.Name) and node.target.id == "server_address"):
+                pairs_in(node.value)
+        elif isinstance(node, ast.Return) and node.value is not None:
+            pairs_in(node.value)
+    return sorted(lines)
+
+
+def test_the_syntax_guard_for_direct_binds_agrees_with_the_listed_sites() -> None:
+    """The line guard above only sees one-line shapes. The same class is read from the syntax tree: a multi-line
+    constructor, nested parentheses or an address kept in a variable is counted too, and the counts must equal the
+    listed ones."""
+    here = Path(__file__).resolve().parent
+    found = {}
+    for path in sorted(here.glob("*.py")):
+        if path.name in ("port_blocks.py", Path(__file__).name):
+            continue
+        sites = _ast_sites(path.read_text(encoding="utf-8"))
+        if sites:
+            found[path.name] = sites
+    surplus = {name: lines for name, lines in found.items() if name not in _ALLOWED_SITES}
+    assert not surplus, f"direct binds to port 0 in a shape the line guard misses: {surplus}"
+    for name, (count, _reason) in _ALLOWED_SITES.items():
+        assert len(found.get(name, [])) == count, (name, count, found.get(name))
+
