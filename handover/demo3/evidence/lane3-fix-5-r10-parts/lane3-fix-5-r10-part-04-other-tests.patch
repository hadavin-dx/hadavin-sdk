+def _direct_sites() -> dict[str, list[str]]:
+    here = Path(__file__).resolve().parent
+    found: dict[str, list[str]] = {}
+    for path in sorted(here.glob("*.py")):
+        if path.name in ("port_blocks.py", Path(__file__).name):
+            continue
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
+            if _SITE.search(line) and "server_address" not in line:  # a stand-in's attribute binds nothing
+                found.setdefault(path.name, []).append(f"{path.name}:{number}: {line.strip()}")
+    return found
