+def test_free_ports_of_a_session_lie_in_that_sessions_part_of_the_block(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("PYTEST_XDIST_WORKER", "gw0")
+    monkeypatch.setenv("PYTEST_XDIST_WORKER_COUNT", "1")
+    block = support.worker_port_range("gw0", "1")
+    assert block is not None
+    low, high = port_blocks.session_window(block, os.getpid())
+    try:
+        numbers = [free_port() for _ in range(5)] + [held_port() for _ in range(5)]
+    finally:
+        release_held_ports()
+    assert all(low <= n <= high for n in numbers), (low, high, numbers)
