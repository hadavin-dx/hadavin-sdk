+@pytest.mark.parametrize("count", [1, 2, 4, 16, 64])
+def test_two_sessions_on_one_machine_draw_from_different_parts_of_the_same_block(count: int) -> None:
+    """Two pytest runs at once both have a gw0 with the same block. The part of the block a process draws from depends
+    on its process number (pid % slices), so neighbouring process numbers get disjoint parts; the part lies inside the
+    block, and a block too narrow to share is used whole."""
+    block = support.worker_port_range("gw0", str(count))
+    assert block is not None
+    windows = [port_blocks.session_window(block, pid) for pid in range(5000, 5000 + 40)]
+    assert all(block[0] <= low <= high <= block[1] for low, high in windows)
+    distinct = sorted(set(windows))
+    assert _all_disjoint(distinct), (count, distinct)
+    assert distinct[0][0] == block[0] and distinct[-1][1] == block[1], (count, distinct)
+    assert all(nxt[0] == prev[1] + 1 for prev, nxt in zip(distinct, distinct[1:], strict=False)), (count, distinct)
+    if block[1] - block[0] + 1 >= 2 * port_blocks._MIN_SLICE:
+        assert len(distinct) >= 2, (count, "neighbouring process numbers share one part")
+        assert port_blocks.session_window(block, 5000) != port_blocks.session_window(block, 5001)
+    else:
+        assert distinct == [block]
+
