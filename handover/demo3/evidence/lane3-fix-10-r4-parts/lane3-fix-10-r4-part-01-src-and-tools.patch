index ad79be1345b8520e7f5bdd43a82f443ee0797e2a..c0e099a997b9f10934fa997c9c6a1b727de9064e 100644
--- a/src/lead_desk/constants.py
+++ b/src/lead_desk/constants.py
@@ -23,13 +23,172 @@ HTTP_BUSY: Final = 503
 
 # Process exit codes
 EXIT_OK: Final = 0
-EXIT_ANOTHER_DESK: Final = 2  # another desk holds the lock file (the lead book is in use)
-EXIT_SETTING_REFUSED: Final = (
-    3  # a limit in constants.py does not fit this computer (too many handler threads for the open-file limit)
-)
+EXIT_ADAPTERS_UNREACHABLE: Final = 1  # start-up cannot reach the sender (/fake/info)
+EXIT_ANOTHER_DESK: Final = 2  # another desk holds the lock file (the database is in use)
+# a limit in constants.py does not fit this computer (too many handler threads for the open-file limit)
+EXIT_OPEN_FILE_LIMIT: Final = 3
 EXIT_DESK_SETTING_REFUSED: Final = 4  # a setting was refused (Config, an adapter, or the Desk)
 EXIT_PORT_UNAVAILABLE: Final = 5  # the port could not be bound within BIND_RETRY_SECONDS
 EXIT_SIMULATED_KILL: Final = 137  # scripts/crash_desk.py: os._exit(137) at the chosen crash point
+EXIT_SCRIPT_SETTING_REFUSED: Final = 8  # a script (not the desk) read a DESK_* setting and it was refused
+# scripts/run_real_check.py (its own three, besides the 8 above)
+EXIT_CHECK_STOPPED: Final = 1
+EXIT_CHECK_REFUSED: Final = 2
+EXIT_CHECK_FAILED: Final = 3
+# scripts/start_all.sh and start_all.ps1 (their own two; they pass on 3, 4 and 5 of the desk)
+EXIT_START_NOT_DONE: Final = 1
+EXIT_NOT_BASH: Final = 2
+# scripts/reset.sh, reset.ps1 and reset_check.py
+EXIT_RESET_REFUSED: Final = 2
+EXIT_RESET_HELD: Final = 3
+EXIT_RESET_ANSWERING: Final = 4
+EXIT_RESET_NOT_STOPPED: Final = 5
+EXIT_RESET_WRONG_PROGRAM: Final = 6
+
+# The most one start_all waits for the demo server and the desk together (whole seconds): the default and the largest
+# value of START_ALL_WAIT_SECONDS. scripts/start_all.sh and start_all.ps1 repeat these two numbers as text (a shell
+# script cannot import them); tests/test_ps1_pins.py compares the text with these constants.
+START_WAIT_DEFAULT_SECONDS: Final = 15
+START_WAIT_MAX: Final = 999
+
+# The meaning of each code, written once, in plain words (what the program is, not our own label for it). A program's
+# row
+# below uses one of these texts; the same text in two programs is one meaning (start_all passes the desk's own codes
+# on), different texts behind one number are the overlap named in SAME_NUMBER_DIFFERENT_MEANING.
+MEANING_ADAPTERS_UNREACHABLE: Final = (
+    "the desk could not reach the demo server (the stand-in for the real mail and CRM services) when it started, "
+    "or the program stopped with an unexpected Python error report"
+)
+MEANING_ANOTHER_DESK: Final = "another desk is already running on the same database file"
+MEANING_OPEN_FILE_LIMIT: Final = "this computer allows too few open files for the desk's limits"
+MEANING_DESK_SETTING_REFUSED: Final = "the desk refused a setting (a value it does not accept)"
+MEANING_PORT_UNAVAILABLE: Final = "the desk could not take its network port (another program holds it)"
+MEANING_SIMULATED_KILL: Final = "the crash script stopped the desk on purpose, to test recovery"
+MEANING_SCRIPT_SETTING_REFUSED: Final = "a setting was refused while this program read it (one plain line says which)"
+# start_all passes the desk's own code 4 on: the desk it started refused a setting AFTER start_all's own reading passed
+# (a leadflow file, an approvers file, a sender address, a public bind address). A refusal in start_all's own reading
+# is 8.
+MEANING_START_DESK_SETTING_REFUSED: Final = (
+    MEANING_DESK_SETTING_REFUSED + "; 4 here is the desk's own refusal passed on (start_all's own reading refused: 8)"
+)
+MEANING_START_NOT_DONE: Final = (
+    "the start did not complete: a bad mode word, a bad START_ALL_WAIT_SECONDS value, a leftover file that holds a "
+    "process number from an earlier start, the demo server or the desk not ready in time, or the desk ended with a "
+    "code this table does not pass on"
+)
+MEANING_NOT_BASH: Final = "refused: the script was run by a shell that is not bash"
+MEANING_RESET_REFUSED: Final = (
+    "refused before anything was stopped or deleted (including a bad RESET_STOP_WAIT_SECONDS value)"
+)
+MEANING_RESET_HELD: Final = "something still uses the database file, or the check for another desk could not be done"
+MEANING_RESET_ANSWERING: Final = "something still answers on the desk's port or the demo server's port"
+MEANING_RESET_NOT_STOPPED: Final = "a process did not stop in time"
+MEANING_RESET_WRONG_PROGRAM: Final = "a file that holds a process number names a process that is not ours"
+MEANING_CHECK_STOPPED: Final = (
+    "the check was stopped before anything real was called: the Start question was not answered yes, or the self-test "
+    "could not start its local test servers"
+)
+MEANING_CHECK_REFUSED: Final = (
+    "the check was started wrongly (command line) or a needed tool is missing; nothing real was called"
+)
+MEANING_CHECK_FAILED: Final = "the check ran and found a failure, or its read-back of the CRM stopped"
+
+# THE table of process exit codes: (program, code, meaning). The program is the one thing that has a code; inside a
+# program a code has ONE meaning. tests/test_exit_code_table.py checks that, that every code a program really returns is
+# one of its rows, that every EXIT_ constant has a row in each program that uses it, and that
+# SAME_NUMBER_DIFFERENT_MEANING
+# equals the overlap computed from this table. The table is printed into docs/settings.md by tools/render_exit_table.py
+# (a test fails when the printed table differs). Programs: "server" is `python -m lead_desk.server`; "crash_desk",
+# "feed",
+# "reset_check" and "run_real_check" are scripts/*.py; "reset.sh", "reset.ps1", "start_all.sh", "start_all.ps1" are the
+# shell scripts. crash_desk calls the desk's own main, so it also returns the desk's codes. start_all passes on 3, 4
+# and 5
+# of the desk it started and gives every other desk code (and 0, a desk that ended at once) as its own 1.
+_DESK_ROWS: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_ADAPTERS_UNREACHABLE, MEANING_ADAPTERS_UNREACHABLE),
+    (EXIT_ANOTHER_DESK, MEANING_ANOTHER_DESK),
+    (EXIT_OPEN_FILE_LIMIT, MEANING_OPEN_FILE_LIMIT),
+    (EXIT_DESK_SETTING_REFUSED, MEANING_DESK_SETTING_REFUSED),
+    (EXIT_PORT_UNAVAILABLE, MEANING_PORT_UNAVAILABLE),
+)
+_PASSED_ON: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_OPEN_FILE_LIMIT, MEANING_OPEN_FILE_LIMIT),
+    (EXIT_DESK_SETTING_REFUSED, MEANING_START_DESK_SETTING_REFUSED),
+    (EXIT_PORT_UNAVAILABLE, MEANING_PORT_UNAVAILABLE),
+)
+# start_all passes on exactly these desk codes
+PASSED_ON_DESK_CODES: Final[tuple[int, ...]] = tuple(code for code, _ in _PASSED_ON)
+_RESET_ROWS: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_RESET_REFUSED, MEANING_RESET_REFUSED),
+    (EXIT_RESET_HELD, MEANING_RESET_HELD),
+    (EXIT_RESET_ANSWERING, MEANING_RESET_ANSWERING),
+    (EXIT_RESET_NOT_STOPPED, MEANING_RESET_NOT_STOPPED),
+    (EXIT_RESET_WRONG_PROGRAM, MEANING_RESET_WRONG_PROGRAM),
+    (EXIT_SCRIPT_SETTING_REFUSED, MEANING_SCRIPT_SETTING_REFUSED),
+)
+_SETTING_ROW: Final = (EXIT_SCRIPT_SETTING_REFUSED, MEANING_SCRIPT_SETTING_REFUSED)
+EXIT_CODE_TABLE: Final[tuple[tuple[str, int, str], ...]] = (
+    *(("server", code, meaning) for code, meaning in _DESK_ROWS),
+    *(("crash_desk", code, meaning) for code, meaning in (*_DESK_ROWS, _SETTING_ROW)),
+    ("crash_desk", EXIT_SIMULATED_KILL, MEANING_SIMULATED_KILL),
+    ("feed", *_SETTING_ROW),
+    *(("reset.sh", code, meaning) for code, meaning in _RESET_ROWS),
+    *(("reset.ps1", code, meaning) for code, meaning in _RESET_ROWS),
+    ("reset_check", EXIT_RESET_HELD, MEANING_RESET_HELD),
+    ("reset_check", EXIT_RESET_ANSWERING, MEANING_RESET_ANSWERING),
+    ("reset_check", *_SETTING_ROW),
+    ("start_all.sh", EXIT_START_NOT_DONE, MEANING_START_NOT_DONE),
+    ("start_all.sh", EXIT_NOT_BASH, MEANING_NOT_BASH),
+    *(("start_all.sh", code, meaning) for code, meaning in (*_PASSED_ON, _SETTING_ROW)),
+    ("start_all.ps1", EXIT_START_NOT_DONE, MEANING_START_NOT_DONE),
+    *(("start_all.ps1", code, meaning) for code, meaning in (*_PASSED_ON, _SETTING_ROW)),
+    ("run_real_check", EXIT_CHECK_STOPPED, MEANING_CHECK_STOPPED),
+    ("run_real_check", EXIT_CHECK_REFUSED, MEANING_CHECK_REFUSED),
+    ("run_real_check", EXIT_CHECK_FAILED, MEANING_CHECK_FAILED),
+    ("run_real_check", *_SETTING_ROW),
