+# -- scripts/run_real_check.py: the desk's own settings check runs without --live-model too --------------------------
+def _real_config(tmp: Path, **extra: str) -> Path:
+    key = tmp / "key.txt"
+    key.write_text("made-up", encoding="utf-8")
+    values = {
+        "DESK_DB_PATH": str(tmp / "run" / "desk.db"),
+        "DESK_HUBSPOT_KEY_FILE": str(key),
+        "DESK_HUBSPOT_MAX_CALLS": "400",
+        "REAL_HUBSPOT_READBACK_MAX_CALLS": "200",
+        "DESK_SMTPP_HOST": "127.0.0.1",
+        "DESK_SMTPP_USER": "a@example.com",
+        "DESK_SMTPP_PASSWORD_FILE": str(key),
+        "DESK_SMTPP_FROM": "a@example.com",
+        "DESK_SMTPP_RECIPIENTS": "a@example.com,b@example.com",
+        "DESK_SMTPP_MAX_SENDS": "60",
+        "REAL_IMAP_1_USER": "a@example.com",
+        "REAL_IMAP_1_PASSWORD_FILE": str(key),
+        "REAL_IMAP_2_USER": "b@example.com",
+        "REAL_IMAP_2_PASSWORD_FILE": str(key),
+        **extra,
+    }
+    path = tmp / "real.env"
+    path.write_text("\n".join(f"{k}={v}" for k, v in values.items()), encoding="utf-8")
+    return path
+
+
+def _rrc() -> Any:
+    sys.path.insert(0, str(SCRIPTS))
+    try:
+        import run_real_check as rrc
+    finally:
+        sys.path.remove(str(SCRIPTS))
+    return rrc
