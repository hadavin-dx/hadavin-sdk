+def test_a_value_inside_a_real_refusal_never_reaches_the_desk_output(tmp_path: Path) -> None:
+    done = _run(["-m", "lead_desk.server"], tmp_path, "DESK_NUDGE_TO", "no-at-sign-secret")
+    assert done.returncode == EXIT_DESK_SETTING_REFUSED and "no-at-sign-secret" not in done.stdout + done.stderr
