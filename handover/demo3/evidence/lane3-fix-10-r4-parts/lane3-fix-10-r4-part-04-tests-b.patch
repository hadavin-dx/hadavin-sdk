+
+    env = {"DESK_LATER_MODE": "off", "DESK_STALL_SECONDS": "65535", "DESK_PORT": "70000", "DESK_ADAPTERS": "demo"}
+    reason = "DESK_PORT must be at most 65535 and DESK_QUALIFIER be a or off"
