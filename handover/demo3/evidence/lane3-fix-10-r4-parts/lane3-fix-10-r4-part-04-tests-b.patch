+def _ipv6_loopback() -> bool:
+    try:
+        with socket.socket(socket.AF_INET6) as probe:
+            probe.bind(("::1", 0))
+        return True
+    except OSError:
+        return False
+
+
+@pytest.mark.skipif(not _ipv6_loopback(), reason="this computer has no IPv6 loopback address")
+def test_a_demo_server_on_an_ipv6_loopback_address_is_waited_for(tmp_path: Path, cleanup: None) -> None:
+    """The settings keep the brackets of `http://[::1]:PORT`; the wait must strip them before it connects."""
+    port = free_port()
+    listener = (
+        f"exec {sys.executable} -c 'import socket,time; s=socket.socket(socket.AF_INET6); "
+        f's.bind(("::1",{port})); s.listen(); time.sleep(60)\''
+    )
+    stub = _stub_python(tmp_path, "echo desk listening on x; exec sleep 60", listener)
+    done = _run(tmp_path, first_on_path=stub, wait="6", DESK_FAKES_URL=f"http://[::1]:{port}")
+    assert done.returncode == 0 and "started:" in done.stdout, (done.stdout, done.stderr)
+
