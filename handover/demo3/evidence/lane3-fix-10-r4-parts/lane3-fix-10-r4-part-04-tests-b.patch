+_TIMEOUT_TAIL = '(it may still be starting); see desk.log in the data folder; run scripts\\reset.ps1 to stop it")'
+START_MUTANTS = {
+    "no pass-through limit": ("if ($deskCode -in 3, 4, 5) { exit $deskCode }", "exit $deskCode"),
+    "no null guard": ("if ($null -eq $deskCode -or $deskCode -isnot [int]) { $deskCode = 1 }", ""),
+    "no handle kept": ("$null = $desk.Handle", ""),
+    "no wait for exit": ("$desk.WaitForExit()", ""),
+    "no wait stop": ("if ($desk.HasExited) { break }", ""),
+    "demo server left running": ("Stop-Process -Id $fakes.Id -ErrorAction SilentlyContinue", ""),
+    "pid files left": (
+        'Remove-Item -Force "$dataDir\\fakes.pid", "$dataDir\\desk.pid" -ErrorAction SilentlyContinue',
+        "",
+    ),
+    "timeout exits 0": (_TIMEOUT_TAIL + "\n        exit 1", _TIMEOUT_TAIL + "\n        exit 0"),
+    "formatter dropped": ("$last | & python -m lead_desk.config_exit", "$last"),
+    "log read can fail": ("Get-Content $f -ErrorAction SilentlyContinue", "Get-Content $f"),
+    "no demo server message": ("the demo server did not answer in", "not ready"),
+    "no taken-port message": ("the demo server stopped at once; the desk was not started", "not ready"),
+    "alive check dropped": ("if ($fakesUp -and -not $fakes.HasExited) { break }", "if ($fakesUp) { break }"),
+    "desk wait ignores a dead demo server": (
+        "    if ($fakes.HasExited) { break }\n    if ((Test-Path",
+        "    if ((Test-Path",
+    ),
+    "ready without the demo server check": ("if ($ready -and $fakes.HasExited) { $ready = $false }", ""),
+    "brackets kept": ("$fakesHost = $fakesHost.Trim('[', ']')", ""),
+    "encoding dropped": ("[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false", ""),
+    "native errors fatal": ("$ErrorActionPreference = 'Continue'\n    $plain = (", "$plain = ("),
+}
+
+
+@pytest.mark.parametrize("mutant", sorted(START_MUTANTS))
+def test_text_only_each_start_pin_rejects_its_mutant(mutant: str) -> None:
+    old, new = START_MUTANTS[mutant]
+    text = (SCRIPTS / "start_all.ps1").read_text(encoding="utf-8")
+    assert old in text, mutant
+    assert start_problems(text.replace(old, new, 1)) != [], mutant
+
+
+@pytest.mark.parametrize("name", NAMES)
+def test_text_only_every_claim_in_the_script_says_it_was_not_run(name: str) -> None:
+    assert "NOT run on Windows in this build" in (SCRIPTS / name).read_text(encoding="utf-8")
+    assert "not run on Windows in this build" in (REPO / "contract.md").read_text(encoding="utf-8")
