+    lines = [ln for ln in (done.stdout + done.stderr).splitlines() if ln.strip()]
+    assert done.returncode == 8 and len(lines) == 1 and "DESK_NUDGE_TO" in lines[0] and "no-at-sign" not in lines[0]
+
+
+@pytest.mark.skipif(sys.platform != "win32", reason="Windows PowerShell only; not run in this build")
+def test_windows_start_all_a_late_refusal_is_the_desks_4_and_nothing_is_started(tmp_path: Path) -> None:
+    done = _windows_run("start_all.ps1", tmp_path, DESK_LEADFLOW_FILE="no-such-flow.json")
+    assert done.returncode == 4 and "started:" not in done.stdout and "the desk ended at once (exit 4)" in done.stderr
+    assert not (tmp_path / "data" / "desk.pid").exists() and not (tmp_path / "data" / "fakes.pid").exists()
+
+
+@pytest.mark.skipif(sys.platform != "win32", reason="Windows PowerShell only; not run in this build")
+def test_windows_start_all_a_taken_port_is_exit_5(tmp_path: Path) -> None:
+    import socket
+
+    with socket.socket() as taken:
+        taken.bind(("127.0.0.1", 0))
+        taken.listen()
+        done = _windows_run("start_all.ps1", tmp_path, DESK_PORT=str(taken.getsockname()[1]))
+    assert done.returncode == 5 and "started:" not in done.stdout
+
+
+def test_text_pin_the_wait_default_and_limit_are_the_constants() -> None:
+    """TEXT PIN: the one number of the waiting budget lives in constants.py; the two scripts and contract.md repeat
+    it, and
+    this pin fails when one of them says another number."""
+    from lead_desk import constants as c
+
+    ps1 = (SCRIPTS / "start_all.ps1").read_text(encoding="utf-8")
+    sh = (SCRIPTS / "start_all.sh").read_text(encoding="utf-8")
+    contract = (REPO / "contract.md").read_text(encoding="utf-8")
+    digits = len(str(c.START_WAIT_MAX))
+    assert c.START_WAIT_MAX == 10**digits - 1 and c.START_WAIT_DEFAULT_SECONDS <= c.START_WAIT_MAX
+    assert f"$waitSeconds = {c.START_WAIT_DEFAULT_SECONDS}\n" in ps1
+    assert f"START_ALL_WAIT_SECONDS:-{c.START_WAIT_DEFAULT_SECONDS}}}" in sh
+    assert f"^[1-9][0-9]{{0,{digits - 1}}}$" in ps1
+    assert "|".join("[1-9]" + "[0-9]" * k for k in range(digits)) in sh
+    assert f"({c.START_WAIT_DEFAULT_SECONDS} seconds;" in contract
+    assert f"from 1 to {c.START_WAIT_MAX} " in ps1 and f"from 1 to {c.START_WAIT_MAX} " in sh
