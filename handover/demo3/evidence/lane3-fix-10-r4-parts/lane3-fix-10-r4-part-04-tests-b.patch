+
+@pytest.mark.parametrize("name", ["DESK_NUDGE_TO", "DESK_LIVE_KEY_FILE", "DESK_SMTPP_PASSWORD_FILE", "DESK_FAKES_URL"])
+def test_a_secret_or_address_like_setting_is_blanked_even_when_the_message_does_not_name_it(name: str) -> None:
+    from lead_desk.config_exit import refusal_line
+
+    env = {name: "token-value-xyz"}
+    line = refusal_line("the desk refuses a setting:", "DESK_PORT is bad (token-value-xyz)", env)
+    assert "token-value-xyz" not in line and "<value>" in line, line
