+def test_refusal_line_is_cut_and_one_line() -> None:
+    from lead_desk.config_exit import LINE_MAX, refusal_line
+
+    line = refusal_line("the desk refuses to start:", "a\r\nb  c\n" + "y" * 5000)
+    assert len(line) == len("the desk refuses to start: ") + LINE_MAX and "\n" not in line and "\r" not in line
