+@pytest.mark.skipif(sys.platform != "win32", reason="Windows PowerShell only; not run in this build")
+@pytest.mark.parametrize("name", NAMES)
+def test_windows_a_bad_setting_gives_one_line_and_exit_8(name: str, tmp_path: Path) -> None:
