+# -- a path that is not valid text (lone surrogate: a byte that is not UTF-8 in the environment) ---------------------
+SURROGATE = "a\udc80b"
+
+
+CONFIG_PATH_NAMES = ["DESK_DB_PATH", "DESK_REPLIES_PATH", "DESK_APPROVERS_FILE", "DESK_LEADFLOW_FILE"]
+ADAPTER_PATH_NAMES = [
+    ("DESK_HUBSPOT_KEY_FILE", "HubspotSettings"),
+    ("DESK_HUBSPOT_STATS_FILE", "HubspotSettings"),
+    ("DESK_SMTPP_PASSWORD_FILE", "ProviderSettings"),
+    ("DESK_SMTPP_STATS_FILE", "ProviderSettings"),
+    ("DESK_SMTPP_CA_FILE", "ProviderSettings"),
+]
+
+
+@pytest.mark.parametrize("bad", [SURROGATE, "a\0b"])
+@pytest.mark.parametrize("name", CONFIG_PATH_NAMES + ["DESK_LIVE_KEY_FILE", "DESK_LIVE_LEDGER_PATH"])
+def test_a_path_that_is_not_valid_text_is_refused_by_config(name: str, bad: str) -> None:
+    env = {**LIVE_GOOD, "DESK_LATER_MODE": "approval", name: bad}
+    with pytest.raises(SettingRefused, match=f"{name} is not a valid path"):
+        Config.from_env(env)
+
+
+@pytest.mark.parametrize("bad", [SURROGATE, "a\0b"])
+@pytest.mark.parametrize(("name", "cls"), ADAPTER_PATH_NAMES)
+def test_a_path_that_is_not_valid_text_is_refused_by_every_adapter_reader(name: str, cls: str, bad: str) -> None:
+    """The adapters' own readers (crm_hubspot, smtp_provider) use the same path helper as Config."""
+    from lead_desk.crm_hubspot import HubspotSettings
+    from lead_desk.smtp_provider import ProviderSettings
+
+    good = {
+        "HubspotSettings": {"DESK_HUBSPOT_KEY_FILE": "k.txt", "DESK_HUBSPOT_MAX_CALLS": "10"},
+        "ProviderSettings": {
+            "DESK_SMTPP_HOST": "127.0.0.1",
+            "DESK_SMTPP_USER": "user",
+            "DESK_SMTPP_PASSWORD_FILE": "p.txt",
+            "DESK_SMTPP_FROM": "a@example.test",
+            "DESK_SMTPP_RECIPIENTS": "b@example.test",
+            "DESK_SMTPP_MAX_SENDS": "5",
+        },
+    }[cls]
+    reader = {"HubspotSettings": HubspotSettings, "ProviderSettings": ProviderSettings}[cls]
+    reader.from_env(good)  # the baseline is accepted
+    with pytest.raises(SettingRefused, match=f"{name} is not a valid path"):
+        reader.from_env({**good, name: bad})
+
+
+@pytest.mark.skipif(WINDOWS, reason="a lone surrogate in the environment is a POSIX case")
+def test_a_path_that_is_not_valid_text_gives_one_line_through_the_helpers(tmp_path: Path) -> None:
+    cases = [([str(SCRIPTS / "reset_check.py")], False), (["start_all.sh"], True), (["reset.sh"], True)]
+    for argv, with_bash in cases:
+        done = _run(argv, tmp_path, "DESK_DB_PATH", SURROGATE, with_bash=with_bash)
+        _assert_clean_refusal(done, "DESK_DB_PATH", SURROGATE, tmp_path)
