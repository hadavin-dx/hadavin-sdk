+"""The two Windows scripts that read the DESK_* settings, pinned as far as this machine allows.
+
+NOT RUN HERE: PowerShell (no Windows, no pwsh on this machine). TEXT-ONLY: what runs here is a set of pins on the TEXT
+of scripts/start_all.ps1 and scripts/reset.ps1, each with a mutant (the same text with one line dropped) that the pin
+must reject, so a pin cannot pass on text that lost the line. These pins prove that the lines are there, not that
+PowerShell does the right thing with them; they are not counted as behaviour tests anywhere. The real run is the
+Windows-only tests at the bottom, skipped everywhere except Windows (a bad setting; a late refusal; a taken port); until
+they have run on Windows every claim about these two scripts is "designed for Windows PowerShell 5.1, not run on Windows
+in this build".
+"""
+
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import REPO
+
+SCRIPTS = REPO / "scripts"
+NAMES = ("start_all.ps1", "reset.ps1")
+
+
+def _code(text: str) -> str:
+    text = re.sub(r"<#.*?#>", "", text, flags=re.DOTALL)
+    return "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def reader_problems(text: str) -> list[str]:
+    """What is missing from the settings reader (`Read-DeskSetting`) of a script; [] when every pin holds."""
+    code = _code(text)
+    found = re.search(r"function Read-DeskSetting\(\[string\]\$Expression\) \{(.*?)\n\}", code, flags=re.DOTALL)
+    if found is None:
+        return ["no Read-DeskSetting function"]
+    body = found.group(1)
+    pins = {
+        "reads through config_or_exit": r"from lead_desk\.config_exit import config_or_exit",
+        "keeps the exit code": r"\$code = \$LASTEXITCODE",
+        "native errors are not fatal while it runs": r"\$ErrorActionPreference = 'Continue'",
+        "splits the error records from the output": (
+            r"-is \[System\.Management\.Automation\.ErrorRecord\][^\n]*\n"
+            r"[^\n]*-isnot \[System\.Management\.Automation\.ErrorRecord\]"
+        ),
+        "writes the refusal on the error stream": (
+            r"if \(\$code -ne 0\) \{[^\n]*\[Console\]::Error\.WriteLine\(\$errorText\)[^\n]"
+            r"*exit \$code[^\n]*\}"
+        ),
+        "the value comes from the output only": r"\$outText\.Trim\(\)",
+    }
+    return [name for name, pat in pins.items() if re.search(pat, body) is None]
+
+
+def start_problems(text: str) -> list[str]:
+    code = _code(text)
+    pins = {
+        "wait budget from START_ALL_WAIT_SECONDS, default 15": (
+            r"\$waitSeconds = 15\b[\s\S]*\$env:START_ALL_WAIT_SECONDS"
+        ),
+        "one tick counter for both waits": (
+            r"\$maxTicks = \$waitSeconds \* 5[\s\S]*while \(\$ticks -lt \$maxTicks\)[\s\S]"
+            r"*while \(\$ticks -lt \$maxTicks\)"
+        ),
+        "waits for the demo server port": r"TcpClient[\s\S]*\.Connect\(\$fakesHost, \[int\]\$fakesPort\)",
+        "says the demo server did not answer, stops it, exits 1": (
+            r"the demo server did not answer in \$waitSeconds seconds[^\n]*\n\s*\}\s*\n\s*Stop-Process[^\n]*\n[^\n]*"
+            r"Remove-Item[^\n]*\n\s*exit 1\b"
+        ),
+        "says the demo server stopped at once (a taken port)": (
+            r"the demo server stopped at once; the desk was not started"
+        ),
+        "the demo server is up only if alive AND the port answers": (
+            r"if \(\$fakesUp -and -not \$fakes\.HasExited\) \{ break \}"
+        ),
+        "the desk wait stops when the demo server has ended": (
+            r"while \(\$ticks -lt \$maxTicks\) \{\s*\n\s*if \(\$fakes\.HasExited\) \{ break \}\s*\n\s*if \(\(Test-Path"
+        ),
+        "the desk is ready only while the demo server is alive": (
+            r"if \(\$ready -and \$fakes\.HasExited\) \{ \$ready = \$false \}"
+        ),
+        "the brackets of an IPv6 host are removed": r"\$fakesHost = \$fakesHost\.Trim\('\[', '\]'\)",
+        "the pipe to the helper carries UTF-8": (
+            r"\[Console\]::OutputEncoding = New-Object System\.Text\.UTF8Encoding \$false[\s\S]*"
+            r"\$OutputEncoding = New-Object System\.Text\.UTF8Encoding \$false[\s\S]*\$last \| & python"
+        ),
+        "the native call cannot raise on its error stream": (
+            r"\$ErrorActionPreference = 'Continue'\s*\n\s*"
+            r"\$plain = \(\$last \| & python -m lead_desk\.config_exit 2>\$null\)"
+            r"\s*\n\s*\$plainCode = \$LASTEXITCODE"
+        ),
+        "looks for the listening line, log reads do not fail on a busy file": (
+            r"Select-String[^\n]*desk listening on[^\n]*-ErrorAction SilentlyContinue"
+        ),
+        "stops waiting when the desk has ended": r"if \(\$desk\.HasExited\) \{ break \}",
+        "timeout says it may still be starting, exits 1": (
+            r"desk not ready after[^\n]*may still be starting[^\n]*\n\s*exit 1\b"
+        ),
+        "keeps the process handle (ExitCode is not null)": r"\$null = \$desk\.Handle",
+        "waits for the process to end before reading its code": (
+            r"\$desk\.WaitForExit\(\)\s*\n\s*\$deskCode = \$desk\.ExitCode"
+        ),
+        "a code that cannot be read is 1": (
+            r"if \(\$null -eq \$deskCode -or \$deskCode -isnot \[int\]\) \{ \$deskCode = 1 \}"
+        ),
+        "passes on only 3, 4 and 5": r"if \(\$deskCode -in 3, 4, 5\) \{ exit \$deskCode \}\s*\n\s*exit 1\b",
+        "last log line through the formatter": r"\$last \| & python -m lead_desk\.config_exit",
+        "last log lines read without failing": r"Get-Content \$f -ErrorAction SilentlyContinue",
+        "stops the demo server it started": r"Stop-Process -Id \$fakes\.Id",
+        "removes its two process-id files": r"Remove-Item -Force \"\$dataDir\\fakes\.pid\", \"\$dataDir\\desk\.pid\"",
+        "the refusal goes to the error stream": r"\[Console\]::Error\.WriteLine\(\"the desk ended at once",
+    }
+    problems = [name for name, pat in pins.items() if re.search(pat, code) is None]
+    started = code.find('Write-Host "started:')
+    wait_end = code.find("\n    exit 1\n}\nWrite-Host")
+    if started < 0 or wait_end < 0 or started < wait_end:
+        problems.append('"started" is printed before the desk was seen to listen')
+    return problems
+
+
+@pytest.mark.parametrize("name", NAMES)
+def test_text_only_the_reader_pins_hold(name: str) -> None:
+    assert reader_problems((SCRIPTS / name).read_text(encoding="utf-8")) == []
+
+
+def test_text_only_the_start_pins_hold() -> None:
+    assert start_problems((SCRIPTS / "start_all.ps1").read_text(encoding="utf-8")) == []
+
+
+MUTANTS = {
+    "drop exit $code": ("exit $code", ""),
+    "drop the stderr write": ("[Console]::Error.WriteLine($errorText);", ""),
+    "no split": ("-isnot [System.Management.Automation.ErrorRecord]", "-is [System.Management.Automation.ErrorRecord]"),
+    "no exit code kept": ("$code = $LASTEXITCODE", "$code = 0"),
+}
+
+
+@pytest.mark.parametrize("name", NAMES)
+@pytest.mark.parametrize("mutant", sorted(MUTANTS))
+def test_text_only_each_reader_pin_rejects_its_mutant(name: str, mutant: str) -> None:
+    old, new = MUTANTS[mutant]
+    text = (SCRIPTS / name).read_text(encoding="utf-8")
+    assert old in text, (name, mutant)
+    assert reader_problems(text.replace(old, new, 1)) != [], (name, mutant)
+
