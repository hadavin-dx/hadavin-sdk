+# Designed for Windows PowerShell 5.1; NOT run on Windows in this build (no PowerShell here).
+# (Windows PowerShell 5.1 turns the error text of a native program into an error, unless the preference is Continue)
+function Read-DeskSetting([string]$Expression) {
+    $previous = $ErrorActionPreference
+    $ErrorActionPreference = 'Continue'
+    $merged = & python -c "from lead_desk.config_exit import config_or_exit; print($Expression)" 2>&1
+    $code = $LASTEXITCODE
