+"""The one table of exit codes (`constants.EXIT_CODE_TABLE`, `SETTING_REFUSED_EXIT_BY_PROGRAM`) must say what the programs do.
+
+Checked here: no code has two meanings inside one family; every `EXIT_*` constant is in the table; the script reader's
+code (8) is used by no other family and appears in no script as a bare number except through the reader; the codes the
+reset scripts use as plain numbers are exactly the "reset" family; contract.md names every code of the table. The test that
+runs each program with a bad setting and compares with the by-program table is in tests/test_bad_setting_entry_points.py.
+"""
+
+from __future__ import annotations
+
+import re
+from collections import defaultdict
+
+from support import REPO
+
+from lead_desk import constants as c
+
+TABLE = c.EXIT_CODE_TABLE
+
+
+def test_no_code_has_two_meanings_inside_one_family() -> None:
+    seen: dict[tuple[str, int], str] = {}
+    for family, code, meaning in TABLE:
+        assert (family, code) not in seen, (family, code, meaning, seen[(family, code)])
+        seen[(family, code)] = meaning
+    assert all(meaning.strip() for _, _, meaning in TABLE)
+
+
+def test_every_exit_constant_is_in_the_table() -> None:
+    codes = {code for _, code, _ in TABLE}
+    named = {v for k, v in vars(c).items() if k.startswith("EXIT_") and isinstance(v, int) and k != "EXIT_OK"}
+    assert named <= codes, named - codes
+
+
+def test_the_script_reader_code_is_unused_by_every_other_family() -> None:
+    families: dict[int, set[str]] = defaultdict(set)
+    for family, code, _ in TABLE:
+        families[code].add(family)
+    assert families[c.EXIT_SCRIPT_SETTING_REFUSED] == {"script"}
+    assert c.EXIT_SCRIPT_SETTING_REFUSED not in {2, 3, 4, 5, 6} and c.EXIT_DESK_SETTING_REFUSED == 4
+
+
+def test_the_by_program_table_names_only_the_two_numbers() -> None:
+    assert set(c.SETTING_REFUSED_EXIT_BY_PROGRAM.values()) == {c.EXIT_DESK_SETTING_REFUSED, c.EXIT_SCRIPT_SETTING_REFUSED}
+
+
+def test_the_reset_family_is_what_the_reset_scripts_return() -> None:
+    reset_codes = {code for family, code, _ in TABLE if family == "reset"}
+    used: set[int] = set()
+    sh = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8")
+    used |= {int(n) for n in re.findall(r"\bexit ([0-9]+)", sh)} - {0, 1}
+    ps = (REPO / "scripts" / "reset.ps1").read_text(encoding="utf-8")
+    used |= {int(n) for n in re.findall(r"\bexit ([0-9]+)", ps)} - {0, 1}
+    check = (REPO / "scripts" / "reset_check.py").read_text(encoding="utf-8")
+    used |= {int(n) for n in re.findall(r"return ([0-9]+)", check)} - {0}
+    assert used == reset_codes, (used, reset_codes)
+
+
+def test_no_script_uses_the_script_reader_code_as_a_bare_number() -> None:
+    for path in (REPO / "scripts").iterdir():
+        if path.suffix in {".sh", ".ps1", ".py"}:
+            assert not re.search(rf"\b(?:exit|return|SystemExit\()\s*{c.EXIT_SCRIPT_SETTING_REFUSED}\b", path.read_text("utf-8")), path.name
+
+
+def test_contract_md_names_both_numbers_and_the_table() -> None:
+    text = (REPO / "contract.md").read_text(encoding="utf-8")
+    assert "EXIT_CODE_TABLE" in text and "exit 8" in text and "EXIT_SCRIPT_SETTING_REFUSED" in text
diff --git a/tests/test_ps1_pins.py b/tests/test_ps1_pins.py
new file mode 100644
index 0000000..3386783
--- /dev/null
+++ b/tests/test_ps1_pins.py
@@ -0,0 +1,135 @@
+"""The two Windows scripts that read the DESK_* settings, pinned as far as this machine allows.
+
+NOT RUN HERE: PowerShell (no Windows, no pwsh on this machine). What runs here is a set of text pins on the code of
+scripts/start_all.ps1 and scripts/reset.ps1, each with a mutant (the same text with one line dropped) that the pin must
+reject, so a pin cannot pass on text that lost the behaviour. The real run is the Windows test at the bottom, skipped
+everywhere except Windows; until it has run on Windows every claim about these two scripts is "designed for Windows
+PowerShell 5.1, not run on Windows in this build".
+"""
+
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import REPO
+
+SCRIPTS = REPO / "scripts"
+NAMES = ("start_all.ps1", "reset.ps1")
+
+
+def _code(text: str) -> str:
+    text = re.sub(r"<#.*?#>", "", text, flags=re.DOTALL)
+    return "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def reader_problems(text: str) -> list[str]:
+    """What is missing from the settings reader (`Read-DeskSetting`) of a script; [] when every pin holds."""
+    code = _code(text)
+    found = re.search(r"function Read-DeskSetting\(\[string\]\$Expression\) \{(.*?)\n\}", code, flags=re.DOTALL)
+    if found is None:
+        return ["no Read-DeskSetting function"]
+    body = found.group(1)
+    pins = {
+        "reads through config_or_exit": r"from lead_desk\.config_exit import config_or_exit",
+        "keeps the exit code": r"\$code = \$LASTEXITCODE",
+        "native errors are not fatal while it runs": r"\$ErrorActionPreference = 'Continue'",
+        "splits the error records from the output": r"-is \[System\.Management\.Automation\.ErrorRecord\][^\n]*\n[^\n]*-isnot \[System\.Management\.Automation\.ErrorRecord\]",
+        "writes the refusal on the error stream": r"if \(\$code -ne 0\) \{[^\n]*\[Console\]::Error\.WriteLine\(\$errorText\)[^\n]*exit \$code[^\n]*\}",
+        "the value comes from the output only": r"\$outText\.Trim\(\)",
+    }
+    return [name for name, pat in pins.items() if re.search(pat, body) is None]
+
+
+def start_problems(text: str) -> list[str]:
+    code = _code(text)
+    pins = {
+        "fixed wait of 15 seconds": r"\$waitSeconds = 15\b",
+        "looks for the listening line": r"Select-String[^\n]*desk listening on",
+        "stops waiting when the desk has ended": r"if \(\$desk\.HasExited\) \{ break \}",
+        "timeout exits 1": r"desk not ready after[^\n]*\n\s*exit 1\b",
+        "passes the desk's own code on": r"(?m)^\s*exit \$deskCode\s*$",
+        "stops the demo server it started": r"Stop-Process -Id \$fakes\.Id",
+        "removes its two process-id files": r"Remove-Item -Force \"\$dataDir\\fakes\.pid\", \"\$dataDir\\desk\.pid\"",
+        "the refusal goes to the error stream": r"\[Console\]::Error\.WriteLine\(\"the desk ended at once",
+    }
+    problems = [name for name, pat in pins.items() if re.search(pat, code) is None]
+    started = code.find('Write-Host "started:')
+    wait_end = code.find("\n    exit $deskCode")
+    if started < 0 or wait_end < 0 or started < wait_end:
+        problems.append('"started" is printed before the desk was seen to listen')
+    return problems
+
+
+@pytest.mark.parametrize("name", NAMES)
+def test_the_reader_pins_hold(name: str) -> None:
+    assert reader_problems((SCRIPTS / name).read_text(encoding="utf-8")) == []
+
+
+def test_the_start_pins_hold() -> None:
+    assert start_problems((SCRIPTS / "start_all.ps1").read_text(encoding="utf-8")) == []
+
+
+MUTANTS = {
+    "drop exit $code": ("exit $code", ""),
+    "drop the stderr write": ("[Console]::Error.WriteLine($errorText);", ""),
+    "no split": ("-isnot [System.Management.Automation.ErrorRecord]", "-is [System.Management.Automation.ErrorRecord]"),
+    "no exit code kept": ("$code = $LASTEXITCODE", "$code = 0"),
+}
+
+
+@pytest.mark.parametrize("name", NAMES)
+@pytest.mark.parametrize("mutant", sorted(MUTANTS))
+def test_each_reader_pin_rejects_its_mutant(name: str, mutant: str) -> None:
+    old, new = MUTANTS[mutant]
+    text = (SCRIPTS / name).read_text(encoding="utf-8")
+    assert old in text, (name, mutant)
+    assert reader_problems(text.replace(old, new, 1)) != [], (name, mutant)
+
+
+START_MUTANTS = {
+    "no exit of the desk's code": ("\n    exit $deskCode", "\n    exit 0"),
+    "no wait stop": ("if ($desk.HasExited) { break }", ""),
+    "demo server left running": ("Stop-Process -Id $fakes.Id -ErrorAction SilentlyContinue", ""),
+    "pid files left": ('Remove-Item -Force "$dataDir\\fakes.pid", "$dataDir\\desk.pid" -ErrorAction SilentlyContinue', ""),
+    "timeout exits 0": ("exit 1\n    }\n    $deskCode", "exit 0\n    }\n    $deskCode"),
+}
+
+
+@pytest.mark.parametrize("mutant", sorted(START_MUTANTS))
+def test_each_start_pin_rejects_its_mutant(mutant: str) -> None:
+    old, new = START_MUTANTS[mutant]
+    text = (SCRIPTS / "start_all.ps1").read_text(encoding="utf-8")
+    assert old in text, mutant
+    assert start_problems(text.replace(old, new, 1)) != [], mutant
+
+
+@pytest.mark.parametrize("name", NAMES)
+def test_every_claim_in_the_script_says_it_was_not_run(name: str) -> None:
+    assert "NOT run on Windows in this build" in (SCRIPTS / name).read_text(encoding="utf-8")
+    assert "not run on Windows in this build" in (REPO / "contract.md").read_text(encoding="utf-8")
+
+
+@pytest.mark.skipif(sys.platform != "win32", reason="Windows PowerShell only; not run in this build")
+@pytest.mark.parametrize("name", NAMES)
+def test_windows_a_bad_setting_gives_one_line_and_exit_8(name: str, tmp_path: Path) -> None:
+    powershell = shutil.which("powershell")
+    if powershell is None:
+        pytest.skip("Windows PowerShell is not installed")
+    from support import child_env
+
+    done = subprocess.run(  # noqa: S603
+        [powershell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(SCRIPTS / name)],
+        cwd=REPO,
+        env=child_env(DESK_PORT="abc", DESK_DB_PATH=str(tmp_path / "data" / "d.sqlite3")),
+        capture_output=True,
+        text=True,
+        timeout=120,
+        check=False,
+    )
+    lines = [ln for ln in (done.stdout + done.stderr).splitlines() if ln.strip()]
+    assert done.returncode == 8 and len(lines) == 1 and "DESK_PORT" in lines[0] and "started" not in lines[0]
