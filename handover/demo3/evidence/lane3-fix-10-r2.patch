+    # character) is the one shared rule of identity.py and is tested where that rule lives, not copied here
+    ("DESK_NUDGE_TO", " "),  # whitespace only
+    ("DESK_NUDGE_TO", "café@b.test"),  # not ASCII
+    ("DESK_NUDGE_TO", "no-at-sign"),
