diff --git a/tests/test_setting_reader_guard.py b/tests/test_setting_reader_guard.py
new file mode 100644
index 0000000..e059467
--- /dev/null
+++ b/tests/test_setting_reader_guard.py
@@ -0,0 +1,123 @@
+"""Class guard: nothing reads a DESK_* setting outside the readers that turn a refusal into a plain line.
+
+The bug class (a bad setting reaching a person as a traceback) comes back whenever a new program reads the settings with
+the bare reader. This test walks the syntax tree of every Python file under src/, scripts/, load_tools/, demo_only/, tools/
+and the launchers in tests/, and finds: a call of `Config.from_env` (also through an alias of `Config`), a bare `from_env`
+call, and a read of a name that starts with DESK_ or LEAD_DESK_ from `os.environ` or `os.getenv`. The three modules that
+ARE the readers (config.py, envnum.py, config_exit.py) are skipped as files; every other hit must be on the allow-list below
+by file AND exact source line, with its reason. There is no whole-file exemption, and an allowance that no longer matches a
+hit fails the test (so it cannot go stale). The shell and PowerShell scripts are checked by text for `Config.from_env`.
+"""
+
+from __future__ import annotations
+
+import ast
+import re
+from pathlib import Path
+
+from support import REPO
+
+READER_FILES = {"src/lead_desk/config.py", "src/lead_desk/envnum.py", "src/lead_desk/config_exit.py"}
+ROOTS = ("src", "scripts", "load_tools", "demo_only", "tools")
+PREFIXES = ("DESK_", "LEAD_DESK_")
+
+# (file, exact stripped source line) -> reason
+ALLOWED: dict[tuple[str, str], str] = {
+    (
+        "src/lead_desk/server.py",
+        "config = Config.from_env()",
+    ): "server.main: the refusal is caught on the next line and worded by _refuse (the shared formatter), exit 4",
+    (
+        "scripts/run_real_check.py",
+        'desk_config = Config.from_env({**env, "DESK_PORT": "0"})',
+    ): "reads a config FILE inside its own refusal block (except ValueError, prints `refused: ...`, its own exit code)",
+    (
+        "load_tools/check_invariants.py",
+        'a.model_required = os.environ.get("DESK_QUALIFIER") == "live_claude" or _facts_say_live(facts_path)',
+    ): "compares DESK_QUALIFIER with one word as plain text; no parse, cannot fail",
+    (
+        "load_tools/load_driver.py",
+        'qualifier=os.environ.get("DESK_QUALIFIER", ""),  # lets the checker know the AI step was live',
+    ): "copies DESK_QUALIFIER as plain text into a report; no parse, cannot fail",
+}
+
+
+def _python_files() -> list[Path]:
+    files: list[Path] = []
+    for root in ROOTS:
+        files += sorted((REPO / root).rglob("*.py"))
+    files += sorted((REPO / "tests").glob("*launcher*.py"))
+    return [f for f in files if f.relative_to(REPO).as_posix() not in READER_FILES and "__pycache__" not in f.parts]
+
+
+def _is_environ(node: ast.AST) -> bool:
+    if isinstance(node, ast.Attribute):
+        return node.attr == "environ"
+    return isinstance(node, ast.Name) and node.id == "environ"
+
+
+def _desk_name(node: ast.AST | None) -> bool:
+    return isinstance(node, ast.Constant) and isinstance(node.value, str) and node.value.startswith(PREFIXES)
+
+
+def hits_in(source: str) -> list[tuple[int, str]]:
+    """(line number, what) of every bare read of the settings in one Python source text."""
+    tree = ast.parse(source)
+    config_names = {"Config"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom) and node.module and node.module.endswith("config"):
+            config_names |= {a.asname for a in node.names if a.name == "Config" and a.asname}
+        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Name) and node.value.id in config_names:
+            config_names |= {t.id for t in node.targets if isinstance(t, ast.Name)}
+    found: list[tuple[int, str]] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            fn = node.func
+            if isinstance(fn, ast.Attribute) and fn.attr == "from_env" and isinstance(fn.value, ast.Name) and fn.value.id in config_names:
+                found.append((node.lineno, "Config.from_env"))
+            if isinstance(fn, ast.Name) and fn.id == "from_env":
+                found.append((node.lineno, "bare from_env"))
+            first = node.args[0] if node.args else None
+            if isinstance(fn, ast.Attribute) and fn.attr == "get" and _is_environ(fn.value) and _desk_name(first):
+                found.append((node.lineno, "environ.get"))
+            if isinstance(fn, ast.Attribute) and fn.attr == "getenv" and _desk_name(first):
+                found.append((node.lineno, "getenv"))
+            if isinstance(fn, ast.Name) and fn.id == "getenv" and _desk_name(first):
+                found.append((node.lineno, "getenv"))
+        if isinstance(node, ast.Subscript) and _is_environ(node.value) and _desk_name(node.slice):
+            found.append((node.lineno, "environ[...]"))
+    return found
+
+
+def test_the_detector_finds_each_kind_of_bare_read() -> None:
+    src = (
+        "import os\nfrom os import environ, getenv\nfrom lead_desk.config import Config as C\nX = C\n"
+        "a = C.from_env()\nb = X.from_env({})\nc = from_env()\nd = os.environ['DESK_PORT']\n"
+        "e = os.environ.get('DESK_BIND')\nf = getenv('LEAD_DESK_X')\ng = environ['DESK_Y']\nh = os.environ['HOME']\n"
+    )
+    assert sorted(line for line, _ in hits_in(src)) == [5, 6, 7, 8, 9, 10, 11]
+
+
+def test_no_program_reads_the_settings_outside_the_readers() -> None:
+    offenders: list[str] = []
+    used: set[tuple[str, str]] = set()
+    for path in _python_files():
+        rel = path.relative_to(REPO).as_posix()
+        text = path.read_text(encoding="utf-8")
+        lines = text.splitlines()
+        for number, what in hits_in(text):
+            key = (rel, lines[number - 1].strip())
+            if key in ALLOWED:
+                used.add(key)
+            else:
+                offenders.append(f"{rel}:{number} {what}")
+    assert offenders == [], offenders
+    assert set(ALLOWED) == used, f"an allowance matches nothing now: {sorted(set(ALLOWED) - used)}"
+
+
+def test_the_shell_and_powershell_scripts_never_call_the_bare_reader() -> None:
+    bare = re.compile(r"Config\.from_env\(")
+    for path in sorted((REPO / "scripts").iterdir()):
+        if path.suffix in {".sh", ".ps1"}:
+            assert not bare.search(path.read_text(encoding="utf-8")), path.name
+            assert "config_or_exit" in path.read_text(encoding="utf-8") or path.name not in {"start_all.sh", "start_all.ps1", "reset.sh", "reset.ps1"}
diff --git a/tests/test_start_all_late_refusal.py b/tests/test_start_all_late_refusal.py
new file mode 100644
index 0000000..d8fa471
--- /dev/null
+++ b/tests/test_start_all_late_refusal.py
@@ -0,0 +1,145 @@
+"""scripts/start_all.sh must tell the truth when the desk it just started ends at once.
+
+Bug class: a script starts a background program, prints "started" and exits 0 without looking at it again, so a desk that
+refuses a late setting (a leadflow file, an approvers file, a public bind address, a sender address) or cannot take its
+port is reported as running. The rule: wait (bounded) until the desk says it is listening; if it ends first, print ONE
+line with its last log line and its own exit code, stop what the script started, delete the two process-id files the
+script wrote, and exit with the desk's code (the codes of `constants.EXIT_CODE_TABLE`, family "desk"). Made-up data, loopback
+only, throwaway folders under tmp_path; every process a test starts is stopped by that test.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import signal
+import socket
+import subprocess
+import sys
+import time
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env, free_port
+
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED, EXIT_PORT_UNAVAILABLE
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="start_all.sh is the non-Windows script")
+LOOPBACK = "127.0.0.1"
+
+
+LAST_RUN_SECONDS: list[float] = []
+
+
+def _run(tmp: Path, *, first_on_path: Path | None = None, **settings: str) -> subprocess.CompletedProcess[str]:
+    env = child_env(
+        DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_PORT=str(free_port()), DESK_FAKES_PORT=str(free_port())
+    )
+    env.pop("DESK_NUDGE_TO", None)
+    env.update(settings)
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    if first_on_path is not None:
+        env["PATH"] = str(first_on_path) + os.pathsep + env["PATH"]
+    began = time.monotonic()
+    done = subprocess.run(  # noqa: S603, S607 - our own script, made-up values, throwaway folder
+        ["bash", str(REPO / "scripts" / "start_all.sh")],
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        stdin=subprocess.DEVNULL,
+        check=False,
+    )
+    LAST_RUN_SECONDS[:] = [time.monotonic() - began]
+    return done
+
+
+def _answers(port: int) -> bool:
+    with contextlib.suppress(OSError), socket.create_connection((LOOPBACK, port), timeout=0.5):
+        return True
+    return False
+
+
+def _stop_started(tmp: Path) -> None:
+    """Whatever a test left running: only the process ids the script itself wrote."""
+    for name in ("desk", "fakes"):
+        pid_file = tmp / "data" / f"{name}.pid"
+        if pid_file.exists():
+            with contextlib.suppress(ValueError, OSError):
+                os.kill(int(pid_file.read_text(encoding="utf-8").strip()), signal.SIGKILL)
+
+
+@pytest.fixture
+def cleanup(tmp_path: Path) -> Iterator[None]:
+    yield
+    _stop_started(tmp_path)
+
+
+def _assert_failed_start(done: subprocess.CompletedProcess[str], tmp: Path, code: int, fakes_port: int) -> None:
+    out = done.stdout + done.stderr
+    assert done.returncode == code, (done.returncode, out[-600:])
+    assert "started:" not in out and "Traceback" not in out, out[-600:]
+    lines = [ln for ln in done.stderr.splitlines() if ln.strip()]
+    assert len(lines) == 1 and lines[0].startswith("the desk ended at once (exit "), lines
+    assert f"(exit {code})" in lines[0] and len(lines[0]) < 400
+    assert not (tmp / "data" / "desk.pid").exists() and not (tmp / "data" / "fakes.pid").exists()  # its own, removed
+    assert not _answers(fakes_port), "the demo server the script started is still running"
+    assert LAST_RUN_SECONDS[0] < 12, LAST_RUN_SECONDS  # it sees the desk end; it does not sit out the 15 second wait
+
+
+LATE_REFUSALS: list[tuple[str, dict[str, str]]] = [
+    ("leadflow_file_missing", {"DESK_LEADFLOW_FILE": "no-such-file.json"}),
+    ("approvers_file_missing", {"DESK_LATER_MODE": "approval", "DESK_APPROVERS_FILE": "no-such-approvers.json"}),
+    ("public_bind", {"DESK_BIND": "0.0.0.0", "DESK_CRM": "hubspot"}),  # noqa: S104 - the refusal of this value is tested
+    ("sender_address", {"DESK_OUTBOX": "smtp", "DESK_SMTP_HOST": "127.0.0.1", "DESK_SMTP_FROM": "no-at-sign"}),
+]
+
+
+@pytest.mark.parametrize(("label", "settings"), LATE_REFUSALS, ids=[n for n, _ in LATE_REFUSALS])
+def test_a_desk_that_refuses_a_late_setting_is_reported_not_started(
+    label: str, settings: dict[str, str], tmp_path: Path, cleanup: None
+) -> None:
+    fakes_port = free_port()
+    done = _run(tmp_path, DESK_FAKES_PORT=str(fakes_port), **settings)
+    _assert_failed_start(done, tmp_path, EXIT_DESK_SETTING_REFUSED, fakes_port)
+    assert "refuses" in done.stderr, label  # the desk's own last line, so the reason is visible
+
+
+def test_a_desk_that_cannot_take_its_port_is_reported_with_its_own_code(tmp_path: Path, cleanup: None) -> None:
+    fakes_port = free_port()
+    with socket.socket() as taken:
+        taken.bind((LOOPBACK, 0))
+        taken.listen()
+        done = _run(tmp_path, DESK_PORT=str(taken.getsockname()[1]), DESK_FAKES_PORT=str(fakes_port))
+    _assert_failed_start(done, tmp_path, EXIT_PORT_UNAVAILABLE, fakes_port)
+    assert "cannot bind" in done.stderr
+
+
+def test_a_desk_that_listens_is_started(tmp_path: Path, cleanup: None) -> None:
+    done = _run(tmp_path)
+    assert done.returncode == 0 and "started:" in done.stdout, (done.stdout, done.stderr)
+    assert (tmp_path / "data" / "desk.pid").exists() and (tmp_path / "data" / "fakes.pid").exists()
+
+
+def test_a_desk_that_never_listens_is_reported_after_the_wait_and_left_for_reset(tmp_path: Path, cleanup: None) -> None:
+    """The honest timeout path: a stand-in `python` makes the desk sleep without a word. After the fixed wait (15 s) the
+    script says so, exits 1 and leaves the processes alone for reset.sh (they are stopped by this test)."""
+    stub_dir = tmp_path / "stub"
+    stub_dir.mkdir()
+    stub = stub_dir / "python"
+    stub.write_text(
+        f'#!/bin/bash\nif [[ "$*" == *lead_desk.server* ]]; then exec sleep 120; fi\nexec {sys.executable} "$@"\n',
+        encoding="utf-8",
+    )
+    stub.chmod(0o755)
+    done = _run(tmp_path, first_on_path=stub_dir)
+    assert done.returncode == 1 and "desk not ready after 15 seconds" in done.stderr, (done.stdout, done.stderr)
+    assert "started:" not in done.stdout
+    assert (tmp_path / "data" / "desk.pid").exists()  # left for reset.sh
+
+
+def test_the_start_script_waits_for_the_listening_line_and_not_longer_than_a_fixed_time() -> None:
+    text = (REPO / "scripts" / "start_all.sh").read_text(encoding="utf-8")
+    assert "WAIT_SECONDS=15" in text and "desk listening on" in text and 'wait "$desk_pid"' in text
