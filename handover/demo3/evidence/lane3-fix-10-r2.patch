+def _run(
+    argv: list[str], tmp: Path, setting: str, value: str, *, with_bash: bool = False
+) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_LEADFLOW_FILE=FLOW)
+    env.pop("DESK_NUDGE_TO", None)
+    env[setting] = value
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    cmd = ["bash", str(SCRIPTS / argv[0])] if with_bash else [sys.executable, *argv]
+    return subprocess.run(  # noqa: S603 - fixed argv built above, made-up values
+        cmd,
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+    )
