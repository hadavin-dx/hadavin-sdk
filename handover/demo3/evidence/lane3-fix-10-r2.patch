+
+# THE table of process exit codes: (family, code, meaning). A family is one program or group of programs; inside a
+# family a code has one meaning (tests/test_exit_code_table.py checks that, that the scripts only use codes listed
+# here, and that EXIT_SCRIPT_SETTING_REFUSED is listed once and used by no other family). Family "desk" is
+# `python -m lead_desk.server` (also what start_all passes on when the desk it started ends at once); family "reset"
+# is scripts/reset.sh, reset.ps1 and reset_check.py; family "script" is every script that reads the DESK_* settings.
+EXIT_CODE_TABLE: Final[tuple[tuple[str, int, str], ...]] = (
+    ("desk", 1, "the sender cannot be reached, or a Python traceback"),
+    ("desk", EXIT_ANOTHER_DESK, "another desk holds the lock file"),
+    ("desk", EXIT_SETTING_REFUSED, "the open-file limit is too low"),
+    ("desk", EXIT_DESK_SETTING_REFUSED, "the desk refused a setting"),
+    ("desk", EXIT_PORT_UNAVAILABLE, "the port could not be bound"),
+    ("desk", EXIT_SIMULATED_KILL, "the crash script ended the desk on purpose"),
+    ("reset", 2, "refused before anything was stopped or deleted"),
+    ("reset", 3, "a process still holds the database, or the lock file cannot be tested"),
+    ("reset", 4, "something still answers on a port"),
+    ("reset", 5, "a process did not stop in time"),
+    ("reset", 6, "a pid file names another program"),
+    ("script", EXIT_SCRIPT_SETTING_REFUSED, "a DESK_* setting was refused while a script read it"),
+)
+
+# The same cause, a refused DESK_* setting, and the number each program returns for it (tests/test_exit_code_table.py
+# and tests/test_bad_setting_entry_points.py run every program and compare). Two numbers on purpose: the desk keeps
+# its existing 4; every script that reads the settings itself returns 8, because 2 to 6 already mean other things in the
+# reset family. start_all passes on the desk's own 4 when the desk it started refuses a setting after the script's
+# own reading passed (a leadflow file, an approvers file, a sender address, a public bind address).
+SETTING_REFUSED_EXIT_BY_PROGRAM: Final[dict[str, int]] = {
+    "python -m lead_desk.server": EXIT_DESK_SETTING_REFUSED,
+    "tests/crash_launcher.py": EXIT_DESK_SETTING_REFUSED,
+    "scripts/crash_desk.py": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/feed.py": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/reset_check.py": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/reset.sh": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/reset.ps1": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/start_all.sh": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/start_all.ps1": EXIT_SCRIPT_SETTING_REFUSED,
+    "scripts/start_all.sh (late refusal by the desk)": EXIT_DESK_SETTING_REFUSED,
+    "scripts/start_all.ps1 (late refusal by the desk)": EXIT_DESK_SETTING_REFUSED,
+}
 
 # Field limits
 SOURCE_REF_MIN: Final = 1
