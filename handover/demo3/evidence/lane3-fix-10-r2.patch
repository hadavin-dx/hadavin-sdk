new file mode 100644
index 0000000..692377f
--- /dev/null
+++ b/src/lead_desk/config_exit.py
@@ -0,0 +1,78 @@
+"""The one place that words a refused DESK_* setting, and the one way for a script to read the settings.
+
+`Config.from_env` raises `SettingRefused` for a bad value. A program that lets that error out shows the person a Python
+traceback. Every program that reads the settings turns the refusal into ONE plain line and an exit code:
+`server.main` (the desk itself) and `config_or_exit` (scripts/*.py and the `python -c` helper calls in scripts/*.sh and
+scripts/*.ps1). Both build the line with `refusal_line`, so the same bad value gives the same words everywhere: one
+line, cut to LINE_MAX characters, no value (a setting value of three or more characters, in the forms it can take in
+a message, is replaced by "<value>"; the message names the setting only).
+
+Two streams, on purpose, each for one reason. The desk prints its refusal on the OUTPUT stream (stdout), like every
+other start-up message it prints; scripts/start_all.sh keeps all of them in desk.log and the desk tests read stdout.
+The helper (`config_or_exit`) prints on the ERROR stream (stderr), because a shell reads a setting with
+`$(python -c ...)` and a command substitution swallows stdout, so the person would see nothing.
+
+Exit codes (one table: `constants.EXIT_CODE_TABLE`): the desk's own refusal is 4 (`EXIT_DESK_SETTING_REFUSED`, in
+`server.main`); a script that reads a setting and finds it refused exits with 8 (`EXIT_SCRIPT_SETTING_REFUSED`), a code
+no other program uses. `start_all` passes on the desk's own code (4) when the desk it started refused a setting."""
+
+from __future__ import annotations
+
+import os
+import re
+import sys
+from collections.abc import Mapping
+
+from lead_desk.config import Config
+from lead_desk.constants import EXIT_SCRIPT_SETTING_REFUSED
+from lead_desk.envnum import SettingRefused
+
+LINE_MAX = 200
+SCRUB_MIN_CHARS = 3  # a value of one or two characters ("0", "no") is also ordinary text in a message
+VALUE_MARK = "<value>"
+_SETTING_NAME = re.compile(r"\b((?:LEAD_)?DESK_[A-Z0-9_]+)")  # a setting name is kept as it is
+
+
+def _forms(value: str) -> set[str]:
+    """The ways a value can appear in an error message: as typed, as Python shows it (repr), and escaped."""
+    forms = {value, repr(value)[1:-1], ascii(value)[1:-1], value.encode("unicode_escape", "backslashreplace").decode()}
+    return {f for f in forms if len(f) >= SCRUB_MIN_CHARS}
+
+
+def _pattern(form: str) -> re.Pattern[str]:
+    """The form as a whole token: not a part of a longer word ("low" is a value, "allows" is a word of the message)."""
+    before = r"(?<![A-Za-z0-9])" if form[0].isalnum() else ""
+    after = r"(?![A-Za-z0-9])" if form[-1].isalnum() else ""
+    return re.compile(before + re.escape(form) + after)
+
+
+def scrub_values(text: str, env: Mapping[str, str]) -> str:
+    """`text` without any DESK_* / LEAD_DESK_* setting value of the environment (three characters or more) in the three
+    forms above. Setting names inside the text are left alone."""
+    forms: set[str] = set()
+    for name, value in env.items():
+        if name.startswith(("DESK_", "LEAD_DESK_")) and isinstance(value, str) and len(value) >= SCRUB_MIN_CHARS:
+            forms |= _forms(value)
+    ordered = sorted(forms, key=len, reverse=True)
+    parts = _SETTING_NAME.split(text)  # odd items are the setting names
+    for i in range(0, len(parts), 2):
+        for form in ordered:
+            parts[i] = _pattern(form).sub(VALUE_MARK, parts[i])
+    return "".join(parts)
+
+
+def refusal_line(prefix: str, reason: object, values: Mapping[str, str] | None = None) -> str:
+    """`<prefix> <reason>` as ONE line of at most LINE_MAX characters of reason: values scrubbed, line ends and runs of
+    spaces collapsed. `prefix` is "the desk refuses a setting:" or "the desk refuses to start:"."""
+    text = " ".join(scrub_values(str(reason), values or {}).split())[:LINE_MAX]
+    return f"{prefix} {text}"
+
+
+def config_or_exit(env: Mapping[str, str] | None = None) -> Config:
+    """`Config.from_env(env)`, or the plain refusal on the error stream and `SystemExit(EXIT_SCRIPT_SETTING_REFUSED)`."""
+    try:
+        return Config.from_env(env)
+    except SettingRefused as e:
+        line = refusal_line("the desk refuses a setting:", e, os.environ if env is None else env)
+        print(line, file=sys.stderr, flush=True)
+        raise SystemExit(EXIT_SCRIPT_SETTING_REFUSED) from None
