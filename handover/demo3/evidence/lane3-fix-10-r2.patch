new file mode 100644
index 0000000..bf37d92
--- /dev/null
+++ b/tests/test_bad_setting_entry_points.py
@@ -0,0 +1,370 @@
+"""A bad DESK_* value must end every start-up script cleanly, never with a Python traceback.
+
+Bug class: a bad setting value (a person's typing mistake) reaches the person as a raw Python error, because the
+script read the settings by itself, outside the one place that turns a refused setting into a plain message.
+The rule for every entry point that reads the DESK_* settings: ONE line that names the setting, no traceback, and the
+value is never repeated (it may be an e-mail address). The code is the desk's own 4 for `python -m lead_desk.server` (and
+the launcher that calls it) and the script reader's 8 (`EXIT_SCRIPT_SETTING_REFUSED`) for every script; the table is
+`constants.EXIT_CODE_TABLE`. Made-up values only; loopback only; no network is reached because every run stops at the check.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk.config import Config
+from lead_desk.config_exit import config_or_exit
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED, EXIT_SCRIPT_SETTING_REFUSED
+
