+def _paragraphs(lines: list[str]) -> list[tuple[int, str]]:
+    """(first line number from 0, text) of each paragraph: a run of lines up to a blank line, a heading, a table row
+    or a list item, so a sentence wrapped over several lines is read as one."""
+    out: list[tuple[int, list[str]]] = []
+    current: list[str] | None = None
+    for i, ln in enumerate(lines):
+        starts_new = not ln.strip() or ln.startswith(("#", "|", "* ", "- ")) or re.match(r"\d+\. ", ln) is not None
+        if not ln.strip():
+            current = None
+            continue
+        if current is None or starts_new:
+            current = [ln]
+            out.append((i, current))
+        else:
+            current.append(ln)
+    return [(i, " ".join(parts)) for i, parts in out]
