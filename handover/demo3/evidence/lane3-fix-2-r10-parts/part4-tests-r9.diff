+def _no_network(monkeypatch: pytest.MonkeyPatch) -> None:
+    from lead_desk import server
+
+    def must_not_serve(*a: Any, **k: Any) -> Any:
+        raise AssertionError("the desk went on to bind a port although the key file is bad")
+
+    monkeypatch.setattr(server, "make_server", must_not_serve)  # a missing check must fail the test, not serve forever
+
+    def no_network(*a: Any, **k: Any) -> Any:
+        raise AssertionError("a server was called before the key file was checked")
+
+    monkeypatch.setattr(socket.socket, "connect", no_network)
+    monkeypatch.setattr(socket, "create_connection", no_network)
+
+
+def _desk_env(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, bad_key: Path) -> None:
+    for name in [n for n in os.environ if n.startswith("DESK_")]:
+        monkeypatch.delenv(name)
+    env = {
+        "DESK_DB_PATH": str(tmp_path / "book" / "desk.db"),
+        "DESK_PORT": "0",
+        "DESK_OUTBOX": "smtp",
+        "DESK_CRM": "hubspot",
+        "DESK_HUBSPOT_KEY_FILE": str(bad_key),
+        "DESK_HUBSPOT_MAX_CALLS": "9",
+        "DESK_HUBSPOT_BASE_URL": "http://127.0.0.1:1",
+        "DESK_HUBSPOT_ALLOW_ANY_BASE_URL": "yes",
+    }
+    for k, v in env.items():
+        monkeypatch.setenv(k, v)
+
+
+@POSIX
+def test_server_main_with_the_smtp_sender_exits_4_on_a_bad_key_file_before_any_demo_server_is_called(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """The documented claim run through `server.main` itself: the bad HubSpot key file ends the start with exit code 4
+    and the key-file text, not with exit code 1 and "cannot reach the demo servers"; no connection is made."""
+    from lead_desk import server
+
+    _desk_env(monkeypatch, tmp_path, _key_file(tmp_path, 0o644))
+    _no_network(monkeypatch)
+    with pytest.raises(SystemExit) as e:
+        server.main()
+    out = capsys.readouterr().out
+    assert e.value.code == 4, out
+    assert "cannot reach the demo servers" not in out
+    assert out.strip().startswith("the desk refuses a setting: ") and USED in out, out
+    assert str(tmp_path) not in out
+
+
