+def _key_file_result(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, data: bytes) -> str:
+    """What scripts/n8n_api.py `_read_key` does with a key file holding `data`: the key it reads, or the refusal."""
+    path = tmp_path / "key-file.txt"
+    path.write_bytes(data)
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(path))
+    monkeypatch.delenv("N8N_URL", raising=False)
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    try:
+        module = importlib.import_module("n8n_api")
+    except SystemExit as refused:
+        return f"refused: {refused}"
+    finally:
+        sys.modules.pop("n8n_api", None)
+    return f"key: {module.KEY}"
+
+
+KEY_FILE_CASES = {
+    "plain": (b"abc123KEYtext", "key: abc123KEYtext"),
+    "line break at the end": (b"abc123KEYtext\n", "key: abc123KEYtext"),
+    "spaces and line breaks around it": (b"  abc123KEYtext \r\n\n", "key: abc123KEYtext"),
+    "space inside": (b"abc 123", "refused"),
+    "second line of text": (b"abc123\nsecond", "refused"),
+    "control character": (b"abc\x00123", "refused"),
+    "letter that is not ASCII": ("abc\u00e9123".encode(), "refused"),
+    "byte-order mark first": (b"\xef\xbb\xbfabc123", "refused"),
+    "empty": (b"\n", "refused"),
+    "longer than 4096": (b"k" * 4097, "refused"),
+}
+
+
+@pytest.mark.parametrize("case", list(KEY_FILE_CASES))
+def test_the_key_file_rules_in_the_recipe_are_what_the_script_does(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, case: str
+) -> None:
+    data, expected = KEY_FILE_CASES[case]
+    result = _key_file_result(monkeypatch, tmp_path, data)
+    if expected.startswith("key: "):
+        assert result == expected, f"premise: the script accepts the key file `{case}`: {result}"
+    else:
+        assert result.startswith("refused: ") and "n8n API key file" in result, f"premise: refused `{case}`: {result}"
+        assert "abc" not in result and "kkkk" not in result, "premise: the refusal does not show the key"
+
+
