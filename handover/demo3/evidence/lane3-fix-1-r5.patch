index 0000000..2a4d55c
--- /dev/null
+++ b/tests/test_docs_claims_lane3.py
@@ -0,0 +1,870 @@
+"""Facts in README.md, docs/limits.md and docs/n8n-recipe.md that earlier review readers found wrong or missing.
+
+How the tests work. Where a fact can be read from the code, the workflow files or a real desk, the test reads it there
+and then checks that the text states it. The text checks pin FACTS (numbers, field names, command names, file names)
+by regular expression, not the exact wording, so a rewrite in better words does not fail them but a wrong number does.
+Every assert on document text carries a message that starts with "this sentence protects:" and says which fact to keep
+if you reword the sentence. Asserts on code or files (tests named `premise_` and asserts whose message starts with
+"premise:") check that a file still has the shape the text relies on; they read files, not the text.
+No demo servers and no n8n are needed: the real desk is started as a child program against an in-process stand-in
+for the demo servers, on a free port, with made-up data only."""
+
+from __future__ import annotations
+
+import importlib
+import json
+import os
+import re
+import sqlite3
+import sys
+from pathlib import Path
+from typing import cast
+
+import pytest
+from conftest import Env
+from support import HOST, call, child_env, free_port, post_lead, start_proc, stop_proc, wait_until
+
+from demo_only import burst
+
+REPO = Path(__file__).resolve().parents[1]
+FIVE = ("received", "new", "duplicate", "review", "open")
+FIVE_NAMED = r"`received`, `new`, `duplicate`, `review` and `open`"
+
+
+def _p(what: str) -> str:
+    return f"this sentence protects: {what} (if you reword the sentence, keep this fact)"
+
+
+def _read(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def _line_with(text: str, start: str) -> str:
+    lines = [ln for ln in text.splitlines() if ln.lstrip().startswith(start)]
+    assert len(lines) == 1, f"premise: exactly one line starts with {start!r}, found {len(lines)}"
+    return lines[0]
+
+
+def _flat(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _search(pattern: str, text: str) -> re.Match[str]:
+    """re.search that must find something (so the result can be used without a type escape)."""
+    found = re.search(pattern, text)
+    assert found, f"premise: the pattern {pattern!r} must occur in the text"
+    return found
+
+
+def _between(text: str, start: str, end: str) -> str:
+    """The part of `text` from the line starting with `start` up to (not including) the line starting with `end`."""
+    lines = text.splitlines()
+    first = next(i for i, ln in enumerate(lines) if ln.lstrip().startswith(start))
+    last = next(i for i, ln in enumerate(lines) if i > first and ln.lstrip().startswith(end))
+    return _flat("\n".join(lines[first:last]))
+
+
+# ---- limits.md: exit code 1 names what the desk really prints ----
+
+
+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = {k: v for k, v in child_env().items() if not k.startswith("DESK_")}  # nothing of the tester's own settings
+    env.update(
+        DESK_PORT=str(free_port()),
+        DESK_FAKES_PORT=str(free_port()),  # nothing listens here: the demo servers are "not running"
+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    proc = start_proc(["-m", "lead_desk.server"], env)
+    try:
+        code = proc.wait(timeout=60)
+    finally:
+        output = stop_proc(proc).decode("utf-8", errors="replace")
+    if code == 3:  # the desk checks the open-file limit first (containers often allow only 4096)
+        pytest.skip(f"this computer's open-file limit is too low for the desk (exit 3): {output.strip()[-200:]}")
+    lines = output.strip().splitlines()
+    assert lines, f"premise: the desk printed nothing (exit {code})"
+    assert code == 1, f"premise: exit code 1 means the demo servers cannot be reached: {code}: {output[-200:]!r}"
+    printed = next((ln for ln in lines if ln.startswith("cannot reach the demo servers")), "")
+    assert printed, f"premise: the desk prints a line that starts with the words below: {lines[-3:]}"
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    bullet = _between(_read("docs/limits.md"), "* Exit codes of the desk:", "* Stopping:")
+    assert phrase in bullet, _p("limits.md quotes the words the desk prints for exit code 1")
+    assert "the sender cannot be reached" not in bullet, _p("the old word 'sender' for the demo servers is gone")
+    assert re.search(r"traceback.*program fault, or that someone edited a fixed value", bullet), _p(
+        "a traceback is a program fault OR an edited fixed value"
+    )
+    assert re.search(r"never caused by a `DESK_\*` setting[^;]*exit code 4", bullet), _p(
+        "a traceback is never caused by a DESK_* setting: a bad DESK_* value gives exit code 4"
+    )
+    assert "src/lead_desk/constants.py" in bullet and (REPO / "src/lead_desk/constants.py").exists(), _p(
+        "the edited fixed value lives in src/lead_desk/constants.py"
+    )
+    assert re.search(r"real CRM or a real mail sender[^.]*not described here", bullet), _p(
+        "what the desk prints for an unreachable real CRM or mail sender is not described (not claimed)"
+    )
+    for code, words in (
+        (2, "another desk holds the lock file"),
+        (3, "the open-file limit is too low"),
+        (4, "the desk refuses a setting"),
+        (5, "the port could not be bound within `BIND_RETRY_SECONDS`"),
+    ):
+        assert re.search(rf"\* Exit code {code}: {re.escape(words)}", bullet), _p(
+            f"exit code {code} is its own sub-bullet ('Exit code {code}: ...'), not part of the sentence of code 1"
+        )
+    assert re.search(r"\* Exit code 1: the demo servers cannot be reached", bullet), _p("exit code 1 is a sub-bullet")
+    assert "constant that is out of range" not in bullet, _p("no unexplained 'constant that is out of range'")
+
+
+# ---- one real desk: the facts of the README demo and of the burst steps ----
+
+
+def _start_real_desk(env: Env, tmp_path: Path) -> tuple[str, str]:
+    """The README desk as a child program, with the demo servers stood in for by the tests' own server.
+    Returns the desk's address and the address of that stand-in server."""
+    _, fakes_url = env.fakes("keyed")
+    port = free_port()
+    env_vars = child_env(
+        DESK_DB_PATH=str(tmp_path / "desk.sqlite3"), DESK_BIND=HOST, DESK_PORT=str(port), DESK_FAKES_URL=fakes_url
+    )
+    proc = start_proc(["-m", "lead_desk.server"], env_vars)
+    env.stop_on_close(lambda: stop_proc(proc))
+    base = f"http://{HOST}:{port}"
+    wait_until(lambda: proc.poll() is not None or call(base, "GET", "/counts")[0] == 200, what="desk ready")
+    assert proc.poll() is None, "premise: the README desk starts with the demo settings"
+    return base, fakes_url
+
+
+def test_the_fresh_desk_counts_are_what_the_readme_says(env: Env, tmp_path: Path) -> None:
+    base, _ = _start_real_desk(env, tmp_path)
+    status, reply = call(base, "GET", "/counts")
+    assert status == 200, "premise: the counts check answers HTTP 200"
+    for name in FIVE:
+        assert reply[name] == 0, f"premise: the five counts are 0 on a fresh desk: {name}"
+    time_field = "last_reaper_pass_at"
+    others = [
+        key
+        for key, value in reply.items()
+        if isinstance(value, int) and not isinstance(value, bool) and key not in FIVE and key != time_field
+    ]
+    assert others, "premise: there are other counts besides the five counts"
+    for name in others:
+        assert reply[name] == 0, f"premise: every other count is 0 on a fresh desk: {name}"
+    assert all(v == 0 for v in reply["hung_workers"].values()), "premise: the numbers inside hung_workers are 0"
+    assert len(reply["hung_workers"]) == 4, "premise: hung_workers holds four numbers"
+    server_text = _read("src/lead_desk/server.py")
+    assert server_text.index("desk.start_background()") < server_text.index("server.serve_forever()"), (
+        "premise: the Reaper is started before the desk serves its first request"
+    )
+    wait_until(lambda: call(base, "GET", "/counts")[1]["reaper_running"] is True, what="reaper running")
+    reply = call(base, "GET", "/counts")[1]
+    assert reply[time_field] is None or isinstance(reply[time_field], int), "premise: a time in seconds, or null"
+    assert reply["expected_match"] is None and reply["ok"] is None, "premise: expected_match and ok are null"
+
+    readme = _read("README.md")
+    linux = _between(readme, "**Linux**", "**Windows PowerShell**")
+    assert FIVE_NAMED in linux and re.search(r"are 0\. So are the other counts", linux), _p(
+        "the five counts are named and the other counts are 0 too"
+    )
+    for name in ("rejected_envelopes", "failed_followups", "hung_workers"):
+        assert name in linux and name in reply, _p(f"the Linux text names the real field {name}")
+    for key in reply["hung_workers"]:
+        assert re.search(rf"\b{key}\b", linux.split("hung_workers")[1][:200]), _p(f"hung_workers names its kind {key}")
+    assert re.search(r"`reaper_running` is `true`", linux), _p("`reaper_running` is stated as true")
+    assert re.search(r"^\* \*\*Reaper\*\*: ", readme, re.M), _p("the word list defines the Reaper")
+    assert re.search(r"says `false` and still does after 10 seconds, read `data/desk.log`", linux), _p(
+        "a reaper_running that is false is waited for 10 seconds, then data/desk.log is read"
+    )
+    assert "It can take a second after the first answer" not in linux, _p(
+        "the unfounded 'it can take a second' is gone (the Reaper starts before the desk listens)"
+    )
+    assert re.search(r"no such line \(curl prints `curl: \(7\)` or nothing\), read `data/desk.log`", linux), _p(
+        "when the wait loop ends without a 200, curl prints curl: (7) or nothing: read data/desk.log"
+    )
+    assert re.search(rf"`{time_field}` is not a count[^.]*\(a large number\), or `null`", linux), _p(
+        f"{time_field} is a time, not a count, and can be null"
+    )
+    assert "`expected_match` and `ok` are `null`" in linux, _p("expected_match and ok are null")
+    assert not re.search(r"\bnot 0\b", linux) and "are not counts of leads" not in linux, _p(
+        "the old false 'not 0' claim is gone"
+    )
+    windows = _flat(_line_with(readme, "Start-Sleep 3; Invoke-WebRequest"))
+    assert FIVE_NAMED in windows and re.search(r"the other number fields are 0 too", windows), _p(
+        "the Windows line names the five counts and says the other number fields are 0 too"
+    )
+    for name in (time_field, "expected_match", "ok", "hung_workers", "reaper_running"):
+        assert name in windows, _p(f"the Windows line names {name}")
+    assert re.search(r"model, crm, send, refresh", windows), _p("the Windows line names the four hung_workers kinds")
+    assert re.search(r"except `last_reaper_pass_at` \(a time, not a count\)", windows), _p(
+        "the Windows line excepts last_reaper_pass_at"
+    )
+
+
+def test_the_second_feed_and_the_receipt_number_match_the_real_desk(env: Env, tmp_path: Path) -> None:
+    base, _ = _start_real_desk(env, tmp_path)
+    one = {"name": "Ada Example", "email": "ada@example.test", "phone": "555 0100", "company": "Example Ltd"}
+    first = post_lead(base, "form", "canned-1", one)  # feed.py: the request id is canned-<index> on both doors
+    again = post_lead(base, "form", "canned-1", one)  # the same request id: a replay
+    other_door = post_lead(base, "webhook", "canned-1", one)  # same person, same id, the other door
+    assert first[0] == 201 and first[1]["verdict"] == "new", "premise: a new lead answers 201 new"
+    assert again[0] == 201 and again[1].get("replayed") is True, "premise: a replay of a `new` answers 201 replayed"
+    assert again[1]["receipt_id"] == first[1]["receipt_id"] == 1, "premise: the replay shows the FIRST receipt's number"
+    assert other_door[0] == 200 and other_door[1]["verdict"] == "duplicate", "premise: a duplicate answers 200"
+    counts = call(base, "GET", "/counts")[1]
+    assert (counts["received"], counts["new"], counts["duplicate"]) == (2, 1, 1), _p(
+        "README: received 2, new 1, duplicate 1 (a replay is not counted again)"
+    )
+    receipt = other_door[1]["receipt_id"]
+    assert receipt == 3, _p("README: the other door's receipt_id is 3, not 2 (the repeat used up the number 2)")
+    with sqlite3.connect(tmp_path / "desk.sqlite3") as db:
+        rows = db.execute("SELECT receipt_id, attempts FROM receipts ORDER BY receipt_id").fetchall()
+    assert rows == [(1, 2), (3, 1)], (
+        f"premise: the repeat updated receipt 1 (attempts 2), number 2 was never stored, the webhook lead is 3: {rows}"
+    )
+    assert "ON CONFLICT(source, source_ref) DO UPDATE SET attempts = attempts + 1" in _read("src/lead_desk/desk.py"), (
+        "premise: a repeat updates the first row instead of inserting (reads desk.py, not the text)"
+    )
+    assert "(SELECT count(*) FROM receipts)," in _read("src/lead_desk/desk.py"), (
+        "premise: `received` is the number of stored receipts"
+    )
+    assert "receipt_id INTEGER PRIMARY KEY AUTOINCREMENT" in _read("src/lead_desk/schema.sql"), (
+        "premise: receipt numbers only go up (reads the schema file, not the text)"
+    )
+
+    readme = _read("README.md")
+    webhook_lines = (
+        ("Linux", "python scripts/feed.py --source webhook"),
+        ("Windows", r"python scripts\feed.py --source webhook"),
+    )
