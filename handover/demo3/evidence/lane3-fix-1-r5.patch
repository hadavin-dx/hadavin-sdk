+def test_readme_port_check_explains_000_and_404() -> None:
+    readme = _read("README.md")
+    linux = readme.split("**Linux**")[1].split("**Windows PowerShell**")[0]
+    assert "curl " in linux, "premise: the Linux block uses curl (reads the block, not the 'You need' sentence)"
+    lines = readme.splitlines()
+    first = next(i for i, ln in enumerate(lines) if ln.startswith("You need Linux or Windows"))
+    clone = next(i for i, ln in enumerate(lines) if i > first and ln.startswith("2. Run `git clone"))
+    check = next(i for i, ln in enumerate(lines) if i > first and ln.startswith("3. Check that ports 8765 and 8766"))
+    last = next(i for i, ln in enumerate(lines) if i > check and ln.startswith("4. Open ONE terminal"))
+    assert first < clone < check < last, _p("the port check is step 3, AFTER the clone step (the folder exists then)")
+    chunk = lines[first : first + 1] + lines[check:last]
+    need = _flat("\n".join(chunk))
+    bullets = [ln for ln in chunk if ln.startswith("   * ")]
+    assert "Step 3 below checks this" in need, _p("the requirements sentence points to step 3 for the check")
+    assert len(bullets) >= 4, _p("the port check is a bullet list (Linux, 000, other number, Windows)")
+    assert "`curl`" in need, _p("curl is listed as needed on Linux")
+    assert "8765" in need and "http_code" in need, _p("the port check command is shown")
+    assert re.search(r"curl -s --max-time 5 -o /dev/null -w", need), _p("the port check has a time limit of 5 seconds")
+    assert re.search(r"`000` usually means nothing is listening", need), _p("000 usually means nothing is listening")
+    assert re.search(r"usually when no answer comes within the 5 seconds", need), _p(
+        "000 usually (not always: exit 28 was not reproduced) also means no answer in time"
+    )
+    assert re.search(r"does not speak web", need), _p("000 can also mean a program that does not speak web")
+    assert re.search(
+        r"it answers 404 for `/`, and so do the demo servers on 8766 \(both codes were read on 2026-11-13", need
+    ), _p(
+        "the 404 claim names its source: read from a real desk and a real demo server, on Linux, not on Windows"
+    )
+    assert re.search(r"404 means a program already answers", need) and "bash scripts/reset.sh" in need, _p(
+        "404 means a program answers; the earlier desk is that program; otherwise stop it or reset"
+    )
+    assert re.search(r"reset\.sh` here, in the project folder \(you are in it after step 2\)", need), _p(
+        "the reset remedy is run in the project folder, which exists after the clone step"
+    )
+    assert re.search(r"If nothing uses the two ports, both checks print `000`", need), _p(
+        "on a first run, with nothing on the ports, both checks print 000"
+    )
+    assert re.search(r"Windows: no tested check", need), _p("Windows has no tested check (stated plainly)")
+    assert "how to check was not tried" not in need, _p("the old wording is gone")
+    assert "Get-NetTCPConnection -LocalPort 8765" in need, _p(
+        "the Windows port check is an idea, marked not tried"
+    )
+    assert re.search(r"makes curl print only the three-digit", need), _p("http_code is explained")
