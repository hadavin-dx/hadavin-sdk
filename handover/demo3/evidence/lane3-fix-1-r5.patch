+def test_the_recipe_curl_lines_send_the_two_example_inputs() -> None:
+    recipe = _read("docs/n8n-recipe.md")
+    flat = _flat(recipe)
+    form = json.loads(_line_with(recipe, "form:").split("form:", 1)[1])
+    hook = json.loads(_line_with(recipe, "webhook:").split("webhook:", 1)[1])
+    sent: dict[str, object] = {}
+    curls = [ln.strip() for ln in recipe.splitlines() if ln.strip().startswith("curl -i -X POST")]
+    assert len(curls) == 2, _p(f"two curl lines, one for each example, found {len(curls)}")
+    for line in curls:
+        found = _search(r"^curl -i -X POST -H 'Content-Type: application/json' -d '(\{.*\})' (\S+)$", line)
+        sent[found.group(2)] = json.loads(found.group(1))
+    base = f"http://{HOST}:5679/webhook/"
+    assert sent == {base + "desk-form": form, base + "desk-webhook": hook}, _p(
+        "the curl lines send exactly the two example inputs to the two webhook addresses (form first)"
+    )
+    assert curls[0].endswith("/webhook/desk-form") and curls[1].endswith("/webhook/desk-webhook"), _p("form first")
+    for name in ("desk-form", "desk-webhook"):
+        flow = json.loads(_read(f"n8n/{name}.json"))
+        assert any(node.get("parameters", {}).get("path") == name for node in flow["nodes"]), (
+            f"premise: {name}.json has a Webhook node with the path {name}"
+        )
+    canned = json.loads(_read("demo_only/canned_leads.json"))[0] if (REPO / "demo_only").exists() else None
+    if canned is not None:
+        assert {k: form[k] for k in ("name", "email", "phone", "company", "message")} == canned, (
+            "premise: the form example is the first canned lead"
+        )
+    assert re.search(r"form example is the first canned lead of `demo_only/canned_leads\.json`", flat), _p(
+        "the form example is the first canned lead, the one feed.py --index 1 sends"
+    )
+    assert re.search(r"these two lines were not run as written here", flat, re.I), _p(
+        "the curl lines are marked as not run here (n8n is not installed on the checking computer)"
+    )
+    assert re.search(r"Windows: no tested line", flat), _p("Windows has no tested line")
