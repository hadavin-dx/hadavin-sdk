+def test_the_key_length_boundary_is_exactly_the_minimum(tmp_path: Path) -> None:
+    from lead_desk.constants import LIVE_KEY_MIN_CHARS
+
+    f = tmp_path / "k.txt"
+    f.write_text("k" * LIVE_KEY_MIN_CHARS, encoding="utf-8")
+    assert envnum.read_secret_file(f, "made-up key", "key") == "k" * LIVE_KEY_MIN_CHARS
+    f.write_text("k" * (LIVE_KEY_MIN_CHARS - 1), encoding="utf-8")
+    with pytest.raises(SettingRefused, match="empty or shorter than"):
+        envnum.read_secret_file(f, "made-up key", "key")
+    f.write_text("k k " + "k" * (LIVE_KEY_MIN_CHARS - 2), encoding="utf-8")  # spaces do not count toward the minimum
+    assert envnum.read_secret_file(f, "made-up key", "key", strip_inner_space=True) == "k" * LIVE_KEY_MIN_CHARS
+    f.write_text("k k " + "k" * (LIVE_KEY_MIN_CHARS - 3), encoding="utf-8")  # one short once the spaces are gone
+    with pytest.raises(SettingRefused, match="empty or shorter than"):
+        envnum.read_secret_file(f, "made-up key", "key", strip_inner_space=True)
