+def test_a_second_secret_reader_outside_src_has_a_cap_or_is_listed() -> None:
+    """Guard over scripts/ and demo_only/: a line that reads a key file whole (read_text / read_bytes on a name that
+    holds key) is not allowed; the two readers that exist (n8n_api, fake_model_server) read at most one byte over a cap
+    that is the desk's own number."""
+    from lead_desk.constants import SECRET_FILE_MAX_BYTES
+
+    hits: list[str] = []
+    for folder in ("scripts", "demo_only"):
+        for p in sorted((REPO / folder).glob("*.py")):
+            for n, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
+                if re.search(r"key", line, re.I) and re.search(r"\.read_text\(|\.read_bytes\(", line):
+                    hits.append(f"{folder}/{p.name}:{n}")
+    assert hits == [], hits
+    n8n = (REPO / "scripts" / "n8n_api.py").read_text(encoding="utf-8")
+    found = re.search(r"^MAX_KEY = (\d+)", n8n, re.M)
+    assert found is not None and int(found.group(1)) == SECRET_FILE_MAX_BYTES
+    fms_text = (REPO / "demo_only" / "fake_model_server.py").read_text(encoding="utf-8")
+    assert "read(KEY_FILE_MAX_BYTES + 1)" in fms_text and f"KEY_FILE_MAX_BYTES = {SECRET_FILE_MAX_BYTES}" in fms_text
+
+
+@pytest.mark.skipif(not hasattr(os, "mkfifo"), reason="no named pipes on this system")
+def test_a_named_pipe_as_a_key_file_is_refused_and_does_not_block(tmp_path: Path) -> None:
+    fifo = tmp_path / "pipe.txt"
+    os.mkfifo(fifo)
+    result: list[str] = []
+
+    def run() -> None:
+        try:
+            envnum.read_secret_file(fifo, "made-up key", "key")
+        except SettingRefused as e:
+            result.append(str(e))
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    t.join(3)
+    blocked = t.is_alive()
+    if blocked:  # let the stuck reader go before the test ends
+        fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
+        os.close(fd)
+        t.join(3)
+    assert not blocked, "the key file reader blocked on a named pipe"
+    assert result == ["the made-up key file cannot be read"]
+
