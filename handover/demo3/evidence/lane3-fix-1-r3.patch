+def test_the_fresh_desk_counts_are_what_the_readme_says(env, tmp_path: Path) -> None:
+    base = _start_real_desk(env, tmp_path)
+    status, reply = call(base, "GET", "/counts")
+    assert status == 200, "premise: the counts check answers HTTP 200"
+    for name in FIVE:
+        assert reply[name] == 0, f"premise: the five counts are 0 on a fresh desk: {name}"
+    time_field = "last_reaper_pass_at"
+    others = [
+        key
+        for key, value in reply.items()
+        if isinstance(value, int) and not isinstance(value, bool) and key not in FIVE and key != time_field
+    ]
+    assert others, "premise: there are other counts besides the five counts"
+    for name in others:
+        assert reply[name] == 0, f"premise: every other count is 0 on a fresh desk: {name}"
+    assert all(v == 0 for v in reply["hung_workers"].values()), "premise: the numbers inside hung_workers are 0"
+    assert len(reply["hung_workers"]) == 4, "premise: hung_workers holds four numbers"
+    wait_until(lambda: call(base, "GET", "/counts")[1]["reaper_running"] is True, what="reaper running")
+    reply = call(base, "GET", "/counts")[1]
+    assert reply[time_field] is None or isinstance(reply[time_field], int), "premise: a time in seconds, or null"
+    assert reply["expected_match"] is None and reply["ok"] is None, "premise: expected_match and ok are null"
+
+    readme = _read("README.md")
+    linux = _between(readme, "**Linux**", "**Windows PowerShell**")
+    assert FIVE_NAMED in linux and re.search(r"are 0\. So are the other counts", linux), _p(
+        "the five counts are named and the other counts are 0 too"
+    )
+    for name in ("rejected_envelopes", "failed_followups", "hung_workers"):
+        assert name in linux and name in reply, _p(f"the Linux text names the real field {name}")
+    for key in reply["hung_workers"]:
+        assert re.search(rf"\b{key}\b", linux.split("hung_workers")[1][:200]), _p(f"hung_workers names its kind {key}")
+    assert re.search(r"`reaper_running` is `true`", linux), _p("`reaper_running` is stated as true")
+    assert re.search(r"if it still says `false` after 10 seconds, read `data/desk.log`", linux), _p(
+        "a reaper_running that is false is waited for 10 seconds, then data/desk.log is read"
+    )
+    assert re.search(rf"`{time_field}` is not a count[^.]*\(a large number\), or `null`", linux), _p(
+        f"{time_field} is a time, not a count, and can be null"
+    )
+    assert "`expected_match` and `ok` are `null`" in linux, _p("expected_match and ok are null")
+    assert "not 0" not in linux and "are not counts of leads" not in linux, _p("the old false 'not 0' claim is gone")
+    windows = _flat(_line_with(readme, "Start-Sleep 3; Invoke-WebRequest"))
+    assert FIVE_NAMED in windows and re.search(r"the other number fields are 0 too", windows), _p(
+        "the Windows line names the five counts and says the other number fields are 0 too"
+    )
+    for name in (time_field, "expected_match", "ok", "hung_workers", "reaper_running"):
+        assert name in windows, _p(f"the Windows line names {name}")
+    assert re.search(r"model, crm, send, refresh", windows), _p("the Windows line names the four hung_workers kinds")
+    assert re.search(r"except `last_reaper_pass_at` \(a time, not a count\)", windows), _p(
+        "the Windows line excepts last_reaper_pass_at"
+    )
