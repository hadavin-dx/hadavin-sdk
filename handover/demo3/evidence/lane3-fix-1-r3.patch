+    first = post_lead(base, "form", "f-1", one)
+    again = post_lead(base, "form", "f-1", one)  # the same request id: a replay
+    other_door = post_lead(base, "webhook", "w-1", one)  # same person, new request id
+    assert first[0] == 201 and first[1]["verdict"] == "new", "premise: a new lead answers 201 new"
+    assert again[0] == 201 and again[1].get("replayed") is True, "premise: a replay of a `new` answers 201 replayed"
+    assert again[1]["receipt_id"] == first[1]["receipt_id"] == 1, "premise: the replay shows the FIRST receipt's number"
+    assert other_door[0] == 200 and other_door[1]["verdict"] == "duplicate", "premise: a duplicate answers 200"
+    counts = call(base, "GET", "/counts")[1]
+    assert (counts["received"], counts["new"], counts["duplicate"]) == (2, 1, 1), _p(
+        "README: received 2, new 1, duplicate 1 (a replay is not counted again)"
+    )
+    receipt = other_door[1]["receipt_id"]
+    assert receipt == 3, _p("README: the other door's receipt_id is 3, not 2 (the replay used up the number 2)")
+    assert "receipt_id INTEGER PRIMARY KEY AUTOINCREMENT" in _read("src/lead_desk/schema.sql"), (
+        "premise: receipt numbers only go up (reads the schema file, not the text)"
