+        ("Linux", "python scripts/feed.py --source webhook"),
+        ("Windows", r"python scripts\feed.py --source webhook"),
+    )
+    for label, start in webhook_lines:
+        line = _flat(_line_with(readme, start))
+        assert "HTTP 200 (not 201)" in line, _p(f"{label} webhook line: the duplicate answers HTTP 200, not 201")
+        assert re.search(rf"`receipt_id` is {receipt}, not {receipt - 1}\b", line), _p(
+            f"{label} webhook line: receipt_id is {receipt}, not {receipt - 1}"
