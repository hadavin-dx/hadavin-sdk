+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}  # nothing of the tester's own settings
+    env["PYTHONPATH"] = os.pathsep.join([str(REPO / "src"), str(REPO)])
+    env.update(
+        DESK_PORT=str(free_port()),
+        DESK_FAKES_PORT=str(free_port()),  # nothing listens here: the demo servers are "not running"
+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    done = subprocess.run(  # noqa: S603 - our own interpreter and module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        cwd=tmp_path,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    if done.returncode == 3:  # the desk checks the open-file limit first (containers often allow only 4096)
+        pytest.skip(f"this computer's open-file limit is too low for the desk (exit 3): {done.stdout.strip()[-200:]}")
+    lines = done.stdout.strip().splitlines()
+    assert lines, f"premise: the desk printed nothing (exit {done.returncode}, error output: {done.stderr[-200:]!r})"
+    printed = lines[-1]
+    assert done.returncode == 1, f"premise: exit code 1 means the demo servers cannot be reached: {done.returncode}"
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    assert phrase.startswith("cannot reach the demo servers"), f"premise: the desk prints this phrase: {printed}"
+    bullet = _flat(_line_with(_read("docs/limits.md"), "* Exit codes:"))
+    assert phrase in bullet, _p("limits.md quotes the words the desk prints for exit code 1")
+    assert "the sender cannot be reached" not in bullet, _p("the old word 'sender' for the demo servers is gone")
+    assert re.search(r"traceback[^.]*program fault[^.]*not a setting", bullet), _p(
+        "the traceback case is a program fault, not a setting"
+    )
+    assert "src/lead_desk/constants.py" in bullet and (REPO / "src/lead_desk/constants.py").exists(), _p(
+        "the edited fixed value lives in src/lead_desk/constants.py"
+    )
+    assert re.search(r"real CRM or a real mail sender[^.]*not described here", bullet), _p(
+        "what the desk prints for an unreachable real CRM or mail sender is not described (not claimed)"
+    )
+    assert "constant that is out of range" not in bullet, _p("no unexplained 'constant that is out of range'")
