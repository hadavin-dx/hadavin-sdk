+def _start_real_desk(env, tmp_path: Path):  # type: ignore[no-untyped-def]
+    """The README desk as a child program, with the demo servers stood in for by the tests' own server."""
+    _, fakes_url = env.fakes("keyed")
+    port = free_port()
+    env_vars = child_env(
+        DESK_DB_PATH=str(tmp_path / "desk.sqlite3"), DESK_BIND=HOST, DESK_PORT=str(port), DESK_FAKES_URL=fakes_url
+    )
+    proc = start_proc(["-m", "lead_desk.server"], env_vars)
+    env.stop_on_close(lambda: stop_proc(proc))
+    base = f"http://{HOST}:{port}"
+    wait_until(lambda: proc.poll() is not None or call(base, "GET", "/counts")[0] == 200, what="desk ready")
+    assert proc.poll() is None, "premise: the README desk starts with the demo settings"
+    return base
+
