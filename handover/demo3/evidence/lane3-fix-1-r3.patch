+def test_the_recipe_import_steps_match_the_script() -> None:
+    recipe = _read("docs/n8n-recipe.md")
+    script = _read("scripts/n8n_api.py")
+    steps = _recipe_steps()
+    assert "N8N_API_KEY_FILE" in script and "N8N_URL" in script, "premise: the script reads both variables"
+    assert re.search(r"environment variable[^.]*`N8N_API_KEY_FILE`", steps), _p(
+        "the key file is an environment variable"
+    )
+    assert 'export N8N_API_KEY_FILE="$HOME/n8n-key.txt"' in recipe, _p("the Linux way, a file outside the folder")
+    assert '$env:N8N_API_KEY_FILE = "$HOME\\n8n-key.txt"' in recipe, _p("the Windows way, the same file name")
+    assert "/path/to/keyfile" not in recipe and ".\\n8n-key.txt" not in recipe, _p(
+        "no key file path inside the project"
+    )
+    assert re.search(r"lasts only in this terminal window", steps), _p("the variable lasts only in that terminal")
+    assert "`N8N_URL`" in steps, _p("N8N_URL is mentioned in the steps")
+    assert re.search(r"create an API key", steps) and "one word on one line" in steps, _p("the key is made in n8n")
+    assert re.search(r"OUTSIDE the project folder", steps), _p("the key file lives outside the project folder")
+    assert "python scripts/n8n_api.py import n8n/desk-form.json" in steps, _p("the import command")
+    assert re.search(r"(?:^| )0\. Start n8n[^.]*5679", steps) and "`N8N_PORT=5679`" in steps, _p(
+        "step 0: start n8n on port 5679 before anything else"
+    )
+    assert re.search(r"(?:^| )5\. Switch each workflow on", steps), _p("switching on is a numbered step")
+    raw_steps = recipe.split("To import a workflow with the script")[1].split("The script has no command")[0]
+    numbers = [int(m) for m in re.findall(r"^(\d)\. ", raw_steps, re.M)]
+    assert numbers == [0, 1, 2, 3, 4, 5], _p(f"the import steps are numbered 0 to 5 in order, found {numbers}")
+    assert re.search(r"`\.venv` is switched on", steps), _p("the steps say where to run them")
+    usage = 'USAGE = "usage: python scripts/n8n_api.py import FILE | activate NAME | deactivate NAME | list"'
+    assert usage in script, (
+        "premise: the script has no delete command"
+    )
+    flat = _flat(recipe)
+    assert re.search(r"no command to delete a workflow[^.]*n8n screen", flat), _p("deleting is done on the n8n screen")
+    assert re.search(r"two workflows with the same name", flat), _p("importing twice makes two workflows")
+    assert "workflows?limit=250" in script and re.search(r"`list`[^.]*first 250 workflows", flat), _p(
+        "the script's list shows only the first 250 workflows"
+    )
+
+
+def test_the_recipe_activates_each_workflow_by_its_real_name() -> None:
+    steps = _recipe_steps()
+    names = [json.loads(p.read_text(encoding="utf-8"))["name"] for p in sorted((REPO / "n8n").glob("*.json"))]
+    assert len(names) == 3, f"premise: three workflow files, found {names}"
+    for name in names:
+        assert f'python scripts/n8n_api.py activate "{name}"' in steps, _p(
+            f"the activate step names the workflow {name!r}"
+        )
+
