+def test_the_burst_numbers_in_limits_are_what_a_real_desk_answers(env, tmp_path: Path) -> None:
+    base = _start_real_desk(env, tmp_path)
+    url = base + "/leads"
+    email = "ada@example.test"
+    n = 10
+    first = burst.fire(url, n, email, "p1", "form")
+    same = burst.fire(url, n, email, "p1", "form")
+    other = burst.fire(url, n, email, "p2", "form")
+
+    def shown(result: dict[str, object]) -> dict[object, int]:
+        out: dict[object, int] = {}
+        for status in result["final"]:  # type: ignore[attr-defined]
+            out[status] = out.get(status, 0) + 1
+        return out
+
+    assert shown(first) == {201: 1, 200: n - 1}, "premise: a fresh desk answers 201 once and 200 for the other n - 1"
+    assert shown(same) == {201: 1, 200: n - 1}, "premise: the same prefix again gives the stored answers"
+    assert shown(other) == {200: n}, "premise: another prefix on a desk that holds the address answers 200 n times"
+    wait_until(lambda: call(base, "GET", "/counts")[1]["pending_followups"] == 0, what="follow-ups finished")
+    assert call(base, "GET", "/counts")[1]["new"] == 1, "premise: new stays 1 through all three runs"
+
+    steps = _between(_read("docs/limits.md"), "* Burst test:", "* Larger bursts:")
+    sends = int(re.search(r"--n (\d+)", steps).group(1))  # type: ignore[union-attr]
+    assert re.search(rf"STATUS 201=1 200={sends - 1}\b", steps), _p(
+        "a fresh desk: 201=1 and 200 for the other n - 1 sends"
+    )
+    same_text = steps.split("SAME `--ref-prefix`")[1].split("DIFFERENT")[0]
+    assert re.search(rf"201=1 200={sends - 1}\b", same_text) and "`new` stays 1" in same_text, _p(
+        "the same prefix again: the stored answers come back and `new` stays 1"
+    )
+    diff_text = steps.split("DIFFERENT `--ref-prefix`")[1]
+    assert re.search(rf"STATUS 200={sends}\b", diff_text) and "does not grow" in diff_text, _p(
+        "a different prefix on a desk that holds the address: every answer is 200"
+    )
+    ten = rf"With `--n {n}` the numbers are `201=1 200={n - 1}`, `201=1 200={n - 1}` and `200={n}`"
+    assert re.search(ten, steps), _p(
+        f"the ten-send numbers 201=1 200={n - 1} / 200={n}"
+    )
+
