+SQLITE_CONNECT = re.compile(r"\bsqlite3\.connect\(")
+
+
+def _scan_sqlite_connects(root: Path, folders: tuple[str, ...]) -> list[tuple[str, str]]:
+    """(file, line text without its comment) for every `sqlite3.connect(` in the folders (not in tests)."""
+    hits: list[tuple[str, str]] = []
+    for folder in folders:
+        for p in sorted((root / folder).rglob("*.py")):
+            for line in p.read_text(encoding="utf-8").splitlines():
+                code = line.split("  #")[0].strip()
+                if SQLITE_CONNECT.search(code) and not code.startswith(("#", '"', "'")):
+                    hits.append((p.relative_to(root).as_posix(), code))
+    return hits
+
+
+ALLOWED_CONNECTS: dict[tuple[str, str], str] = {
+    ("src/lead_desk/db.py", "conn = sqlite3.connect(path, isolation_level=None, timeout=BUSY_WAIT_SECONDS)"): (
+        "the one connection of the desk: `connect` calls `refuse_unusable_db_path` first"
+    ),
+    (
+        "src/lead_desk/portal_api.py",
+        "conn = sqlite3.connect(uri, uri=True, timeout=BUSY_WAIT_SECONDS, isolation_level=None)",
+    ): "read-only (`mode=ro`: SQLite never creates a file); `connect_readonly` calls `refuse_unusable_db_path` first",
+    ("scripts/check_schema.py", "conn = sqlite3.connect(path, timeout=5.0, isolation_level=None)"): (
+        "a demo tool: opens only a file inside a temporary folder it made itself, with made-up data (not shipped)"
+    ),
+    ("load_tools/check_invariants.py", "conn = sqlite3.connect(uri, uri=True)"): (
+        "a demo tool: read-only URI (`mode=ro`) on a path that is confined and already a regular file; made-up data"
+    ),
+}
