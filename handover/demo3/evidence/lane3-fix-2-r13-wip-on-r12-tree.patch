+def test_every_sqlite_connect_is_the_checked_one_or_a_named_exception() -> None:
+    hits = _scan_sqlite_connects(REPO, ("src", "scripts", "load_tools", "demo_only"))
+    unknown = [h for h in hits if h not in ALLOWED_CONNECTS]
+    assert unknown == [], unknown
+    assert sorted(set(hits)) == sorted(ALLOWED_CONNECTS), "an allowance names a line that is gone"
+    assert all(ALLOWED_CONNECTS.values())
