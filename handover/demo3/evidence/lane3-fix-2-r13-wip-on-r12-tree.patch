+    real_open = envnum.open_without_following_link
+
+    def spy(*a: Any, **k: Any) -> int:
+        fd = real_open(*a, **k)
+        opened.append(fd)
+        return fd
+
+    def refuse(fd: int, *a: Any, **k: Any) -> Any:
+        raise MemoryError("made-up")
+
