+"""Round 13 of the key-file work. The spend ledger is opened through the one checked opener (a link, a folder or a named
+pipe is refused, never followed, never waited for); its lock name comes from the resolved path; a database name is
+checked for every caller; SQLite is shown not to follow a link at its derived names; every key reader names its setting
+and checks the owner; plain files the desk only reads are opened without waiting. Made-up data and loopback only."""
+
+from __future__ import annotations
+
+import errno
+import importlib
+import json
+import os
+import re
+import sqlite3
+import sys
+import threading
+import time
+from decimal import Decimal
+from pathlib import Path
+from typing import Any, get_args
+
+import pytest
+from support import MADE_UP_KEY as KEY
+from support import POSIX_ONLY as POSIX
+from support import doc_text, port_nobody_listens_on
+
+from lead_desk import db, envnum, hooks, portal_api, run_stats, server, trace
+from lead_desk.config import LiveSettings, read_approvers
+from lead_desk.constants import EXIT_SIMULATED_KILL  # noqa: F401  (named so the flag-file tests read clearly)
+from lead_desk.live_claude import LiveCapReached, LiveQualifier, LiveTransport, SpendLedger, _FileLock
+
+REPO = Path(server.__file__).parents[2]
+HARD_SECONDS = 10.0  # a test that waits longer than this has found a hang: it fails, it does not wait
+
+
+def _settings(tmp_path: Path, ledger: Path, run: str = "run-a", cap_total: str = "3") -> LiveSettings:
+    key = tmp_path / "key-for-settings.txt"
+    if not key.exists():
+        key.write_text(KEY + "\n", encoding="utf-8")
+    return LiveSettings(
+        model="fake-model-1",
+        key_file=key,
+        price_in_per_mtok=Decimal("1"),
+        price_out_per_mtok=Decimal("1"),
+        price_date="2026-01-01",
+        cap_run_usd=Decimal("1"),
+        cap_total_usd=Decimal(cap_total),
+        ledger_path=ledger,
+        run_id=run,
+        base_url="http://127.0.0.1:1",
+        timeout_seconds=2.0,
+        allow_any_base_url=True,
+    )
+
+
+def _within(seconds: float, call: Any) -> BaseException | None:
+    """Run call() on a helper thread; the exception it raised (None: it returned). A call that is still running after
+    `seconds` fails the test at once (and the helper is left to the daemon rule: it cannot hold the run)."""
+    box: list[BaseException | None] = []
+
+    def run() -> None:
+        try:
+            call()
+            box.append(None)
+        except BaseException as e:  # noqa: BLE001 (handed back to the test)
+            box.append(e)
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    t.join(seconds)
+    assert box, f"the call was still waiting after {seconds} s (a hang)"
+    return box[0]
+
+
+def _all_four_entry_points_refuse(ledger: SpendLedger, s: LiveSettings) -> None:
+    for call in (
+        lambda: ledger.reserve(s, Decimal("0.5")),
+        lambda: ledger.settle("some-id", Decimal("0.1")),
+        lambda: ledger.totals("run-a"),
+        lambda: ledger.read_totals("run-a"),
+    ):
+        err = _within(HARD_SECONDS, call)
+        assert isinstance(err, LiveCapReached), err
+        assert "ledger" in str(err)
+
+
+# ------------------------------------------------------------------------------ rows 1, 3: the spend ledger
+@POSIX
+def test_a_link_planted_at_the_ledger_after_the_start_is_refused_and_nothing_is_made_at_its_target(
+    tmp_path: Path,
+) -> None:
+    path = tmp_path / "ledger.jsonl"
+    s = _settings(tmp_path, path)
+    ledger = SpendLedger(path)
+    ledger.reserve(s, Decimal("0.5"))  # the desk is running with a real ledger
+    path.unlink()
+    target = tmp_path / "target-of-the-link"
+    path.symlink_to(target)  # planted after the start
+    _all_four_entry_points_refuse(ledger, s)
+    assert not target.exists(), "a file was made at the target of the link"
+
+
+@POSIX
+def test_a_link_to_an_existing_file_is_refused_too_and_that_file_is_not_touched(tmp_path: Path) -> None:
+    victim = tmp_path / "victim.txt"
+    victim.write_bytes(b"VICTIM\n")
+    path = tmp_path / "ledger.jsonl"
+    path.symlink_to(victim)
+    _all_four_entry_points_refuse(SpendLedger(path), _settings(tmp_path, path))
+    assert victim.read_bytes() == b"VICTIM\n"
+
+
+@POSIX
+def test_a_named_pipe_at_the_ledger_never_makes_the_desk_wait(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.jsonl"
+    os.mkfifo(path)
+    keeper = os.open(path, os.O_RDWR | os.O_NONBLOCK)  # lets a blocked open return, so a failing test cannot hang
+    try:
+        _all_four_entry_points_refuse(SpendLedger(path), _settings(tmp_path, path))
+    finally:
+        os.close(keeper)
+
+
+@POSIX
+def test_a_folder_at_the_ledger_is_refused_and_nothing_is_made_inside_it(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.jsonl"
+    path.mkdir()
+    _all_four_entry_points_refuse(SpendLedger(path), _settings(tmp_path, path))
+    assert list(path.iterdir()) == [] and not Path(f"{path}.lock").exists()
+
+
+@POSIX
+def test_a_second_hard_link_to_the_ledger_is_refused(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.jsonl"
+    s = _settings(tmp_path, path)
+    SpendLedger(path).reserve(s, Decimal("0.5"))
+    os.link(path, tmp_path / "second-name.jsonl")  # two names for one file: two lock names would be two locks
+    _all_four_entry_points_refuse(SpendLedger(path), s)
+    _all_four_entry_points_refuse(SpendLedger(tmp_path / "second-name.jsonl"), s)
+
+
+@POSIX
+def test_a_dangling_lock_link_beside_the_ledger_stops_reserve_and_settle_and_makes_nothing(tmp_path: Path) -> None:
+    path = tmp_path / "ledger.jsonl"
+    s = _settings(tmp_path, path)
+    target = tmp_path / "lock-target"
+    Path(f"{path}.lock").symlink_to(target)
+    ledger = SpendLedger(path)
+    for call in (lambda: ledger.reserve(s, Decimal("0.5")), lambda: ledger.settle("some-id", Decimal("0.1"))):
+        err = _within(HARD_SECONDS, call)
+        assert isinstance(err, LiveCapReached) and str(tmp_path) not in str(err), err
+    assert not target.exists(), "a lock file was made at the target of the link"
+    assert not path.exists(), "the ledger was written although its lock could not be taken"
+
+
+@POSIX
+def test_the_lock_opener_is_the_one_the_ledger_lock_uses(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Behaviour, not a text pin: the lock for the ledger is made through `lockfile.open_lock_file`. A lock opener that
+    follows a link would create the target; this one is swapped for a plain open and the test must then see it."""
+    seen: list[Path] = []
+    from lead_desk import live_claude, lockfile
+
+    real = lockfile.open_lock_file
+
+    def spy(p: Path) -> Any:
+        seen.append(p)
+        return real(p)
+
+    monkeypatch.setattr(live_claude, "open_lock_file", spy)
+    path = tmp_path / "ledger.jsonl"
+    SpendLedger(path).reserve(_settings(tmp_path, path), Decimal("0.5"))
+    assert seen == [Path(f"{path.resolve()}.lock")]
+
+
+def _slow(ledger_cls: type[SpendLedger], monkeypatch: pytest.MonkeyPatch, seconds: float) -> None:
+    """Make every read of the totals slow, so two spenders that are not kept apart both read the old total."""
+    real = ledger_cls._totals
+
+    def slow(self: SpendLedger, run: str) -> tuple[Decimal, Decimal]:
+        out = real(self, run)
+        time.sleep(seconds)
+        return out
+
+    monkeypatch.setattr(ledger_cls, "_totals", slow)
+
+
+@POSIX
+def test_two_names_for_one_ledger_cannot_spend_past_the_cap(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """The ledger is also named through a link to it (old code: a second lock, so no spender waits for the other, and
+    both read the same old total). The cap fits ONE reserve of 0.6 (total cap 1.0): the sum of the reserves that were
+    recorded must stay at or below the cap, and the two lock names must be one."""
+    path = tmp_path / "ledger.jsonl"
+    alias = tmp_path / "alias.jsonl"
+    s = _settings(tmp_path, path, cap_total="1")
+    s2 = _settings(tmp_path, alias, cap_total="1", run="run-b")
+    SpendLedger(path).reserve(s, Decimal("0.01"))  # the file exists, so a link to it can be made
+    alias.symlink_to(path)
+    _slow(SpendLedger, monkeypatch, 0.4)
+    results: list[object] = []
+
+    def spend(ledger: SpendLedger, settings: LiveSettings) -> None:
+        try:
+            results.append(ledger.reserve(settings, Decimal("0.6")))
+        except LiveCapReached as e:
+            results.append(e)
+
+    threads = [
+        threading.Thread(target=spend, args=(SpendLedger(path), s)),
+        threading.Thread(target=spend, args=(SpendLedger(alias), s2)),
+    ]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(HARD_SECONDS * 3)
+    assert len(results) == 2
+    rows = [json.loads(x) for x in path.read_text(encoding="utf-8").splitlines()]
+    total = sum(Decimal(r["usd"]) for r in rows if r["op"] == "reserve")
+    assert total <= Decimal("1"), f"the cap was passed: {total}"
+    assert sorted(p.name for p in tmp_path.glob("*.lock")) == ["ledger.jsonl.lock"]
+
+
+def test_the_lock_name_is_made_from_the_resolved_path(tmp_path: Path) -> None:
+    real = tmp_path / "real"
+    real.mkdir()
+    ledger = SpendLedger(real / ".." / "real" / "l.jsonl")
+    assert ledger._lock_file() == Path(f"{(real / 'l.jsonl').resolve()}.lock")
+
+
+# ------------------------------------------------------------------------------ row 2: the script refuses first
+def _script() -> Any:
+    sys.path.insert(0, str(REPO / "scripts"))
