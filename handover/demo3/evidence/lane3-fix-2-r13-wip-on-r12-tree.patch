+@POSIX
+@pytest.mark.parametrize("suffix", ["-wal", "-shm", "-journal"])
+def test_sqlite_never_follows_a_link_at_a_name_it_derives_from_the_database(tmp_path: Path, suffix: str) -> None:
+    """What SQLite does with a dangling link at `<book>-wal`, `-shm` or `-journal` (the result is the reason the desk
+    adds no check of its own for these names; the docs cite this test). It must neither make the link's target nor
+    change a file the link points to. The assertion text names the SQLite version that ran."""
+    ver = f"SQLite {sqlite3.sqlite_version}"
+    book = tmp_path / "d.sqlite3"
+    nowhere = tmp_path / f"nowhere{suffix}"
+    Path(f"{book}{suffix}").symlink_to(nowhere)
+    c = sqlite3.connect(book, isolation_level=None)
+    try:
+        c.execute("PRAGMA journal_mode=WAL")
+        c.execute("CREATE TABLE t(a)")
+        c.execute("INSERT INTO t VALUES (1)")
+    except sqlite3.OperationalError:
+        pass  # SQLite refused on its own: also fine
+    finally:
+        c.close()
+    assert not nowhere.exists(), f"{ver} made a file at the target of a link"
+
+
+@POSIX
+@pytest.mark.parametrize("suffix", ["-wal", "-shm", "-journal"])
+def test_sqlite_does_not_write_through_a_link_at_a_derived_name_to_an_existing_file(
