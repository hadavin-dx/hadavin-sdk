+def test_a_caller_that_has_gone_makes_the_fake_servers_print_nothing_and_keep_working(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """The answer cannot be written (the caller has gone): the server thread must not report an error. The write
+    failure is made by patching the end of the headers, which is where the first bytes are sent."""
+    import http.client
+    from http.server import BaseHTTPRequestHandler
+
+    from demo_only import fake_hubspot
+    from demo_only.fakes_server import serve_fakes_in_thread, stop_fakes
+
+    real_end = BaseHTTPRequestHandler.end_headers
+    broken = {"on": True}
+
+    def end_headers(self: BaseHTTPRequestHandler) -> None:
+        if broken["on"]:
+            raise BrokenPipeError(errno.EPIPE, "made-up")
+        real_end(self)
+
+    srv, url, th = serve_fakes_in_thread()
+    reported: list[object] = []
+    srv.handle_error = lambda request, client_address: reported.append(client_address)  # type: ignore[method-assign]
+    try:
+        host, port = "127.0.0.1", int(url.rsplit(":", 1)[1])
+        monkeypatch.setattr(BaseHTTPRequestHandler, "end_headers", end_headers)
+        c = http.client.HTTPConnection(host, port, timeout=3)
+        c.request(
+            "POST", "/fake/control", body=b'{"fail_next": "nonsense"}', headers={"Content-Type": "application/json"}
+        )
+        with pytest.raises((http.client.RemoteDisconnected, ConnectionError)):
+            c.getresponse()
+        c.close()
+        broken["on"] = False
+        c = http.client.HTTPConnection(host, port, timeout=3)
+        c.request("GET", "/fake/info")
+        assert c.getresponse().status in (200, 404)  # still serving
+        c.close()
+    finally:
+        broken["on"] = False
+        stop_fakes(srv, th)
+    assert reported == [], "the fake server reported an error for a caller that had gone"
+    assert fake_hubspot is not None
