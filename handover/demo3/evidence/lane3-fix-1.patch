diff --git a/tests/test_docs_claims_lane3.py b/tests/test_docs_claims_lane3.py
new file mode 100644
index 0000000..d242ffd
--- /dev/null
+++ b/tests/test_docs_claims_lane3.py
@@ -0,0 +1,165 @@
+"""Sentences in README.md, docs/limits.md and docs/n8n-recipe.md that two readers (who followed the text literally on
+a clean copy) found wrong or missing. Each test derives the true value from the code or the workflow files where it can,
+so the text cannot drift from it again. The tests need no demo servers and no n8n; one starts the desk once and lets it
+fail at once (nothing listens where it looks for the demo servers)."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import socket
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def _read(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def _free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(("127.0.0.1", 0))
+        return int(s.getsockname()[1])
+
+
+def _line_with(text: str, start: str) -> str:
+    lines = [ln for ln in text.splitlines() if ln.lstrip().startswith(start)]
+    assert len(lines) == 1, f"expected exactly one line starting with {start!r}, found {len(lines)}"
+    return lines[0]
+
+
+# ---- limits.md: exit code 1 names what the desk really prints ----
+
+
+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = dict(os.environ)
+    env["PYTHONPATH"] = os.pathsep.join([str(REPO / "src"), str(REPO)])
+    env.update(
+        DESK_PORT=str(_free_port()),
+        DESK_FAKES_PORT=str(_free_port()),  # nothing listens here: the demo servers are "not running"
+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    done = subprocess.run(  # noqa: S603 - our own interpreter and module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        cwd=tmp_path,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    assert done.returncode == 1, (done.returncode, done.stdout, done.stderr)
+    printed = done.stdout.strip().splitlines()[-1]
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    assert phrase.startswith("cannot reach the demo servers"), printed
+    bullet = _line_with(_read("docs/limits.md"), "* Exit codes:")
+    assert phrase in bullet, "limits.md must quote the words the desk prints for exit code 1"
+    assert "the sender cannot be reached" not in bullet
+
+
+# ---- limits.md: the burst numbers hold only on a fresh desk ----
+
+
+def test_burst_counts_are_stated_for_a_fresh_desk_only() -> None:
+    line = _line_with(_read("docs/limits.md"), "* Burst test:")
+    before_counts = line.split("should each be 1")[0]
+    assert "fresh desk" in before_counts, "the 'should each be 1' sentence must say it holds on a fresh desk"
+    assert "scripts/reset.sh" in before_counts
+    assert "`201=1`" in line and "fresh desk" in line.split("`201=1`")[0][-80:]
+
+
+# ---- n8n-recipe.md: the ports are written into the workflow files ----
+
+
+def _ports_written_in_workflows() -> set[int]:
+    found: set[int] = set()
+    for path in sorted((REPO / "n8n").glob("*.json")):
+        text = path.read_text(encoding="utf-8")
+        json.loads(text)  # the file must still be a workflow
+        found |= {int(n) for n in re.findall(r"http://127\.0\.0\.1:(\d+)/", text)}
+    return found
+
+
+def test_the_workflow_files_carry_the_default_ports() -> None:
+    """The fact the recipe must state: these are the settings' defaults (desk, demo servers) and n8n_api's default."""
+    from lead_desk.config import Config
+
+    config = Config.from_env({})
+    n8n_default = int(re.search(r"http://127\.0\.0\.1:(\d+)", _read("scripts/n8n_api.py")).group(1))  # type: ignore[union-attr]
+    assert _ports_written_in_workflows() == {config.port, config.fakes_port, n8n_default}
+
+
+def test_the_recipe_says_the_ports_are_written_into_the_workflow_files() -> None:
+    recipe = _read("docs/n8n-recipe.md")
+    flat = " ".join(recipe.split())
+    for port in sorted(_ports_written_in_workflows()):
+        assert str(port) in flat
+    assert "do not read those settings" in flat
+    assert "(host and port from `docs/settings.md`)" not in flat, (
+        "the old sentence implied the files follow settings.md"
+    )
+    assert "editing it" in flat and "written permission" in flat.split("editing it")[1][:120]
+
+
+# ---- n8n-recipe.md: reset first, key file, delete ----
+
+
+def test_the_recipe_example_lead_is_the_readme_demo_lead_so_it_says_to_reset_first() -> None:
+    canned = Path(REPO / "demo_only" / "canned_leads.json")
+    if not canned.exists():
+        pytest.skip("demo_only folder removed")
+    first = json.loads(canned.read_text(encoding="utf-8"))[0]
+    recipe = _read("docs/n8n-recipe.md")
+    form_line = _line_with(recipe, "form:")
+    example = json.loads(form_line.split("form:", 1)[1])
+    assert example["email"].lower() == first["email"].lower(), "premise: same person, so a used desk answers duplicate"
+    flat = " ".join(recipe.split())
+    assert "scripts/reset.sh" in flat.split("Example inputs")[1].split("form:")[0]
+    assert "no leads yet" in flat
+
+
+def test_the_recipe_names_the_key_file_setting_and_says_how_to_delete_a_workflow() -> None:
+    recipe = _read("docs/n8n-recipe.md")
+    script = _read("scripts/n8n_api.py")
+    assert "N8N_API_KEY_FILE" in script
+    assert "N8N_API_KEY_FILE" in recipe, "the recipe must name the setting, not only point at the script's top"
+    assert "delete a workflow" in recipe and "n8n screen" in recipe.split("delete a workflow")[1][:120]
+    assert "create the key in your own n8n" in recipe
+
+
+# ---- README.md ----
+
+
+def test_readme_lists_curl_because_the_linux_lines_use_it_and_shows_a_port_check() -> None:
+    readme = _read("README.md")
+    linux = readme.split("**Linux**")[1].split("**Windows PowerShell**")[0]
+    assert "curl " in linux, "premise: the Linux block uses curl"
+    need = _line_with(readme, "You need Linux or Windows")
+    assert "`curl`" in need
+    assert "8765" in need and "http_code" in need and "`000`" in need
+
+
+def test_readme_says_the_duplicate_door_answers_200_and_why_receipt_ids_skip() -> None:
+    readme = _read("README.md")
+    schema = _read("src/lead_desk/schema.sql")
+    assert "receipt_id INTEGER PRIMARY KEY AUTOINCREMENT" in schema, "premise: numbers only go up, never reused"
+    line = _line_with(readme, "python scripts/feed.py --source webhook --index 1")
+    assert "HTTP 200 (not 201)" in line
+    assert "can skip a number" in line
+
+
+def test_readme_counts_check_names_the_counts_that_are_zero() -> None:
+    readme = _read("README.md")
+    for text in (
+        _line_with(readme, "for i in 1 2 3"),
+        _line_with(readme, "Start-Sleep 3; Invoke-WebRequest"),
+    ):
+        assert "numbers are all 0" not in text and "(all 0)" not in text
+        assert "`received`, `new`, `duplicate`, `review` and `open`" in text
+    assert "`reaper_running`" in _line_with(readme, "for i in 1 2 3")
