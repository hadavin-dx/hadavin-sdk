+@pytest.mark.parametrize("size", [63, 64, 65, 200])
+def test_reset_sh_deletes_a_pid_file_that_is_not_a_number_whatever_its_size_in_bytes(book: Path, size: int) -> None:
+    """Letters of two bytes, 63 to 200 bytes: stale, whether the 64 byte cap counts bytes or characters."""
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_bytes(("\u00e9" * (size // 2)).encode() + b"x" * (size % 2))  # exactly `size` bytes, never a number
+    assert pidfile.stat().st_size == size
+    done = _run(SCRIPT, book, **reset_ports())
+    assert done.returncode == 0 and not pidfile.exists(), (done.stdout, done.stderr)
