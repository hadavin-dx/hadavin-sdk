+# -- one decision before any action (fix-5 round 7): the reset looks at BOTH pid files first and only then stops
+def _live_desk(book: Path, name: str, module: str, code: str) -> subprocess.Popen[bytes]:
+    """A stand-in for the desk (or the demo server) that runs until it is stopped; its pid file is written here."""
+    ready = book.parent / f"{name}.ready"
+    proc = start_module_proc(ready, code, module=module)
+    wait_until(ready.exists, what=f"the {name} stand-in is running")
+    (book.parent / f"{name}.pid").write_text(str(proc.pid), encoding="utf-8")
+    return proc
+
