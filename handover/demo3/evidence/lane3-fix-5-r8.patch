+def test_text_only_pass_2_looks_at_the_program_again_right_before_each_stop() -> None:
+    """A process number is judged in pass 1, but a stop of an earlier program can take up to 999 seconds, and the
+    number can then belong to another program: the command line is read again and compared with -cmatch right before
+    Stop-Process; a program that changed is not stopped (exit 6, naming what was already stopped)."""
+    two = _pass(2)
+    stop = two.index("Stop-Process")
+    again = two.index("Get-CimInstance Win32_Process")
+    assert again < stop, "the program is not looked at again before the stop"
+    assert re.search(r"-cmatch\s+\$ours", two[again:stop]), "the second look does not compare the command line"
+    assert "was the desk or the demo server when checked, but is another program now; it was not stopped" in two
+    assert "exit 6" in two[again:stop]
+    assert "could not be looked up" in two[again:stop], "a failing second lookup must refuse too"
+    refusal = two.index("is another program now", again)
+    assert re.search(r"exit 6\b", two[refusal:stop]), "the refusal for a changed program must exit 6"
+
