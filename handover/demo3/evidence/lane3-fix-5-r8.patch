+def test_the_pattern_of_reset_ps1_in_powershell_keeps_letter_case_for_the_option_and_the_program(
+    line: str, ours: bool
+) -> None:
+    """-cmatch in PowerShell itself (not Python's re): `python -M ...` and `PYTHON.EXE -m ...` are another program."""
+    code = _code()
+    definitions = "\n".join(re.findall(r"(?m)^\$(?:interpreter|ours) = .*$", code))
+    read_line = '$line = [Console]::In.ReadToEnd().TrimEnd("`r", "`n")'
+    script = f"{definitions}\n{read_line}\n[Console]::Out.Write($line -cmatch $ours)"
+    shell = shutil.which("powershell")
+    assert shell is not None, "Windows PowerShell is not installed"
+    done = subprocess.run(  # noqa: S603 (our own script text and a made-up line)
+        [shell, "-NoProfile", "-Command", script], input=line, capture_output=True, text=True, timeout=60, check=False
+    )
+    assert done.stdout.strip() == ("True" if ours else "False"), (line, done.stdout, done.stderr)
