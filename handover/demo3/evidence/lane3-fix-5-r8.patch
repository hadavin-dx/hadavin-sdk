+"""The reset scripts: the order of the three passes (decide, stop, check, delete), what a refusal says and where it is
+printed (standard error only), one word for the database, a program that changes between the passes, a pid file that is
+a dangling link, and the 64 byte rule after a byte order mark. Linux tests run reset.sh for real with stand-in
+programs; reset.ps1 is covered by text tests only (see test_reset_ps1_pid_rules.py). Made-up data only."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+from support import (
+    DESK_MODULE,
+    FAKES_MODULE,
+    REPO,
+    WINDOWS,
+    bound_socket,
+    held_port,
+    reset_kept,
+    reset_ports,
+    reset_run,
+    start_module_proc,
+    stop_proc,
+    wait_until,
+)
+
+SH = "reset.sh"
+_RUNS_UNTIL_STOPPED = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(60)"
+_posix = pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+
+
+def _live(book: Path, name: str, module: str, code: str) -> subprocess.Popen[bytes]:
+    ready = book.parent / f"{name}.ready"
+    proc = start_module_proc(ready, code, module=module)
+    wait_until(ready.exists, what=f"the {name} stand-in is running")
+    (book.parent / f"{name}.pid").write_text(str(proc.pid), encoding="utf-8")
+    return proc
+
+
+def _end(*procs: subprocess.Popen[bytes]) -> None:
+    for proc in procs:
+        proc.kill()
+        proc.wait()
+        stop_proc(proc)
+
+
+# -- the refusals of reset_check.py go to standard error, never to standard output
+def _check(book: Path, **env: str) -> subprocess.CompletedProcess[str]:
+    full = {**os.environ, "DESK_DB_PATH": str(book), "PYTHONPATH": f"{REPO / 'src'}{os.pathsep}{REPO}", **env}
+    return subprocess.run(  # noqa: S603 (this repository's own script, a path made by the test)
+        [sys.executable, str(REPO / "scripts" / "reset_check.py")],
+        cwd=REPO,
+        env=full,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+
+
+def test_reset_check_prints_its_exit_4_refusal_on_standard_error_only(book: Path) -> None:
+    with bound_socket() as listener:
+        listener.listen(1)
+        done = _check(book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+    assert done.returncode == 4 and done.stdout == "", (done.stdout, done.stderr)
+    assert done.stderr.startswith("refused: something still answers on port") and done.stderr.count("\n") == 1
+
+
+def test_reset_check_prints_its_exit_3_refusal_on_standard_error_only(book: Path) -> None:
+    from lead_desk import lockfile
+
+    handle = lockfile.acquire(book)
+    try:
+        done = _check(book, **reset_ports())
+    finally:
+        handle.close()
+    assert done.returncode == 3 and done.stdout == "", (done.stdout, done.stderr)
+    assert "holds the database" in done.stderr and done.stderr.count("\n") == 1
+
+
+def test_reset_check_refusal_survives_a_redirect_of_standard_error_to_a_file(book: Path, tmp_path: Path) -> None:
+    """`2>file` takes the refusal and leaves standard output empty: the shape a wrapper script or a user gets."""
+    target = tmp_path / "err.txt"
+    with bound_socket() as listener, target.open("w", encoding="utf-8") as err:
+        listener.listen(1)
+        env = {**os.environ, "DESK_DB_PATH": str(book), "PYTHONPATH": f"{REPO / 'src'}{os.pathsep}{REPO}"}
+        env.update(DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+        done = subprocess.run(  # noqa: S603 (this repository's own script)
+            [sys.executable, str(REPO / "scripts" / "reset_check.py")],
+            cwd=REPO,
+            env=env,
+            stdout=subprocess.PIPE,
+            stderr=err,
+            text=True,
+            timeout=60,
+            check=False,
+        )
+    assert done.returncode == 4 and done.stdout == ""
+    assert "something still answers on port" in target.read_text(encoding="utf-8")
+
+
+@_posix
+def test_the_reset_script_keeps_standard_output_empty_for_every_refusal_of_the_check(book: Path) -> None:
+    with bound_socket() as listener:
+        listener.listen(1)
+        done = reset_run(SH, book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+    assert done.returncode == 4 and done.stdout == "" and "something still answers" in done.stderr
+    assert "nothing was deleted" in done.stderr, done.stderr
+
+
+# -- the check runs after the stop and BEFORE any pid file is deleted
+@_posix
+def test_reset_sh_keeps_both_pid_files_when_the_check_refuses_after_it_stopped_the_desk(book: Path) -> None:
+    """The desk (named in desk.pid) is stopped, then something else answers on its port: exit 4. The old order had
+    already deleted desk.pid, so the refusal left no trace of what was stopped; now the pid files stay."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    try:
+        with bound_socket() as listener:
+            listener.listen(1)
+            done = reset_run(SH, book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+        wait_until(lambda: desk.poll() is not None, timeout=10, what="the desk stand-in was stopped")
+    finally:
+        _end(desk)
+    assert done.returncode == 4 and done.stdout == "", (done.stdout, done.stderr)
+    assert (book.parent / "desk.pid").exists() and reset_kept(book)
+    assert "nothing was deleted" in done.stderr and "pid files" in done.stderr, done.stderr
+
+
+@_posix
+def test_reset_sh_keeps_the_utf16_pid_file_of_a_running_desk_when_the_port_check_refuses(book: Path) -> None:
+    """A pid file saved as UTF-16 is stale (nothing is stopped for it). The desk it names really runs and holds the
+    port: exit 4, the desk still runs, and the pid file is kept as the only clue (the old order deleted it first)."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_bytes(str(desk.pid).encode("utf-16"))
+    try:
+        with bound_socket() as listener:
+            listener.listen(1)
+            done = reset_run(SH, book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert done.returncode == 4 and still_running, (done.returncode, done.stdout, done.stderr)
+    assert pidfile.exists() and reset_kept(book)
+
+
+@_posix
+def test_text_only_the_exit_3_and_4_lines_say_what_happened_to_the_pid_files_and_the_records() -> None:
+    text = (REPO / "scripts" / "reset_check.py").read_text(encoding="utf-8")
+    assert text.count("nothing was deleted, not even the pid files") == 1, "one shared sentence for exit 3 and 4"
+    prints = text.count("print(")
+    assert prints >= 1 and prints == text.count("file=sys.stderr"), "a print is not on standard error"
+
+
+# -- a program that changes between the first look and the stop is not stopped
+_CHANGES_ITS_LINE = (
+    "import os, sys, time\n"
+    "go = sys.argv[-1] + '.go'\n"
+    "open(sys.argv[-1], 'w').close()\n"
+    "while not os.path.exists(go):\n"
+    "    time.sleep(0.05)\n"
+    "os.execv(sys.executable, [sys.executable, '-c', 'import time; time.sleep(60)'])\n"
+)
+_ENDS_SLOWLY = (
+    "import signal, sys, time\n"
+    "def stop(*_a):\n"
+    "    open(sys.argv[-1] + '.stopping', 'w').close()\n"
+    "    time.sleep(1.5)\n"
+    "    sys.exit(0)\n"
+    "signal.signal(signal.SIGTERM, stop)\n"
+    "open(sys.argv[-1], 'w').close()\n"
+    "time.sleep(60)\n"
+)
+
+
+@_posix
+def test_reset_sh_does_not_stop_a_process_that_became_another_program_after_the_first_look(book: Path) -> None:
+    """Pass 1 sees both pid files name the desk and the demo server. The desk needs 1.5 seconds to end; while the
+    reset waits, the demo server stand-in executes another program (its command line changes), as a reused number
+    would. The second look refuses with exit 6 and does NOT stop it; the desk, already stopped, is named."""
+    desk = _live(book, "desk", DESK_MODULE, _ENDS_SLOWLY)
+    fakes = _live(book, "fakes", FAKES_MODULE, _CHANGES_ITS_LINE)
+    go = Path(str(book.parent / "fakes.ready") + ".go")
+    stopping = Path(str(book.parent / "desk.ready") + ".stopping")
+    # the demo server changes as soon as the desk has been told to stop
+
+    def trigger() -> None:
+        wait_until(stopping.exists, timeout=30, what="the desk was told to stop")
+        go.write_text("", encoding="utf-8")
+
+    helper = threading.Thread(target=trigger, daemon=True)
+    helper.start()
+    try:
+        done = reset_run(SH, book, **reset_ports())
+        helper.join(timeout=30)
