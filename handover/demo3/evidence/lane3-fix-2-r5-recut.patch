+def test_the_causes_of_a_traceback_named_in_limits_end_in_exit_code_1(env: Env, tmp_path: Path) -> None:
+    """The three causes limits.md lists for exit code 1 and a traceback, each tried on a real desk start."""
+    base_env = {k: v for k, v in child_env().items() if not k.startswith("DESK_")}
+    # 1. no PYTHONPATH: Python cannot find the desk's code (not a fault where the package is installed)
+    no_path = {k: v for k, v in base_env.items() if k != "PYTHONPATH"}
+    probe_code, _ = _run_desk_to_exit(["-c", "import lead_desk"], no_path)
+    if probe_code != 0:
+        code, output = _run_desk_to_exit(["-m", "lead_desk.server"], no_path)
+        assert code == 1 and "lead_desk" in output, f"a missing PYTHONPATH ends with exit code 1: {output[-200:]!r}"
+    # 2. an edited fixed value: a copy of src with MAX_CONNECTIONS below its range
+    src_copy = tmp_path / "src"
+    shutil.copytree(REPO / "src", src_copy, ignore=shutil.ignore_patterns("__pycache__"))
+    constants = src_copy / "lead_desk" / "constants.py"
+    text = constants.read_text(encoding="utf-8")
+    edited = text.replace("MAX_CONNECTIONS: Final = 256", "MAX_CONNECTIONS: Final = 2")
+    assert edited != text, "premise: constants.py holds MAX_CONNECTIONS: Final = 256"
+    constants.write_text(edited, encoding="utf-8")
+    code, output = _run_desk_to_exit(["-m", "lead_desk.server"], {**base_env, "PYTHONPATH": str(src_copy)})
+    assert code == 1 and "Traceback" in output and "MAX_CONNECTIONS must be a whole number" in output, (
+        f"an edited fixed value ends with exit code 1 and a traceback: {code}: {output[-300:]!r}"
+    )
+    # 3. the demo_only folder is missing: only src is on the search path (the working folder is taken off it)
+    _, fakes_url = env.fakes("keyed")
+    without_working_folder = (
+        "import runpy, sys; sys.path[:] = [p for p in sys.path if p]; "
+        "runpy.run_module('lead_desk.server', run_name='__main__')"
+    )
+    code, output = _run_desk_to_exit(
