+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    proc = start_proc(["-m", "lead_desk.server"], env)
+    try:
+        code = proc.wait(timeout=60)
+    finally:
+        output = stop_proc(proc).decode("utf-8", errors="replace")
+    if code == 3:  # the desk checks the open-file limit first (containers often allow only 4096)
+        pytest.skip(f"this computer's open-file limit is too low for the desk (exit 3): {output.strip()[-200:]}")
+    lines = output.strip().splitlines()
+    assert lines, f"premise: the desk printed nothing (exit {code})"
