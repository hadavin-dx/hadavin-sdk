+def _env(tmp_path: Path, fakes_url: str, extra: dict[str, str]) -> dict[str, str]:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}
+    env.update(
+        PYTHONPATH=os.pathsep.join([str(REPO / "src"), str(REPO)]),
+        DESK_DB_PATH=str(tmp_path / "d.sqlite3"),
+        DESK_PORT="0",
+        DESK_FAKES_URL=fakes_url,
+    )
+    env.update(extra)
+    return env
+
+
+def _run(tmp_path: Path, fakes_url: str, extra: dict[str, str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(  # noqa: S603  # nosec B603 - our own module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        capture_output=True,
+        text=True,
+        timeout=60,
+        cwd=tmp_path,
+        env=_env(tmp_path, fakes_url, extra),
+    )
+
