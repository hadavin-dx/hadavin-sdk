+        r"the `demo_only/` folder is missing while the pre-written demo answers are in use",
+        r"a fixed value in `src/lead_desk/constants\.py` that was edited to a number that does not fit",
+    ):
+        assert re.search(cause, bullet), _p(f"a cause of a traceback that was tried: {cause}")
+    assert "never caused by" not in bullet and "it is never" not in bullet, _p(
+        "the false absolute 'a traceback is never caused by a DESK_* setting' is gone"
+    )
+    assert re.search(r"`DESK_\*` value that no check listed under exit code 4 covers is not promised", bullet), _p(
+        "a DESK_* value that no check of exit code 4 covers is not promised to be refused with code 4"
+    )
+    assert "the data folder cannot be created" not in bullet, _p(
+        "the data folder is NOT named as a cause: it is a traceback in one version and exit code 4 in another"
+    )
+    assert "PYTHONPATH" in _read("contract.md").split("## Run commands")[1].split("## ")[0], (
+        "premise: contract.md, Run commands, names PYTHONPATH"
+    )
+    assert "src/lead_desk/constants.py" in bullet and (REPO / "src/lead_desk/constants.py").exists(), _p(
+        "the edited fixed value lives in src/lead_desk/constants.py"
+    )
+    assert re.search(r"real CRM or a real mail sender[^.]*not described here", bullet), _p(
+        "what the desk prints for an unreachable real CRM or mail sender is not described (not claimed)"
+    )
+    for code, words in (
+        (2, "another desk holds the lock file"),
