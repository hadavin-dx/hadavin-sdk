+        {
+            **base_env,
+            "PYTHONPATH": str(REPO / "src"),
+            "DESK_FAKES_URL": fakes_url,
+            "DESK_PORT": str(free_port()),
+            "DESK_DB_PATH": str(tmp_path / "data" / "desk.db"),
+        },
+    )
+    if code == 3:
