+    ):
+        assert re.search(rf"\* Exit code {code}: {re.escape(words)}", bullet), _p(
+            f"exit code {code} is its own sub-bullet ('Exit code {code}: ...'), not part of the sentence of code 1"
+        )
+    assert re.search(r"\* Exit code 1: the demo servers cannot be reached", bullet), _p("exit code 1 is a sub-bullet")
+    assert "constant that is out of range" not in bullet, _p("no unexplained 'constant that is out of range'")
+    contract_line = _line_with(_read("contract.md"), "* Exit codes: 1 ")
+    assert "1 the demo servers cannot be reached" in contract_line, _p("contract.md names the demo servers for code 1")
+    assert "sender cannot be reached" not in contract_line and "constant that is out of range" not in contract_line, _p(
+        "contract.md does not repeat the old words 'sender' and 'a constant that is out of range'"
+    )
