+    assert printed, f"premise: the desk prints a line that starts with the words below: {lines[-3:]}"
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    bullet = _between(_read("docs/limits.md"), "* Exit codes of the desk:", "* Stopping:")
+    assert phrase in bullet, _p("limits.md quotes the words the desk prints for exit code 1")
+    assert "the sender cannot be reached" not in bullet, _p("the old word 'sender' for the demo servers is gone")
+    assert re.search(r"Python traceback \(a long error text\)\. A traceback means a program fault", bullet), _p(
+        "a traceback is a long error text and means a program fault or a problem the desk does not check for"
+    )
+    for cause in (
