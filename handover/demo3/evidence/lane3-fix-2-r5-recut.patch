+def _run_desk_to_exit(args: list[str], env: dict[str, str]) -> tuple[int, str]:
+    proc = start_proc(args, env)
+    try:
+        code = proc.wait(timeout=60)
+    finally:
+        output = stop_proc(proc).decode("utf-8", errors="replace")
+    return code, output
