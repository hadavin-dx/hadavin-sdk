+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = {k: v for k, v in child_env().items() if not k.startswith("DESK_")}  # nothing of the tester's own settings
+    env.update(
+        DESK_PORT=str(free_port()),
