+"""Facts in README.md, docs/limits.md and docs/n8n-recipe.md that earlier review readers found wrong or missing.
+
+How the tests work. Where a fact can be read from the code, the workflow files or a real desk, the test reads it there
+and then checks that the text states it. The text checks pin FACTS (numbers, field names, command names, file names)
+by regular expression, not the exact wording, so a rewrite in better words does not fail them but a wrong number does.
+Every assert on document text carries a message that starts with "this sentence protects:" and says which fact to keep
+if you reword the sentence. Asserts on code or files (tests named `premise_` and asserts whose message starts with
+"premise:") check that a file still has the shape the text relies on; they read files, not the text.
+No demo servers and no n8n are needed: the real desk is started as a child program against an in-process stand-in
+for the demo servers, on a free port, with made-up data only."""
+
+from __future__ import annotations
+
+import importlib
+import json
+import re
+import shutil
+import sqlite3
+import sys
+from pathlib import Path
+from typing import cast
+
+import pytest
+from conftest import Env
+from support import HOST, call, child_env, free_port, post_lead, start_proc, stop_proc, wait_until
+
+from demo_only import burst
+from lead_desk.config import Config
+from lead_desk.urls import DESK_SCHEME, desk_origin
+
+REPO = Path(__file__).resolve().parents[1]
+DESK_PORT = Config().port  # the default ports are read from Config and from the n8n script, never typed here
+FAKES_PORT = Config().fakes_port
+FIVE = ("received", "new", "duplicate", "review", "open")
+FIVE_NAMED = r"`received`, `new`, `duplicate`, `review` and `open`"
+
+
+def _n8n_default_port() -> int:
+    """The port in the default n8n address of scripts/n8n_api.py (the one place that holds it)."""
+    text = (REPO / "scripts" / "n8n_api.py").read_text(encoding="utf-8")
+    found = re.search(rf"{DESK_SCHEME}://{re.escape(HOST)}:(\d+)", text)
+    assert found, "premise: scripts/n8n_api.py has a default n8n address"
+    return int(found.group(1))
+
+
+N8N_PORT = _n8n_default_port()
+
+
+def _p(what: str) -> str:
+    return f"this sentence protects: {what} (if you reword the sentence, keep this fact)"
+
+
+def _read(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def _line_with(text: str, start: str) -> str:
+    lines = [ln for ln in text.splitlines() if ln.lstrip().startswith(start)]
+    assert len(lines) == 1, f"premise: exactly one line starts with {start!r}, found {len(lines)}"
+    return lines[0]
+
+
+def _flat(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _search(pattern: str, text: str) -> re.Match[str]:
+    """re.search that must find something (so the result can be used without a type escape)."""
+    found = re.search(pattern, text)
+    assert found, f"premise: the pattern {pattern!r} must occur in the text"
+    return found
+
+
+def _between(text: str, start: str, end: str) -> str:
+    """The part of `text` from the line starting with `start` up to (not including) the line starting with `end`."""
+    lines = text.splitlines()
+    first = next(i for i, ln in enumerate(lines) if ln.lstrip().startswith(start))
+    last = next(i for i, ln in enumerate(lines) if i > first and ln.lstrip().startswith(end))
+    return _flat("\n".join(lines[first:last]))
+
