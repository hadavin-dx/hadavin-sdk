diff --git a/tests/test_docs_claims_lane3.py b/tests/test_docs_claims_lane3.py
new file mode 100644
index 0000000..0bd99bd
--- /dev/null
+++ b/tests/test_docs_claims_lane3.py
@@ -0,0 +1,279 @@
+"""Facts in README.md, docs/limits.md and docs/n8n-recipe.md that earlier review readers found wrong or missing.
+
+How the tests work. Where a fact can be read from the code, the workflow files or a real desk, the test reads it there
+and then checks that the text states it. The text checks pin FACTS (numbers, field names, command names, file names)
+by regular expression, not the exact wording, so a rewrite in better words does not fail them but a wrong number does.
+Tests marked `premise_` check that a file still has the shape the text relies on (they read files, not the text).
+Every assert carries a message that starts with "this sentence protects:" so a failure names the sentence at risk.
+No demo servers and no n8n are needed: the real desk is started as a child program against an in-process stand-in
+for the demo servers, on a free port, with made-up data only."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import socket
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import HOST, call, child_env, free_port, post_lead, start_proc, stop_proc, wait_until
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def _p(what: str) -> str:
+    return f"this sentence protects: {what}"
+
+
+def _read(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def _free_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(("127.0.0.1", 0))
+        return int(s.getsockname()[1])
+
+
+def _line_with(text: str, start: str) -> str:
+    lines = [ln for ln in text.splitlines() if ln.lstrip().startswith(start)]
+    assert len(lines) == 1, _p(f"exactly one line starts with {start!r}, found {len(lines)}")
+    return lines[0]
+
+
+def _flat(text: str) -> str:
+    return " ".join(text.split())
+
+
+# ---- limits.md: exit code 1 names what the desk really prints ----
+
+
+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}  # nothing of the tester's own settings
+    env["PYTHONPATH"] = os.pathsep.join([str(REPO / "src"), str(REPO)])
+    env.update(
+        DESK_PORT=str(_free_port()),
+        DESK_FAKES_PORT=str(_free_port()),  # nothing listens here: the demo servers are "not running"
+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    done = subprocess.run(  # noqa: S603 - our own interpreter and module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        cwd=tmp_path,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    assert done.returncode == 1, _p(f"exit code 1 means the demo servers cannot be reached: {done.returncode}")
+    printed = done.stdout.strip().splitlines()[-1]
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    assert phrase.startswith("cannot reach the demo servers"), _p(f"the desk prints this, not another phrase: {printed}")
+    bullet = _line_with(_read("docs/limits.md"), "* Exit codes:")
+    assert phrase in bullet, _p("limits.md quotes the words the desk prints for exit code 1")
+    assert "the sender cannot be reached" not in bullet, _p("the old word 'sender' for the demo servers is gone")
+    assert re.search(r"traceback[^;]*bug in the program[^;]*not a setting", bullet), _p(
+        "the traceback case is explained as a bug in the program, not a setting"
+    )
+    assert "constant that is out of range" not in bullet, _p("no unexplained 'constant that is out of range'")
+
+
+# ---- one real desk: the facts of the README demo and of the burst bullet ----
+
+
+def _start_real_desk(env, tmp_path: Path):  # type: ignore[no-untyped-def]
+    """The README desk as a child program, with the demo servers stood in for by the tests' own server."""
+    _, fakes_url = env.fakes("keyed")
+    port = free_port()
+    env_vars = child_env(
+        DESK_DB_PATH=str(tmp_path / "desk.sqlite3"), DESK_BIND=HOST, DESK_PORT=str(port), DESK_FAKES_URL=fakes_url
+    )
+    proc = start_proc(["-m", "lead_desk.server"], env_vars)
+    env.stop_on_close(lambda: stop_proc(proc))
+    base = f"http://{HOST}:{port}"
+    wait_until(lambda: proc.poll() is not None or call(base, "GET", "/counts")[0] == 200, what="desk ready")
+    assert proc.poll() is None, _p("the README desk starts with the demo settings")
+    return base
+
+
+def test_readme_counts_line_matches_the_real_counts_of_a_fresh_desk(env, tmp_path: Path) -> None:
+    base = _start_real_desk(env, tmp_path)
+    status, reply = call(base, "GET", "/counts")
+    assert status == 200, _p("the counts check answers HTTP 200")
+    five = ("received", "new", "duplicate", "review", "open")
+    for name in five:
+        assert reply[name] == 0, _p(f"the five counts are 0 on a fresh desk: {name}")
+    others = [k for k, v in reply.items() if isinstance(v, int) and not isinstance(v, bool) and k not in five and k != "last_reaper_pass_at"]  # that one is a time, not a count
+    assert others, _p("there are other counts besides the five counts")
+    for name in others:
+        assert reply[name] == 0, _p(f"every other count is 0 on a fresh desk: {name}")
+    assert all(v == 0 for v in reply["hung_workers"].values()), _p("the four numbers inside hung_workers are 0")
+    wait_until(lambda: call(base, "GET", "/counts")[1]["reaper_running"] is True, what="reaper running")
+    reply = call(base, "GET", "/counts")[1]
+    assert reply["reaper_running"] is True, _p("`reaper_running` is true")
+    assert reply["last_reaper_pass_at"] is None or isinstance(reply["last_reaper_pass_at"], int), _p(
+        "`last_reaper_pass_at` is nothing (null) or a whole number of seconds"
+    )
+    assert reply["expected_match"] is None and reply["ok"] is None, _p("`expected_match` and `ok` are null")
+
+    readme = _read("README.md")
+    linux = _flat(_line_with(readme, "for i in 1 2 3"))
+    assert "`received`, `new`, `duplicate`, `review` and `open`" in linux, _p("the five counts are named")
+    assert re.search(r"Every other count in the reply is 0 too", linux), _p("the other counts are said to be 0 too")
+    for name in ("rejected_envelopes", "failed_followups", "hung_workers"):
+        assert name in linux and name in reply, _p(f"the Linux line names the real field {name}")
+    assert re.search(r"`reaper_running` is `true`", linux), _p("`reaper_running` is stated as true")
+    assert re.search(r"`last_reaper_pass_at` is not a count", linux) and "`null`" in linux, _p(
+        "last_reaper_pass_at is a time, not a count, and can be null"
+    )
+    assert "not 0" not in linux and "are not counts of leads" not in linux, _p("the old false 'not 0' claim is gone")
+    windows = _flat(_line_with(readme, "Start-Sleep 3; Invoke-WebRequest"))
+    assert "`received`, `new`, `duplicate`, `review` and `open`" in windows, _p("the Windows line names the five counts")
+    assert re.search(r"the other counts", windows), _p("the Windows line says the other counts are 0 too")
+
