+def test_readme_port_check_explains_000_and_404() -> None:
+    readme = _read("README.md")
+    linux = readme.split("**Linux**")[1].split("**Windows PowerShell**")[0]
+    assert "curl " in linux, "premise: the Linux block uses curl (reads the block, not the 'You need' sentence)"
+    need = _flat(_line_with(readme, "You need Linux or Windows"))
+    assert "`curl`" in need, _p("curl is listed as needed on Linux")
+    assert "8765" in need and "http_code" in need, _p("the port check command is shown")
+    assert re.search(r"`000` usually means nothing is listening", need), _p("000 usually means nothing is listening")
+    assert re.search(r"does not speak web", need), _p("000 can also mean a program that does not speak web")
+    assert re.search(r"404[^.]*already answers", need) and "bash scripts/reset.sh" in need, _p(
+        "404 means a program answers; the earlier desk is that program; otherwise stop it or reset"
+    )
+    assert re.search(r"makes curl print only the three-digit", need), _p("http_code is explained")
