+def _ports_in(path: Path) -> set[int]:
+    text = path.read_text(encoding="utf-8")
+    json.loads(text)  # the file must still be a workflow
+    return {int(n) for n in re.findall(r"http://127\.0\.0\.1:(\d+)/", text)}
+
+
+def test_premise_workflow_files_carry_the_default_ports_each() -> None:
+    """Reads the files (not the recipe text): which port each workflow file has written into its web addresses."""
+    from lead_desk.config import Config
+
+    config = Config.from_env({})
+    n8n_default = int(re.search(r"http://127\.0\.0\.1:(\d+)", _read("scripts/n8n_api.py")).group(1))  # type: ignore[union-attr]
+    assert _ports_in(REPO / "n8n" / "desk-form.json") == {config.port}, "premise: form file needs only the desk"
+    assert _ports_in(REPO / "n8n" / "desk-webhook.json") == {config.port}, "premise: webhook file needs only the desk"
+    assert _ports_in(REPO / "n8n" / "proof.json") == {config.port, config.fakes_port, n8n_default}, (
+        "premise: the proof file needs the desk, the demo servers and n8n"
+    )
+
+
