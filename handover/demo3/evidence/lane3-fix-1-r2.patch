+def test_readme_demo_and_burst_bullet_match_a_real_replay(env, tmp_path: Path) -> None:
+    base = _start_real_desk(env, tmp_path)
+    one = {"name": "Ada Example", "email": "ada@example.test", "phone": "555 0100", "company": "Example Ltd"}
+    first = post_lead(base, "form", "f-1", one)
+    again = post_lead(base, "form", "f-1", one)  # the same request number: a replay
+    other_door = post_lead(base, "webhook", "w-1", one)  # same person, new request number
+    other_door_again = post_lead(base, "webhook", "w-1", one)  # a replay of a stored `duplicate`
+    assert first[0] == 201 and first[1]["verdict"] == "new", "premise: a new lead answers 201 new"
+    assert again[0] == 201 and again[1].get("replayed") is True, "premise: a replay of a `new` answers 201 replayed"
+    assert other_door[0] == 200 and other_door[1]["verdict"] == "duplicate", "premise: a duplicate answers 200"
+    assert other_door_again[0] == 200, "premise: a replay of a stored `duplicate` answers 200"
+    counts = call(base, "GET", "/counts")[1]
+    assert (counts["received"], counts["new"], counts["duplicate"]) == (2, 1, 1), _p(
+        "README: received 2, new 1, duplicate 1 (a replay is not counted again)"
+    )
+    receipt = other_door[1]["receipt_id"]
+    assert receipt == 3, _p("README: the other door's receipt_id is 3, not 2 (the replay took number 2)")
+    assert "receipt_id INTEGER PRIMARY KEY AUTOINCREMENT" in _read("src/lead_desk/schema.sql"), (
+        "premise: receipt numbers only go up (reads the schema file, not the text)"
+    )
+
+    readme = _read("README.md")
+    linux_line = _flat(_line_with(readme, "python scripts/feed.py --source webhook --index 1"))
+    windows_line = _flat(_line_with(readme, r"python scripts\feed.py --source webhook --index 1"))
+    for label, line in (("Linux", linux_line), ("Windows", windows_line)):
+        assert "HTTP 200 (not 201)" in line, _p(f"{label} webhook line: the duplicate answers HTTP 200, not 201")
+        assert re.search(rf"`receipt_id` is {receipt}\b", line), _p(f"{label} webhook line: receipt_id is {receipt}")
+    assert re.search(r"took a receipt number", linux_line), _p("the repeated request is said to take a receipt number")
+    assert re.search(r"can skip a number", linux_line), _p("receipt numbers can skip a number")
+
+    bullet = _flat(_line_with(_read("docs/limits.md"), "* Burst test:"))
+    definition = bullet.split("A fresh desk is ")[1].split("Then run")[0]
+    assert "scripts/reset.sh" in definition and "scripts/start_all.sh" in definition, _p(
+        "the fresh-desk definition names the two scripts"
+    )
+    assert "just started" not in bullet, _p("the old 'just started' wording is gone")
+    assert "lead count and the follow-up count" not in bullet, _p("the old, non-existent 'lead count' field is gone")
+    assert re.search(r"STATUS 201=1 200=99", bullet), _p("a fresh desk: 201=1 and 200=99 for 100 sends")
+    same = bullet.split("SAME `--ref-prefix`")[1].split("DIFFERENT")[0]
+    assert re.search(r"201=1 200=99", same) and "`new` stays 1" in same, _p(
+        "the same prefix again: the stored answers come back (201=1 200=99) and `new` stays 1"
+    )
+    diff = bullet.split("DIFFERENT `--ref-prefix`")[1]
+    assert re.search(r"STATUS 200=100", diff) and "does not grow" in diff, _p(
+        "a different prefix on a desk that holds the address: every answer is 200"
+    )
+    assert re.search(r'"count": 1', bullet) and "fake/outbox" in bullet, _p("the outbox shows one email")
