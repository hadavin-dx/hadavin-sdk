+    )
+    out = done.stdout + done.stderr
+    assert (tmp_path / "shim-flag").exists(), "the stand-in was never reached"
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert "started:" not in out and "the desk ended at once (exit 0)" in done.stderr, out[-500:]
+    assert not (data / "fakes.pid").exists() and not (data / "desk.pid").exists()
