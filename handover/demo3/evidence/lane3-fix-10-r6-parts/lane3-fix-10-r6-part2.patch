+def test_a_path_that_is_not_valid_text_is_refused_by_config(name: str, bad: str) -> None:
+    env = {**LIVE_GOOD, "DESK_LATER_MODE": "approval", name: bad}
+    if name == "DESK_LEADFLOW_FILE" and not bad.strip():
+        # the one rule for an OPTIONAL file setting: empty or white space only means unset (here: the feature is off);
+        # a REQUIRED one is refused (the live-model and adapter cases below)
+        assert Config.from_env(env).leadflow_path is None
+        return
+    with pytest.raises(SettingRefused, match=f"{name} (is not a valid path|is required)"):
