+def _run_with_path(tmp: Path, only_path: str) -> subprocess.CompletedProcess[str]:
+    env = child_env(
+        DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_PORT=str(free_port()), DESK_FAKES_PORT=str(free_port())
+    )
+    env["PATH"] = only_path
+    return subprocess.run(  # noqa: S603 - our own script, made-up values, throwaway folder
+        [shutil.which("bash") or "bash", str(REPO / "scripts" / "start_all.sh")],
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+        check=False,
+    )
