+def test_a_path_that_is_not_valid_text_is_refused_by_every_adapter_reader(name: str, cls: str, bad: str) -> None:
+    """The adapters' own readers (crm_hubspot, smtp_provider) use the same path helper as Config."""
+    from lead_desk.crm_hubspot import HubspotSettings
+    from lead_desk.smtp_provider import ProviderSettings
+
+    good = {
+        "HubspotSettings": {"DESK_HUBSPOT_KEY_FILE": "k.txt", "DESK_HUBSPOT_MAX_CALLS": "10"},
+        "ProviderSettings": {
