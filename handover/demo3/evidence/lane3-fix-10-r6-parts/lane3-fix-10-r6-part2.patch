+def test_list_items_url_user_and_the_ends_of_a_long_value_are_blanked_too() -> None:
+    from lead_desk.config_exit import refusal_line
+
+    items = {"DESK_ALLOWED_HOSTS": "alpha-host.test,beta-host.test"}
+    line = refusal_line("x:", "DESK_ALLOWED_HOSTS has beta-host.test", items)
+    assert "beta-host" not in line and "<value>" in line
