+def test_a_demo_server_that_dies_between_its_line_and_the_port_answer_is_not_up(tmp_path: Path, cleanup: None) -> None:
+    """The second alive check of the demo-server loop, tested on its own: the demo server prints its ownership line, the
+    stand-in grep then ends it, waits until it is gone and lets this test take its port (a foreign program). The line
+    is there and the port answers, but the process is dead: the desk must never be launched."""
+    port = free_port()
+    marker = tmp_path / "desk-was-started"
+    stub = _stub_python(
+        tmp_path, f"touch {marker}; exec sleep 60", 'echo "fakes server keyed on port $DESK_FAKES_PORT"; exec sleep 60'
+    )
+    data = tmp_path / "data"
+    flag = tmp_path / "shim-flag"
+    taken = tmp_path / "port-taken"
+    _grep_after_match(
+        stub,
+        "^fakes server",
+        f'pid="$(cat "$FAKES_PID_FILE")"; kill "$pid"; {_WAIT_GONE}; '
+        f'touch "$GONE_FLAG"; for _ in $(seq 1 100); do [[ -e "$TAKEN_FLAG" ]] && break; sleep 0.05; done',
+    )
+    gone = tmp_path / "demo-server-gone"
+    held = socket.socket()
+    stop = threading.Event()
+    listening: list[tuple[str, int]] = []
+
+    def take_the_port_when_gone() -> None:
+        while not gone.exists() and not stop.is_set():
+            stop.wait(0.02)
+        if gone.exists():
+            held.bind((LOOPBACK, port))
+            held.listen()
+            listening.append(held.getsockname())
+            taken.touch()
+
+    thread = threading.Thread(target=take_the_port_when_gone)
+    thread.start()
+    try:
+        done = _run(
+            tmp_path,
+            first_on_path=stub,
+            wait="5",
+            DESK_FAKES_PORT=str(port),
+            SHIM_FLAG=str(flag),
+            FAKES_PID_FILE=str(data / "fakes.pid"),
+            GONE_FLAG=str(gone),
+            TAKEN_FLAG=str(taken),
+        )
+    finally:
+        stop.set()
+        thread.join(timeout=10)
+        held.close()
+    out = done.stdout + done.stderr
+    assert flag.exists() and listening == [(LOOPBACK, port)], "the stand-in or the listener did not run: nothing proven"
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert not marker.exists(), "the desk was launched although the demo server was dead"
+    assert "started:" not in out and "the demo server stopped at once" in done.stderr, out[-500:]
+    assert not (data / "fakes.pid").exists()
+
