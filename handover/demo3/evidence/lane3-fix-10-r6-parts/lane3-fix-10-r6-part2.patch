+def _grep_after_match(stub_dir: Path, pattern: str, then: str) -> None:
+    """A `grep` stand-in first on PATH. It runs the real grep; when the real answer is "found" for a call whose words
+    hold `pattern`, it runs the shell lines `then` ONCE (a flag file) and only then returns the real answer. This
+    puts the
+    test exactly between "the script saw the line" and "the script looks at the process", with no sleep margin."""
+    shim = stub_dir / "grep"
+    shim.write_text(
+        "#!/bin/bash\n"
+        f'{REAL_GREP} "$@"; rc=$?\n'
+        f'if [[ $rc == 0 && "$*" == *{shlex.quote(pattern)}* && ! -e "$SHIM_FLAG" ]]; then\n'
+        f'  touch "$SHIM_FLAG"; {then}\n'
+        "fi\n"
+        "exit $rc\n",
+        encoding="utf-8",
+    )
+    shim.chmod(0o755)
+
+
+_WAIT_GONE = 'for _ in $(seq 1 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done'
