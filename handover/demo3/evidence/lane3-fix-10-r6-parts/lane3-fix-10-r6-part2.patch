+def test_a_slow_port_probe_does_not_stretch_the_wait(tmp_path: Path, cleanup: None) -> None:
+    """The wait is a clock deadline, not a count of short sleeps: every probe here takes about one second (a `timeout`
+    stand-in), the demo server never answers, the budget is 2 seconds. The old count (5 sleeps per second of budget,
+    each
+    followed by a probe) took more than 10 seconds. The line states the seconds really waited."""
+    stub = _stub_python(
+        tmp_path, "exec sleep 120", 'echo "fakes server keyed on port $DESK_FAKES_PORT"; exec sleep 120'
+    )
+    slow = stub / "timeout"
+    real = shutil.which("timeout")
+    assert real
+    slow.write_text(f'#!/bin/bash\nsleep 1\nexec {shlex.quote(real)} "$@"\n', encoding="utf-8")
+    slow.chmod(0o755)
+    start = time.monotonic()
+    done = _run(tmp_path, first_on_path=stub, wait="2")
+    elapsed = time.monotonic() - start
+    assert done.returncode == EXIT_START_NOT_DONE, (done.stdout, done.stderr)
+    assert "the demo server did not answer in " in done.stderr, done.stderr
+    waited = int(done.stderr.split("did not answer in ")[1].split(" ")[0])
+    assert 2 <= waited <= 5 and elapsed < 9, (waited, elapsed)
