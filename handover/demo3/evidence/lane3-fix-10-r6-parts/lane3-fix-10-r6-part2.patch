+SURROGATE = "a\udc80b"
+
+
+# text that is not a path: a lone surrogate, NUL, a line end, a tab, an escape, DEL, white space only
+BAD_PATH_TEXTS = [SURROGATE, "a\0b", "a\nb", "a\r\nb", "a\tb", "a\x1bb", "a\x7fb", " ", "   ", "\t", "\n"]
