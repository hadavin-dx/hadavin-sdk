@@ -0,0 +1,49 @@
+"""One test for each boundary of `config_exit.scrub_values`, written so that a mutant that moves the boundary fails.
+
+The three boundaries: (1) a setting whose NAME says secret, address or user is blanked wherever its value shows, even
+when the message does not name it; (2) any other setting (a path, a limit) is blanked only when the message names it,
+and stays readable when it does not (the decision of round 5: a message never holds a value by accident, and a
+non-secret path the message does not name is ordinary text); (3) a fixed advice text of ours stays readable even when a
+host setting holds the same words. Made-up values only.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from lead_desk.config_exit import VALUE_MARK, scrub_values
+from lead_desk.constants import PUBLIC_BIND_ADVICE
+
+SECRET_VALUE = "/made/up/keys/" + "hubspot-qq7.txt"
+PATH_VALUE = "/made/up/replies/" + "book-zz3.json"
+
+
+def test_a_secret_like_setting_is_blanked_even_when_the_message_does_not_name_it() -> None:
+    text = f"cannot open {SECRET_VALUE} now"
+    out = scrub_values(text, {"DESK_HUBSPOT_KEY_FILE": SECRET_VALUE})
+    assert SECRET_VALUE not in out and VALUE_MARK in out
+
+
+def test_a_path_setting_is_blanked_when_the_message_names_it() -> None:
+    text = f"DESK_REPLIES_PATH holds {PATH_VALUE}"
+    out = scrub_values(text, {"DESK_REPLIES_PATH": PATH_VALUE})
+    assert PATH_VALUE not in out and "DESK_REPLIES_PATH" in out and VALUE_MARK in out
+
+
+def test_a_path_setting_the_message_does_not_name_stays_readable() -> None:
+    text = f"cannot open {PATH_VALUE} now"
+    out = scrub_values(text, {"DESK_REPLIES_PATH": PATH_VALUE})
+    assert out == text
+
+
+def test_a_fixed_advice_text_stays_readable_when_a_host_setting_holds_its_words() -> None:
+    env = {"DESK_FAKES_HOST": "127.0.0.1"}
+    out = scrub_values(f"refused: {PUBLIC_BIND_ADVICE}", env)
+    assert PUBLIC_BIND_ADVICE in out and VALUE_MARK not in out
+    assert VALUE_MARK in scrub_values("the host 127.0.0.1 is refused", env)  # outside the advice text it is blanked
+
+
+@pytest.mark.parametrize("name", ["DESK_SMTP_FROM", "DESK_LIVE_BASE_URL", "REAL_IMAP_1_USER", "DESK_NUDGE_TO"])
+def test_each_secret_like_name_shape_is_blanked_unnamed(name: str) -> None:
+    value = "made-up-value-" + "k9x2"
+    assert value not in scrub_values(f"it said {value}", {name: value})
