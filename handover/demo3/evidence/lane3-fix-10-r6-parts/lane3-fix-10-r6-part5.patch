@@ -0,0 +1,207 @@
+"""Round 5 of fix-10: the demo server binds the configured host, the formatter writes UTF-8 bytes, a reader that cannot
+open a file names its setting group, and the two lists of setting prefixes agree. Made-up data, loopback only."""
+
+from __future__ import annotations
+
+import socket
+import subprocess
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env
+
+sys.path.insert(0, str(REPO / "scripts"))
+import run_real_check as rrc  # noqa: E402
+
+from demo_only.fakes_server import make_fakes_server  # noqa: E402
+from lead_desk.config_exit import SETTING_PREFIXES  # noqa: E402
+from lead_desk.constants import EXIT_SCRIPT_SETTING_REFUSED  # noqa: E402
+from lead_desk.envnum import SettingRefused  # noqa: E402
+
+
+def _ipv6_loopback() -> bool:
+    try:
+        with socket.socket(socket.AF_INET6) as probe:
+            probe.bind(("::1", 0))
+        return True
+    except OSError:
+        return False
+
+
+# -- row 2: the demo server binds the host it is given --------------------------------------------------------------
+def test_the_demo_server_binds_the_ipv4_host_it_is_given() -> None:
+    srv = make_fakes_server("keyed", 0, host="127.0.0.1")
+    try:
+        assert srv.server_address[0] == "127.0.0.1" and srv.address_family == socket.AF_INET
+    finally:
+        srv.server_close()
+
+
+@pytest.mark.skipif(
+    not _ipv6_loopback(),
+    reason="no IPv6 on this computer (checked 2026-11-14: AF_INET6 sockets are refused by this kernel)",
+)
+@pytest.mark.parametrize("host", ["::1", "[::1]"])
+def test_the_demo_server_binds_an_ipv6_host_and_answers_there(host: str) -> None:
+    srv = make_fakes_server("keyed", 0, host=host)
+    thread = threading.Thread(target=srv.serve_forever, daemon=True)
+    thread.start()
+    try:
+        assert srv.address_family == socket.AF_INET6 and srv.server_address[0] == "::1"
+        port = srv.server_address[1]
+        with socket.create_connection(("::1", port), timeout=3):
+            pass
+        with socket.socket(socket.AF_INET) as v4, pytest.raises(OSError):
+            v4.settimeout(1)
+            v4.connect(("127.0.0.1", port))  # bound to ::1 only
+    finally:
+        srv.shutdown()
+        srv.server_close()
+        thread.join(timeout=5)
+
+
+@pytest.mark.parametrize(
+    ("host", "family", "address"),
+    [("::1", "six", ("::1", 0)), ("[::1]", "six", ("::1", 0)), ("127.0.0.1", "four", ("127.0.0.1", 0))],
+)
+def test_the_demo_server_picks_the_address_family_of_its_host_without_binding(
+    host: str, family: str, address: tuple[str, int], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Runs without any IPv6: the class chosen and the address handed to it are checked with stand-ins."""
+    import demo_only.fakes_server as fs
+
+    made: list[tuple[str, tuple[str, int]]] = []
+
+    class Six:
+        def __init__(self, addr: tuple[str, int], handler: object) -> None:
+            made.append(("six", addr))
+
+    class Four(Six):
+        def __init__(self, addr: tuple[str, int], handler: object) -> None:
+            made.append(("four", addr))
+
+    monkeypatch.setattr(fs, "FakesServer6", Six)
+    monkeypatch.setattr(fs, "FakesServer", Four)
+    fs.make_fakes_server("keyed", 0, host=host)
+    assert made == [(family, address)]
+
+
+def test_the_ipv6_server_class_is_an_ipv6_socket_server() -> None:
+    import demo_only.fakes_server as fs
+
+    assert fs.FakesServer6.address_family == socket.AF_INET6 and issubclass(fs.FakesServer6, fs.FakesServer)
+
+
+def test_the_demo_server_command_line_takes_a_host(monkeypatch: pytest.MonkeyPatch) -> None:
+    import demo_only.fakes_server as fs
+
+    seen: dict[str, object] = {}
+
+    class Stop(Exception):
+        pass
+
+    def fake_make(mode: str, port: int, crm: str, host: str | None) -> object:
+        seen.update(mode=mode, port=port, host=host)
+        raise Stop
+
+    monkeypatch.setattr(fs, "make_fakes_server", fake_make)
+    with pytest.raises(Stop):
+        fs.main(["--outbox", "keyed", "--port", "5", "--host", "[::1]"])
+    assert seen == {"mode": "keyed", "port": 5, "host": "[::1]"}
+
+
+def test_only_one_pair_of_brackets_is_taken_off_a_host() -> None:
+    with pytest.raises(OSError):  # "[[::1]]" is not an address: one pair off leaves "[::1]", which cannot be bound
+        make_fakes_server("keyed", 0, host="[[::1]]").server_close()
+
+
+# -- row 6: the one-line formatter writes UTF-8 bytes whatever the console code page is -----------------------------
+def test_the_formatter_module_writes_utf8_bytes_under_a_narrow_console_code_page() -> None:
+    line = "the log said café – über 中"
+    env = child_env(PYTHONIOENCODING="cp1252", PYTHONUTF8="0")
+    done = subprocess.run(  # noqa: S603 - our own interpreter and module
+        [sys.executable, "-m", "lead_desk.config_exit"],
+        input=line.encode("utf-8"),
+        capture_output=True,
+        env=env,
+        cwd=REPO,
+        timeout=60,
+        check=False,
+    )
+    assert done.returncode == 0, done.stderr[-300:]
+    assert done.stdout == line.encode("utf-8") + b"\n", done.stdout
+
+
+# -- row 8: a reader that cannot open a file names its group; the fixed text is reached and shown -----------------
+def test_a_reader_that_cannot_open_a_file_names_its_setting_group() -> None:
+    def reader() -> None:
+        raise PermissionError(13, "denied: /made/up/secret-path-qq1")
+
+    with pytest.raises(SettingRefused) as seen:
+        rrc._readable("DESK_SMTPP_*", reader)
+    assert str(seen.value) == "a file named by a DESK_SMTPP_* setting cannot be read"
+    assert "qq1" not in str(seen.value)
+
+
+def test_an_error_no_reader_names_gets_the_fixed_text_and_the_setting_exit_code(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    def boom(env: object, inboxes: object) -> str:
+        raise OSError(13, "denied: /made/up/secret-path-qq2")
+
+    monkeypatch.setattr(rrc, "check_mailbox_order", boom)
+    code = rrc.main(["--dry-fakes", "--assume-yes"])
+    out = capsys.readouterr().out
+    lines = [ln for ln in out.splitlines() if ln.startswith("refused:")]
+    assert code == EXIT_SCRIPT_SETTING_REFUSED, out[-500:]
+    assert lines == ["refused: a setting or a file named in the config cannot be used"], lines
+    assert "qq2" not in out
+
+
+def test_a_named_reader_failure_ends_the_check_with_one_line_naming_the_group(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    def boom(env: object) -> list[object]:
+        raise PermissionError(13, "denied: /made/up/secret-path-qq3")
+
+    monkeypatch.setattr(rrc, "imap_settings", boom)
+    code = rrc.main(["--dry-fakes", "--assume-yes"])
+    out = capsys.readouterr().out
+    assert code == EXIT_SCRIPT_SETTING_REFUSED, out[-500:]
+    assert "refused: a file named by a REAL_IMAP_* setting cannot be read" in out and "qq3" not in out
+
+
+# -- row 18: the child-environment prefixes are a subset of the one list -----------------------------------------------
+def test_the_prefixes_the_check_passes_on_are_a_subset_of_the_one_list() -> None:
+    assert set(rrc.CHILD_ENV_PREFIXES) <= set(SETTING_PREFIXES)
+    assert rrc.CHILD_ENV_PREFIXES, "an empty tuple would pass nothing on"
+
+
+# -- row 19: an optional file setting that is empty or white space means unset; a required one is refused ---------
+@pytest.mark.parametrize("empty", ["", " ", "\t"])
+def test_an_empty_optional_ca_file_is_unset_and_an_empty_password_file_is_refused(empty: str) -> None:
+    base = {"REAL_IMAP_1_USER": "someone", "REAL_IMAP_1_PASSWORD_FILE": "pw.txt"}
+    inboxes = rrc.imap_settings({**base, "REAL_IMAP_1_CA_FILE": empty})
+    assert len(inboxes) == 1 and inboxes[0].ssl_context is None
+    with pytest.raises(SettingRefused, match="REAL_IMAP_1_PASSWORD_FILE is required"):
+        rrc.imap_settings({**base, "REAL_IMAP_1_PASSWORD_FILE": empty})
+
+
+def test_a_directory_is_not_a_certificate_file_and_the_refusal_names_the_setting(tmp_path: Path) -> None:
+    base = {"REAL_IMAP_1_USER": "someone", "REAL_IMAP_1_PASSWORD_FILE": "pw.txt", "REAL_IMAP_1_CA_FILE": str(tmp_path)}
+    with pytest.raises(SettingRefused, match="REAL_IMAP_1_CA_FILE cannot be used"):
+        rrc.imap_settings(base)
+
+
+def test_the_demo_server_allows_address_reuse_everywhere_but_windows() -> None:
+    """Row 5: on Windows SO_REUSEADDR allows a second bind of a used port, so the ownership line would not prove that
+    the
+    port is ours. The decision is a function of the platform name (tested with both names)."""
+    import demo_only.fakes_server as fs
+
+    assert fs.reuse_address_allowed("win32") is False
+    assert fs.reuse_address_allowed("linux") is True and fs.reuse_address_allowed("darwin") is True
+    assert fs.FakesServer.allow_reuse_address is fs.reuse_address_allowed(sys.platform)
+    assert fs.FakesServer6.allow_reuse_address is fs.FakesServer.allow_reuse_address
