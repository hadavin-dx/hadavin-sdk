+"""The one table of exit codes (`constants.EXIT_CODE_TABLE`, keyed by PROGRAM) must say what the programs do.
+
+Checked here: inside one program a code has one meaning; the numbers that mean different things in different programs
+are exactly the pinned list `SAME_NUMBER_DIFFERENT_MEANING` (computed from the table and compared); every `EXIT_*`
+constant is in the table; the rows of each program are compared by constant NAME with an own list written here (a
+deleted or added row fails); the code a program really returns is one of its rows (programs are run, not read); the
+codes the shell and PowerShell scripts write as plain numbers are rows of that script; the codes start_all passes on are
+the same in the table, the .sh and the .ps1; every row is either produced by a named test that exists or listed as not
+produced (a row in neither list fails); no page repeats a program's exit numbers (they live in the table, printed into
+docs/settings.md by tools/render_exit_table.py, and a test compares the printed table with the generator). The text-only
+checks are labelled "text pin" in their names: they read a file and prove the text, not the behaviour. The test that
+runs
+each program with a bad setting and compares with the by-program table is in tests/test_bad_setting_entry_points.py.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import socket
+import subprocess
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk import constants as c
+from tools import render_exit_table as render
+
+TABLE = c.EXIT_CODE_TABLE
+PROGRAMS = {program for program, _, _ in TABLE}
+SHELL_SCRIPTS = ("reset.sh", "reset.ps1", "start_all.sh", "start_all.ps1")
+
+
+def _rows(program: str) -> dict[int, str]:
+    return {code: meaning for p, code, meaning in TABLE if p == program}
+
+
+def _overlap(table: tuple[tuple[str, int, str], ...] = TABLE) -> set[int]:
+    meanings: dict[int, set[str]] = defaultdict(set)
+    for _, code, meaning in table:
+        meanings[code].add(meaning)
+    return {code for code, texts in meanings.items() if len(texts) > 1}
+
+
+def test_no_program_has_a_code_with_two_meanings() -> None:
+    seen: dict[tuple[str, int], str] = {}
+    for program, code, meaning in TABLE:
+        assert (program, code) not in seen, (program, code, meaning, seen[(program, code)])
+        seen[(program, code)] = meaning
+    assert all(meaning.strip() for _, _, meaning in TABLE)
+
+
+def test_every_program_of_the_table_exists() -> None:
+    for program in PROGRAMS - {"server"} - set(c.TOOL_PROGRAM_FILES):
+        name = program if "." in program else f"{program}.py"
+        assert (REPO / "scripts" / name).exists(), program
+    for program, relative in c.TOOL_PROGRAM_FILES.items():
+        assert program in PROGRAMS and (REPO / relative).exists(), program
+    assert set(SHELL_SCRIPTS) <= PROGRAMS
+
+
+def test_the_pinned_overlap_list_is_the_computed_overlap() -> None:
+    assert set(c.SAME_NUMBER_DIFFERENT_MEANING) == _overlap()
+    assert list(c.SAME_NUMBER_DIFFERENT_MEANING) == sorted(c.SAME_NUMBER_DIFFERENT_MEANING)
+
+
+def test_a_second_meaning_behind_a_free_number_is_seen_by_the_computation() -> None:
+    """The check itself: it is not vacuous (it finds an overlap that is not pinned)."""
+    extra = (*TABLE, ("feed", c.EXIT_SIMULATED_KILL, "something else entirely"))
+    assert c.EXIT_SIMULATED_KILL in _overlap(extra) - set(c.SAME_NUMBER_DIFFERENT_MEANING)
+
+
+def test_the_setting_refused_code_has_one_meaning_in_every_program_and_a_reuse_is_seen() -> None:
+    """Code 8 is NOT in the pinned overlap list: every program that returns it says the same thing. A table where
+    one program gives 8 another meaning (the failure this test is for) is shown to be caught."""
+    eight = {meaning for _, code, meaning in TABLE if code == c.EXIT_SCRIPT_SETTING_REFUSED}
+    assert (
+        eight == {c.MEANING_SCRIPT_SETTING_REFUSED}
+        and c.EXIT_SCRIPT_SETTING_REFUSED not in c.SAME_NUMBER_DIFFERENT_MEANING
+    )
+    reused = (*TABLE, ("reset.sh", c.EXIT_SCRIPT_SETTING_REFUSED, "something else entirely"))
+    assert c.EXIT_SCRIPT_SETTING_REFUSED in _overlap(reused) - set(c.SAME_NUMBER_DIFFERENT_MEANING)
+    assert {m for p, k, m in TABLE if p.startswith("reset") and k == c.EXIT_RESET_NOT_STOPPED} == {
+        "a process did not stop in time, or the check program crashed (nothing was deleted)"
+    }
+
+
+def test_every_exit_constant_is_in_the_table() -> None:
+    codes = {code for _, code, _ in TABLE}
+    named = {v for k, v in vars(c).items() if k.startswith("EXIT_") and isinstance(v, int) and k != "EXIT_OK"}
+    assert named <= codes, named - codes
+
+
+def test_the_by_program_tables_name_only_programs_and_codes_of_the_table() -> None:
+    for by_program in (c.SETTING_REFUSED_EXIT_BY_PROGRAM, c.LATE_SETTING_REFUSED_EXIT_BY_PROGRAM):
+        for program, code in by_program.items():
+            assert program in PROGRAMS and code in _rows(program), (program, code)
+    assert set(c.SETTING_REFUSED_EXIT_BY_PROGRAM.values()) == {
+        c.EXIT_DESK_SETTING_REFUSED,
+        c.EXIT_SCRIPT_SETTING_REFUSED,
+    }
+    assert c.SETTING_REFUSED_EXIT_BY_PROGRAM["run_real_check"] == c.EXIT_SCRIPT_SETTING_REFUSED
+    assert c.LATE_SETTING_REFUSED_EXIT_BY_PROGRAM["crash_desk"] == c.EXIT_DESK_SETTING_REFUSED
+
+
+def test_the_numbers_each_shell_script_writes_are_rows_of_that_script() -> None:
+    for name in SHELL_SCRIPTS:
+        text = (REPO / "scripts" / name).read_text(encoding="utf-8")
+        code_lines = "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+        used = {int(n) for n in re.findall(r"\bexit ([0-9]+)\b", code_lines)} - {0}
+        assert used <= set(_rows(name)), (name, used - set(_rows(name)))
+        assert c.EXIT_SCRIPT_SETTING_REFUSED not in used, name  # 8 comes only from the reader, passed on
+
+
+def test_the_numbers_reset_check_returns_are_rows_of_reset_check() -> None:
+    text = (REPO / "scripts" / "reset_check.py").read_text(encoding="utf-8")
+    names = set(re.findall(r"return (EXIT_[A-Z_]+)", text))
+    assert names and not re.search(r"return [1-9]", text)  # by name, never a bare number
+    assert {getattr(c, n) for n in names} <= set(_rows("reset_check"))
+
+
+def test_the_two_reset_scripts_have_one_list_of_codes() -> None:
+    assert _rows("reset.sh") == _rows("reset.ps1")
+
+
+def test_no_script_uses_the_script_setting_code_as_a_bare_number() -> None:
+    for path in (REPO / "scripts").iterdir():
+        if path.suffix in {".sh", ".ps1", ".py"}:
+            pattern = rf"\b(?:exit|return|SystemExit\()\s*{c.EXIT_SCRIPT_SETTING_REFUSED}\b"
+            assert not re.search(pattern, path.read_text("utf-8")), path.name
+
+
+def _run(argv: list[str], tmp: Path, **extra: str) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), **extra)
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    return subprocess.run(  # noqa: S603 - fixed argv, made-up values
+        argv, cwd=REPO, env=env, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL, check=False
+    )
+
+
+def test_every_code_a_program_really_returns_is_one_of_its_rows(tmp_path: Path) -> None:
+    """The programs are RUN (each with a refusal it can really make); the code is looked up in that program's rows."""
+    py = sys.executable
+    scripts = REPO / "scripts"
+    runs: list[tuple[str, subprocess.CompletedProcess[str]]] = [
+        ("server", _run([py, "-m", "lead_desk.server"], tmp_path, DESK_PORT="abc")),
+        ("crash_desk", _run([py, str(scripts / "crash_desk.py")], tmp_path, DESK_PORT="abc")),
+        ("feed", _run([py, str(scripts / "feed.py"), "--source", "form", "--all"], tmp_path, DESK_PORT="abc")),
+        ("reset_check", _run([py, str(scripts / "reset_check.py")], tmp_path, DESK_PORT="abc")),
+        ("run_real_check", _run([py, str(scripts / "run_real_check.py")], tmp_path)),  # no --config: its own refusal
+    ]
+    if sys.platform != "win32":
+        bash = ["bash"]
+        runs += [
+            ("reset.sh", _run([*bash, str(scripts / "reset.sh")], tmp_path, DESK_PORT="abc")),
+            ("reset.sh", _run([*bash, str(scripts / "reset.sh")], tmp_path, RESET_STOP_WAIT_SECONDS="x")),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh")], tmp_path, DESK_PORT="abc")),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh"), "sideways"], tmp_path)),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh")], tmp_path, START_ALL_WAIT_SECONDS="0")),
+        ]
+    for program, done in runs:
+        assert done.returncode in _rows(program), (program, done.returncode, (done.stdout + done.stderr)[-300:])
+    assert runs[0][1].returncode == c.EXIT_DESK_SETTING_REFUSED
+    assert runs[4][1].returncode == c.EXIT_CHECK_REFUSED
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="the shell scripts are the non-Windows ones")
+def test_start_all_sh_in_a_shell_that_is_not_bash_returns_its_own_not_bash_code(tmp_path: Path) -> None:
+    sh = shutil.which("sh")
+    probe = [sh, "-c", "[[ a == a ]]"] if sh else None
+    if probe is None or subprocess.run(probe, capture_output=True, check=False).returncode == 0:  # noqa: S603
+        pytest.skip("sh on this machine runs [[ ]] (it is bash): the refusal cannot be reached")
+    done = _run([sh, str(REPO / "scripts" / "start_all.sh")], tmp_path)
+    assert done.returncode == c.EXIT_NOT_BASH
+
+
+def test_contract_md_names_the_table_and_the_overlap_list() -> None:
+    text = (REPO / "contract.md").read_text(encoding="utf-8")
+    assert "EXIT_CODE_TABLE" in text and "SAME_NUMBER_DIFFERENT_MEANING" in text
+    assert "EXIT_SCRIPT_SETTING_REFUSED" in text and "EXIT_DESK_SETTING_REFUSED" in text
+
+
+# --- rows compared by constant NAME, per program (an own list, not read from the table) -------------------------------
+_DESK = {
+    "EXIT_ADAPTERS_UNREACHABLE": "MEANING_ADAPTERS_UNREACHABLE",
+    "EXIT_ANOTHER_DESK": "MEANING_ANOTHER_DESK",
+    "EXIT_OPEN_FILE_LIMIT": "MEANING_OPEN_FILE_LIMIT",
+    "EXIT_DESK_SETTING_REFUSED": "MEANING_DESK_SETTING_REFUSED",
+    "EXIT_PORT_UNAVAILABLE": "MEANING_PORT_UNAVAILABLE",
+}
+_SETTING = {"EXIT_SCRIPT_SETTING_REFUSED": "MEANING_SCRIPT_SETTING_REFUSED"}
+_RESET = {
+    "EXIT_RESET_REFUSED": "MEANING_RESET_REFUSED",
+    "EXIT_RESET_HELD": "MEANING_RESET_HELD",
+    "EXIT_RESET_ANSWERING": "MEANING_RESET_ANSWERING",
+    "EXIT_RESET_NOT_STOPPED": "MEANING_RESET_NOT_STOPPED",
+    "EXIT_RESET_WRONG_PROGRAM": "MEANING_RESET_WRONG_PROGRAM",
+    **_SETTING,
+}
+_START = {
+    "EXIT_START_NOT_DONE": "MEANING_START_NOT_DONE",
+    "EXIT_OPEN_FILE_LIMIT": "MEANING_OPEN_FILE_LIMIT",
+    "EXIT_DESK_SETTING_REFUSED": "MEANING_START_DESK_SETTING_REFUSED",
+    "EXIT_PORT_UNAVAILABLE": "MEANING_PORT_UNAVAILABLE",
+    **_SETTING,
+}
+EXPECTED_ROWS: dict[str, dict[str, str]] = {
+    "server": _DESK,
+    "crash_desk": {**_DESK, **_SETTING, "EXIT_SIMULATED_KILL": "MEANING_SIMULATED_KILL"},
+    "feed": _SETTING,
+    "reset.sh": _RESET,
+    "reset.ps1": _RESET,
+    "reset_check": {
+        "EXIT_RESET_HELD": "MEANING_RESET_HELD",
+        "EXIT_RESET_ANSWERING": "MEANING_RESET_ANSWERING",
+        **_SETTING,
+    },
+    "start_all.sh": {**_START, "EXIT_NOT_BASH": "MEANING_NOT_BASH"},
+    "start_all.ps1": _START,
+    "run_real_check": {
+        "EXIT_CHECK_STOPPED": "MEANING_CHECK_STOPPED",
+        "EXIT_CHECK_REFUSED": "MEANING_CHECK_REFUSED",
+        "EXIT_CHECK_FAILED": "MEANING_CHECK_FAILED",
+        **_SETTING,
+    },
+    "check_schema": {"EXIT_TOOL_FAILED": "MEANING_TOOL_SCHEMA_FAILED"},
+    "hubspot_probe": {
+        "EXIT_TOOL_FAILED": "MEANING_TOOL_PROBE_FAILED",
+        "EXIT_TOOL_REFUSED": "MEANING_TOOL_PROBE_REFUSED",
+    },
+    "run_live_check": {
+        "EXIT_TOOL_FAILED": "MEANING_TOOL_LIVE_STOPPED",
+        "EXIT_TOOL_REFUSED": "MEANING_TOOL_LIVE_REFUSED",
+    },
+    "n8n_api": {"EXIT_TOOL_FAILED": "MEANING_TOOL_N8N_FAILED", "EXIT_TOOL_REFUSED": "MEANING_TOOL_N8N_REFUSED"},
+    "check_invariants": {
+        "EXIT_TOOL_FAILED": "MEANING_TOOL_INVARIANTS_FAILED",
+        "EXIT_TOOL_REFUSED": "MEANING_TOOL_INVARIANTS_REFUSED",
+    },
+    "load_driver": {"EXIT_TOOL_REFUSED": "MEANING_TOOL_LOAD_REFUSED"},
+    "catcher": {"EXIT_TOOL_REFUSED": "MEANING_TOOL_CATCHER_REFUSED"},
+    "burst": {"EXIT_TOOL_FAILED": "MEANING_TOOL_BURST_FAILED"},
+    "fake_model_server": {"EXIT_TOOL_REFUSED": "MEANING_TOOL_FAKE_MODEL_REFUSED"},
+}
+
+
+def _expected_rows() -> set[tuple[str, int, str]]:
+    """EXPECTED_ROWS resolved by constant NAME to (program, code, meaning). A name that does not exist raises here."""
+    return {
+        (program, getattr(c, code_name), getattr(c, meaning_name))
+        for program, names in EXPECTED_ROWS.items()
+        for code_name, meaning_name in names.items()
+    }
+
+
+def test_each_program_has_exactly_the_rows_listed_here_by_constant_name() -> None:
+    assert len(TABLE) == len(set(TABLE))
+    assert set(TABLE) == _expected_rows(), set(TABLE) ^ _expected_rows()
+
+
+def test_a_deleted_or_a_wrong_row_is_seen_by_the_name_comparison() -> None:
+    """The check itself: it is not vacuous. A deleted row, an added row and a swapped meaning each make it fail."""
+    deleted = tuple(r for r in TABLE if not (r[0] == "run_real_check" and r[1] == c.EXIT_CHECK_STOPPED))
+    assert set(deleted) != _expected_rows()
+    added = (*TABLE, ("feed", c.EXIT_CHECK_FAILED, c.MEANING_CHECK_FAILED))
+    assert set(added) != _expected_rows()
+    swapped = tuple(
+        (p, code, c.MEANING_ANOTHER_DESK if (p, code) == ("server", c.EXIT_OPEN_FILE_LIMIT) else m)
+        for p, code, m in TABLE
+    )
+    assert set(swapped) != _expected_rows()
+
+
+def test_every_program_that_reads_the_settings_has_the_script_setting_code_exactly_once() -> None:
+    """The one script code is a row of every program except the desk, and has one meaning wherever it appears."""
+    with_it = {p for p, code, _ in TABLE if code == c.EXIT_SCRIPT_SETTING_REFUSED}
+    assert with_it == PROGRAMS - {"server"} - set(c.TOOL_PROGRAM_FILES)
+    assert {m for _, code, m in TABLE if code == c.EXIT_SCRIPT_SETTING_REFUSED} == {c.MEANING_SCRIPT_SETTING_REFUSED}
+
+
+# --- the three desk codes start_all passes on: the table, the .sh and the .ps1 say the same --------------------------
+def test_text_pin_start_all_passes_on_the_codes_of_the_table_in_both_scripts() -> None:
+    sh = (REPO / "scripts" / "start_all.sh").read_text(encoding="utf-8")
+    ps = (REPO / "scripts" / "start_all.ps1").read_text(encoding="utf-8")
+    sh_codes = re.search(r"case \"\$desk_code\" in ([0-9|]+)\)", sh)
+    ps_codes = re.search(r"\$deskCode -in ([0-9, ]+)\)", ps)
+    assert sh_codes and ps_codes
+    assert tuple(int(n) for n in sh_codes.group(1).split("|")) == c.PASSED_ON_DESK_CODES
+    assert tuple(int(n.strip()) for n in ps_codes.group(1).split(",")) == c.PASSED_ON_DESK_CODES
+    for program in ("start_all.sh", "start_all.ps1"):
+        assert set(c.PASSED_ON_DESK_CODES) <= set(_rows(program)), program
+    assert set(c.PASSED_ON_DESK_CODES) <= set(_rows("server"))
+
+
+# --- every row has a test that produces it, or is listed as not produced ----------------------------------------------
+_BAD_T = "test_bad_setting_entry_points.py::"
+_SELF_T = "test_exit_code_table.py::"
+_HTTP_T = "test_http.py::"
+_SETTINGS_TABLE_TEST = _BAD_T + "test_the_by_program_table_matches_what_every_program_returns"
+_RESET_T = "test_reset_scripts.py::"
+_START_T = "test_start_all_late_refusal.py::"
+_CHECK_T = "test_real_check_dry.py::"
