+def test_every_program_that_ends_with_a_code_has_rows_in_the_table() -> None:
+    """Reverse check: every file of scripts/, load_tools/ and demo_only/ that runs as a program and ends with a number
+    (`sys.exit(`, `raise SystemExit(`, `return EXIT_`) is a program of the table. `http_guard.py` is a module that
+    other programs import: it has no end of its own."""
+    known = {f"scripts/{p}" if "." in p else f"scripts/{p}.py" for p in PROGRAMS} | set(c.TOOL_PROGRAM_FILES.values())
+    known |= {"scripts/http_guard.py"}
+    unlisted: list[str] = []
+    for folder in ("scripts", "load_tools", "demo_only"):
+        for path in sorted((REPO / folder).glob("*.py")):
+            text = path.read_text(encoding="utf-8")
+            if "__main__" in text and re.search(r"sys\.exit\(|raise SystemExit\(", text):
+                relative = f"{folder}/{path.name}"
+                if relative not in known:
+                    unlisted.append(relative)
+    assert not unlisted, unlisted
+
