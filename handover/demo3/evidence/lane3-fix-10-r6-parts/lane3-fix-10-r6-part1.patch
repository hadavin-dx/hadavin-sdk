+_PAGES = (
+    *sorted((REPO / "docs").glob("*.md")),
+    REPO / "README.md",
+    REPO / "contract.md",
+    REPO / "load_tools" / "README.md",
+)
+_PROGRAM_WORDS = (
+    "crash_desk",
+    "reset_check",
+    "run_real_check",
+    "reset.sh",
+    "reset.ps1",
+    "start_all",
