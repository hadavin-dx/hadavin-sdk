+
+# The rows of the table that no test running on this build produces by running the program (the PowerShell rows are
+# produced only by tests that run on Windows, skipped here; the others have no test yet). The printed table marks them.
+# tests/test_exit_code_table.py lists the test that produces every OTHER row, so a new row that is in neither list
+# fails.
+EXIT_ROWS_NOT_PRODUCED_BY_A_TEST: Final[tuple[tuple[str, int], ...]] = (
+    *(("crash_desk", code) for code in (EXIT_ANOTHER_DESK, EXIT_OPEN_FILE_LIMIT)),
+    ("crash_desk", EXIT_PORT_UNAVAILABLE),
+    ("crash_desk", EXIT_SIMULATED_KILL),
+    *(("reset.ps1", code) for code, _ in _RESET_ROWS),
+    ("check_schema", EXIT_TOOL_FAILED),
+    ("hubspot_probe", EXIT_TOOL_FAILED),
+    ("run_live_check", EXIT_TOOL_FAILED),
+    ("run_live_check", EXIT_TOOL_REFUSED),
+    ("n8n_api", EXIT_TOOL_FAILED),
+    ("load_driver", EXIT_TOOL_REFUSED),
+    ("catcher", EXIT_TOOL_REFUSED),
+    ("burst", EXIT_TOOL_FAILED),
+    ("fake_model_server", EXIT_TOOL_REFUSED),
+    *(("start_all.ps1", code) for code in (EXIT_START_NOT_DONE, *PASSED_ON_DESK_CODES, EXIT_SCRIPT_SETTING_REFUSED)),
+)
+
+# The numbers that mean different things in different programs, pinned by name (tests/test_exit_code_table.py computes
+# the overlap from the table and compares). A person reads a number together with the program that returned it.
+SAME_NUMBER_DIFFERENT_MEANING: Final[tuple[int, ...]] = (1, 2, 3, 4, 5)
+
+# The same cause, a refused DESK_* setting, and the number each program returns for it, DERIVED from the table (never
+# typed a second time). A program that reads the settings by itself returns 8 (the reader, lead_desk.config_exit); the
+# desk keeps its own 4 because 2 to 6 already mean other things in the reset scripts. The late table is what a program
+# returns when a setting is refused AFTER its own reading passed: the desk it runs (crash_desk) or starts (start_all)
+# refuses a leadflow file, an approvers file, a sender address or a public bind address, and the desk's own 4 is the
+# answer.
+_DESK_REFUSAL_TEXTS: Final = (MEANING_DESK_SETTING_REFUSED, MEANING_START_DESK_SETTING_REFUSED)
+SETTING_REFUSED_EXIT_BY_PROGRAM: Final[dict[str, int]] = {
+    program: EXIT_SCRIPT_SETTING_REFUSED
+    if any(p == program and code == EXIT_SCRIPT_SETTING_REFUSED for p, code, _ in EXIT_CODE_TABLE)
+    else EXIT_DESK_SETTING_REFUSED
+    for program in dict.fromkeys(p for p, _, _ in EXIT_CODE_TABLE)
+    if program not in TOOL_PROGRAMS  # the small tools do not read the desk settings
+}
+LATE_SETTING_REFUSED_EXIT_BY_PROGRAM: Final[dict[str, int]] = {
+    program: EXIT_DESK_SETTING_REFUSED
+    for program in dict.fromkeys(p for p, _, _ in EXIT_CODE_TABLE)
+    if any(p == program and meaning in _DESK_REFUSAL_TEXTS for p, _, meaning in EXIT_CODE_TABLE) and program != "server"
+}
+# What a message may say about a setting without the value being hidden: advice that is a fixed text of ours (it names
+# the setting and the rule, never a value). config_exit.scrub_values leaves these texts as they are;
