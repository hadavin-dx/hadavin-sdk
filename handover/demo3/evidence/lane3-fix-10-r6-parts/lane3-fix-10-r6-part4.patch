+# entry_points.py checks that none of them holds a value.
+PUBLIC_BIND_ADVICE: Final = "set DESK_BIND to a loopback address (127.0.0.1 or ::1)"
+FIXED_ADVICE_TEXTS: Final[tuple[str, ...]] = (PUBLIC_BIND_ADVICE,)
 
