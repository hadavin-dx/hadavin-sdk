+TOOL_PROGRAMS: Final[tuple[str, ...]] = (
+    "check_schema",
+    "hubspot_probe",
+    "run_live_check",
+    "n8n_api",
+    "check_invariants",
+    "load_driver",
+    "catcher",
+    "burst",
+    "fake_model_server",
