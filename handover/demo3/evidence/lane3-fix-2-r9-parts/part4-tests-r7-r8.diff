+KEY_FILE_WORDS = re.compile(r"key file|password file|KEY_FILE|PASSWORD_FILE|read_secret_file|key or password", re.I)
+RULE_WORDS = ("4096", "printable ASCII", "byte-order", "symbolic link", "named pipe", "other users")
+TEXT_SUFFIXES = (".md", ".txt", ".example")
+SKIPPED_FOLDERS = {".git", ".venv", "node_modules", "__pycache__"}
+
+
+def _repeats_of_the_rule(name: str, text: str) -> list[tuple[str, int, str]]:
+    """The lines of a text file that talk about a key or password file AND name one of the rule's words (a size, the
+    character set, the byte-order mark, a link, a pipe, other users). The one section of docs/settings.md that holds
+    the rule, and its table row, are the only place allowed to. A line about something else that happens to hold one
+    of the words (open files, portal files, the lead fields) does not talk about a key file and is left alone."""
+    lines = text.splitlines()
+    skip: set[int] = set()
+    if name == "docs/settings.md":
+        start = next((i for i, ln in enumerate(lines) if ln.strip() == SECTION), None)
+        if start is not None:
+            end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
+            skip |= set(range(start, end))
+        skip |= {i for i, ln in enumerate(lines) if ln.startswith("| `DESK_LIVE_KEY_FILE`")}
+    found = []
+    for i, ln in enumerate(lines):
+        if i in skip or not KEY_FILE_WORDS.search(ln):
+            continue
+        found += [(name, i + 1, w) for w in RULE_WORDS if w in ln]
+    return found
+
+
+def _text_files() -> list[Path]:
+    return sorted(
+        p
+        for p in REPO.rglob("*")
+        if p.suffix in TEXT_SUFFIXES
+        and p.is_file()
+        and not (set(p.relative_to(REPO).parts) & SKIPPED_FOLDERS)
+        and not p.name.startswith("requirements")
+    )
+
