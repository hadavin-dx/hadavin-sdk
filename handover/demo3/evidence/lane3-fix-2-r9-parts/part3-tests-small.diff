--- a/tests/support.py
+++ b/tests/support.py
@@ -82,6 +82,18 @@ def free_port() -> int:
         return int(s.getsockname()[1])
 
 
+@contextmanager
+def port_nobody_listens_on() -> Iterator[int]:
+    """A loopback port that nothing listens on, for the whole `with` block. The socket stays BOUND but never listens,
+    so a connection to the port is refused (as on a closed port) and no other program can be given the same port in
+    the meantime (a port that was only found free and then closed can be taken by a test that starts later). On a
+    system where a bound port that does not listen is not refused at once (Windows is the one to doubt; not tried here)
+    use `free_port()`."""
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind((HOST, 0))
+        yield int(s.getsockname()[1])
+
