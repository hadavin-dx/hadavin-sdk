+_RANGE_START = 40000  # xdist workers draw their port numbers from 40000 up, one block each (see worker_port_range)
+_RANGE_END = 65535
+_RANGE_WIDTH = 5000  # gw0 40000-44999, gw1 45000-49999, ... (narrower when there are more than five workers)
+
+
+def worker_port_range(worker: str | None, count: str | None) -> tuple[int, int] | None:
+    """The block of port numbers (first, last) that xdist worker `worker` ("gw0", "gw1", ...) draws from, or None when
+    the tests run in one process (then the operating system chooses, as before). The blocks of different workers never
+    overlap, so a number from free_port() in one worker cannot be a number that held_port() holds in another.
+    `count` is PYTEST_XDIST_WORKER_COUNT: with more than five workers the blocks are narrower so all of them fit
+    below 65536; a count smaller than the worker's own number is raised to it."""
+    found = re.fullmatch(r"gw(\d+)", worker or "")
+    if found is None:
+        return None
+    number = int(found.group(1))
+    total = max(int(count) if count and count.isdigit() else 0, number + 1)
+    width = min(_RANGE_WIDTH, (_RANGE_END - _RANGE_START + 1) // total)
+    first = _RANGE_START + number * width
+    return first, first + width - 1
+
