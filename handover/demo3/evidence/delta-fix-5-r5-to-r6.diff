+def test_reset_ps1_reads_at_most_64_characters_of_a_pid_file_and_longer_means_stale() -> None:
+    """Same rule as reset.sh (`read -N 64`, 64 or more characters = stale): a read of at most 64 bytes, then the text
+    is dropped when it filled the buffer. A file that cannot be read stays stale (the try/catch)."""
+    code = _code()
+    assert re.search(r"New-Object byte\[\]\s+64\b", code), "the pid file is not read through a 64 byte buffer"
+    assert re.search(r"\.Read\(\$buffer,\s*0,\s*64\)", code), "the read does not stop at 64 bytes"
+    assert re.search(r"\$count\s+-ge\s+64", code), "a pid file of 64 bytes or more is not treated as stale"
+    assert re.search(r"try\s*\{.*?\}\s*catch\s*\{", code, re.DOTALL), "an unreadable pid file is not caught"
+    assert "64" in _reset_sh_code() and "read -r -N 64" in _reset_sh_code(), "reset.sh no longer has the 64 cap"
+
+
+def test_reset_ps1_removes_only_a_plain_file_and_exits_7_like_reset_sh() -> None:
+    """A pid file that is a folder (an empty one would be removed silently by Remove-Item) or cannot be removed gives
+    exit 7 with the wording of reset.sh. PowerShell itself is not run here (the Windows run is the open item)."""
+    code = _code()
+    assert re.search(r"Test-Path\s+-LiteralPath\s+\$pidFile\s+-PathType\s+Leaf", code), "no leaf-only check"
+    assert code.count("exit 7") >= 2, "both the folder case and the failed removal must exit 7"
+    sh_words = re.search(r'echo "(refused: \$pidfile cannot be removed[^"]*)"', _reset_sh_code())
+    assert sh_words, "reset.sh lost its exit 7 message"
+    ps_words = sh_words.group(1).replace("$pidfile", "$pidFile")
+    assert ps_words in code, "the exit 7 wording of reset.ps1 differs from reset.sh"
+    assert re.search(r"catch\s*\{[^}]*exit 7", code), "the failed removal does not end in exit 7"
+    assert re.search(r"try\s*\{\s*Remove-Item\s+-LiteralPath\s+\$pidFile\s+-ErrorAction\s+Stop\s*\}\s*catch", code), (
+        "a failed removal is not caught and turned into exit 7"
+    )
+    assert not re.search(r"^\s*Remove-Item\s+\$pidFile\s*$", code, re.MULTILINE), "the bare Remove-Item is back"
+
