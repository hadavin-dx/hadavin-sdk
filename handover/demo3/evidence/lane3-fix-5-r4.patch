+    stubs.mkdir()
+    (stubs / "tr").write_text(f"#!/usr/bin/env bash\nprintf '%s' {shlex.quote(line)}\n", encoding="utf-8")
+    (stubs / "tr").chmod(0o755)
+    victim = _sleeper(["bash", "-c", "read -t 60"], stdin=subprocess.PIPE)  # any process: the stand-in `tr` names it
+    pidfile = book.parent / "desk.pid"
+    try:
+        pidfile.write_text(str(victim.pid), encoding="utf-8")
+        done = _run(
