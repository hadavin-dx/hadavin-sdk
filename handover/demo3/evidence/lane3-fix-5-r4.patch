+++ b/scripts/reset.sh
@@ -25,23 +25,48 @@ if ! command -v ps >/dev/null 2>&1 && { [[ -e "$data_dir/desk.pid" ]] || [[ -e "
 fi
 # a process that has ended but is not yet collected by its parent (state Z) is stopped
 alive() { kill -0 "$1" 2>/dev/null && [[ "$(ps -p "$1" -o stat= 2>/dev/null | cut -c1)" != "Z" ]]; }
+# the whole command line of a process, never cut at a terminal width: ps cuts it at $COLUMNS (even into a pipe) and
+# the marker is the last word. Linux: /proc (NUL separators become spaces); else ps -ww (unlimited width), else plain ps
+proc_args() {
+  # only a plain number names a process (an empty pid would read /proc/cmdline, the kernel's own line)
+  # a blank answer (a process with no command line, or only NUL bytes that became spaces) is not an answer: ask ps
+  if [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/cmdline" ]]; then
+    proc_line="$(tr '\0' ' ' 2>/dev/null < "/proc/$1/cmdline")" || proc_line=""
+    if [[ "$proc_line" == *[![:space:]]* ]]; then
+      printf '%s\n' "$proc_line"
+      return 0
+    fi
+  fi
+  ps -ww -p "$1" -o args= 2>/dev/null || ps -p "$1" -o args= 2>/dev/null
+}
 for name in desk fakes; do
   pidfile="$data_dir/$name.pid"
   if [[ -e "$pidfile" ]]; then
     pid="$(cat "$pidfile")"
-    # only stop a process that still is the desk or the demo server (a pid can be reused by another program);
-    # a process that has ended but is not yet collected (state Z) shows no program name, so it counts as gone
-    what="$(ps -p "$pid" -o args= 2>/dev/null || true)"
-    if [[ "$(ps -p "$pid" -o stat= 2>/dev/null | cut -c1)" == "Z" ]]; then what=""; fi
+    pid="${pid#"${pid%%[![:space:]]*}"}"; pid="${pid%"${pid##*[![:space:]]}"}" # trim the spaces and the line end
+    # only one plain process number (no leading zero, not 0) names a process. Anything else ("abc", "123 456", two
+    # lines, "self", "../1", an empty file) is a stale file: nothing is looked up or stopped, the file is deleted.
+    # (a pid file with two numbers is not one this repository writes, and no guess is made about which one is the desk)
+    what=""
+    if [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
+      # only stop a process that still is the desk or the demo server (a pid can be reused by another program);
+      # a process that has ended but is not yet collected (state Z) shows no program name, so it counts as gone
+      what="$(proc_args "$pid" || true)"
+      if [[ "$(ps -p "$pid" -o stat= 2>/dev/null | cut -c1)" == "Z" ]]; then what=""; fi
+    fi
+    # the marker is a word of its own, after the interpreter: `python -m lead_desk.server` (what start_all.sh runs),
+    # so an editor that merely has `lead_desk.server.py` in an argument is another program. proc_args ends a /proc line
+    # with a space, a ps line has none, so each marker has an "at the end" and an "in the middle" form
     case "$what" in
-      *lead_desk.server*|*demo_only.fakes_server*)
+      *python*" -m lead_desk.server"|*python*" -m lead_desk.server "*|\
+      *python*" -m demo_only.fakes_server"|*python*" -m demo_only.fakes_server "*)
         kill "$pid" 2>/dev/null || true
         for _ in $(seq 1 $(( ${RESET_STOP_WAIT_SECONDS:-10} * 10 ))); do alive "$pid" || break; sleep 0.1; done
         if alive "$pid"; then
           echo "refused: process $pid did not stop in time; nothing was deleted" >&2
           exit 5
         fi ;;
-      "") ;; # that process id is gone already
+      "") ;; # that process id is gone already, or the file is not one process number
       *) echo "refused: pid $pid in $pidfile is not the desk or the demo server; nothing was stopped or deleted (delete the pid file yourself if it is stale)" >&2
          exit 6 ;;
     esac
