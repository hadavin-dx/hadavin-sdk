+        )
+        ended = victim.poll() is not None
+    finally:
+        _end(victim)
+    assert ended is stopped, (line, done.returncode, done.stdout, done.stderr)
+    assert done.returncode == (0 if stopped else 6), (line, done.returncode, done.stdout, done.stderr)
