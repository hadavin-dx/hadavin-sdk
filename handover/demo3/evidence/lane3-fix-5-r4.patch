+class ToolMissing(unittest.SkipTest):
+    """A program the test needs is not installed. unittest.SkipTest is the standard-library skip signal: pytest
+    reports a test that raises it as skipped, and this module needs no pytest import."""
+
+
+WINDOWS = sys.platform == "win32"
+RESET_SCRIPT = "reset.ps1" if WINDOWS else "reset.sh"
+
+
+def reset_run(
+    script: str,
+    db: Path,
+    *args: str,
+    first_on_path: Path | None = None,
+    shell: str = "bash",
+    code: str | None = None,
+    **extra: str,
+) -> subprocess.CompletedProcess[str]:
+    """first_on_path: a folder (holding a stand-in `python`) searched before this interpreter's folder; the
+    desk's own DESK_LEADFLOW_FILE and DESK_NUDGE_TO of the calling shell are then left out of the environment.
+    code: shell text run with `shell -c` instead of the script file (not on Windows)."""
+    env = {**os.environ, "DESK_DB_PATH": str(db), **extra}
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    if first_on_path is not None:
+        env["PATH"] = str(first_on_path) + os.pathsep + env["PATH"]
+        for name in ("DESK_LEADFLOW_FILE", "DESK_NUDGE_TO"):
+            if name not in extra:
+                env.pop(name, None)
+    if WINDOWS:
+        powershell = shutil.which("powershell")
+        if powershell is None:
+            raise ToolMissing("Windows PowerShell is not installed")
+        cmd = [powershell, "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(REPO / "scripts" / script)]
+    else:
+        cmd = [shell, "-c", code] if code is not None else [shell, str(REPO / "scripts" / script), *args]
+    return subprocess.run(  # noqa: S603 (our own script and a path made by the test)
+        cmd, cwd=REPO, env=env, capture_output=True, text=True, timeout=120, check=False
+    )
+
+
+def reset_kept(db: Path) -> bool:
+    return db.read_text(encoding="utf-8") == "keep me" and (db.parent / "desk.log").exists()
+
+
 def free_port() -> int:
     with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
         s.bind((HOST, 0))
diff --git a/tests/test_reset_ps_width.py b/tests/test_reset_ps_width.py
new file mode 100644
index 0000000..aff68bc
--- /dev/null
+++ b/tests/test_reset_ps_width.py
@@ -0,0 +1,341 @@
+"""reset.sh tells the desk from another program by its command line, whose marker is the last word. `ps` cuts the
+line at the terminal width when COLUMNS is set (pytest-xdist workers and any terminal set it), so the script must
+read the whole line. Made-up processes only."""
+
+from __future__ import annotations
+
+import os
+import re
+import shlex
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import RESET_SCRIPT as SCRIPT
+from support import WINDOWS, start_proc, stop_proc, wait_until
+from support import free_port as _free_port
+from support import reset_kept as _kept
+from support import reset_run as _run
+
+REPO_SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "reset.sh"
+
+pytestmark = pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+
+NARROW = {"COLUMNS": "80", "LINES": "24"}
+
+
+def _start(ready: Path, code: str, *padding: str) -> subprocess.Popen[bytes]:
+    # `-m lead_desk.server` is the end of the line, after the code and any padding words
+    return start_proc(["-c", code, *padding, "-m", "lead_desk.server", str(ready)], dict(os.environ))
+
+
+def _end(child: subprocess.Popen[bytes]) -> None:
+    child.kill()
+    child.wait()
+    if child.stdin is not None:
+        child.stdin.close()
+    stop_proc(child)  # reads and closes its output pipe
+
+
+def test_a_slow_stop_is_refused_with_exit_5_when_the_terminal_width_is_80(book: Path) -> None:
+    code = (
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
+        "open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    )
+    ready = book.parent / "ready"
+    slow = _start(ready, code)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(
+            SCRIPT,
+            book,
+            RESET_STOP_WAIT_SECONDS="1",
+            DESK_PORT=str(_free_port()),
+            DESK_FAKES_PORT=str(_free_port()),
+            **NARROW,
+        )
+    finally:
+        _end(slow)
+    said = done.stdout + done.stderr
+    assert done.returncode == 5 and "did not stop" in said, (done.stdout, done.stderr)
+    assert _kept(book)
+
+
+def test_a_desk_that_stops_in_a_few_seconds_is_waited_for_when_the_terminal_width_is_80(book: Path) -> None:
+    code = (
+        "import signal, sys, time\n"
+        "def stop(*a):\n"
+        "    time.sleep(3)\n"
+        "    sys.exit(0)\n"
+        "signal.signal(signal.SIGTERM, stop)\n"
+        "open(sys.argv[-1], 'w').close()\n"
+        "time.sleep(60)\n"
+    )
+    ready = book.parent / "ready"
+    slow = _start(ready, code)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    finally:
+        _end(slow)
+    assert done.returncode == 0, (done.stdout, done.stderr)
+    assert not book.exists() and not (book.parent / "desk.pid").exists()
+
+
+def test_a_command_line_over_200_characters_with_the_marker_last_is_still_the_desk(book: Path) -> None:
+    code = (
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
+        "open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    )
+    ready = book.parent / "ready"
+    padding = [f"padding-word-{i:02d}" for i in range(20)]  # about 300 characters before the marker
+    slow = _start(ready, code, *padding)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(
+            SCRIPT,
+            book,
+            RESET_STOP_WAIT_SECONDS="1",
+            DESK_PORT=str(_free_port()),
+            DESK_FAKES_PORT=str(_free_port()),
+            COLUMNS="20",
+            LINES="24",
+        )
+    finally:
+        _end(slow)
+    # the desk was recognised (so it was asked to stop, and refused to): 5, never 6 "not the desk"
+    said = done.stdout + done.stderr
+    assert done.returncode == 5 and "did not stop" in said, (done.stdout, done.stderr)
+    assert _kept(book)
+
+
+# -- the helper `proc_args` itself, cut out of the script text and run in bash with a stand-in `ps` (first on PATH)
+def _proc_args(tmp: Path, pid: str, ps_body: str, tr_body: str | None = None) -> tuple[str, list[str], int]:
+    """Run reset.sh's `proc_args` for `pid`. The stand-in `ps` writes its arguments (one call per line) to a file and
+    then runs ps_body; a stand-in `tr` (tr_body) is added only when given. Returns (output, ps calls, exit code)."""
+    stubs = tmp / "stubs"
+    stubs.mkdir()
+    log = tmp / "ps-calls.txt"
+    ps_text = f'#!/usr/bin/env bash\nprintf \'%s\\n\' "$*" >> "{log}"\n{ps_body}\n'
+    (stubs / "ps").write_text(ps_text, encoding="utf-8")
+    (stubs / "ps").chmod(0o755)
+    if tr_body is not None:
+        (stubs / "tr").write_text(f"#!/usr/bin/env bash\n{tr_body}\n", encoding="utf-8")
+        (stubs / "tr").chmod(0o755)
+    text = REPO_SCRIPT.read_text(encoding="utf-8")
+    start = text.index("proc_args() {")
+    func = text[start : text.index("\n}\n", start) + 3]
+    done = _run(SCRIPT, tmp / "unused.sqlite3", first_on_path=stubs, code=f"{func}\nproc_args {shlex.quote(pid)}")
+    calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
+    return done.stdout, calls, done.returncode
+
+
+def test_proc_args_asks_ps_with_ww_first_when_the_pid_is_not_a_plain_number(tmp_path: Path) -> None:
+    out, calls, rc = _proc_args(tmp_path, "abc", 'echo "line from ww"')
+    assert (out, rc) == ("line from ww\n", 0)
+    assert calls == ["-ww -p abc -o args="], calls  # one call, with -ww; /proc was not used for a non-number
+
+
+def test_proc_args_falls_back_to_plain_ps_when_ps_ww_fails(tmp_path: Path) -> None:
+    body = 'if [[ "$1" == "-ww" ]]; then exit 1; fi; echo "plain ps line"'
+    out, calls, rc = _proc_args(tmp_path, "abc", body)
+    assert (out, rc) == ("plain ps line\n", 0)
+    assert calls == ["-ww -p abc -o args=", "-p abc -o args="], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_reads_proc_first_and_never_calls_ps_for_a_live_process(tmp_path: Path) -> None:
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "ps must not run"')
+    # this process's own command line as the kernel holds it (NUL separators become spaces), one line
+    own = os.fsdecode(Path("/proc/self/cmdline").read_bytes()).replace("\0", " ")
+    assert rc == 0 and out == own + "\n", (out, own)
+    assert calls == [], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_asks_ps_when_proc_gives_an_empty_command_line(tmp_path: Path) -> None:
+    # a stand-in `tr` prints nothing and succeeds, as `tr` does for a process whose command line is empty
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "[kernel-thread]"', tr_body="exit 0")
+    assert (out, rc) == ("[kernel-thread]\n", 0)
+    assert calls == [f"-ww -p {os.getpid()} -o args="], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_asks_ps_when_proc_gives_only_blanks(tmp_path: Path) -> None:
+    # a process whose command line is only NUL bytes: `tr` turns them into spaces, so the answer is blank, not empty
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "[kernel-thread]"', tr_body="printf '   '")
+    assert (out, rc) == ("[kernel-thread]\n", 0)
+    assert calls == [f"-ww -p {os.getpid()} -o args="], calls
+
+
+# -- a pid file with text that is not one process number: treated as before (a stale file, deleted), never run
+@pytest.mark.parametrize(
+    "text",
+    [
+        "abc",
+        "1 ; touch {marker}",
+        "$(touch {marker})",
+        "`touch {marker}`",
+        "",
+        "   ",
+        "99999999999999999999",
+        "self",
+        "../1",
+        "123 456",
+        "123\n456\n",
+        "0",
+        "007",
+    ],
+)
+def test_a_pid_file_with_text_that_is_not_a_number_runs_nothing(book: Path, text: str) -> None:
+    marker = book.parent / "injected"
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(text.format(marker=marker), encoding="utf-8")
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    assert not marker.exists(), "text from the pid file was run as a command"
+    # ps cannot find such a process, so the file counts as stale: removed, the reset goes on (as the old script did)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+# -- a pid file with two process numbers is stale too: nothing is stopped, not even a real desk named by one of them
+def _sleeper(args: list[str], *, stdin: int | None = None) -> subprocess.Popen[bytes]:
+    return subprocess.Popen(  # noqa: S603 (our own interpreter or bash, made-up arguments)
+        args, cwd=Path(__file__).resolve().parents[1], stdin=stdin, stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT
+    )
+
+
+def _ready_sleeper(ready: Path, *marker: str) -> subprocess.Popen[bytes]:
+    """A python child that creates `ready` and sleeps; `marker` words come before the ready path (the last word)."""
+    code = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    child = _sleeper([sys.executable, "-c", code, *marker, str(ready)])
+    wait_until(ready.exists, what="the child is running")
+    return child
+
+
+@pytest.mark.parametrize("shape", ["{pid} 999999", "999999 {pid}", "{pid}\n999999\n", "{pid}\n{pid}\n", "{pid} {pid}"])
+def test_a_pid_file_with_two_numbers_is_stale_and_stops_nothing_even_a_real_desk(book: Path, shape: str) -> None:
+    ready = book.parent / "ready"
+    desk = _ready_sleeper(ready, "-m", "lead_desk.server")
+    pidfile = book.parent / "desk.pid"
+    try:
+        pidfile.write_text(shape.format(pid=desk.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert still_running, "a process was stopped although the pid file did not name one process"
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+# -- the marker is a word of its own after the interpreter; a program that only CONTAINS the marker text is left alone
+_EDITOR = ["bash", "-c", "read -t 60", "vim"]  # no python in the line: an editor with a file open
+
+
+@pytest.mark.parametrize(
+    ("pid_file", "launcher", "words"),
+    [
+        ("desk.pid", "editor", ["lead_desk.server.py"]),
+        ("desk.pid", "editor", ["lead_desk.server"]),
+        ("desk.pid", "editor", ["-m", "lead_desk.server"]),  # no python in the line
+        ("fakes.pid", "editor", ["demo_only.fakes_server.py"]),
+        ("desk.pid", "python", ["vim", "lead_desk.server.py"]),
+        ("desk.pid", "python", ["-m", "lead_desk.server.py"]),
+        ("desk.pid", "python", ["-m", "lead_desk.serverx"]),
+        ("desk.pid", "python", ["-m", "xlead_desk.server"]),
+        ("desk.pid", "python", ["--x=lead_desk.server"]),
+        ("desk.pid", "python", ["lead_desk.server"]),  # the old bare-word shape
+        ("fakes.pid", "python", ["demo_only.fakes_server"]),
+        ("fakes.pid", "python", ["-m", "lead_desk.server.py", "demo_only.fakes_server.py"]),
+    ],
+)
+def test_a_program_that_only_contains_the_marker_text_is_not_stopped(
+    book: Path, pid_file: str, launcher: str, words: list[str]
+) -> None:
+    ready = book.parent / "ready"
+    if launcher == "editor":
+        child = _sleeper([*_EDITOR, *words], stdin=subprocess.PIPE)
+    else:
+        child = _ready_sleeper(ready, *words)
+    pidfile = book.parent / pid_file
+    try:
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = child.poll() is None
+    finally:
+        _end(child)
+    assert still_running, "a program that is not the desk was stopped"
+    assert done.returncode == 6 and "not the desk" in done.stdout + done.stderr, (done.stdout, done.stderr)
+    assert _kept(book) and pidfile.exists()
+
+
+@pytest.mark.parametrize(
+    ("pid_file", "words"),
+    [
+        ("desk.pid", ["-m", "lead_desk.server"]),
+        ("fakes.pid", ["-m", "demo_only.fakes_server", "--outbox", "keyed", "--port", "1"]),  # as start_all.sh runs it
+    ],
+)
+def test_the_real_desk_and_demo_server_command_lines_are_still_stopped(
+    book: Path, pid_file: str, words: list[str]
+) -> None:
+    ready = book.parent / "ready"
+    child = _ready_sleeper(ready, *words)
+    pidfile = book.parent / pid_file
+    try:
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = child.poll() is None
+    finally:
+        _end(child)
+    assert not still_running and done.returncode == 0, (done.returncode, done.stdout, done.stderr)
+    assert not pidfile.exists() and not book.exists()
+
+
+# -- the same decision on the other command-line form: `ps` gives no trailing space, /proc gives one (stand-in `tr`)
+@pytest.mark.parametrize(
+    ("line", "stopped"),
+    [
+        ("python -m lead_desk.server", True),
+        ("python -m lead_desk.server ", True),
+        ("/opt/my tools/venv/bin/python3.12 -m lead_desk.server ", True),
+        ("python -m demo_only.fakes_server", True),
+        ("python -m demo_only.fakes_server --outbox keyed --port 5 ", True),
