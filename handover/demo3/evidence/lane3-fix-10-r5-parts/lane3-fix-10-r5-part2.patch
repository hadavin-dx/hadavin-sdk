+def env_path(env: Mapping[str, str], name: str, default: Any = _MISSING) -> Path:
+    """A path read from setting text: THE one way (every `Path(env[...])` in src/ and scripts/ goes through here; a test
+    walks the syntax tree and fails on a bare one). Text that cannot be written as UTF-8 (a lone surrogate: what the
+    operating system's own decoding makes of a byte that is not UTF-8), that holds a control character (NUL, a line
+    end, a tab) or that is empty or only white space is a plain SettingRefused naming the setting. A log line, a
+    stored row or a printed path could not hold it. `default` is returned as it is when the name is absent (a Path, or
+    None)."""
+    if name not in env:
