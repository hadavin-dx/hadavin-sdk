+"""Print the exit-code table (`lead_desk.constants.EXIT_CODE_TABLE`) as a Markdown table.
+
+`python tools/render_exit_table.py --write` puts the table between the two marker lines in docs/settings.md; without
+`--write` it prints the table. tests/test_exit_code_table.py fails when the printed table differs from this output, so
+the table in the document is never typed by hand and cannot drift from the constants.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+if str(ROOT / "src") not in sys.path:
+    sys.path.insert(0, str(ROOT / "src"))
+
+from lead_desk import constants as c  # noqa: E402
+
+START = "<!-- exit-table:start (written by tools/render_exit_table.py; do not edit by hand) -->"
+END = "<!-- exit-table:end -->"
+TARGET = ROOT / "docs" / "settings.md"
+NOT_PRODUCED = "not produced by a test on this build"
+
+
+def render() -> str:
+    """The table as Markdown text: one row per (program, code), in the order of the constant."""
+    skipped = set(c.EXIT_ROWS_NOT_PRODUCED_BY_A_TEST)
+    lines = ["| Program | Code | Meaning | Run by a test here |", "|---|---|---|---|"]
+    for program, code, meaning in c.EXIT_CODE_TABLE:
+        note = NOT_PRODUCED if (program, code) in skipped else "yes"
+        lines.append(f"| `{program}` | {code} | {meaning} | {note} |")
+    return "\n".join(lines)
+
+
+def block() -> str:
+    return f"{START}\n{render()}\n{END}"
+
+
+def current_block(text: str) -> str | None:
+    """The marked block as it stands in `text` (markers included), or None when a marker is missing."""
+    start, end = text.find(START), text.find(END)
+    if start < 0 or end < start:
+        return None
+    return text[start : end + len(END)]
+
+
+def main(argv: list[str]) -> int:
+    if "--write" not in argv:
+        print(render())
+        return 0
+    text = TARGET.read_text(encoding="utf-8")
+    old = current_block(text)
+    if old is None:
+        print("the marker lines are missing in docs/settings.md", file=sys.stderr)
+        return 1
+    TARGET.write_text(text.replace(old, block()), encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
