+# -- the value is never echoed (row: scrub) --------------------------------------------------------------------------
+@pytest.mark.parametrize("value", ["secretvalue", "a b\tc@d.test", "café-\u202e", "line1\nline2xyz", "q'uote\"s\\x"])
+def test_refusal_line_never_holds_a_setting_value_in_any_form(value: str) -> None:
+    from lead_desk.config_exit import refusal_line
+
+    env = {"DESK_NUDGE_TO": value, "OTHER": "unrelated-value"}
+    escaped = value.encode("unicode_escape").decode()
+    for reason in (f"bad {value}", f"bad {value!r}", f"bad {ascii(value)}", f"bad {escaped}"):
+        line = refusal_line("the desk refuses a setting:", reason, env)
+        assert "<value>" in line, (reason, line)
+        assert value not in line and repr(value)[1:-1] not in line and ascii(value)[1:-1] not in line, (reason, line)
+        assert "\n" not in line and line.startswith("the desk refuses a setting: ")
+
+
+def test_refusal_line_keeps_short_values_setting_names_and_other_variables() -> None:
+    from lead_desk.config_exit import refusal_line
+
+    env = {"DESK_PORT": "80", "DESK_QUALIFIER": "DESK", "NOT_A_SETTING": "visible-text"}
+    line = refusal_line("the desk refuses a setting:", "DESK_PORT 80 is bad; DESK_QUALIFIER visible-text", env)
+    assert "80" in line  # a value of two characters is also ordinary text
+    assert "DESK_PORT" in line and "DESK_QUALIFIER" in line  # a setting name is never blanked
+    assert "visible-text" in line  # only DESK_* values are scrubbed
+
+
