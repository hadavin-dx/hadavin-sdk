+def test_the_prose_check_finds_a_program_with_a_number() -> None:
+    """The check itself: it is not vacuous."""
+    assert _prose_numbers("`run_real_check` gives 2 for its own refusals")
+    assert _prose_numbers("start_all.sh ends with code 4")
+    assert _prose_numbers("reset.sh: exit 5 when it is slow")
+    assert _prose_numbers("the desk exits with exit code 4 on a refused setting")  # the `server` rows are covered too
+    assert _prose_numbers("a bad value ends `start_all` with its own `1`")  # the settings.md shape
+    assert _prose_numbers("the desk ends with exit code 4.")
+    assert not _prose_numbers("`run_real_check` gives the code of the table")
+    assert not _prose_numbers("the desk exits with the refusal row of the table")
+
+
+def test_the_number_check_finds_a_number_that_is_in_no_row() -> None:
