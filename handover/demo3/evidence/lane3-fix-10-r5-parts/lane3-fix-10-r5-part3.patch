+    "EXIT_DESK_SETTING_REFUSED": "MEANING_DESK_SETTING_REFUSED",
+    "EXIT_PORT_UNAVAILABLE": "MEANING_PORT_UNAVAILABLE",
+}
+_SETTING = {"EXIT_SCRIPT_SETTING_REFUSED": "MEANING_SCRIPT_SETTING_REFUSED"}
+_RESET = {
+    "EXIT_RESET_REFUSED": "MEANING_RESET_REFUSED",
+    "EXIT_RESET_HELD": "MEANING_RESET_HELD",
+    "EXIT_RESET_ANSWERING": "MEANING_RESET_ANSWERING",
+    "EXIT_RESET_NOT_STOPPED": "MEANING_RESET_NOT_STOPPED",
+    "EXIT_RESET_WRONG_PROGRAM": "MEANING_RESET_WRONG_PROGRAM",
+    **_SETTING,
+}
+_START = {
+    "EXIT_START_NOT_DONE": "MEANING_START_NOT_DONE",
+    "EXIT_OPEN_FILE_LIMIT": "MEANING_OPEN_FILE_LIMIT",
+    "EXIT_DESK_SETTING_REFUSED": "MEANING_START_DESK_SETTING_REFUSED",
+    "EXIT_PORT_UNAVAILABLE": "MEANING_PORT_UNAVAILABLE",
+    **_SETTING,
+}
+EXPECTED_ROWS: dict[str, dict[str, str]] = {
+    "server": _DESK,
+    "crash_desk": {**_DESK, **_SETTING, "EXIT_SIMULATED_KILL": "MEANING_SIMULATED_KILL"},
+    "feed": _SETTING,
+    "reset.sh": _RESET,
