+"""A bad DESK_* value must end every start-up script cleanly, never with a Python traceback.
+
+Bug class: a bad setting value (a person's typing mistake) reaches the person as a raw Python error, because the
+script read the settings by itself, outside the one place that turns a refused setting into a plain message.
+The rule for every entry point that reads the DESK_* settings: ONE line that names the setting, no traceback, and the
+value is never repeated (it may be an e-mail address). The code is the desk's own 4 for `python -m lead_desk.server`
+(and the launcher that calls it) and the script reader's 8 (`EXIT_SCRIPT_SETTING_REFUSED`) for every script; the table
+is `constants.EXIT_CODE_TABLE`. Made-up values only; loopback only; no network is reached because every run stops at the
+check.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk.config import Config
+from lead_desk.config_exit import config_or_exit
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED, EXIT_SCRIPT_SETTING_REFUSED
+from lead_desk.envnum import SettingRefused
+
+SCRIPTS = REPO / "scripts"
+WINDOWS = sys.platform == "win32"
+FLOW = "demo_only/leadflow.json"  # reminders on, so DESK_NUDGE_TO is read as an address
+
+PY_ENTRY_POINTS: list[tuple[str, list[str]]] = [
+    ("crash_desk", [str(SCRIPTS / "crash_desk.py")]),
+    ("feed", [str(SCRIPTS / "feed.py"), "--source", "form", "--all"]),
+    ("reset_check", [str(SCRIPTS / "reset_check.py")]),
+    ("server", ["-m", "lead_desk.server"]),
+    ("crash_launcher", [str(REPO / "tests" / "crash_launcher.py"), "unused.flag"]),
+]
+DESK_OWN = {"server", "crash_launcher"}  # the desk's own refusal (exit 4); every script exits 8
+SH_ENTRY_POINTS = ["start_all.sh", "reset.sh"]
+
+# (setting name, value that no desk may accept). A NUL character cannot be put in an environment by the operating
+# system; it is tried in-process below.
+BAD_VALUES: list[tuple[str, str]] = [
+    # only values the base tree already refuses: the address rule itself (a second @, a length cap, a control
+    # character) is the one shared rule of identity.py and is tested where that rule lives, not copied here
+    ("DESK_NUDGE_TO", " "),  # whitespace only
+    ("DESK_NUDGE_TO", "café@b.test"),  # not ASCII
+    ("DESK_NUDGE_TO", "no-at-sign"),
+    ("DESK_PORT", ""),  # empty
+    ("DESK_PORT", "   "),
+    ("DESK_PORT", "9" * 5000),
+    ("DESK_PORT", "8\x077"),
+    ("DESK_PORT", "٣٤"),  # digits of another script
+    ("DESK_PORT", "abc@b@c.test"),  # address-like text in a number setting
+    ("DESK_FAKES_URL", "ftp://a@b@c.test:1"),
+    ("DESK_SEND_TIMEOUT_SECONDS", "nan"),
+]
+
+
+def _run(
+    argv: list[str], tmp: Path, setting: str, value: str, *, with_bash: bool = False
+) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_LEADFLOW_FILE=FLOW)
+    env.pop("DESK_NUDGE_TO", None)
+    env[setting] = value
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    cmd = ["bash", str(SCRIPTS / argv[0])] if with_bash else [sys.executable, *argv]
+    return subprocess.run(  # noqa: S603 - fixed argv built above, made-up values
+        cmd,
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+    )
+
+
+def _assert_clean_refusal(
+    done: subprocess.CompletedProcess[str], setting: str, value: str, tmp: Path, code: int = EXIT_SCRIPT_SETTING_REFUSED
+) -> None:
+    out = done.stdout + done.stderr
+    lines = [ln for ln in out.splitlines() if ln.strip()]
+    assert done.returncode == code, (done.returncode, out[-400:])
+    assert "Traceback" not in out and 'File "' not in out, out[-400:]
+    assert len(lines) == 1, lines[-5:]  # ONE line
+    assert setting in lines[0], lines[0]  # names the setting
+    assert len(lines[0]) < 300, len(lines[0])
+    probe = value.strip()
+    for piece in (probe[:12], probe[-12:]):  # the value (or a part of it) is never echoed
+        if len(piece) >= 3:
+            assert piece not in out
+    assert "@" not in out  # nothing that looks like an address
+    assert not (tmp / "data").exists()  # a refused start created nothing
+
+
+@pytest.mark.parametrize(("setting", "value"), BAD_VALUES, ids=lambda v: repr(v)[:24])
+@pytest.mark.parametrize(("name", "argv"), PY_ENTRY_POINTS, ids=[n for n, _ in PY_ENTRY_POINTS])
+def test_bad_setting_is_a_clean_refusal_in_every_python_entry_point(
+    name: str, argv: list[str], setting: str, value: str, tmp_path: Path
+) -> None:
+    code = EXIT_DESK_SETTING_REFUSED if name in DESK_OWN else EXIT_SCRIPT_SETTING_REFUSED
+    _assert_clean_refusal(_run(argv, tmp_path, setting, value), setting, value, tmp_path, code)
+
+
+@pytest.mark.skipif(WINDOWS, reason="the shell scripts are the non-Windows ones")
+@pytest.mark.parametrize(("setting", "value"), BAD_VALUES, ids=lambda v: repr(v)[:24])
+@pytest.mark.parametrize("script", SH_ENTRY_POINTS)
+def test_bad_setting_is_a_clean_refusal_in_every_shell_script(
+    script: str, setting: str, value: str, tmp_path: Path
+) -> None:
+    _assert_clean_refusal(_run([script], tmp_path, setting, value, with_bash=True), setting, value, tmp_path)
+
+
+HOSTILE: dict[str, str] = {
+    "empty": "",
+    "whitespace": "  \t ",
+    "long": "x" * 100_000,
+    "nul": "a\0b",
+    "control": "a\x07b\nc",
+    "non_ascii": "café\u202e",
+    "lone_surrogate": "a\udc80b",
+    "two_at": "a@b@c.test",
+}
+SETTING_NAMES = (
+    "DB_PATH BIND PORT ADAPTERS FAKES_HOST FAKES_PORT FAKES_URL REPLIES_PATH SEND_TIMEOUT_SECONDS SIZE_CAP_BYTES "
+    "STALL_SECONDS ALLOWED_HOSTS QUALIFIER OUTBOX CRM LATER_MODE APPROVERS_FILE LEADFLOW_FILE NUDGE_TO"
+).split()
+
+
+@pytest.mark.parametrize("kind", sorted(HOSTILE))
+@pytest.mark.parametrize("name", SETTING_NAMES)
+def test_config_or_exit_never_lets_another_error_out(name: str, kind: str, capsys: Any) -> None:
+    """Class check at the shared reader: any DESK_* name with any hostile value gives a Config or a plain refusal."""
+    env = {"DESK_LEADFLOW_FILE": FLOW, f"DESK_{name}": HOSTILE[kind]}
+    try:
+        accepted = config_or_exit(env)
+    except SystemExit as stop:
+        assert stop.code == EXIT_SCRIPT_SETTING_REFUSED
+        out = capsys.readouterr()
+        lines = [ln for ln in (out.out + out.err).splitlines() if ln.strip()]
+        assert len(lines) == 1 and f"DESK_{name}" in lines[0] and "Traceback" not in lines[0]
+        assert "@" not in lines[0] and len(lines[0]) < 300
+    else:  # a value the desk accepts must be a real Config: the same one the bare reader gives, and nothing printed
+        assert accepted == Config.from_env(env)
+        assert capsys.readouterr() == ("", "")
+
+
+def test_config_or_exit_returns_the_same_config_for_good_settings() -> None:
+    env = {"DESK_PORT": "8123", "DESK_LEADFLOW_FILE": FLOW}
+    assert config_or_exit(env) == Config.from_env(env)
+
+
+def test_the_refusal_is_cut_to_one_short_line_even_for_a_long_or_multi_line_message(
+    monkeypatch: pytest.MonkeyPatch, capsys: Any
+) -> None:
+    """The shared reader keeps the one-line rule itself, whatever a refusal message holds."""
+
+    def refuse(cls: Any, env: Any = None) -> Any:
+        raise SettingRefused("DESK_PORT is bad\nsecond line\r\n" + "y" * 5000)
+
+    monkeypatch.setattr(Config, "from_env", classmethod(refuse))
+    with pytest.raises(SystemExit) as stop:
+        config_or_exit({})
+    assert stop.value.code == EXIT_SCRIPT_SETTING_REFUSED
+    out = capsys.readouterr()
+    assert out.out == ""  # the error stream, not the output a shell would capture
+    assert len(out.err.splitlines()) == 1 and len(out.err) < 300 and "DESK_PORT" in out.err
+
+
+# -- one wording on both streams (the desk prints on stdout, a script reader on stderr) ------------------------------
+SAME_WORDS: list[tuple[str, str]] = [
+    ("DESK_PORT", "abc"),
+    ("DESK_PORT", "99999"),
+    ("DESK_FAKES_URL", "ftp://x.test:1"),
+    ("DESK_SEND_TIMEOUT_SECONDS", "nan"),
+    ("DESK_NUDGE_TO", "no-at-sign"),
+    ("DESK_QUALIFIER", "something-else"),
+]
+
+
+@pytest.mark.parametrize(("setting", "value"), SAME_WORDS, ids=lambda v: repr(v)[:24])
+def test_the_desk_and_the_script_reader_say_the_same_words(setting: str, value: str, tmp_path: Path) -> None:
+    """One formatter (`config_exit.refusal_line`): the same bad value gives the same line whichever program reads it."""
+    desk = _run(["-m", "lead_desk.server"], tmp_path, setting, value)
+    helper_code = "from lead_desk.config_exit import config_or_exit; config_or_exit()"
+    helper = _run(["-c", helper_code], tmp_path, setting, value)
+    assert desk.returncode == EXIT_DESK_SETTING_REFUSED and helper.returncode == EXIT_SCRIPT_SETTING_REFUSED
+    assert desk.stderr == "" and helper.stdout == ""  # the two streams, by reason (see config_exit.py)
+    assert desk.stdout.strip() == helper.stderr.strip() != ""
+
+
+def test_every_refusal_site_of_the_desk_goes_through_the_one_formatter() -> None:
+    """No `print(f"the desk refuses ...` is built by hand in server.py: `_refuse` is the only place that prints one."""
+    text = (REPO / "src" / "lead_desk" / "server.py").read_text(encoding="utf-8")
+    assert 'print(f"the desk refuses' not in text
+    assert text.count("print(refusal_line(") == 1
+    assert text.count("_refuse(") >= 8  # the eight sites plus the definition
+
