diff --git a/tests/test_docs_tests_md_lane3.py b/tests/test_docs_tests_md_lane3.py
new file mode 100644
index 0000000..e1e84cb
--- /dev/null
+++ b/tests/test_docs_tests_md_lane3.py
@@ -0,0 +1,70 @@
+"""Pin facts that docs/tests.md, docs/real-services.md and the README state, so the text cannot drift from the scripts.
+
+Each test reads text files only; nothing slow is run. A cold reader found each of these statements wrong on f3c39cf8.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8")
+
+
+def test_crash_command_sets_the_path_with_the_repository_folder() -> None:
+    text = _read("docs/tests.md")
+    assert re.search(r"PYTHONPATH=src:\. python scripts/crash_desk\.py", text)
+    assert not re.search(r"PYTHONPATH=src python scripts/crash_desk\.py", text)
+    assert not re.search(r"PYTHONPATH=src python -m lead_desk\.server", text)
+    assert not re.search(r"PYTHONPATH=src python -m lead_desk\.server", _read("README.md"))
+
+
+def test_desk_by_hand_says_the_demo_servers_come_first() -> None:
+    text = _read("docs/tests.md")
+    assert re.search(r"demo servers[^.]*running first", text)
+    assert re.search(r"cannot reach the demo servers", text)
+    assert re.search(r"demo_only\.fakes_server --outbox keyed", text)
+    assert re.search(r"demo servers first", _read("README.md"))
+
+
+def test_documented_assume_yes_flag_exists_in_the_script() -> None:
+    script = _read("scripts/run_real_check.py")
+    assert re.search(r'add_argument\(\s*"--assume-yes"', script)
+    doc = _read("docs/real-services.md")
+    assert re.search(r"--dry-fakes --assume-yes", doc)
+    assert re.search(r"Start\? \[y/N\]", doc)
+    assert re.search(r"exit code 1", doc)
+
+
+def test_documented_soak_flag_exists_in_the_checker() -> None:
+    checker = _read("load_tools/check_invariants.py")
+    assert re.search(r'add_argument\(\s*"--max-unknown"', checker)
+    text = _read("docs/tests.md")
+    assert re.search(r"--max-unknown", text)
+    assert re.search(r"crash_while_sending", text)
+    assert re.search(r"0 or 1 mails \(never 2 for one lead\)", text)
+    assert re.search(r"listed in the review list", text)
+
+
+def test_documented_counts_are_the_measured_ones_not_the_stale_ones() -> None:
+    text = _read("docs/tests.md")
+    assert re.search(r"3683 passed and 200 skipped", text)
+    assert re.search(r"166 \+ 30 \+ 4 = 200", text)
+    for reason in ("gitleaks", "root", "Python 3.13", "Windows", "LEAD_DESK_LOAD_N"):
+        assert reason in text
+    for line in text.splitlines():
+        if re.search(r"2513 passed|2349 passed", line):
+            assert re.search(r"NOT the current count", line)
+    assert not re.search(r"the 3 skipped are gitleaks", text, re.IGNORECASE)
+
+
+def test_dry_run_people_count_is_the_real_one() -> None:
+    doc = _read("docs/real-services.md")
+    assert re.search(r"8 people plus a twin, 9 leads", doc)
+    assert re.search(r"REAL_PERSONS", doc)
+    script = _read("scripts/run_real_check.py")
+    assert re.search(r'"REAL_PERSONS": "8"', script)
