+def _paragraphs(lines: list[str]) -> list[tuple[int, str]]:
+    """(first line number from 0, text) of each paragraph: a run of lines up to a blank line, a heading, a table row
+    or a list item, so a sentence wrapped over several lines is read as one."""
+    out: list[tuple[int, list[str]]] = []
+    current: list[str] | None = None
+    for i, ln in enumerate(lines):
+        starts_new = not ln.strip() or ln.startswith(("#", "|", "* ", "- ")) or re.match(r"\d+\. ", ln) is not None
+        if not ln.strip():
+            current = None
+            continue
+        if current is None or starts_new:
+            current = [ln]
+            out.append((i, current))
+        else:
+            current.append(ln)
+    return [(i, " ".join(parts)) for i, parts in out]
+
+
+def _repeats_of_the_rule(name: str, text: str) -> list[tuple[str, int, str]]:
+    """The paragraphs of a text file that talk about a key or password file AND name one of the rule's words (a size,
+    the character set, the byte-order mark, a link, a pipe, other users), whatever the case, a hyphen or a line break.
+    The one section of docs/settings.md that holds the rule, and its table row, are the only place allowed to. A
+    paragraph about something else that happens to hold one of the words (open files, portal files, the lead
+    fields) does not talk about a key file and is left alone."""
+    lines = text.splitlines()
+    skip: set[int] = set()
+    if name == "docs/settings.md":
+        start = next((i for i, ln in enumerate(lines) if ln.strip() == SECTION), None)
+        if start is not None:
+            end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
+            skip |= set(range(start, end))
+        skip |= {i for i, ln in enumerate(lines) if ln.startswith("| `DESK_LIVE_KEY_FILE`")}
+    found = []
+    for first, para in _paragraphs(lines):
+        if first in skip or not KEY_FILE_WORDS.search(para):
+            continue
+        found += [(name, first + 1, m.group(0).lower()) for m in RULE_WORDS.finditer(para)]
+    return found
