+def test_a_link_is_refused_where_the_system_has_no_no_follow_flag(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Windows has no O_NOFOLLOW (getattr gives 0 there): the open follows the link, the second look (lstat) refuses."""
