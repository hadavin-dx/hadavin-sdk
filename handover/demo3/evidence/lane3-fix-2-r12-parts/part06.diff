+def test_the_whole_key_file_rule_is_in_one_section_of_the_settings_page() -> None:
+    text = (REPO / "docs" / "settings.md").read_text(encoding="utf-8")
+    assert text.count(SECTION) == 1
+    section = " ".join(text.split(SECTION)[1].split("\n## ")[0].split())
+    for part in (
+        RULE,
+        "a symbolic link",
+        "chmod 600",
+        "other users",
+        "byte-order mark",
+        "4096 bytes, counting the line break",
+        "kept as text",
+        "a named pipe",
+        "a device",
+        "is read at start and again before every call",
+        "kept in memory",
+        "who owns the file is not checked",
+        "empty or too short",
+        "a character that is not printable ASCII",
+        "a space inside a key",
+    ):
+        assert part in section, part
+
