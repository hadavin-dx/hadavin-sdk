+@pytest.mark.skipif(not hasattr(os, "O_NOFOLLOW"), reason="this system has no O_NOFOLLOW flag")
+def test_the_file_is_opened_without_following_a_link(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """REGRESSION GUARD (passes on the round 7 code too). The second look (lstat) also refuses a link, so only the flags
+    of the open call show that the flag is kept."""
+    f = tmp_path / "k.txt"
+    f.write_text(KEY, encoding="utf-8")
+    seen: list[int] = []
+    real_open = os.open
+
+    def spy(path: Any, flags: int, *a: Any, **k: Any) -> int:
+        seen.append(flags)
+        return real_open(path, flags, *a, **k)
+
+    monkeypatch.setattr(os, "open", spy)
