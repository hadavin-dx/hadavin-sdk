+def test_the_held_port_refuses_a_connection_and_is_not_given_out_twice() -> None:
+    import sys
+
+    sys.path.insert(0, str(REPO / "tests"))
+    try:
+        from support import free_port, port_nobody_listens_on
+    finally:
+        sys.path.remove(str(REPO / "tests"))
+    with port_nobody_listens_on() as port:
+        with pytest.raises(ConnectionRefusedError):
+            socket.create_connection(("127.0.0.1", port), timeout=2).close()
+        with pytest.raises(OSError):  # nobody else can bind it while it is held
+            with socket.socket() as other:
+                other.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 0)
+                other.bind(("127.0.0.1", port))
+        assert free_port() != port
