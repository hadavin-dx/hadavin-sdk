+    system's own `Path.stat` raises PermissionError for the book path itself, so the real `path_kind` answers
+    `unreadable` at once (the first look of `env_file_problem`; its parent walk is not reached). The parent walk has its
+    own test (`test_a_part_above_the_path_that_cannot_be_looked_at_is_refused`)."""
+    mod = _real_check(monkeypatch)
+    book = tmp_path / "x" / "desk.db"
+    cfg = _config_with_book(mod, tmp_path, book)
+    real_stat = Path.stat
+
+    def stat(self: Path, *args: Any, **kwargs: Any) -> os.stat_result:
+        if self == book:
+            raise PermissionError(13, "no permission")
+        return real_stat(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", stat)
+    monkeypatch.setattr("builtins.input", lambda prompt="": pytest.fail("the question must not be reached"))
+    code = mod.main(["--config", str(cfg)])
+    out = capsys.readouterr().out
+    assert code == mod.EXIT_REFUSED, (code, out)
+    assert out.strip().splitlines() == [BOOK_UNREADABLE], out
+    assert "Traceback" not in out and str(tmp_path) not in out
+
