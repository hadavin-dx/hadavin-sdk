+def test_a_number_with_too_many_digits_is_clamped_not_dropped(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A text that the rule accepts but that is too big for a float is a long wait, not no wait: 308 digits is the
+    largest finite number; every longer text used to give None (a jump in the answers)."""
+    top = constants.RETRY_AFTER_MAX_SECONDS
+    for name, fn in _copies(monkeypatch).items():
+        for digits in (305, 308, 309, 310, 400, 5000):
+            assert fn("9" * digits) == top, (name, digits)
+            assert fn("1" + "0" * digits) == top, (name, digits)
+        assert fn("9" * 400 + ".5") == top, name
+        assert fn("1e999") is None and fn("inf") is None, name
+
