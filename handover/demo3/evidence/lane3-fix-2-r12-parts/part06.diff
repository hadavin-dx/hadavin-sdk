+ALPHABET = "09.eE+-_ \t\r\n\x0b\x0c\xa0٢x,"  # digits, point, exponent, signs, every kind of blank, a foreign digit
+
+
+def test_the_copies_agree_with_the_one_reader_on_every_text_to_four_characters(monkeypatch: pytest.MonkeyPatch) -> None:
+    copies = _copies(monkeypatch)
+    count = 0
+    for n in range(0, 5):
+        for chars in itertools.product(ALPHABET, repeat=n):
+            text = "".join(chars)
+            want = envnum.retry_after_seconds(text)
+            count += 1
+            for name in ("load_driver", "hubspot_probe"):
+                assert copies[name](text) == want, (name, text)
+    assert count == sum(len(ALPHABET) ** n for n in range(5))
