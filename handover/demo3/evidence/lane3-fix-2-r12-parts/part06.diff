+@POSIX
+def test_the_link_and_kind_refusals_come_before_the_mode_refusal(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """REGRESSION GUARD (passes on the earlier code too). A link to a file with a bad mode, and a folder with a wide
+    mode, each say their own fault, not the mode. The link half takes away the open flag that refuses a link (as on a
+    system without it), so the open FOLLOWS the link, the file behind it has the bad mode, and only the second look
+    (the link check) stands before the mode check: moving the mode check above it would change the answer."""
+    real = tmp_path / "real-key.txt"
+    real.write_text(KEY, encoding="utf-8")
+    real.chmod(0o644)
+    link = tmp_path / "link-key.txt"
+    _make_link(link, real)
+    monkeypatch.setattr(os, "O_NOFOLLOW", 0, raising=False)
+    with pytest.raises(SettingRefused) as e:
+        envnum.read_secret_file(link, "made-up key", "key")
+    assert str(e.value) == LINK_TEXT
+    folder = tmp_path / "a-folder"
+    folder.mkdir()
+    folder.chmod(0o777)
+    with pytest.raises(SettingRefused) as e:
+        envnum.read_secret_file(folder, "made-up key", "key")
+    assert str(e.value) == "the made-up key file cannot be read"
