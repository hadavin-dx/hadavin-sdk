+# part of the list is derived from the names the code gives each kind of file (KINDS above), so a new kind is
+# covered without anyone editing this list; the fixed part holds the general words
+_KIND_NAMES = "|".join(re.escape(name).replace(r"\ ", r"[-\s]") for name in sorted(KINDS))
+KEY_FILE_WORDS = re.compile(
+    r"key[- ]file|password[- ]file|token[- ]file|secret[- ]file|credential[- ]file|KEY_FILE|PASSWORD_FILE"
+    r"|read_secret_file|key or password|" + _KIND_NAMES,
+    re.I,
+)
+# the words of the rule; case does not matter, a hyphen or a space (or a line break) may sit between two words
+RULE_WORDS = re.compile(
+    r"4096|printable\s+ASCII|byte[-\s]order|symbolic[-\s]links?|named\s+pipe|other\s+users",
+    re.I,
+)
+TEXT_SUFFIXES = (".md", ".txt", ".example")
+SKIPPED_FOLDERS = {
+    ".git", ".venv", "node_modules", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "build", "dist",
+}  # fmt: skip
