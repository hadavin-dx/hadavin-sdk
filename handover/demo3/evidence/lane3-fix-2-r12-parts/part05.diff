+def _make_link(link: Path, target: Path) -> None:
+    """A symbolic link; a system that will not make one here (Windows without the right) skips the test."""
+    try:
+        link.symlink_to(target, target_is_directory=target.is_dir())
+    except (OSError, NotImplementedError) as e:
+        pytest.skip(f"this system will not make a symbolic link here: {type(e).__name__}")
