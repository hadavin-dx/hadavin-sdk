+def _walk(node: ast.AST, stack: tuple[str, ...] = ()) -> Iterator[tuple[ast.AST, str]]:
+    """Every node with the name of the definitions around it ("Class.method", or "<module>" outside any)."""
+    named = isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
+    inner = (*stack, node.name) if named else stack  # type: ignore[attr-defined]
+    yield node, ".".join(inner) or "<module>"
+    for child in ast.iter_child_nodes(node):
+        yield from _walk(child, inner)
+
+
+def _call_name(f: ast.expr) -> str:
+    return f.id if isinstance(f, ast.Name) else f.attr if isinstance(f, ast.Attribute) else ""
+
+
+def _is_namespace(v: ast.expr) -> bool:
+    return (
+        (isinstance(v, ast.Attribute) and v.attr == "__dict__")
+        or (isinstance(v, ast.Name) and v.id in {"__builtins__", "builtins"})
+        or (isinstance(v, ast.Call) and _call_name(v.func) in NAMESPACE_CALLS)
+    )
+
+
+def _is_own_file_name(a: ast.AST) -> bool:
+    """`__file__`, `module.__file__`, or `str(...)` of one of them: the path of code that is running."""
+    if isinstance(a, ast.Name):
+        return a.id == "__file__"
+    if isinstance(a, ast.Attribute):
+        return a.attr == "__file__"
+    return (
+        isinstance(a, ast.Call)
+        and isinstance(a.func, ast.Name)
+        and a.func.id == "str"
+        and len(a.args) == 1
+        and not a.keywords
+        and _is_own_file_name(a.args[0])
+    )
+
+
+def _names_own_file(v: ast.AST) -> bool:
+    """True when the expression is EXACTLY the path of the running code: `Path(__file__)`, `Path(mod.__file__)` or
+    `Path(str(mod.__file__))`, optionally followed by `.parent` or `.parents[n]` (never a setting). Any other
+    expression that merely mentions `__file__` (a default of an environment lookup, a joined name) is not exempt."""
+    while True:
+        if isinstance(v, ast.Subscript) and isinstance(v.value, ast.Attribute) and v.value.attr == "parents":
+            v = v.value.value
+        elif isinstance(v, ast.Attribute) and v.attr in ("parent", "parents"):
+            v = v.value
+        else:
+            break
+    return (
+        isinstance(v, ast.Call)
+        and _call_name(v.func) == "Path"
+        and len(v.args) == 1
+        and not v.keywords
+        and _is_own_file_name(v.args[0])
+    )
+
+
+def _module_of(tree: ast.AST) -> dict[str, str]:
+    """`import shutil as sh` -> {"sh": "shutil"} (and the plain names), for the modules of the two bans."""
+    out: dict[str, str] = {}
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Import):
+            for a in n.names:
+                out[(a.asname or a.name).split(".")[0]] = a.name.split(".")[0]
+    return out
+
+
+def _refs(
+    source: str, names: set[str], *, bare_names: bool, readers: bool = False, zero_arg: bool = False
+) -> list[tuple[int, str, str]]:
+    """Every place the source names one of `names` (a line number, the line, the enclosing definition): an attribute
+    (`x.read_text`), a bare name when `bare_names` (`open`), an import of it (`from os import open`, or a star import
+    of an os-like module), a keyword or argument of that name, a definition of that name, or a `getattr(x, "name")`.
+    Calls and mere references are both found, so `reader = Path.read_text; reader(p)` is caught as well as
+    `Path(p).read_text()`. With `readers` the ban of whole modules (BANNED_MODULES), of attributes of shutil and os
+    (BANNED_MODULE_ATTRS), of a computed name in getattr, of `__import__`/`import_module` with a computed or banned
+    name, of `builtins.__dict__[...]`/`globals()[...]`/`__builtins__` are also reported; with `zero_arg` the
+    zero-argument `owner()` and `group()` probes (ZERO_ARG_PROBES) are. `Path(__file__).resolve()` (the file of the
+    code itself, not a setting) is never a hit."""
+    tree = ast.parse(source)
+    lines = source.splitlines()
+    modules = _module_of(tree)
+    found: dict[int, str] = {}
+    for n, scope in _walk(tree):
+        line = None
+        if isinstance(n, ast.Name) and bare_names and n.id in names:
+            line = n.lineno
+        elif isinstance(n, ast.Attribute) and n.attr in names:
+            if not (n.attr == "resolve" and _names_own_file(n.value)):
+                line = n.end_lineno  # the attribute name sits at the end of the expression
+        elif isinstance(n, ast.ImportFrom) and (
+            any(a.name in names for a in n.names)
+            or any(a.name == "*" for a in n.names)
+            and (n.module or "") in OS_MODULES
+        ):
+            line = n.lineno
+        elif isinstance(n, ast.keyword) and n.arg in names:
+            line = n.value.lineno
+        elif isinstance(n, ast.arg) and bare_names and n.arg in names:
+            line = n.lineno
+        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and bare_names and n.name in names:
+            line = n.lineno
+        elif (
+            isinstance(n, ast.Call)
+            and isinstance(n.func, ast.Name)
+            and n.func.id in ("getattr", "vars", "__import__")
+            and len(n.args) > 1
+            and isinstance(n.args[1], ast.Constant)
+            and n.args[1].value in names
+        ):
+            line = n.lineno
+        elif zero_arg and isinstance(n, ast.Call) and _call_name(n.func) in ZERO_ARG_PROBES:
+            if isinstance(n.func, ast.Attribute) and not n.args and not n.keywords:
+                line = n.lineno
+        elif readers:
+            line = _reader_extra(n, modules)
+        if line:
+            found.setdefault(line, scope)
+    return [(n, lines[n - 1].strip(), found[n]) for n in sorted(found)]
+
+
+def _reader_extra(n: ast.AST, modules: dict[str, str]) -> int | None:
+    """The extra bans of `_refs(readers=True)`: the line of this node, or None."""
+    if isinstance(n, ast.Import) and any(a.name.split(".")[0] in BANNED_MODULES for a in n.names):
+        return n.lineno
+    if isinstance(n, ast.ImportFrom):
+        top = (n.module or "").split(".")[0]
+        if top in BANNED_MODULES or any(a.name in BANNED_MODULE_ATTRS.get(top, set()) for a in n.names):
+            return n.lineno
+        return None
+    if isinstance(n, ast.Attribute) and isinstance(n.value, ast.Name):
+        module = modules.get(n.value.id, n.value.id)
+        if module in BANNED_MODULES or n.attr in BANNED_MODULE_ATTRS.get(module, set()):
+            return n.end_lineno
+    if isinstance(n, ast.Call):
+        name = _call_name(n.func)
+        if name == "getattr" and len(n.args) > 1 and not isinstance(n.args[1], ast.Constant):
+            return n.lineno  # a computed name can be any of the banned names
+        if name in {"__import__", "import_module"} and n.args:
+            first = n.args[0]
+            if not isinstance(first, ast.Constant) or str(first.value).split(".")[0] in BANNED_MODULES:
+                return n.lineno
+    if isinstance(n, ast.Subscript) and _is_namespace(n.value):
+        return n.lineno
+    if isinstance(n, ast.Name) and n.id == "__builtins__":
+        return n.lineno
+    return None
+
+
+def _scan_tree(
+    root: Path,
+    folders: tuple[str, ...],
+    names: set[str],
+    *,
+    bare_names: bool,
+    readers: bool = False,
+    zero_arg: bool = False,
+) -> list[tuple[str, int, str, str]]:
+    """(file, line, text, definition) for every hit of `_refs` in every .py file below each folder, at any depth;
+    only the file src/lead_desk/envnum.py (the one reader) is left out, by its exact path."""
+    out: list[tuple[str, int, str, str]] = []
+    for folder in folders:
+        for p in sorted((root / folder).rglob("*.py")):
+            rel = p.relative_to(root).as_posix()
+            if rel == THE_ONE_READER:
+                continue
+            hits = _refs(
+                p.read_text(encoding="utf-8"), names, bare_names=bare_names, readers=readers, zero_arg=zero_arg
+            )
+            out += [(rel, n, t, scope) for n, t, scope in hits]
+    return out
+
+
+def _unallowed(
+    hits: list[tuple[str, int, str, str]], allowed: dict[tuple[str, str, str], tuple[int, str]]
+) -> tuple[list[str], list[tuple[str, str, str]]]:
+    """(hits that no allowance covers, allowances that nothing uses up). The key is the file, the definition around
+    the line and the exact line text without its trailing comment; the number says how many times that line may occur
+    there. A line that moves to another definition is a new hit."""
+    bad: list[str] = []
+    used: dict[tuple[str, str, str], int] = {}
+    for rel, n, text, scope in hits:
+        key = (rel, scope, text.split("  #")[0].rstrip())
+        if key in allowed and used.get(key, 0) < allowed[key][0]:
+            used[key] = used.get(key, 0) + 1
+        else:
+            bad.append(f"{rel}:{n} ({scope}): {text}")
+    stale = [k for k, (count, _why) in allowed.items() if used.get(k, 0) != count]
+    return bad, stale
+
