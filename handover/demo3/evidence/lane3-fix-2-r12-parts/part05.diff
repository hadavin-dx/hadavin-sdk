+# ------------------------------------------- every reader of the Retry-After header is the one reader or a pinned copy
+READER_NAMES = {"retry_after_seconds", "_retry_after", "_retry_after_fallback"}
+EXPECTED_READERS = {
+    ("src/lead_desk/envnum.py", "retry_after_seconds"),
+    ("load_tools/load_driver.py", "_retry_after_fallback"),
+    ("scripts/hubspot_probe.py", "_retry_after"),
+}
+WRITER_CALLS = {"send_header", "add_header", "putheader"}  # they set the header; they do not read it
+TABLE_ATTRS = {"headers", "msg"}  # the whole header table of a reply or an error
+TABLE_CALLS = {"dict", "list", "tuple", "sorted", "set", "iter", "enumerate", "vars"}
+
+
+def _retry_names(source: str) -> set[str]:
+    """Names that stand for the header's name in this source: `H = "Retry-After"` (any case)."""
+    return {
+        t.id
+        for n in ast.walk(ast.parse(source))
+        if isinstance(n, ast.Assign)
+        and isinstance(n.value, ast.Constant)
+        and str(n.value.value).lower() == "retry-after"
+        for t in n.targets
+        if isinstance(t, ast.Name)
+    }
+
+
+def _is_retry(e: ast.AST, names: set[str]) -> bool:
+    if isinstance(e, ast.Constant):
+        return isinstance(e.value, str) and e.value.lower() == "retry-after"
+    return (isinstance(e, ast.Name) and e.id in names) or (isinstance(e, ast.Attribute) and e.attr in names)
+
+
+def _is_table(e: ast.AST) -> bool:
+    return (isinstance(e, ast.Attribute) and e.attr in TABLE_ATTRS) or (
+        isinstance(e, ast.Call) and _name_of(e.func) in {"info", "getheaders"}
+    )
+
+
+def _name_of(f: ast.expr) -> str:
+    return f.id if isinstance(f, ast.Name) else f.attr if isinstance(f, ast.Attribute) else ""
+
+
+def _header_reads(tree: ast.AST, names: set[str]) -> list[ast.AST]:
+    """Every place that reads the Retry-After header or the whole header table: a subscript or a call that is given the
+    header's name (a literal, any case, or a name that holds it), `dict(x.headers)`, `x.headers.items()`, a loop over
+    the table, `getheaders()`. A call to a reader or to a writer is not a read here."""
+    reads: list[ast.AST] = []
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Subscript) and isinstance(n.ctx, ast.Load) and _is_retry(n.slice, names):
+            reads.append(n)
+        elif isinstance(n, ast.Call):
+            name = _name_of(n.func)
+            if name in WRITER_CALLS or name in READER_NAMES:
+                continue
+            args = [*n.args, *(k.value for k in n.keywords)]
+            if any(_is_retry(a, names) for a in args):
+                reads.append(n)
+            elif name in TABLE_CALLS and n.args and _is_table(n.args[0]):
+                reads.append(n)
+            elif name == "getheaders" or (
+                isinstance(n.func, ast.Attribute)
+                and n.func.attr in {"items", "keys", "values"}
+                and _is_table(n.func.value)
+            ):
+                reads.append(n)
+        elif isinstance(n, (ast.For, ast.comprehension)) and _is_table(n.iter):
+            reads.append(n.iter)
+    return reads
+
+
+def _reader_report(source: str, names: set[str] | None = None) -> tuple[list[str], list[int]]:
+    """(functions that turn Retry-After text into a number themselves, header reads that no reader receives)."""
+    tree = ast.parse(source)
+    names = _retry_names(source) | (names or set())
+    own = [
+        f.name
+        for f in ast.walk(tree)
+        if isinstance(f, (ast.FunctionDef, ast.AsyncFunctionDef))
+        and any(isinstance(c, ast.Call) and _name_of(c.func) in {"float", "Decimal", "int"} for c in ast.walk(f))
+        and (
+            "retry_after" in f.name.lower()
+            or any(isinstance(c, ast.Name) and c.id == "RETRY_AFTER_MAX_SECONDS" for c in ast.walk(f))
+        )
+    ]
+    fed: set[int] = set()
+    for c in ast.walk(tree):
+        if isinstance(c, ast.Call) and _name_of(c.func) in READER_NAMES:
+            fed |= {id(a) for a in c.args}
+    return own, [r.lineno for r in _header_reads(tree, names) if id(r) not in fed]
+
+
+@pytest.mark.parametrize(
+    ("source", "loose", "own"),
+    [
+        ("def f(e):\n    return float(e.headers.get('Retry-After', ''))\n", [2], []),
+        ("def f(e):\n    return float(e.headers['Retry-After'])\n", [2], []),
+        ("H = 'Retry-After'\ndef f(e):\n    return e.headers.get(H)\n", [3], []),
+        ("H = 'retry-after'\ndef f(e):\n    return e.headers[H]\n", [3], []),
+        ("def f(e):\n    return dict(e.headers)\n", [2], []),
+        ("def f(e):\n    return list(e.headers.items())\n", [2], []),
+        ("def f(e):\n    return {k: v for k, v in e.headers.items()}\n", [2], []),
+        ("def f(e):\n    for k in (e.headers):\n        pass\n", [2], []),
+        ("def f(r):\n    return r.getheaders()\n", [2], []),
+        ("def f(r):\n    return r.getheader('Retry-After')\n", [2], []),
+        ("def f(r):\n    return (r).info().get('retry-after')\n", [2], []),
+        ("w = int(e.headers.getheader('retry-after'))\n", [1], []),
+        ("def _retry_after(v):\n    return float(v)\n", [], ["_retry_after"]),
+        ("def renamed(v):\n    return min(float(v), RETRY_AFTER_MAX_SECONDS)\n", [], ["renamed"]),
+        ("x = retry_after_seconds(e.headers.get('Retry-After'))\n", [], []),
+        ("x = _retry_after(e.headers['Retry-After'])\n", [], []),
+        ("self.send_header('Retry-After', '1')\nh = {'Retry-After': '1'}\nheaders['Retry-After'] = '2'\n", [], []),
+    ],
+)
+def test_the_reader_list_scanner_sees_planted_readers_and_leaves_writers_alone(
+    source: str, loose: list[int], own: list[str]
