+# ------------------------------------------------------------------ the spending caps: the real refusal text is reached
+@pytest.mark.parametrize("arg", ["NaN", "Infinity", "-Infinity", "0", "-1"])
+@pytest.mark.parametrize("flag", ["--cap-run", "--cap-total"])
+def test_the_live_check_refuses_a_cap_with_its_own_text(
+    flag: str, arg: str, tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    mod = importlib.import_module("run_live_check")
+    keyf = tmp_path / "k.txt"
+    keyf.write_text(KEY, encoding="utf-8")
+    other = "--cap-total" if flag == "--cap-run" else "--cap-run"
+    argv = ["--key-file", str(keyf), "--ledger", str(tmp_path / "l.jsonl"), "--price-date", "2026-01-01"]
+    argv += ["--model", "m=1,2", f"{flag}={arg}", f"{other}=3"]  # one token: argparse takes "-Infinity" as the value
+    with pytest.raises(SystemExit) as e:
+        mod.main(argv)
+    assert e.value.code == 2
+    err = capsys.readouterr().err
+    assert "a spending cap must be a finite amount above zero" in err and "Traceback" not in err, err
+
