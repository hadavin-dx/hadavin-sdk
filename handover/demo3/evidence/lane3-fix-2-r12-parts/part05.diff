+def test_every_retry_after_reader_in_the_repository_is_the_one_reader_or_a_pinned_copy() -> None:
+    files = [
+        (p.relative_to(REPO).as_posix(), p.read_text(encoding="utf-8"))
+        for f in READ_FOLDERS
+        for p in sorted((REPO / f).rglob("*.py"))
+    ]
+    names: set[str] = set()
+    for _rel, text in files:
+        names |= _retry_names(text)
+    readers: set[tuple[str, str]] = set()
+    unfed: list[str] = []
+    for rel, text in files:
+        own, loose = _reader_report(text, names)
+        readers |= {(rel, name) for name in own}
+        unfed += [f"{rel}:{n}" for n in loose]
+    assert unfed == [], unfed
+    assert readers == EXPECTED_READERS, readers
