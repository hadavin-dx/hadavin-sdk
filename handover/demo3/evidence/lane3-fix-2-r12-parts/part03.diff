+PathKind = Literal["folder", "file", "absent", "unreadable"]
+# Nothing is there, or the text can never be a path that exists: not a failure. ENAMETOOLONG and EINVAL (a name the
+# system cannot hold) and the Windows codes 123 (invalid name), 21 (device not ready) and 1921 (a link that cannot be
+# resolved) say the same as ENOENT.
+_ABSENT_ERRNOS = (errno.ENOENT, errno.ENOTDIR, errno.ELOOP, errno.ENAMETOOLONG, errno.EINVAL)
+_ABSENT_WINERRORS = (123, 21, 1921)
+
+
+def path_kind(path: Path) -> PathKind:
+    """What a setting's path is right now: `folder`, `file` (anything else that exists), `absent`, or `unreadable`
+    (the system will not tell us, for example no permission to look inside a parent folder). The one place that
+    looks at a setting's path before the desk uses it: `Path.is_dir()` and `Path.exists()` raise PermissionError for a
+    folder that cannot be looked at (seen as an ordinary user on Python 3.11, 3.12 and 3.13), which ended in a
+    traceback (exit code 1) where a refusal (exit code 4) is documented.
+    Every caller treats `unreadable` as a refusal with a fixed text (no path in it)."""
+    try:
+        mode = path.stat().st_mode
+    except ValueError:  # an embedded NUL: not a path that exists (what is_dir() reported too)
+        return "absent"
+    except OSError as e:
+        if e.errno in _ABSENT_ERRNOS or getattr(e, "winerror", None) in _ABSENT_WINERRORS:
+            return "absent"
+        return "unreadable"
+    return "folder" if stat.S_ISDIR(mode) else "file"
+
+
+FileProblem = Literal["folder", "inside_file", "unreadable", "link"]
+
+
+def env_file_problem(path: Path) -> FileProblem | None:
+    """Why a path cannot be the place of a FILE the desk writes or reads (None: it can). `folder`: the path is a
+    folder. `inside_file`: the first part of the path that exists is a file, where a folder must be. `link`: the path,
+    or a part of it above the first folder that exists, is a symbolic link that leads nowhere (the target is missing
+    or the links go round in a circle): opening such a name would create a file at the link's target, or fail
+    in a way no one can read. `unreadable`: the system will not let the desk look at the path or at a part of it.
+    A link that leads to an existing folder or file keeps the answer of that target. The one parent walk for the
+    lead-book path, the live ledger and both counters files; every look at a path goes through `path_kind`, which
+    reads a dangling link and a link that loops as `absent` (the system answers "no such file"); this walk then asks
+    `_is_link` (one `os.lstat`, the only other look) about each absent name, and so tells them apart from a name
+    that is really free. The last branch (a part above the path that cannot be looked at) is
+    practically unreachable on a real system, because a look at the path itself fails first; it stays for a system
+    that answers the path as absent and its parent as unreadable, and a test reaches it by making only the parent
+    raise."""
+    kind = path_kind(path)
+    if kind == "folder":
+        return "folder"
+    if kind == "unreadable":
+        return "unreadable"
+    if kind == "file":
+        return None
+    for part in (path, *path.parents):  # the path is absent: the first part that exists must be a folder
+        part_kind = path_kind(part)
+        if part_kind == "absent":
+            if _is_link(part):  # absent although the name is a link: dangling, or a loop
+                return "link"
+            continue
+        if part_kind == "folder":
+            return None
+        if part_kind == "file":
+            return "inside_file"
+        return "unreadable"
+    return None
+
+
+def file_problem_text(name: str, problem: FileProblem) -> str:
+    """The fixed refusal text for an `env_file_problem` answer: the setting named, never the path."""
+    if problem == "folder":
+        return f"{name} names a folder, not a file"
+    if problem == "inside_file":
+        return f"{name} sits inside something that is a file, not a folder"
+    if problem == "link":
+        return f"{name} is, or sits behind, a symbolic link that leads nowhere: name a real file"
+    return f"{name} cannot be looked at (the system would not let the desk look at a part of that path)"
+
