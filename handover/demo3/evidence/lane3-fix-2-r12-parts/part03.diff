+        self.stop_event = threading.Event()
+        self.thread = threading.Thread(target=self._loop, daemon=True)
+        self.thread.start()
+
+    @property
+    def hits(self) -> int:
+        with self._lock:
+            return self._hits
+
+    def _loop(self) -> None:
+        while not self.stop_event.is_set():
+            try:
+                conn, _ = self.sock.accept()
+            except (TimeoutError, OSError):
+                continue
+            with conn:
+                conn.settimeout(STUB_IO_SECONDS)
+                try:
+                    buf = b""
+                    while b"\r\n\r\n" not in buf:
+                        chunk = conn.recv(4096)
+                        if not chunk:
+                            break
+                        buf += chunk
+                    head = b"HTTP/1.1 429 Too Many Requests\r\n"
+                    if self.header is not None:
+                        head += b"Retry-After: " + self.header + b"\r\n"
+                    head += b"Content-Type: application/json\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}"
+                    if b"\r\n\r\n" not in buf:
+                        continue  # a connection that closed without a request is not a request
+                    with self._lock:
+                        self._hits += 1  # before the answer is sent
+                    conn.sendall(head)
+                    time.sleep(self._pause)
+                except OSError:
+                    pass
+
+    @property
+    def url(self) -> str:
+        return f"http://{HOST}:{self.port}"
+
+    def close(self) -> None:
+        self.stop_event.set()
+        self.thread.join(STUB_IO_SECONDS)
+        self.sock.close()
+
+
+def fresh_script(monkeypatch: Any, name: str, path: Path) -> Any:
+    """Load a file as a module with its own name. `monkeypatch` puts `sys.modules` back at the end of the test, so
+    nothing leaks to a later test (one helper for every test that loads a script from `scripts/`)."""
+    import importlib.util
+    import sys
+
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, name, mod)
+    spec.loader.exec_module(mod)
+    return mod
