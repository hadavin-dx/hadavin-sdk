+def refuse_unusable_file(name: str, path: Path) -> None:
+    """For a setting that must name a FILE (a counters file, a ledger): a folder, a path inside a file, or a path the
+    system will not let us look at is a SettingRefused naming the setting (never the path). A path that is absent
+    below a folder, or a file, passes."""
+    problem = env_file_problem(path)
+    if problem is not None:
+        raise SettingRefused(file_problem_text(name, problem))
