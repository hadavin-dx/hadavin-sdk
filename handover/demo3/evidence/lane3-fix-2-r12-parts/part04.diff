diff --git a/tests/test_one_key_file_rule_and_path_walk.py b/tests/test_one_key_file_rule_and_path_walk.py
new file mode 100644
index 0000000..12fdef8
--- /dev/null
+++ b/tests/test_one_key_file_rule_and_path_walk.py
@@ -0,0 +1,591 @@
+"""One rule for every secret file, one parent walk for every file path a setting names (lane 3 fix 2, round 4).
+
+Made-up data only; key files hold made-up text built from parts. Each test below was run against the round 3 tree
+(it fails there unless it is labelled a REGRESSION GUARD; the list is in the notes)."""
+
+from __future__ import annotations
+
+import ast
+import errno
+import inspect
+import os
+import re
+import threading
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import BLOCK_CHECK_SECONDS, port_nobody_listens_on
+
+from lead_desk import envnum, loader, server
+from lead_desk.config import Config, read_approvers
+from lead_desk.crm_hubspot import HubspotCrm, HubspotSettings
+from lead_desk.desk import BOOK_UNREADABLE_PROBLEM, book_problem
+from lead_desk.envnum import SettingRefused, env_file_problem, file_problem_text, path_kind
+from lead_desk.live_claude import LiveQualifier
+from lead_desk.smtp_provider import ProviderSettings, SmtpProviderOutbox, read_smtp_password
+
+SRC = Path(server.__file__).parent
+REPO = SRC.parents[1]
+FAKE_KEY = "made" + "-up-" + "key-" + "0123456789"  # built from parts: never a real key
+SECRET_TEXT = "SECRET" + "-text-" + "1234"
+
+
+def _hubspot(key: Path, extra: dict[str, str] | None = None) -> dict[str, str]:
+    return {"DESK_HUBSPOT_KEY_FILE": str(key), "DESK_HUBSPOT_MAX_CALLS": "5", **(extra or {})}
+
+
+def _provider(pw: Path, extra: dict[str, str] | None = None) -> dict[str, str]:
+    return {
+        "DESK_SMTPP_HOST": "mail.example.test",
+        "DESK_SMTPP_USER": "u",
+        "DESK_SMTPP_PASSWORD_FILE": str(pw),
+        "DESK_SMTPP_FROM": "a@example.test",
+        "DESK_SMTPP_RECIPIENTS": "b@example.test",
+        "DESK_SMTPP_MAX_SENDS": "5",
+        **(extra or {}),
+    }
+
+
+def _live(key: Path, tmp_path: Path, extra: dict[str, str] | None = None) -> dict[str, str]:
+    return {
+        "DESK_QUALIFIER": "live_claude",
+        "DESK_LIVE_MODEL": "made-up-model",
+        "DESK_LIVE_KEY_FILE": str(key),
+        "DESK_LIVE_PRICE_DATE": "2026-01-01",
+        "DESK_LIVE_LEDGER_PATH": str(tmp_path / "ledger.jsonl"),
+        "DESK_LIVE_RUN_ID": "run1",
+        "DESK_LIVE_PRICE_IN_PER_MTOK": "1",
+        "DESK_LIVE_PRICE_OUT_PER_MTOK": "2",
+        "DESK_LIVE_CAP_RUN_USD": "1",
+        "DESK_LIVE_CAP_TOTAL_USD": "3",
+        **(extra or {}),
+    }
+
+
+def _kind(name: str, f: Path, tmp_path: Path) -> Any:
+    if name == "hubspot":
+        return HubspotCrm(HubspotSettings.from_env({**_hubspot(f)}))
+    if name == "provider":
+        return SmtpProviderOutbox(ProviderSettings.from_env(_provider(f)))
+    live = Config.from_env(_live(f, tmp_path)).live
+    assert live is not None
+    return LiveQualifier(live)
+
+
+def _write_sample(f: Path, sample: str) -> None:
+    if sample == "directory":
+        f.mkdir()
+    elif sample == "short":
+        f.write_text("abc\n", encoding="utf-8")
+    elif sample == "empty":
+        f.write_text("", encoding="utf-8")
+    elif sample == "utf16":
+        f.write_bytes(b"\xff\xfe" + SECRET_TEXT.encode("utf-16-le"))
+    elif sample == "several-lines":
+        f.write_text(SECRET_TEXT + "\n" + SECRET_TEXT + "\n", encoding="utf-8")
+    elif sample == "oversize":
+        f.write_text(SECRET_TEXT * 5000, encoding="utf-8")
+    elif sample == "not-utf8":
+        f.write_bytes(b"\xc3\x28" + SECRET_TEXT.encode())
+    elif sample == "non-ascii":
+        f.write_text(SECRET_TEXT + "éé", encoding="utf-8")
+    elif sample == "control-character":
+        f.write_text(SECRET_TEXT + "\x07\x07", encoding="utf-8")
+    # "missing": nothing is written
+
+
+BAD_SAMPLES = [
+    "missing",
+    "directory",
+    "empty",
+    "short",
+    "utf16",
+    "several-lines",
+    "oversize",
+    "not-utf8",
+    "non-ascii",
+    "control-character",
+]
+KINDS = ["hubspot", "provider", "live"]
+
+
+@pytest.mark.parametrize("sample", BAD_SAMPLES)
+def test_the_three_kinds_refuse_the_same_ten_bad_files(tmp_path: Path, sample: str) -> None:
+    verdicts: dict[str, str] = {}
+    for kind in KINDS:
+        f = tmp_path / (kind + "-private-file-name.txt")
+        _write_sample(f, sample)
+        with pytest.raises(SettingRefused) as info:
+            _kind(kind, f, tmp_path).check_start()
+        msg = str(info.value)
+        assert os.sep not in msg and f.name not in msg and "SECRET" not in msg, msg
+        verdicts[kind] = re.sub(r"DESK_[A-Z_]+: the .*? file ", "", msg).replace("password", "X").replace("key", "X")
+    assert len(set(verdicts.values())) == 1, verdicts  # the same words for the same fault, whichever kind reads it
+
+
+def test_a_key_with_a_space_inside_is_refused_by_the_hubspot_and_live_kinds_and_dropped_by_the_smtp_password(
+    tmp_path: Path,
+) -> None:
+    f = tmp_path / "spaced.txt"
+    f.write_text("abcd efgh ijkl\n", encoding="utf-8")
+    for kind in ("hubspot", "live"):
+        with pytest.raises(SettingRefused, match="must not hold a space"):
+            _kind(kind, f, tmp_path).check_start()
+    assert read_smtp_password(f) == "abcdefghijkl"  # providers show an app password in groups: the one exception
+    _kind("provider", f, tmp_path).check_start()
+
+
+def test_every_refusal_text_uses_the_word_of_its_own_secret(tmp_path: Path) -> None:
+    for sample in ("short", "several-lines", "oversize"):
+        for kind, own, other in (
+            ("live", "key", "password"),
+            ("hubspot", "key", "password"),
+            ("provider", "password", "key"),
+        ):
+            f = tmp_path / f"{kind}-{sample}.txt"
+            _write_sample(f, sample)
+            with pytest.raises(SettingRefused) as info:
+                _kind(kind, f, tmp_path).check_start()
+            msg = str(info.value)
+            assert own in msg and other not in msg, msg
+
+
+def test_the_one_function_returns_the_line_and_the_kinds_name_their_own_files(tmp_path: Path) -> None:
+    f = tmp_path / "k.txt"
+    f.write_bytes(b"\xef\xbb\xbf" + FAKE_KEY.encode() + b"\r\n")  # a byte-order mark and a Windows line end
+    assert envnum.read_secret_file(f, "made-up key", "key") == FAKE_KEY
+    with pytest.raises(SettingRefused, match="the made-up key file cannot be read"):
+        envnum.read_secret_file(tmp_path / "none.txt", "made-up key", "key")
+    with pytest.raises(SettingRefused, match="the made-up key file cannot be read"):
+        envnum.read_secret_file(Path("a\x00b"), "made-up key", "key")  # a NUL in the path is not a traceback
+
+
+def _imports_of(path: Path) -> set[str]:
+    found: set[str] = set()
+    for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+        if isinstance(node, ast.ImportFrom) and node.module:
+            found.add(node.module)
+            found.update(f"{node.module}.{a.name}" for a in node.names)
+        elif isinstance(node, ast.Import):
+            found.update(a.name for a in node.names)
+    return found
+
+
+def test_no_kind_that_reads_a_secret_file_imports_another_kind() -> None:
+    """The three kinds that hold a key or password file (and the mailbox counter) share no module: the one rule is in
+    `envnum`. (`smtp_provider` and `smtp_outbox` share the plain SMTP wire helpers; that is not the secret rule.)"""
+    kinds = ("crm_hubspot", "smtp_provider", "live_claude")
+    for name in kinds:
+        imported = _imports_of(SRC / f"{name}.py")
+        for other in kinds:
+            if other != name:
+                assert f"lead_desk.{other}" not in imported, (name, other)
+    assert not {"lead_desk.crm_hubspot", "lead_desk.live_claude"} & _imports_of(SRC / "imap_count.py")
+
+
+def test_only_envnum_reads_a_secret_file() -> None:
+    """The rule has one copy: the byte limit is read in `envnum.py` and named in `constants.py` only."""
+    holders = sorted(p.name for p in SRC.glob("*.py") if "SECRET_FILE_MAX_BYTES" in p.read_text(encoding="utf-8"))
+    assert holders == ["constants.py", "envnum.py"], holders
+    for name in ("crm_hubspot.py", "smtp_provider.py", "live_claude.py"):
+        assert 'decode("utf-8-sig")' not in (SRC / name).read_text(encoding="utf-8"), name
+
+
+# ------------------------------------------------------------------------------------------ the shared parent walk
+def _settings_builders(f: Path, tmp_path: Path, target: str) -> dict[str, Any]:
+    return {
+        "DESK_HUBSPOT_STATS_FILE": lambda: HubspotSettings.from_env(_hubspot(f, {"DESK_HUBSPOT_STATS_FILE": target})),
+        "DESK_SMTPP_STATS_FILE": lambda: ProviderSettings.from_env(_provider(f, {"DESK_SMTPP_STATS_FILE": target})),
+        "DESK_LIVE_LEDGER_PATH": lambda: Config.from_env(_live(f, tmp_path, {"DESK_LIVE_LEDGER_PATH": target})),
+    }
+
+
+def test_a_stats_file_or_ledger_path_inside_a_file_is_refused_with_no_path(tmp_path: Path) -> None:
+    f = tmp_path / "good-key"
+    f.write_text(FAKE_KEY + "\n", encoding="utf-8")
+    below = str(f / "x.json")  # the key file is a file: nothing can be made below it
+    deeper = str(f / "a" / "b" / "x.json")
+    for target in (below, deeper):
+        for name, build in _settings_builders(f, tmp_path, target).items():
+            with pytest.raises(SettingRefused) as info:
+                build()
+            assert str(info.value) == f"{name} sits inside something that is a file, not a folder"
+
+
+def test_a_db_path_inside_a_file_and_a_stats_file_inside_a_file_say_the_same_thing(tmp_path: Path) -> None:
+    f = tmp_path / "a-file"
+    f.write_text("x", encoding="utf-8")
+    assert env_file_problem(f / "below") == "inside_file"
+    assert env_file_problem(f / "a" / "b" / "c") == "inside_file"
+    assert book_problem(f / "below" / "d.db") == "DESK_DB_PATH sits inside something that is a file, not a folder"
+    assert env_file_problem(tmp_path) == "folder"
+    assert env_file_problem(tmp_path / "none" / "x") is None
+    assert env_file_problem(f) is None
+
+
+def _deny_looking_inside(monkeypatch: pytest.MonkeyPatch, locked: Path) -> None:
+    real_stat = Path.stat
+
+    def stat(self: Path, *args: Any, **kwargs: Any) -> os.stat_result:
+        if self == locked or locked in self.parents:
+            raise PermissionError(errno.EACCES, "Permission denied")
+        return real_stat(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", stat)
+
+
+def test_a_path_the_system_will_not_show_is_refused_by_every_file_setting_in_the_same_words(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    f = tmp_path / "good-key"
+    f.write_text(FAKE_KEY + "\n", encoding="utf-8")
+    locked = tmp_path / "locked"
+    locked.mkdir()
+    _deny_looking_inside(monkeypatch, locked)
+    words = "cannot be looked at (the system would not let the desk look at a part of that path)"
+    for name, build in _settings_builders(f, tmp_path, str(locked / "x.json")).items():
+        with pytest.raises(SettingRefused) as info:
+            build()
+        assert str(info.value) == f"{name} {words}"
+    assert BOOK_UNREADABLE_PROBLEM == f"DESK_DB_PATH {words}"
+    assert book_problem(locked / "d.db") == BOOK_UNREADABLE_PROBLEM
+
+
+@pytest.mark.parametrize(
+    ("code", "expected"),
+    [
+        (errno.ENAMETOOLONG, "absent"),
+        (errno.EINVAL, "absent"),
+        (errno.ENOENT, "absent"),
+        (errno.EACCES, "unreadable"),
+        (errno.EIO, "unreadable"),
+    ],
+)
+def test_path_kind_does_not_call_a_bad_name_a_permission_problem(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, code: int, expected: str
+) -> None:
+    def stat(self: Path, *args: Any, **kwargs: Any) -> os.stat_result:
+        raise OSError(code, "x")
+
+    monkeypatch.setattr(Path, "stat", stat)
+    assert path_kind(tmp_path / "x") == expected
+
+
+@pytest.mark.parametrize("winerror", [123, 21, 1921])
+def test_path_kind_reads_the_windows_codes_for_a_bad_name_as_absent(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, winerror: int
+) -> None:
+    class WindowsStyleError(OSError):
+        def __init__(self) -> None:
+            super().__init__(errno.EIO, "x")
