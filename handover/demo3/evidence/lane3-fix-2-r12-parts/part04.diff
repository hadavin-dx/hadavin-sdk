+@POSIX
+@pytest.mark.parametrize("shape", ["dangling", "loop", "loop_in_parent", "dangling_parent"])
+def test_run_real_check_refuses_a_link_that_leads_nowhere_in_one_line_and_creates_nothing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str], shape: str
+) -> None:
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    mod: Any = fresh_script(monkeypatch, "run_real_check", REPO / "scripts" / "run_real_check.py")
+    target = tmp_path / "target-folder" / "target.db"
+    if shape == "dangling":
+        book = tmp_path / "book.db"
+        _link(book, target)
+    elif shape == "loop":
+        book = tmp_path / "loop-a"
+        _loop(book, tmp_path / "loop-b")
+    elif shape == "loop_in_parent":
+        _loop(tmp_path / "loop-a", tmp_path / "loop-b")
+        book = tmp_path / "loop-a" / "book.db"
+    else:
+        _link(tmp_path / "gone", tmp_path / "target-folder")
+        book = tmp_path / "gone" / "book.db"
+    values = dict.fromkeys(mod.REQUIRED, "x") | {"DESK_DB_PATH": str(book)}
+    cfg = tmp_path / "run.env"
+    cfg.write_text("\n".join(f"{k}={v}" for k, v in values.items()) + "\n", encoding="utf-8")
+    monkeypatch.setattr("builtins.input", lambda prompt="": pytest.fail("the question must not be reached"))
+    before = sorted(p.name for p in tmp_path.rglob("*"))
+    code = mod.main(["--config", str(cfg)])
+    out = capsys.readouterr().out
+    assert code == mod.EXIT_REFUSED, out
+    assert out.strip().splitlines() == [f"refused: ValueError: {LINK_TEXT}"], out
+    assert str(tmp_path) not in out and "Traceback" not in out
+    assert not (tmp_path / "target-folder").exists(), "a file or folder was made at the link's target"
