+"""Fix-2 round 6: one line-end rule for every secret file, one reader outside envnum nowhere, one Retry-After reader,
+finite spending caps, one word "lead-book". Made-up data only; fake keys are built from parts."""
+
+from __future__ import annotations
+
+import importlib
+import math
+import os
+import re
+import sys
+import threading
+from email.utils import formatdate
+from pathlib import Path
+
+import pytest
+from support import BLOCK_CHECK_SECONDS
+
+from lead_desk import envnum, server
+from lead_desk.envnum import SettingRefused
+
+SRC = Path(server.__file__).parent
+REPO = SRC.parents[1]
+KEY = "made" + "-up-" + "key-" + "0123456789"
+ODD = {
+    "tab": "\t",
+    "no-break-space": " ",
+    "ideographic-space": "　",
+    "file-separator": "\x1c",
+    "unit-separator": "\x1f",
+    "next-line": "\x85",
+    "vertical-tab": "\x0b",
+    "form-feed": "\x0c",
+}
+
+
+def _put(tmp_path: Path, body: bytes) -> Path:
+    f = tmp_path / "secret-file.txt"
+    f.write_bytes(body)
+    return f
+
+
+# ---------------------------------------------------------------- 1: the one line-end rule, at every position
+@pytest.mark.parametrize("name", sorted(ODD))
+@pytest.mark.parametrize("where", ["start", "middle", "end"])
+@pytest.mark.parametrize("inner", [False, True])
+def test_any_blank_but_the_line_end_at_the_end_of_the_file_is_refused(
+    tmp_path: Path, name: str, where: str, inner: bool
+) -> None:
+    ch = ODD[name]
+    text = {"start": ch + KEY, "middle": KEY[:6] + ch + KEY[6:], "end": KEY + ch}[where]
+    with pytest.raises(SettingRefused) as info:
+        envnum.read_secret_file(_put(tmp_path, text.encode()), "made-up key", "key", strip_inner_space=inner)
+    assert KEY not in str(info.value) and os.sep not in str(info.value)
+
+
+@pytest.mark.parametrize("where", ["start", "middle", "end"])
+def test_a_plain_space_is_refused_for_a_key_and_dropped_for_the_password(tmp_path: Path, where: str) -> None:
+    text = {"start": " " + KEY, "middle": KEY[:6] + " " + KEY[6:], "end": KEY + " "}[where]
+    f = _put(tmp_path, text.encode())
+    with pytest.raises(SettingRefused, match="must not hold a space"):
+        envnum.read_secret_file(f, "made-up key", "key")
+    assert envnum.read_secret_file(f, "made-up password", "password", strip_inner_space=True) == KEY
+
+
+@pytest.mark.parametrize(
+    ("body", "ok"),
+    [
+        (KEY.encode(), True),
+        (KEY.encode() + b"\n", True),
+        (KEY.encode() + b"\r\n", True),
+        (b"\xef\xbb\xbf" + KEY.encode() + b"\n", True),
+        (KEY.encode() + b"\n\n", False),  # an empty second line
+        (KEY.encode() + b"\r", False),
+        (b"\n" + KEY.encode(), False),
+        (KEY.encode() + b"\n ", False),
+        (KEY.encode()[:5] + b"\n" + KEY.encode()[5:], False),
+    ],
+)
+def test_only_one_line_end_at_the_very_end_is_removed(tmp_path: Path, body: bytes, ok: bool) -> None:
+    f = _put(tmp_path, body)
+    if ok:
+        assert envnum.read_secret_file(f, "made-up key", "key") == KEY
+    else:
+        with pytest.raises(SettingRefused):
+            envnum.read_secret_file(f, "made-up key", "key")
+
+
+def test_the_reader_opens_the_file_without_taking_a_terminal(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    seen: list[int] = []
+    real = os.open
+
+    def spy(path: object, flags: int, *a: object, **k: object) -> int:
+        seen.append(flags)
+        return real(path, flags, *a, **k)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(os, "open", spy)
+    envnum.read_secret_file(_put(tmp_path, KEY.encode()), "made-up key", "key")
+    assert seen and all(f & getattr(os, "O_NOCTTY", 0) == getattr(os, "O_NOCTTY", 0) for f in seen)
+
+
+def test_the_docs_state_the_line_end_rule() -> None:
+    text = " ".join((REPO / "docs" / "settings.md").read_text(encoding="utf-8").split())  # said once: r8 file pins that
+    assert "Only the line break at the very end of the file is removed" in text
+    doc = " ".join((envnum.__doc__ or "").split()).lower()
+    assert "retry-after" in doc and "secret file" in doc
+
+
+# ---------------------------------------------------------------- 2 and 3: the readers outside src
+def _n8n(monkeypatch: pytest.MonkeyPatch, key: Path) -> object:
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(key))
+    monkeypatch.delenv("N8N_URL", raising=False)
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    return importlib.import_module("n8n_api")
+
+
+def test_the_n8n_script_reads_its_key_with_the_one_rule(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    mod = _n8n(monkeypatch, _put(tmp_path, KEY.encode() + b"\n"))
+    assert mod.KEY == KEY  # type: ignore[attr-defined]
+    assert not hasattr(mod, "MAX_KEY")
+    for body in (b"abc", KEY.encode() + b"\t", b" " + KEY.encode(), b"k" * 5000):
+        with pytest.raises(SystemExit) as e:
+            _n8n(monkeypatch, _put(tmp_path, body))
+        assert "n8n API key file" in str(e.value) and "k" * 40 not in str(e.value)
+
+
+@pytest.mark.skipif(not hasattr(os, "mkfifo"), reason="no named pipes on this system")
+def test_the_n8n_script_does_not_block_on_a_named_pipe(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    fifo = tmp_path / "pipe.txt"
+    os.mkfifo(fifo)
+    out: list[str] = []
+
+    def run() -> None:
+        try:
+            _n8n(monkeypatch, fifo)
+        except SystemExit as e:
+            out.append(str(e))
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    t.join(BLOCK_CHECK_SECONDS)
+    blocked = t.is_alive()
+    if blocked:
+        os.close(os.open(fifo, os.O_WRONLY | os.O_NONBLOCK))
+        t.join(BLOCK_CHECK_SECONDS)
+    assert not blocked and out and "cannot be read" in out[0]
+
+
+def _fms_main(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, body: bytes, capsys: pytest.CaptureFixture[str]) -> int:
+    monkeypatch.syspath_prepend(str(REPO))
+    from demo_only import fake_model_server as fms
+
+    monkeypatch.setattr(fms, "confine_existing", lambda p, what="": Path(p))
+    monkeypatch.setattr(fms, "make_model_server", lambda **kw: (_ for _ in ()).throw(RuntimeError("reached")))
+    f = _put(tmp_path, body)
+    monkeypatch.setattr(sys, "argv", ["fake_model_server", "--port", "0", "--key-file", str(f)])
+    try:
+        fms.main()
+    except SystemExit as e:
+        assert "refused: --key-file" in capsys.readouterr().err
+        return int(e.code)  # type: ignore[arg-type]
+    except RuntimeError:
+        return 0
+    return -1
+
+
+def test_the_fake_model_server_key_file_uses_the_one_rule_and_exits_2(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    assert _fms_main(monkeypatch, tmp_path, b"k" * 4096, capsys) == 0  # 4096 bytes accepted
+    assert _fms_main(monkeypatch, tmp_path, b"k" * 4097, capsys) == 2  # 4097 refused
+    assert _fms_main(monkeypatch, tmp_path, b"abc", capsys) == 2  # shorter than the minimum
+    assert _fms_main(monkeypatch, tmp_path, KEY.encode() + b"\t", capsys) == 2
+
+
+# ---------------------------------------------------------------- 5: the wrapper has its own name
+def test_the_smtp_wrapper_is_named_for_the_password() -> None:
+    from lead_desk import smtp_provider
+
+    assert hasattr(smtp_provider, "read_smtp_password") and not hasattr(smtp_provider, "read_secret_file")
+
+
+def test_the_mailbox_password_sentence_is_in_the_docs() -> None:
+    text = " ".join((REPO / "docs" / "settings.md").read_text(encoding="utf-8").split())  # said once (r8 file)
+    assert "The mailbox password file follows the SMTP password rule: spaces inside are dropped" in text
+
+
+# ---------------------------------------------------------------- 7: lock wording
+def test_the_lock_sentence_and_exit_4_at_step_12() -> None:
+    text = " ".join((REPO / "contract.md").read_text(encoding="utf-8").split())
+    assert (
+        "is never deleted by the desk: a refusal in any later step (6) to (12), and a normal stop, leave it behind "
+        "(the reset scripts delete it on purpose)" in text
+    )
+    assert "is never deleted: a refusal in steps (6) to (9)" not in text
+    assert re.search(r"\(12\) `Desk.startup\(\)` \(schema and sweep; exit 4 when", text)
+
+
+# ---------------------------------------------------------------- 8: one Retry-After reader at four sites
+HTTP_DATE = formatdate(0, usegmt=True)  # wall-clock: only builds a date text
+BAD_AFTER = ["inf", "-inf", "nan", "1e999", "-1", HTTP_DATE, "", "1_0", "١٢", None]
+
+
+def test_retry_after_seconds_is_finite_and_not_negative() -> None:
+    assert envnum.retry_after_seconds("7") == 7.0 and envnum.retry_after_seconds("0") == 0.0
+    assert envnum.retry_after_seconds(" 1.5 ") == 1.5
+    for bad in BAD_AFTER:
+        assert envnum.retry_after_seconds(bad) is None, bad
+
+
+def test_the_burst_and_load_sites_use_the_one_reader_and_refuse_inf_and_nan() -> None:
+    from demo_only import burst
+    from lead_desk import crm_hubspot, live_claude
+
+    sys.path.insert(0, str(REPO))
+    try:
+        from load_tools import load_driver
+    finally:
+        sys.path.remove(str(REPO))
+    for mod, name in ((crm_hubspot, "_retry_after"), (live_claude, "_retry_after")):
+        assert not hasattr(mod, name), (mod.__name__, name)  # the HTTP-level tests of these two are in the r7 file
+    for fn in (envnum.retry_after_seconds, burst.retry_after_seconds, load_driver._retry_after):
+        for bad in BAD_AFTER:
+            assert fn(bad) is None, (fn, bad)
+        assert fn("2") == 2.0
+    assert burst.retry_after_seconds is envnum.retry_after_seconds
+    assert not math.isinf(burst.next_wait(0.1, envnum.retry_after_seconds("inf"), 5.0))
+
+
+def test_the_load_drivers_stand_alone_copy_gives_the_same_answers() -> None:
+    sys.path.insert(0, str(REPO))
+    try:
+        from load_tools import load_driver
+    finally:
+        sys.path.remove(str(REPO))
+    for text in [*BAD_AFTER, "0", "7", "1.5", " 3 "]:  # the refused shapes (1e2, .5, +4, 5.) are in the r7 file
+        assert load_driver._retry_after_fallback(text) == envnum.retry_after_seconds(text), text
+
+
+# ---------------------------------------------------------------- 14: run_real_check looks at the book once
+def test_run_real_check_looks_at_the_book_path_once() -> None:
+    text = (REPO / "scripts" / "run_real_check.py").read_text(encoding="utf-8")
+    assert text.count("path_kind(db)") == 1
+
+
+def test_the_docs_name_the_outbox_values_where_they_say_which_outbox_reports_a_bad_key_file() -> None:
+    from lead_desk import loader
+
+    assert loader.SMTP_PROVIDER_MODULE and loader.SMTP_MODULE  # premise: both values are loaded by the loader
+    for name in ("contract.md", "docs/limits.md"):
+        text = " ".join((REPO / name).read_text(encoding="utf-8").split())
+        part = "the SMTP provider (`DESK_OUTBOX=smtp_provider`) or the SMTP sender (`DESK_OUTBOX=smtp`) as outbox"
+        assert part in text
+        assert "the SMTP provider or the SMTP sender as outbox" not in text
+
+
+def test_the_old_weak_fake_server_size_test_is_gone() -> None:
+    text = (REPO / "tests" / "test_one_key_file_rule_and_path_walk.py").read_text(encoding="utf-8")
+    assert "test_the_fake_model_server_reads_a_key_file_with_a_size_cap" not in text
