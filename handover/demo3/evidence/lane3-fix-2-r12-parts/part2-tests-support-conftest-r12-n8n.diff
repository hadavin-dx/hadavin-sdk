+def _no_lock_handle_left_open(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
+    """Every lock handle taken through `lockfile.acquire` while a test runs must be closed when the test ends (an open
+    handle keeps the lock file locked for the rest of the test run). A test that runs `server.main()` past the lock
+    step asks for `main_lock_handles_closed`, which closes them first; any other test that leaves one open fails
+    here, naming no path. This is the outer wrapper: it is set up first and checked last."""
+    handles: list[Any] = []
+    real_acquire = lockfile.acquire
+
+    def acquire(db_path: Path | str) -> Any:
+        handle = real_acquire(db_path)
+        handles.append(handle)
+        return handle
+
+    monkeypatch.setattr(lockfile, "acquire", acquire)
+    yield
+    left = [h for h in handles if not h.closed]
+    for handle in left:
+        handle.close()  # give the lock back whatever the verdict
+    assert not left, f"{len(left)} lock handle(s) taken by this test were still open at its end"
+
