+def test_a_key_file_the_system_will_not_open_gives_the_same_message_also_as_root(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """The root twin of the test above: root can open a file with no permissions, so the system's refusal is made
+    by patching `os.open` for the key path only (the real reader, the real import)."""
+    secret = tmp_path / "locked-key.txt"
+    secret.write_text(KEY_TEXT, encoding="utf-8")
+    real = os.open
+
+    def refuse(path: object, *a: object, **k: object) -> int:
+        if str(path) == str(secret):
+            raise PermissionError(13, "made-up refusal")
+        return real(path, *a, **k)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(os, "open", refuse)
+    msg = _key_file_refusal(monkeypatch, secret)
+    assert msg == "the n8n API key file cannot be read"
+    assert KEY_TEXT not in msg and "locked-key" not in msg and "PermissionError" not in msg
+    with pytest.raises(SettingRefused) as direct:
+        envnum.read_secret_file(secret, "n8n API key", "key")
