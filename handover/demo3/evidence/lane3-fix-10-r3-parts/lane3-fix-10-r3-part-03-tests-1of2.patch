+
+@pytest.mark.skipif(WINDOWS, reason="a lone surrogate in the environment is a POSIX case")
+def test_a_path_that_is_not_valid_text_gives_one_line_through_the_helpers(tmp_path: Path) -> None:
+    cases = [([str(SCRIPTS / "reset_check.py")], False), (["start_all.sh"], True), (["reset.sh"], True)]
