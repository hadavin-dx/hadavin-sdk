+def test_a_line_is_stripped_of_control_characters() -> None:
+    from lead_desk.config_exit import plain_line
+
+    line = plain_line("a\x07b\x1b[31mc\u202ed\udc80e\r\nf\tg", {})
+    assert line == "ab[31mcde f g", line
+    assert all(ch.isprintable() for ch in line)
