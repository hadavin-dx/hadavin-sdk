+def test_the_module_prints_standard_input_as_one_plain_line_through_the_formatter(tmp_path: Path) -> None:
+    """`python -m lead_desk.config_exit`: what start_all uses for the last line of desk.log."""
+    env = child_env(DESK_NUDGE_TO="secret-address-qq")
+    done = subprocess.run(  # noqa: S603
+        [sys.executable, "-m", "lead_desk.config_exit"],
+        input="the desk refuses a setting: DESK_PORT x\x1b[2J secret-address-qq\n",
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    assert done.returncode == 0 and done.stderr == ""
+    assert done.stdout == "the desk refuses a setting: DESK_PORT x[2J <value>\n", done.stdout
