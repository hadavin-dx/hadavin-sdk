+def test_list_items_url_user_and_the_ends_of_a_long_value_are_blanked_too() -> None:
+    from lead_desk.config_exit import refusal_line
+
+    items = {"DESK_ALLOWED_HOSTS": "alpha-host.test,beta-host.test"}
+    line = refusal_line("x:", "DESK_ALLOWED_HOSTS has beta-host.test", items)
+    assert "beta-host" not in line and "<value>" in line
+    user, secret = "some-" + "user", "some-" + "pass"
+    url = {"DESK_FAKES_URL": f"http://{user}:{secret}@127.0.0.1:1234/"}
+    line = refusal_line("x:", f"DESK_FAKES_URL cannot use {user} or {secret}", url)
+    assert user not in line and secret not in line
+    long_value = "firstpart-12" + "m" * 20 + "lastpart-123"
+    line = refusal_line("x:", "DESK_REPLIES_PATH broke at firstpart-12", {"DESK_REPLIES_PATH": long_value})
+    assert "firstpart-12" not in line and "<value>" in line
+    line = refusal_line("x:", "DESK_REPLIES_PATH broke at lastpart-123", {"DESK_REPLIES_PATH": long_value})
+    assert "lastpart-123" not in line and "<value>" in line
