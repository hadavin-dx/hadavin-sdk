+# A stand-in `python` for scripts/start_all.sh: it answers the four `python -c` helper calls (data folder, demo-server
+# host, demo-server port, desk port) with fixed values, writes one line per `python -m <module>` launch with the
+# DESK_LEADFLOW_FILE and DESK_NUDGE_TO it saw, and records every call, so the test sees what the shell [[ ]] tests
+# decided without starting a server. The stand-in desk prints the listening line, as the real desk does, so start_all.sh
+# sees it start.
 _STUB_PYTHON = """#!/usr/bin/env bash
 echo "$*" >> "${STUB_DATA}/calls.log"
 if [[ "$1" == "-c" ]]; then
   case "$2" in
     *parent*) echo "${STUB_DATA}";;
-    *fakes_port*) echo 1234;;
+    *fakes_host*) echo 127.0.0.1;;
+    *fakes_port*) echo "${STUB_FAKES_PORT}";;
     *.port*) echo 4321;;
   esac
 elif [[ "$1" == "-m" ]]; then
