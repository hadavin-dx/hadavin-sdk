+# The meaning of each code, written once. A program's row below uses one of these texts; the same text in two programs
+# is one meaning (start_all passes the desk's own codes on), different texts behind one number are the overlap named in
+# SAME_NUMBER_DIFFERENT_MEANING.
+MEANING_ADAPTERS_UNREACHABLE: Final = "the demo server (the sender) cannot be reached, or a Python traceback"
+MEANING_ANOTHER_DESK: Final = "another desk holds the lock file"
+MEANING_OPEN_FILE_LIMIT: Final = "the open-file limit is too low"
+MEANING_DESK_SETTING_REFUSED: Final = "the desk refused a setting"
+MEANING_PORT_UNAVAILABLE: Final = "the port could not be bound"
+MEANING_SIMULATED_KILL: Final = "the crash script ended the desk on purpose"
+MEANING_SCRIPT_SETTING_REFUSED: Final = "a setting was refused while a script read it"
+MEANING_START_NOT_DONE: Final = (
+    "the start did not complete: a bad mode, pid files exist, the demo server or the desk was not ready in time, "
+    "or the desk ended with a code this table does not pass on"
+)
+MEANING_NOT_BASH: Final = "refused: the script was run by a shell that is not bash"
+MEANING_RESET_REFUSED: Final = "refused before anything was stopped or deleted"
+MEANING_RESET_HELD: Final = "a process still holds the database, or the lock file cannot be tested"
+MEANING_RESET_ANSWERING: Final = "something still answers on a port"
+MEANING_RESET_NOT_STOPPED: Final = "a process did not stop in time"
+MEANING_RESET_WRONG_PROGRAM: Final = "a pid file names another program"
+MEANING_CHECK_STOPPED: Final = (
+    "the check was stopped before anything was called (the Start question was not answered yes)"
+)
+MEANING_CHECK_REFUSED: Final = "the check refused its config or its question before anything real was called"
+MEANING_CHECK_FAILED: Final = "the check ran and found a failure, or its read-back stopped"
+
+# THE table of process exit codes: (program, code, meaning). The program is the one thing that has a code; inside a
+# program a code has ONE meaning. tests/test_exit_code_table.py checks that, that every code a program really returns is
+# one of its rows, that every EXIT_ constant is listed, and that SAME_NUMBER_DIFFERENT_MEANING equals the overlap
+# computed from this table. Programs: "server" is `python -m lead_desk.server`; "crash_desk", "feed", "reset_check" and
+# "run_real_check" are scripts/*.py; "reset.sh", "reset.ps1", "start_all.sh", "start_all.ps1" are the shell scripts.
+# crash_desk calls the desk's own main, so it also returns the desk's codes. start_all passes on 3, 4 and 5 of the
+# desk it started and gives every other desk code (and 0, a desk that ended at once) as its own 1.
+_DESK_ROWS: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_ADAPTERS_UNREACHABLE, MEANING_ADAPTERS_UNREACHABLE),
+    (EXIT_ANOTHER_DESK, MEANING_ANOTHER_DESK),
+    (EXIT_OPEN_FILE_LIMIT, MEANING_OPEN_FILE_LIMIT),
+    (EXIT_DESK_SETTING_REFUSED, MEANING_DESK_SETTING_REFUSED),
+    (EXIT_PORT_UNAVAILABLE, MEANING_PORT_UNAVAILABLE),
+)
+_PASSED_ON: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_OPEN_FILE_LIMIT, MEANING_OPEN_FILE_LIMIT),
+    (EXIT_DESK_SETTING_REFUSED, MEANING_DESK_SETTING_REFUSED),
+    (EXIT_PORT_UNAVAILABLE, MEANING_PORT_UNAVAILABLE),
+)
+_RESET_ROWS: Final[tuple[tuple[int, str], ...]] = (
+    (EXIT_RESET_REFUSED, MEANING_RESET_REFUSED),
+    (EXIT_RESET_HELD, MEANING_RESET_HELD),
+    (EXIT_RESET_ANSWERING, MEANING_RESET_ANSWERING),
+    (EXIT_RESET_NOT_STOPPED, MEANING_RESET_NOT_STOPPED),
+    (EXIT_RESET_WRONG_PROGRAM, MEANING_RESET_WRONG_PROGRAM),
+    (EXIT_SCRIPT_SETTING_REFUSED, MEANING_SCRIPT_SETTING_REFUSED),
+)
+_SETTING_ROW: Final = (EXIT_SCRIPT_SETTING_REFUSED, MEANING_SCRIPT_SETTING_REFUSED)
+EXIT_CODE_TABLE: Final[tuple[tuple[str, int, str], ...]] = (
+    *(("server", code, meaning) for code, meaning in _DESK_ROWS),
+    *(("crash_desk", code, meaning) for code, meaning in (*_DESK_ROWS, _SETTING_ROW)),
+    ("crash_desk", EXIT_SIMULATED_KILL, MEANING_SIMULATED_KILL),
+    ("feed", *_SETTING_ROW),
+    *(("reset.sh", code, meaning) for code, meaning in _RESET_ROWS),
+    *(("reset.ps1", code, meaning) for code, meaning in _RESET_ROWS),
+    ("reset_check", EXIT_RESET_HELD, MEANING_RESET_HELD),
+    ("reset_check", EXIT_RESET_ANSWERING, MEANING_RESET_ANSWERING),
+    ("reset_check", *_SETTING_ROW),
+    ("start_all.sh", EXIT_START_NOT_DONE, MEANING_START_NOT_DONE),
+    ("start_all.sh", EXIT_NOT_BASH, MEANING_NOT_BASH),
+    *(("start_all.sh", code, meaning) for code, meaning in (*_PASSED_ON, _SETTING_ROW)),
+    ("start_all.ps1", EXIT_START_NOT_DONE, MEANING_START_NOT_DONE),
+    *(("start_all.ps1", code, meaning) for code, meaning in (*_PASSED_ON, _SETTING_ROW)),
+    ("run_real_check", EXIT_CHECK_STOPPED, MEANING_CHECK_STOPPED),
+    ("run_real_check", EXIT_CHECK_REFUSED, MEANING_CHECK_REFUSED),
+    ("run_real_check", EXIT_CHECK_FAILED, MEANING_CHECK_FAILED),
+    ("run_real_check", *_SETTING_ROW),
+)
+
+# The numbers that mean different things in different programs, pinned by name (tests/test_exit_code_table.py computes
+# the overlap from the table and compares). A person reads a number together with the program that returned it.
+SAME_NUMBER_DIFFERENT_MEANING: Final[tuple[int, ...]] = (1, 2, 3, 4, 5)
+
+# The same cause, a refused DESK_* setting, and the number each program returns for it. A program that reads the
+# settings by itself returns 8 (the reader, lead_desk.config_exit); the desk keeps its own 4 because 2 to 6 already mean
