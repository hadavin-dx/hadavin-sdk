     -PassThru -WindowStyle Hidden -RedirectStandardOutput "$dataDir\desk.log" -RedirectStandardError "$dataDir\desk.err.log"
+$null = $desk.Handle  # keeps the process handle, so that ExitCode can be read after the process ended (Windows PowerShell 5.1)
 $desk.Id | Set-Content "$dataDir\desk.pid"
+# Then wait (inside the same budget) until the desk says it is listening. A desk that ends first is reported as it is (its
+# last log line and its own exit code), what this script started is stopped again, and "started" is never printed for it.
+$ready = $false
+while ($ticks -lt $maxTicks) {
+    if ((Test-Path "$dataDir\desk.log") -and (Select-String -Path "$dataDir\desk.log" -Pattern '^desk listening on ' -Quiet -ErrorAction SilentlyContinue)) { $ready = $true; break }
+    if ($desk.HasExited) { break }
+    Start-Sleep -Milliseconds 200
+    $ticks++
+}
+if (-not $ready) {
+    if (-not $desk.HasExited) {
+        [Console]::Error.WriteLine("desk not ready after $waitSeconds seconds (it may still be starting); see $dataDir\desk.log; run scripts\reset.ps1 to stop it")
+        exit 1
+    }
+    $desk.WaitForExit()
+    $deskCode = $desk.ExitCode
+    if ($null -eq $deskCode -or $deskCode -isnot [int]) { $deskCode = 1 }  # an exit code that cannot be read is never a success
+    $last = ''
+    foreach ($f in "$dataDir\desk.log", "$dataDir\desk.err.log") {
+        if (Test-Path $f) { $l = Get-Content $f -ErrorAction SilentlyContinue | Where-Object { $_.Trim() } | Select-Object -Last 1; if ($l) { $last = $l; break } }
+    }
+    # the last line goes through the one formatter: one plain line, no control characters, no setting value
+    $plain = ($last | & python -m lead_desk.config_exit 2>$null)
+    if ($LASTEXITCODE -ne 0 -or -not $plain) { $plain = '(the log line could not be read)' }
+    [Console]::Error.WriteLine("the desk ended at once (exit $deskCode): $plain")
+    Stop-Process -Id $fakes.Id -ErrorAction SilentlyContinue
+    Remove-Item -Force "$dataDir\fakes.pid", "$dataDir\desk.pid" -ErrorAction SilentlyContinue
+    # the desk's own 3, 4 and 5 are passed on; every other end (including a desk that stopped with 0) is this script's 1
+    if ($deskCode -in 3, 4, 5) { exit $deskCode }
+    exit 1
+}
 Write-Host "started: demo servers ($Mode outbox) pid $($fakes.Id), desk pid $($desk.Id)"
-$deskPort = (python -c "from lead_desk.config import Config; print(Config.from_env().port)").Trim()
+$deskPort = Read-DeskSetting 'config_or_exit().port'
