+"""Facts in README.md, docs/limits.md and docs/n8n-recipe.md that earlier review readers found wrong or missing.
+
+How the tests work. Where a fact can be read from the code, the workflow files or a real desk, the test reads it there
+and then checks that the text states it. The text checks pin FACTS (numbers, field names, command names, file names)
+by regular expression, not the exact wording, so a rewrite in better words does not fail them but a wrong number does.
+Every assert on document text carries a message that starts with "this sentence protects:" and says which fact to keep
+if you reword the sentence. Asserts on code or files (tests named `premise_` and asserts whose message starts with
+"premise:") check that a file still has the shape the text relies on; they read files, not the text.
+No demo servers and no n8n are needed: the real desk is started as a child program against an in-process stand-in
+for the demo servers, on a free port, with made-up data only."""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import HOST, call, child_env, free_port, post_lead, start_proc, stop_proc, wait_until
+
+from demo_only import burst
+
+REPO = Path(__file__).resolve().parents[1]
+FIVE = ("received", "new", "duplicate", "review", "open")
+FIVE_NAMED = r"`received`, `new`, `duplicate`, `review` and `open`"
+
+
+def _p(what: str) -> str:
+    return f"this sentence protects: {what} (if you reword the sentence, keep this fact)"
+
+
+def _read(rel: str) -> str:
+    return (REPO / rel).read_text(encoding="utf-8")
+
+
+def _line_with(text: str, start: str) -> str:
+    lines = [ln for ln in text.splitlines() if ln.lstrip().startswith(start)]
+    assert len(lines) == 1, f"premise: exactly one line starts with {start!r}, found {len(lines)}"
+    return lines[0]
+
+
+def _flat(text: str) -> str:
+    return " ".join(text.split())
+
+
+def _between(text: str, start: str, end: str) -> str:
+    """The part of `text` from the line starting with `start` up to (not including) the line starting with `end`."""
+    lines = text.splitlines()
+    first = next(i for i, ln in enumerate(lines) if ln.lstrip().startswith(start))
+    last = next(i for i, ln in enumerate(lines) if i > first and ln.lstrip().startswith(end))
+    return _flat("\n".join(lines[first:last]))
+
+
+# ---- limits.md: exit code 1 names what the desk really prints ----
+
+
+def test_exit_code_1_uses_the_words_the_desk_prints(tmp_path: Path) -> None:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}  # nothing of the tester's own settings
+    env["PYTHONPATH"] = os.pathsep.join([str(REPO / "src"), str(REPO)])
+    env.update(
+        DESK_PORT=str(free_port()),
+        DESK_FAKES_PORT=str(free_port()),  # nothing listens here: the demo servers are "not running"
+        DESK_DB_PATH=str(tmp_path / "data" / "desk.db"),
+    )
+    done = subprocess.run(  # noqa: S603 - our own interpreter and module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        cwd=tmp_path,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    if done.returncode == 3:  # the desk checks the open-file limit first (containers often allow only 4096)
+        pytest.skip(f"this computer's open-file limit is too low for the desk (exit 3): {done.stdout.strip()[-200:]}")
+    lines = done.stdout.strip().splitlines()
+    assert lines, f"premise: the desk printed nothing (exit {done.returncode}, error output: {done.stderr[-200:]!r})"
+    printed = lines[-1]
+    assert done.returncode == 1, f"premise: exit code 1 means the demo servers cannot be reached: {done.returncode}"
+    phrase = printed.split(" (")[0]  # "cannot reach the demo servers"
+    assert phrase.startswith("cannot reach the demo servers"), f"premise: the desk prints this phrase: {printed}"
+    bullet = _flat(_line_with(_read("docs/limits.md"), "* Exit codes:"))
+    assert phrase in bullet, _p("limits.md quotes the words the desk prints for exit code 1")
+    assert "the sender cannot be reached" not in bullet, _p("the old word 'sender' for the demo servers is gone")
+    assert re.search(r"traceback.*program fault, or that someone edited a fixed value", bullet), _p(
+        "a traceback is a program fault OR an edited fixed value"
+    )
+    assert re.search(r"never caused by a `DESK_\*` setting[^;]*exit code 4", bullet), _p(
+        "a traceback is never caused by a DESK_* setting: a bad DESK_* value gives exit code 4"
+    )
+    assert "src/lead_desk/constants.py" in bullet and (REPO / "src/lead_desk/constants.py").exists(), _p(
+        "the edited fixed value lives in src/lead_desk/constants.py"
+    )
+    assert re.search(r"real CRM or a real mail sender[^.]*not described here", bullet), _p(
+        "what the desk prints for an unreachable real CRM or mail sender is not described (not claimed)"
+    )
+    assert "constant that is out of range" not in bullet, _p("no unexplained 'constant that is out of range'")
+
