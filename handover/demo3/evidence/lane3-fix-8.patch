diff --git a/tests/test_domain_labels.py b/tests/test_domain_labels.py
new file mode 100644
index 0000000..6a491c2
--- /dev/null
+++ b/tests/test_domain_labels.py
@@ -0,0 +1,142 @@
+"""A domain whose labels are not well formed is not a mailbox: it starts with a dot, ends with a dot, has two dots in
+a row, or has a label that starts or ends with a hyphen. Such a lead email goes to review (never a lead of its own,
+never a follow-up mail); the same rule guards the sender, recipient and reminder addresses. Made-up data only."""
+
+from __future__ import annotations
+
+import random
+from pathlib import Path
+
+import pytest
+from support import lead
+
+from lead_desk import identity
+from lead_desk.config import Config, SettingRefused
+from lead_desk.contract import SendRefused
+from lead_desk.smtp_outbox import SmtpOutbox, SmtpSettings
+
+AT = "@"  # a fake address is built from parts (the hygiene scan reads every address-shaped text)
+DOTS = ("。", "．", "｡")  # the dots that internationalised domain names also read as a dot
+
+BAD_DOMAINS = [
+    ".dom.test",  # starts with a dot
+    "a..b.test",  # two dots in a row (an empty label)
+    "a.b..test",
+    "example.test.",  # ends with a dot (the earlier rule)
+    "example.test..",
+    "..test",
+    "-a.test",  # label starts with a hyphen
+    "a-.test",  # label ends with a hyphen
+    "a.-b.test",
+    "a.b-.test",
+    "a.test-",
+    "a.-",
+    "example" + DOTS[0] + DOTS[0] + "test",
+    "a" + DOTS[1] + DOTS[1] + "test.test",
+    DOTS[2] + "example.test",
+    "example.test" + DOTS[0],
+]
+GOOD_DOMAINS = [
+    "example.test",
+    "a.b",
+    "sub-domain.example.test",
+    "a-b-c.d-e.test",
+    "1-2.test",
+    "xn--bcher-kva.example",
+    "bücher.example",
+    "a" + "." + "b" + "." + "c",
+]
+
+
+def verdict(domain: str, local: str = "loc") -> identity.Checked:
+    return identity.check_payload({"name": "N", "email": f"{local}@{domain}"})
+
+
+@pytest.mark.parametrize("domain", BAD_DOMAINS)
+def test_badly_shaped_domain_goes_to_review(domain: str) -> None:
+    chk = verdict(domain)
+    assert (chk.kind, chk.reason, chk.email_key) == ("review", "invalid_email", None), domain
+
+
+@pytest.mark.parametrize("domain", GOOD_DOMAINS)
+def test_well_shaped_domain_stays_valid(domain: str) -> None:
+    assert verdict(domain).kind == "ok", domain
+
+
+def _labels(domain: str) -> list[str]:
+    out = [domain]
+    for dot in (".", *DOTS):  # an independent way to split: replace every dot by one marker, then split on it
+        out = [part for piece in out for part in piece.split(dot)]
+    return out
+
+
+def test_no_accepted_address_has_an_empty_label_or_a_hyphen_at_a_label_end() -> None:
+    """Fixed-seed fuzz over generated domains: whatever the check accepts has only well-formed labels."""
+    rng = random.Random(8)
+    pieces = ["a", "b", "x1", "-", ".", ".", "..", "-.", ".-", "a-b", "。", "．", "xn--k", "test"]
+    accepted = rejected = 0
+    for _ in range(20000):
+        domain = "".join(rng.choice(pieces) for _ in range(rng.randint(1, 7)))
+        chk = verdict(domain)
+        labels = _labels(domain)
+        well_formed = all(lb and not lb.startswith("-") and not lb.endswith("-") for lb in labels)
+        if chk.kind == "ok":
+            accepted += 1
+            assert well_formed, f"accepted {domain!r}"
+            assert "." in domain  # the earlier rule stays: a dot in the domain
+        else:
+            rejected += 1
+            assert chk.reason == "invalid_email"
+    assert accepted > 100 and rejected > 5000, (accepted, rejected)  # the fuzz exercises both sides
+
+
+def test_domain_labels_ok_edges() -> None:
+    assert identity.domain_labels_ok("localhost")  # a one-label host name (a sender may be desk@localhost)
+    assert identity.domain_labels_ok("[::1]") and identity.domain_labels_ok("[127.0.0.1]")
+    assert not identity.domain_labels_ok("") and not identity.domain_labels_ok(".")
+    assert not identity.domain_labels_ok("localhost.") and not identity.domain_labels_ok("-localhost")
+
+
+@pytest.mark.parametrize("domain", [".dom.test", "a..b.test", "example.test.", "-a.test", "a-.test"])
+def test_dotted_domain_lead_is_reviewed_and_makes_nothing(env, domain: str) -> None:
+    """Real desk: 202 review, no lead row, no follow-up row, no mail, no qualifier call."""
+    rig = env.rig()
+    r = rig.desk.handle("form", "dom-1", lead(email=f"loc@{domain}"))
+    assert (r.status, r.body["verdict"], r.body["reason"]) == (202, "review", "invalid_email"), r.body
+    assert "lead_id" not in r.body
+    assert rig.leads() == 0
+    assert rig.query("SELECT count(*) FROM followups")[0][0] == 0
+    assert rig.outbox.count == 0
+    assert rig.qualifier.calls == 0
+    ok = rig.desk.handle("form", "dom-2", lead(email="loc@example.test"))  # the desk still takes a good one
+    assert ok.status == 201 and rig.leads() == 1
+
+
+@pytest.mark.parametrize("bad", [f"desk{AT}{d}" for d in (".example.test", "a..test", "example.test.", "-a.test")])
+def test_sender_recipient_and_reminder_addresses_use_the_same_rule(bad: str) -> None:
+    assert not identity.plain_address_ok(bad)
+    with pytest.raises(SettingRefused):
+        SmtpSettings(mail_from=bad)
+    with pytest.raises(SendRefused, match="plain address"):  # refused before any network use
+        SmtpOutbox(SmtpSettings()).send("k" * 8, bad, "subject", "body", 1.0)
+    with pytest.raises(SettingRefused, match="plain address"):
+        Config(leadflow_path=Path("x.json"), nudge_to=bad)
+
+
+def test_plain_address_ok_keeps_good_addresses() -> None:
+    for good in ("desk@example.test", "reminder@localhost", "o'brien@a-b.example.test"):
+        assert identity.plain_address_ok(good), good
+
+
+@pytest.mark.parametrize("bad", [f"desk{AT}{d}" for d in (".example.test", "a..test", "example.test.", "-a.test")])
+def test_provider_sender_and_recipients_use_the_same_rule(bad: str) -> None:
+    from lead_desk.smtp_provider import ProviderSettings, SmtpProviderOutbox
+
+    good = "a@example.test"
+    with pytest.raises(SettingRefused, match="plain ASCII addresses"):
+        ProviderSettings("h", 587, "u", Path("p"), bad, (good,), 1)
+    with pytest.raises(SettingRefused, match="plain ASCII addresses"):
+        ProviderSettings("h", 587, "u", Path("p"), good, (good, bad), 1)
+    ob = SmtpProviderOutbox(ProviderSettings("h", 587, "u", Path("p"), good, (good,), 1))
+    with pytest.raises(SendRefused, match="plain address"):  # refused before the password file is read
+        ob.send("k" * 8, bad, "subject", "body", 1.0)
