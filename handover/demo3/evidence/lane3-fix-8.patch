diff --git a/src/lead_desk/identity.py b/src/lead_desk/identity.py
index 035c8e7..c2b931d 100644
--- a/src/lead_desk/identity.py
+++ b/src/lead_desk/identity.py
@@ -18,6 +18,9 @@ PLAIN_ADDRESS = re.compile(r'^[^\s<>\r\n\x00,;"()][^\s<>\r\n\x00,;"()@]*@[^\s<>\
 # local part, "@", then a domain that has a dot with a character before it and one after it: one character, characters
 # that are not dots, the first dot, one or more characters (the dot is found once, not by backtracking)
 _EMAIL_RE = re.compile(r"^[^@\s<>\",;]+@[^@\s<>\"',;][^@\s<>\"',;.]*\.[^@\s<>\"',;]+$")
+# the characters that end a label of a domain name: the dot and the three dots that internationalised domain names
+# also read as a dot (U+3002 ideographic full stop, U+FF0E fullwidth full stop, U+FF61 halfwidth ideographic full stop)
+_LABEL_DOTS = re.compile("[.\u3002\uff0e\uff61]")
 _CONTROL_OK_IN_MESSAGE = frozenset("\t\n\r")
 _FIELD_LIMITS: tuple[tuple[str, int | None], ...] = (  # fixed order; email has no length rule here (its rule is below)
     ("name", NAME_MAX),
@@ -87,13 +90,27 @@ def _lower_keeps_ascii_apart(e: str) -> bool:
     return not any(not c.isascii() and any(x.isascii() for x in c.lower()) for c in e)
 
 
+def domain_labels_ok(domain: str) -> bool:
+    """True when every label of the domain (the parts between dots) has at least one character and neither starts nor
+    ends with a hyphen. So a domain that starts with a dot, ends with a dot or has two dots in a row, and a label such
+    as "-a" or "a-", is not a mailbox domain (RFC 1035 section 2.3.1, RFC 5321 section 4.1.2). This is the one place
+    that rule lives: the lead email check and the plain-address check of the sender, the recipient and the reminder
+    address all call it."""
+    return all(label and not label.startswith("-") and not label.endswith("-") for label in _LABEL_DOTS.split(domain))
+
+
+def plain_address_ok(s: str) -> bool:
+    """One plain address (PLAIN_ADDRESS) whose domain has well-formed labels."""
+    return PLAIN_ADDRESS.fullmatch(s) is not None and domain_labels_ok(s.rpartition("@")[2])
+
+
 def _valid_email(e: str) -> bool:
     return (
         _lower_keeps_ascii_apart(e)
         and len(e) <= EMAIL_MAX
         and len(normalise_email(e)) <= EMAIL_MAX  # lower case can be longer (some letters become two characters)
         and _EMAIL_RE.fullmatch(e) is not None
-        and not e.endswith(".")
+        and domain_labels_ok(e.rpartition("@")[2])  # also refuses a trailing dot (an empty last label)
         and not any(unicodedata.category(c).startswith("C") for c in e)
     )
 
