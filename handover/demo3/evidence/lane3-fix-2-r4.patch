+    code = inspect.getsource(server.main)
+    in_code = [
+        code.index(m)
+        for m in (
+            "Config.from_env()",
+            "book_problem(",
+            "mkdir(",
+            "lockfile.acquire(",
+            "load_approvers(",
+            "read_leadflow(",
+            "load_demo_adapters(",
+            "check_secret_files(",
+            "Desk(config",
