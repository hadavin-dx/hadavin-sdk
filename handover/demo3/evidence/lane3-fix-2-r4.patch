+    return HubspotSettings.from_env({**_hubspot(f), "DESK_HUBSPOT_ALLOW_ANY_BASE_URL": "ys"})
+
+
+def _live_bad_word(f: Path, t: Path) -> object:
+    return Config.from_env({**_live(f, t), "DESK_QUALIFIER": "live_claude", "DESK_LIVE_ALLOW_ANY_BASE_URL": "ys"})
+
+
+@pytest.mark.parametrize(
+    ("make", "name"),
+    [(_hubspot_bad_word, "DESK_HUBSPOT_ALLOW_ANY_BASE_URL"), (_live_bad_word, "DESK_LIVE_ALLOW_ANY_BASE_URL")],
+    ids=["hubspot", "live"],
+)
+def test_a_yes_no_setting_with_another_word_is_refused_not_read_as_no(tmp_path: Path, make: Any, name: str) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    with pytest.raises(SettingRefused) as info:
+        make(f, tmp_path)
+    assert str(info.value) == f"{name} must be yes or no"  # the word typed is not echoed
+
+
+# REGRESSION GUARD: passes on the earlier tree too, by design (pins behaviour that must not change)
+@pytest.mark.parametrize("word", ["yes", "YES", " yes ", "no", "No", ""])
+def test_yes_no_words_that_are_accepted(word: str) -> None:
+    assert env_yes_no({"X": word}, "X") is (word.strip().lower() == "yes")
+    assert env_yes_no({}, "X") is False
+
