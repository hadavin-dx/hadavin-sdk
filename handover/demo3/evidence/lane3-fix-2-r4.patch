+def test_a_stats_file_or_ledger_that_is_a_folder_is_refused(tmp_path: Path) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    d = tmp_path / "adir"
+    d.mkdir()
+    with pytest.raises(SettingRefused, match="DESK_HUBSPOT_STATS_FILE names a folder"):
+        HubspotSettings.from_env({**_hubspot(f), "DESK_HUBSPOT_STATS_FILE": str(d)})
+    with pytest.raises(SettingRefused, match="DESK_SMTPP_STATS_FILE names a folder"):
+        ProviderSettings.from_env({**_provider(f), "DESK_SMTPP_STATS_FILE": str(d)})
+    with pytest.raises(SettingRefused, match="DESK_LIVE_LEDGER_PATH names a folder"):
+        Config.from_env({**_live(f, tmp_path), "DESK_QUALIFIER": "live_claude", "DESK_LIVE_LEDGER_PATH": str(d)})
+
+
+@pytest.mark.parametrize("state", ["missing", "not-a-certificate"])
+def test_a_ca_file_that_cannot_be_read_is_refused_with_no_traceback_and_no_path(tmp_path: Path, state: str) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    ca = tmp_path / "ca-file.pem"
+    if state != "missing":
+        ca.write_text("this is no certificate\n", encoding="utf-8")
+    env = {**_provider(f), "DESK_SMTPP_CA_FILE": str(ca)}
+    with pytest.raises(SettingRefused) as info:
+        SmtpProviderOutbox(ProviderSettings.from_env(env))
+    assert str(info.value) == "DESK_SMTPP_CA_FILE is not a readable certificate file"
