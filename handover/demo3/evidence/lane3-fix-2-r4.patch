+"""A bad setting stops the start (docs/settings.md, line 3): exit code 4, the setting named, no traceback, and never a
+path, key or password in the text. Cases found by a cold reader who followed the documents literally: a DESK_BIND
+that is no address, an empty or unmakeable DESK_DB_PATH, a broken or missing DESK_REPLIES_PATH file, and key or
+password files that were not looked at until the first call. Made-up data; key files hold made-up text."""
+
+from __future__ import annotations
+
+import errno
+import importlib
+import os
+import re
+import subprocess
+import sys
+import threading
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
