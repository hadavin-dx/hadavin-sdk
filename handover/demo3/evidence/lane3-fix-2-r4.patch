+def test_no_source_file_probes_a_setting_path_with_the_raising_stdlib_calls() -> None:
+    """Path.is_dir()/is_file()/exists() and os.path.exists/isdir raise PermissionError on Python 3.12 and later;
+    resolve(strict=True) raises on a loop. Only `envnum.path_kind` looks at a setting path. Allowed: `portal_api.py`
+    (its one fixed folder of the portal's own pages) and the words in `envnum.py`'s own explanation."""
+    pattern = re.compile(r"\.is_dir\(|\.exists\(|\.is_file\(|os\.path\.exists\(|os\.path\.isdir\(|resolve\(strict=True")
+    hits: dict[str, int] = {}
+    for p in sorted(SRC.glob("*.py")):
+        if p.name in ("portal_api.py", "envnum.py"):
+            continue
+        found = pattern.findall(p.read_text(encoding="utf-8"))
+        if found:
+            hits[p.name] = len(found)
+    assert hits == {}, hits
