+"""Fix-2 round 6: one line-end rule for every secret file, one reader outside envnum nowhere, one Retry-After reader,
+finite spending caps, one word "lead-book". Made-up data only; fake keys are built from parts."""
+
+from __future__ import annotations
+
+import ast
+import importlib
+import math
+import os
+import re
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+
+from lead_desk import envnum, server
+from lead_desk.envnum import SettingRefused
+
+SRC = Path(server.__file__).parent
+REPO = SRC.parents[1]
+KEY = "made" + "-up-" + "key-" + "0123456789"
+ODD = {
+    "tab": "\t",
+    "no-break-space": " ",
+    "ideographic-space": "　",
+    "file-separator": "\x1c",
+    "unit-separator": "\x1f",
+    "next-line": "\x85",
+    "vertical-tab": "\x0b",
+    "form-feed": "\x0c",
+}
+
+
+def _put(tmp_path: Path, body: bytes) -> Path:
+    f = tmp_path / "secret-file.txt"
+    f.write_bytes(body)
+    return f
+
+
+# ---------------------------------------------------------------- 1: the one line-end rule, at every position
+@pytest.mark.parametrize("name", sorted(ODD))
+@pytest.mark.parametrize("where", ["start", "middle", "end"])
+@pytest.mark.parametrize("inner", [False, True])
+def test_any_blank_but_the_line_end_at_the_end_of_the_file_is_refused(
+    tmp_path: Path, name: str, where: str, inner: bool
+) -> None:
+    ch = ODD[name]
+    text = {"start": ch + KEY, "middle": KEY[:6] + ch + KEY[6:], "end": KEY + ch}[where]
+    with pytest.raises(SettingRefused) as info:
+        envnum.read_secret_file(_put(tmp_path, text.encode()), "made-up key", "key", strip_inner_space=inner)
+    assert KEY not in str(info.value) and os.sep not in str(info.value)
+
+
+@pytest.mark.parametrize("where", ["start", "middle", "end"])
+def test_a_plain_space_is_refused_for_a_key_and_dropped_for_the_password(tmp_path: Path, where: str) -> None:
+    text = {"start": " " + KEY, "middle": KEY[:6] + " " + KEY[6:], "end": KEY + " "}[where]
+    f = _put(tmp_path, text.encode())
+    with pytest.raises(SettingRefused, match="must not hold a space"):
+        envnum.read_secret_file(f, "made-up key", "key")
+    assert envnum.read_secret_file(f, "made-up password", "password", strip_inner_space=True) == KEY
+
+
+@pytest.mark.parametrize(
+    ("body", "ok"),
