+def test_contract_start_up_order_is_the_order_of_the_calls_in_server_main() -> None:
+    """The doc test for the start-up order: contract.md lists the steps in the order `server.main` runs them."""
+    import inspect
+
+    code = inspect.getsource(server.main)
+    in_code = [
+        code.index(m)
+        for m in (
+            "Config.from_env()",
+            "book_problem(",
+            "mkdir(",
+            "lockfile.acquire(",
+            "load_approvers(",
+            "read_leadflow(",
+            "load_demo_adapters(",
+            "check_secret_files(",
+            "Desk(config",
+            "make_server(",
+        )
+    ]
+    assert in_code == sorted(in_code)
+    text = (Path(server.__file__).parents[2] / "contract.md").read_text(encoding="utf-8")
+    steps = {int(n): body for n, body in re.findall(r"^\* \((\d+)\) (.*)$", text, flags=re.M)}
+    assert sorted(steps) == list(range(1, 14)), sorted(steps)
+    order = [
+        (2, "settings are read and checked"),
+        (3, "desk.book_problem"),
+        (4, "folder of the lead-book file is made"),
+        (5, "lock file"),
+        (6, "approvers file"),
+        (7, "demo adapters are loaded"),
+        (8, "`Desk` is built"),
+        (9, "The bind"),
+    ]
+    for number, words in order:
+        assert words in steps[number], (number, words)
+    assert "check_secret_files" in steps[7] and "exit 2" in steps[5]
+
