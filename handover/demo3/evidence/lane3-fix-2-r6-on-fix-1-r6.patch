+    assert out == f"the desk refuses to start: {BOOK_UNREADABLE_PROBLEM}\n", out
+    assert str(locked) not in out and "Traceback" not in out
+    monkeypatch.undo()  # the pretend lock is lifted: now look for a lock file (a refusal must leave none)
+    assert not list(locked.rglob("*.lock"))
