+def _reader_calls(tree: ast.AST) -> list[int]:
+    found: list[int] = []
+    for fn in ast.walk(tree):
+        if not isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            continue
+        names = {n.id for n in ast.walk(fn) if isinstance(n, ast.Name)} | {
+            n.value for n in ast.walk(fn) if isinstance(n, ast.Constant) and isinstance(n.value, str)
+        }
+        if not (SECRET_NAME.search(fn.name) or any(SECRET_NAME.search(x) for x in names)):
+            continue
+        for c in ast.walk(fn):
+            if isinstance(c, ast.Call):
+                f = c.func
+                if (isinstance(f, ast.Attribute) and f.attr in READERS) or (isinstance(f, ast.Name) and f.id == "open"):
+                    found.append(c.lineno)
+    return found
+
