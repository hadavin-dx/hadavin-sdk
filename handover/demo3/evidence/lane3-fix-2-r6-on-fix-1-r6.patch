+def _kinds(f: Path, tmp_path: Path) -> dict[str, Any]:
+    hs = HubspotSettings.from_env({k: v for k, v in _hubspot(f).items() if k != "DESK_CRM"})
+    pv = ProviderSettings.from_env({k: v for k, v in _provider(f).items() if k != "DESK_OUTBOX"})
+    lv = Config.from_env({**_live(f, tmp_path), "DESK_QUALIFIER": "live_claude"}).live
+    assert lv is not None
+    return {"hubspot": HubspotCrm(hs), "provider": SmtpProviderOutbox(pv), "live": LiveQualifier(lv)}
+
+
+@pytest.mark.parametrize("kind", ["hubspot", "provider", "live"])
+def test_the_three_kinds_that_hold_a_secret_file_have_the_hook(tmp_path: Path, kind: str) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    assert isinstance(_kinds(f, tmp_path)[kind], StartCheck)
+
+
+@pytest.mark.parametrize("state", ["missing", "directory", "short", "utf16", "several-lines", "oversize", "not-utf8"])
+@pytest.mark.parametrize("kind", ["hubspot", "provider", "live"])
+def test_no_failing_key_state_puts_a_path_a_file_name_or_key_text_in_the_message(
+    tmp_path: Path, kind: str, state: str
+) -> None:
+    f = tmp_path / "very-private-file-name.txt"
+    secret_text = "SECRET" + "-text-" + "1234"
+    if state == "directory":
+        f.mkdir()
+    elif state == "short":
+        f.write_text("abc\n", encoding="utf-8")
+    elif state == "utf16":
+        f.write_bytes(b"\xff\xfe" + secret_text.encode("utf-16-le"))
+    elif state == "several-lines":
+        f.write_text(secret_text + "\n" + secret_text + "\n", encoding="utf-8")
+    elif state == "oversize":
+        f.write_text(secret_text * 5000, encoding="utf-8")
+    elif state == "not-utf8":
+        f.write_bytes(b"\xc3\x28" + secret_text.encode())
+    obj = _kinds(f, tmp_path)[kind]
+    with pytest.raises(SettingRefused) as info:  # the three kinds read a key file by one rule: every state is refused
+        obj.check_start()
+    msg = str(info.value)
+    assert msg.startswith("DESK_"), msg
+    assert os.sep not in msg and f.name not in msg and "SECRET" not in msg and "abc" not in msg, msg
+
+
+def test_after_check_start_the_live_qualifier_holds_no_key(tmp_path: Path) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    q = _kinds(f, tmp_path)["live"]
+    q.check_start()
+    assert q._key == ""
+
+
+def test_a_key_file_replaced_between_the_start_and_the_first_call_is_the_one_used(tmp_path: Path) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "-A\n")
+    q = _kinds(f, tmp_path)["live"]
+    q.check_start()
+    f.write_text(FAKE_KEY + "-B\n", encoding="utf-8")
+    assert q._read_key() == FAKE_KEY + "-B"
+    f.write_text(FAKE_KEY + "-C\n", encoding="utf-8")
+    assert q._read_key() == FAKE_KEY + "-B"  # kept in memory after the first call, as the settings page says
+
+
+# REGRESSION GUARD: passes on the earlier tree too, by design (pins behaviour that must not change)
+@pytest.mark.parametrize("kind", ["hubspot", "live", "provider"])
+def test_a_good_key_file_starts_the_desk_and_the_key_is_not_printed(tmp_path: Path, fakes_url: str, kind: str) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    extra = {"hubspot": _hubspot(f), "live": _live(f, tmp_path), "provider": _provider(f)}[kind]
+    p = subprocess.Popen(  # noqa: S603  # nosec B603 - our own module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+        cwd=tmp_path,
+        env=_env(tmp_path, fakes_url, extra),
+    )
+    assert p.stdout is not None
+    out = p.stdout
+    first: list[str] = []
+    reader = threading.Thread(target=lambda: first.append(out.readline()), daemon=True)
+    reader.start()
+    reader.join(timeout=40)  # a desk that stays silent fails here instead of hanging the test
+    try:
+        assert first, "the desk printed nothing within 40 seconds"
+        assert first[0].startswith("desk listening on "), first[0]
+    finally:
+        p.terminate()
+        try:
+            rest, _ = p.communicate(timeout=20)
+        except subprocess.TimeoutExpired:  # our own child: stop it for good
+            p.kill()
+            rest, _ = p.communicate(timeout=20)
+    assert FAKE_KEY not in first[0] + (rest or "")  # the whole output, not only the first line
+
