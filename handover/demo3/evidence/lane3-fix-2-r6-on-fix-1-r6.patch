+    _refused(_run(tmp_path, fakes_url, extra), setting + ": ", str(f), "abc")
+
+
+# ---------------------------------------------------------------------------------------------- start check hook
+class _NoHook:
+    """A kind with no secret: it has no check_start method and is simply not checked."""
+
+
+class _Refusing:
+    def check_start(self) -> None:
+        raise SettingRefused("DESK_MADE_UP_FILE: fixed text")
+
+
+class _Counting:
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def check_start(self) -> None:
+        self.calls += 1
+
+
+def test_a_kind_without_check_start_starts_and_every_kind_with_it_is_asked_once() -> None:
+    a, b = _Counting(), _Counting()
+    check_secret_files(_NoHook(), a, b)
+    assert (a.calls, b.calls) == (1, 1)
+
+
+def test_a_check_start_that_refuses_is_a_setting_refusal_with_its_own_text() -> None:
+    with pytest.raises(SettingRefused, match="DESK_MADE_UP_FILE: fixed text"):
+        check_secret_files(_NoHook(), _Refusing(), _NoHook())
+
+
+@pytest.mark.usefixtures("main_lock_handles_closed")
+def test_main_turns_a_refusing_check_start_into_exit_4_without_a_traceback(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    monkeypatch.setattr(server, "load_demo_adapters", lambda cfg: (_NoHook(), _Refusing(), _NoHook()))
+    monkeypatch.setenv("DESK_DB_PATH", str(tmp_path / "d.sqlite3"))
+    monkeypatch.setenv("DESK_PORT", "0")
+    with pytest.raises(SystemExit) as info:
+        server.main()
+    out = capsys.readouterr().out
+    assert info.value.code == 4
+    assert "the desk refuses a setting: DESK_MADE_UP_FILE: fixed text" in out
+
