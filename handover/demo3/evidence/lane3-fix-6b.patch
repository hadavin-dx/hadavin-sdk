diff --git a/tests/test_run_commands_lane3.py b/tests/test_run_commands_lane3.py
new file mode 100644
index 0000000..ae84d13
--- /dev/null
+++ b/tests/test_run_commands_lane3.py
@@ -0,0 +1,32 @@
+"""Keep the run command in the crash_desk.py docstring and the pyproject.toml comment the same as in contract.md.
+
+Text only: the files are read, nothing is started.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8")
+
+
+def test_crash_desk_docstring_names_the_path_with_the_repository_folder() -> None:
+    doc = _read("scripts/crash_desk.py").split('"""')[1]
+    assert "PYTHONPATH=src python scripts/crash_desk.py" not in doc
+    assert "set PYTHONPATH=src first" not in doc
+    assert re.search(r"PYTHONPATH=src:[.] python scripts/crash_desk\.py", doc)
+    assert "$env:PYTHONPATH = 'src;.'" in doc
+    assert max(len(line) for line in doc.splitlines()) <= 120
+
+
+def test_pyproject_comment_names_the_path_with_the_repository_folder() -> None:
+    comments = [ln for ln in _read("pyproject.toml").splitlines() if ln.startswith("# Run commands set PYTHONPATH")]
+    assert len(comments) == 1
+    assert "PYTHONPATH=src:. (there is no build-system)" in comments[0]
+    assert "PYTHONPATH=src (" not in comments[0]
+
