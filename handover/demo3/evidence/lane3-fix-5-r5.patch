+def test_start_all_sh_launches_the_programs_with_the_words_reset_sh_looks_for() -> None:
+    text = (Path(__file__).resolve().parents[1] / "scripts" / "start_all.sh").read_text(encoding="utf-8")
+    assert re.search(r"^python -m lead_desk\.server[ >]", text, re.MULTILINE), "the desk is no longer `python -m ...`"
+    assert re.search(r"^python -m demo_only\.fakes_server[ >]", text, re.MULTILINE), "the demo server line changed"
