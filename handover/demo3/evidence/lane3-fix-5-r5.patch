+++ b/tests/test_port_helpers.py
@@ -0,0 +1,87 @@
+"""free_port() and held_port() (tests/support.py) never give one port number to two callers, and a held number is
+released after every test by the autouse fixture in tests/conftest.py. The operating system's answers are made up
+here (a stand-in for the socket module), so the result is exact on every machine and no real port is taken."""
+
+from __future__ import annotations
+
+import socket
+from collections import deque
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import support
+from support import HOST, free_port, held_port, release_held_ports
+
+
+def test_a_held_port_is_given_to_no_other_socket_and_is_free_again_after_the_release() -> None:
+    port = held_port()
+    try:
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as other:
+            with pytest.raises(OSError):
+                other.bind((HOST, port))
+        with pytest.raises(OSError), socket.create_connection((HOST, port), timeout=2):
+            pass  # bound but not listening: nothing answers
+        taken = {free_port() for _ in range(50)}  # never a number that is held
+        assert port not in taken
+    finally:
+        release_held_ports()
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as again:
+        again.bind((HOST, port))
+
+
+def test_the_held_ports_of_a_test_are_released_by_the_fixture_in_conftest(request: pytest.FixtureRequest) -> None:
+    assert "_release_held_ports" in request.fixturenames, "no autouse fixture releases the held ports after a test"
+
+
+class _MadeUpSocket:
+    """Takes the next number from the list when it is bound to port 0; holds nothing and listens nowhere."""
+
+    numbers: deque[int] = deque()
+
+    def __init__(self, *_args: Any) -> None:
+        self.number = 0
+
+    def __enter__(self) -> _MadeUpSocket:
+        return self
+
+    def __exit__(self, *_exc: object) -> None:
+        self.close()
+
+    def bind(self, address: tuple[str, int]) -> None:
+        self.number = self.numbers.popleft()
+
+    def getsockname(self) -> tuple[str, int]:
+        return (HOST, self.number)
+
+    def close(self) -> None:
+        pass
+
+
+def _operating_system_hands_out(monkeypatch: pytest.MonkeyPatch, numbers: list[int]) -> None:
+    _MadeUpSocket.numbers = deque(numbers)
+    stand_in = SimpleNamespace(socket=_MadeUpSocket, AF_INET=socket.AF_INET, SOCK_STREAM=socket.SOCK_STREAM)
+    monkeypatch.setattr(support, "socket", stand_in)
+    monkeypatch.setattr(support, "_HELD_PORTS", [])
+    monkeypatch.setattr(support, "_GIVEN_FREE", deque(maxlen=512), raising=False)
+
+
+def test_free_port_never_returns_a_number_that_held_port_holds(monkeypatch: pytest.MonkeyPatch) -> None:
+    held, other = 41001, 41002
+    _operating_system_hands_out(monkeypatch, [held, held, held, other])
+    assert held_port() == held
+    assert free_port() == other  # the answers that said `held` again were refused
+
+
+def test_held_port_never_returns_a_number_that_free_port_gave_away(monkeypatch: pytest.MonkeyPatch) -> None:
+    given, other = 41003, 41004
+    _operating_system_hands_out(monkeypatch, [given, given, other])
+    assert free_port() == given
+    assert held_port() == other  # the caller of free_port() may bind `given` at any moment
+
+
+def test_free_port_stops_with_a_clear_error_when_every_answer_is_held(monkeypatch: pytest.MonkeyPatch) -> None:
+    _operating_system_hands_out(monkeypatch, [41005] * 101)
+    assert held_port() == 41005
+    with pytest.raises(AssertionError, match="held"):
+        free_port()
diff --git a/tests/test_reset_ps1_pid_rules.py b/tests/test_reset_ps1_pid_rules.py
new file mode 100644
index 0000000..375172b
--- /dev/null
+++ b/tests/test_reset_ps1_pid_rules.py
@@ -0,0 +1,110 @@
+"""scripts/reset.ps1 must decide like scripts/reset.sh: a pid file is one plain process number or it is stale, and a
+process is the desk only when its command line is `python -m lead_desk.server ...` (or the demo server), not when the
+marker text is just somewhere in it. NOT run here: PowerShell and Windows (no Windows runner was available when this
+was written, so reset.ps1 itself is unverified by a run). What runs on every machine: the script text is read, the
+old bare `-match` and bare `[int](Get-Content ...)` must be gone, and the pattern the script holds is applied to a
+table of command lines with Python's `re` (close to, but not the same engine as, PowerShell's). The one test that
+really runs reset.ps1 needs Windows."""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+from pathlib import Path
+
+import pytest
+from support import REPO, WINDOWS, reset_kept, reset_run, start_proc, stop_proc, wait_until
+
+SCRIPT_TEXT = (REPO / "scripts" / "reset.ps1").read_text(encoding="utf-8")
+
+
+def _code() -> str:
+    return "\n".join(ln for ln in SCRIPT_TEXT.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def _ours_pattern() -> str:
+    """The pattern reset.ps1 builds: `$interpreter = '...'` and `$ours = '...' + $interpreter + '...'`."""
+    code = _code()
+    interpreter = re.search(r"^\$interpreter = '(?P<text>.*)'$", code, re.MULTILINE)
+    ours = re.search(r"^\$ours = (?P<expr>.*)$", code, re.MULTILINE)
+    assert interpreter and ours, "reset.ps1 has no $interpreter and $ours patterns for the desk's command line"
+    parts = []
+    for token in re.finditer(r"'([^']*)'|\$interpreter", ours.group("expr")):
+        parts.append(token.group(1) if token.group(1) is not None else interpreter.group("text"))
+    return "".join(parts)
+
+
+def test_the_old_bare_substring_match_and_the_unchecked_number_are_gone() -> None:
+    code = _code()
+    assert not re.search(r"-match\s+'lead_desk\\\.server\|", code), "the bare substring match is back"
+    assert "[int](Get-Content" not in code, "the pid file is converted without a shape check (abc, two lines throw)"
+    assert "[int]::TryParse" in code and "-cmatch '^[1-9][0-9]*$'" in code, "the pid shape rule is missing"
+    assert re.search(r"\$proc\.CommandLine\s+-match\s+\$ours", code), "the command line is not judged by the pattern"
+    # an empty file gives $null: the text is built without calling .Trim() on it
+    assert re.search(r"\$null\s+-eq\s+\$raw", code), "an empty pid file is not guarded"
+    # a file that cannot be read must not stop the reset (ErrorActionPreference is Stop)
+    assert re.search(r"try\s*\{\s*\$raw\s*=\s*Get-Content[^}]*\}\s*catch", code), "an unreadable pid file is not caught"
+
+
+@pytest.mark.parametrize(
+    ("line", "ours"),
+    [
+        ("python -m lead_desk.server", True),
+        ('"C:\\Users\\me\\venv\\Scripts\\python.exe" -m lead_desk.server', True),
+        ('"C:\\Program Files\\Python312\\python.exe" -m lead_desk.server', True),
+        ("C:\\Program Files\\Python312\\python.exe -m lead_desk.server", False),  # no quotes, a space: the safe side
+        ("C:\\venv\\python.exe -m lead_desk.server", True),
+        ("C:\\x\\pythonw.exe -m demo_only.fakes_server --outbox keyed --port 5", True),
+        ("PYTHON.EXE -m LEAD_DESK.SERVER", True),
+        ("notepad lead_desk.server.py", False),
+        ("python -m lead_desk.server.py", False),
+        ("python -m lead_desk.serverx", False),
+        ("python -m xlead_desk.server", False),
+        ("python -mlead_desk.server", False),
+        ("python lead_desk.server", False),
+        ("C:\\python-tools\\less.exe -m lead_desk.server", False),
+        ("cmd /c echo python -m lead_desk.server", False),
+        ('powershell -Command "python -m demo_only.fakes_server.py"', False),
+    ],
+)
+def test_the_command_line_pattern_in_reset_ps1_accepts_only_the_real_shapes(line: str, ours: bool) -> None:
+    assert bool(re.search(_ours_pattern(), line, re.IGNORECASE)) is ours, line
+
+
+@pytest.mark.parametrize(
+    ("text", "plain"),
+    [("123", True), ("1", True), ("007", False), ("0", False), ("abc", False), ("12 34", False), ("12\n34", False)],
+)
+def test_the_pid_shape_rule_in_reset_ps1_accepts_one_plain_number_only(text: str, plain: bool) -> None:
+    found = re.search(r"-cmatch '(?P<rule>\^\[1-9\]\[0-9\]\*\$)'", _code())
+    assert found, "the pid shape rule is not in reset.ps1"
+    assert bool(re.search(found.group("rule"), text)) is plain, text
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+@pytest.mark.parametrize("text", ["abc", "007", "123\n456\n", ""])
+def test_reset_ps1_treats_a_pid_file_that_is_not_one_number_as_stale(book: Path, text: str) -> None:
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(text, encoding="utf-8")
+    done = reset_run("reset.ps1", book)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+def test_reset_ps1_does_not_stop_a_program_that_only_has_the_marker_in_its_line(book: Path) -> None:
+    ready = book.parent / "ready"
+    code = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    child: subprocess.Popen[bytes] = start_proc(["-c", code, "-m", "lead_desk.server.py", str(ready)], dict(os.environ))
+    try:
+        wait_until(ready.exists, what="the child is running")
+        pidfile = book.parent / "desk.pid"
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = reset_run("reset.ps1", book)
+        still_running = child.poll() is None
+    finally:
+        child.kill()
+        child.wait()
+        stop_proc(child)
+    assert still_running and done.returncode == 6, (done.returncode, done.stdout, done.stderr)
+    assert reset_kept(book) and pidfile.exists()
diff --git a/tests/test_reset_ps_width.py b/tests/test_reset_ps_width.py
new file mode 100644
index 0000000..39bb8e9
--- /dev/null
+++ b/tests/test_reset_ps_width.py
@@ -0,0 +1,437 @@
+"""reset.sh tells the desk from another program by its command line, whose marker is the last word. `ps` cuts the
+line at the terminal width when COLUMNS is set (pytest-xdist workers and any terminal set it), so the script must
+read the whole line. Made-up processes only."""
+
+from __future__ import annotations
+
+import os
+import re
+import shlex
+import shutil
+import socket
+import subprocess
+import sys
+from collections.abc import Callable
+from pathlib import Path
+
+import pytest
+from support import (
+    DESK_MODULE,
+    FAKES_MODULE,
+    SLEEP,
+    WINDOWS,
+    dead_pid,
+    start_module_proc,
+    start_proc,
+    stop_proc,
+    stub_tree,
+    wait_until,
+)
+from support import RESET_SCRIPT as SCRIPT
+from support import held_port as _free_port
+from support import reset_kept as _kept
+from support import reset_run as _run
+
+REPO_SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "reset.sh"
+
+pytestmark = pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+
+NARROW = {"COLUMNS": "80", "LINES": "24"}
+
+
+def _link(folder: Path, name: str) -> str:
+    """A file called `name` in `folder` that runs this interpreter (a made-up program path); returns its path."""
+    folder.mkdir(parents=True, exist_ok=True)
+    link = folder / name
+    link.symlink_to(sys.executable)
+    return str(link)
+
+
+def _end(child: subprocess.Popen[bytes]) -> None:
+    child.kill()
+    child.wait()
+    stop_proc(child)  # reads and closes its output pipe
+
+
+def test_a_slow_stop_is_refused_with_exit_5_when_the_terminal_width_is_80(book: Path) -> None:
+    code = (
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
+        "open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    )
+    ready = book.parent / "ready"
+    slow = start_module_proc(ready, code)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(
+            SCRIPT,
+            book,
+            RESET_STOP_WAIT_SECONDS="1",
+            DESK_PORT=str(_free_port()),
+            DESK_FAKES_PORT=str(_free_port()),
+            **NARROW,
+        )
+    finally:
+        _end(slow)
+    said = done.stdout + done.stderr
+    assert done.returncode == 5 and "did not stop" in said, (done.stdout, done.stderr)
+    assert _kept(book)
+
+
+def test_a_desk_that_stops_in_a_few_seconds_is_waited_for_when_the_terminal_width_is_80(book: Path) -> None:
+    code = (
+        "import signal, sys, time\n"
+        "def stop(*a):\n"
+        "    time.sleep(3)\n"
+        "    sys.exit(0)\n"
+        "signal.signal(signal.SIGTERM, stop)\n"
+        "open(sys.argv[-1], 'w').close()\n"
+        "time.sleep(60)\n"
+    )
+    ready = book.parent / "ready"
+    slow = start_module_proc(ready, code)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    finally:
+        _end(slow)
+    assert done.returncode == 0, (done.stdout, done.stderr)
+    assert not book.exists() and not (book.parent / "desk.pid").exists()
+
+
+def test_a_command_line_over_200_characters_is_still_the_desk(book: Path) -> None:
+    code = (
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN)\n"
+        "open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    )
+    ready = book.parent / "ready"
+    padding = [f"padding-word-{i:02d}" for i in range(20)]  # about 300 characters after the marker
+    slow = start_module_proc(ready, code, *padding)
+    try:
+        wait_until(ready.exists, what="the child has installed its signal handler")
+        (book.parent / "desk.pid").write_text(str(slow.pid), encoding="utf-8")
+        done = _run(
+            SCRIPT,
+            book,
+            RESET_STOP_WAIT_SECONDS="1",
+            DESK_PORT=str(_free_port()),
+            DESK_FAKES_PORT=str(_free_port()),
+            COLUMNS="20",
+            LINES="24",
+        )
+    finally:
+        _end(slow)
+    # the desk was recognised (so it was asked to stop, and refused to): 5, never 6 "not the desk"
+    said = done.stdout + done.stderr
+    assert done.returncode == 5 and "did not stop" in said, (done.stdout, done.stderr)
+    assert _kept(book)
+
+
+# -- the helper `proc_args` itself, cut out of the script text and run in bash with a stand-in `ps` (first on PATH)
+def _proc_args(tmp: Path, pid: str, ps_body: str, tr_body: str | None = None) -> tuple[str, list[str], int]:
+    """Run reset.sh's `proc_args` for `pid`. The stand-in `ps` writes its arguments (one call per line) to a file and
+    then runs ps_body; a stand-in `tr` (tr_body) is added only when given. Returns (output, ps calls, exit code)."""
+    stubs = tmp / "stubs"
+    stubs.mkdir()
+    log = tmp / "ps-calls.txt"
+    ps_text = f'#!/usr/bin/env bash\nprintf \'%s\\n\' "$*" >> "{log}"\n{ps_body}\n'
+    (stubs / "ps").write_text(ps_text, encoding="utf-8")
+    (stubs / "ps").chmod(0o755)
+    if tr_body is not None:
+        (stubs / "tr").write_text(f"#!/usr/bin/env bash\n{tr_body}\n", encoding="utf-8")
+        (stubs / "tr").chmod(0o755)
+    text = REPO_SCRIPT.read_text(encoding="utf-8")
+    start = text.index("proc_args() {")
+    func = text[start : text.index("\n}\n", start) + 3]
+    done = _run(SCRIPT, tmp / "unused.sqlite3", first_on_path=stubs, code=f"{func}\nproc_args {shlex.quote(pid)}")
+    calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
+    return done.stdout, calls, done.returncode
+
+
+def test_proc_args_asks_ps_with_ww_first_when_the_pid_is_not_a_plain_number(tmp_path: Path) -> None:
+    out, calls, rc = _proc_args(tmp_path, "abc", 'echo "line from ww"')
+    assert (out, rc) == ("line from ww\n", 0)
+    assert calls == ["-ww -p abc -o args="], calls  # one call, with -ww; /proc was not used for a non-number
+
+
+def test_proc_args_falls_back_to_plain_ps_when_ps_ww_fails(tmp_path: Path) -> None:
+    body = 'if [[ "$1" == "-ww" ]]; then exit 1; fi; echo "plain ps line"'
+    out, calls, rc = _proc_args(tmp_path, "abc", body)
+    assert (out, rc) == ("plain ps line\n", 0)
+    assert calls == ["-ww -p abc -o args=", "-p abc -o args="], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_reads_proc_first_and_never_calls_ps_for_a_live_process(tmp_path: Path) -> None:
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "ps must not run"')
+    # this process's own command line as the kernel holds it (NUL separators become spaces), one line
+    own = os.fsdecode(Path("/proc/self/cmdline").read_bytes()).replace("\0", " ")
+    assert rc == 0 and out == own + "\n", (out, own)
+    assert calls == [], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_asks_ps_when_proc_gives_an_empty_command_line(tmp_path: Path) -> None:
+    # a stand-in `tr` prints nothing and succeeds, as `tr` does for a process whose command line is empty
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "[kernel-thread]"', tr_body="exit 0")
+    assert (out, rc) == ("[kernel-thread]\n", 0)
+    assert calls == [f"-ww -p {os.getpid()} -o args="], calls
+
+
+@pytest.mark.skipif(not Path("/proc/self/cmdline").exists(), reason="needs /proc (Linux)")
+def test_proc_args_asks_ps_when_proc_gives_only_blanks(tmp_path: Path) -> None:
+    # a process whose command line is only NUL bytes: `tr` turns them into spaces, so the answer is blank, not empty
+    out, calls, rc = _proc_args(tmp_path, str(os.getpid()), 'echo "[kernel-thread]"', tr_body="printf '   '")
+    assert (out, rc) == ("[kernel-thread]\n", 0)
+    assert calls == [f"-ww -p {os.getpid()} -o args="], calls
+
+
+# -- a pid file with text that is not one process number: treated as before (a stale file, deleted), never run
+@pytest.mark.parametrize(
+    "text",
+    [
+        "abc",
+        "1 ; touch {marker}",
+        "$(touch {marker})",
+        "`touch {marker}`",
+        "",
+        "   ",
+        "99999999999999999999",
+        "self",
+        "../1",
+        "123 456",
+        "123\n456\n",
+        "0",
+        "007",
+    ],
+)
+def test_a_pid_file_with_text_that_is_not_a_number_runs_nothing(book: Path, text: str) -> None:
+    marker = book.parent / "injected"
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(text.format(marker=marker), encoding="utf-8")
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    assert not marker.exists(), "text from the pid file was run as a command"
+    # ps cannot find such a process, so the file counts as stale: removed, the reset goes on (as the old script did)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+# -- a pid file with two process numbers is stale too: nothing is stopped, not even a real desk named by one of them
+@pytest.mark.parametrize("shape", ["{pid} {dead}", "{dead} {pid}", "{pid}\n{dead}\n", "{pid}\n{pid}\n", "{pid} {pid}"])
+def test_a_pid_file_with_two_numbers_is_stale_and_stops_nothing_even_a_real_desk(book: Path, shape: str) -> None:
+    ready = book.parent / "ready"
+    desk = start_module_proc(ready, SLEEP)
+    pidfile = book.parent / "desk.pid"
+    try:
+        wait_until(ready.exists, what="the child is running")
+        pidfile.write_text(shape.format(pid=desk.pid, dead=dead_pid()), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert still_running, "a process was stopped although the pid file did not name one process"
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+# -- the interpreter and the module are exact words of the argument list (read from /proc one by one): a program that
+# only CONTAINS the marker text, or has python in a folder name, is left alone
+def _run_against(book: Path, pid_file: str, child: subprocess.Popen[bytes], ready: Path) -> tuple[int, str, bool]:
+    """Name `child` in the pid file, run the reset script, return (exit code, its words, child still running)."""
+    wait_until(ready.exists, what="the child is running")
+    pidfile = book.parent / pid_file
+    try:
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = child.poll() is None
+    finally:
+        _end(child)
+    return done.returncode, done.stdout + done.stderr, still_running
+
+
+@pytest.mark.parametrize(
+    ("pid_file", "words"),
+    [
+        ("desk.pid", ["-c", SLEEP, "vim", "lead_desk.server.py"]),
+        ("desk.pid", ["-c", SLEEP, "-m", "lead_desk.server.py"]),
+        ("desk.pid", ["-c", SLEEP, "-m", "lead_desk.serverx"]),
+        ("desk.pid", ["-c", SLEEP, "-m", "xlead_desk.server"]),
+        ("desk.pid", ["-c", SLEEP, "--x=lead_desk.server"]),
+        ("desk.pid", ["-c", SLEEP, "lead_desk.server"]),  # the old bare-word shape
+        ("fakes.pid", ["-c", SLEEP, "demo_only.fakes_server"]),
+        ("fakes.pid", ["-c", SLEEP, "-m", "lead_desk.server.py", "demo_only.fakes_server.py"]),
+        ("desk.pid", ["-c", SLEEP, "-m", "lead_desk.server"]),  # -c is the second word: python runs it, no module
+        ("desk.pid", ["-u", "-m", "lead_desk.server"]),  # another python option first: not the shape start_all.sh gives
+    ],
+)
+def test_a_program_that_only_contains_the_marker_text_is_not_stopped(
+    book: Path, pid_file: str, words: list[str]
+) -> None:
+    ready = book.parent / "ready"
+    tree = stub_tree(book.parent / "stub-tree", SLEEP)  # `-m lead_desk.server` finds the made-up module here
+    child = start_proc([*words, str(ready)], dict(os.environ), cwd=tree)
+    code, said, still_running = _run_against(book, pid_file, child, ready)
+    assert still_running, "a program that is not the desk was stopped"
+    assert code == 6 and "not the desk" in said, (code, said)
+    assert _kept(book) and (book.parent / pid_file).exists()
+
+
+def test_a_shell_that_has_the_marker_in_a_quoted_string_is_not_stopped(book: Path) -> None:
+    # bash -c "...; echo python -m lead_desk.server >&2": the line holds the marker, argv[0] is bash. The script
+    # waits on a pipe it opened for reading and writing (no child process that could outlive the test)
+    bash = shutil.which("bash")
+    assert bash is not None
+    ready = book.parent / "ready"
+    script = (
+        'f="$1"; mkfifo "$f/wait"; exec 3<>"$f/wait"; : > "$f/ready"; read -t 60 -u 3 _;'
+        " echo python -m lead_desk.server >&2"
+    )
+    child = start_proc(["-c", script, "bash", str(book.parent)], dict(os.environ), program=bash)
+    code, said, still_running = _run_against(book, "desk.pid", child, book.parent / "ready")
+    assert still_running, "a shell that only prints the marker was stopped"
+    assert code == 6 and "not the desk" in said, (code, said)
+    assert ready.exists()
+
+
+@pytest.mark.parametrize("pid_file", ["desk.pid", "fakes.pid"])
+def test_a_program_with_python_in_a_folder_name_and_the_marker_is_not_stopped(book: Path, pid_file: str) -> None:
+    # /.../python-tools/bin/less -m lead_desk.server <ready>: the same words as the real shape, but argv[0] is `less`
+    ready = book.parent / "ready"
+    module = FAKES_MODULE if pid_file == "fakes.pid" else DESK_MODULE
+    program = _link(book.parent / "python-tools" / "bin", "less")
+    child = start_module_proc(ready, SLEEP, module=module, program=program)
+    code, said, still_running = _run_against(book, pid_file, child, ready)
+    assert still_running, "a program called less was stopped because python is in its folder name"
+    assert code == 6 and "not the desk" in said, (code, said)
+
+
+@pytest.mark.parametrize(
+    ("pid_file", "module", "words", "program_name"),
+    [
+        ("desk.pid", DESK_MODULE, [], None),  # this interpreter, as start_all.sh starts it
+        ("fakes.pid", FAKES_MODULE, ["--outbox", "keyed", "--port", "1"], None),
+        ("desk.pid", DESK_MODULE, [], "python3.12"),
+        ("desk.pid", DESK_MODULE, [], "Python"),  # the macOS framework name
+        ("fakes.pid", FAKES_MODULE, ["--outbox", "keyed"], "python"),
+    ],
+)
+def test_the_real_desk_and_demo_server_command_lines_are_still_stopped(
+    book: Path, pid_file: str, module: str, words: list[str], program_name: str | None
+) -> None:
+    ready = book.parent / "ready"
+    # a folder name with a space: the words are told apart one by one, never by splitting a line at spaces
+    program = None if program_name is None else _link(book.parent / "my tools" / "bin", program_name)
+    child = start_module_proc(ready, SLEEP, *words, module=module, program=program)
+    code, said, still_running = _run_against(book, pid_file, child, ready)
+    assert not still_running and code == 0, (code, said)
+    assert not (book.parent / pid_file).exists() and not book.exists()
+
