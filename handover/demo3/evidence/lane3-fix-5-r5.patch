+def test_a_desk_that_ignores_the_stop_signal_in_the_real_shape_is_refused_with_exit_5(book: Path) -> None:
+    code_text = "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN)\n" + SLEEP
+    ready = book.parent / "ready"
+    child = start_module_proc(ready, code_text)
+    wait_until(ready.exists, what="the child has installed its signal handler")
+    pidfile = book.parent / "desk.pid"
+    try:
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = _run(
+            SCRIPT, book, RESET_STOP_WAIT_SECONDS="1", DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port())
+        )
+    finally:
+        _end(child)
+    assert done.returncode == 5 and "did not stop" in done.stdout + done.stderr, (done.stdout, done.stderr)
+
+
+# -- where /proc cannot be read (macOS, BSD) the line from `ps` is matched as text: a dead process number (no /proc
+# entry) with a stand-in `ps` that answers for it. The process is not really stopped: exit 0 means "was the desk",
+# exit 6 means "another program"
+@pytest.mark.parametrize(
+    ("line", "stopped"),
+    [
+        ("python -m lead_desk.server", True),
+        ("python -m lead_desk.server ", True),
+        ("/venv/bin/python3.12 -m lead_desk.server", True),
+        ("my tools/venv/bin/python3.12 -m lead_desk.server", False),  # a space in the path: refused, the safe side
+        ("/Library/Frameworks/Python.framework/Versions/3.12/bin/Python -m lead_desk.server", True),
+        ("python -m demo_only.fakes_server", True),
+        ("python -m demo_only.fakes_server --outbox keyed --port 5", True),
+        ("vim lead_desk.server.py", False),
+        ("vim -m lead_desk.server", False),
+        ("python-tools/bin/less -m lead_desk.server", False),
+        ("my python/bin/less -m lead_desk.server", False),
+        ("bash -c python -m lead_desk.server", False),
+        ("python -m lead_desk.server.py", False),
+        ("python -m lead_desk.serverx", False),
+        ("python -m xlead_desk.server", False),
+        ("python -mlead_desk.server", False),
+        ("python lead_desk.server", False),
+        ("python demo_only.fakes_server.py", False),
+    ],
+)
+def test_the_ps_text_fallback_decides_the_same_way(book: Path, tmp_path: Path, line: str, stopped: bool) -> None:
+    stubs = tmp_path / "stubs"
+    stubs.mkdir()
+    answer = f"printf '%s\\n' {shlex.quote(line)}"
+    body = f'#!/usr/bin/env bash\ncase "$*" in *stat=*) echo S ;; *) {answer} ;; esac\n'
+    (stubs / "ps").write_text(body, encoding="utf-8")
+    (stubs / "ps").chmod(0o755)
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(str(dead_pid()), encoding="utf-8")
+    ports = {"DESK_PORT": str(_free_port()), "DESK_FAKES_PORT": str(_free_port())}
+    done = _run(SCRIPT, book, first_on_path=stubs, **ports, **NARROW)
+    assert done.returncode == (0 if stopped else 6), (line, done.returncode, done.stdout, done.stderr)
+    assert pidfile.exists() is not stopped
+
+
+# -- a pid file that cannot be read as a plain file: a stale file, never a hang and never an abort
+def _fifo(path: Path) -> None:
+    os.mkfifo(path)
+
+
+def _socket_file(path: Path) -> None:
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
+        s.bind(str(path))
+
+
+@pytest.mark.parametrize("make", [_fifo, _socket_file], ids=["named-pipe", "socket-file"])
+def test_a_pid_file_that_is_a_pipe_or_a_socket_is_stale_and_does_not_stop_the_reset(
+    book: Path, make: Callable[[Path], None]
+) -> None:
+    pidfile = book.parent / "desk.pid"
+    make(pidfile)
+    try:
+        done = _run(SCRIPT, book, timeout=30, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    finally:
+        if pidfile.exists() and pidfile.is_fifo():  # lets a reader that is still waiting for a writer go (old script)
+            os.close(os.open(pidfile, os.O_RDWR))
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+    assert not book.exists()
+
+
+def test_a_pid_file_that_is_a_folder_is_refused_with_exit_7_and_nothing_is_deleted(book: Path) -> None:
+    (book.parent / "desk.pid").mkdir()
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    assert done.returncode == 7 and "cannot be removed" in done.stdout + done.stderr, (done.stdout, done.stderr)
+    assert _kept(book)
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="the super-user can read any file; a normal user runs this")
+def test_a_pid_file_without_read_permission_is_stale_and_does_not_stop_the_reset(book: Path) -> None:
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text("123", encoding="utf-8")
+    pidfile.chmod(0)
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+def test_a_pid_file_with_a_very_long_first_line_is_stale(book: Path) -> None:
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text("1" + " " * 200 + "1\n", encoding="utf-8")
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
