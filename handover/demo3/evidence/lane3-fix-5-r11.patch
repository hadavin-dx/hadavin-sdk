+@_posix
+def test_reset_sh_treats_a_process_that_ends_during_the_look_as_stopped_not_as_another_program(
+    book: Path, tmp_path: Path
+) -> None:
+    """Pass 1 looks at the desk (alive, readable) and judges it ours. Pass 2 looks again (the first `ps -p ... -o stat=`
+    of pass 2, which is the SECOND such call of the whole run): the stand-in `ps` kills the desk on that call and
+    answers
+    "S", so the desk reads alive, its command line is then that of an ended process (not the desk), and only the second
+    look of pass 2 finds it ended (Z). The run must go on: exit 0, the pid file deleted, no "another program" line.
+    Without the second look (`elif alive` turned into `else`) it refuses with exit 6. The test counts the calls, so it
+    reaches pass 2 by behaviour (the round-10 version ended inside pass 1 and never reached pass 2)."""
+    real_ps = shutil.which("ps")
+    if real_ps is None:
+        pytest.skip("ps is not installed")
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    folder = tmp_path / "bin"
+    folder.mkdir()
+    fake = folder / "ps"
+    fake.write_text(
+        "#!/usr/bin/env bash\n"
+        f'state="{folder}/stat-calls"\n'
+        'if [[ "$*" == *"-o stat="* ]]; then\n'
+        '  echo x >> "$state"; n="$(wc -l < "$state")"\n'
+        '  if [[ "$n" == 2 ]]; then kill -9 "$2"; sleep 0.3; echo S; exit 0; fi\n'
+        "fi\n"
+        f'exec "{real_ps}" "$@"\n',
+        encoding="utf-8",
+    )
+    fake.chmod(0o755)
+    try:
+        done = reset_run(SH, book, first_on_path=folder, **reset_ports())
+        killed = desk.wait(timeout=10)
+    finally:
+        _end(desk)
+    calls = (folder / "stat-calls").read_text(encoding="utf-8").count("x")
+    assert calls >= 3, f"the run did not reach the second look of pass 2 (state looks: {calls})"
+    assert killed == -9
+    assert done.returncode == 0, (done.returncode, done.stdout, done.stderr)
+    assert "another program" not in done.stderr and not (book.parent / "desk.pid").exists()
+
