+        f'state="{folder}/stat-calls"\n'
+        'if [[ "$*" == *"-o stat="* ]]; then\n'
+        '  echo x >> "$state"; n="$(wc -l < "$state")"\n'
+        '  if [[ "$n" == 3 ]]; then kill -9 "$2"; sleep 0.3; echo S; exit 0; fi\n'
+        "fi\n"
