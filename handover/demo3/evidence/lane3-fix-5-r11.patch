+@_posix
+def test_reset_sh_does_not_stop_a_process_that_became_another_program_after_the_first_look(book: Path) -> None:
+    """Pass 1 sees both pid files name the desk and the demo server. The desk, once told to stop, waits for a signal
+    from this test; while the reset waits, the demo server stand-in executes another program (its command line
+    changes), as a reused number would. Only when the new program has announced itself does the desk end (a handshake,
+    not a time margin). The second look refuses with exit 6 and does NOT stop it; the desk, already stopped, is
+    named."""
+    desk = _live(book, "desk", DESK_MODULE, _ENDS_SLOWLY)
+    fakes = _live(book, "fakes", FAKES_MODULE, _CHANGES_ITS_LINE)
+    go = Path(str(book.parent / "fakes.ready") + ".go")
+    stopping = Path(str(book.parent / "desk.ready") + ".stopping")
+    changed = Path(str(book.parent / "fakes.ready") + ".changed")
+    release = Path(str(book.parent / "desk.ready") + ".exit")
+    failures: list[BaseException] = []
+    # the demo server changes as soon as the desk has been told to stop; the desk ends once the change is seen
+
+    def trigger() -> None:
+        try:
+            wait_until(stopping.exists, timeout=30, what="the desk was told to stop")
+            go.write_text("", encoding="utf-8")
+            wait_until(changed.exists, timeout=30, what="the demo server stand-in became another program")
+        except BaseException as error:  # noqa: BLE001 (handed to the test thread below)
+            failures.append(error)
+        finally:
+            release.write_text("", encoding="utf-8")  # never leave the desk waiting
+
+    helper = threading.Thread(target=trigger, daemon=True)
+    helper.start()
+    try:
+        done = reset_run(SH, book, **reset_ports())
+        helper.join(timeout=60)
+        assert not helper.is_alive(), "the helper thread did not finish"
+        if failures:
+            raise failures[0]
+        fakes_running = fakes.poll() is None
+    finally:
+        _end(desk, fakes)
+    assert done.returncode == 6, (done.returncode, done.stdout, done.stderr)
+    assert "was the desk or the demo server when checked, but is another program now; it was not stopped" in done.stderr
+    assert f"already stopped: desk (process {desk.pid})" in done.stderr, done.stderr
+    assert fakes_running, "the program that changed was stopped"
+    assert (book.parent / "desk.pid").exists() and (book.parent / "fakes.pid").exists() and reset_kept(book)
