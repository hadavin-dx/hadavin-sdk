+    (target / "keep.txt").write_text("keep", encoding="utf-8")
+    link = book.parent / "desk.pid"
+    try:
+        link.symlink_to(target, target_is_directory=True)
+    except (OSError, NotImplementedError):
+        pytest.skip("this computer cannot make a symbolic link")
+    done = _run(SCRIPT, book, **reset_ports())
+    assert done.returncode == 7, (done.returncode, done.stdout, done.stderr)
+    assert link.is_symlink() and (target / "keep.txt").exists() and _kept(book)
+
+
+@pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+def test_reset_sh_reads_a_pid_file_that_starts_with_a_utf8_byte_order_mark(book: Path) -> None:
+    """Notepad and some editors put EF BB BF in front of the number: the process is still the desk and is stopped."""
+    desk = _live_desk(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    (book.parent / "desk.pid").write_bytes(b"\xef\xbb\xbf" + str(desk.pid).encode() + b"\r\n")
+    try:
+        done = _run(SCRIPT, book, **reset_ports())
+        wait_until(lambda: desk.poll() is not None, timeout=10, what="the desk stand-in was stopped")
+    finally:
+        desk.kill()
+        desk.wait()
+        stop_proc(desk)
+    assert done.returncode == 0, (done.stdout, done.stderr)
+    assert not (book.parent / "desk.pid").exists() and not book.exists()
+
+
+@pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+def test_reset_sh_treats_a_utf16_pid_file_as_stale(book: Path) -> None:
+    """A file saved as UTF-16 is not one plain number: nothing is stopped for it, it is deleted (reset_check refuses
+    with exit 3 or 4 when a desk is really running, so the book is never deleted under a live desk)."""
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_bytes("1234\n".encode("utf-16"))
+    done = _run(SCRIPT, book, **reset_ports())
+    assert done.returncode == 0 and not pidfile.exists() and not book.exists(), (done.stdout, done.stderr)
