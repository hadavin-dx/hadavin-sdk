+def _as_nobody_can_run_bash() -> bool:
+    """True when a run as the user 65534 is possible, and process 1 is then another user's process that kill -0 may not
+    signal ("Operation not permitted"). The precondition is asserted, not assumed."""
+    if (
+        shutil.which("setpriv") is None
+        or not hasattr(os, "geteuid")
+        or os.geteuid() != 0
+        or not Path("/proc/1").exists()
+    ):
+        return False
+    done = subprocess.run(  # noqa: S603 (fixed lines)
+        [*_NOBODY, shutil.which("bash") or "bash", "-c", "LC_ALL=C kill -0 1"],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return done.returncode != 0 and "not permitted" in done.stderr
