+@_posix
+@_NEEDS_UTF8_BASH
+@pytest.mark.parametrize("r", [0, 1, 2])
+def test_reset_sh_counts_bytes_not_characters_of_the_pid_file_whatever_the_language_setting(book: Path, r: int) -> None:
+    """The desk's own number, plain spaces (3 more for each step of r; the base count is chosen
+    so that the 67-byte cut falls between two characters, whatever the digit count of the number; the old test passed
+    or failed by pid luck). In a UTF-8 setting that counts characters the file would trim to the desk's number and
+    stop it; the script reads, counts and trims in the C locale (64 bytes or more is stale) and stops nothing."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    number = str(desk.pid)
+    content = number.encode() + b" " * ((67 - len(number)) % 3 + 3 * r) + "\u3000".encode() * 30
+    (book.parent / "desk.pid").write_bytes(content)
+    try:
+        done = reset_run(SH, book, LC_ALL="C.UTF-8", **reset_ports())
+        still_running = desk.poll() is None
+        returncode = desk.returncode
+    finally:
+        _end(desk)
+    assert done.returncode == 0 and still_running, (
+        done.returncode,
+        still_running,
+        returncode,
+        len(content),
+        done.stdout,
+        done.stderr,
+    )
+    assert not (book.parent / "desk.pid").exists()
