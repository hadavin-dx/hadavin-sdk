+# -- a byte order mark, then the 64 byte rule counts the bytes after the mark
+@_posix
+@pytest.mark.parametrize(("content_bytes", "stopped"), [(63, True), (64, False)])
+def test_reset_sh_counts_the_64_bytes_after_a_byte_order_mark(book: Path, content_bytes: int, stopped: bool) -> None:
+    """Mark + number + spaces: 63 bytes after the mark still name the desk (it is stopped); 64 bytes are stale (nothing
+    is stopped; the same rule as reset.ps1, which reads 67 bytes and judges those after the mark)."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    number = str(desk.pid).encode()
+    (book.parent / "desk.pid").write_bytes(b"\xef\xbb\xbf" + number + b" " * (content_bytes - len(number)))
+    try:
+        done = reset_run(SH, book, **reset_ports())
+        if stopped:
+            wait_until(lambda: desk.poll() is not None, timeout=10, what="the desk stand-in was stopped")
+        still_running = desk.poll() is None
+    finally:
+        _end(desk)
+    assert done.returncode == 0, (done.stdout, done.stderr)
+    assert still_running is (not stopped), (content_bytes, still_running)
+    assert not (book.parent / "desk.pid").exists() and not book.exists()
