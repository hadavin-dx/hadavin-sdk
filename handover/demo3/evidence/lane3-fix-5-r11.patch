+    fakes = _live(
+        book,
+        "fakes",
+        FAKES_MODULE,
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN); "
+        "open(sys.argv[-1], 'w').close(); time.sleep(300)",
+    )
+    folder = tmp_path / "bin"
