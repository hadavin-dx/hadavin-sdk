+"""The reset scripts: the order of the three passes (decide, stop, check, delete), what a refusal says and where it is
+printed (standard error only), one word for the database, a program that changes between the passes, a pid file that is
+a dangling link, and the 64 byte rule after a byte order mark. Linux tests run reset.sh for real with stand-in
+programs; reset.ps1 is covered by text tests only (see test_reset_ps1_pid_rules.py). Made-up data only."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+from support import (
+    DESK_MODULE,
+    FAKES_MODULE,
+    REPO,
+    WINDOWS,
+    bound_socket,
+    held_port,
+    reset_kept,
+    reset_ports,
+    reset_run,
+    start_module_proc,
+    stop_proc,
+    wait_until,
+)
+
+SH = "reset.sh"
+_RUNS_UNTIL_STOPPED = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(300)"
+_posix = pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
