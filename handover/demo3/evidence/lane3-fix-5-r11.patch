+def _alive_answer(pid: int, *, as_nobody: bool) -> int:
+    """The exit status of reset.sh's alive() for this process number, run alone (0 = alive), optionally as 65534."""
+    text = _script_text()
+    body = text[text.index("alive() {") :]
+    body = body[: body.index("\n}\n") + 3]
+    cmd = [shutil.which("bash") or "bash", "-c", body + f"\nalive {pid}"]
+    if as_nobody:
+        cmd = [*_NOBODY, *cmd]
+    return subprocess.run(cmd, capture_output=True, check=False).returncode  # noqa: S603 (fixed lines)
+
+
+@_posix
+def test_alive_counts_a_process_it_may_not_signal_as_alive_and_a_missing_one_as_gone() -> None:
+    """Process 1 belongs to another user: kill -0 answers "Operation not permitted" (EPERM), which is not "gone". As
+    root the signal is allowed, so then user 65534 tries it (setpriv); as any other user the test runs as it is. The
+    precondition (the refusal really happens) is checked first; where it cannot hold the test is skipped, with that
+    reason."""
+    as_nobody = hasattr(os, "geteuid") and os.geteuid() == 0
+    if as_nobody:
+        if not _as_nobody_can_run_bash():
+            pytest.skip("cannot run as user 65534 here (no setpriv, or kill -0 on process 1 is not refused for it)")
+    else:
+        refused = subprocess.run(  # noqa: S603 (fixed line)
+            [str(shutil.which("bash")), "-c", "LC_ALL=C kill -0 1"], capture_output=True, text=True, check=False
+        )
+        if refused.returncode == 0 or "not permitted" not in refused.stderr:
+            pytest.skip("kill -0 on process 1 is not refused for this user")
+    assert _alive_answer(1, as_nobody=as_nobody) == 0, "a process we may not signal read as stopped"
+    gone = subprocess.Popen([sys.executable, "-c", "pass"])  # noqa: S603
+    gone.wait()
+    assert _alive_answer(gone.pid, as_nobody=as_nobody) == 1, "a process that ended read as alive"
+
