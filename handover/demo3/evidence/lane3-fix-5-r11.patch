+    "def stop(*_a):\n"
+    "    open(sys.argv[-1] + '.stopping', 'w').close()\n"
+    "    for _ in range(600):\n"  # ends when the test says so (a handshake), or after 30 seconds
+    "        if os.path.exists(sys.argv[-1] + '.exit'):\n"
+    "            break\n"
+    "        time.sleep(0.05)\n"
+    "    sys.exit(0)\n"
+    "signal.signal(signal.SIGTERM, stop)\n"
+    "open(sys.argv[-1], 'w').close()\n"
+    "time.sleep(300)\n"
+)
