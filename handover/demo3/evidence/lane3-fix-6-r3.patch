+    assert "$env:PYTHONPATH = 'src;.'" in readme
+    assert "cannot reach the demo servers" in readme and "exit code 1" in readme
+    assert "the PowerShell lines were not tried on Windows" in readme
+    assert "(not tried here)" not in readme
+
+
+def test_documented_assume_yes_flag_exists_in_the_script() -> None:
+    script = _read("scripts/run_real_check.py")
+    assert re.search(r'add_argument\(\s*"--assume-yes"', script)
+    assert "EXIT_REFUSED, EXIT_STOPPED, EXIT_FAILED = 2, 1, 3" in script
