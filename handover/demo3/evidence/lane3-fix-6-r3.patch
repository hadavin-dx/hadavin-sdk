+"""Pin facts that docs/tests.md, docs/real-services.md, contract.md and the README state about the scripts.
+
+Each test reads text files only; nothing slow is run. These statements were wrong in an earlier version of the docs;
+the tests keep them true. Every check looks inside one named paragraph, not anywhere in the file.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8")
+
+
+def _line(rel: str, start: str) -> str:
+    """The one line of a file that begins with `start` (zero or two such lines fail the test)."""
+    found = [ln for ln in _read(rel).splitlines() if ln.startswith(start)]
+    assert len(found) == 1, (rel, start, len(found))
+    return found[0]
+
+
+def _index(rel: str, start: str) -> int:
+    lines = _read(rel).splitlines()
+    return next(i for i, ln in enumerate(lines) if ln.startswith(start))
+
+
+def test_old_desk_commands_are_gone_from_every_doc() -> None:
+    old = re.compile(r"PYTHONPATH=src python (-m lead_desk\.server|scripts/crash_desk\.py)")
+    for rel in ("contract.md", "README.md", "docs/tests.md", "docs/real-services.md"):
+        assert not old.search(_read(rel)), rel
+    assert "PYTHONPATH=src:. python -m lead_desk.server" in _read("contract.md")
+    assert "PYTHONPATH=src:. python -m lead_desk.server" in _read("README.md")
+    assert "crash scene" not in _read("docs/tests.md")
+
+
+def test_by_hand_steps_name_one_window_per_command() -> None:
+    # the dot is written in brackets: a backslash before it would look like a Windows drive path to the hygiene test
+    step1 = _line("docs/tests.md", "1. Window 1, the demo server:")
+    assert re.search(r"PYTHONPATH=src:[.] python -m demo_only\.fakes_server --outbox keyed --port 8766", step1)
+    step2 = _line("docs/tests.md", "2. Window 2, the desk:")
+    assert re.search(r"PYTHONPATH=src:[.] python -m lead_desk\.server", step2)
+    crash = _line("docs/tests.md", "**Crash demo (instead of step 2).**")
+    assert re.search(r"PYTHONPATH=src:[.] python scripts/crash_desk\.py", crash)
+    step3 = _line("docs/tests.md", "3. Window 3, one made-up lead:")
+    assert "PYTHONPATH=src python scripts/feed.py --source form --index 1" in step3
+    assert "exit code 137" not in step3 and "flag file" not in step3
+    assert "scripts/start_all.sh" in _line("docs/tests.md", "`bash scripts/start_all.sh`")
+
+
+def test_start_up_outcomes_match_the_code() -> None:
+    para = _line("docs/tests.md", "What happens when something is missing")
+    shown = r"not running, the desk prints `cannot reach the demo servers[^`]*`"
+    assert re.search(shown + r" \(there is one demo server program[^)]*\) and ends with exit code 1", para)
+    assert "on ports other than 8765 and 8766" in para and "private ports" not in para
+    assert "`python scripts/crash_desk.py` does not have the current folder" in para
+    assert re.search(r"exit code 1 and a RuntimeError that says the folder `demo_only` is missing", para)
+    assert "ModuleNotFoundError" not in _read("docs/tests.md")
+    assert re.search(r'folder demo_only is "\s*"missing', _read("src/lead_desk/loader.py"))
+    assert "cannot reach the demo servers" in _read("src/lead_desk/server.py")
+    assert 'PYTHONPATH="src:."' in _read("scripts/start_all.sh")
+    assert "EXIT_SIMULATED_KILL: Final = 137" in _read("src/lead_desk/constants.py")
+    assert "simulate crash" in _read("src/lead_desk/hooks.py")
+
+
+def test_windows_powershell_form_is_given_once() -> None:
+    para = _line("docs/tests.md", "On Windows PowerShell, run")
+    assert "$env:PYTHONPATH = 'src;.'" in para
+    assert "'src;.'" in _read("scripts/start_all.ps1")
