+"""Fix-2 round 8: key files that other users can read, links refused on every system (not only where O_NOFOLLOW
+exists), the Retry-After rule over every short text and a huge number, the sibling path probes, and the key-file rule
+written in one place. Made-up data only; fake keys are built from parts."""
+
+from __future__ import annotations
+
+import importlib
+import importlib.util
+import itertools
+import os
+import re
+import stat
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from lead_desk import constants, envnum, server
+from lead_desk.envnum import SettingRefused
+
+SRC = Path(server.__file__).parent
+REPO = SRC.parents[1]
+KEY = "made" + "-up-" + "key-" + "0123456789"
+POSIX = pytest.mark.skipif(os.name != "posix", reason="permission bits and inode numbers are a POSIX notion")
+# every kind of secret file and how its reader is called: (what, noun, strip_inner_space)
+KINDS = {
+    "hubspot key": ("hubspot key", "key", False),
+    "live model key": ("live model key", "key", False),
+    "smtp password": ("smtp password", "password", True),
+    "mailbox password": ("mailbox password", "password", True),
+    "n8n API key": ("n8n API key", "key", False),
+    "model key": ("model key", "key", False),
+}
+
+
+def _make_link(link: Path, target: Path) -> None:
+    try:
+        link.symlink_to(target)
+    except (OSError, NotImplementedError) as e:  # Windows without the privilege to make links
+        pytest.skip(f"this system will not make a symbolic link here: {type(e).__name__}")
+
+
+# ------------------------------------------------------------------------------- the permission bits of a key file
+def test_the_test_session_makes_private_files_so_one_helper_covers_every_test() -> None:
+    """tests/conftest.py sets one umask for the whole session (no test makes its own): a plain write is mode 0600."""
+    if os.name != "posix":
+        pytest.skip("umask is a POSIX notion")
+    current = os.umask(0)
+    os.umask(current)
+    assert current & 0o077 == 0o077, oct(current)
+
+
+@POSIX
+@pytest.mark.parametrize("mode", [0o644, 0o640, 0o604, 0o660, 0o666, 0o440, 0o444, 0o601, 0o610, 0o700 | 0o010])
+@pytest.mark.parametrize("kind", sorted(KINDS))
+def test_a_key_file_that_other_users_can_read_is_refused_for_every_kind(tmp_path: Path, kind: str, mode: int) -> None:
+    what, noun, inner = KINDS[kind]
+    f = tmp_path / "secret-file.txt"
+    f.write_text(KEY + "\n", encoding="utf-8")
+    f.chmod(mode)
+    with pytest.raises(SettingRefused) as e:
+        envnum.read_secret_file(f, what, noun, strip_inner_space=inner)
+    assert str(e.value) == f"the {what} file can be read by other users: run chmod 600 on it"
+    assert KEY not in str(e.value) and str(tmp_path) not in str(e.value)
+
+
+@POSIX
+@pytest.mark.parametrize("mode", [0o600, 0o400, 0o200 | 0o400])
+@pytest.mark.parametrize("kind", sorted(KINDS))
+def test_a_key_file_only_its_owner_can_read_is_accepted_for_every_kind(tmp_path: Path, kind: str, mode: int) -> None:
+    what, noun, inner = KINDS[kind]
+    f = tmp_path / "secret-file.txt"
+    f.write_text(KEY + "\n", encoding="utf-8")
+    f.chmod(mode)
+    assert envnum.read_secret_file(f, what, noun, strip_inner_space=inner) == KEY
+
+
+@POSIX
+def test_the_mode_refusal_comes_after_the_link_and_kind_checks_and_has_no_way_round(tmp_path: Path) -> None:
+    f = tmp_path / "secret-file.txt"
+    f.write_text(KEY, encoding="utf-8")
+    f.chmod(0o644)
+    import inspect
+
+    assert "strict" not in inspect.signature(envnum.read_secret_file).parameters
+    assert [p for p in inspect.signature(envnum.read_secret_file).parameters] == [
+        "path", "what", "noun", "strip_inner_space",
+    ]  # fmt: skip
+    with pytest.raises(SettingRefused, match="other users"):
+        envnum.read_secret_file(f, "made-up key", "key")
+
+
+@POSIX
+def test_a_world_readable_key_stops_every_wrapper_with_the_same_fixed_text(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    f = tmp_path / "k.txt"
+    f.write_text(KEY, encoding="utf-8")
+    f.chmod(0o644)
+    from lead_desk import imap_count, smtp_provider
+    from lead_desk.crm_hubspot import CrmConfigError, HubspotCrm, HubspotSettings
+
+    with pytest.raises(smtp_provider.SendRefused, match="other users"):
+        smtp_provider.read_smtp_password(f)
+    crm = HubspotCrm(HubspotSettings(key_file=f, max_calls=5, base_url="http://127.0.0.1:1", allow_any_base_url=True))
+    with pytest.raises(CrmConfigError, match="other users"):
+        crm._key()
+    with pytest.raises(imap_count.ImapCountError, match="other users"):
+        imap_count._password(types_ns(password_file=f))
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(f))
+    monkeypatch.delenv("N8N_URL", raising=False)
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    try:
+        with pytest.raises(SystemExit) as e:
+            importlib.import_module("n8n_api")
+        assert "other users" in str(e.value) and str(tmp_path) not in str(e.value)
+    finally:
+        sys.modules.pop("n8n_api", None)
+
