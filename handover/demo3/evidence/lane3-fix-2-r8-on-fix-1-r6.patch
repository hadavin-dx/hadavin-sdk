+def _is_bind_name(name: str) -> bool:
+    """False only for what can never be the address the desk listens on; True for everything the operating system
+    might resolve (whether a name resolves on this computer is for the system to say: the desk then stops later with
+    exit code 5). Refused: empty, anything outside ASCII letters, digits and . - _ : % [ ] (so no space and no control
+    character), more than HOST_NAME_MAX characters, an empty part in a dotted name (`a..b`; one dot at the end is
+    fine), a number-and-dots name the system cannot read as IPv4 (a part above 255), brackets around anything but an
+    IPv6 address (an IPv4 address in brackets), and a name with a colon or % that is not an IPv6 address (a zone id is
+    fine: `[fe80::1%eth0]`). Allowed: an underscore (container and machine names), a trailing dot, the
+    all-interfaces spellings."""
+    if not name or len(name) > HOST_NAME_MAX or not _BIND_CHARS.fullmatch(name):
+        return False
+    if "[" in name or "]" in name:  # brackets go with an IPv6 address (zone allowed); IPv4 in brackets is refused
+        inner = name.strip("[]")  # an unpaired bracket (`[::1`) stays readable: public_bind_problem calls it public
+        return ":" in inner and "[" not in inner and "]" not in inner and _is_ipv6(inner)
+    if ":" in name or "%" in name:
+        return _is_ipv6(name)
+    if _ALL_DIGITS_AND_DOTS.fullmatch(name):  # the system reads short forms and 0 as IPv4; a part above 255 it cannot
+        try:
