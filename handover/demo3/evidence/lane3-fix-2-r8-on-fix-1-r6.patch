+def test_a_zero_inode_number_does_not_stop_a_plain_file(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """Some systems report 0 for st_ino: then only the link test is used (the numbers cannot be compared)."""
+    f = tmp_path / "k.txt"
+    f.write_text(KEY, encoding="utf-8")
+    real_fstat, real_lstat = os.fstat, os.lstat
+
+    def zero(r: os.stat_result) -> os.stat_result:
+        return os.stat_result((r.st_mode, 0, r.st_dev, *tuple(r)[3:]))
+
+    # the open handle says 0; the name says its real number
+    monkeypatch.setattr(os, "fstat", lambda fd: zero(real_fstat(fd)))
+    monkeypatch.setattr(os, "lstat", lambda p, *a, **k: real_lstat(p, *a, **k))
+    assert envnum.read_secret_file(f, "made-up key", "key") == KEY
+    monkeypatch.setattr(os, "lstat", lambda p, *a, **k: zero(real_lstat(p, *a, **k)))
+    assert envnum.read_secret_file(f, "made-up key", "key") == KEY
