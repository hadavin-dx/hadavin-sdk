+            raw = f.read(SECRET_FILE_MAX_BYTES + 1)
+    except OSError:
+        raise SettingRefused(f"the {what} file cannot be read") from None
+    finally:
+        os.close(fd)
+    if len(raw) > SECRET_FILE_MAX_BYTES:
+        raise SettingRefused(f"the {what} file is too large: it must hold only the {noun}")
+    if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
+        raise SettingRefused(f"the {what} file is UTF-16 text: save it as plain UTF-8 text")
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeError:
+        raise SettingRefused(f"the {what} file is not UTF-8 text: save it as plain UTF-8 text") from None
+    if text.endswith("\r\n"):  # the one line break a text editor adds at the end
+        text = text[:-2]
+    elif text.endswith("\n"):
+        text = text[:-1]
+    if "\n" in text or "\r" in text:
+        raise SettingRefused(f"the {what} file has more than one line: it must hold only the {noun}")
+    secret = text.replace(" ", "") if strip_inner_space else text
+    if len(secret) < LIVE_KEY_MIN_CHARS:
+        raise SettingRefused(
+            f"the {what} file is empty or shorter than {LIVE_KEY_MIN_CHARS} characters: it must hold the {noun}"
+        )
+    if not secret.isascii() or not secret.isprintable():  # a tab, a no-break space, an accent, a control character
+        raise SettingRefused(
+            f"the {what} file must hold only plain printable ASCII characters (letters, digits, signs)"
+        )
+    if " " in secret:
+        raise SettingRefused(f"the {what} file's {noun} must not hold a space")
+    return secret
+
+
+def _is_link(path: Path) -> bool:
+    """True when the last part of `path` is a symbolic link (also a broken one or one that loops). Never raises."""
+    try:
+        return stat.S_ISLNK(os.lstat(path).st_mode)
+    except (OSError, ValueError):
+        return False
+
+
+def retry_after_seconds(raw: str | None) -> float | None:
+    """The seconds a Retry-After header names: digits, optionally followed by a point and more digits, with no sign, no
+    exponent and no point at either end (spaces and tabs around it are ignored; ASCII digits only). A number larger than
+    RETRY_AFTER_MAX_SECONDS (also one with so many digits that a float cannot hold it) is read as
+    RETRY_AFTER_MAX_SECONDS. None for a missing header, an HTTP date, junk, a negative number, `inf`, `nan` or `1e999`
+    (none of them is digits with an optional decimal part): the caller then uses its own back-off. The one
+    reader for the desk's HubSpot and live-model kinds, the burst script and the portal demo; `scripts/hubspot_probe.py`
+    and `load_tools/load_driver.py` hold stand-alone copies of this rule (see the module text)."""
+    if raw is None:
+        return None
+    text = raw.strip(" \t")
+    if not (text.isascii() and _RETRY_AFTER.fullmatch(text)):
+        return None
+    try:
+        seconds = float(text)
+    except ValueError:
+        return None
+    return min(seconds, RETRY_AFTER_MAX_SECONDS)  # a text too long for a float is infinity: also the maximum
+
