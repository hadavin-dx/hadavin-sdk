+    hits = [("a.py", 3, "x = open(p)", "f")]
+    key = ("a.py", "f", "x = open(p)")
+    assert _unallowed(hits, {key: (1, "r")}) == ([], [])
+    assert _unallowed(hits, {key: (2, "r")})[1] == [key]
+    assert _unallowed(hits, {})[0] == ["a.py:3 (f): x = open(p)"]
+    assert _unallowed(hits + hits, {key: (1, "r")})[0] == ["a.py:3 (f): x = open(p)"]
+    moved = [("a.py", 3, "x = open(p)", "g")]  # the same line text in another definition does not use the allowance
+    assert _unallowed(moved, {key: (1, "r")}) == (["a.py:3 (g): x = open(p)"], [key])
