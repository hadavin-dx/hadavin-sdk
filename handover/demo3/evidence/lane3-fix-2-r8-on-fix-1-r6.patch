+def test_a_second_look_that_says_link_refuses_whatever_the_open_did(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    f = tmp_path / "k.txt"
+    f.write_text(KEY, encoding="utf-8")
+    real_lstat = os.lstat
+
+    def as_link(path: Any, *args: Any, **kw: Any) -> os.stat_result:
+        r = real_lstat(path, *args, **kw)
+        if Path(path) != f:
+            return r
+        return os.stat_result((stat.S_IFLNK | 0o777, *tuple(r)[1:]))
+
+    monkeypatch.setattr(os, "lstat", as_link)
+    with pytest.raises(SettingRefused) as e:
