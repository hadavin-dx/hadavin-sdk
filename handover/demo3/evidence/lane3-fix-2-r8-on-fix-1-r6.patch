+# a file name is built from parts: a bare name with a web-address ending reads as a web address to the repository scan
+def _n(stem: str, ending: str) -> str:
+    return stem + "." + ending if ending else stem
+
+
+SHELL_FILES = [
+    _n("run", "sh"), _n("run", "ps1"), _n("run", "bat"), _n("run", "cmd"), _n("ci", "yml"), _n("ci", "yaml"),
+    "Makefile", "Dockerfile", _n("docker-compose.override", "yml"),
+]  # fmt: skip
+SHELL_SUFFIXES = {".sh", ".ps1", ".bat", ".cmd", ".yml", ".yaml"}
+SHELL_NAME_STARTS = ("Makefile", "Dockerfile", "docker-compose")
+# and the files at the top of the repository
+SHELL_FOLDERS = ("scripts", "load_tools", "tools", "n8n", "docs", ".github")
+SHELL_READER = re.compile(
+    r"(\bcat\b|\bGet-Content\b|\bgc\b|\btype\b|\bhead\b|\btail\b|\bless\b|\bmore\b|\bsed\b|\bawk\b|\bsource\b"
+    r"|\bmapfile\b|\bread\b|\$\(\s*<|<\s*[\"'$\w]|\bopen\s*\(|\.read_text\b|\.read_bytes\b|\.read\(\))",
+    re.I,
+)
+SHELL_SECRET = re.compile(r"\b(key|password|secret|token)(_?file)?\b", re.I)
+# the key word and a way to read must be on the same line, in either order: a `cat` of a log is not a read of a key
+# (a chosen limit of a tripwire, not a proof)
+
+
+def _reads_a_secret(line: str) -> bool:
+    return bool(SHELL_READER.search(line) and SHELL_SECRET.search(line))
+
+
+def _is_shell_file(p: Path) -> bool:
+    return p.is_file() and (p.suffix in SHELL_SUFFIXES or p.name.startswith(SHELL_NAME_STARTS))
+
+
+def _shell_hits(root: Path, folders: tuple[str, ...]) -> list[str]:
+    files = {p for folder in folders for p in (root / folder).rglob("*") if _is_shell_file(p)}
+    files |= {p for p in root.iterdir() if _is_shell_file(p)}
+    out: list[str] = []
+    for p in sorted(files):
+        for n, line in enumerate(p.read_text(encoding="utf-8").splitlines(), 1):
+            if not line.lstrip().startswith("#") and _reads_a_secret(line):
+                out.append(f"{p.relative_to(root).as_posix()}:{n}")
+    return out
+
