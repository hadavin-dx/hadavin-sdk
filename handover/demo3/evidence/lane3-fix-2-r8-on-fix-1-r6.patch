+    SettingRefused naming the setting (a typo such as `ys` must not silently mean no). The value is not echoed."""
+    word = env.get(name, "").strip().lower()
+    if word in ("", "no"):
+        return False
+    if word == "yes":
+        return True
+    raise SettingRefused(f"{name} must be yes or no")
+
