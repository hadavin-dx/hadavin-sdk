+@pytest.mark.parametrize(
+    "line",
+    [
+        'cat "$KEY_FILE"',
+        "K=$(< key.txt)",
+        "Get-Content $PasswordFile",
+        'IFS= read -r k < "$KEY_FILE"',
+        "$t = gc token.txt",
+        'source "$SECRET_FILE"',
+        "python -c \"print(open('key.txt').read())\"",
+        "python3 -c 'from pathlib import Path; Path(\"secret.txt\").read_text()'",
+        "run: python -c \"import sys; open(sys.argv[1]).read()\" $TOKEN_FILE",
+    ],
+)
+@pytest.mark.parametrize("name", SHELL_FILES)
+def test_the_shell_check_sees_planted_readers_in_any_subfolder_and_any_file_kind(
+    tmp_path: Path, line: str, name: str
+) -> None:
+    sub = tmp_path / "tools" / "a" / "b"
+    sub.mkdir(parents=True)
+    (sub / name).write_text("# cat key.txt in a comment\n" + line + "\n", encoding="utf-8")
+    (tmp_path / name).write_text(line + "\n", encoding="utf-8")  # a file at the top of the repository
+    hits = _shell_hits(tmp_path, ("scripts", "load_tools", "tools"))
+    assert sorted(hits) == sorted([f"tools/a/b/{name}:2", f"{name}:1"])
+
