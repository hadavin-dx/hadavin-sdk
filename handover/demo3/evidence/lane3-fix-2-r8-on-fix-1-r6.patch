+def types_ns(**kw: Any) -> Any:
+    import types
+
+    return types.SimpleNamespace(**kw)
+
+
+# -------------------------------------------------------------------- symbolic links, on every system, with own text
+LINK_TEXT = "the made-up key file is a symbolic link: name the real file"
+
+
