+) -> None:
+    a = tmp_path / "a-key.txt"
+    a.write_text(KEY, encoding="utf-8")
+    b = tmp_path / "b-key.txt"
+    b.write_text(KEY, encoding="utf-8")
+    real_lstat = os.lstat
+
+    def swapped(path: Any, *args: Any, **kw: Any) -> os.stat_result:
+        return real_lstat(b if Path(path) == a else path, *args, **kw)
+
+    monkeypatch.setattr(os, "lstat", swapped)
+    with pytest.raises(SettingRefused) as e:
+        envnum.read_secret_file(a, "made-up key", "key")
