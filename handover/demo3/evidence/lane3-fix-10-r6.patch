+    lines = [ln for ln in out.splitlines() if ln.startswith("refused:")]
+    assert code == EXIT_SCRIPT_SETTING_REFUSED, out[-500:]
+    assert lines == ["refused: a setting or a file named in the config cannot be used"], lines
+    assert "qq2" not in out
+
+
+def test_a_named_reader_failure_ends_the_check_with_one_line_naming_the_group(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    def boom(env: object) -> list[object]:
+        raise PermissionError(13, "denied: /made/up/secret-path-qq3")
+
+    monkeypatch.setattr(rrc, "imap_settings", boom)
+    code = rrc.main(["--dry-fakes", "--assume-yes"])
+    out = capsys.readouterr().out
+    assert code == EXIT_SCRIPT_SETTING_REFUSED, out[-500:]
+    assert "refused: a file named by a REAL_IMAP_* setting cannot be read" in out and "qq3" not in out
