+# --- the same rule for comments and docstrings of the code, and every program that ends with a code has rows ---------
+_NO_PROSE_CHECK = {"constants.py", "db.py"}  # the table itself; db.py speaks of SQLite's own result codes
+
+
+def _prose_of_code_files() -> list[tuple[Path, int, str]]:
+    """(file, line, text) of every comment and docstring in the code of src/, scripts/, load_tools/ and demo_only/,
+    and of
+    every comment line of the shell scripts and every line of the load_tools pages."""
+    import ast
+    import io
+    import tokenize
+
+    found: list[tuple[Path, int, str]] = []
+    files = [
+        *(REPO / "src").rglob("*.py"),
+        *(REPO / "scripts").glob("*"),
+        *(REPO / "load_tools").glob("*.py"),
+        *(REPO / "load_tools").glob("*.md"),
+        *(REPO / "demo_only").glob("*.py"),
+    ]
+    for path in files:
+        if path.name in _NO_PROSE_CHECK or path.is_dir() or path.suffix in {".pyc", ".example"}:
+            continue
+        source = path.read_text(encoding="utf-8")
+        if path.suffix == ".py":
+            for node in ast.walk(ast.parse(source)):
+                if isinstance(node, ast.Module | ast.FunctionDef | ast.AsyncFunctionDef | ast.ClassDef):
+                    doc = ast.get_docstring(node, clean=False)
+                    if doc and node.body:
+                        found.extend((path, node.body[0].lineno + i, ln) for i, ln in enumerate(doc.splitlines()))
+            found.extend(
+                (path, tok.start[0], tok.string)
+                for tok in tokenize.generate_tokens(io.StringIO(source).readline)
+                if tok.type == tokenize.COMMENT
+            )
+        else:
+            found.extend(
+                (path, n, ln)
+                for n, ln in enumerate(source.splitlines(), 1)
+                if path.suffix == ".md" or ln.lstrip().startswith(("#", "<#"))
+            )
+    return found
+
+
+def _code_prose_numbers(lines: list[tuple[Path, int, str]]) -> list[str]:
+    return [
+        f"{path.relative_to(REPO) if path.is_relative_to(REPO) else path}:{number}"
+        for path, number, text in lines
+        if [n for n in _EXIT_NUMBER.findall(text) if n != "0" and int(n) <= _MAX_EXIT_CODE]
+    ]
+
+
+def test_no_comment_or_docstring_of_the_code_gives_an_exit_number() -> None:
+    assert not _code_prose_numbers(_prose_of_code_files())
