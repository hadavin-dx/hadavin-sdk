+# every way a page gives an exit number: "exit 4", "exit code 4", "(exit: 4)", "code 4", "returns/gives/ends with 4",
+# "its own `4`", "with its own 4"
+_EXIT_NUMBER = re.compile(
+    r"(?:\bexit(?:s| code| codes)?\s*[(:]?\s*|\bcode\s+|\b(?:gives|ends with)\s+(?:code\s+)?|\bits own\s+`?)(\d+)\b"
+)
+_MAX_EXIT_CODE = 255  # a larger number after "gives" or "code" is an HTTP status (400, 503), not an exit code
+_TABLE_CODES = {str(code) for _, code, _ in TABLE}
+
+
+def _outside_the_table(text: str) -> list[tuple[int, str]]:
+    kept: list[tuple[int, str]] = []
+    inside = False
+    for number, line in enumerate(text.splitlines(), 1):
+        if render.START in line:
+            inside = True
+        elif render.END in line:
+            inside = False
+        elif not inside:
+            kept.append((number, line))
+    return kept
+
+
+def _prose_numbers(text: str) -> list[tuple[int, str]]:
+    """Lines (outside the generated table) that name a program or the desk and give an exit number other than 0: the
+    numbers live only in the table."""
+    return [
+        (number, line[:90])
+        for number, line in _outside_the_table(text)
+        if any(word in line for word in _PROGRAM_WORDS)
+        and [n for n in _EXIT_NUMBER.findall(line) if n != "0" and int(n) <= _MAX_EXIT_CODE]
+    ]
+
+
+def _numbers_not_in_the_table(text: str) -> list[tuple[int, str]]:
+    """Any exit number, on any line, that is not a code of the table at all (a stale or invented number)."""
+    return [
+        (number, line[:90])
+        for number, line in _outside_the_table(text)
+        if [n for n in _EXIT_NUMBER.findall(line) if n != "0" and int(n) <= _MAX_EXIT_CODE and n not in _TABLE_CODES]
+    ]
+
