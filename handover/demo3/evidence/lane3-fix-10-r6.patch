+REAL_GREP = "/usr/bin/grep" if Path("/usr/bin/grep").exists() else "/bin/grep"
+
+
+def _grep_after_match(stub_dir: Path, pattern: str, then: str) -> None:
+    """A `grep` stand-in first on PATH. It runs the real grep; when the real answer is "found" for a call whose words
+    hold `pattern`, it runs the shell lines `then` ONCE (a flag file) and only then returns the real answer. This
+    puts the
+    test exactly between "the script saw the line" and "the script looks at the process", with no sleep margin."""
+    shim = stub_dir / "grep"
+    shim.write_text(
+        "#!/bin/bash\n"
+        f'{REAL_GREP} "$@"; rc=$?\n'
+        f'if [[ $rc == 0 && "$*" == *{shlex.quote(pattern)}* && ! -e "$SHIM_FLAG" ]]; then\n'
+        f'  touch "$SHIM_FLAG"; {then}\n'
+        "fi\n"
+        "exit $rc\n",
+        encoding="utf-8",
+    )
+    shim.chmod(0o755)
+
+
+_WAIT_GONE = 'for _ in $(seq 1 100); do kill -0 "$pid" 2>/dev/null || break; sleep 0.05; done'
+
+
+def test_a_desk_that_printed_its_line_and_died_is_not_a_start(tmp_path: Path, cleanup: None) -> None:
+    """Bug class: "the line was seen" taken as "the desk is up". The desk prints its listening line and ends; the grep
+    stand-in holds the script until the desk is really gone. Exit with the table's code for a desk that ended (0 is the
+    script's own 1), the "ended at once" line, no "started:", no pid file."""
+    stub = _stub_python(tmp_path, "echo 'desk listening on x'; exit 0")
+    data = tmp_path / "data"
+    _grep_after_match(stub, "desk listening", f'pid="$(cat "$DESK_PID_FILE")"; {_WAIT_GONE}')
+    done = _run(
+        tmp_path, first_on_path=stub, SHIM_FLAG=str(tmp_path / "shim-flag"), DESK_PID_FILE=str(data / "desk.pid")
+    )
+    out = done.stdout + done.stderr
+    assert (tmp_path / "shim-flag").exists(), "the stand-in was never reached"
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert "started:" not in out and "the desk ended at once (exit 0)" in done.stderr, out[-500:]
+    assert not (data / "fakes.pid").exists() and not (data / "desk.pid").exists()
+
+
+def test_a_demo_server_that_dies_between_its_line_and_the_port_answer_is_not_up(tmp_path: Path, cleanup: None) -> None:
+    """The second alive check of the demo-server loop, tested on its own: the demo server prints its ownership line, the
+    stand-in grep then ends it, waits until it is gone and lets this test take its port (a foreign program). The line
+    is there and the port answers, but the process is dead: the desk must never be launched."""
+    port = free_port()
+    marker = tmp_path / "desk-was-started"
+    stub = _stub_python(
+        tmp_path, f"touch {marker}; exec sleep 60", 'echo "fakes server keyed on port $DESK_FAKES_PORT"; exec sleep 60'
+    )
+    data = tmp_path / "data"
+    flag = tmp_path / "shim-flag"
+    taken = tmp_path / "port-taken"
+    _grep_after_match(
+        stub,
+        "^fakes server",
+        f'pid="$(cat "$FAKES_PID_FILE")"; kill "$pid"; {_WAIT_GONE}; '
+        f'touch "$GONE_FLAG"; for _ in $(seq 1 100); do [[ -e "$TAKEN_FLAG" ]] && break; sleep 0.05; done',
+    )
+    gone = tmp_path / "demo-server-gone"
+    held = socket.socket()
+    stop = threading.Event()
+    listening: list[tuple[str, int]] = []
+
+    def take_the_port_when_gone() -> None:
+        while not gone.exists() and not stop.is_set():
+            stop.wait(0.02)
+        if gone.exists():
+            held.bind((LOOPBACK, port))
+            held.listen()
+            listening.append(held.getsockname())
+            taken.touch()
+
+    thread = threading.Thread(target=take_the_port_when_gone)
+    thread.start()
+    try:
+        done = _run(
+            tmp_path,
+            first_on_path=stub,
+            wait="5",
+            DESK_FAKES_PORT=str(port),
+            SHIM_FLAG=str(flag),
+            FAKES_PID_FILE=str(data / "fakes.pid"),
+            GONE_FLAG=str(gone),
+            TAKEN_FLAG=str(taken),
+        )
+    finally:
+        stop.set()
+        thread.join(timeout=10)
+        held.close()
+    out = done.stdout + done.stderr
+    assert flag.exists() and listening == [(LOOPBACK, port)], "the stand-in or the listener did not run: nothing proven"
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert not marker.exists(), "the desk was launched although the demo server was dead"
+    assert "started:" not in out and "the demo server stopped at once" in done.stderr, out[-500:]
+    assert not (data / "fakes.pid").exists()
+
+
+def test_a_missing_timeout_program_is_refused_before_anything_is_started(tmp_path: Path, cleanup: None) -> None:
+    """The port probe needs `timeout` (a connect to a dropped address must not hang the script). Without it: the table's
+    code 1, one fixed line, nothing started. No silent fall back to a probe that can hang."""
+    bin_dir = tmp_path / "onlybin"
+    bin_dir.mkdir()
+    for name in ("bash", "grep", "tail", "sleep", "rm", "mkdir", "cat", "touch", "kill", "seq"):
+        found = shutil.which(name)
+        if found:
+            (bin_dir / name).symlink_to(found)
+    (bin_dir / "python").symlink_to(sys.executable)
+    done = _run_with_path(tmp_path, str(bin_dir))
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, done.stdout, done.stderr)
+    assert done.stderr.strip() == "refused: the program timeout is needed and was not found; nothing was started"
+    assert not (tmp_path / "data" / "fakes.pid").exists()
+
+
+def _run_with_path(tmp: Path, only_path: str) -> subprocess.CompletedProcess[str]:
+    env = child_env(
+        DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_PORT=str(free_port()), DESK_FAKES_PORT=str(free_port())
+    )
+    env["PATH"] = only_path
+    return subprocess.run(  # noqa: S603 - our own script, made-up values, throwaway folder
+        [shutil.which("bash") or "bash", str(REPO / "scripts" / "start_all.sh")],
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+        check=False,
+    )
+
+
+def test_a_slow_port_probe_does_not_stretch_the_wait(tmp_path: Path, cleanup: None) -> None:
+    """The wait is a clock deadline, not a count of short sleeps: every probe here takes about one second (a `timeout`
+    stand-in), the demo server never answers, the budget is 2 seconds. The old count (5 sleeps per second of budget,
+    each
+    followed by a probe) took more than 10 seconds. The line states the seconds really waited."""
+    stub = _stub_python(
+        tmp_path, "exec sleep 120", 'echo "fakes server keyed on port $DESK_FAKES_PORT"; exec sleep 120'
+    )
+    slow = stub / "timeout"
+    real = shutil.which("timeout")
+    assert real
+    slow.write_text(f'#!/bin/bash\nsleep 1\nexec {shlex.quote(real)} "$@"\n', encoding="utf-8")
+    slow.chmod(0o755)
+    start = time.monotonic()
+    done = _run(tmp_path, first_on_path=stub, wait="2")
+    elapsed = time.monotonic() - start
+    assert done.returncode == EXIT_START_NOT_DONE, (done.stdout, done.stderr)
+    assert "the demo server did not answer in " in done.stderr, done.stderr
+    waited = int(done.stderr.split("did not answer in ")[1].split(" ")[0])
+    assert 2 <= waited <= 5 and elapsed < 9, (waited, elapsed)
