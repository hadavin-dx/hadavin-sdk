+    # An empty or whitespace-only text is not a path (Path("") would mean the current folder), and a line end or any
+    # other control character (NUL, tab, newline, escape, DEL) would break a one-line log or a file that repeats it.
+    if not value.strip() or any(ord(ch) < _FIRST_PRINTABLE or ord(ch) == _DEL for ch in value):
