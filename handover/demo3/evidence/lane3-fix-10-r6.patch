new file mode 100644
index 0000000..cb89414
--- /dev/null
+++ b/src/lead_desk/config_exit.py
@@ -0,0 +1,158 @@
+"""The one place that words a refused setting, and the one way for a script to read the settings.
+
+`Config.from_env` raises `SettingRefused` for a bad value. A program that lets that error out shows the person a Python
+traceback. Every program that reads the settings turns the refusal into ONE plain line and an exit code:
+`server.main` (the desk itself), `config_or_exit` (scripts/*.py and the `python -c` helper calls in scripts/*.sh and
+scripts/*.ps1) and scripts/run_real_check.py. All of them build the line with `refusal_line`, so the same bad value
+gives the same words everywhere: one line, control characters removed, cut to LINE_MAX characters, and no value (see
+`scrub_values` for exactly which values are blanked).
+
+Two streams, on purpose, each for one reason. The desk prints its refusal on the OUTPUT stream (stdout), like every
+other start-up message it prints; scripts/start_all.sh keeps all of them in desk.log and the desk tests read stdout.
+The helper (`config_or_exit`) prints on the ERROR stream (stderr), because a shell reads a setting with
+`$(python -c ...)` and a command substitution swallows stdout, so the person would see nothing.
+
+Why `server.main` does not call `config_or_exit`: the desk's refusal ends with EXIT_DESK_SETTING_REFUSED and is on
+stdout (two things the desk's own
+callers and tests rely on), a script's ends with EXIT_SCRIPT_SETTING_REFUSED and is on stderr. `server.main` reads
+`Config.from_env` itself and words the
+refusal with the same `refusal_line`; the structure test (tests/test_setting_reader_guard.py) allows exactly that line.
+
+Exit codes: the one table is `constants.EXIT_CODE_TABLE`, keyed by program. The desk's own refusal is 4; a program that
+reads a setting and finds it refused exits with 8 (`EXIT_SCRIPT_SETTING_REFUSED`)."""
+
+from __future__ import annotations
+
+import os
+import re
+import sys
+import unicodedata
+from collections.abc import Mapping
+from typing import TextIO
+from urllib.parse import urlsplit
+
+from lead_desk.config import Config
+from lead_desk.constants import EXIT_SCRIPT_SETTING_REFUSED, FIXED_ADVICE_TEXTS
+from lead_desk.envnum import SettingRefused
+
+LINE_MAX = 200
+SCRUB_MIN_CHARS = 3  # a value of one or two characters ("0", "no") is also ordinary text in a message
+LONG_VALUE_MIN = 24  # a value this long also has its first and last PART blanked (a message cut short shows a part)
+LONG_VALUE_PART = 12
+VALUE_MARK = "<value>"
+SETTING_PREFIXES = ("DESK_", "LEAD_DESK_", "REAL_")
+_SETTING_NAME = re.compile(r"\b((?:LEAD_)?DESK_[A-Z0-9_]+|REAL_[A-Z0-9_]+)")  # a setting name is kept as it is
+# a setting that holds a secret, an address or a person (a path is not on this list: it is hidden only when the
+# message names it): its value is blanked wherever the message shows it,
+# even when the message does not name the setting
+_SECRET_LIKE = re.compile(r"KEY|PASSWORD|SECRET|TOKEN|USER|FROM|RECIPIENT|ADDRESS|URL|HOST|(?:^|_)TO$")
+
+
+def _forms(value: str) -> set[str]:
+    """The ways a value can appear in an error message: as typed, as Python shows it (repr), and escaped."""
+    forms = {value, repr(value)[1:-1], ascii(value)[1:-1], value.encode("unicode_escape", "backslashreplace").decode()}
+    return {f for f in forms if len(f) >= SCRUB_MIN_CHARS}
+
+
+def _parts_of(value: str) -> set[str]:
+    """The value and the pieces of it a message could show on its own: each list item, the user name and password of
+    a URL, and (for a long value) its first and last LONG_VALUE_PART characters."""
+    parts = {value}
+    parts |= {item.strip() for item in value.split(",")}
+    try:
+        url = urlsplit(value)
+        parts |= {url.username or "", url.password or ""}
+    except ValueError:  # not a URL (a bad bracket, a bad port): nothing more to take from it
+        pass
+    if len(value) >= LONG_VALUE_MIN:
+        parts |= {value[:LONG_VALUE_PART], value[-LONG_VALUE_PART:]}
+    return {p for p in parts if len(p) >= SCRUB_MIN_CHARS}
+
+
+def _pattern(form: str) -> re.Pattern[str]:
+    """The form as a whole token: not a part of a longer word ("low" is a value, "allows" is a word of the message)."""
+    before = r"(?<![A-Za-z0-9])" if form[0].isalnum() else ""
+    after = r"(?![A-Za-z0-9])" if form[-1].isalnum() else ""
+    return re.compile(before + re.escape(form) + after)
+
+
+def scrub_values(text: str, env: Mapping[str, str]) -> str:
+    """`text` without the values of exactly these settings of `env`: the ones the text NAMES (a message about
+    DESK_PORT hides the value of DESK_PORT) and the ones whose name says secret, address or user (a key file, a
+    password, a sender, a URL, a host). Each is hidden in the forms above, and so are its list items, URL user name and
+    password, and the first and last 12 characters of a value of 24 or more. Every other setting keeps its value
+    readable: a limit, an allowed word and a plain number in a message are not hidden by a setting that happens to hold
+    the same text. A setting name inside the text is left alone, and so is a fixed advice text of ours
+    (`constants.FIXED_ADVICE_TEXTS`: it names the setting and the rule and never holds a value, so "set DESK_BIND to a
+    loopback address (127.0.0.1 or ::1)" stays readable even when a host setting holds 127.0.0.1)."""
+    named = set(_SETTING_NAME.findall(text))
+    forms: set[str] = set()
+    for name, value in env.items():
+        if not name.startswith(SETTING_PREFIXES) or not isinstance(value, str):
+            continue
+        if name in named or _SECRET_LIKE.search(name):
+            for part in _parts_of(value):
+                forms |= _forms(part)
+    ordered = sorted(forms, key=len, reverse=True)
+    # the advice texts and the setting names are cut out first; every other piece is scrubbed
+    kept = re.compile("(" + "|".join(re.escape(a) for a in FIXED_ADVICE_TEXTS) + ")")
+    out: list[str] = []
+    for outer_index, outer in enumerate(kept.split(text)):
+        if outer_index % 2 == 1:  # a fixed advice text
+            out.append(outer)
+            continue
+        pieces = _SETTING_NAME.split(outer)  # odd items are the setting names
+        for i in range(0, len(pieces), 2):
+            for form in ordered:
+                pieces[i] = _pattern(form).sub(VALUE_MARK, pieces[i])
+        out.append("".join(pieces))
+    return "".join(out)
+
+
+def plain_line(text: object, values: Mapping[str, str] | None = None) -> str:
+    """`text` as ONE plain line of at most LINE_MAX characters: values scrubbed, every control, format, surrogate and
+    private-use character removed (a terminal could act on them), line ends and runs of spaces collapsed."""
+    scrubbed = scrub_values(str(text), values or {})
+    kept = "".join(" " if ch.isspace() else ch for ch in scrubbed if ch.isspace() or unicodedata.category(ch)[0] != "C")
+    return " ".join(kept.split())[:LINE_MAX]
+
+
+def refusal_line(prefix: str, reason: object, values: Mapping[str, str] | None = None) -> str:
+    """`<prefix> <reason>` as ONE line (see `plain_line`).
+
+    `prefix` is "the desk refuses a setting:", "the desk refuses to start:" or "refused:".
+    """
+    return f"{prefix} {plain_line(reason, values)}"
+
+
+def write_line(line: str, stream: TextIO | None = None) -> None:
+    """THE way a refusal line (or any one plain line a person reads) is written: one line, UTF-8 bytes, flushed. `print`
+    would use the console's code page (cp1252 on a Windows console) and a letter it cannot show would turn a refusal
+    into
+    a Python error report instead of the refusal. `stream` is standard output when not given."""
+    out = sys.stdout if stream is None else stream
+    out.flush()  # text already written to this stream stays in front of the line
+    buffer = getattr(out, "buffer", None)
+    if buffer is None:  # a stream with no byte layer (a test's text buffer): text is all it takes
+        out.write(line + "\n")
+        out.flush()
+        return
+    buffer.write((line + "\n").encode("utf-8"))
+    buffer.flush()
+
+
+def config_or_exit(env: Mapping[str, str] | None = None) -> Config:
+    """`Config.from_env(env)`, or the plain refusal on the error stream and the script exit code."""
+    try:
+        return Config.from_env(env)
+    except SettingRefused as e:
+        line = refusal_line("the desk refuses a setting:", e, os.environ if env is None else env)
+        write_line(line, sys.stderr)
+        raise SystemExit(EXIT_SCRIPT_SETTING_REFUSED) from None
+
+
+if __name__ == "__main__":
+    # `python -m lead_desk.config_exit`: reads text on standard input and prints it as one plain line (a shell script
+    # uses it for the last line of a log file it shows a person); the settings come from the environment
+    # UTF-8 bytes on purpose: print() would use the console's code page on Windows and could fail on a non-ASCII letter
+    write_line(plain_line(sys.stdin.buffer.read().decode("utf-8", "replace"), os.environ))
