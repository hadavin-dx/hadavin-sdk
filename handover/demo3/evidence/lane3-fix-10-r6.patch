+def _collected_ids(node_ids: list[str]) -> set[str]:
+    """What `pytest --collect-only` finds for the named tests (a name that no longer exists is an error)."""
+    done = subprocess.run(  # noqa: S603 - our own interpreter and our own test ids
+        [sys.executable, "-m", "pytest", "--collect-only", "-q", "-p", "no:cacheprovider", *node_ids],
