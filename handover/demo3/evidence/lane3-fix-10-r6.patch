+def _run(
+    argv: list[str], tmp: Path, setting: str, value: str, *, with_bash: bool = False
+) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_LEADFLOW_FILE=FLOW)
+    env.pop("DESK_NUDGE_TO", None)
+    env[setting] = value
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    cmd = ["bash", str(SCRIPTS / argv[0])] if with_bash else [sys.executable, *argv]
+    return subprocess.run(  # noqa: S603 - fixed argv built above, made-up values
+        cmd,
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+    )
+
+
+def _assert_clean_refusal(
+    done: subprocess.CompletedProcess[str], setting: str, value: str, tmp: Path, code: int = EXIT_SCRIPT_SETTING_REFUSED
+) -> None:
+    out = done.stdout + done.stderr
+    lines = [ln for ln in out.splitlines() if ln.strip()]
+    assert done.returncode == code, (done.returncode, out[-400:])
+    assert "Traceback" not in out and 'File "' not in out, out[-400:]
+    assert len(lines) == 1, lines[-5:]  # ONE line
+    assert setting in lines[0], lines[0]  # names the setting
+    assert len(lines[0]) < 300, len(lines[0])
+    probe = value.strip()
+    for piece in (probe[:12], probe[-12:]):  # the value (or a part of it) is never echoed
+        if len(piece) >= 3:
+            assert piece not in out
+    assert "@" not in out  # nothing that looks like an address
+    assert not (tmp / "data").exists()  # a refused start created nothing
+
