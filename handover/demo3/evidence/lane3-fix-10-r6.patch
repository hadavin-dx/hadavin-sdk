@@ -0,0 +1,49 @@
+"""One test for each boundary of `config_exit.scrub_values`, written so that a mutant that moves the boundary fails.
+
+The three boundaries: (1) a setting whose NAME says secret, address or user is blanked wherever its value shows, even
+when the message does not name it; (2) any other setting (a path, a limit) is blanked only when the message names it,
+and stays readable when it does not (the decision of round 5: a message never holds a value by accident, and a
+non-secret path the message does not name is ordinary text); (3) a fixed advice text of ours stays readable even when a
+host setting holds the same words. Made-up values only.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from lead_desk.config_exit import VALUE_MARK, scrub_values
+from lead_desk.constants import PUBLIC_BIND_ADVICE
+
+SECRET_VALUE = "/made/up/keys/" + "hubspot-qq7.txt"
+PATH_VALUE = "/made/up/replies/" + "book-zz3.json"
+
+
+def test_a_secret_like_setting_is_blanked_even_when_the_message_does_not_name_it() -> None:
+    text = f"cannot open {SECRET_VALUE} now"
+    out = scrub_values(text, {"DESK_HUBSPOT_KEY_FILE": SECRET_VALUE})
+    assert SECRET_VALUE not in out and VALUE_MARK in out
+
+
+def test_a_path_setting_is_blanked_when_the_message_names_it() -> None:
+    text = f"DESK_REPLIES_PATH holds {PATH_VALUE}"
+    out = scrub_values(text, {"DESK_REPLIES_PATH": PATH_VALUE})
+    assert PATH_VALUE not in out and "DESK_REPLIES_PATH" in out and VALUE_MARK in out
+
+
+def test_a_path_setting_the_message_does_not_name_stays_readable() -> None:
+    text = f"cannot open {PATH_VALUE} now"
+    out = scrub_values(text, {"DESK_REPLIES_PATH": PATH_VALUE})
+    assert out == text
+
+
+def test_a_fixed_advice_text_stays_readable_when_a_host_setting_holds_its_words() -> None:
+    env = {"DESK_FAKES_HOST": "127.0.0.1"}
+    out = scrub_values(f"refused: {PUBLIC_BIND_ADVICE}", env)
+    assert PUBLIC_BIND_ADVICE in out and VALUE_MARK not in out
+    assert VALUE_MARK in scrub_values("the host 127.0.0.1 is refused", env)  # outside the advice text it is blanked
+
+
+@pytest.mark.parametrize("name", ["DESK_SMTP_FROM", "DESK_LIVE_BASE_URL", "REAL_IMAP_1_USER", "DESK_NUDGE_TO"])
+def test_each_secret_like_name_shape_is_blanked_unnamed(name: str) -> None:
+    value = "made-up-value-" + "k9x2"
+    assert value not in scrub_values(f"it said {value}", {name: value})
diff --git a/tests/test_setting_reader_guard.py b/tests/test_setting_reader_guard.py
new file mode 100644
index 0000000..34ff535
--- /dev/null
+++ b/tests/test_setting_reader_guard.py
@@ -0,0 +1,315 @@
+"""Class guard: nothing reads a setting outside the readers that turn a refusal into a plain line.
+
+The bug class (a bad setting reaching a person as a traceback) comes back whenever a new program reads the settings with
+the bare reader. This test walks the syntax tree of every Python file under src/, scripts/, load_tools/, demo_only/,
+tools/ and the launchers in tests/, and finds: a call of `Config.from_env` (also through an alias of `Config`), a bare
+`from_env` call, and a read of a name that starts with DESK_ or LEAD_DESK_ from `os.environ` or `os.getenv`. The three
+modules that ARE the readers (config.py, envnum.py, config_exit.py) are skipped as files; every other hit must be on the
+allow-list below by file AND exact source line, with its reason. There is no whole-file exemption, and an allowance that
+no longer matches a hit fails the test (so it cannot go stale). The shell and PowerShell scripts are checked by text for
+`Config.from_env`.
+
+Two more bug classes of the same family are guarded here. (1) The other settings readers (`HubspotSettings`,
+`ProviderSettings`, `SmtpSettings`, `LiveSettings` `.from_env`, and `_live_from_env`) are tripwires too: a new caller
+must be allowed by file and line with the reason its refusal becomes a plain line. (2) A path read from setting text
+must go through `envnum.env_path`: a `Path(...)` of an environment subscript or of a `.get` on an environment mapping,
+anywhere under the ROOTS (src/, scripts/, load_tools/, demo_only/, tools/), fails; text that is cut, joined or
+converted on the way (`.strip()`, `str()`, `os.path.expanduser`, an f-string, `+`)
+is still that text (a lone surrogate or a NUL in such
+text crashes whatever prints it later).
+"""
+
+from __future__ import annotations
+
+import ast
+import re
+from pathlib import Path
+
+from support import REPO
+
+from lead_desk.config_exit import SETTING_PREFIXES
+
+READER_FILES = {"src/lead_desk/config.py", "src/lead_desk/envnum.py", "src/lead_desk/config_exit.py"}
+SETTINGS_CLASSES = {"HubspotSettings", "ProviderSettings", "SmtpSettings", "LiveSettings"}
+ENV_NAMES = {"env", "e", "environ", "cfg_env"}  # the names an environment mapping goes by
+ENV_ATTRS = {"environ", "env", "cfg_env"}  # ... and the attribute names (os.environ, self.env)
+ROOTS = ("src", "scripts", "load_tools", "demo_only", "tools")
+PREFIXES = SETTING_PREFIXES  # the one list of setting-name prefixes (lead_desk.config_exit)
+
+# (file, exact stripped source line) -> reason
+ALLOWED: dict[tuple[str, str], str] = {
+    (
+        "src/lead_desk/server.py",
+        "config = Config.from_env()",
+    ): "server.main: the refusal is caught on the next line and worded by _refuse (the shared formatter), exit 4",
+    (
+        "scripts/run_real_check.py",
+        'desk_config = _readable("DESK_*", lambda: Config.from_env({**env, "DESK_PORT": "0"}))',
+    ): "reads a config FILE inside its refusal block: the except words it with refusal_line, exit 8",
+    (
+        "scripts/run_real_check.py",
+        'hs = _readable("DESK_HUBSPOT_*", lambda: HubspotSettings.from_env(env))',
+    ): "inside the same refusal block (refusal_line, exit 8)",
+    (
+        "scripts/run_real_check.py",
+        'pr = _readable("DESK_SMTPP_*", lambda: ProviderSettings.from_env(env))',
+    ): "inside the same refusal block (refusal_line, exit 8)",
+    (
+        "src/lead_desk/smtp_provider.py",
+        "s = ProviderSettings.from_env(os.environ)",
+    ): "the adapter loader: server.main catches its SettingRefused (load_demo_adapters) and words it with _refuse",
+    (
+        "src/lead_desk/smtp_outbox.py",
+        "return SmtpOutbox(SmtpSettings.from_env(env))",
+    ): "the adapter loader: server.main catches its SettingRefused (load_demo_adapters) and words it with _refuse",
+    (
+        "src/lead_desk/crm_hubspot.py",
+        "s = HubspotSettings.from_env(os.environ)",
+    ): "the adapter loader: server.main catches its SettingRefused (load_demo_adapters) and words it with _refuse",
+    (
+        "load_tools/check_invariants.py",
+        'a.model_required = os.environ.get("DESK_QUALIFIER") == "live_claude" or _facts_say_live(facts_path)',
+    ): "compares DESK_QUALIFIER with one word as plain text; no parse, cannot fail",
+    (
+        "load_tools/load_driver.py",
+        'qualifier=os.environ.get("DESK_QUALIFIER", ""),  # lets the checker know the AI step was live',
+    ): "copies DESK_QUALIFIER as plain text into a report; no parse, cannot fail",
+}
+
+
+def _python_files() -> list[Path]:
+    files: list[Path] = []
+    for root in ROOTS:
+        files += sorted((REPO / root).rglob("*.py"))
+    files += sorted((REPO / "tests").glob("*launcher*.py"))
+    return [f for f in files if f.relative_to(REPO).as_posix() not in READER_FILES and "__pycache__" not in f.parts]
+
+
+def _is_environ(node: ast.AST) -> bool:
+    if isinstance(node, ast.Attribute):
+        return node.attr == "environ"
+    return isinstance(node, ast.Name) and node.id == "environ"
+
+
+def _desk_name(node: ast.AST | None) -> bool:
+    return isinstance(node, ast.Constant) and isinstance(node.value, str) and node.value.startswith(PREFIXES)
+
+
+def hits_in(source: str) -> list[tuple[int, str]]:
+    """(line number, what) of every bare read of the settings in one Python source text."""
+    tree = ast.parse(source)
+    config_names = {"Config"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.ImportFrom) and node.module and node.module.endswith("config"):
+            config_names |= {a.asname for a in node.names if a.name == "Config" and a.asname}
+        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Name) and node.value.id in config_names:
+            config_names |= {t.id for t in node.targets if isinstance(t, ast.Name)}
+    found: list[tuple[int, str]] = []
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            fn = node.func
+            if (
+                isinstance(fn, ast.Attribute)
+                and fn.attr == "from_env"
+                and isinstance(fn.value, ast.Name)
+                and fn.value.id in config_names
+            ):
+                found.append((node.lineno, "Config.from_env"))
+            if (
+                isinstance(fn, ast.Attribute)
+                and fn.attr == "from_env"
+                and isinstance(fn.value, ast.Name)
+                and fn.value.id in SETTINGS_CLASSES
+            ):
+                found.append((node.lineno, f"{fn.value.id}.from_env"))
+            if isinstance(fn, ast.Name) and fn.id == "_live_from_env":
+                found.append((node.lineno, "_live_from_env"))
+            if isinstance(fn, ast.Name) and fn.id == "from_env":
+                found.append((node.lineno, "bare from_env"))
+            first = node.args[0] if node.args else None
+            if isinstance(fn, ast.Attribute) and fn.attr == "get" and _is_environ(fn.value) and _desk_name(first):
+                found.append((node.lineno, "environ.get"))
+            if isinstance(fn, ast.Attribute) and fn.attr == "getenv" and _desk_name(first):
+                found.append((node.lineno, "getenv"))
+            if isinstance(fn, ast.Name) and fn.id == "getenv" and _desk_name(first):
+                found.append((node.lineno, "getenv"))
+        if isinstance(node, ast.Subscript) and _is_environ(node.value) and _desk_name(node.slice):
+            found.append((node.lineno, "environ[...]"))
+    return found
+
+
+def test_the_detector_finds_each_kind_of_bare_read() -> None:
+    src = (
+        "import os\nfrom os import environ, getenv\nfrom lead_desk.config import Config as C\nX = C\n"
+        "a = C.from_env()\nb = X.from_env({})\nc = from_env()\nd = os.environ['DESK_PORT']\n"
+        "e = os.environ.get('DESK_BIND')\nf = getenv('LEAD_DESK_X')\ng = environ['DESK_Y']\nh = os.environ['HOME']\n"
+        "i = HubspotSettings.from_env(env)\nj = LiveSettings.from_env(env)\n"
+        "k = _live_from_env(env)\nl = Other.from_env(env)\n"
+    )
+    assert sorted(line for line, _ in hits_in(src)) == [5, 6, 7, 8, 9, 10, 11, 13, 14, 15]
+
+
+def _env_like(node: ast.AST) -> bool:
+    if isinstance(node, ast.Attribute):
+        return node.attr in ENV_ATTRS
+    return isinstance(node, ast.Name) and node.id in ENV_NAMES
+
+
+def _env_source(node: ast.AST, tainted: set[str]) -> bool:
+    """True when the expression is text read from an environment mapping (or from a name that holds such text)."""
+    if isinstance(node, ast.Subscript):
+        return _env_like(node.value)
+    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in {"get", "getenv"}:
+        return _env_like(node.func.value) or node.func.attr == "getenv"
+    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == "getenv":
+        return True
+    if isinstance(node, ast.BoolOp):  # `x or default`, `x and y`: any operand
+        return any(_env_source(v, tainted) for v in node.values)
+    if isinstance(node, ast.IfExp):
+        return _env_source(node.body, tainted) or _env_source(node.orelse, tainted)
+    if isinstance(node, ast.NamedExpr):
+        return _env_source(node.value, tainted)
+    if isinstance(node, ast.Name):
+        return node.id in tainted
+    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute) and node.func.attr in _TEXT_METHODS:
+        return _env_source(node.func.value, tainted)  # x.strip(), x.rstrip("/"), x.replace(...)
+    if isinstance(node, ast.Call) and _text_function(node.func):
+        return any(_env_source(arg, tainted) for arg in node.args)  # str(x), os.path.expanduser(x), os.fspath(x)
+    if isinstance(node, ast.JoinedStr):  # an f-string that holds such text
+        return any(isinstance(v, ast.FormattedValue) and _env_source(v.value, tainted) for v in node.values)
+    if isinstance(node, ast.BinOp):  # x + "/sub", "%s" % x
+        return _env_source(node.left, tainted) or _env_source(node.right, tainted)
+    return False
+
+
+_TEXT_METHODS = {"strip", "lstrip", "rstrip", "replace", "format", "lower", "upper", "removeprefix", "removesuffix"}
+_TEXT_FUNCTIONS = {"str", "fspath", "expanduser", "expandvars", "normpath", "abspath"}
+
+
+def _text_function(fn: ast.AST) -> bool:
+    name = fn.id if isinstance(fn, ast.Name) else fn.attr if isinstance(fn, ast.Attribute) else ""
+    return name in _TEXT_FUNCTIONS
+
+
+def bare_paths_in(source: str) -> list[int]:
+    """Line numbers of a `Path(...)` built from text that came out of an environment mapping.
+
+    The text may be an environment subscript, a `.get` or `getenv` of one, `x or default` of those, or a NAME that was
+    assigned from any of them earlier in the file (followed to a fixed point, so a name copied from a name counts).
+    Environment mappings are the names in ENV_NAMES and the attributes in ENV_ATTRS (`os.environ`, `self.env`).
+    """
+    tree = ast.parse(source)
+    tainted: set[str] = set()
+    changed = True
+    while changed:
+        changed = False
+        for node in ast.walk(tree):
+            pairs: list[tuple[ast.AST, ast.AST | None]] = []
+            if isinstance(node, ast.Assign):
+                pairs = [(t, node.value) for t in node.targets]
+            elif isinstance(node, ast.AnnAssign | ast.NamedExpr):
+                pairs = [(node.target, node.value)]
+            for target, value in pairs:
+                if (
+                    isinstance(target, ast.Name)
+                    and value is not None
+                    and target.id not in tainted
+                    and _env_source(value, tainted)
+                ):
+                    tainted.add(target.id)
+                    changed = True
+    found: list[int] = []
+    for node in ast.walk(tree):
+        if not (isinstance(node, ast.Call) and node.args):
+            continue
+        fn = node.func
+        named_path = isinstance(fn, ast.Name) and fn.id == "Path"
+        is_path = named_path or (isinstance(fn, ast.Attribute) and fn.attr == "Path")
+        if is_path and _env_source(node.args[0], tainted):
+            found.append(node.lineno)
+    return found
+
+
+def test_the_path_detector_finds_each_kind_of_bare_path() -> None:
+    src = (
+        "from pathlib import Path\nimport os\n"
+        "a = Path(env['X'])\nb = Path(e['X'])\nc = Path(env.get('X', 'y'))\nd = Path(os.environ['X'])\n"
+        "f = Path(os.getenv('X'))\ng = Path(env[p + 'F'])\nh = Path('literal')\ni = Path(argv[1])\n"
+        "j = Path(env_path(env, 'X'))\n"
+    )
+    assert sorted(bare_paths_in(src)) == [3, 4, 5, 6, 7, 8]
+
+
+def test_the_path_detector_finds_the_wider_shapes() -> None:
+    """Each shape is planted alone; each must be found (and the safe look-alikes must not be)."""
+    shapes = {
+        "assigned name": "x = env['K']\nq = Path(x)\n",
+        "assigned from get": "x = env.get('K')\nq = Path(x)\n",
+        "name copied from a name": "x = env['K']\ny = x\nq = Path(y)\n",
+        "or default": "q = Path(env.get('K') or 'd')\n",
+        "name or default": "x = env.get('K')\nq = Path(x or 'd')\n",
+        "attribute receiver": "q = Path(self.env['K'])\n",
+        "attribute get": "q = Path(self.env.get('K'))\n",
+        "cfg_env receiver": "q = Path(cfg_env['K'])\n",
+        "conditional": "q = Path(env['K'] if flag else 'd')\n",
+        "annotated assign": "x: str = env['K']\nq = Path(x)\n",
+        "walrus": "q = Path(x := env['K'])\n",
+        "pathlib.Path": "import pathlib\nq = pathlib.Path(env['K'])\n",
+        "os.environ get with default": "q = Path(os.environ.get('K', 'd'))\n",
+        "strip": "q = Path(env['K'].strip())\n",
+        "strip of a name": "x = env['K']\nq = Path(x.strip())\n",
+        "strip of a get": "q = Path(env.get('K', '').strip())\n",
+        "str": "q = Path(str(env['K']))\n",
+        "expanduser": "import os\nq = Path(os.path.expanduser(env['K']))\n",
+        "f-string": "q = Path(f\"{env['K']}/sub\")\n",
+        "plus": "q = Path(env['K'] + '/sub')\n",
+    }
+    for label, body in shapes.items():
+        assert bare_paths_in(body), label
+    safe = {
+        "helper": "x = env_path(env, 'K')\nq = Path(x)\n",
+        "literal": "x = 'a'\nq = Path(x)\n",
+        "argv": "x = argv[1]\nq = Path(x or 'd')\n",
+        "tainted name used elsewhere": "x = env['K']\nq = Path('lit')\nprint(x)\n",
+        "strip of a literal": "q = Path('lit'.strip())\n",
+        "f-string of a literal": 'q = Path(f"{base}/sub")\n',
+    }
+    for label, body in safe.items():
+        assert not bare_paths_in(body), label
+
+
+def test_no_path_is_read_from_setting_text_except_through_the_one_helper() -> None:
+    offenders: list[str] = []
+    for root in ROOTS:
+        for path in sorted((REPO / root).rglob("*.py")):
+            rel = path.relative_to(REPO).as_posix()
+            if "__pycache__" in path.parts or rel == "src/lead_desk/envnum.py":
+                continue
+            offenders += [f"{rel}:{n}" for n in bare_paths_in(path.read_text(encoding="utf-8"))]
+    assert offenders == [], offenders
+
+
+def test_no_program_reads_the_settings_outside_the_readers() -> None:
+    offenders: list[str] = []
+    used: set[tuple[str, str]] = set()
+    for path in _python_files():
+        rel = path.relative_to(REPO).as_posix()
+        text = path.read_text(encoding="utf-8")
+        lines = text.splitlines()
+        for number, what in hits_in(text):
+            key = (rel, lines[number - 1].strip())
+            if key in ALLOWED:
+                used.add(key)
+            else:
+                offenders.append(f"{rel}:{number} {what}")
+    assert offenders == [], offenders
+    assert set(ALLOWED) == used, f"an allowance matches nothing now: {sorted(set(ALLOWED) - used)}"
+
+
+def test_the_shell_and_powershell_scripts_never_call_the_bare_reader() -> None:
+    bare = re.compile(r"Config\.from_env\(")
+    for path in sorted((REPO / "scripts").iterdir()):
+        if path.suffix in {".sh", ".ps1"}:
+            assert not bare.search(path.read_text(encoding="utf-8")), path.name
+            named = {"start_all.sh", "start_all.ps1", "reset.sh", "reset.ps1"}
+            assert "config_or_exit" in path.read_text(encoding="utf-8") or path.name not in named
