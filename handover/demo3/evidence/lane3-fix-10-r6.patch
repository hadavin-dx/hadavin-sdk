+@pytest.mark.parametrize(("setting", "value"), BAD_VALUES, ids=lambda v: repr(v)[:24])
+@pytest.mark.parametrize(("name", "argv"), PY_ENTRY_POINTS, ids=[n for n, _ in PY_ENTRY_POINTS])
+def test_bad_setting_is_a_clean_refusal_in_every_python_entry_point(
+    name: str, argv: list[str], setting: str, value: str, tmp_path: Path
+) -> None:
+    code = EXIT_DESK_SETTING_REFUSED if name in DESK_OWN else EXIT_SCRIPT_SETTING_REFUSED
+    _assert_clean_refusal(_run(argv, tmp_path, setting, value), setting, value, tmp_path, code)
