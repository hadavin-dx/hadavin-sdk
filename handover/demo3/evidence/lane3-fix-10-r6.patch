+
+# -- row 18: the child-environment prefixes are a subset of the one list -----------------------------------------------
+def test_the_prefixes_the_check_passes_on_are_a_subset_of_the_one_list() -> None:
+    assert set(rrc.CHILD_ENV_PREFIXES) <= set(SETTING_PREFIXES)
+    assert rrc.CHILD_ENV_PREFIXES, "an empty tuple would pass nothing on"
+
+
+# -- row 19: an optional file setting that is empty or white space means unset; a required one is refused ---------
+@pytest.mark.parametrize("empty", ["", " ", "\t"])
+def test_an_empty_optional_ca_file_is_unset_and_an_empty_password_file_is_refused(empty: str) -> None:
+    base = {"REAL_IMAP_1_USER": "someone", "REAL_IMAP_1_PASSWORD_FILE": "pw.txt"}
+    inboxes = rrc.imap_settings({**base, "REAL_IMAP_1_CA_FILE": empty})
+    assert len(inboxes) == 1 and inboxes[0].ssl_context is None
+    with pytest.raises(SettingRefused, match="REAL_IMAP_1_PASSWORD_FILE is required"):
+        rrc.imap_settings({**base, "REAL_IMAP_1_PASSWORD_FILE": empty})
