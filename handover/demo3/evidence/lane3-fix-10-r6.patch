+        (tmp_path / "b.sh", 1, "# exits 3 when too few files"),
+        (tmp_path / "c.py", 2, "the portal gives 503 and exit 0 is fine"),
+    ]
+    assert _code_prose_numbers(sample) == [f"{tmp_path / 'a.py'}:3", f"{tmp_path / 'b.sh'}:1"]
