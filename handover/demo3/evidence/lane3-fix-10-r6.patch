+    assert fs.FakesServer6.address_family == socket.AF_INET6 and issubclass(fs.FakesServer6, fs.FakesServer)
+
+
+def test_the_demo_server_command_line_takes_a_host(monkeypatch: pytest.MonkeyPatch) -> None:
+    import demo_only.fakes_server as fs
+
+    seen: dict[str, object] = {}
+
+    class Stop(Exception):
+        pass
