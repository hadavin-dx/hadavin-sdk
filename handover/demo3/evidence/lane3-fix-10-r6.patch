+"""Round 5 of fix-10: the demo server binds the configured host, the formatter writes UTF-8 bytes, a reader that cannot
+open a file names its setting group, and the two lists of setting prefixes agree. Made-up data, loopback only."""
+
+from __future__ import annotations
+
+import socket
+import subprocess
+import sys
+import threading
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env
+
+sys.path.insert(0, str(REPO / "scripts"))
