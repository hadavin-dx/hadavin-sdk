+from lead_desk.config_exit import SETTING_PREFIXES  # noqa: E402
+from lead_desk.constants import EXIT_SCRIPT_SETTING_REFUSED  # noqa: E402
+from lead_desk.envnum import SettingRefused  # noqa: E402
+
+
+def _ipv6_loopback() -> bool:
+    try:
+        with socket.socket(socket.AF_INET6) as probe:
+            probe.bind(("::1", 0))
+        return True
+    except OSError:
+        return False
+
+
+# -- row 2: the demo server binds the host it is given --------------------------------------------------------------
+def test_the_demo_server_binds_the_ipv4_host_it_is_given() -> None:
+    srv = make_fakes_server("keyed", 0, host="127.0.0.1")
+    try:
+        assert srv.server_address[0] == "127.0.0.1" and srv.address_family == socket.AF_INET
+    finally:
+        srv.server_close()
+
+
+@pytest.mark.skipif(
+    not _ipv6_loopback(),
+    reason="no IPv6 on this computer (checked 2026-11-14: AF_INET6 sockets are refused by this kernel)",
+)
+@pytest.mark.parametrize("host", ["::1", "[::1]"])
+def test_the_demo_server_binds_an_ipv6_host_and_answers_there(host: str) -> None:
+    srv = make_fakes_server("keyed", 0, host=host)
+    thread = threading.Thread(target=srv.serve_forever, daemon=True)
+    thread.start()
+    try:
+        assert srv.address_family == socket.AF_INET6 and srv.server_address[0] == "::1"
+        port = srv.server_address[1]
+        with socket.create_connection(("::1", port), timeout=3):
+            pass
+        with socket.socket(socket.AF_INET) as v4, pytest.raises(OSError):
+            v4.settimeout(1)
+            v4.connect(("127.0.0.1", port))  # bound to ::1 only
+    finally:
+        srv.shutdown()
+        srv.server_close()
+        thread.join(timeout=5)
+
+
+@pytest.mark.parametrize(
+    ("host", "family", "address"),
