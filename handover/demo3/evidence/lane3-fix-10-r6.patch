+"""Every refusal line is written as UTF-8 bytes through ONE function (`config_exit.write_line`), so a console whose code
+page cannot show a letter (PYTHONIOENCODING=cp1252 here, a Windows console in life) does not turn a refusal into a
+Python
+error report with exit code 1. Bug class: `print(line)` of text that may hold any letter of a person's file or setting
+name. The letter below is not in cp1252. Made-up text only."""
+
+from __future__ import annotations
+
+import ast
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+from support import REPO
+
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED, EXIT_SCRIPT_SETTING_REFUSED
+
+LETTER = "अ"  # DEVANAGARI LETTER A: kept by the plain-line rules, not in cp1252
+
+
+def _run(code: str) -> subprocess.CompletedProcess[bytes]:
+    env = {**os.environ, "PYTHONPATH": "src:.", "PYTHONIOENCODING": "cp1252", "PYTHONUTF8": "0"}
+    return subprocess.run(  # noqa: S603 - our own interpreter and code
+        [sys.executable, "-c", code], cwd=REPO, env=env, capture_output=True, timeout=60, check=False
+    )
+
+
+def test_the_desks_own_refusal_is_utf8_on_a_cp1252_console() -> None:
+    done = _run(f"from lead_desk.server import _refuse; _refuse('the desk refuses a setting:', 'name {LETTER} here')")
+    assert done.returncode == EXIT_DESK_SETTING_REFUSED, (done.returncode, done.stderr[-300:])
+    assert (
+        done.stdout == f"the desk refuses a setting: name {LETTER} here\n".encode() and b"Traceback" not in done.stderr
+    )
+
+
+def test_the_open_file_limit_line_is_utf8_on_a_cp1252_console() -> None:
+    code = (
+        "from lead_desk import server\n"
+        f"def boom(): raise server.DescriptorBudgetError('limit {LETTER}')\n"
+        "server.ensure_descriptor_budget = boom\n"
+        "server.main()"
+    )
+    done = _run(code)
+    assert done.stdout == f"limit {LETTER}\n".encode() and b"Traceback" not in done.stderr, done.stderr[-300:]
+
+
+def test_a_script_reading_a_bad_setting_prints_utf8_on_a_cp1252_console() -> None:
+    code = (
+        "from lead_desk import config_exit as ce\n"
+        "from lead_desk.config import SettingRefused\n"
+        f"def boom(env=None): raise SettingRefused('name {LETTER} here')\n"
+        "ce.Config.from_env = staticmethod(boom)\n"
+        "ce.config_or_exit({})"
+    )
+    done = _run(code)
+    assert done.returncode == EXIT_SCRIPT_SETTING_REFUSED, (done.returncode, done.stderr[-300:])
+    assert f"name {LETTER} here\n".encode() in done.stderr and b"Traceback" not in done.stderr
+
+
+def test_no_refusal_line_is_printed_with_print_in_the_tree() -> None:
+    """Sibling search: `print(refusal_line(` or `print(plain_line(` anywhere in src/ or scripts/ is the bug."""
+    bad: list[str] = []
+    for folder in ("src", "scripts"):
+        for path in (REPO / folder).rglob("*.py"):
+            tree = ast.parse(path.read_text(encoding="utf-8"))
+            for node in ast.walk(tree):
+                if (
+                    isinstance(node, ast.Call)
+                    and isinstance(node.func, ast.Name)
+                    and node.func.id == "print"
+                    and node.args
+                    and isinstance(node.args[0], ast.Call)
+                    and isinstance(node.args[0].func, ast.Name)
+                    and node.args[0].func.id in {"refusal_line", "plain_line"}
+                ):
+                    bad.append(f"{path.relative_to(REPO)}:{node.lineno}")
+    assert not bad, bad
+
+
+def test_the_one_function_exists_and_writes_bytes() -> None:
+    assert Path(REPO / "src" / "lead_desk" / "config_exit.py").read_text(encoding="utf-8").count("def write_line(") == 1
