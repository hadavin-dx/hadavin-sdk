    def read_secret_file(path: Path, what: str, noun: str, *, strip_inner_space: bool = False) -> str:
        """The one rule for every secret file (a key or a password): a regular file (a folder, a named pipe or a device is
        refused without being read), one line, at most SECRET_FILE_MAX_BYTES, UTF-8 (a byte-order mark is accepted), at
        least LIVE_KEY_MIN_CHARS printable ASCII characters and no space or other blank inside. `strip_inner_space=True`
        (the SMTP password only: providers show an app password in groups of letters) drops the plain spaces (U+0020) inside
        instead of refusing them; a tab, a no-break space or any other blank inside is still refused. `what` names the file
        in every text ("the {what} file ...") and `noun` the content ("key" or "password"). A refusal is a SettingRefused
        whose text is fixed: it holds neither the path nor the content. The kinds wrap it in their own error
        type; none imports another."""
        try:
            # O_NONBLOCK: opening a named pipe for reading would wait for a writer; the check below refuses it instead
            fd = os.open(path, os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_BINARY", 0))
        except (OSError, ValueError):  # ValueError: an embedded NUL in the path
            raise SettingRefused(f"the {what} file cannot be read") from None  # the OS error holds the path
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):  # on the open handle: nothing can be swapped in after the check
                raise SettingRefused(f"the {what} file cannot be read")
            with os.fdopen(fd, "rb", closefd=False) as f:
                raw = f.read(SECRET_FILE_MAX_BYTES + 1)
        except OSError:
            raise SettingRefused(f"the {what} file cannot be read") from None
        finally:
            os.close(fd)
        if len(raw) > SECRET_FILE_MAX_BYTES:
            raise SettingRefused(f"the {what} file is too large: it must hold only the {noun}")
        if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
            raise SettingRefused(f"the {what} file is UTF-16 text: save it as plain UTF-8 text")
        try:
            text = raw.decode("utf-8-sig").strip()
        except UnicodeError:
            raise SettingRefused(f"the {what} file is not UTF-8 text: save it as plain UTF-8 text") from None
        if "\n" in text or "\r" in text:
            raise SettingRefused(f"the {what} file has more than one line: it must hold only the {noun}")
        secret = text.replace(" ", "") if strip_inner_space else text
        if len(secret) < LIVE_KEY_MIN_CHARS:
