    def test_two_threads_playing_two_workers_get_distinct_numbers_inside_their_own_ranges(
        monkeypatch: pytest.MonkeyPatch,
    ) -> None:
        """Two threads that call free_port() 200 times each, started together by a barrier. (It is a stand-in for two
        xdist workers: the real run with -n is in raw/b16-xdist.log.) A mutant that gives every worker the same range
        fails it."""
        environ = _PerThreadEnviron()
        monkeypatch.setattr(support, "os", _OsWithPerThreadEnviron(environ))
        start = threading.Barrier(2)
        got: dict[str, list[int]] = {}
    
        def play(worker: str) -> None:
            environ.worker_of_thread[threading.get_ident()] = worker
            start.wait(timeout=10)  # both threads call free_port() together
            got[worker] = [free_port() for _ in range(200)]
    
        threads = [threading.Thread(target=play, args=(name,)) for name in ("gw0", "gw1")]
        for t in threads:
            t.start()
        for t in threads:
            t.join(timeout=120)
        assert not any(t.is_alive() for t in threads), "a worker thread did not finish"
        assert set(got) == {"gw0", "gw1"}
        for worker, numbers in got.items():
            low, high = support.worker_port_range(worker, "2") or (0, 0)
