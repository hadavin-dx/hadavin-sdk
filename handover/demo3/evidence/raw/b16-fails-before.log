tests/test_port_helpers.py:123: AssertionError
__ test_a_restarted_worker_never_gets_the_block_of_a_worker_that_is_alive[1] ___

count = 1

    @pytest.mark.parametrize("count", range(1, 65))
    def test_a_restarted_worker_never_gets_the_block_of_a_worker_that_is_alive(count: int) -> None:
        """xdist starts gw<count>, gw<count+1> ... when a worker dies, while the others go on. Every worker number from 0
        to 2*count-1 has a block, the first `count` and the second `count` numbers are each disjoint among themselves, and a
        restarted block is disjoint from every first block (the dead worker's block is not known to the new one)."""
        first = [support.worker_port_range(f"gw{n}", str(count)) for n in range(count)]
