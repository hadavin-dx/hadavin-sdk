    @_posix
    def test_the_guard_line_refuses_a_shell_that_runs_double_brackets_but_has_no_bash_version_info() -> None:
        """zsh and busybox ash run `[[ ]]` but are not bash. They are not installed here, so the guard's own test is run
        in bash with BASH_VERSINFO made unreadable to it by a plain `unset`-like stand-in: the same test line, evaluated
        where the variable is empty, must say no."""
        text = _script_text()
        line = next(row for row in text.splitlines() if row.startswith("case ") and "bash)" in row)
        inner = re.search(r"eval '([^']*)'", line)
        assert inner is not None
        probe = f"(eval '{inner.group(1).replace('BASH_VERSINFO', 'NO_SUCH_VARIABLE')}') 2>/dev/null && echo bash || echo no"
        done = subprocess.run(  # noqa: S603 (a fixed bash line)
            [shutil.which("bash") or "bash", "-c", probe], capture_output=True, text=True, check=False
        )
