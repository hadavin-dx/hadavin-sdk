    @_posix
    def test_alive_counts_a_process_it_may_not_signal_as_alive_and_a_missing_one_as_gone() -> None:
        """Process 1 belongs to another user: kill -0 answers "Operation not permitted" (EPERM), which is not "gone". Run as
        root the signal is allowed, so then the user nobody tries it; skipped where that is impossible."""
        as_nobody = hasattr(os, "geteuid") and os.geteuid() == 0
        if as_nobody and not (shutil.which("runuser") and shutil.which("id")):
            pytest.skip("running as root without runuser: the signal is never refused")
        if as_nobody and _alive_answer(1, as_nobody=True) not in (0, 1):
            pytest.skip("the user nobody cannot run bash here")
        if not Path("/proc/1").exists():
            pytest.skip("no process 1 to test with")
