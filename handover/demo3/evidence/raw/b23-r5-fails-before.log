name = 'DESK_HUBSPOT_KEY_FILE', cls = 'HubspotSettings', bad = 'a\nb'

    @pytest.mark.parametrize("bad", BAD_PATH_TEXTS)
    @pytest.mark.parametrize(("name", "cls"), ADAPTER_PATH_NAMES)
    def test_a_path_that_is_not_valid_text_is_refused_by_every_adapter_reader(name: str, cls: str, bad: str) -> None:
        """The adapters' own readers (crm_hubspot, smtp_provider) use the same path helper as Config."""
        from lead_desk.crm_hubspot import HubspotSettings
        from lead_desk.smtp_provider import ProviderSettings
    
        good = {
            "HubspotSettings": {"DESK_HUBSPOT_KEY_FILE": "k.txt", "DESK_HUBSPOT_MAX_CALLS": "10"},
            "ProviderSettings": {
                "DESK_SMTPP_HOST": "127.0.0.1",
                "DESK_SMTPP_USER": "user",
                "DESK_SMTPP_PASSWORD_FILE": "p.txt",
                "DESK_SMTPP_FROM": "a@example.test",
                "DESK_SMTPP_RECIPIENTS": "b@example.test",
                "DESK_SMTPP_MAX_SENDS": "5",
            },
        }[cls]
        reader = {"HubspotSettings": HubspotSettings, "ProviderSettings": ProviderSettings}[cls]
        reader.from_env(good)  # the baseline is accepted
        optional = name.endswith(("STATS_FILE", "CA_FILE"))
        if optional and not bad.strip():
            reader.from_env({**good, name: bad})  # an optional file setting that is only white space means unset
            return
>       with pytest.raises(SettingRefused, match=f"{name} (is not a valid path|is required)"):
