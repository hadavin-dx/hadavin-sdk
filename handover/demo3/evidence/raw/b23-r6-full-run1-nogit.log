        for f in (patterns, exceptions, toml):
            assert f.is_file(), f"missing {f.name} (this test needs it)"
        # 1. canaries: a temp repo with one planted value per kind, plus values that must be allowed
        canary = tmp_path / "canary"
        canary.mkdir()
        _git(canary, "init", "-q")
