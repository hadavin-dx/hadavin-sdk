    def test_no_script_reads_the_settings_outside_the_shared_reader() -> None:
        """Class guard: a new script that calls the bare reader (the bug) fails here. run_real_check.py reads a config FILE
        in its own refusal block (`except ValueError`, prints `refused: ...`), so it is the one named exception."""
        allowed = {"run_real_check.py"}
        bare = re.compile(r"Config\.from_env\(")
        offenders: list[str] = []
        for path in sorted(SCRIPTS.iterdir()):
            if path.suffix not in {".py", ".sh", ".ps1"} or path.name in allowed:
                continue
            for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                if bare.search(line):
                    offenders.append(f"{path.name}:{number}")
