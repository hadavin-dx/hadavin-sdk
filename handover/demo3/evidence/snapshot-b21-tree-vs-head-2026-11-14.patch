+def test_the_ps_text_fallback_decides_the_same_way(tmp_path: Path, line: str, stopped: bool) -> None:
+    """Function level: reset.sh's is_ours() is run alone on a process number that no process holds (so /proc cannot be
+    read and the ps text is the only source) with each ps line. A live process is always read from /proc, so this
+    fallback cannot be reached end to end on Linux: this test names its level instead of pretending."""
+    text = (REPO / "scripts" / SCRIPT).read_text(encoding="utf-8")
+    body = text[text.index("is_ours() {") :]
+    body = body[: body.index("\n}\n") + 3]
+    done = subprocess.run(  # noqa: S603 (fixed lines)
+        [str(shutil.which("bash")), "-c", body + f'\nis_ours {dead_pid()} "$1"', "bash", line],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert done.returncode == (0 if stopped else 1), (line, done.returncode, done.stderr)
