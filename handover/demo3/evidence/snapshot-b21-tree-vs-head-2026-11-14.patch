+def test_alive_reads_the_refusal_in_the_c_locale_so_a_translated_message_is_still_alive() -> None:
+    """Function level, with a simulated locale (no non-English locale is installed on this machine, so the real
+    translation cannot be produced here: a named machine limit). A stand-in `kill` answers "Operation not permitted"
+    when
+    it is called with LC_ALL=C and a translated line otherwise; `ps` answers a running state. alive() must say alive.
+    Kills: removing `LC_ALL=C` from the kill call inside alive()."""
+    text = _script_text()
+    body = text[text.index("alive() {") :]
+    body = body[: body.index("\n}\n") + 3]
+    prelude = (
+        'kill() { if [[ "${LC_ALL:-}" == C ]]; then echo "kill: (1) - Operation not permitted" >&2; '
+        'else echo "kill: (1) - Operation non permise" >&2; fi; return 1; }\n'
+        "ps() { echo S; }\n"
+    )
+    done = subprocess.run(  # noqa: S603 (fixed lines)
+        [shutil.which("bash") or "bash", "-c", prelude + body + "\nalive 12345"],
+        env={**os.environ, "LC_ALL": "C.UTF-8"},
+        capture_output=True,
+        check=False,
+    )
+    assert done.returncode == 0, done.stderr
