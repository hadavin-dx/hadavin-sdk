+def test_a_restarted_worker_never_gets_the_block_of_a_worker_that_is_alive(count: int) -> None:
+    """xdist starts gw<count>, gw<count+1> ... when a worker dies, while the others go on. Every worker number from 0
+    to 2*count-1 has a block, the first `count` and the second `count` numbers are each disjoint among themselves, and a
+    restarted block is disjoint from every first block (the dead worker's block is not known to the new one)."""
+    first = [support.worker_port_range(f"gw{n}", str(count)) for n in range(count)]
+    again = [support.worker_port_range(f"gw{n}", str(count)) for n in range(count, 2 * count)]
+    assert None not in first and None not in again
+    blocks = [b for b in first + again if b is not None]
+    assert _all_disjoint([b for b in first if b is not None]), (count, first)
+    assert _all_disjoint([b for b in again if b is not None]), (count, again)
+    assert _all_disjoint(blocks), (count, "a restarted block overlaps a live one")
+    assert all(20000 <= low <= high <= 32767 for low, high in blocks), (count, blocks)
+    assert all(high - low + 1 >= 24 for low, high in blocks), (count, "a block is too narrow to be of use")
