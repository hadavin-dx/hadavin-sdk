+        (book.parent / "desk.pid").write_text(str(child.pid), encoding="utf-8")
+        done = reset_run(SH, book, first_on_path=folder, **reset_ports())
+    finally:
+        child.kill()
+        child.wait()
+        if child.stdout is not None:
+            child.stdout.close()
+        if child.stdin is not None:
+            child.stdin.close()
+    assert done.returncode != 6 and "could not be read" not in done.stderr, (done.returncode, done.stderr)
+    assert not (book.parent / "desk.pid").exists(), "a stale pid file must be deleted"
+
+
+def _python_stand_in(folder: Path, *, fail_from_call: int, status: int) -> None:
+    """A `python` that works (the real one) for calls before `fail_from_call` and then ends with `status`."""
+    counter = folder / "calls"
+    stand_in = folder / "python"
+    stand_in.write_text(
+        "#!/usr/bin/env bash\n"
+        f'echo x >> "{counter}"; n="$(wc -l < "{counter}")"\n'
+        f"if (( n >= {fail_from_call} )); then exit {status}; fi\n"
+        f'exec "{sys.executable}" "$@"\n',
+        encoding="utf-8",
+    )
+    stand_in.chmod(0o755)
+
+
+@_posix
+@pytest.mark.parametrize(
+    ("fail_from_call", "status", "words"),
+    [
+        (1, 127, "python was not found, so it could not read the database path"),
+        (1, 1, "python failed (exit 1) when it was asked to read the database path"),
+        (2, 127, "python was not found, so it could not compare the database folder with data/"),
+        (2, 1, "python failed (exit 1) when it was asked to compare the database folder with data/"),
+    ],
+    ids=["db-missing", "db-failed", "inside-missing", "inside-failed"],
+)
+def test_reset_sh_gives_exit_8_with_a_line_when_either_python_call_before_the_first_stop_fails(
+    book: Path, tmp_path: Path, fail_from_call: int, status: int, words: str
+) -> None:
+    """Every bare python call before the first stop (the database path, the data/ comparison) ends with exit 8 and one
+    line that names the call and the cause, never a bare exit 127 or 1. Nothing is stopped or deleted. Kills: removing
+    either `|| py_status=$?` or the `py_fail` call."""
+    folder = tmp_path / "bin"
+    folder.mkdir()
+    _python_stand_in(folder, fail_from_call=fail_from_call, status=status)
+    done = reset_run(SH, book, first_on_path=folder, **reset_ports())
+    assert done.returncode == 8, (done.returncode, done.stdout, done.stderr)
+    assert words in done.stderr and "nothing was stopped or deleted" in done.stderr, done.stderr
+    assert "Traceback" not in done.stderr and reset_kept(book)
+
+
+@_posix
+def test_reset_sh_gives_exit_8_with_a_line_when_python_is_not_on_the_path_at_all(book: Path, tmp_path: Path) -> None:
+    """The real shape of "python is not installed": the search path holds no python. bash is started by its full path
+    so that only python is missing."""
+    empty = tmp_path / "empty"
+    empty.mkdir()
+    done = subprocess.run(  # noqa: S603 (bash by its full path, this repository's script)
+        [str(shutil.which("bash")), str(REPO / "scripts" / SH)],
+        cwd=REPO,
+        env={"PATH": str(empty), "DESK_DB_PATH": str(book), **reset_ports()},
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+    )
+    assert done.returncode == 8 and "python was not found" in done.stderr, (done.returncode, done.stderr)
+    assert reset_kept(book)
+
+
+@_posix
+def test_reset_sh_lists_only_the_processes_it_signalled_as_already_stopped(book: Path, tmp_path: Path) -> None:
+    """The desk ends by itself on the stand-in `ps` second look (so reset.sh never signalled it), then the demo server
+    ignores the stop signal. The refusal for the demo server must not say the desk was "already stopped" (it was not
+    stopped by reset.sh). Kills: appending to `stopped` without the `signalled` test."""
+    real_ps = shutil.which("ps")
+    if real_ps is None:
+        pytest.skip("ps is not installed")
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    fakes = _live(
+        book,
+        "fakes",
+        FAKES_MODULE,
+        "import signal, sys, time; signal.signal(signal.SIGTERM, signal.SIG_IGN); "
+        "open(sys.argv[-1], 'w').close(); time.sleep(300)",
+    )
+    folder = tmp_path / "bin"
+    folder.mkdir()
+    fake = folder / "ps"
+    fake.write_text(
+        "#!/usr/bin/env bash\n"
+        f'state="{folder}/stat-calls"\n'
+        'if [[ "$*" == *"-o stat="* ]]; then\n'
+        '  echo x >> "$state"; n="$(wc -l < "$state")"\n'
+        '  if [[ "$n" == 3 ]]; then kill -9 "$2"; sleep 0.3; echo S; exit 0; fi\n'
+        "fi\n"
+        f'exec "{real_ps}" "$@"\n',
+        encoding="utf-8",
+    )
+    fake.chmod(0o755)
+    try:
+        done = reset_run(SH, book, first_on_path=folder, RESET_STOP_WAIT_SECONDS="1", **reset_ports())
+    finally:
+        _end(desk, fakes)
+    assert done.returncode == 5 and "did not stop in time" in done.stderr, (done.returncode, done.stderr)
+    assert "already stopped" not in done.stderr, done.stderr
+
