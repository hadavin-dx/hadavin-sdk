index 0000000..3e4e9a9
--- /dev/null
+++ b/tests/test_reset_ps1_pid_rules.py
@@ -0,0 +1,512 @@
+"""scripts/reset.ps1 must decide like scripts/reset.sh: a pid file is one plain process number or it is stale, and a
+process is the desk only when its command line is `python -m lead_desk.server ...` (or the demo server), not when the
+marker text is just somewhere in it. NOT run here: PowerShell and Windows (no Windows runner was available when this
+was written, so reset.ps1 itself is unverified by a run). What runs on every machine: the script text is read, the
+old bare `-match` and bare `[int](Get-Content ...)` must be gone, and the pattern the script holds is applied to a
+table of command lines with Python's `re` (close to, but not the same engine as, PowerShell's). The tests that
+really run reset.ps1 need Windows. A test whose name starts with test_text_only_ reads the script text and nothing
+else: it shows that a line is there, not that it works (count them with `pytest --collect-only -q -k text_only`)."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from support import REPO, WINDOWS, reset_kept, reset_ports, reset_run, start_proc, stop_proc, wait_until
+
+SCRIPT_TEXT = (REPO / "scripts" / "reset.ps1").read_text(encoding="utf-8")
+
+
+def _without_comment(line: str) -> str:
+    """The line up to a `#` that starts a comment: a `#` outside single and double quotes. (reset.ps1 holds no `#`
+    inside a string; a test below shows that a trailing comment is dropped.)"""
+    quote = ""
+    for i, ch in enumerate(line):
+        if quote:
+            if ch == quote:
+                quote = ""
+        elif ch in "'\"":
+            quote = ch
+        elif ch == "#":
+            return line[:i].rstrip()
+    return line
+
+
+def _strip(text: str) -> str:
+    return "\n".join(c for c in (_without_comment(ln) for ln in text.splitlines()) if c.strip())
+
+
+def _code() -> str:
+    return _strip(SCRIPT_TEXT)
+
+
+def test_a_comment_after_code_is_not_code_and_a_hash_inside_a_string_is_kept() -> None:
+    assert _without_comment("Stop-Process -Id 1 # a note about Remove-Item") == "Stop-Process -Id 1"
+    assert _without_comment("# whole line") == ""
+    assert _without_comment("x = 'a # b' # c") == "x = 'a # b'"
+    assert _without_comment('Write-Host "a # b"') == 'Write-Host "a # b"'
+
+
+def _ours_pattern() -> str:
+    """The pattern reset.ps1 builds: `$interpreter = '...'` and `$ours = '...' + $interpreter + '...'`."""
+    code = _code()
+    interpreter = re.search(r"^\$interpreter = '(?P<text>.*)'$", code, re.MULTILINE)
+    ours = re.search(r"^\$ours = (?P<expr>.*)$", code, re.MULTILINE)
+    assert interpreter and ours, "reset.ps1 has no $interpreter and $ours patterns for the desk's command line"
+    parts = []
+    for token in re.finditer(r"'([^']*)'|\$interpreter", ours.group("expr")):
+        parts.append(token.group(1) if token.group(1) is not None else interpreter.group("text"))
+    return "".join(parts)
+
+
+def test_text_only_the_old_bare_substring_match_and_the_unchecked_number_are_gone() -> None:
+    code = _code()
+    assert not re.search(r"-match\s+'lead_desk\\\.server\|", code), "the bare substring match is back"
+    assert "[int](Get-Content" not in code, "the pid file is converted without a shape check (abc, two lines throw)"
+    assert "[int]::TryParse" in code and "-cmatch '\\A[1-9][0-9]*\\z'" in code, "the pid shape rule is missing"
+    assert re.search(r"\$proc\.CommandLine\s+-cmatch\s+\$ours", code), "the command line is not judged by -cmatch"
+    assert not re.search(r"\$proc\.CommandLine\s+-match\b", code), "the case-insensitive -match is back"
+    # an empty file gives $null: the text is built without calling .Trim() on it
+    assert re.search(r"\$null\s+-eq\s+\$raw", code), "an empty pid file is not guarded"
+    assert re.search(r"(?m)^\$ours = '\^' \+ ", code), "the pattern is not anchored at the first character"
+    assert "Get-Content" not in code, "the whole pid file is read (reset.sh reads at most 67 bytes)"
+
+
+@pytest.mark.parametrize(
+    ("line", "ours"),
+    [
+        ("python -m lead_desk.server", True),
+        ('"\\tools\\venv\\Scripts\\python.exe" -m lead_desk.server', True),
+        ('"\\Program Files\\Python312\\python.exe" -m lead_desk.server', True),
+        (
+            "\\Program Files\\Python312\\python.exe -m lead_desk.server",
+            False,
+        ),  # no quotes, a space: the safe side
+        ("\\venv\\python.exe -m lead_desk.server", True),
+        ("\\x\\pythonw.exe -m demo_only.fakes_server --outbox keyed --port 5", True),
+        (
+            "\\Python312\\Python.exe -m lead_desk.server",
+            True,
+        ),  # the same first letter rule as reset.sh: [Pp]ython
+        ('"\\Python312\\Python.exe" -m lead_desk.server', True),  # quoted: the same [Pp]ython rule
+        ('"\\Python312\\PYTHON.EXE" -m lead_desk.server', False),
+        ("PYTHON.EXE -m LEAD_DESK.SERVER", False),  # -cmatch: the whole line is compared with its letter case
+        (" python -m lead_desk.server", False),  # reset.sh matches from the first character: so does reset.ps1
+        ("python -M lead_desk.server", False),
+        ("python -m Lead_Desk.Server", False),
+        ("python -m DEMO_ONLY.FAKES_SERVER", False),
+        ("notepad lead_desk.server.py", False),
+        ("python -m lead_desk.server.py", False),
+        ("python -m lead_desk.serverx", False),
+        ("python -m xlead_desk.server", False),
+        ("python -mlead_desk.server", False),
+        ("python lead_desk.server", False),
+        ("\\python-tools\\less.exe -m lead_desk.server", False),
+        ("cmd /c echo python -m lead_desk.server", False),
+        ('powershell -Command "python -m demo_only.fakes_server.py"', False),
+    ],
+)
+def test_text_only_the_command_line_pattern_in_reset_ps1_accepts_only_the_real_shapes(line: str, ours: bool) -> None:
+    assert bool(re.search(_ours_pattern(), line)) is ours, line  # no IGNORECASE: -cmatch
+
+
+@pytest.mark.parametrize(
+    ("text", "plain"),
+    [
+        ("123", True),
+        ("1", True),
+        ("007", False),
+        ("0", False),
+        ("abc", False),
+        ("12 34", False),
+        ("12\n34", False),
+        ("123\n", False),  # the old `$` accepted a line end after the number; \z does not
+    ],
+)
+def test_text_only_the_pid_shape_rule_in_reset_ps1_accepts_one_plain_number_only(text: str, plain: bool) -> None:
+    """The rule is cut out of the script text and tried on the sample in Python (there the end mark is Z)."""
+    found = re.search(r"-cmatch '(?P<rule>\\A\[1-9\]\[0-9\]\*\\z)'", _code())
+    assert found, "the pid shape rule is not in reset.ps1"
+    assert bool(re.search(found.group("rule").replace("\\z", "\\Z"), text)) is plain, text
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+@pytest.mark.parametrize("text", ["abc", "007", "123\n456\n", ""])
+def test_reset_ps1_treats_a_pid_file_that_is_not_one_number_as_stale(book: Path, text: str) -> None:
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(text, encoding="utf-8")
+    done = reset_run("reset.ps1", book)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+def test_reset_ps1_does_not_stop_a_program_that_only_has_the_marker_in_its_line(book: Path) -> None:
+    ready = book.parent / "ready"
+    code = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(300)"
+    child: subprocess.Popen[bytes] = start_proc(["-c", code, "-m", "lead_desk.server.py", str(ready)], dict(os.environ))
+    try:
+        wait_until(ready.exists, what="the child is running")
+        pidfile = book.parent / "desk.pid"
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = reset_run("reset.ps1", book)
+        still_running = child.poll() is None
+    finally:
+        child.kill()
+        child.wait()
+        stop_proc(child)
+    assert still_running and done.returncode == 6, (done.returncode, done.stdout, done.stderr)
+    assert reset_kept(book) and pidfile.exists()
+
+
+def _reset_sh_code() -> str:
+    text = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8")
+    return "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def test_text_only_reset_ps1_reads_a_byte_order_mark_and_64_bytes_after_it_like_reset_sh() -> None:
+    """The rule of reset.sh (tested there with real files): an optional UTF-8 byte order mark, then 64 bytes or more
+    is stale. reset.ps1 reads up to 67 bytes, skips the mark, and judges the bytes after it. Anchored to whole
+    lines of the script."""
+    code = _code()
+    assert re.search(r"New-Object byte\[\]\s+67\b", code), "the pid file is not read through a 67 byte buffer"
+    assert re.search(r"while \(\$count -lt 67\)", code), "the read does not go on until 67 bytes or the end"
+    assert re.search(r"\.Read\(\$buffer,\s*\$count,\s*67 - \$count\)", code), "the read does not ask for what is left"
+    assert re.search(
+        r"if \(\$count -ge 3 -and \$buffer\[0\] -eq 0xEF -and \$buffer\[1\] -eq 0xBB -and \$buffer\[2\] -eq 0xBF\) "
+        r"\{ \$from = 3 \}",
+        code,
+    ), "the byte order mark rule is not the whole condition"
+    assert re.search(r"\$bad = \(\(\$count - \$from\) -ge 64\)", code), "64 bytes are not stale"
+    assert re.search(r"\$b -gt 126 -or \(\$b -lt 32 -and \(\$b -lt 9 -or \$b -gt 13\)\)", code), (
+        "no byte rule (NUL, above 126)"
+    )
+    assert re.search(r"if \(\$bad\) \{ \$raw = \$null \}", code), "a bad byte is not stale"
+    assert re.search(r"try\s*\{.*?\}\s*catch\s*\{", code, re.DOTALL), "an unreadable pid file is not caught"
+    sh = _reset_sh_code()
+    body = sh[sh.index("read_pid_file() {") :]
+    body = body[: body.index("\n}\n")]  # the function alone: the whole rule sits inside it, under its own LC_ALL=C
+    assert "local LC_ALL=C" in body and "67" in body and "xef" in body.lower(), (
+        "reset.sh: not 67 bytes, mark in the function"
+    )
+    assert re.search(r"\(\( \$\{#pid\} >= 64 \)\)", body), "reset.sh: the 64 byte check is not inside read_pid_file"
