+def _minimum_line() -> str:
+    lines = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8").splitlines()
+    found = [line for line in lines if line.startswith(_MINIMUM_START)]
+    assert len(found) == 1, "the bash minimum constant was not found exactly once at the start of a line"
+    return found[0]
+
