+def _minimum_bash() -> tuple[int, int]:
+    """The README sentence names the minimum bash, once."""
+    found = re.findall(r"bash (\d+)\.(\d+) or newer", (REPO / "README.md").read_text(encoding="utf-8"))
+    assert len(found) == 1, f"the README must name the minimum bash version exactly once: {found}"
+    return int(found[0][0]), int(found[0][1])
