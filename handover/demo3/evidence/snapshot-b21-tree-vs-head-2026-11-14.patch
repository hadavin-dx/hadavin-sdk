+# a bind to port 0 in any shape: .bind((host, 0)), a server constructor ((host, 0), Handler) or asyncio's start_server
+_SITE = re.compile(r"\(\s*\(\s*[^,()]+,\s*0\s*\)|\bstart_server\([^)]*,\s*0\s*\)")
+_KEPT_OPEN = (
+    "the server keeps its own socket open until it is closed, and the number comes from the operating system's "
+    "own range (32768 and up on Linux, 49152 and up on Windows and macOS: checked by the range test below), which "
+    "no worker block contains; there is no gap between giving the number away and binding it"
+)
+# file -> (how many sites, why a direct bind to port 0 is allowed there). A new site, or one fewer, fails the test.
+_ALLOWED_SITES: dict[str, tuple[int, str]] = {
+    "support.py": (1, _KEPT_OPEN),
+    "test_followup_edge_cases.py": (1, _KEPT_OPEN),
+    "test_hubspot_probe.py": (1, _KEPT_OPEN),
+    "test_load_tools.py": (2, _KEPT_OPEN),
+    "test_n8n_api_url.py": (6, _KEPT_OPEN),
+    "test_portal_demo.py": (1, _KEPT_OPEN),
+    "test_server_stop_guard.py": (1, _KEPT_OPEN),
+    "test_sonar_p2_choke_points.py": (3, _KEPT_OPEN),
+    "test_standins_body_before_answer.py": (2, _KEPT_OPEN),
+}
