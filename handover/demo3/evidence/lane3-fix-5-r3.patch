 # a process that has ended but is not yet collected by its parent (state Z) is stopped
 alive() { kill -0 "$1" 2>/dev/null && [[ "$(ps -p "$1" -o stat= 2>/dev/null | cut -c1)" != "Z" ]]; }
+# the whole command line of a process, never cut at a terminal width: ps cuts it at $COLUMNS (even into a pipe) and
+# the marker is the last word. Linux: /proc (NUL separators become spaces); else ps -ww (unlimited width), else plain ps
+proc_args() {
+  # only a plain number names a process (an empty pid would read /proc/cmdline, the kernel's own line)
+  # a blank answer (a process with no command line, or only NUL bytes that became spaces) is not an answer: ask ps
+  if [[ "$1" =~ ^[0-9]+$ && -r "/proc/$1/cmdline" ]]; then
+    proc_line="$(tr '\0' ' ' 2>/dev/null < "/proc/$1/cmdline")" || proc_line=""
+    if [[ "$proc_line" == *[![:space:]]* ]]; then
+      printf '%s\n' "$proc_line"
+      return 0
+    fi
+  fi
+  ps -ww -p "$1" -o args= 2>/dev/null || ps -p "$1" -o args= 2>/dev/null
+}
 for name in desk fakes; do
   pidfile="$data_dir/$name.pid"
   if [[ -e "$pidfile" ]]; then
     pid="$(cat "$pidfile")"
     # only stop a process that still is the desk or the demo server (a pid can be reused by another program);
     # a process that has ended but is not yet collected (state Z) shows no program name, so it counts as gone
