diff --git a/src/lead_desk/config_exit.py b/src/lead_desk/config_exit.py
new file mode 100644
index 0000000..3b1f9a5
--- /dev/null
+++ b/src/lead_desk/config_exit.py
@@ -0,0 +1,29 @@
+"""The one way for a script to read the DESK_* settings: a refused setting ends the script with a plain message.
+
+`Config.from_env` raises `SettingRefused` for a bad value. A program that lets that error out shows the person a Python
+traceback. `server.main` catches it and exits with code 4; every other program that reads the settings (scripts/*.py,
+the `python -c` helper calls in scripts/*.sh and scripts/*.ps1) calls `config_or_exit` instead, so the rule has one
+home: exit code 4 (`EXIT_DESK_SETTING_REFUSED`), ONE line on the error stream that names the setting, no traceback, and
+never the value (the `SettingRefused` messages name the setting only; the line is also cut to one short line here).
+The line goes to the error stream so that a shell command substitution (`$(python -c ...)`) does not swallow it."""
+
+from __future__ import annotations
+
+import sys
+from collections.abc import Mapping
+
+from lead_desk.config import Config
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED
+from lead_desk.envnum import SettingRefused
+
+LINE_MAX = 200
+
+
+def config_or_exit(env: Mapping[str, str] | None = None) -> Config:
+    """`Config.from_env(env)`, or the plain refusal and `SystemExit(4)` when a setting is refused."""
+    try:
+        return Config.from_env(env)
+    except SettingRefused as e:
+        line = " ".join(str(e).split())[:LINE_MAX]  # one line, whatever the message holds
+        print(f"the desk refuses a setting: {line}", file=sys.stderr, flush=True)
+        raise SystemExit(EXIT_DESK_SETTING_REFUSED) from None
diff --git a/tests/test_bad_setting_entry_points.py b/tests/test_bad_setting_entry_points.py
new file mode 100644
index 0000000..439c8ec
--- /dev/null
+++ b/tests/test_bad_setting_entry_points.py
@@ -0,0 +1,186 @@
+"""A bad DESK_* value must end every start-up script cleanly, never with a Python traceback.
+
+Bug class: a bad setting value (a person's typing mistake) reaches the person as a raw Python error, because the
+script read the settings by itself, outside the one place that turns a refused setting into a plain message.
+The rule for every entry point that reads the DESK_* settings: exit code 4 (the desk's code for a refused setting,
+contract.md "Exit codes"), ONE line that names the setting, no traceback, and the value is never repeated (it may be
+an e-mail address). Made-up values only; loopback only; no network is reached because every run stops at the check.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk.config import Config
+from lead_desk.config_exit import config_or_exit
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED
+
+SCRIPTS = REPO / "scripts"
+WINDOWS = sys.platform == "win32"
+FLOW = "demo_only/leadflow.json"  # reminders on, so DESK_NUDGE_TO is read as an address
+
+PY_ENTRY_POINTS: list[tuple[str, list[str]]] = [
+    ("crash_desk", [str(SCRIPTS / "crash_desk.py")]),
+    ("feed", [str(SCRIPTS / "feed.py"), "--source", "form", "--all"]),
+    ("reset_check", [str(SCRIPTS / "reset_check.py")]),
+    ("server", ["-m", "lead_desk.server"]),
+    ("crash_launcher", [str(REPO / "tests" / "crash_launcher.py"), "unused.flag"]),
+]
+SH_ENTRY_POINTS = ["start_all.sh", "reset.sh"]
+
+# (setting name, value that no desk may accept). A NUL character cannot be put in an environment by the operating
+# system; it is tried in-process below.
+BAD_VALUES: list[tuple[str, str]] = [
+    ("DESK_NUDGE_TO", "a@b@c.test"),  # address-like, two @
+    ("DESK_NUDGE_TO", " "),  # whitespace only
+    ("DESK_NUDGE_TO", "x" * 5000 + "@b.test"),  # very long
+    ("DESK_NUDGE_TO", "a\x07b@c.test"),  # control character
+    ("DESK_NUDGE_TO", "café@b.test"),  # not ASCII
+    ("DESK_NUDGE_TO", "no-at-sign"),
+    ("DESK_PORT", ""),  # empty
+    ("DESK_PORT", "   "),
+    ("DESK_PORT", "9" * 5000),
+    ("DESK_PORT", "8\x077"),
+    ("DESK_PORT", "٣٤"),  # digits of another script
+    ("DESK_PORT", "abc@b@c.test"),  # address-like text in a number setting
+    ("DESK_FAKES_URL", "ftp://a@b@c.test:1"),
+    ("DESK_SEND_TIMEOUT_SECONDS", "nan"),
+]
+
+
+def _run(
+    argv: list[str], tmp: Path, setting: str, value: str, *, with_bash: bool = False
+) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_LEADFLOW_FILE=FLOW)
+    env.pop("DESK_NUDGE_TO", None)
+    env[setting] = value
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    cmd = ["bash", str(SCRIPTS / argv[0])] if with_bash else [sys.executable, *argv]
+    return subprocess.run(  # noqa: S603 - fixed argv built above, made-up values
+        cmd,
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+        timeout=60,
+        stdin=subprocess.DEVNULL,
+    )
+
+
+def _assert_clean_refusal(done: subprocess.CompletedProcess[str], setting: str, value: str, tmp: Path) -> None:
+    out = done.stdout + done.stderr
+    lines = [ln for ln in out.splitlines() if ln.strip()]
+    assert done.returncode == EXIT_DESK_SETTING_REFUSED, (done.returncode, out[-400:])
+    assert "Traceback" not in out and 'File "' not in out, out[-400:]
+    assert len(lines) == 1, lines[-5:]  # ONE line
+    assert setting in lines[0], lines[0]  # names the setting
+    assert len(lines[0]) < 300, len(lines[0])
+    probe = value.strip()
+    for piece in (probe[:12], probe[-12:]):  # the value (or a part of it) is never echoed
+        if len(piece) >= 3:
+            assert piece not in out
+    assert "@" not in out  # nothing that looks like an address
+    assert not (tmp / "data").exists()  # a refused start created nothing
+
+
+@pytest.mark.parametrize(("setting", "value"), BAD_VALUES, ids=lambda v: repr(v)[:24])
+@pytest.mark.parametrize(("name", "argv"), PY_ENTRY_POINTS, ids=[n for n, _ in PY_ENTRY_POINTS])
+def test_bad_setting_is_a_clean_refusal_in_every_python_entry_point(
+    name: str, argv: list[str], setting: str, value: str, tmp_path: Path
+) -> None:
+    _assert_clean_refusal(_run(argv, tmp_path, setting, value), setting, value, tmp_path)
