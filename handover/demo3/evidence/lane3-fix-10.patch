+HOSTILE: dict[str, str] = {
+    "empty": "",
+    "whitespace": "  \t ",
+    "long": "x" * 100_000,
+    "nul": "a\0b",
+    "control": "a\x07b\nc",
+    "non_ascii": "café‮",
+    "lone_surrogate": "a\udc80b",
+    "two_at": "a@b@c.test",
+}
+SETTING_NAMES = (
+    "DB_PATH BIND PORT ADAPTERS FAKES_HOST FAKES_PORT FAKES_URL REPLIES_PATH SEND_TIMEOUT_SECONDS SIZE_CAP_BYTES "
+    "STALL_SECONDS ALLOWED_HOSTS QUALIFIER OUTBOX CRM LATER_MODE APPROVERS_FILE LEADFLOW_FILE NUDGE_TO"
+).split()
+
+
+@pytest.mark.parametrize("kind", sorted(HOSTILE))
+@pytest.mark.parametrize("name", SETTING_NAMES)
+def test_config_or_exit_never_lets_another_error_out(name: str, kind: str, capsys: Any) -> None:
+    """Class check at the shared reader: any DESK_* name with any hostile value gives a Config or a plain refusal."""
+    env = {"DESK_LEADFLOW_FILE": FLOW, f"DESK_{name}": HOSTILE[kind]}
+    try:
+        config_or_exit(env)
+    except SystemExit as stop:
+        assert stop.code == EXIT_DESK_SETTING_REFUSED
+        out = capsys.readouterr()
+        lines = [ln for ln in (out.out + out.err).splitlines() if ln.strip()]
+        assert len(lines) == 1 and f"DESK_{name}" in lines[0] and "Traceback" not in lines[0]
+        assert "@" not in lines[0] and len(lines[0]) < 300
+
+
+def test_config_or_exit_returns_the_same_config_for_good_settings() -> None:
+    env = {"DESK_PORT": "8123", "DESK_LEADFLOW_FILE": FLOW}
+    assert config_or_exit(env) == Config.from_env(env)
