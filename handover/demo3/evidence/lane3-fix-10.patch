+def test_the_refusal_is_cut_to_one_short_line_even_for_a_long_or_multi_line_message(
+    monkeypatch: pytest.MonkeyPatch, capsys: Any
+) -> None:
+    """The shared reader keeps the one-line rule itself, whatever a refusal message holds."""
+    from lead_desk.envnum import SettingRefused
+
+    def refuse(cls: Any, env: Any = None) -> Any:
+        raise SettingRefused("DESK_PORT is bad\nsecond line\r\n" + "y" * 5000)
+
+    monkeypatch.setattr(Config, "from_env", classmethod(refuse))
+    with pytest.raises(SystemExit) as stop:
+        config_or_exit({})
+    assert stop.value.code == EXIT_DESK_SETTING_REFUSED
+    out = capsys.readouterr()
+    assert out.out == ""  # the error stream, not the output a shell would capture
+    assert len(out.err.splitlines()) == 1 and len(out.err) < 300 and "DESK_PORT" in out.err
