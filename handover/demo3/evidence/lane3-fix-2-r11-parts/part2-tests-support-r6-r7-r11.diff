@@ -0,0 +1,157 @@
+"""Round 11 of the key-file work: a counting stub that cannot be read one request short, and a path that is, or sits
+behind, a symbolic link that leads nowhere (a missing target, or links that go round in a circle). Made-up data only."""
+
+from __future__ import annotations
+
+import os
+import socket
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import RawStub, fresh_script
+
+from lead_desk import desk, envnum, server
+from lead_desk.envnum import SettingRefused
+
+REPO = Path(server.__file__).parents[2]
+POSIX = pytest.mark.skipif(os.name != "posix", reason="symbolic links need a POSIX system here")
+LINK_TEXT = "DESK_DB_PATH is, or sits behind, a symbolic link that leads nowhere: name a real file"
+
+
+# ------------------------------------------------------------------------------ item 1: the counting stub
+def _ask(stub: RawStub) -> bytes:
+    with socket.create_connection(("127.0.0.1", stub.port), timeout=5) as c:
+        c.sendall(b"GET / HTTP/1.1\r\nHost: x\r\n\r\n")
+        got = b""
+        while b"{}" not in got:
+            chunk = c.recv(4096)
+            if not chunk:
+                break
+            got += chunk
+    return got
+
+
+def test_the_stub_has_counted_a_request_by_the_time_the_client_has_its_answer() -> None:
+    """The server thread waits 0.3 s AFTER it has sent the answer. A count made after the answer would still read 0
+    here (the old order: the count was one request short); the count is made before it, so it reads 1 at once."""
+    stub = RawStub(b"1", pause_after_send=0.3)
+    try:
+        for want in (1, 2):
+            assert b"429" in _ask(stub)
+            assert stub.hits == want  # no wait, no poll
+    finally:
+        stub.close()
+
+
+# ------------------------------------------------------------------------------ item 3: a link that leads nowhere
+def _link(link: Path, target: Path) -> None:
+    link.symlink_to(target)
+
+
+def _loop(a: Path, b: Path) -> None:
+    a.symlink_to(b)
+    b.symlink_to(a)
+
+
+@POSIX
+def test_a_dangling_link_a_loop_and_a_link_in_a_parent_are_one_problem_called_link(tmp_path: Path) -> None:
+    dangling = tmp_path / "dangling.db"
+    _link(dangling, tmp_path / "nowhere" / "target.db")
+    loop_a, loop_b = tmp_path / "loop-a", tmp_path / "loop-b"
+    _loop(loop_a, loop_b)
+    dangling_dir = tmp_path / "dangling-dir"
+    _link(dangling_dir, tmp_path / "missing-folder")
+    assert envnum.path_kind(dangling) == "absent"  # the system answers "no such file": path_kind alone cannot tell
+    assert envnum.env_file_problem(dangling) == "link"
+    assert envnum.env_file_problem(loop_a) == "link"
+    assert envnum.env_file_problem(loop_a / "book.db") == "link"  # a loop in a parent
+    assert envnum.env_file_problem(dangling_dir / "book.db") == "link"  # a dangling link in a parent
+    assert envnum.env_file_problem(dangling_dir / "a" / "b" / "book.db") == "link"
+    assert not (tmp_path / "nowhere").exists() and not (tmp_path / "missing-folder").exists()
+
+
+@POSIX
+def test_a_link_to_something_that_exists_keeps_the_answer_of_its_target(tmp_path: Path) -> None:
+    folder = tmp_path / "real-folder"
+    folder.mkdir()
+    plain = tmp_path / "real-file"
+    plain.write_text("x", encoding="utf-8")
+    to_folder, to_file = tmp_path / "to-folder", tmp_path / "to-file"
+    _link(to_folder, folder)
+    _link(to_file, plain)
+    assert envnum.env_file_problem(to_folder) == "folder"
+    assert envnum.env_file_problem(to_file) is None
+    assert envnum.env_file_problem(to_folder / "book.db") is None  # a free name below a link to a real folder
+    assert envnum.env_file_problem(to_file / "book.db") == "inside_file"
+    assert envnum.env_file_problem(tmp_path / "plain-free-name.db") is None
+    assert envnum.env_file_problem(tmp_path / "none" / "x" / "book.db") is None
+
+
+@POSIX
+def test_the_one_text_for_a_link_names_the_setting_and_never_the_path(tmp_path: Path) -> None:
+    assert envnum.file_problem_text("DESK_DB_PATH", "link") == LINK_TEXT
+    assert desk.BOOK_PROBLEMS["link"] == LINK_TEXT
+    dangling = tmp_path / "dangling.db"
+    _link(dangling, tmp_path / "nowhere.db")
+    assert desk.book_problem(dangling) == LINK_TEXT
+    with pytest.raises(SettingRefused) as e:
+        envnum.refuse_unusable_file("DESK_LIVE_LEDGER_PATH", dangling)  # the same helper serves the other file settings
+    assert str(e.value) == LINK_TEXT.replace("DESK_DB_PATH", "DESK_LIVE_LEDGER_PATH")
+    assert str(tmp_path) not in str(e.value)
+
+
+@POSIX
+@pytest.mark.parametrize("shape", ["dangling", "loop", "loop_in_parent", "dangling_parent"])
+def test_run_real_check_refuses_a_link_that_leads_nowhere_in_one_line_and_creates_nothing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str], shape: str
+) -> None:
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    mod: Any = fresh_script(monkeypatch, "run_real_check", REPO / "scripts" / "run_real_check.py")
+    target = tmp_path / "target-folder" / "target.db"
+    if shape == "dangling":
+        book = tmp_path / "book.db"
+        _link(book, target)
+    elif shape == "loop":
+        book = tmp_path / "loop-a"
+        _loop(book, tmp_path / "loop-b")
+    elif shape == "loop_in_parent":
+        _loop(tmp_path / "loop-a", tmp_path / "loop-b")
+        book = tmp_path / "loop-a" / "book.db"
+    else:
+        _link(tmp_path / "gone", tmp_path / "target-folder")
+        book = tmp_path / "gone" / "book.db"
+    values = dict.fromkeys(mod.REQUIRED, "x") | {"DESK_DB_PATH": str(book)}
+    cfg = tmp_path / "run.env"
+    cfg.write_text("\n".join(f"{k}={v}" for k, v in values.items()) + "\n", encoding="utf-8")
+    monkeypatch.setattr("builtins.input", lambda prompt="": pytest.fail("the question must not be reached"))
+    before = sorted(p.name for p in tmp_path.rglob("*"))
+    code = mod.main(["--config", str(cfg)])
+    out = capsys.readouterr().out
+    assert code == mod.EXIT_REFUSED, out
+    assert out.strip().splitlines() == [f"refused: ValueError: {LINK_TEXT}"], out
+    assert str(tmp_path) not in out and "Traceback" not in out
+    assert not (tmp_path / "target-folder").exists(), "a file or folder was made at the link's target"
+    assert sorted(p.name for p in tmp_path.rglob("*")) == before, "something was created"
+
+
+@POSIX
+@pytest.mark.usefixtures("main_lock_handles_closed")
+def test_the_desk_refuses_to_start_on_a_link_that_leads_nowhere_and_makes_nothing(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    dangling = tmp_path / "book.db"
+    _link(dangling, tmp_path / "target-folder" / "target.db")
+    monkeypatch.setenv("DESK_DB_PATH", str(dangling))
+    monkeypatch.setenv("DESK_PORT", "0")
+
+    def must_not_serve(*a: Any, **k: Any) -> Any:
+        raise AssertionError("the desk went on although the lead-book path is a link that leads nowhere")
+
+    monkeypatch.setattr(server, "make_server", must_not_serve)
+    with pytest.raises(SystemExit) as e:
+        server.main()
+    out = capsys.readouterr().out
+    assert e.value.code == 4, out
+    assert out.strip() == f"the desk refuses to start: {LINK_TEXT}", out
+    assert not (tmp_path / "target-folder").exists() and not list(tmp_path.glob("*.lock"))
