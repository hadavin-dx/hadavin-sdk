+def _is_settable_bind_name(name: str) -> bool:
+    """The stricter check for a bind that came from the DESK_BIND setting (`Config.from_env`): everything
+    `_is_bind_name` accepts, and also exactly one pair of brackets around the whole IPv6 address (`[::1` and `::1]` can
+    never bind), and a letter or digit in every part of a name (`-`, `_` and `a.-.b` can never be a name). `Config`
+    itself keeps the looser check, so that `public_bind_problem` still calls a half-bracketed text public."""
+    if not _is_bind_name(name):
+        return False
+    if name.startswith("[") or name.endswith("]") or "[" in name or "]" in name:
+        return name.startswith("[") and name.endswith("]") and name.count("[") == 1 and name.count("]") == 1
+    if ":" in name or "%" in name or _ALL_DIGITS_AND_DOTS.fullmatch(name):
+        return True  # an IPv6 or IPv4 address that `_is_bind_name` already read
+    return all(any(c.isalnum() for c in part) for part in name.rstrip(".").split("."))
