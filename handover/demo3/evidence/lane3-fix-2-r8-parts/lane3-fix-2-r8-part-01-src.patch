+_ABSENT_ERRNOS = (errno.ENOENT, errno.ENOTDIR, errno.ELOOP, errno.ENAMETOOLONG, errno.EINVAL)
+_ABSENT_WINERRORS = (123, 21, 1921)
+
+
+def path_kind(path: Path) -> PathKind:
+    """What a setting's path is right now: `folder`, `file` (anything else that exists), `absent`, or `unreadable`
+    (the system will not tell us, for example no permission to look inside a parent folder). The one place that
+    looks at a setting's path before the desk uses it: `Path.is_dir()` and `Path.exists()` raise PermissionError on
+    Python 3.12 and later, which ended in a traceback (exit code 1) where a refusal (exit code 4) is documented.
+    Every caller treats `unreadable` as a refusal with a fixed text (no path in it)."""
+    try:
+        mode = path.stat().st_mode
+    except ValueError:  # an embedded NUL: not a path that exists (what is_dir() reported too)
+        return "absent"
+    except OSError as e:
+        if e.errno in _ABSENT_ERRNOS or getattr(e, "winerror", None) in _ABSENT_WINERRORS:
+            return "absent"
+        return "unreadable"
+    return "folder" if stat.S_ISDIR(mode) else "file"
+
+
+FileProblem = Literal["folder", "inside_file", "unreadable"]
+
+
+def env_file_problem(path: Path) -> FileProblem | None:
+    """Why a path cannot be the place of a FILE the desk writes or reads (None: it can). `folder`: the path is a
+    folder. `inside_file`: the first part of the path that exists is a file, where a folder must be. `unreadable`: the
+    system will not let the desk look at the path or at a part of it. The one parent walk for the lead-book path, the
+    live ledger and both counters files; every probe goes through `path_kind`."""
+    kind = path_kind(path)
+    if kind == "folder":
+        return "folder"
+    if kind == "unreadable":
+        return "unreadable"
+    if kind == "file":
+        return None
+    for folder in path.parents:  # the path is absent: the first part that exists must be a folder
+        parent_kind = path_kind(folder)
+        if parent_kind == "folder":
+            return None
+        if parent_kind == "file":
+            return "inside_file"
+        if parent_kind == "unreadable":
+            return "unreadable"
+    return None
+
+
+def file_problem_text(name: str, problem: FileProblem) -> str:
+    """The fixed refusal text for an `env_file_problem` answer: the setting named, never the path."""
+    if problem == "folder":
+        return f"{name} names a folder, not a file"
+    if problem == "inside_file":
+        return f"{name} sits inside something that is a file, not a folder"
+    return f"{name} cannot be looked at (the system would not let the desk look at a part of that path)"
+
+
+def refuse_unusable_file(name: str, path: Path) -> None:
+    """For a setting that must name a FILE (a counters file, a ledger): a folder, a path inside a file, or a path the
+    system will not let us look at is a SettingRefused naming the setting (never the path). A path that is absent
+    below a folder, or a file, passes."""
+    problem = env_file_problem(path)
+    if problem is not None:
+        raise SettingRefused(file_problem_text(name, problem))
+
+
+def read_secret_file(path: Path, what: str, noun: str, *, strip_inner_space: bool = False) -> str:
+    """The one rule for every secret file (a key or a password), for the desk, its scripts and its fakes. The whole
+    rule, with its reasons, is written once, in the section "Key and password files" of docs/settings.md. In short: a
+    regular file that is not a link (a folder, a named pipe, a device or a symbolic link is refused without being
+    read) that no other user can read (on a system with permission bits), at most SECRET_FILE_MAX_BYTES, UTF-8 (a
+    byte-order mark at the start is accepted), at least LIVE_KEY_MIN_CHARS printable ASCII characters and no blank
+    anywhere. Only the line break at the very end of the file is removed. `strip_inner_space=True` (the SMTP password
+    and the mailbox password only) drops every plain space first. `what` names the file in every text ("the {what}
+    file ...") and `noun` the content ("key" or "password"). A refusal is a SettingRefused whose text is fixed and
+    holds neither the path nor the content. The kinds wrap it in their own error type; none imports another."""
+    link_text = f"the {what} file is a symbolic link: name the real file"
+    try:
+        # O_NONBLOCK: opening a named pipe for reading would wait for a writer; the check below refuses it instead.
+        # O_NOCTTY: a terminal device named here must never become this process's terminal.
+        # O_NOFOLLOW: a link as the last part of the path is not followed where the system has the flag (it is 0
+        # where it has none, and the second look below refuses the link there too).
+        flags = os.O_RDONLY | getattr(os, "O_NONBLOCK", 0) | getattr(os, "O_NOCTTY", 0) | getattr(os, "O_NOFOLLOW", 0)
+        fd = os.open(path, flags | getattr(os, "O_BINARY", 0))
+    except (OSError, ValueError):  # ValueError: an embedded NUL in the path
+        if _is_link(path):  # the open refused a link (ELOOP): say so, instead of "cannot be read"
+            raise SettingRefused(link_text) from None
+        raise SettingRefused(f"the {what} file cannot be read") from None  # the OS error holds the path
+    try:
+        opened = os.fstat(fd)  # on the open handle: nothing can be swapped in after the checks below
+        if not stat.S_ISREG(opened.st_mode):
+            raise SettingRefused(f"the {what} file cannot be read")
+        try:
+            second = os.lstat(path)  # the second look: what the name is now (a link, or another file than the open one)
+        except (OSError, ValueError):
+            raise SettingRefused(f"the {what} file cannot be read") from None
+        if stat.S_ISLNK(second.st_mode):
+            raise SettingRefused(link_text)
+        if opened.st_ino != 0 and (second.st_ino, second.st_dev) != (opened.st_ino, opened.st_dev):
+            raise SettingRefused(f"the {what} file changed while it was being opened: try again")
+        if os.name == "posix" and opened.st_mode & _OTHERS_MASK:
+            raise SettingRefused(f"the {what} file can be read by other users: run chmod 600 on it")
+        with os.fdopen(fd, "rb", closefd=False) as f:
+            raw = f.read(SECRET_FILE_MAX_BYTES + 1)
+    except OSError:
+        raise SettingRefused(f"the {what} file cannot be read") from None
+    finally:
+        os.close(fd)
+    if len(raw) > SECRET_FILE_MAX_BYTES:
+        raise SettingRefused(f"the {what} file is too large: it must hold only the {noun}")
+    if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
+        raise SettingRefused(f"the {what} file is UTF-16 text: save it as plain UTF-8 text")
+    try:
+        text = raw.decode("utf-8-sig")
+    except UnicodeError:
+        raise SettingRefused(f"the {what} file is not UTF-8 text: save it as plain UTF-8 text") from None
+    if text.endswith("\r\n"):  # the one line break a text editor adds at the end
+        text = text[:-2]
+    elif text.endswith("\n"):
+        text = text[:-1]
+    if "\n" in text or "\r" in text:
+        raise SettingRefused(f"the {what} file has more than one line: it must hold only the {noun}")
+    secret = text.replace(" ", "") if strip_inner_space else text
+    if len(secret) < LIVE_KEY_MIN_CHARS:
+        raise SettingRefused(
+            f"the {what} file is empty or shorter than {LIVE_KEY_MIN_CHARS} characters: it must hold the {noun}"
+        )
+    if not secret.isascii() or not secret.isprintable():  # a tab, a no-break space, an accent, a control character
+        raise SettingRefused(
+            f"the {what} file must hold only plain printable ASCII characters (letters, digits, signs)"
+        )
+    if " " in secret:
+        raise SettingRefused(f"the {what} file's {noun} must not hold a space")
+    return secret
+
+
+def _is_link(path: Path) -> bool:
+    """True when the last part of `path` is a symbolic link (also a broken one or one that loops). Never raises."""
+    try:
+        return stat.S_ISLNK(os.lstat(path).st_mode)
+    except (OSError, ValueError):
+        return False
+
+
+def retry_after_seconds(raw: str | None) -> float | None:
+    """The seconds a Retry-After header names: digits, optionally followed by a point and more digits, with no sign, no
+    exponent and no point at either end (spaces and tabs around it are ignored; ASCII digits only). A number larger than
+    RETRY_AFTER_MAX_SECONDS (also one with so many digits that a float cannot hold it) is read as
+    RETRY_AFTER_MAX_SECONDS. None for a missing header, an HTTP date, junk, a negative number, `inf`, `nan` or `1e999`
+    (none of them is digits with an optional decimal part): the caller then uses its own back-off. The one
+    reader for the desk's HubSpot and live-model kinds, the burst script and the portal demo; `scripts/hubspot_probe.py`
+    and `load_tools/load_driver.py` hold stand-alone copies of this rule (see the module text)."""
+    if raw is None:
+        return None
+    text = raw.strip(" \t")
+    if not (text.isascii() and _RETRY_AFTER.fullmatch(text)):
+        return None
+    try:
+        seconds = float(text)
+    except ValueError:
+        return None
+    return min(seconds, RETRY_AFTER_MAX_SECONDS)  # a text too long for a float is infinity: also the maximum
+
+
+def env_yes_no(env: Mapping[str, str], name: str) -> bool:
+    """A yes-or-no setting: `yes` is True; `no` and an unset or empty name are False. Any other word is a
+    SettingRefused naming the setting (a typo such as `ys` must not silently mean no). The value is not echoed."""
+    word = env.get(name, "").strip().lower()
+    if word in ("", "no"):
+        return False
+    if word == "yes":
+        return True
+    raise SettingRefused(f"{name} must be yes or no")
+
