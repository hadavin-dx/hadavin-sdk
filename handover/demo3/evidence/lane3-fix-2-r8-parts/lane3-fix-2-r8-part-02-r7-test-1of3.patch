+# ------------------------------------------------------------------------ the readers of files: one ban, one allow-list
+# A TRIPWIRE, not a proof: it names every way the standard library has to read a file or to start a program that reads
+# one, and refuses each outside the named allow-list. What it cannot see (a C extension, a plug-in, text that is run as
+# code) needs a person who reads the diff.
+BANNED = {"open", "read_text", "read_bytes", "fdopen", "FileIO", "read_binary", "open_text", "open_binary"}
+BANNED_MODULES = {"linecache", "fileinput", "configparser", "mmap", "subprocess", "tokenize"}  # any use, any form
+BANNED_MODULE_ATTRS = {
+    "shutil": {"copy", "copy2", "copyfile", "copyfileobj", "copytree", "move"},
+    "os": {"system", "popen", "read", "pread", "readv", "sendfile", "startfile", "spawnl", "spawnv", "execv", "execl"},
+}  # fmt: skip
+PROBES = {
+    "is_dir", "is_file", "exists", "is_symlink", "stat", "lstat", "samefile", "iterdir", "glob", "rglob", "getsize",
+    "lexists", "access", "isdir", "isfile", "islink", "ismount", "getmtime", "getctime", "getatime", "realpath",
+    "samestat", "scandir", "listdir", "walk", "readlink", "resolve", "is_mount", "is_socket", "is_fifo",
+    "is_block_device", "is_char_device", "is_junction", "statvfs", "disk_usage", "expanduser",
+}  # fmt: skip
+ZERO_ARG_PROBES = {"owner", "group"}  # Path.owner() and Path.group() take no argument (re.Match.group(1) does)
+NAMESPACE_CALLS = {"globals", "locals", "vars"}
+OS_MODULES = {"os", "os.path", "posixpath", "ntpath", "genericpath", "glob", "pathlib", "io", "shutil"}
+READ_FOLDERS = ("src/lead_desk", "scripts", "demo_only", "load_tools", "tools")
+PROBE_FOLDERS = ("src/lead_desk", "scripts", "demo_only", "load_tools", "tools")
+THE_ONE_READER = "src/lead_desk/envnum.py"  # the one file that may read a key file and look at a setting's path
