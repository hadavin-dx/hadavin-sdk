+
+    def run() -> None:
+        try:
+            _n8n(monkeypatch, fifo)
+        except SystemExit as e:
+            out.append(str(e))
+
+    t = threading.Thread(target=run, daemon=True)
+    t.start()
+    t.join(3)
+    blocked = t.is_alive()
+    if blocked:
+        os.close(os.open(fifo, os.O_WRONLY | os.O_NONBLOCK))
+        t.join(3)
