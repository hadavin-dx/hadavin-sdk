+def test_the_link_and_mode_rules_live_only_in_the_one_reader() -> None:
+    """No other file in src/scripts/demo_only/load_tools/tools names lstat, S_ISLNK, mode bits or O_NOFOLLOW."""
+    wanted = re.compile(r"S_ISLNK|O_NOFOLLOW|0o077|\bchmod 600\b")
+    where = []
+    for folder in ("src/lead_desk", "scripts", "demo_only", "load_tools", "tools"):
+        for p in sorted((REPO / folder).rglob("*.py")):
+            if p.name != "envnum.py" and wanted.search(p.read_text(encoding="utf-8")):
+                where.append(p.relative_to(REPO).as_posix())
+    assert where == [], where
+
