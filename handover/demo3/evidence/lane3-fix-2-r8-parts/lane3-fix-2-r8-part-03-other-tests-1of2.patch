+        "A Retry-After that is an HTTP date is read as no value",
+    ):
+        assert part in text, part
+    source = Path(envnum.__file__).read_text(encoding="utf-8")
+    line = next(x for x in source.splitlines() if x.startswith("_RETRY_AFTER = "))
+    assert "RFC" not in line, line  # the rule is ours (a decimal part is also accepted), not a claim of conformance
+    fixed = _doc("docs/settings.md").split("Fixed in code, not settings")[1]
+    assert "RETRY_AFTER_MAX_SECONDS" in fixed.split("## ")[0]
