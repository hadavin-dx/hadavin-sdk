+# ------------------------------------------------------------------------------- the Retry-After text, every short text
+def _copies(monkeypatch: pytest.MonkeyPatch) -> dict[str, Any]:
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    monkeypatch.syspath_prepend(str(REPO))
+    probe = importlib.import_module("hubspot_probe")
+    driver = importlib.import_module("load_tools.load_driver")
+    return {
+        "envnum": envnum.retry_after_seconds,
+        "load_driver": driver._retry_after_fallback,
+        "hubspot_probe": probe._retry_after,
+    }
+
+
+ALPHABET = "09.eE+-_ \t\r\n\x0b\x0c\xa0٢x,"  # digits, point, exponent, signs, every kind of blank, a foreign digit
+
+
+def test_the_copies_agree_with_the_one_reader_on_every_text_to_four_characters(monkeypatch: pytest.MonkeyPatch) -> None:
+    copies = _copies(monkeypatch)
+    count = 0
+    for n in range(0, 5):
+        for chars in itertools.product(ALPHABET, repeat=n):
+            text = "".join(chars)
+            want = envnum.retry_after_seconds(text)
+            count += 1
+            for name in ("load_driver", "hubspot_probe"):
+                assert copies[name](text) == want, (name, text)
+    assert count == sum(len(ALPHABET) ** n for n in range(5))
+
+
+def test_a_number_with_too_many_digits_is_clamped_not_dropped(monkeypatch: pytest.MonkeyPatch) -> None:
+    """A text that the rule accepts but that is too big for a float is a long wait, not no wait: 308 digits is the
+    largest finite number; every longer text used to give None (a jump in the answers)."""
+    top = constants.RETRY_AFTER_MAX_SECONDS
+    for name, fn in _copies(monkeypatch).items():
+        for digits in (305, 308, 309, 310, 400, 5000):
+            assert fn("9" * digits) == top, (name, digits)
+            assert fn("1" + "0" * digits) == top, (name, digits)
+        assert fn("9" * 400 + ".5") == top, name
+        assert fn("1e999") is None and fn("inf") is None, name
+
