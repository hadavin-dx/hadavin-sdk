+    locked.mkdir()
+    _deny_looking_inside(monkeypatch, locked)
+    assert book_problem(locked / "d.db") == BOOK_UNREADABLE_PROBLEM
+    assert book_problem(locked) == BOOK_UNREADABLE_PROBLEM
+    assert book_problem(tmp_path / "elsewhere" / "d.db") is None  # the rest is still judged as before
+
+
+def test_a_stats_file_or_ledger_that_cannot_be_looked_at_is_refused_with_no_path(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    f = _write(tmp_path, "good-key", FAKE_KEY + "\n")
+    locked = tmp_path / "locked"
+    locked.mkdir()
+    _deny_looking_inside(monkeypatch, locked)
+    target = str(locked / "x.json")
+    cases = (
+        (
+            "DESK_HUBSPOT_STATS_FILE",
+            lambda: HubspotSettings.from_env({**_hubspot(f), "DESK_HUBSPOT_STATS_FILE": target}),
+        ),
+        (
+            "DESK_SMTPP_STATS_FILE",
+            lambda: ProviderSettings.from_env({**_provider(f), "DESK_SMTPP_STATS_FILE": target}),
+        ),
+        (
+            "DESK_LIVE_LEDGER_PATH",
+            lambda: Config.from_env(
+                {**_live(f, tmp_path), "DESK_QUALIFIER": "live_claude", "DESK_LIVE_LEDGER_PATH": target}
+            ),
+        ),
+    )
+    for name, build in cases:
+        with pytest.raises(SettingRefused) as info:
+            build()
+        assert str(info.value) == (
+            f"{name} cannot be looked at (the system would not let the desk look at a part of that path)"
+        )
+
+
+@pytest.mark.parametrize(
+    ("code", "expected"),
+    [
+        (errno.ENOENT, "absent"),
+        (errno.ENOTDIR, "absent"),
+        (errno.ELOOP, "absent"),
+        (errno.EACCES, "unreadable"),
+        (errno.EPERM, "unreadable"),
+        (errno.EIO, "unreadable"),
+    ],
+)
+def test_path_kind_sorts_every_stat_error(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, code: int, expected: str
+) -> None:
+    def stat(self: Path, *args: Any, **kwargs: Any) -> os.stat_result:
+        raise OSError(code, "x")
+
+    monkeypatch.setattr(Path, "stat", stat)
+    assert path_kind(tmp_path / "x") == expected
+
+
+def test_path_kind_names_a_folder_a_file_and_nothing(tmp_path: Path) -> None:
+    f = tmp_path / "a-file"
+    f.write_text("x", encoding="utf-8")
+    assert path_kind(tmp_path) == "folder"
+    assert path_kind(f) == "file"
+    assert path_kind(tmp_path / "none") == "absent"
+    assert path_kind(f / "below") == "absent"  # ENOTDIR
+
