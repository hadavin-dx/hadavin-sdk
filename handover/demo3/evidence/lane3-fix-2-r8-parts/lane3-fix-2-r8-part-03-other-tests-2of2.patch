+        "a symbolic link",
+        "chmod 600",
+        "other users",
+        "byte-order mark",
+        "4096 bytes, counting the line break",
+        "kept as text",
+        "a named pipe",
+        "a device",
+        "read once at the start",
+        "read again at every call",
+        "the owner of the file is not checked",
