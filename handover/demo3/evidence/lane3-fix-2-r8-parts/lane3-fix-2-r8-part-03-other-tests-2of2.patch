+        "docs/tests.md", "load_tools/README.md", "scripts/real-run.env.example",
+    ):  # fmt: skip
+        text = _doc(name)
+        assert RULE not in text, name
+        assert "a symbolic link is refused" not in text and "who is allowed to read a key" not in text, name
+        assert "the permission bits are not checked" not in text, name
+    for name in ("contract.md", "docs/limits.md", "docs/n8n-recipe.md"):
+        assert "docs/settings.md#key-and-password-files" in _doc(name), name
+
+
+def test_the_settings_page_agrees_with_itself_about_when_each_file_is_read() -> None:
+    text = _doc("docs/settings.md")
+    assert "permissions of the file are not checked" not in text.lower()
+    assert "; Only the line break" not in text and "; only the line break" not in text
+    lines = (REPO / "docs" / "settings.md").read_text(encoding="utf-8").splitlines()
+    row = next(x for x in lines if x.startswith("| `DESK_LIVE_KEY_FILE`"))
+    assert "read once at start and not kept" not in row  # the one section says when each file is read
