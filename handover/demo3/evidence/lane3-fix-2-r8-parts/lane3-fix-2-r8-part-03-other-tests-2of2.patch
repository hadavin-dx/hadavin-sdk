+        if self.name in portal_demo.ASSET_TYPES:
+            raise PermissionError(13, "denied")  # what Python 3.12 and later raises for a folder it cannot look at
+        return real_read(self, *a, **k)
+
+    def deny_stat(self: Path, *a: Any, **k: Any) -> Any:
+        raise AssertionError("the assets are not asked about with stat or is_file")
+
+    monkeypatch.setattr(Path, "read_bytes", deny)
+    monkeypatch.setattr(Path, "is_file", deny_stat)
+    page = portal_demo.PortalDemo(desk=object(), desk_url="http://127.0.0.1:1")  # type: ignore[arg-type]
+    assert page.assets == {}
+
+
+# ----------------------------------------------------------------- the key-file rule is written in exactly one place
+RULE = "Only the line break at the very end of the file is removed"
+SECTION = "## Key and password files"
+
+
+def _doc(name: str) -> str:
+    return " ".join((REPO / name).read_text(encoding="utf-8").split())
+
+
+def test_the_whole_key_file_rule_is_in_one_section_of_the_settings_page() -> None:
+    text = (REPO / "docs" / "settings.md").read_text(encoding="utf-8")
+    assert text.count(SECTION) == 1
+    section = " ".join(text.split(SECTION)[1].split("\n## ")[0].split())
+    for part in (
