+    assert "DESK_DB_PATH names a folder that cannot be made" in out
+
+
+def _deny_looking_inside(monkeypatch: pytest.MonkeyPatch, locked: Path) -> None:
+    """Make every stat() of `locked` or anything below it fail with EACCES, as a folder without the search permission
+    does for a normal user. It works as root too (a real chmod does not), so these tests also run in this sandbox."""
+    real_stat = Path.stat
+
+    def stat(self: Path, *args: Any, **kwargs: Any) -> os.stat_result:
+        if self == locked or locked in self.parents:
+            raise PermissionError(errno.EACCES, "Permission denied")
+        return real_stat(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "stat", stat)
+
+
+def test_a_db_path_below_a_folder_that_cannot_be_looked_into_exits_4_with_no_path(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    locked = tmp_path / "locked"
