+def _fresh(monkeypatch: pytest.MonkeyPatch, name: str, path: Path) -> types.ModuleType:
+    """Load a file as a module with its own name; monkeypatch puts sys.modules back: nothing leaks to a later test."""
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec and spec.loader
+    mod = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, name, mod)
+    spec.loader.exec_module(mod)
+    return mod
+
