+def test_a_person_never_reads_the_wrong_spelling_of_lead_book() -> None:
+    hits: list[tuple[str, int, str, str]] = []
+    for p in sorted(REPO.rglob("*")):
+        if not p.is_file() or p.suffix not in {".py", ".md", ".sh", ".ps1", ".sql", ".txt", ".json", ".yml"}:
+            continue
+        rel = p.relative_to(REPO)
+        if rel.parts[0] in {".git", ".venv", "data", "node_modules"} or "__pycache__" in rel.parts:
+            continue
+        for n, line in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
+            if re.search(WORD, line, re.I):
+                hits.append((rel.as_posix(), n, line.strip(), "-"))
+    bad, stale = _unallowed(hits, ALLOWED_WRONG_WORD)
+    assert bad == [], bad
+    assert stale == [], stale
