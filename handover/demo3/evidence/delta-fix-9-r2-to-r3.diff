+def test_the_data_folder_check_keeps_an_exit_code_that_is_not_a_plain_pass(tmp_path: Path) -> None:
+    """A run that already ended with a usage-style code keeps that code; the message about data still shows."""
+    probe = (
+        "from pathlib import Path\n\nimport pytest\n\n"
+        "def test_leaves_data_then_stops():\n"
+        "    (Path(__file__).resolve().parent.parent / 'data').mkdir()\n"
+        "    pytest.exit('stop here', returncode=4)\n"
+    )
+    done, copy = _run_in_copy(tmp_path, probe)
+    assert (copy / "data").is_dir(), "the probe must have made the folder"
+    assert done.returncode == 4, ("the original exit code was replaced", done.returncode, done.stdout[-1500:])
