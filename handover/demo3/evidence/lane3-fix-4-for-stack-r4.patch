+++ b/tests/test_email_case_rule.py
@@ -0,0 +1,220 @@
+"""Which email addresses become one lead, and which letters the desk cannot join when they are written in capitals.
+
+The desk makes the lead key with Python's `lower()` (identity.normalise_email). A few letters do not turn back into
+the same small letter after capitals: ß (capital SS), ı (capital I) and ſ (capital S), among rarer ones. The key tests
+here fail if the code changes (for example to `casefold()`); whoever makes them pass must also change the documents:
+README.md (the definition of Same lead and the Not claimed list), docs/limits.md, contract.md and docs/tests.md.
+The document tests fail if one of those places stops naming the three letters or the phrase "different lead", if the
+README and docs/limits.md remedy stops naming what the Leads list shows, or if the docs/limits.md sentences on other
+address forms and on the refused letters are removed.
+Made-up data only (example.com)."""
+
+from __future__ import annotations
+
+import re
+import time
+
+import pytest
+from support import REPO, call, lead, post_lead
+
+from lead_desk.constants import EMAIL_MAX
+from lead_desk.identity import check_payload, normalise_email
+
+DOMAIN = "@example.com"
+# (lower-case spelling, capitals spelling): the pairs that the desk keeps as two leads
+SPLIT_PAIRS = [
+    ("straße" + DOMAIN, "STRASSE" + DOMAIN),  # ß, the German sharp s; its capital is SS
+    ("ıstanbul" + DOMAIN, "ISTANBUL" + DOMAIN),  # ı, the Turkish dotless i; its capital is I
+    ("ſam" + DOMAIN, "SAM" + DOMAIN),  # ſ (U+017F), the old long s; its capital is S
+]
+# one address spelled two ways that still gives one key (the letters checked and found safe)
+SAME_PAIRS = [
+    ("émile" + DOMAIN, "ÉMILE" + DOMAIN),
+    ("müller" + DOMAIN, "MÜLLER" + DOMAIN),
+    ("özil" + DOMAIN, "ÖZIL" + DOMAIN),
+    ("françois" + DOMAIN, "FRANÇOIS" + DOMAIN),
+    ("ada" + DOMAIN, "ADA@" + "example.com".upper()),  # the capital domain is built here, not typed
+]
+# a first capital or mixed case is also a different lead from the ß or ı spelling
+OTHER_CASES = [("straße" + DOMAIN, "StraSSe" + DOMAIN), ("ıstanbul" + DOMAIN, "Istanbul" + DOMAIN)]
+LETTERS = "ßıſ"
+PHRASE = re.compile(r"different\s+lead")
+DOC_PLACES = {  # name -> (file, words that appear in exactly one line of that file: the line holding the claim)
+    "README, definition of Same lead": ("README.md", "means the same email address"),
+    "README, Not claimed list": ("README.md", "the same address in capitals"),
+    "docs/limits.md": ("docs/limits.md", "Email addresses written in capitals"),
+    "contract.md": ("contract.md", "not `casefold()`"),
+}
+# two more sentences of docs/limits.md that are pinned: (anchor, words the line must hold)
+OTHER_FORMS_LINE = ("docs/limits.md", "Other address forms stay separate leads", ("xn--", "brackets", "64", "254"))
+REFUSED_LINE = ("docs/limits.md", "The Kelvin sign (U+212A)", ("U+212A", "U+0130", "refused", "review list"))
+# The portal Leads list shows every address in small letters (portal/pages/leads.js, `toLowerCase()`), so the remedy
+# names the two entries as the person sees them: the rare small letter next to the plain small letters.
+SCREEN_FORMS = (
+    "`straße@…` next to `strasse@…`",
+    "`ıstanbul@…` next to `istanbul@…`",
+    "`ſam@…` next to `sam@…`",
+    "shows every address in small letters",
+)
+REMEDY_PLACES = {
+    "README, definition of Same lead": DOC_PLACES["README, definition of Same lead"],
+    "docs/limits.md": DOC_PLACES["docs/limits.md"],
+}
+
+
+def _splits(letter: str) -> bool:
+    """True when the desk gives the letter and its capital form two different keys."""
+    return normalise_email(letter + DOMAIN) != normalise_email(letter.upper() + DOMAIN)
+
+
+@pytest.mark.parametrize(("small", "capitals"), SPLIT_PAIRS)
+def test_split_pairs_differ(small: str, capitals: str) -> None:
+    msg = "the key rule changed: change the code and README, docs/limits.md, contract.md and docs/tests.md together"
+    assert normalise_email(small) != normalise_email(capitals), f"{small} and {capitals} now give one key; {msg}"
+    for email in (small, capitals):  # both are valid addresses, so each one becomes a lead of its own
+        assert check_payload({"name": "Ada", "email": email}).kind == "ok", f"{email} should be accepted"
+
+
+@pytest.mark.parametrize(("small", "capitals"), OTHER_CASES)
+def test_first_capital_splits(small: str, capitals: str) -> None:
+    assert normalise_email(small) != normalise_email(capitals), f"{small} and {capitals} now give one key"
+
+
+@pytest.mark.parametrize(("small", "capitals"), SAME_PAIRS)
+def test_safe_letters_one_key(small: str, capitals: str) -> None:
+    assert normalise_email(small) == normalise_email(capitals), f"{small} and {capitals} now give two keys"
+
+
+def test_casefold_claim() -> None:
+    """The documents say case folding would join the ß and ſ pairs but not the ı pair."""
+    joined = [s for s, c in SPLIT_PAIRS if s.casefold() == c.casefold()]
+    assert joined == [SPLIT_PAIRS[0][0], SPLIT_PAIRS[2][0]], f"casefold joins {joined}: the documents say ß and ſ only"
+
+
+def test_other_forms_stay_apart() -> None:
+    """The short list in docs/limits.md: each form is accepted and is its own lead."""
+    plain = "ada" + DOMAIN
+    forms = {
+        "domain with non-ASCII letters": "ada@xü.example.com",
+        "the same domain as punycode": "ada@xn--x-eha.example.com",
+        "comment in brackets": "ada(sales)" + DOMAIN,
+        # accepted only while the domain check leaves brackets alone: lane3-fix-8 says an IP address in square
+        # brackets after the @ is "not checked"; if that decision changes, change this form and docs/limits.md
+        "domain in square brackets": "ada@[example.com]",
+    }
+    keys = {normalise_email(plain)}
+    for what, email in forms.items():
+        assert check_payload({"name": "Ada", "email": email}).kind == "ok", f"{what} is no longer accepted"
+        keys.add(normalise_email(email))
+    assert len(keys) == len(forms) + 1, "two of these forms now give one key: change docs/limits.md"
+    room = EMAIL_MAX - len(DOMAIN)
+    for size, kind in ((65, "ok"), (room, "ok"), (room + 1, "review")):  # no 64-character limit before the @
+        got = check_payload({"name": "Ada", "email": "a" * size + DOMAIN}).kind
+        assert got == kind, f"{size} characters before the @ gave {got}, docs/limits.md says {kind}"
+
+
+def test_other_rare_letters() -> None:
+    """docs/limits.md names µ, ŉ, ǰ and a Greek final sigma before a full stop as more letters that split: both
+    spellings are valid addresses (so each is a lead) and they give two different keys."""
+    pairs = [(c + DOMAIN, c.upper() + DOMAIN) for c in "µŉǰ"] + [("οδος.x" + DOMAIN, "ΟΔΟΣ.X" + DOMAIN)]
+    for small, capitals in pairs:
+        assert normalise_email(small) != normalise_email(capitals), f"{small} now joins {capitals}: change the docs"
+        for email in (small, capitals):
+            assert check_payload({"name": "Ada", "email": email}).kind == "ok", f"{email!r} should be accepted"
+
+
+def test_refused_letters() -> None:
+    """The Kelvin sign and the dotted capital I are refused (verdict review), not split into two leads."""
+    for email in ("\u212a" + DOMAIN, "\u0130stanbul" + DOMAIN):
+        assert check_payload({"name": "Ada", "email": email}).kind == "review", f"{email!r} is no longer refused"
+
+
+SEND_WAIT_SECONDS = 10  # the most the tests wait for the desk to send the follow-ups
+
+
+def _desk_run(env, first: str, second: str, expected_sent: int) -> tuple[list[tuple[int, str]], int, int, int, int]:
+    """Two requests, then wait (at most SEND_WAIT_SECONDS) until `expected_sent` follow-ups are `sent`.
+    Returns the two answers, the number of leads, `new` from /counts, the follow-up rows and the emails the stand-in
+    mail system received."""
+    rig = env.rig()
+    base = env.serve(rig)
+    answers = [post_lead(base, "form", f"r{i}", lead(email=e)) for i, e in enumerate((first, second), 1)]
+    stop = time.monotonic() + SEND_WAIT_SECONDS
+    sent = "SELECT count(*) FROM followups WHERE state = 'sent'"
+    while time.monotonic() < stop and rig.query(sent)[0][0] < expected_sent:
+        time.sleep(0.05)
+    counts = call(base, "GET", "/counts")
+    assert counts[0] == 200, f"/counts answered {counts[0]}"
+    rows = int(rig.query("SELECT count(*) FROM followups")[0][0])
+    return [(a[0], a[1]["verdict"]) for a in answers], rig.leads(), counts[1]["new"], rows, rig.outbox.count
+
+
+@pytest.mark.parametrize(("small", "capitals"), SPLIT_PAIRS)
+def test_desk_two_leads_two_mails(env, small: str, capitals: str) -> None:
+    """The cost of the rule on the real desk: two `new` answers, two leads, two follow-ups, two emails received."""
+    answers, leads, news, rows, mails = _desk_run(env, small, capitals, 2)
+    assert answers == [(201, "new"), (201, "new")], f"expected two new leads, got {answers}"
+    assert (leads, news, rows) == (2, 2, 2), f"expected 2 leads, 2 new, 2 follow-ups, got {leads}, {news}, {rows}"
+    assert mails == 2, f"the stand-in mail system received {mails} emails for {small} and {capitals}, expected 2"
+
+
+def test_desk_plain_capitals_one_lead(env) -> None:
+    """The control: ordinary capitals are one lead, so the second request is a duplicate and one email goes out."""
+    answers, leads, news, rows, mails = _desk_run(env, *SAME_PAIRS[0], 1)
+    assert answers == [(201, "new"), (200, "duplicate")], f"expected new then duplicate, got {answers}"
+    got = (leads, news, rows, mails)
+    assert got == (1, 1, 1, 1), f"expected 1 lead, 1 new, 1 row, 1 email, got {got}"
+
+
+def _line(path: str, anchor: str) -> str:
+    """The one line of the document that holds the anchor words. Fails unless exactly one line holds them."""
+    lines = [x for x in (REPO / path).read_text(encoding="utf-8").splitlines() if anchor in x]
+    assert len(lines) == 1, f"{path}: {len(lines)} lines hold {anchor!r}, expected exactly 1; the anchor words moved"
+    return lines[0]
+
+
+def _place_text(name: str) -> str:
+    return _line(*DOC_PLACES[name])
+
+
+@pytest.mark.parametrize("place", sorted(DOC_PLACES))
+def test_docs_name_the_letters(place: str) -> None:
+    """Each place names every letter the code splits, and says a different lead results."""
+    letters = [c for c in LETTERS if _splits(c)]
+    assert letters == list(LETTERS), f"the code now splits only {letters}: change all places that name {LETTERS}"
+    text = _place_text(place)
+    for letter in letters:
+        assert letter in text, f"{place} must name {letter!r}: the desk keeps it apart from its capital"
+    assert PHRASE.search(text), f"{place} must say that the two spellings are a different lead"
+
+
