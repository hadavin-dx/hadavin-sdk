@@ -0,0 +1,181 @@
+"""free_port() and held_port() (tests/support.py) never give one port number to two callers, and a held number is
+released after every test by the autouse fixture in tests/conftest.py. The operating system's answers are made up
+here (a stand-in for the socket module), so the result is exact on every machine and no real port is taken."""
+
+from __future__ import annotations
+
+import os
+import socket
+import threading
+from collections import deque
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+import support
+from support import HOST, free_port, held_port, release_held_ports
+
+
+def test_a_held_port_is_given_to_no_other_socket_and_is_free_again_after_the_release() -> None:
+    port = held_port()
+    try:
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as other:
+            with pytest.raises(OSError):
+                other.bind((HOST, port))
+        with pytest.raises(OSError), socket.create_connection((HOST, port), timeout=2):
+            pass  # bound but not listening: nothing answers
+        taken = {free_port() for _ in range(50)}  # never a number that is held
+        assert port not in taken
+    finally:
+        release_held_ports()
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as again:
+        again.bind((HOST, port))
+
+
+def test_the_held_ports_of_a_test_are_released_by_the_fixture_in_conftest(request: pytest.FixtureRequest) -> None:
+    assert "_release_held_ports" in request.fixturenames, "no autouse fixture releases the held ports after a test"
+
+
+class _MadeUpSocket:
+    """Takes the next number from the list when it is bound to port 0; holds nothing and listens nowhere."""
+
+    numbers: deque[int] = deque()
+
+    def __init__(self, *_args: Any) -> None:
+        self.number = 0
+
+    def __enter__(self) -> _MadeUpSocket:
+        return self
+
+    def __exit__(self, *_exc: object) -> None:
+        self.close()
+
+    def bind(self, address: tuple[str, int]) -> None:
+        self.number = self.numbers.popleft()
+
+    def getsockname(self) -> tuple[str, int]:
+        return (HOST, self.number)
+
+    def close(self) -> None:
+        pass
+
+
+def _operating_system_hands_out(monkeypatch: pytest.MonkeyPatch, numbers: list[int]) -> None:
+    _MadeUpSocket.numbers = deque(numbers)
+    stand_in = SimpleNamespace(socket=_MadeUpSocket, AF_INET=socket.AF_INET, SOCK_STREAM=socket.SOCK_STREAM)
+    monkeypatch.delenv("PYTEST_XDIST_WORKER", raising=False)  # the made-up numbers are the serial case
+    monkeypatch.setattr(support, "socket", stand_in)
+    monkeypatch.setattr(support, "_HELD_PORTS", [])
+    monkeypatch.setattr(support, "_GIVEN_FREE", deque(maxlen=512), raising=False)
+
+
+def test_free_port_never_returns_a_number_that_held_port_holds(monkeypatch: pytest.MonkeyPatch) -> None:
+    held, other = 41001, 41002
+    _operating_system_hands_out(monkeypatch, [held, held, held, other])
+    assert held_port() == held
+    assert free_port() == other  # the answers that said `held` again were refused
+
+
+def test_held_port_never_returns_a_number_that_free_port_gave_away(monkeypatch: pytest.MonkeyPatch) -> None:
+    given, other = 41003, 41004
+    _operating_system_hands_out(monkeypatch, [given, given, other])
+    assert free_port() == given
+    assert held_port() == other  # the caller of free_port() may bind `given` at any moment
+
+
+def test_free_port_stops_with_a_clear_error_when_every_answer_is_held(monkeypatch: pytest.MonkeyPatch) -> None:
+    _operating_system_hands_out(monkeypatch, [41005] * 101)
+    assert held_port() == 41005
+    with pytest.raises(AssertionError, match="held"):
+        free_port()
+
+
+def _ranges(count: int) -> list[tuple[int, int]]:
+    ranges = []
+    for n in range(count):
+        found = support.worker_port_range(f"gw{n}", str(count))
+        assert found is not None
+        ranges.append(found)
+    return ranges
+
+
+def test_the_port_ranges_of_two_xdist_workers_never_overlap() -> None:
+    assert support.worker_port_range("gw0", "4") == (40000, 44999)
+    assert support.worker_port_range("gw1", "4") == (45000, 49999)
+    assert support.worker_port_range("gw3", "4") == (55000, 59999)
+    for count in (1, 2, 4, 5, 6, 8, 16, 32, 64):
+        ranges = sorted(_ranges(count))
+        for (_, high), (low, _) in zip(ranges, ranges[1:], strict=False):
+            assert high < low, (count, ranges)
+        assert ranges[0][0] >= 40000 and ranges[-1][1] <= 65535, (count, ranges)
+        assert all(low <= high for low, high in ranges)
+
+
+def test_a_run_without_xdist_keeps_the_numbers_the_operating_system_chooses() -> None:
+    assert support.worker_port_range(None, None) is None
+    assert support.worker_port_range("master", "4") is None
+    for odd in ("gwx", "gw", "gw1x", "xgw1", "GW1", ""):
+        assert support.worker_port_range(odd, "4") is None, odd
+
+
+def test_a_worker_number_beyond_the_worker_count_still_gets_its_own_range() -> None:
+    low, high = support.worker_port_range("gw6", "2") or (0, 0)  # a count that is too small is raised to the number
+    assert (low, high) not in _ranges(2) and 40000 <= low <= high <= 65535
+
+
+def test_free_and_held_ports_of_a_worker_lie_in_its_range(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("PYTEST_XDIST_WORKER", "gw2")
+    monkeypatch.setenv("PYTEST_XDIST_WORKER_COUNT", "4")
+    low, high = support.worker_port_range("gw2", "4") or (0, 0)
+    try:
+        numbers = [free_port() for _ in range(5)] + [held_port() for _ in range(5)]
+    finally:
+        release_held_ports()
+    assert all(low <= n <= high for n in numbers), (low, high, numbers)
+
+
+class _PerThreadEnviron:
+    """os.environ as seen by the code under test, except that PYTEST_XDIST_WORKER and PYTEST_XDIST_WORKER_COUNT
+    answer per thread, so that two threads can play two xdist workers in one process."""
+
+    worker_of_thread: dict[int, str] = {}
+
+    def get(self, key: str, default: str | None = None) -> str | None:
+        if key == "PYTEST_XDIST_WORKER":
+            return self.worker_of_thread.get(threading.get_ident())
+        if key == "PYTEST_XDIST_WORKER_COUNT":
+            return "2"
+        return os.environ.get(key, default)
+
+
+class _OsWithPerThreadEnviron:
+    environ = _PerThreadEnviron()
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(os, name)
+
+
+def test_two_workers_calling_free_port_at_once_get_distinct_numbers_inside_their_own_ranges(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr(support, "os", _OsWithPerThreadEnviron())
+    start = threading.Barrier(2)
+    got: dict[str, list[int]] = {}
+
+    def play(worker: str) -> None:
+        _PerThreadEnviron.worker_of_thread[threading.get_ident()] = worker
+        start.wait(timeout=10)  # both threads call free_port() together
+        got[worker] = [free_port() for _ in range(200)]
+
+    threads = [threading.Thread(target=play, args=(name,)) for name in ("gw0", "gw1")]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join(timeout=120)
+    assert not any(t.is_alive() for t in threads), "a worker thread did not finish"
+    assert set(got) == {"gw0", "gw1"}
+    for worker, numbers in got.items():
+        low, high = support.worker_port_range(worker, "2") or (0, 0)
+        assert (low, high) == ((40000, 44999) if worker == "gw0" else (45000, 49999))
+        assert all(low <= n <= high for n in numbers), (worker, low, high)
+    assert not set(got["gw0"]) & set(got["gw1"]), "two workers were given the same port number"
