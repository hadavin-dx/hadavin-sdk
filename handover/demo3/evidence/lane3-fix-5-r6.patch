+@pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+@pytest.mark.parametrize(
+    ("version", "refused"),
+    [("3 2 57", True), ("3 0 0", True), ("4 0 44", True), ("4 1 0", False), ("4 4 20", False), ("5 2 21", False)],
+)
+def test_reset_sh_refuses_a_bash_older_than_4_1_with_exit_2(version: str, refused: bool) -> None:
+    """`read -N` needs bash 4.1. On an older bash a valid pid would read as empty and count as stale. The guard line
+    is run alone with a made-up version (BASH_VERSINFO itself is read-only), as a standalone line with set -eu."""
+    line = _version_guard_line().replace("BASH_VERSINFO", "MADE_UP_VERSINFO")
+    done = _run(
+        SCRIPT, Path("unused.sqlite3"), code=f"set -eu\nMADE_UP_VERSINFO=({version})\n{line}\necho PAST-THE-GUARD"
+    )
+    if refused:
+        assert done.returncode == 2 and "PAST-THE-GUARD" not in done.stdout, (done.stdout, done.stderr)
+        assert "bash 4.1" in done.stderr and "nothing was stopped or deleted" in done.stderr
+    else:
+        assert done.returncode == 0 and "PAST-THE-GUARD" in done.stdout, (done.stdout, done.stderr)
+
