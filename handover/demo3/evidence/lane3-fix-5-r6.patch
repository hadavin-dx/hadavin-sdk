+# -- the helper `proc_args` itself, cut out of the script text and run in bash with a stand-in `ps` (first on PATH)
+def _proc_args(tmp: Path, pid: str, ps_body: str, tr_body: str | None = None) -> tuple[str, list[str], int]:
+    """Run reset.sh's `proc_args` for `pid`. The stand-in `ps` writes its arguments (one call per line) to a file and
+    then runs ps_body; a stand-in `tr` (tr_body) is added only when given. Returns (output, ps calls, exit code)."""
+    stubs = tmp / "stubs"
+    stubs.mkdir()
+    log = tmp / "ps-calls.txt"
+    ps_text = f'#!/usr/bin/env bash\nprintf \'%s\\n\' "$*" >> "{log}"\n{ps_body}\n'
+    (stubs / "ps").write_text(ps_text, encoding="utf-8")
+    (stubs / "ps").chmod(0o755)
+    if tr_body is not None:
+        (stubs / "tr").write_text(f"#!/usr/bin/env bash\n{tr_body}\n", encoding="utf-8")
+        (stubs / "tr").chmod(0o755)
+    text = REPO_SCRIPT.read_text(encoding="utf-8")
+    start = text.index("proc_args() {")
+    func = text[start : text.index("\n}\n", start) + 3]
+    done = _run(SCRIPT, tmp / "unused.sqlite3", first_on_path=stubs, code=f"{func}\nproc_args {shlex.quote(pid)}")
+    calls = log.read_text(encoding="utf-8").splitlines() if log.exists() else []
+    return done.stdout, calls, done.returncode
+
