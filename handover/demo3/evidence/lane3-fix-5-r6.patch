@@ -0,0 +1,173 @@
+"""scripts/reset.ps1 must decide like scripts/reset.sh: a pid file is one plain process number or it is stale, and a
+process is the desk only when its command line is `python -m lead_desk.server ...` (or the demo server), not when the
+marker text is just somewhere in it. NOT run here: PowerShell and Windows (no Windows runner was available when this
+was written, so reset.ps1 itself is unverified by a run). What runs on every machine: the script text is read, the
+old bare `-match` and bare `[int](Get-Content ...)` must be gone, and the pattern the script holds is applied to a
+table of command lines with Python's `re` (close to, but not the same engine as, PowerShell's). The one test that
+really runs reset.ps1 needs Windows."""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+from pathlib import Path
+
+import pytest
+from support import REPO, WINDOWS, reset_kept, reset_run, start_proc, stop_proc, wait_until
+
+SCRIPT_TEXT = (REPO / "scripts" / "reset.ps1").read_text(encoding="utf-8")
+
+
+def _code() -> str:
+    return "\n".join(ln for ln in SCRIPT_TEXT.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def _ours_pattern() -> str:
+    """The pattern reset.ps1 builds: `$interpreter = '...'` and `$ours = '...' + $interpreter + '...'`."""
+    code = _code()
+    interpreter = re.search(r"^\$interpreter = '(?P<text>.*)'$", code, re.MULTILINE)
+    ours = re.search(r"^\$ours = (?P<expr>.*)$", code, re.MULTILINE)
+    assert interpreter and ours, "reset.ps1 has no $interpreter and $ours patterns for the desk's command line"
+    parts = []
+    for token in re.finditer(r"'([^']*)'|\$interpreter", ours.group("expr")):
+        parts.append(token.group(1) if token.group(1) is not None else interpreter.group("text"))
+    return "".join(parts)
+
+
+def test_the_old_bare_substring_match_and_the_unchecked_number_are_gone() -> None:
+    code = _code()
+    assert not re.search(r"-match\s+'lead_desk\\\.server\|", code), "the bare substring match is back"
+    assert "[int](Get-Content" not in code, "the pid file is converted without a shape check (abc, two lines throw)"
+    assert "[int]::TryParse" in code and "-cmatch '^[1-9][0-9]*$'" in code, "the pid shape rule is missing"
+    assert re.search(r"\$proc\.CommandLine\s+-cmatch\s+\$ours", code), "the command line is not judged by -cmatch"
+    assert not re.search(r"\$proc\.CommandLine\s+-match\b", code), "the case-insensitive -match is back"
+    # an empty file gives $null: the text is built without calling .Trim() on it
+    assert re.search(r"\$null\s+-eq\s+\$raw", code), "an empty pid file is not guarded"
+    assert "Get-Content" not in code, "the whole pid file is read (reset.sh reads at most 64 characters)"
+
+
+@pytest.mark.parametrize(
+    ("line", "ours"),
+    [
+        ("python -m lead_desk.server", True),
+        ('"C:\\Users\\me\\venv\\Scripts\\python.exe" -m lead_desk.server', True),
+        ('"C:\\Program Files\\Python312\\python.exe" -m lead_desk.server', True),
+        ("C:\\Program Files\\Python312\\python.exe -m lead_desk.server", False),  # no quotes, a space: the safe side
+        ("C:\\venv\\python.exe -m lead_desk.server", True),
+        ("C:\\x\\pythonw.exe -m demo_only.fakes_server --outbox keyed --port 5", True),
+        ("C:\\Python312\\Python.exe -m lead_desk.server", True),  # the same first letter rule as reset.sh: [Pp]ython
+        ('"C:\\Python312\\Python.exe" -m lead_desk.server', True),  # quoted: the same [Pp]ython rule
+        ('"C:\\Python312\\PYTHON.EXE" -m lead_desk.server', False),
+        ("PYTHON.EXE -m LEAD_DESK.SERVER", False),  # -cmatch: the whole line is compared with its letter case
+        ("python -M lead_desk.server", False),
+        ("python -m Lead_Desk.Server", False),
+        ("python -m DEMO_ONLY.FAKES_SERVER", False),
+        ("notepad lead_desk.server.py", False),
+        ("python -m lead_desk.server.py", False),
+        ("python -m lead_desk.serverx", False),
+        ("python -m xlead_desk.server", False),
+        ("python -mlead_desk.server", False),
+        ("python lead_desk.server", False),
+        ("C:\\python-tools\\less.exe -m lead_desk.server", False),
+        ("cmd /c echo python -m lead_desk.server", False),
+        ('powershell -Command "python -m demo_only.fakes_server.py"', False),
+    ],
+)
+def test_the_command_line_pattern_in_reset_ps1_accepts_only_the_real_shapes(line: str, ours: bool) -> None:
+    assert bool(re.search(_ours_pattern(), line)) is ours, line  # no IGNORECASE: -cmatch
+
+
+@pytest.mark.parametrize(
+    ("text", "plain"),
+    [("123", True), ("1", True), ("007", False), ("0", False), ("abc", False), ("12 34", False), ("12\n34", False)],
+)
+def test_the_pid_shape_rule_in_reset_ps1_accepts_one_plain_number_only(text: str, plain: bool) -> None:
+    found = re.search(r"-cmatch '(?P<rule>\^\[1-9\]\[0-9\]\*\$)'", _code())
+    assert found, "the pid shape rule is not in reset.ps1"
+    assert bool(re.search(found.group("rule"), text)) is plain, text
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+@pytest.mark.parametrize("text", ["abc", "007", "123\n456\n", ""])
+def test_reset_ps1_treats_a_pid_file_that_is_not_one_number_as_stale(book: Path, text: str) -> None:
+    pidfile = book.parent / "desk.pid"
+    pidfile.write_text(text, encoding="utf-8")
+    done = reset_run("reset.ps1", book)
+    assert done.returncode == 0 and not pidfile.exists(), (done.returncode, done.stdout, done.stderr)
+
+
+@pytest.mark.skipif(not WINDOWS, reason="runs reset.ps1 in Windows PowerShell")
+def test_reset_ps1_does_not_stop_a_program_that_only_has_the_marker_in_its_line(book: Path) -> None:
+    ready = book.parent / "ready"
+    code = "import sys, time; open(sys.argv[-1], 'w').close(); time.sleep(60)"
+    child: subprocess.Popen[bytes] = start_proc(["-c", code, "-m", "lead_desk.server.py", str(ready)], dict(os.environ))
+    try:
+        wait_until(ready.exists, what="the child is running")
+        pidfile = book.parent / "desk.pid"
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = reset_run("reset.ps1", book)
+        still_running = child.poll() is None
+    finally:
+        child.kill()
+        child.wait()
+        stop_proc(child)
+    assert still_running and done.returncode == 6, (done.returncode, done.stdout, done.stderr)
+    assert reset_kept(book) and pidfile.exists()
+
+
+def _reset_sh_code() -> str:
+    text = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8")
+    return "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+
+
+def test_reset_ps1_reads_at_most_64_characters_of_a_pid_file_and_longer_means_stale() -> None:
+    """Same rule as reset.sh (`read -N 64`, 64 or more characters = stale): a read of at most 64 bytes, then the text
+    is dropped when it filled the buffer. A file that cannot be read stays stale (the try/catch)."""
+    code = _code()
+    assert re.search(r"New-Object byte\[\]\s+64\b", code), "the pid file is not read through a 64 byte buffer"
+    assert re.search(r"\.Read\(\$buffer,\s*0,\s*64\)", code), "the read does not stop at 64 bytes"
+    assert re.search(r"\$count\s+-ge\s+64", code), "a pid file of 64 bytes or more is not treated as stale"
+    assert re.search(r"try\s*\{.*?\}\s*catch\s*\{", code, re.DOTALL), "an unreadable pid file is not caught"
+    assert "64" in _reset_sh_code() and "read -r -N 64" in _reset_sh_code(), "reset.sh no longer has the 64 cap"
+
+
+def test_reset_ps1_removes_only_a_plain_file_and_exits_7_like_reset_sh() -> None:
+    """A pid file that is a folder (an empty one would be removed silently by Remove-Item) or cannot be removed gives
+    exit 7 with the wording of reset.sh. PowerShell itself is not run here (the Windows run is the open item)."""
+    code = _code()
+    assert re.search(r"Test-Path\s+-LiteralPath\s+\$pidFile\s+-PathType\s+Leaf", code), "no leaf-only check"
+    assert code.count("exit 7") >= 2, "both the folder case and the failed removal must exit 7"
+    sh_words = re.search(r'echo "(refused: \$pidfile cannot be removed[^"]*)"', _reset_sh_code())
+    assert sh_words, "reset.sh lost its exit 7 message"
+    ps_words = sh_words.group(1).replace("$pidfile", "$pidFile")
+    assert ps_words in code, "the exit 7 wording of reset.ps1 differs from reset.sh"
+    assert re.search(r"catch\s*\{[^}]*exit 7", code), "the failed removal does not end in exit 7"
+    assert re.search(r"try\s*\{\s*Remove-Item\s+-LiteralPath\s+\$pidFile\s+-ErrorAction\s+Stop\s*\}\s*catch", code), (
+        "a failed removal is not caught and turned into exit 7"
+    )
+    assert not re.search(r"^\s*Remove-Item\s+\$pidFile\s*$", code, re.MULTILINE), "the bare Remove-Item is back"
+
+
+def _modules_in(text: str, pattern: str) -> set[str]:
+    return set(re.findall(pattern, text))
+
+
+def test_start_all_ps1_still_starts_the_two_programs_the_way_reset_ps1_recognises_them() -> None:
+    """Pin (the real Windows run is not possible here): start_all.ps1 starts `python -m <module>` by the bare word
+    python, and the modules it starts are exactly those reset.ps1 and reset.sh accept. If one side changes, a reset
+    would refuse (exit 6) or stop the wrong thing."""
+    start = (REPO / "scripts" / "start_all.ps1").read_text(encoding="utf-8")
+    calls = re.findall(r"Start-Process python -ArgumentList '-m', '([a-z_.]+)'", start)
+    assert sorted(calls) == ["demo_only.fakes_server", "lead_desk.server"], calls
+    ours = re.search(r"^\$ours = (?P<expr>.*)$", _code(), re.MULTILINE)
+    assert ours
+    in_ps1 = re.search(r"\((?P<alt>[a-z_\\.|]+)\)", ours.group("expr"))
+    assert in_ps1
+    names_ps1 = {w.replace("\\.", ".") for w in in_ps1.group("alt").split("|")}
+    assert names_ps1 == set(calls)
+    sh = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8")
+    in_sh = _modules_in(sh, r'"\$\{argv\[2\]:-\}" == "([a-z_.]+)"')
+    assert in_sh == set(calls)
+    start_sh = (REPO / "scripts" / "start_all.sh").read_text(encoding="utf-8")
+    assert all(f"-m {m}" in start_sh for m in calls)
