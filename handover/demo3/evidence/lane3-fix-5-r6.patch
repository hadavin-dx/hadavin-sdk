+# -- the interpreter and the module are exact words of the argument list (read from /proc one by one): a program that
+# only CONTAINS the marker text, or has python in a folder name, is left alone
+def _run_against(book: Path, pid_file: str, child: subprocess.Popen[bytes], ready: Path) -> tuple[int, str, bool]:
+    """Name `child` in the pid file, run the reset script, return (exit code, its words, child still running)."""
+    wait_until(ready.exists, what="the child is running")
+    pidfile = book.parent / pid_file
+    try:
+        pidfile.write_text(str(child.pid), encoding="utf-8")
+        done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()), **NARROW)
+        still_running = child.poll() is None
+    finally:
+        _end(child)
+    return done.returncode, done.stdout + done.stderr, still_running
