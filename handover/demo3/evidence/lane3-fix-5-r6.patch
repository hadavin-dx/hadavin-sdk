+def _link(folder: Path, name: str) -> str:
+    """A file called `name` in `folder` that runs this interpreter (a made-up program path); returns its path."""
+    folder.mkdir(parents=True, exist_ok=True)
+    link = folder / name
+    link.symlink_to(sys.executable)
+    return str(link)
+
