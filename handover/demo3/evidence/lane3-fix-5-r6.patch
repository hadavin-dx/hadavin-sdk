+def test_reset_sh_refuses_with_exit_7_when_the_pid_file_is_an_empty_folder_and_keeps_the_book(
+    book: Path, name: str
+) -> None:
+    """A pid file that is a folder cannot be removed: exit 7, nothing else deleted (reset.ps1 must do the same)."""
+    folder = book.parent / name
+    folder.mkdir()
+    done = _run(SCRIPT, book, DESK_PORT=str(_free_port()), DESK_FAKES_PORT=str(_free_port()))
+    assert done.returncode == 7, (done.returncode, done.stdout, done.stderr)
+    assert "cannot be removed" in done.stderr and "nothing else was deleted" in done.stderr
+    assert folder.is_dir() and _kept(book)
