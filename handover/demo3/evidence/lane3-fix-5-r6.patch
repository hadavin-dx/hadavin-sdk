+_VERSION_GUARD_START = "if (( BASH_VERSINFO[0] < 4 ||"
+
+
+def _version_guard_line() -> str:
+    lines = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8").splitlines()
+    found = [line for line in lines if line.startswith(_VERSION_GUARD_START)]
+    assert len(found) == 1, "the bash version guard was not found exactly once at the start of a line"
+    return found[0]
+
