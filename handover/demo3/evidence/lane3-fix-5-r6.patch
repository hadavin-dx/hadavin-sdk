+"""reset.sh tells the desk from another program by its command line, whose marker is the last word. `ps` cuts the
+line at the terminal width when COLUMNS is set (pytest-xdist workers and any terminal set it), so the script must
+read the whole line. Made-up processes only."""
+
+from __future__ import annotations
+
+import os
+import re
+import shlex
+import shutil
+import socket
+import subprocess
+import sys
+from collections.abc import Callable
+from pathlib import Path
+
+import pytest
+from support import (
+    DESK_MODULE,
+    FAKES_MODULE,
+    SLEEP,
+    WINDOWS,
+    dead_pid,
+    start_module_proc,
+    start_proc,
+    stop_proc,
+    stub_tree,
+    wait_until,
+)
+from support import RESET_SCRIPT as SCRIPT
+from support import held_port as _free_port
+from support import reset_kept as _kept
+from support import reset_run as _run
+
+REPO_SCRIPT = Path(__file__).resolve().parents[1] / "scripts" / "reset.sh"
+
+pytestmark = pytest.mark.skipif(WINDOWS, reason="reset.sh is the non-Windows script")
+
+NARROW = {"COLUMNS": "80", "LINES": "24"}
+
