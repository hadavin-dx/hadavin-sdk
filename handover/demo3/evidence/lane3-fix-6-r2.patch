+"""Pin facts that docs/tests.md, docs/real-services.md, contract.md and the README state about the scripts.
+
+Each test reads text files only; nothing slow is run. These statements were wrong in an earlier version of the docs;
+the tests keep them true. Every check looks inside one named paragraph, not anywhere in the file.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _read(rel: str) -> str:
+    return (ROOT / rel).read_text(encoding="utf-8")
+
+
+def _line(rel: str, start: str) -> str:
+    """The one line of a file that begins with `start` (zero or two such lines fail the test)."""
+    found = [ln for ln in _read(rel).splitlines() if ln.startswith(start)]
+    assert len(found) == 1, (rel, start, len(found))
+    return found[0]
+
+
+def _index(rel: str, start: str) -> int:
+    lines = _read(rel).splitlines()
+    return next(i for i, ln in enumerate(lines) if ln.startswith(start))
+
+
+def test_old_desk_commands_are_gone_from_every_doc() -> None:
+    old = re.compile(r"PYTHONPATH=src python (-m lead_desk\.server|scripts/crash_desk\.py)")
+    for rel in ("contract.md", "README.md", "docs/tests.md", "docs/real-services.md"):
+        assert not old.search(_read(rel)), rel
+    assert "PYTHONPATH=src:. python -m lead_desk.server" in _read("contract.md")
+    assert "PYTHONPATH=src:. python -m lead_desk.server" in _read("README.md")
+    assert "crash scene" not in _read("docs/tests.md")
+
+
+def test_by_hand_steps_name_one_window_per_command() -> None:
+    # the dot is written in brackets: a backslash before it would look like a Windows drive path to the hygiene test
+    step1 = _line("docs/tests.md", "1. Window 1, the demo server:")
+    assert re.search(r"PYTHONPATH=src:[.] python -m demo_only\.fakes_server --outbox keyed --port 8766", step1)
+    step2 = _line("docs/tests.md", "2. Window 2, the desk:")
+    assert re.search(r"PYTHONPATH=src:[.] python -m lead_desk\.server", step2)
+    assert re.search(r"PYTHONPATH=src:[.] python scripts/crash_desk\.py", step2)
+    step3 = _line("docs/tests.md", "3. Window 3, one made-up lead:")
+    assert "PYTHONPATH=src python scripts/feed.py --source form --index 1" in step3
+    assert "exit code 137" in step3 and "removes the flag file" in step3
+    assert "scripts/start_all.sh" in _line("docs/tests.md", "`bash scripts/start_all.sh`")
+
+
+def test_start_up_outcomes_match_the_code() -> None:
+    para = _line("docs/tests.md", "What happens when something is missing")
+    shown = r"not running, the desk prints `cannot reach the demo servers[^`]*`"
+    assert re.search(shown + r" and ends with exit code 1", para)
+    assert "`python scripts/crash_desk.py` does not have the current folder" in para
+    assert re.search(r"exit code 1 and a RuntimeError that says the folder `demo_only` is missing", para)
+    assert "ModuleNotFoundError" not in _read("docs/tests.md")
+    assert re.search(r'folder demo_only is "\s*"missing', _read("src/lead_desk/loader.py"))
+    assert "cannot reach the demo servers" in _read("src/lead_desk/server.py")
+    assert 'PYTHONPATH="src:."' in _read("scripts/start_all.sh")
+    assert "EXIT_SIMULATED_KILL: Final = 137" in _read("src/lead_desk/constants.py")
+    assert "simulate crash" in _read("src/lead_desk/hooks.py")
+
+
+def test_windows_powershell_form_is_given_once() -> None:
+    para = _line("docs/tests.md", "On Windows PowerShell, run")
+    assert "$env:PYTHONPATH = 'src;.'" in para
+    assert "'src;.'" in _read("scripts/start_all.ps1")
+    readme = _line("README.md", "The desk alone needs two terminal windows")
+    assert "$env:PYTHONPATH = 'src;.'" in readme
+    assert "cannot reach the demo servers" in readme and "exit code 1" in readme
+
+
+def test_documented_assume_yes_flag_exists_in_the_script() -> None:
+    script = _read("scripts/run_real_check.py")
+    assert re.search(r'add_argument\(\s*"--assume-yes"', script)
+    assert "EXIT_REFUSED, EXIT_STOPPED, EXIT_FAILED = 2, 1, 3" in script
+    assert "refused: --assume-yes is only for the self-test (--dry-fakes); a real run always asks" in script
+    step = _line("docs/real-services.md", "3. Self-test first")
+    assert re.search(r'It asks "Start\? \[y/N\]"; with no terminal to answer on[^.]*exit code 1', step)
+    assert "python scripts/run_real_check.py --dry-fakes --assume-yes" in step
+    assert re.search(r"without `--dry-fakes` prints \"refused: --assume-yes[^\"]*\" and ends with exit code 2", step)
+    assert "ALL CHECKS HOLD" in step and "in two runs by the author" in step.lower()
+
+
+def test_documented_soak_flag_exists_in_the_checker() -> None:
+    checker = _read("load_tools/check_invariants.py")
+    assert re.search(r'add_argument\(\s*"--max-unknown"', checker)
+    assert re.search(r"DEFAULT_MAX_UNKNOWN = \(?\s*0\b", checker)
+    assert "crash_while_sending" in _read("src/lead_desk/desk.py")
+    para = _line("docs/tests.md", "**Blind mail system, many follow-ups at once.**")
+    for must in (
+        "cannot recognise a repeated send",
+        "`crash_while_sending`",
+        "`--max-unknown N`, default 0",
+        "`--max-unknown 100000`, which allows any number",
+        "keyed CRM): 300 rounds",
+        "385 stops in all: 229 at a named crash point",
+        "156 by SIGKILL",
+        "9154 leads",
+        "197 follow-ups ended UNKNOWN, all in 70 of the 300 rounds",
+        "143 of them had 1 email",
+        "54 had none",
+        "no lead had 2 emails",
+        "failed in those 70 rounds and passed in the other 230",
+        "not in this repository",
+    ):
+        assert must in para, must
+    assert "never 2 for one lead" not in para
+    assert 229 + 156 == 385 and 143 + 54 == 197 and 70 + 230 == 300 and 9100 + 54 == 9154
+    # the paragraph comes after the "(Exact places" paragraph, as the table notes belong together
+    assert _index("docs/tests.md", "**Blind mail system") > _index("docs/tests.md", "(Exact places:")
+    assert "see the paragraph" in _line("docs/tests.md", "The desk was stopped on purpose at each of ten crash points")
+
+
+def test_documented_counts_are_the_measured_ones_not_the_stale_ones() -> None:
+    cur = _line("docs/tests.md", "* **Current counts (commit f3c39cf8")
+    assert "**3683 passed and 200 skipped**" in cur and "3883 tests in all" in cur
+    assert "the administrator user on Linux" in cur and "none of the 200 skip reasons names Node" in cur
+    assert "93.52 percent of the code lines" in cur and "not re-measured" in cur
+    full = _line("docs/tests.md", "* **A full run with the first version of this documentation patch")
+    assert "**3689 passed and 200 skipped**" in full and "3683 + 6 = 3689" in full
+    assert "not the count for the latest" in full
+    why = _line("docs/tests.md", "* **Why 200 tests are skipped")
+    assert "166 + 30 + 1 + 1 + 1 + 1 = 200" in why
+    for reason in (
+        "166 are the browser tests",
+        "30 need the `gitleaks` secret-scanning program",
+        "1 is the load measurement, which runs only when `LEAD_DESK_LOAD_N` is set",
+        "1 runs only on Windows",
+        "1 needs a user who is not root",
+        "1 needs Python 3.13",
+    ):
+        assert reason in why, reason
+    parts = [int(n) for n in re.findall(r"\b(\d+) in `test_", why)]
+    assert len(parts) == 7 and sum(parts[:4]) == 166 and sum(parts[4:]) == 30 and 166 + 30 + 4 == 200
+    run = _line("docs/tests.md", "* **The 196 browser and gitleaks tests were run separately")
+    assert "166 + 30 = 196" in run and "241 passed, none skipped" in run and "72 passed, none skipped" in run
+    assert "whole-file totals" in run and "do not add up to 196" in run
+    assert "3684 passed and 199 skipped" in run
+    browser_files = sorted(
+        p.name for p in (ROOT / "tests").glob("test_*.py") if "play" + "wright" in p.read_text(encoding="utf-8").lower()
+    )
+    assert len(browser_files) == 10 and all(name in run for name in browser_files)
+    found = [ln for ln in _read("docs/tests.md").splitlines() if re.search(r"2513 passed|2349 passed", ln)]
+    assert found and all("NOT the current count" in ln or "Older record" in ln for ln in found), found
+    old_eight = _line("docs/tests.md", "* **Older record, history only")
+    assert "2516 tests" in old_eight and "3883" in old_eight
+    assert "this change" not in _read("docs/tests.md")
+
+
+def test_dry_run_people_count_is_the_real_one() -> None:
+    doc = _line("docs/real-services.md", "`scripts/run_real_check.py` runs the same desk")
+    assert "8 invented people plus one of them again under a second address" in doc
+    assert "which makes 9 leads" in doc and "at least 8, at most 1000" in doc and "`REAL_PERSONS`" in doc
+    script = _read("scripts/run_real_check.py")
+    assert re.search(r'"REAL_PERSONS": "8"', script)
+    assert "DEFAULT_PERSONS = 12" in script and "MIN_PERSONS = 8" in script
+    assert "REAL_PERSONS_MAX: Final = 1_000" in _read("src/lead_desk/constants.py")
+    assert "(default 12, at least 8, at most 1000)" in _read("docs/settings.md")
+    assert "the \"twin\"" in _line("docs/real-services.md", "It sends new people")
