diff --git a/tests/test_text_only_naming.py b/tests/test_text_only_naming.py
new file mode 100644
index 0000000..509e890
--- /dev/null
+++ b/tests/test_text_only_naming.py
@@ -0,0 +1,99 @@
+"""A reset test that only reads a script's text must say so in its name (test_text_only_...), and a test with that name
+must not run anything. Reason: reset.ps1 is never run on this machine, and a pin on its text is not evidence that it
+works; the name tells the reader which kind of test they are looking at. The scan is a repository test with planted
+cases (it must find them) and leave-alone cases (it must not)."""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+_PREFIX = "test_text_only_"
+# calls that run a program, or a helper that does; a test that calls one of them is a behaviour or function-level test
+_RUNNERS = frozenset(
+    {
+        "run",
+        "_run",
+        "reset_run",
+        "_check",
+        "Popen",
+        "start_proc",
+        "start_module_proc",
+        "_live",
+        "_alive_answer",
+        "_proc_args",
+        "_run_against",
+        "check_output",
+        "check_call",
+        "call",
+        "stub_tree",
+    }
+)
+
+
+def _called(fn: ast.AST) -> set[str]:
+    names: set[str] = set()
+    for node in ast.walk(fn):
+        if isinstance(node, ast.Call):
+            target = node.func
+            names.add(target.attr if isinstance(target, ast.Attribute) else getattr(target, "id", ""))
+    return names
+
+
+def _reads_text(fn: ast.AST) -> bool:
+    return any(
+        isinstance(node, ast.Call)
+        and isinstance(node.func, ast.Attribute)
+        and node.func.attr in ("read_text", "read_bytes")
+        for node in ast.walk(fn)
+    )
+
+
+def naming_problems(source: str) -> list[str]:
+    """Names of tests in `source` that break the naming rule, each with the reason."""
+    problems = []
+    for fn in ast.parse(source).body:
+        if not (isinstance(fn, ast.FunctionDef) and fn.name.startswith("test_")):
+            continue
+        runs = _called(fn) & _RUNNERS
+        if fn.name.startswith(_PREFIX) and runs:
+            problems.append(f"{fn.name}: named text-only but runs {sorted(runs)}")
+        elif not fn.name.startswith(_PREFIX) and not runs and _reads_text(fn):
+            problems.append(f"{fn.name}: reads a file's text, runs nothing, and is not named {_PREFIX}...")
+    return problems
+
+
+_PLANTED = {
+    "reads text, runs nothing, wrong name": "def test_a_pin():\n    text = path.read_text()\n    assert 'x' in text\n",
+    "named text-only but runs a program": "def test_text_only_b():\n    subprocess.run(['x'])\n",
+    "named text-only but calls the reset helper": "def test_text_only_c():\n    reset_run('s', db)\n",
+}
+_LEFT_ALONE = {
+    "named text-only and only reads": "def test_text_only_a():\n    assert 'x' in path.read_text()\n",
+    "reads text and runs the script": "def test_b():\n    t = p.read_text()\n    subprocess.run([t])\n",
+    "runs through the helper and reads": "def test_c():\n    t = p.read_text()\n    reset_run('s', db)\n",
+    "reads nothing and runs nothing": "def test_d():\n    assert 1 + 1 == 2\n",
+    "not a test": "def helper():\n    return p.read_text()\n",
+}
+
+
+@pytest.mark.parametrize("name", sorted(_PLANTED))
+def test_the_naming_scan_finds_each_planted_case(name: str) -> None:
+    assert len(naming_problems(_PLANTED[name])) == 1, name
+
+
+@pytest.mark.parametrize("name", sorted(_LEFT_ALONE))
+def test_the_naming_scan_leaves_ordinary_tests_alone(name: str) -> None:
+    assert naming_problems(_LEFT_ALONE[name]) == [], name
+
+
+def test_every_reset_test_file_follows_the_text_only_naming_rule() -> None:
+    found = {}
+    for path in sorted((REPO / "tests").glob("test_reset*.py")):
+        problems = naming_problems(path.read_text(encoding="utf-8"))
+        if problems:
+            found[path.name] = problems
+    assert found == {}, found
