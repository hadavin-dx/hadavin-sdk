+    assert _ast_sites(code), code
+
+
+@pytest.mark.parametrize(
+    "code",
+    [
+        "s.bind((HOST, port))",
+        "x = (1, 0)",
+        "self.bad, self.tries = bad, 0",
+        'w["a"] = ("sent", 0)',
+        "s.bind((HOST, 80))",
+        'f(("sent", 0))',
+        "class Stand(object):\n    @property\n    def server_address(self):\n        return (HOST, 0)",
+        "class Stand(object):\n    server_address = (HOST, 0)",
+        "PORT = 8080\ns.bind((HOST, PORT))",
+        's.bind((HOST, int("5")))',
+        "s.bind((HOST, int(port)))",
+        "flag = False\ns.bind((HOST, flag))",
+    ],
+)
+def test_the_syntax_guard_for_direct_binds_leaves_other_pairs_alone(code: str) -> None:
+    assert not _ast_sites(code), code
+
+
+def test_the_allowed_direct_binds_are_servers_that_keep_the_socket_and_none_is_closed_and_bound_again() -> None:
+    """A direct site that only asks for a number and closes it (the free_port shape) would be a gap: none of the listed
+    sites calls .close() on a socket it bound to port 0 and then binds the number again."""
+    here = Path(__file__).resolve().parent
+    for name in _ALLOWED_SITES:
+        text = (here / name).read_text(encoding="utf-8")
+        assert not re.search(r"\.bind\(\s*\(\s*[^,()]+,\s*0\s*\)\s*\)", text), f"{name} binds a plain socket to port 0"
+
+
+def test_the_numbers_the_operating_system_hands_out_never_overlap_the_worker_blocks() -> None:
+    """Linux: /proc/sys/net/ipv4/ip_local_port_range is the range a bind to port 0 draws from. A machine whose setting
+    was widened over the worker blocks is a property of that machine, not of the code: the test is skipped there with
+    the numbers named. (Windows and macOS have no such file; their documented range starts at 49152, above the
+    blocks.) The code's own part is asserted first, on every system: the worker blocks are a real range that ends below
+    49152, where the documented range of Windows and macOS starts. The machine check follows."""
+    assert port_blocks._RANGE_START < port_blocks._RANGE_END < 49152, (port_blocks._RANGE_START, port_blocks._RANGE_END)
+    proc = Path("/proc/sys/net/ipv4/ip_local_port_range")
+    if not proc.exists():
+        pytest.skip("no /proc/sys/net/ipv4/ip_local_port_range on this system")
+    low, high = (int(n) for n in proc.read_text(encoding="utf-8").split())
+    if not (low > port_blocks._RANGE_END or high < port_blocks._RANGE_START):
+        pytest.skip(
+            f"this machine hands out {low}-{high}, which overlaps the worker blocks "
+            f"{port_blocks._RANGE_START}-{port_blocks._RANGE_END} (a setting of the machine, not of the code)"
+        )
+    assert low > port_blocks._RANGE_END or high < port_blocks._RANGE_START, (low, high)
+
+
+def test_the_guard_for_direct_binds_sees_the_shapes_in_use() -> None:
+    shapes = (
+        's.bind(("127.0.0.1", 0))',
+        "srv.bind((HOST, 0))",
+        "self.sock.bind( (HOST,0) )",
+        "ThreadingHTTPServer((HOST, 0), H)",
+        'socketserver.TCPServer(("127.0.0.1", 0), H)',
+        'await asyncio.start_server(cat.handle, "127.0.0.1", 0)',
+    )
+    for line in shapes:
+        assert _SITE.search(line), line
+    other_shapes = ("s.bind((HOST, port))", "s.bind((HOST, first + 0))", 'bind(("127.0.0.1", 80))', "range(a, 0)")
+    for line in (*other_shapes, "x = (1, 0)"):
+        assert not _SITE.search(line), line
+
+
+def test_the_loopback_host_of_the_tests_is_defined_once() -> None:
+    """support.py takes HOST from port_blocks.py: two assignments could drift apart."""
+    assert support.HOST is port_blocks.HOST
+    text = (Path(__file__).resolve().parent / "support.py").read_text(encoding="utf-8")
+    assert not re.search(r"(?m)^HOST\s*=", text), "support.py defines HOST again"
+
+
+@pytest.mark.parametrize("count", [1, 2, 4, 16, 64])
+def test_two_sessions_on_one_machine_draw_from_different_parts_of_the_same_block(count: int) -> None:
+    """Two pytest runs at once both have a gw0 with the same block. The part of the block a process draws from depends
+    on its process number (pid % slices), so neighbouring process numbers get disjoint parts; the part lies inside the
+    block, and a block too narrow to share is used whole."""
+    block = support.worker_port_range("gw0", str(count))
+    assert block is not None
+    windows = [port_blocks.session_window(block, pid) for pid in range(5000, 5000 + 40)]
+    assert all(block[0] <= low <= high <= block[1] for low, high in windows)
+    distinct = sorted(set(windows))
+    assert _all_disjoint(distinct), (count, distinct)
+    assert distinct[0][0] == block[0] and distinct[-1][1] == block[1], (count, distinct)
+    assert all(nxt[0] == prev[1] + 1 for prev, nxt in zip(distinct, distinct[1:], strict=False)), (count, distinct)
+    if block[1] - block[0] + 1 >= 2 * port_blocks._MIN_SLICE:
+        assert len(distinct) >= 2, (count, "neighbouring process numbers share one part")
+        assert port_blocks.session_window(block, 5000) != port_blocks.session_window(block, 5001)
+    else:
+        assert distinct == [block]
+
+
+def test_free_ports_of_a_session_lie_in_that_sessions_part_of_the_block(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("PYTEST_XDIST_WORKER", "gw0")
+    monkeypatch.setenv("PYTEST_XDIST_WORKER_COUNT", "1")
+    block = support.worker_port_range("gw0", "1")
+    assert block is not None
+    low, high = port_blocks.session_window(block, os.getpid())
+    try:
+        numbers = [free_port() for _ in range(5)] + [held_port() for _ in range(5)]
+    finally:
+        release_held_ports()
+    assert all(low <= n <= high for n in numbers), (low, high, numbers)
