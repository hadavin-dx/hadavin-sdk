+def test_no_test_binds_to_port_0_by_itself_except_the_listed_servers_that_keep_their_socket() -> None:
+    """A bind to port 0 that is closed and bound again later (free_port) gets a number that no worker block knows
+    about, so tests ask bound_socket() (or free_port() / held_port()). The only direct sites left are servers that keep
+    their own socket; each file is listed with its count and the reason, so a new site fails here."""
+    found = _direct_sites()
+    surplus = {name: lines for name, lines in found.items() if name not in _ALLOWED_SITES}
+    assert not surplus, f"direct binds to port 0 (use bound_socket, or list them with a reason): {surplus}"
+    for name, (count, reason) in _ALLOWED_SITES.items():
+        assert len(found.get(name, [])) == count, (name, count, found.get(name))
+        assert reason and len(reason) > 40, name
+
+
+_HOSTISH = re.compile(r"host|addr|bind|^ip$|^loopback$", re.IGNORECASE)
+_ALL_INTERFACES = ".".join(["0"] * 4)  # text to recognise, built from parts; nothing is bound
+_HOST_TEXTS = {"", "localhost", "::1", "::", _ALL_INTERFACES}
+
+
+def _hostish(node: ast.AST) -> bool:
+    """The first part of a (host, port) pair: a name or attribute that says host/address (HOST, self.host, cfg.HOST), or
+    a text that is an address or a dotted host name (127.0.0.1, localhost, ::1, example.test, the empty text)."""
+    if isinstance(node, ast.Name):
+        return bool(_HOSTISH.search(node.id))
+    if isinstance(node, ast.Attribute):
+        return bool(_HOSTISH.search(node.attr))
+    if isinstance(node, ast.Constant) and isinstance(node.value, str):
+        return node.value in _HOST_TEXTS or bool(re.fullmatch(r"[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+", node.value))
+    return False
+
+
+def _is_zero(node: ast.AST, zero_names: set[str]) -> bool:
+    """The number 0 in any of the shapes that give the same bind: the literal, int("0") or int(0), or a name that the
+    file sets to such a zero (PORT = 0). Not a bool (False is not a port number written as 0)."""
+    if isinstance(node, ast.Constant):
+        return type(node.value) is int and node.value == 0
+    if isinstance(node, ast.Name):
+        return node.id in zero_names
+    if isinstance(node, ast.Call) and isinstance(node.func, ast.Name) and node.func.id == "int" and len(node.args) == 1:
+        arg = node.args[0]
+        return isinstance(arg, ast.Constant) and (
+            (type(arg.value) is int and arg.value == 0) or (isinstance(arg.value, str) and arg.value.strip() == "0")
+        )
+    return False
+
+
+_BIND_CALLS = re.compile(r"(^|_)(bind|listen|serve|server|start_server|create_server)$|Server$", re.IGNORECASE)
+
+
+def _is_zero_port_pair(node: ast.AST, zero_names: set[str], *, any_host: bool = False) -> bool:
+    """(host, 0): a pair whose second part is a zero port and whose first part says host or is an address. Inside the
+    arguments of a bind or server call (`any_host`) the first part may be anything: the call itself says it binds."""
+    return (
+        isinstance(node, ast.Tuple)
+        and len(node.elts) == 2
+        and _is_zero(node.elts[1], zero_names)
+        and (any_host or _hostish(node.elts[0]))
+    )
+
+
+def _ast_sites(text: str) -> list[int]:
+    """The class, not the line shape. Counted (once per pair, by its line): a (host, 0) pair ANYWHERE in the file (call
+    arguments over several lines, nested parentheses or lists, assignments, returns, default values, yield, lambda,
+    dictionary values ...), a pair of any first part inside the arguments of a bind or server call, a zero written as
+    int("0") or kept in a name the file sets to 0, and start_server/serve given the port 0 (by position or as
+    port=0). The one stand-in left out: the return statement of a `server_address` property, or a `server_address`
+    attribute set directly in a class body (they only report an address and bind nothing)."""
+    tree = ast.parse(text)
+    zero_names: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Assign) and _is_zero(node.value, set()):
+            zero_names.update(t.id for t in node.targets if isinstance(t, ast.Name))
+        elif isinstance(node, ast.AnnAssign) and node.value is not None and _is_zero(node.value, set()):
+            if isinstance(node.target, ast.Name):
+                zero_names.add(node.target.id)
+    skip: set[int] = set()  # the nodes (by id) inside a stand-in
+    for node in ast.walk(tree):
+        if (
+            isinstance(node, ast.FunctionDef)
+            and node.name == "server_address"
+            and any(isinstance(d, ast.Name) and d.id == "property" for d in node.decorator_list)
+        ):
+            for stmt in node.body:  # only its return statements: any other statement is looked at like all code
+                if isinstance(stmt, ast.Return):
+                    skip.update(id(inner) for inner in ast.walk(stmt))
+        if isinstance(node, ast.ClassDef):
+            for stmt in node.body:
+                if isinstance(stmt, (ast.Assign, ast.AnnAssign)):
+                    targets = stmt.targets if isinstance(stmt, ast.Assign) else [stmt.target]
+                    if all(isinstance(t, ast.Name) and t.id == "server_address" for t in targets):
+                        skip.update(id(inner) for inner in ast.walk(stmt))
+    lines: set[int] = set()
+    for node in ast.walk(tree):
+        if id(node) in skip:
+            continue
+        if _is_zero_port_pair(node, zero_names):
+            lines.add(node.lineno)
+        if isinstance(node, ast.Call):
+            name = node.func.attr if isinstance(node.func, ast.Attribute) else getattr(node.func, "id", "")
+            args = [*node.args, *(k.value for k in node.keywords)]
+            if _BIND_CALLS.search(name):
+                for arg in args:
+                    for inner in ast.walk(arg):
+                        if id(inner) not in skip and _is_zero_port_pair(inner, zero_names, any_host=True):
+                            lines.add(inner.lineno)
+            if name in ("start_server", "serve"):
+                zeros = [a for a in node.args[1:] if _is_zero(a, zero_names)]
+                zeros += [k.value for k in node.keywords if k.arg == "port" and _is_zero(k.value, zero_names)]
+                if zeros:
+                    lines.add(node.lineno)
+    return sorted(lines)
+
