+def _without_comment(line: str) -> str:
+    """The line up to a `#` that starts a comment: a `#` outside single and double quotes. (reset.ps1 holds no `#`
+    inside a string; a test below shows that a trailing comment is dropped.)"""
+    quote = ""
+    for i, ch in enumerate(line):
+        if quote:
+            if ch == quote:
+                quote = ""
+        elif ch in "'\"":
+            quote = ch
+        elif ch == "#":
+            return line[:i].rstrip()
+    return line
+
+
+def _strip(text: str) -> str:
+    return "\n".join(c for c in (_without_comment(ln) for ln in text.splitlines()) if c.strip())
