+def _python_stand_in(folder: Path, *, fail_from_call: int, status: int) -> None:
+    """A `python` that works (the real one) for calls before `fail_from_call` and then ends with `status`."""
+    counter = folder / "calls"
+    stand_in = folder / "python"
+    stand_in.write_text(
+        "#!/usr/bin/env bash\n"
+        f'echo x >> "{counter}"; n="$(wc -l < "{counter}")"\n'
+        f"if (( n >= {fail_from_call} )); then exit {status}; fi\n"
+        f'exec "{sys.executable}" "$@"\n',
+        encoding="utf-8",
+    )
+    stand_in.chmod(0o755)
