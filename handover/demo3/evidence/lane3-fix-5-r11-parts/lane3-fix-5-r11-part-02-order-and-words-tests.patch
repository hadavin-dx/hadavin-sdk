+# -- a program that changes between the first look and the stop is not stopped
+_CHANGES_ITS_LINE = (
+    "import os, sys, time\n"
+    "go = sys.argv[-1] + '.go'\n"
+    "open(sys.argv[-1], 'w').close()\n"
+    "while not os.path.exists(go):\n"
+    "    time.sleep(0.05)\n"
+    "marker = sys.argv[-1] + '.changed'\n"
+    "after = 'import sys, time; open(sys.argv[1], \"w\").close(); time.sleep(300)'\n"
+    "os.execv(sys.executable, [sys.executable, '-c', after, marker])\n"
+)
+_ENDS_SLOWLY = (
+    "import os, signal, sys, time\n"
+    "def stop(*_a):\n"
+    "    open(sys.argv[-1] + '.stopping', 'w').close()\n"
+    "    for _ in range(600):\n"  # ends when the test says so (a handshake), or after 30 seconds
+    "        if os.path.exists(sys.argv[-1] + '.exit'):\n"
+    "            break\n"
+    "        time.sleep(0.05)\n"
+    "    sys.exit(0)\n"
+    "signal.signal(signal.SIGTERM, stop)\n"
+    "open(sys.argv[-1], 'w').close()\n"
+    "time.sleep(300)\n"
+)
