+@_posix
+@_NEEDS_UTF8_BASH
+@pytest.mark.parametrize("digits", [1, 2, 3, 4, 5, 6, 7])
+def test_read_pid_file_counts_and_trims_bytes_for_every_digit_count_under_a_utf8_setting(
+    tmp_path: Path, digits: int
+) -> None:
+    number = "7" * digits
+    target = tmp_path / "p.pid"
+    # a number then ideographic spaces: 64 bytes or more after it is stale whatever the characters would count
+    for pad in range(0, 3):
+        spaces = b" " * ((67 - digits) % 3 + pad * 3)
+        target.write_bytes(number.encode() + spaces + "\u3000".encode() * 30)
+        assert _read_pid_file_result(target) == "", (digits, pad)
+    # a short file is read as it is, trimmed in bytes (plain spaces only)
+    target.write_bytes(b"  " + number.encode() + b" \n")
+    assert _read_pid_file_result(target) == number
+    # an ideographic space is not a plain space: bytes above 127 make the file stale
+    target.write_bytes(number.encode() + "\u3000".encode())
+    assert _read_pid_file_result(target) == ""
+
+
+@_posix
+@pytest.mark.parametrize("encoding", ["utf-16-le", "utf-16-be", "utf-32-le"])
+def test_read_pid_file_empties_a_file_whose_zero_bytes_were_dropped_by_read(tmp_path: Path, encoding: str) -> None:
+    """UTF-16 or UTF-32 without a byte order mark: bash's read drops the NUL bytes, so "1\\0 \\0" would read as "1 "
+    and then as a number. The script compares what it read with the file's size and treats the difference as stale."""
+    target = tmp_path / "p.pid"
+    target.write_bytes("4242\n".encode(encoding))
+    assert _read_pid_file_result(target) == ""
