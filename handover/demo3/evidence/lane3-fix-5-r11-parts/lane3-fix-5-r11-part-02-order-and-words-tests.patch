+        '  if [[ "$n" == 3 ]]; then kill -9 "$2"; sleep 0.3; echo S; exit 0; fi\n'
+        "fi\n"
+        f'exec "{real_ps}" "$@"\n',
+        encoding="utf-8",
+    )
+    fake.chmod(0o755)
+    try:
+        done = reset_run(SH, book, first_on_path=folder, RESET_STOP_WAIT_SECONDS="1", **reset_ports())
+    finally:
+        _end(desk, fakes)
+    assert done.returncode == 5 and "did not stop in time" in done.stderr, (done.returncode, done.stderr)
+    assert "already stopped" not in done.stderr, done.stderr
+
