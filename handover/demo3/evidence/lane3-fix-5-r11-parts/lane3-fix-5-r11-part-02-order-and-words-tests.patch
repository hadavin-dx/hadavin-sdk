+# -- the check runs after the stop and BEFORE any pid file is deleted
+@_posix
+def test_reset_sh_keeps_the_desk_pid_file_when_the_check_refuses_after_it_stopped_the_desk(book: Path) -> None:
+    """The desk (named in desk.pid) is stopped, then something else answers on its port: exit 4. The old order had
+    already deleted desk.pid, so the refusal left no trace of what was stopped; now the pid files stay."""
+    desk = _live(book, "desk", DESK_MODULE, _RUNS_UNTIL_STOPPED)
+    try:
+        with bound_socket() as listener:
+            listener.listen(1)
+            done = reset_run(SH, book, DESK_PORT=str(listener.getsockname()[1]), DESK_FAKES_PORT=str(held_port()))
+        wait_until(lambda: desk.poll() is not None, timeout=10, what="the desk stand-in was stopped")
+    finally:
+        _end(desk)
+    assert done.returncode == 4 and done.stdout == "", (done.stdout, done.stderr)
+    assert (book.parent / "desk.pid").exists() and reset_kept(book)
+    assert "nothing was deleted" in done.stderr and "pid files" in done.stderr, done.stderr
+
