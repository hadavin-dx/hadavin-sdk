+@contextmanager
+def book_folder_in_repo(prefix: str) -> Iterator[Path]:
+    """A fresh folder inside the repository's data/ folder (reset.sh and reset.ps1 accept a book only there). The
+    fresh folder is removed at the end; the data/ folder is removed too when THIS call made it and it is empty again,
+    so a test run leaves the repository folder as it found it (the clean-tree guard reports a data/ that appeared)."""
+    data = REPO / "data"
+    made = not data.exists()
+    data.mkdir(exist_ok=True)
+    folder = Path(tempfile.mkdtemp(prefix=prefix, dir=data))  # a fresh folder: only it is removed
+    try:
+        yield folder
+    finally:
+        shutil.rmtree(folder, ignore_errors=True)
+        if made:
+            try:
+                data.rmdir()  # only when empty: anything else in it is left alone
+            except OSError:
+                pass
diff --git a/tests/test_data_folder_helper.py b/tests/test_data_folder_helper.py
new file mode 100644
index 0000000..91e5bb2
--- /dev/null
+++ b/tests/test_data_folder_helper.py
@@ -0,0 +1,173 @@
+"""The shared helper `support.book_folder_in_repo` (one copy, taken from the core fix) leaves the tree as it found
+it, and the test files that use it leave no `data` folder in the repository after a run. Made-up data only."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+import support
+from support import REPO, book_folder_in_repo
+
+AFFECTED = ("tests/test_reset_scripts.py", "tests/test_mode_safety.py")
+
+
+@pytest.fixture
+def fake_repo(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    """The helper reads support.REPO: point it at a scratch folder so the real repository is never touched."""
+    monkeypatch.setattr(support, "REPO", tmp_path)
+    return tmp_path
+
+
+def test_a_data_folder_that_was_absent_is_absent_again(fake_repo: Path) -> None:
+    with book_folder_in_repo("t-") as folder:
+        assert folder.parent == fake_repo / "data" and folder.is_dir()
+    assert not (fake_repo / "data").exists()
+
+
+def test_an_empty_data_folder_that_was_there_is_kept(fake_repo: Path) -> None:
+    (fake_repo / "data").mkdir()
+    with book_folder_in_repo("t-") as folder:
+        assert folder.is_dir()
+    assert (fake_repo / "data").is_dir() and not folder.exists() and list((fake_repo / "data").iterdir()) == []
+
+
+def test_a_data_folder_holding_a_file_is_left_untouched(fake_repo: Path) -> None:
+    data = fake_repo / "data"
+    data.mkdir()
+    (data / "desk.sqlite3").write_text("keep me", encoding="utf-8")
+    with book_folder_in_repo("t-") as folder:
+        assert folder.is_dir()
+    assert not folder.exists()
+    assert [p.name for p in data.iterdir()] == ["desk.sqlite3"]
+    assert (data / "desk.sqlite3").read_text(encoding="utf-8") == "keep me"
+
+
+def test_a_data_folder_made_here_but_filled_by_someone_else_is_kept(fake_repo: Path) -> None:
+    with book_folder_in_repo("t-") as folder:
+        (fake_repo / "data" / "other.txt").write_text("not ours", encoding="utf-8")
+        assert folder.is_dir()
+    assert not folder.exists() and (fake_repo / "data" / "other.txt").read_text(encoding="utf-8") == "not ours"
+
+
+def test_the_folder_is_removed_when_the_test_body_fails(fake_repo: Path) -> None:
+    with pytest.raises(RuntimeError, match="boom"):
+        with book_folder_in_repo("t-") as folder:
+            (folder / "x").write_text("x", encoding="utf-8")
+            raise RuntimeError("boom")
+    assert not (fake_repo / "data").exists()
+
+
+@pytest.mark.xfail(
+    strict=True,
+    reason="the copied core helper follows a data link (core finding, being fixed in core r7f); remove this mark "
+    "when the helper is re-copied from the fixed core",
+)
+@pytest.mark.skipif(sys.platform == "win32", reason="links need rights on Windows")
+def test_a_data_folder_that_is_a_link_is_not_followed(fake_repo: Path) -> None:
+    elsewhere = fake_repo / "elsewhere"
+    elsewhere.mkdir()
+    (fake_repo / "data").symlink_to(elsewhere, target_is_directory=True)
+    try:
+        with book_folder_in_repo("t-") as folder:
+            assert elsewhere.resolve() not in folder.resolve().parents, "a test folder was made behind the link"
+    except (RuntimeError, OSError):
+        pass  # a refusal is fine
+    assert (fake_repo / "data").is_symlink() and list(elsewhere.iterdir()) == []
+
+
+def _copy_repo(dest: Path) -> None:
+    git = shutil.which("git")
+    if git is None:
+        pytest.fail("git is needed to copy the repository for this check, and it was not found on PATH")
+    listed = subprocess.run(  # noqa: S603 (the git found on PATH, our own repository)
+        [git, "ls-files", "-z"], cwd=REPO, capture_output=True, check=False, timeout=30
+    )
+    if listed.returncode != 0 or not listed.stdout:
+        pytest.fail(f"git ls-files failed: rc={listed.returncode} {listed.stderr[-300:]!r}")
+    names = [n for n in listed.stdout.decode("utf-8").split("\0") if n]
+    for name in names:
+        src = REPO / name
+        if src.is_file() and not src.is_symlink():
+            (dest / name).parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(src, dest / name)
+
+
+def test_the_tests_that_use_the_data_folder_leave_none_in_the_repository(tmp_path: Path) -> None:
+    """Runs the affected test files in a copy of the repository: no `data` folder may exist in the copy afterwards."""
+    copy = tmp_path / "copy"
+    copy.mkdir()
+    _copy_repo(copy)
+    assert not (copy / "data").exists(), "the copy must start without a data folder"
+    files = [f for f in AFFECTED if (copy / f).is_file()]
+    assert files, "the affected test files are missing from the copy"
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("PYTEST_", "DESK_"))}
+    env["TMPDIR"] = str(tmp_path / "tmp")
+    (tmp_path / "tmp").mkdir()
+    done = subprocess.run(  # noqa: S603 (this interpreter, our own test files)
+        [sys.executable, "-m", "pytest", "-p", "no:cacheprovider", "-q", "--basetemp", str(tmp_path / "bt"), *files],
+        cwd=copy,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=300,
+        check=False,
+    )
+    assert done.returncode == 0, ("the inner test run failed", done.returncode, done.stdout[-1500:], done.stderr[-500:])
+    assert (copy / "data").exists() is False, ("a data folder is left in the repository", done.stdout[-1500:])
+    assert "passed" in done.stdout, (done.stdout[-1500:], done.stderr[-500:])
+
+
+def _run_in_copy(tmp_path: Path, test_source: str) -> tuple[subprocess.CompletedProcess[str], Path]:
+    """Copy the repository, add one throwaway test file, run only that file in the copy."""
+    copy = tmp_path / "copy"
+    copy.mkdir()
+    _copy_repo(copy)
+    assert not (copy / "data").exists(), "the copy must start without a data folder"
+    (copy / "tests" / "test_throwaway_probe.py").write_text(test_source, encoding="utf-8")
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("PYTEST_", "DESK_"))}
+    env["TMPDIR"] = str(tmp_path / "tmp")
+    (tmp_path / "tmp").mkdir()
+    done = subprocess.run(  # noqa: S603 (this interpreter, a file we just wrote)
+        [
+            sys.executable,
+            "-m",
+            "pytest",
+            "-p",
+            "no:cacheprovider",
+            "-q",
+            "--basetemp",
+            str(tmp_path / "bt"),
+            "tests/test_throwaway_probe.py",
+        ],
+        cwd=copy,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=300,
+        check=False,
+    )
+    return done, copy
+
+
+def test_the_whole_run_fails_when_a_test_leaves_a_data_folder(tmp_path: Path) -> None:
+    """The run-wide check in conftest.py: a passing test that makes `data` and keeps it must still fail the run."""
+    probe = (
+        "from pathlib import Path\n\n"
+        "def test_leaves_data():\n"
+        "    (Path(__file__).resolve().parent.parent / 'data').mkdir()\n"
+    )
+    done, copy = _run_in_copy(tmp_path, probe)
+    assert (copy / "data").is_dir(), "the probe must have made the folder"
+    assert "1 passed" in done.stdout, (done.stdout[-1500:], done.stderr[-500:])
+    assert done.returncode != 0, ("the run passed although a data folder was left", done.stdout[-1500:])
+    assert "left a data folder in the repository" in done.stdout, done.stdout[-1500:]
+
+
+def test_the_whole_run_passes_when_no_data_folder_is_left(tmp_path: Path) -> None:
+    done, copy = _run_in_copy(tmp_path, "def test_clean():\n    assert True\n")
+    assert done.returncode == 0 and not (copy / "data").exists(), (done.stdout[-1500:], done.stderr[-500:])
