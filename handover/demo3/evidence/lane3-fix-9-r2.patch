+# A test run must not leave the git-ignored `data` folder behind in the repository (the desk's default database
+# folder). The state at the start is kept here; at the end a `data` folder absent at the start fails the run.
+_REPO_DATA = Path(__file__).resolve().parent.parent / "data"
+_DATA_EXISTED_AT_START: dict[str, bool] = {}
+
+
 def pytest_sessionstart(session: pytest.Session) -> None:
+    _DATA_EXISTED_AT_START["value"] = _REPO_DATA.exists() or _REPO_DATA.is_symlink()
     if not DEMO_PRESENT and os.environ.get(REQUIRE_DEMO_ENV) == "1":
         pytest.exit(
             f"the demo_only folder is missing but {REQUIRE_DEMO_ENV}=1: refusing to skip most tests", returncode=2
         )
 
 
+def pytest_sessionfinish(session: pytest.Session, exitstatus: int) -> None:
+    if hasattr(session.config, "workerinput") or _DATA_EXISTED_AT_START.get("value", True):
+        return  # a parallel worker (the controller checks), or the folder was already there before the run
+    if _REPO_DATA.exists() or _REPO_DATA.is_symlink():
+        session.config.get_terminal_writer().line(
+            f"FAILED: this run left a data folder in the repository ({_REPO_DATA}); it was not there at the start. "
+            "A test made it and did not remove it.",
+            red=True,
+        )
+        session.exitstatus = pytest.ExitCode.TESTS_FAILED
+
+
 if DEMO_PRESENT:
     from support import Rig, ServerDidNotStop, build_rig, stop_within
 
