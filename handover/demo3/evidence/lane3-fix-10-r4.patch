+def test_a_message_that_names_no_setting_still_hides_the_value_of_a_secret_like_setting(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: Any
+) -> None:
+    """The stand-in message names no setting, yet holds the value of DESK_HUBSPOT_KEY_FILE (a secret-like name):
+    hidden."""
+    _env(tmp_path, monkeypatch)
+    value = str(tmp_path / f"{MARK}-key.txt")
+    monkeypatch.setenv("DESK_HUBSPOT_KEY_FILE", value)
