+# Designed for Windows PowerShell 5.1; NOT run on Windows in this build (no PowerShell here).
+# (Windows PowerShell 5.1 turns the error text of a native program into an error, unless the preference is Continue)
+function Read-DeskSetting([string]$Expression) {
+    $previous = $ErrorActionPreference
+    $ErrorActionPreference = 'Continue'
+    $merged = & python -c "from lead_desk.config_exit import config_or_exit; print($Expression)" 2>&1
+    $code = $LASTEXITCODE
+    $ErrorActionPreference = $previous
+    # the merged output is split: error records are the helper's error stream, everything else is its output (the value)
+    $errorText = ($merged | Where-Object { $_ -is [System.Management.Automation.ErrorRecord] } | ForEach-Object { "$_" }) -join ' '
+    $outText = ($merged | Where-Object { $_ -isnot [System.Management.Automation.ErrorRecord] } | ForEach-Object { "$_" }) -join "`n"
+    if ($code -ne 0) { [Console]::Error.WriteLine($errorText); exit $code }
+    $outText.Trim()
