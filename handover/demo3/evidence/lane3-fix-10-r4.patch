+"""Pin, not proof: a setting value never reaches the desk's output through ANY of its refusal sites.
+
+Bug class: a refusal message that carries what the person typed (a path, an address, a key file name). The desk words
+every refusal through one function (`_refuse` -> `config_exit.refusal_line`). This file runs `server.main` itself, once
+per late refusal site, with the real function behind that site replaced by one that refuses with a message that HOLDS
+the value of the setting it names (the worst case: a message that echoes). The line the person sees must not hold the
+value, must be one line, and the exit code is the desk's own. The sites after the first reading of the settings, in the
+order of `server.main`: the public bind address, the book check, the approvers file, the leadflow file, the adapters,
+building the Desk, and the run-time check of the Desk. Made-up values only; the lock file and the folder are in
+tmp_path.
+
+This file is a PIN, not proof: it plants the refusals with stand-ins for the real functions, so it shows that the
+line a person sees is scrubbed at each site, not that every real message the desk can make is free of values. The
+real messages are checked where they are made (tests/test_bad_setting_entry_points.py and the config tests).
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from lead_desk import config as config_module
+from lead_desk import desk as desk_module
+from lead_desk import server
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED
+from lead_desk.desk import DeskSettingRefused
+from lead_desk.envnum import SettingRefused
+
+SETTING = "DESK_REPLIES_PATH"  # a valid, unread-at-start path setting: its value is the thing that must not appear
+MARK = "zq-marker-9f3k"  # the made-up value, built into a path below
+
+
+class _StubServer:
+    def server_close(self) -> None:
+        return None
+
+
+class _StubDesk:
+    """A Desk that builds, and refuses (as the real one can) when it is started: the run-time site."""
+
+    def __init__(self, *_: Any, **__: Any) -> None:
+        return None
+
+    def start_background(self) -> None:
+        raise DeskSettingRefused(f"{SETTING} holds {self.value}")
+
+    def stop_background(self) -> None:
+        return None
+
+    def reaper_running(self) -> bool:
+        return False
+
+    def close(self) -> None:
+        return None
+
+    value = ""
+
+
+def _env(tmp: Path, monkeypatch: pytest.MonkeyPatch, **extra: str) -> str:
+    value = str(tmp / f"{MARK}.json")
+    for name, text in {
+        "DESK_DB_PATH": str(tmp / "data" / "desk.sqlite3"),
+        "DESK_PORT": "0",
+        SETTING: value,
+        **extra,
+    }.items():
+        monkeypatch.setenv(name, text)
+    return value
+
+
+def _message(value: str) -> str:
+    return f"{SETTING} is wrong: {value}"
+
+
+def _site_bind(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    monkeypatch.setattr(config_module.Config, "public_bind_problem", lambda self: _message(value))
+
+
+def _site_book(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    monkeypatch.setattr(desk_module, "book_problem", lambda path: _message(value))
+
+
+def _site_approvers(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    def refuse(config: Any) -> Any:
+        raise SettingRefused(_message(value))
+
+    monkeypatch.setattr(server, "load_approvers", refuse)
+
+
+def _site_leadflow(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    def refuse(path: Any) -> Any:
+        raise SettingRefused(_message(value))
+
+    monkeypatch.setattr(server, "read_leadflow", refuse)
+
+
+def _site_adapters(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    def refuse(config: Any) -> Any:
+        raise SettingRefused(_message(value))
+
+    monkeypatch.setattr(server, "load_demo_adapters", refuse)
+
+
+def _site_desk_build(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    def refuse(*_: Any, **__: Any) -> Any:
+        raise DeskSettingRefused(_message(value))
+
+    monkeypatch.setattr(server, "load_demo_adapters", lambda config: (object(), object(), object()))
+    monkeypatch.setattr(server, "Desk", refuse)
+
+
+def _site_run_time(monkeypatch: pytest.MonkeyPatch, value: str) -> None:
+    _StubDesk.value = value
+    monkeypatch.setattr(server, "load_demo_adapters", lambda config: (object(), object(), object()))
+    monkeypatch.setattr(server, "Desk", _StubDesk)
+    monkeypatch.setattr(server, "make_server", lambda desk, config: _StubServer())
+    monkeypatch.setattr(server.signal, "signal", lambda *a, **k: None)
+
+
+# (site, how the refusal is planted, the extra settings that make the site reachable)
+SITES: list[tuple[str, Any, dict[str, str]]] = [
+    ("bind", _site_bind, {}),
+    ("book", _site_book, {}),
+    ("approvers", _site_approvers, {"DESK_LATER_MODE": "approval", "DESK_APPROVERS_FILE": "approvers.json"}),
+    ("leadflow", _site_leadflow, {"DESK_LEADFLOW_FILE": "flow.json", "DESK_NUDGE_TO": "n@example.test"}),
+    ("adapters", _site_adapters, {}),
+    ("desk_build", _site_desk_build, {}),
+    ("run_time", _site_run_time, {}),
+]
+
+
+@pytest.mark.parametrize(("site", "plant", "extra"), SITES, ids=[s[0] for s in SITES])
+def test_no_setting_value_reaches_the_output_at_a_late_refusal_site(
+    site: str, plant: Any, extra: dict[str, str], tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: Any
+) -> None:
+    value = _env(tmp_path, monkeypatch, **extra)
+    plant(monkeypatch, value)
+    with pytest.raises(SystemExit) as stop:
+        server.main()
+    assert stop.value.code == EXIT_DESK_SETTING_REFUSED, site
+    out = capsys.readouterr()
+    text = out.out + out.err
+    lines = [ln for ln in text.splitlines() if ln.strip()]
+    assert len(lines) == 1, (site, lines)
+    assert SETTING in lines[0] and "<value>" in lines[0], (site, lines[0])
+    assert MARK not in text and value not in text, site
+
+
