+def _prose_numbers(text: str) -> list[tuple[int, str]]:
+    """Lines (outside the generated table) that name a program of the table and give an exit number other than 0 or
+    137."""
+    hits: list[tuple[int, str]] = []
+    inside = False
+    for number, line in enumerate(text.splitlines(), 1):
+        if render.START in line:
+            inside = True
+        elif render.END in line:
+            inside = False
+        elif not inside and any(word in line for word in _PROGRAM_WORDS):
+            if [n for n in _EXIT_NUMBER.findall(line) if n not in {"0", str(c.EXIT_SIMULATED_KILL)}]:
+                hits.append((number, line[:90]))
+    return hits
+
