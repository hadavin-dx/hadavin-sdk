new file mode 100644
index 0000000000000000000000000000000000000000..acbe787028632d62071a6809291db941fd395267
--- /dev/null
+++ b/tests/test_start_all_late_refusal.py
@@ -0,0 +1,311 @@
+"""scripts/start_all.sh must tell the truth when the desk it just started ends at once.
+
+Bug class: a script starts a background program, prints "started" and exits 0 without looking at it again, so a desk
+that refuses a late setting (a leadflow file, an approvers file, a public bind address, a sender address) or cannot take
+its port is reported as running. The rule: wait (bounded) until the desk says it is listening; if it ends first, print
+ONE line with its last log line and its own exit code, stop what the script started, delete the two process-id files the
+script wrote, and exit with the desk's code when it is one of the three the table passes on (3, 4, 5: the program rows
+of `start_all.sh` in `constants.EXIT_CODE_TABLE`), else with the script's own 1. The demo server is waited for first,
+inside the same budget; if it does not answer, the desk is not started. The wait is injected (START_ALL_WAIT_SECONDS),
+so no test asserts a wall time: the PATH taken (a message that says "the desk ended at once" instead of "not ready after
+N seconds") shows that the script saw the desk end and did not sit out the wait. Made-up data, loopback only, throwaway
+folders under tmp_path; every process a test starts is stopped by that test.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import signal
+import socket
+import subprocess
+import sys
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env, free_port
+
+from lead_desk.constants import (
+    EXIT_DESK_SETTING_REFUSED,
+    EXIT_OPEN_FILE_LIMIT,
+    EXIT_PORT_UNAVAILABLE,
+    EXIT_START_NOT_DONE,
+)
+
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="start_all.sh is the non-Windows script")
+LOOPBACK = "127.0.0.1"
+
+
+WAIT = "3"  # the injected waiting budget (seconds) of the failure tests: short, and never the thing that is measured
+
+
+def _run(
+    tmp: Path, *, first_on_path: Path | None = None, wait: str = WAIT, **settings: str
+) -> subprocess.CompletedProcess[str]:
+    env = child_env(
+        DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), DESK_PORT=str(free_port()), DESK_FAKES_PORT=str(free_port())
+    )
+    env.pop("DESK_NUDGE_TO", None)
+    env["START_ALL_WAIT_SECONDS"] = wait
+    env.update(settings)
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    if first_on_path is not None:
+        env["PATH"] = str(first_on_path) + os.pathsep + env["PATH"]
+    return subprocess.run(  # noqa: S603, S607 - our own script, made-up values, throwaway folder
+        ["bash", str(REPO / "scripts" / "start_all.sh")],  # noqa: S607
+        cwd=REPO,
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=120,
+        stdin=subprocess.DEVNULL,
+        check=False,
+    )
+
+
+def _answers(port: int) -> bool:
+    with contextlib.suppress(OSError), socket.create_connection((LOOPBACK, port), timeout=0.5):
+        return True
+    return False
+
+
+def _stop_started(tmp: Path) -> None:
+    """Whatever a test left running: only the process ids the script itself wrote."""
+    for name in ("desk", "fakes"):
+        pid_file = tmp / "data" / f"{name}.pid"
+        if pid_file.exists():
+            with contextlib.suppress(ValueError, OSError):
+                os.kill(int(pid_file.read_text(encoding="utf-8").strip()), signal.SIGKILL)
+
+
+@pytest.fixture
+def cleanup(tmp_path: Path) -> Iterator[None]:
+    yield
+    _stop_started(tmp_path)
+
+
+def _assert_failed_start(done: subprocess.CompletedProcess[str], tmp: Path, code: int, fakes_port: int) -> None:
+    out = done.stdout + done.stderr
+    assert done.returncode == code, (done.returncode, out[-600:])
+    assert "started:" not in out and "Traceback" not in out, out[-600:]
+    lines = [ln for ln in done.stderr.splitlines() if ln.strip()]
+    assert len(lines) == 1 and lines[0].startswith("the desk ended at once (exit "), lines
+    assert f"(exit {code})" in lines[0] and len(lines[0]) < 400
+    assert not (tmp / "data" / "desk.pid").exists() and not (tmp / "data" / "fakes.pid").exists()  # its own, removed
+    assert not _answers(fakes_port), "the demo server the script started is still running"
+
+
+LATE_REFUSALS: list[tuple[str, dict[str, str]]] = [
+    ("leadflow_file_missing", {"DESK_LEADFLOW_FILE": "no-such-file.json"}),
+    ("approvers_file_missing", {"DESK_LATER_MODE": "approval", "DESK_APPROVERS_FILE": "no-such-approvers.json"}),
+    # the all-zeros address: its refusal is what is tested
+    ("public_bind", {"DESK_BIND": ".".join(["0"] * 4), "DESK_CRM": "hubspot"}),
+    ("sender_address", {"DESK_OUTBOX": "smtp", "DESK_SMTP_HOST": "127.0.0.1", "DESK_SMTP_FROM": "no-at-sign"}),
+]
+
+
+@pytest.mark.parametrize(("label", "settings"), LATE_REFUSALS, ids=[n for n, _ in LATE_REFUSALS])
+def test_a_desk_that_refuses_a_late_setting_is_reported_not_started(
+    label: str, settings: dict[str, str], tmp_path: Path, cleanup: None
+) -> None:
+    fakes_port = free_port()
+    done = _run(tmp_path, DESK_FAKES_PORT=str(fakes_port), **settings)
+    _assert_failed_start(done, tmp_path, EXIT_DESK_SETTING_REFUSED, fakes_port)
+    assert "refuses" in done.stderr, label  # the desk's own last line, so the reason is visible
+
+
+def test_a_desk_that_cannot_take_its_port_is_reported_with_its_own_code(tmp_path: Path, cleanup: None) -> None:
+    fakes_port = free_port()
+    with socket.socket() as taken:
+        taken.bind((LOOPBACK, 0))
+        taken.listen()
+        done = _run(tmp_path, wait="60", DESK_PORT=str(taken.getsockname()[1]), DESK_FAKES_PORT=str(fakes_port))
+    _assert_failed_start(done, tmp_path, EXIT_PORT_UNAVAILABLE, fakes_port)
+    assert "cannot bind" in done.stderr
+
+
+def test_a_desk_that_listens_is_started(tmp_path: Path, cleanup: None) -> None:
+    done = _run(tmp_path)
+    assert done.returncode == 0 and "started:" in done.stdout, (done.stdout, done.stderr)
+    assert (tmp_path / "data" / "desk.pid").exists() and (tmp_path / "data" / "fakes.pid").exists()
+
+
+def _stub_python(tmp: Path, desk_body: str, fakes_body: str = "") -> Path:
+    """A stand-in `python` first on PATH: `-m lead_desk.server` runs `desk_body`, `-m demo_only.fakes_server` runs
+    `fakes_body` when it is not empty; everything else is the real interpreter."""
+    stub_dir = tmp / "stub"
+    stub_dir.mkdir(exist_ok=True)
+    stub = stub_dir / "python"
+    fakes = f'if [[ "$*" == *demo_only.fakes_server* ]]; then {fakes_body}; fi\n' if fakes_body else ""
+    stub.write_text(
+        f'#!/bin/bash\n{fakes}if [[ "$*" == *lead_desk.server* ]]; then {desk_body}; fi\nexec {sys.executable} "$@"\n',
+        encoding="utf-8",
+    )
+    stub.chmod(0o755)
+    return stub_dir
+
+
+def test_a_desk_that_never_listens_is_reported_after_the_wait_and_left_for_reset(tmp_path: Path, cleanup: None) -> None:
+    """The honest timeout path: a stand-in `python` makes the desk sleep without a word. After the injected wait the
+    script says so (and that the desk may still be starting), exits 1 and leaves the processes alone for reset.sh
+    (they are stopped by this test)."""
+    done = _run(tmp_path, first_on_path=_stub_python(tmp_path, "exec sleep 120"), wait="2")
+    assert done.returncode == EXIT_START_NOT_DONE, (done.stdout, done.stderr)
+    assert "desk not ready after 2 seconds" in done.stderr, (done.stdout, done.stderr)
+    assert "may still be starting" in done.stderr and "started:" not in done.stdout
+    assert (tmp_path / "data" / "desk.pid").exists()  # left for reset.sh
+
+
+@pytest.mark.parametrize(
+    ("fakes_body", "said"),
+    [("exec sleep 120", "the demo server did not answer in 2 seconds"), ("exit 3", "the demo server stopped at once")],
+    ids=["silent", "ends_at_once"],
+)
+def test_a_demo_server_that_does_not_come_up_stops_the_start_before_the_desk(
+    fakes_body: str, said: str, tmp_path: Path, cleanup: None
+) -> None:
+    """The desk asks the demo server once and ends if nobody answers: a slow demo server is a different failure from a
+    bad setting, so the script waits for it first, says so, and never starts the desk."""
+    marker = tmp_path / "desk-was-started"
+    stub = _stub_python(tmp_path, f"touch {marker}; exec sleep 120", fakes_body)
+    done = _run(tmp_path, first_on_path=stub, wait="2")
+    assert done.returncode == EXIT_START_NOT_DONE, (done.stdout, done.stderr)
+    assert said in done.stderr and "the desk was not started" in done.stderr
+    assert "desk" not in done.stderr.replace("the desk was not started", "")
+    assert "started:" not in done.stdout and not marker.exists()
+    assert not (tmp_path / "data" / "desk.pid").exists() and not (tmp_path / "data" / "fakes.pid").exists()
+
+
+@pytest.mark.parametrize(
+    ("desk_code", "expected"),
+    [
+        (0, EXIT_START_NOT_DONE),  # a desk that stopped with 0 is not a start
+        (1, EXIT_START_NOT_DONE),
+        (2, EXIT_START_NOT_DONE),  # the desk's "another desk" is the script's own 1, so 2 means only "not bash"
+        (6, EXIT_START_NOT_DONE),
+        (137, EXIT_START_NOT_DONE),
+        (EXIT_OPEN_FILE_LIMIT, EXIT_OPEN_FILE_LIMIT),
+        (EXIT_DESK_SETTING_REFUSED, EXIT_DESK_SETTING_REFUSED),
+        (EXIT_PORT_UNAVAILABLE, EXIT_PORT_UNAVAILABLE),
+    ],
+)
+def test_only_the_three_desk_codes_of_the_table_are_passed_on(
+    desk_code: int, expected: int, tmp_path: Path, cleanup: None
+) -> None:
+    stub = _stub_python(tmp_path, f"echo 'a line'; exit {desk_code}")
+    done = _run(tmp_path, first_on_path=stub)
+    assert done.returncode == expected, (desk_code, done.stdout, done.stderr)
+    assert f"(exit {desk_code})" in done.stderr and "started:" not in done.stdout
+
+
+def test_the_last_log_line_goes_through_the_one_formatter(tmp_path: Path, cleanup: None) -> None:
+    """Control characters are removed and the value of a setting the line names is not shown."""
+    secret = str(tmp_path / "secret-replies-qq9.json")
+    body = (
+        "printf 'the desk refuses a setting: DESK_REPLIES_PATH holds %s \\033[2J\\007bell\\n' "
+        '"$DESK_REPLIES_PATH"; exit 4'
+    )
+    done = _run(tmp_path, first_on_path=_stub_python(tmp_path, body), DESK_REPLIES_PATH=secret)
+    assert done.returncode == EXIT_DESK_SETTING_REFUSED, (done.stdout, done.stderr)
+    assert "secret-replies-qq9" not in done.stderr and "<value>" in done.stderr and "DESK_REPLIES_PATH" in done.stderr
+    assert "\x1b" not in done.stderr and "\x07" not in done.stderr and "bell" in done.stderr
+    assert len([ln for ln in done.stderr.splitlines() if ln.strip()]) == 1
+
+
+def test_a_bad_wait_setting_is_refused_before_anything_is_started(tmp_path: Path, cleanup: None) -> None:
+    for bad in ("0", "abc", "-1", "015", "1000", "1.5", " 5"):
+        done = _run(tmp_path, wait=bad)
+        assert done.returncode == EXIT_START_NOT_DONE and "START_ALL_WAIT_SECONDS" in done.stderr, bad
+        assert not (tmp_path / "data" / "fakes.pid").exists(), bad
+
+
+def test_text_pin_the_start_script_waits_for_the_listening_line_inside_one_budget() -> None:
+    """TEXT PIN, not a proof of behaviour: it only shows the lines are in the file. The behaviour tests above (a desk
+    that never listens, a demo server that does not come up, a desk that ends at once) are the proof."""
+    text = (REPO / "scripts" / "start_all.sh").read_text(encoding="utf-8")
+    assert 'WAIT_SECONDS="${START_ALL_WAIT_SECONDS:-15}"' in text and "desk listening on" in text
+    assert 'wait "$desk_pid"' in text and text.count("max_ticks") >= 3  # one counter for both waits
+    assert text.count("seq 1 ") == 0 and "the demo server did not answer in" in text
+
+
+def test_an_empty_desk_log_still_gives_a_readable_line(tmp_path: Path, cleanup: None) -> None:
+    """A desk that ends without a word: the line must not end in an empty tail ("(exit 1): ")."""
+    done = _run(tmp_path, first_on_path=_stub_python(tmp_path, "exit 1"))
+    assert done.returncode == EXIT_START_NOT_DONE, (done.stdout, done.stderr)
+    line = [ln for ln in done.stderr.splitlines() if ln.strip()][-1]
+    assert line.startswith("the desk ended at once (exit 1): ") and line.endswith("(the log line could not be read)")
+
+
+def test_a_foreign_listener_on_the_demo_server_port_is_not_a_started_demo_server(tmp_path: Path, cleanup: None) -> None:
+    """Bug class: "something answers on the port" taken as "our demo server is up". The demo server dies on the taken
+    port; the script must say so, print no "started", leave no pid file and stop the desk it may have started."""
+    with socket.socket() as taken:
+        taken.bind((LOOPBACK, 0))
+        taken.listen()
+        fakes_port = taken.getsockname()[1]
+        done = _run(tmp_path, wait="6", DESK_FAKES_PORT=str(fakes_port))
+    out = done.stdout + done.stderr
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert "started:" not in out and "the demo server stopped" in done.stderr, out[-500:]
+    assert not (tmp_path / "data" / "fakes.pid").exists() and not (tmp_path / "data" / "desk.pid").exists()
+
+
+def test_a_foreign_listener_with_a_demo_server_that_dies_a_moment_later_is_still_not_a_start(
+    tmp_path: Path, cleanup: None
+) -> None:
+    """The port answers at once (a foreign program) while our demo server process is still alive for a second. For that
+    second the two look like a working demo server, so the desk may be started; the later checks must still stop it:
+    exit 1, no "started", no pid file left. (Not claimed: that the desk is never started in that second.)"""
+    with socket.socket() as taken:
+        taken.bind((LOOPBACK, 0))
+        taken.listen()
+        fakes_port = taken.getsockname()[1]
+        stub = _stub_python(tmp_path, "exec sleep 120", "sleep 1; exit 3")
+        done = _run(tmp_path, first_on_path=stub, wait="6", DESK_FAKES_PORT=str(fakes_port))
+    out = done.stdout + done.stderr
+    assert done.returncode == EXIT_START_NOT_DONE, (done.returncode, out[-500:])
+    assert "the demo server stopped at once; the desk was" in done.stderr and "started:" not in out, out[-500:]
+    assert not (tmp_path / "data" / "fakes.pid").exists() and not (tmp_path / "data" / "desk.pid").exists()
+
+
+@pytest.mark.parametrize("fakes_body", ["exec sleep 120", "exit 3"], ids=["silent", "ends_at_once"])
+def test_a_failure_line_shows_no_folder_and_no_port(fakes_body: str, tmp_path: Path, cleanup: None) -> None:
+    """The failure lines name the log file (fakes.log, desk.log) but never the data folder or the port: both come
+    from settings (DESK_DB_PATH, DESK_FAKES_PORT)."""
+    fakes_port = free_port()
+    stub = _stub_python(tmp_path, "exec sleep 120", fakes_body)
+    done = _run(tmp_path, first_on_path=stub, wait="2", DESK_FAKES_PORT=str(fakes_port))
+    assert done.returncode == EXIT_START_NOT_DONE and "fakes.log" in done.stderr, (done.stdout, done.stderr)
+    assert str(tmp_path) not in done.stderr and str(fakes_port) not in done.stderr, done.stderr
+    desk = _run(tmp_path, first_on_path=_stub_python(tmp_path, "exec sleep 120"), wait="2")
+    assert "desk.log" in desk.stderr and str(tmp_path) not in desk.stderr, desk.stderr
+
+
+def _ipv6_loopback() -> bool:
+    try:
+        with socket.socket(socket.AF_INET6) as probe:
+            probe.bind(("::1", 0))
+        return True
+    except OSError:
+        return False
+
+
+@pytest.mark.skipif(not _ipv6_loopback(), reason="this computer has no IPv6 loopback address")
+def test_a_demo_server_on_an_ipv6_loopback_address_is_waited_for(tmp_path: Path, cleanup: None) -> None:
+    """The settings keep the brackets of `http://[::1]:PORT`; the wait must strip them before it connects."""
+    port = free_port()
+    listener = (
+        f"exec {sys.executable} -c 'import socket,time; s=socket.socket(socket.AF_INET6); "
+        f's.bind(("::1",{port})); s.listen(); time.sleep(60)\''
+    )
+    stub = _stub_python(tmp_path, "echo desk listening on x; exec sleep 60", listener)
+    done = _run(tmp_path, first_on_path=stub, wait="6", DESK_FAKES_URL=f"http://[::1]:{port}")
+    assert done.returncode == 0 and "started:" in done.stdout, (done.stdout, done.stderr)
+
+
+def test_text_pin_both_start_scripts_strip_the_brackets_of_an_ipv6_host() -> None:
+    """TEXT PIN (the .ps1 cannot run here): the line that removes the brackets is present in both scripts."""
