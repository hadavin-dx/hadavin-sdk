+HOSTILE: dict[str, str] = {
+    "empty": "",
+    "whitespace": "  \t ",
+    "long": "x" * 100_000,
+    "nul": "a\0b",
+    "control": "a\x07b\nc",
+    "non_ascii": "café\u202e",
+    "lone_surrogate": "a\udc80b",
+    "two_at": "a@b@c.test",
