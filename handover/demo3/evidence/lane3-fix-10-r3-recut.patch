index b414024..ba6c1fc 100644
--- a/tests/test_path_confinement.py
+++ b/tests/test_path_confinement.py
@@ -563,7 +563,7 @@ def test_run_real_check_reads_a_config_outside_the_allowed_folders(
     (outside / "run.env").write_text("REAL_PERSONS=3\n", encoding="utf-8")
     mod = _rrc(monkeypatch)
     monkeypatch.setattr("builtins.input", lambda prompt="": "n")
-    assert mod.main(["--config", str(outside / "run.env")]) == mod.EXIT_REFUSED
