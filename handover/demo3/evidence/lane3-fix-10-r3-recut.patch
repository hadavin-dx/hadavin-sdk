+def env_path(env: Mapping[str, str], name: str, default: Any = _MISSING) -> Path:
+    """A path read from setting text: THE one way (every `Path(env[...])` in src/ and scripts/ goes through here; a test
+    walks the syntax tree and fails on a bare one). Text that cannot be written as UTF-8 (a lone surrogate: what the
+    operating system's own decoding makes of a byte that is not UTF-8) or that holds a NUL character is a plain
+    SettingRefused naming the setting. A log line, a stored row or a printed path could not hold it. `default` is
+    returned as it is when the name is absent (a Path, or None)."""
+    if name not in env:
+        if default is _MISSING:
+            raise SettingRefused(f"{name} is required")
+        return default  # type: ignore[no-any-return]
+    value = env[name]
+    try:
+        value.encode("utf-8")
+    except UnicodeEncodeError:
+        raise SettingRefused(f"{name} is not a valid path") from None
+    if "\0" in value:
+        raise SettingRefused(f"{name} is not a valid path")
+    return Path(value)
