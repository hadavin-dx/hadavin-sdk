@@ -0,0 +1,536 @@
+"""A bad DESK_* value must end every start-up script cleanly, never with a Python traceback.
+
+Bug class: a bad setting value (a person's typing mistake) reaches the person as a raw Python error, because the
+script read the settings by itself, outside the one place that turns a refused setting into a plain message.
+The rule for every entry point that reads the DESK_* settings: ONE line that names the setting, no traceback, and the
+value is never repeated (it may be an e-mail address). The code is the desk's own 4 for `python -m lead_desk.server`
+(and the launcher that calls it) and the script reader's 8 (`EXIT_SCRIPT_SETTING_REFUSED`) for every script; the table
+is `constants.EXIT_CODE_TABLE`. Made-up values only; loopback only; no network is reached because every run stops at the
+check.
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk.config import Config
+from lead_desk.config_exit import config_or_exit
+from lead_desk.constants import EXIT_DESK_SETTING_REFUSED, EXIT_SCRIPT_SETTING_REFUSED
+from lead_desk.envnum import SettingRefused
+
+SCRIPTS = REPO / "scripts"
+WINDOWS = sys.platform == "win32"
+FLOW = "demo_only/leadflow.json"  # reminders on, so DESK_NUDGE_TO is read as an address
+
+PY_ENTRY_POINTS: list[tuple[str, list[str]]] = [
+    ("crash_desk", [str(SCRIPTS / "crash_desk.py")]),
+    ("feed", [str(SCRIPTS / "feed.py"), "--source", "form", "--all"]),
+    ("reset_check", [str(SCRIPTS / "reset_check.py")]),
+    ("server", ["-m", "lead_desk.server"]),
+    ("crash_launcher", [str(REPO / "tests" / "crash_launcher.py"), "unused.flag"]),
+]
+DESK_OWN = {"server", "crash_launcher"}  # the desk's own refusal (exit 4); every script exits 8
+SH_ENTRY_POINTS = ["start_all.sh", "reset.sh"]
+
+# (setting name, value that no desk may accept). A NUL character cannot be put in an environment by the operating
+# system; it is tried in-process below.
+BAD_VALUES: list[tuple[str, str]] = [
+    # only values the base tree already refuses: the address rule itself (a second @, a length cap, a control
+    # character) is the one shared rule of identity.py and is tested where that rule lives, not copied here
+    ("DESK_NUDGE_TO", " "),  # whitespace only
+    ("DESK_NUDGE_TO", "café@b.test"),  # not ASCII
+    ("DESK_NUDGE_TO", "no-at-sign"),
+    ("DESK_PORT", ""),  # empty
+    ("DESK_PORT", "   "),
+    ("DESK_PORT", "9" * 5000),
+    ("DESK_PORT", "8\x077"),
+    ("DESK_PORT", "٣٤"),  # digits of another script
+    ("DESK_PORT", "abc@b@c.test"),  # address-like text in a number setting
+    ("DESK_FAKES_URL", "ftp://a@b@c.test:1"),
+    ("DESK_SEND_TIMEOUT_SECONDS", "nan"),
+]
