+++ b/tests/test_exit_code_table.py
@@ -0,0 +1,190 @@
+"""The one table of exit codes (`constants.EXIT_CODE_TABLE`, keyed by PROGRAM) must say what the programs do.
+
+Checked here: inside one program a code has one meaning; the numbers that mean different things in different programs
+are exactly the pinned list `SAME_NUMBER_DIFFERENT_MEANING` (computed from the table and compared); every `EXIT_*`
+constant is in the table; the code a program really returns is one of its rows (programs are run, not read); the codes
+the shell and PowerShell scripts write as plain numbers are rows of that script; 8 (a setting refused while a script
+read it) is never written as a bare number. Codes are compared by constant NAME, never by a bare integer. contract.md
+names the table. The test that runs each program with a bad setting and compares with the by-program table is in
+tests/test_bad_setting_entry_points.py.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import pytest
+from support import REPO, child_env
+
+from lead_desk import constants as c
+
+TABLE = c.EXIT_CODE_TABLE
+PROGRAMS = {program for program, _, _ in TABLE}
+SHELL_SCRIPTS = ("reset.sh", "reset.ps1", "start_all.sh", "start_all.ps1")
+
+
+def _rows(program: str) -> dict[int, str]:
+    return {code: meaning for p, code, meaning in TABLE if p == program}
+
+
+def _overlap(table: tuple[tuple[str, int, str], ...] = TABLE) -> set[int]:
+    meanings: dict[int, set[str]] = defaultdict(set)
+    for _, code, meaning in table:
+        meanings[code].add(meaning)
+    return {code for code, texts in meanings.items() if len(texts) > 1}
+
+
+def test_no_program_has_a_code_with_two_meanings() -> None:
+    seen: dict[tuple[str, int], str] = {}
+    for program, code, meaning in TABLE:
+        assert (program, code) not in seen, (program, code, meaning, seen[(program, code)])
+        seen[(program, code)] = meaning
+    assert all(meaning.strip() for _, _, meaning in TABLE)
+
+
+def test_every_program_of_the_table_exists() -> None:
+    for program in PROGRAMS - {"server"}:
+        name = program if "." in program else f"{program}.py"
+        assert (REPO / "scripts" / name).exists(), program
+    assert set(SHELL_SCRIPTS) <= PROGRAMS
+
+
+def test_the_pinned_overlap_list_is_the_computed_overlap() -> None:
+    assert set(c.SAME_NUMBER_DIFFERENT_MEANING) == _overlap()
+    assert list(c.SAME_NUMBER_DIFFERENT_MEANING) == sorted(c.SAME_NUMBER_DIFFERENT_MEANING)
+
+
+def test_a_second_meaning_behind_a_free_number_is_seen_by_the_computation() -> None:
+    """The check itself: it is not vacuous (it finds an overlap that is not pinned)."""
+    extra = (*TABLE, ("feed", c.EXIT_SIMULATED_KILL, "something else entirely"))
+    assert c.EXIT_SIMULATED_KILL in _overlap(extra) - set(c.SAME_NUMBER_DIFFERENT_MEANING)
+
+
+def test_the_script_setting_code_has_one_meaning_everywhere() -> None:
+    assert c.EXIT_SCRIPT_SETTING_REFUSED not in _overlap()
+    others = {
+        c.EXIT_ADAPTERS_UNREACHABLE,
+        c.EXIT_ANOTHER_DESK,
+        c.EXIT_OPEN_FILE_LIMIT,
+        c.EXIT_DESK_SETTING_REFUSED,
+        c.EXIT_PORT_UNAVAILABLE,
+        c.EXIT_RESET_REFUSED,
+        c.EXIT_RESET_HELD,
+        c.EXIT_RESET_ANSWERING,
+        c.EXIT_RESET_NOT_STOPPED,
+        c.EXIT_RESET_WRONG_PROGRAM,
+        c.EXIT_CHECK_STOPPED,
+        c.EXIT_CHECK_REFUSED,
+        c.EXIT_CHECK_FAILED,
+    }
+    assert c.EXIT_SCRIPT_SETTING_REFUSED not in others
+
+
+def test_every_exit_constant_is_in_the_table() -> None:
+    codes = {code for _, code, _ in TABLE}
+    named = {v for k, v in vars(c).items() if k.startswith("EXIT_") and isinstance(v, int) and k != "EXIT_OK"}
+    assert named <= codes, named - codes
+
+
+def test_the_by_program_tables_name_only_programs_and_codes_of_the_table() -> None:
+    for by_program in (c.SETTING_REFUSED_EXIT_BY_PROGRAM, c.LATE_SETTING_REFUSED_EXIT_BY_PROGRAM):
+        for program, code in by_program.items():
+            assert program in PROGRAMS and code in _rows(program), (program, code)
+    assert set(c.SETTING_REFUSED_EXIT_BY_PROGRAM.values()) == {
+        c.EXIT_DESK_SETTING_REFUSED,
+        c.EXIT_SCRIPT_SETTING_REFUSED,
+    }
+    assert c.SETTING_REFUSED_EXIT_BY_PROGRAM["run_real_check"] == c.EXIT_SCRIPT_SETTING_REFUSED
+    assert c.LATE_SETTING_REFUSED_EXIT_BY_PROGRAM["crash_desk"] == c.EXIT_DESK_SETTING_REFUSED
+
+
+def test_start_all_passes_on_exactly_the_three_desk_codes_it_can_explain() -> None:
+    desk = _rows("server")
+    for program in ("start_all.sh", "start_all.ps1"):
+        rows = _rows(program)
+        for code in (c.EXIT_OPEN_FILE_LIMIT, c.EXIT_DESK_SETTING_REFUSED, c.EXIT_PORT_UNAVAILABLE):
+            assert rows[code] == desk[code], (program, code)  # the same meaning, not a new one
+        assert rows[c.EXIT_START_NOT_DONE] == c.MEANING_START_NOT_DONE
+        assert c.EXIT_ANOTHER_DESK not in rows or program == "start_all.sh"  # 2 is only "not bash", only in the .sh
+
+
+def test_the_numbers_each_shell_script_writes_are_rows_of_that_script() -> None:
+    for name in SHELL_SCRIPTS:
+        text = (REPO / "scripts" / name).read_text(encoding="utf-8")
+        code_lines = "\n".join(ln for ln in text.splitlines() if not ln.lstrip().startswith("#"))
+        used = {int(n) for n in re.findall(r"\bexit ([0-9]+)\b", code_lines)} - {0}
+        assert used <= set(_rows(name)), (name, used - set(_rows(name)))
+        assert c.EXIT_SCRIPT_SETTING_REFUSED not in used, name  # 8 comes only from the reader, passed on
+
+
+def test_the_numbers_reset_check_returns_are_rows_of_reset_check() -> None:
+    text = (REPO / "scripts" / "reset_check.py").read_text(encoding="utf-8")
+    names = set(re.findall(r"return (EXIT_[A-Z_]+)", text))
+    assert names and not re.search(r"return [1-9]", text)  # by name, never a bare number
+    assert {getattr(c, n) for n in names} <= set(_rows("reset_check"))
+
+
+def test_the_two_reset_scripts_have_one_list_of_codes() -> None:
+    assert _rows("reset.sh") == _rows("reset.ps1")
+
+
+def test_no_script_uses_the_script_setting_code_as_a_bare_number() -> None:
+    for path in (REPO / "scripts").iterdir():
+        if path.suffix in {".sh", ".ps1", ".py"}:
+            pattern = rf"\b(?:exit|return|SystemExit\()\s*{c.EXIT_SCRIPT_SETTING_REFUSED}\b"
+            assert not re.search(pattern, path.read_text("utf-8")), path.name
+
+
+def _run(argv: list[str], tmp: Path, **extra: str) -> subprocess.CompletedProcess[str]:
+    env = child_env(DESK_DB_PATH=str(tmp / "data" / "desk.sqlite3"), **extra)
+    env["PATH"] = str(Path(sys.executable).parent) + os.pathsep + env.get("PATH", "")
+    return subprocess.run(  # noqa: S603 - fixed argv, made-up values
+        argv, cwd=REPO, env=env, capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL, check=False
+    )
+
+
+def test_every_code_a_program_really_returns_is_one_of_its_rows(tmp_path: Path) -> None:
+    """The programs are RUN (each with a refusal it can really make); the code is looked up in that program's rows."""
+    py = sys.executable
+    scripts = REPO / "scripts"
+    runs: list[tuple[str, subprocess.CompletedProcess[str]]] = [
+        ("server", _run([py, "-m", "lead_desk.server"], tmp_path, DESK_PORT="abc")),
+        ("crash_desk", _run([py, str(scripts / "crash_desk.py")], tmp_path, DESK_PORT="abc")),
+        ("feed", _run([py, str(scripts / "feed.py"), "--source", "form", "--all"], tmp_path, DESK_PORT="abc")),
+        ("reset_check", _run([py, str(scripts / "reset_check.py")], tmp_path, DESK_PORT="abc")),
+        ("run_real_check", _run([py, str(scripts / "run_real_check.py")], tmp_path)),  # no --config: its own refusal
+    ]
+    if sys.platform != "win32":
+        bash = ["bash"]
+        runs += [
+            ("reset.sh", _run([*bash, str(scripts / "reset.sh")], tmp_path, DESK_PORT="abc")),
+            ("reset.sh", _run([*bash, str(scripts / "reset.sh")], tmp_path, RESET_STOP_WAIT_SECONDS="x")),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh")], tmp_path, DESK_PORT="abc")),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh"), "sideways"], tmp_path)),
+            ("start_all.sh", _run([*bash, str(scripts / "start_all.sh")], tmp_path, START_ALL_WAIT_SECONDS="0")),
+        ]
+    for program, done in runs:
+        assert done.returncode in _rows(program), (program, done.returncode, (done.stdout + done.stderr)[-300:])
+    assert runs[0][1].returncode == c.EXIT_DESK_SETTING_REFUSED
+    assert runs[4][1].returncode == c.EXIT_CHECK_REFUSED
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="the shell scripts are the non-Windows ones")
+def test_start_all_sh_in_a_shell_that_is_not_bash_returns_its_own_not_bash_code(tmp_path: Path) -> None:
+    sh = shutil.which("sh")
+    probe = [sh, "-c", "[[ a == a ]]"] if sh else None
+    if probe is None or subprocess.run(probe, capture_output=True, check=False).returncode == 0:  # noqa: S603
+        pytest.skip("sh on this machine runs [[ ]] (it is bash): the refusal cannot be reached")
+    done = _run([sh, str(REPO / "scripts" / "start_all.sh")], tmp_path)
+    assert done.returncode == c.EXIT_NOT_BASH
+
+
+def test_contract_md_names_the_table_and_the_overlap_list() -> None:
+    text = (REPO / "contract.md").read_text(encoding="utf-8")
+    assert "EXIT_CODE_TABLE" in text and "SAME_NUMBER_DIFFERENT_MEANING" in text and "exit 8" in text
