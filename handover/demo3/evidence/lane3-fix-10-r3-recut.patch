+    code = rrc.main(["--config", str(_real_config(tmp_path, DESK_NUDGE_TO="no-at-sign"))])
+    out = capsys.readouterr().out
+    assert code == EXIT_SCRIPT_SETTING_REFUSED and out.startswith("refused: DESK_NUDGE_TO"), out
+    assert "no-at-sign" not in out and "Start?" not in out
+    assert "SettingRefused" not in out and "ValueError" not in out  # no class name in a refused line
+    assert len([ln for ln in out.splitlines() if ln.strip()]) == 1
+
+
+def test_run_real_check_has_no_scrubber_of_its_own() -> None:
+    """One formatter: the script words its refusal with `config_exit.refusal_line` and keeps no second scrub()."""
+    text = (SCRIPTS / "run_real_check.py").read_text(encoding="utf-8")
+    assert "def scrub(" not in text and "refusal_line(" in text
+    assert not hasattr(_rrc(), "scrub")
+
+
+def test_run_real_check_keeps_code_2_for_the_command_line_and_uses_8_for_every_setting(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    rrc = _rrc()
+    assert rrc.main([]) == rrc.EXIT_REFUSED and capsys.readouterr().out.startswith("refused: give --config")
+    config = _real_config(tmp_path)
+    (tmp_path / "run").mkdir()
+    (tmp_path / "run" / "desk.db").write_text("x", encoding="utf-8")  # an old book: DESK_DB_PATH is refused
+    assert rrc.main(["--config", str(config)]) == EXIT_SCRIPT_SETTING_REFUSED
+    assert "refused: DESK_DB_PATH names a file that already exists" in capsys.readouterr().out
+
+
+@pytest.mark.skipif(WINDOWS, reason="a lone surrogate in a file read as text is a POSIX case in this test")
+@pytest.mark.parametrize(
+    "name", ["REAL_RESULT_FILE", "DESK_HUBSPOT_STATS_FILE", "DESK_SMTPP_STATS_FILE", "DESK_SMTPP_CA_FILE"]
+)
+def test_run_real_check_refuses_a_path_that_is_not_valid_text_before_anything_is_called(
+    name: str, tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    rrc = _rrc()
+    monkeypatch.setattr("builtins.input", lambda *_: pytest.fail("the Start question must not be reached"))
+    config = _real_config(tmp_path)
+    monkeypatch.setattr(rrc, "load_env", lambda path: {**_values_of(config), name: SURROGATE})
+    assert rrc.main(["--config", str(config)]) == EXIT_SCRIPT_SETTING_REFUSED
+    out = capsys.readouterr().out
+    assert out.startswith(f"refused: {name} is not a valid path") and "\udc80" not in out
+
+
+def _values_of(config: Path) -> dict[str, str]:
+    return dict(line.split("=", 1) for line in config.read_text(encoding="utf-8").splitlines())
+
+
+def test_the_by_program_table_matches_what_every_program_returns(tmp_path: Path) -> None:
+    """`constants.SETTING_REFUSED_EXIT_BY_PROGRAM` pinned against real runs of the programs that can run here."""
+    from lead_desk.constants import SETTING_REFUSED_EXIT_BY_PROGRAM as table
+
+    (tmp_path / "real").mkdir()
+    real = _real_config(tmp_path / "real", DESK_NUDGE_TO="no-at-sign")
+    runs = {
+        "server": _run(["-m", "lead_desk.server"], tmp_path, "DESK_PORT", "abc"),
+        "crash_desk": _run([str(SCRIPTS / "crash_desk.py")], tmp_path, "DESK_PORT", "abc"),
+        "feed": _run([str(SCRIPTS / "feed.py"), "--source", "form", "--all"], tmp_path, "DESK_PORT", "abc"),
+        "reset_check": _run([str(SCRIPTS / "reset_check.py")], tmp_path, "DESK_PORT", "abc"),
+        "run_real_check": _run([str(SCRIPTS / "run_real_check.py"), "--config", str(real)], tmp_path, "DESK_PORT", "0"),
+    }
+    if not WINDOWS:
+        for sh in ("reset.sh", "start_all.sh"):
+            runs[sh] = _run([sh], tmp_path, "DESK_PORT", "abc", with_bash=True)
+    for program, done in runs.items():
+        assert done.returncode == table[program], (program, done.returncode, table[program])
+    assert set(table) - set(runs) == {"reset.ps1", "start_all.ps1"}  # never run here: tests/test_ps1_pins.py
+
+
+def test_crash_desk_gives_the_desks_own_code_for_a_late_refusal(tmp_path: Path) -> None:
+    """crash_desk reads the settings itself (8), then runs the desk's own main: a late refusal there is the desk's 4."""
+    from lead_desk.constants import LATE_SETTING_REFUSED_EXIT_BY_PROGRAM as late
+
+    done = _run([str(SCRIPTS / "crash_desk.py")], tmp_path, "DESK_LEADFLOW_FILE", "no-such-flow.json")
+    assert done.returncode == late["crash_desk"] == EXIT_DESK_SETTING_REFUSED, (done.stdout, done.stderr)
+    lines = [ln for ln in (done.stdout + done.stderr).splitlines() if ln.strip()]
+    assert lines[-1].startswith("the desk refuses a setting: ") and "Traceback" not in done.stdout + done.stderr
+    assert "no-such-flow" not in done.stdout + done.stderr
