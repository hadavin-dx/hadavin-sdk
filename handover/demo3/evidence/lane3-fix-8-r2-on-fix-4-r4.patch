     return not any(not c.isascii() and any(x.isascii() for x in c.lower()) for c in e)
 
 
+def domain_labels_ok(domain: str) -> bool:
+    """True when every label of the domain (the parts between dots) has at least one character and neither starts nor
+    ends with a hyphen (or one of the look-alikes of the hyphen). So a domain that starts with a dot, ends with a dot or
+    has two dots in a row, and a label such as "-a" or "a-", is not a mailbox domain (RFC 1035 section 2.3.1, RFC 5321
+    section 4.1.2). A domain that has one of the three non-ASCII dots needs a real ASCII dot as well; those three dots
+    only split labels. This is the one place that rule lives: the lead email check and the plain-address check of the
+    sender, the recipient and the reminder address all call it."""
+    if any(c in _DOT_LOOKALIKES for c in domain):
+        return False
+    if "." not in domain and any(c in _NON_ASCII_DOTS for c in domain):
+        return False
+    return all(
+        label and label[0] not in _LABEL_EDGE_HYPHENS and label[-1] not in _LABEL_EDGE_HYPHENS
+        for label in _LABEL_DOTS.split(domain)
+    )
+
+
+def plain_address_ok(s: str) -> bool:
+    """One plain address (PLAIN_ADDRESS) with exactly one "@" and a domain that has well-formed labels. The pattern
+    lets "@" into the domain part, so a second "@" ("desk@-x@good.test") is refused here, not left to the domain check."""
+    return PLAIN_ADDRESS.fullmatch(s) is not None and s.count("@") == 1 and domain_labels_ok(s.rpartition("@")[2])
+
+
 def _valid_email(e: str) -> bool:
     return (
         _lower_keeps_ascii_apart(e)
         and len(e) <= EMAIL_MAX
         and len(normalise_email(e)) <= EMAIL_MAX  # lower case can be longer (some letters become two characters)
         and _EMAIL_RE.fullmatch(e) is not None
-        and not e.endswith(".")
+        and domain_labels_ok(e.rpartition("@")[2])  # also refuses a trailing dot (an empty last label)
         and not any(unicodedata.category(c).startswith("C") for c in e)
     )
 
