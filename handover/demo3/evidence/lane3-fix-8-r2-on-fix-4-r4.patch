+@pytest.mark.parametrize("hy", HYPHEN_LOOKALIKES)
+def test_hyphen_lookalikes_at_a_label_edge_are_refused(hy: str) -> None:
+    for domain in (f"a{hy}.test", f"{hy}a.test", f"x.a{hy}.test", f"x.{hy}a.test", f"a.test{hy}"):
