+_NON_ASCII_DOTS = frozenset("\u3002\uff0e\uff61")
+_DOT_LOOKALIKES = frozenset("\u2024\ufe52")
+_LABEL_EDGE_HYPHENS = "-\uff0d\u2010\u2011\u2212"
 _CONTROL_OK_IN_MESSAGE = frozenset("\t\n\r")
