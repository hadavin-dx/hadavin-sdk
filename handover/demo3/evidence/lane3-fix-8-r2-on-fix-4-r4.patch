index 0000000..8cb1630
--- /dev/null
+++ b/tests/test_domain_labels.py
@@ -0,0 +1,261 @@
+"""A domain whose labels are not well formed is not a mailbox: it starts with a dot, ends with a dot, has two dots in
+a row, or has a label that starts or ends with a hyphen. Such a lead email goes to review (never a lead of its own,
+never a follow-up mail); the same rule guards the sender, recipient and reminder addresses. Made-up data only."""
+
+from __future__ import annotations
+
+import random
+import string
+from pathlib import Path
+
+import pytest
+from support import lead
+
+from lead_desk import identity
+from lead_desk.config import Config, SettingRefused
+from lead_desk.contract import SendRefused
+from lead_desk.smtp_outbox import SmtpOutbox, SmtpSettings
+
+AT = "@"  # a fake address is built from parts (the hygiene scan reads every address-shaped text)
+DOTS = ("。", "．", "｡")  # the dots that internationalised domain names also read as a dot
+
+BAD_DOMAINS = [
+    ".dom.test",  # starts with a dot
+    "a..b.test",  # two dots in a row (an empty label)
+    "a.b..test",
+    "example.test.",  # ends with a dot (the earlier rule)
+    "example.test..",
+    "..test",
+    "-a.test",  # label starts with a hyphen
+    "a-.test",  # label ends with a hyphen
+    "a.-b.test",
+    "a.b-.test",
+    "a.test-",
+    "a.-",
+    # each of these has an ASCII dot, so only the splitting on the three other dots can refuse it
+    "ex.a" + DOTS[0] + DOTS[0] + "test",
+    "a" + DOTS[1] + DOTS[1] + "test.test",
+    DOTS[2] + "example.test",
+    "example.test" + DOTS[0],
+    "a.b-" + DOTS[0] + "c",  # "b-" ends with a hyphen once the other dot is read as a dot
+    "a.b" + DOTS[1] + "-c",
+    "a.b" + DOTS[2] + DOTS[2] + "c",
+]
+# a domain whose only dots are the three non-ASCII ones is not a mailbox domain: one rule, a real ASCII dot is needed
+UNICODE_ONLY_DOMAINS = ["example" + d + "test" for d in DOTS] + ["a" + DOTS[0] + "b" + DOTS[1] + "c", "xn--k" + DOTS[2] + "x"]
+# look-alikes of the hyphen (U+FF0D, U+2010, U+2011, U+2212) at a label edge; of the dot (U+2024, U+FE52) anywhere
+HYPHEN_LOOKALIKES = ("\uff0d", "\u2010", "\u2011", "\u2212")
+DOT_LOOKALIKES = ("\u2024", "\ufe52")
+GOOD_DOMAINS = [
+    "example.test",
+    "a.b",
+    "sub-domain.example.test",
+    "a-b-c.d-e.test",
+    "1-2.test",
+    "xn--bcher-kva.example",
+    "bücher.example",
+    "a" + "." + "b" + "." + "c",
+    "xn--k.test",
+    "bücher.test",
+    "Example.TEST",
+    "a." + "x" * 70 + ".test",  # labels over 63 characters are not checked (said in docs/limits.md)
+    "a" + DOTS[0] + "b.test",  # a real dot is there, so the other dot only splits a label
+]
+
+
+def verdict(domain: str, local: str = "loc") -> identity.Checked:
+    return identity.check_payload({"name": "N", "email": f"{local}@{domain}"})
+
+
+@pytest.mark.parametrize("domain", BAD_DOMAINS)
+def test_badly_shaped_domain_goes_to_review(domain: str) -> None:
+    chk = verdict(domain)
+    assert (chk.kind, chk.reason, chk.email_key) == ("review", "invalid_email", None), domain
+
+
+@pytest.mark.parametrize("domain", GOOD_DOMAINS)
+def test_well_shaped_domain_stays_valid(domain: str) -> None:
+    assert verdict(domain).kind == "ok", domain
+
+
+_FORBIDDEN_IN_LEAD_DOMAIN = set('@<>",;\'') | set(DOT_LOOKALIKES)
+_FORBIDDEN_IN_PLAIN_DOMAIN = set('@<>",;()\r\n\x00') | set(DOT_LOOKALIKES)
+_HYPHENS = {"-", *HYPHEN_LOOKALIKES}
+_ANY_DOT = {".", *DOTS}
+
+
+def _oracle_labels_ok(domain: str, forbidden: set[str], need_ascii_dot: bool) -> bool:
+    """The rule written out a second way: walk the characters once (no split, no regular expression)."""
+    if not domain:
+        return False
+    if any(c in forbidden or c.isspace() or ord(c) < 32 for c in domain):
+        return False
+    if (need_ascii_dot or any(c in DOTS for c in domain)) and "." not in domain:
+        return False
+    first = last = None  # first and last character of the label being read
+    n = 0  # characters in the label being read
+    for c in domain + ".":  # the closing dot ends the last label
+        if c in _ANY_DOT:
+            if n == 0 or first in _HYPHENS or last in _HYPHENS:
+                return False
+            first = last = None
+            n = 0
+        else:
+            first = c if n == 0 else first
+            last = c
+            n += 1
+    return True
+
+
+FUZZ_PIECES = [
+    "a", "b", "x1", "A", "-", ".", ".", "..", "-.", ".-", "a-b", "。", "．", "｡", "xn--k", "test", "bücher",
+    "\u00a0", "\x00", "\uff0d", "\u2010", "\u2011", "\u2212", "\u2024", "\ufe52", "@", "a" * 64, " ", "\t",
+]  # fmt: skip
+FUZZ_PIECES += ["a", "b", ".", "test", "x1", "a-b", "xn--k", "bücher", ".", "A", "。"] * 4  # more well-formed pieces
+
+
+def test_fuzz_lead_domain_matches_an_independent_oracle() -> None:
+    """Fixed-seed fuzz over generated domains (wide alphabet): accepted if and only if the oracle says so."""
+    rng = random.Random(8)
+    accepted = rejected = 0
+    for _ in range(30000):
+        domain = "".join(rng.choice(FUZZ_PIECES) for _ in range(rng.randint(1, 6)))
+        email = f"loc@{domain}"
+        want = _oracle_labels_ok(domain, _FORBIDDEN_IN_LEAD_DOMAIN, True)
+        assert identity._valid_email(email) is want, repr(domain)
+        accepted += want
+        rejected += not want
+    assert accepted > 200 and rejected > 5000, (accepted, rejected)  # both sides are exercised
+
+
+def test_fuzz_plain_address_matches_an_independent_oracle() -> None:
+    rng = random.Random(9)
+    accepted = rejected = 0
+    for _ in range(30000):
+        rest = "".join(rng.choice(FUZZ_PIECES) for _ in range(rng.randint(1, 6)))
+        s = "desk" + AT + rest
+        domain = rest.rpartition(AT)[2]
+        want = rest.count(AT) == 0 and _oracle_labels_ok(rest, _FORBIDDEN_IN_PLAIN_DOMAIN, False)
+        assert identity.plain_address_ok(s) is want, repr(s)
+        accepted += want
+        rejected += not want
+        assert domain is not None
+    assert accepted > 200 and rejected > 5000, (accepted, rejected)
+
+
+def test_fuzz_well_formed_domains_are_accepted() -> None:
+    """Completeness: a domain built from well-formed labels is accepted by the lead check and the plain check."""
+    rng = random.Random(10)
+    label_chars = string.ascii_letters + string.digits + "ü"
+    for _ in range(3000):
+        labels = []
+        for _ in range(rng.randint(2, 5)):
+            body = "".join(rng.choice(label_chars + "-") for _ in range(rng.randint(1, 40)))
+            labels.append(rng.choice(label_chars) + body.strip("-") + rng.choice(label_chars))
+        dots = [rng.choice((".", *DOTS)) for _ in labels[1:]]
+        dots[rng.randrange(len(dots))] = "."  # at least one real dot
+        domain = labels[0] + "".join(d + lb for d, lb in zip(dots, labels[1:], strict=True))
+        assert identity._valid_email(f"loc@{domain}"), repr(domain)
+        assert identity.plain_address_ok(f"loc@{domain}"), repr(domain)
+
+
+def test_domain_labels_ok_edges() -> None:
+    assert identity.domain_labels_ok("localhost")  # a one-label host name (a sender may be desk@localhost)
+    assert identity.domain_labels_ok("[::1]") and identity.domain_labels_ok("[127.0.0.1]")
+    assert not identity.domain_labels_ok("") and not identity.domain_labels_ok(".")
+    assert not identity.domain_labels_ok("localhost.") and not identity.domain_labels_ok("-localhost")
+
