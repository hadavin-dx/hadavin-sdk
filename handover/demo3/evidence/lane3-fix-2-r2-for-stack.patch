+def _kinds(f: Path, tmp_path: Path) -> dict[str, Any]:
+    hs = HubspotSettings.from_env({k: v for k, v in _hubspot(f).items() if k != "DESK_CRM"})
+    pv = ProviderSettings.from_env({k: v for k, v in _provider(f).items() if k != "DESK_OUTBOX"})
+    lv = Config.from_env({**_live(f, tmp_path), "DESK_QUALIFIER": "live_claude"}).live
+    assert lv is not None
+    return {"hubspot": HubspotCrm(hs), "provider": SmtpProviderOutbox(pv), "live": LiveQualifier(lv)}
