+def test_main_turns_a_refusing_check_start_into_exit_4_without_a_traceback(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    monkeypatch.setattr(server, "load_demo_adapters", lambda cfg: (_NoHook(), _Refusing(), _NoHook()))
+    monkeypatch.setenv("DESK_DB_PATH", str(tmp_path / "d.sqlite3"))
+    monkeypatch.setenv("DESK_PORT", "0")
+    with pytest.raises(SystemExit) as info:
+        server.main()
+    out = capsys.readouterr().out
+    assert info.value.code == 4
+    assert "the desk refuses a setting: DESK_MADE_UP_FILE: fixed text" in out
+
