+    assert "cannot take the lock file" in capsys.readouterr().out
+
+
+# ---------------------------------------------------------------------------------------------- DESK_REPLIES_PATH
+@pytest.mark.parametrize("content", [None, "{not json", "[1, 2]", ""], ids=["missing", "broken", "not-object", "empty"])
+def test_a_missing_or_broken_replies_file_ends_the_desk_with_exit_4(
