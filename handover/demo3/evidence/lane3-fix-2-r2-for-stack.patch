+# ---------------------------------------------------------------------------------------------- key and password files
+def _write(tmp_path: Path, name: str, text: str) -> Path:
+    p = tmp_path / name
+    p.write_text(text, encoding="utf-8")
+    return p
+
+
+def _hubspot(key: Path) -> dict[str, str]:
