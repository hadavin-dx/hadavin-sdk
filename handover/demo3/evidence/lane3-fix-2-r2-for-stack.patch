new file mode 100644
index 0000000..2aab115
--- /dev/null
+++ b/tests/test_settings_lane3.py
@@ -0,0 +1,566 @@
+"""A bad setting stops the start (docs/settings.md, line 3): exit code 4, the setting named, no traceback, and never a
+path, key or password in the text. Cases found by a cold reader who followed the documents literally: a DESK_BIND
+that is no address, an empty or unmakeable DESK_DB_PATH, a broken or missing DESK_REPLIES_PATH file, and key or
+password files that were not looked at until the first call. Made-up data; key files hold made-up text."""
+
+from __future__ import annotations
+
+import importlib
+import os
+import subprocess
+import sys
+import threading
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from demo_only.fakes_server import serve_fakes_in_thread, stop_fakes
+from lead_desk import lockfile, server
+from lead_desk.config import Config
+from lead_desk.crm_hubspot import HubspotCrm, HubspotSettings
+from lead_desk.desk import MEMORY_BOOK_PROBLEM, book_problem
+from lead_desk.envnum import SettingRefused, env_yes_no
+from lead_desk.live_claude import LiveQualifier
+from lead_desk.loader import StartCheck, check_secret_files, load_demo_adapters
+from lead_desk.smtp_provider import ProviderSettings, SmtpProviderOutbox
+
+REPO = Path(__file__).resolve().parents[1]
+ALL_ZEROS = ".".join("0000")  # built from parts: the every-interface address
+FAKE_KEY = "made" + "-up-" + "key-" + "0123456789"  # built from parts: never a real key
+
+
+@pytest.fixture(scope="module")
+def fakes_url() -> Iterator[str]:
+    srv, url, th = serve_fakes_in_thread("keyed")
+    yield url
+    stop_fakes(srv, th)
+
+
+def _env(tmp_path: Path, fakes_url: str, extra: dict[str, str]) -> dict[str, str]:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}
+    env.update(
+        PYTHONPATH=os.pathsep.join([str(REPO / "src"), str(REPO)]),
+        DESK_DB_PATH=str(tmp_path / "d.sqlite3"),
+        DESK_PORT="0",
+        DESK_FAKES_URL=fakes_url,
+    )
+    env.update(extra)
+    return env
+
+
+def _run(tmp_path: Path, fakes_url: str, extra: dict[str, str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(  # noqa: S603  # nosec B603 - our own module, fixed arguments
+        [sys.executable, "-m", "lead_desk.server"],
+        capture_output=True,
+        text=True,
+        timeout=60,
+        cwd=tmp_path,
+        env=_env(tmp_path, fakes_url, extra),
+    )
+
+
+def _refused_any(r: subprocess.CompletedProcess[str], setting: str, *secrets: str) -> None:
+    """Exit 4, the setting named (the text may start `the desk refuses a setting:` or `the desk refuses to start:`)."""
+    out = r.stdout + r.stderr
+    assert r.returncode == 4, out[-600:]
+    assert setting in r.stdout, out[-600:]
+    assert "Traceback" not in out
+    for s in secrets:
+        assert s not in out
+
+
+def _refused(r: subprocess.CompletedProcess[str], setting: str, *secrets: str) -> None:
+    out = r.stdout + r.stderr
+    assert r.returncode == 4, out[-600:]
+    assert f"the desk refuses a setting: {setting}" in r.stdout, out[-600:]
+    assert "Traceback" not in out
+    for s in secrets:
+        assert s not in out
+
+
+# ---------------------------------------------------------------------------------------------- DESK_BIND
+@pytest.mark.parametrize(
+    "bind",
+    [
+        "not an address",
+        "a b",
+        "bad name!",
+        "a,b",
+        "",
+        "\t",
+        "a..b",
+        ".".join(("256", "1", "1", "1")),  # built from parts: the hygiene scan reads a written address as hard-coded
+        "[" + ".".join(("1", "2", "3", "4")) + "]",
+        "h\u00e9llo",
+        "host:80",
+        "a" * 300,
+    ],
+    ids=[
+        "spaces",
+        "space",
+        "bang",
+        "comma",
+        "empty",
+        "tab",
+        "empty-part",
+        "bad-ipv4",
+        "bracketed-ipv4",
+        "non-ascii",
+        "colon",
+        "long",
+    ],
+)
+def test_a_bind_that_can_never_be_a_name_is_refused_by_the_settings(bind: str) -> None:
+    with pytest.raises(SettingRefused, match="DESK_BIND"):
+        Config(bind=bind)
+
+
+@pytest.mark.parametrize(
+    "bind",
+    [
+        "127.0.0.1",
+        ".".join(("127", "0", "0", "2")),
+        "127.1",
+        "::1",
+        "[::1]",
+        "[fe80::1%eth0]",
+        "fe80::1%eth0",
+        "::",
+        "[::]",
+        ALL_ZEROS,
+        "0",
+        "localhost",
+        "LocalHost",
+        "localhost.",
+        "desk_web",
+        "my-host." + "lo" + "cal",
+    ],
+)
+def test_every_name_the_system_might_resolve_is_accepted(bind: str) -> None:
+    assert Config.from_env({"DESK_BIND": bind}).bind == bind
+
+
+def test_the_ip_path_and_the_bracket_path_agree_on_a_zone_id() -> None:
+    assert Config(bind="[fe80::1%eth0]").bind == "[fe80::1%eth0]"
+    assert Config(bind="fe80::1%eth0").bind == "fe80::1%eth0"
+
+
+def test_a_bind_that_is_no_address_ends_the_desk_with_exit_4(tmp_path: Path, fakes_url: str) -> None:
+    _refused(_run(tmp_path, fakes_url, {"DESK_BIND": "not an address"}), "DESK_BIND must be an IP address")
+
+
+# ---------------------------------------------------------------------------------------------- DESK_DB_PATH
+@pytest.mark.parametrize("value", ["", "   "])
+def test_an_empty_db_path_is_refused_by_the_settings(value: str) -> None:
+    with pytest.raises(SettingRefused, match="DESK_DB_PATH must not be empty"):
+        Config.from_env({"DESK_DB_PATH": value})
+
+
+def test_an_empty_db_path_ends_the_desk_with_exit_4(tmp_path: Path, fakes_url: str) -> None:
+    _refused(_run(tmp_path, fakes_url, {"DESK_DB_PATH": ""}), "DESK_DB_PATH must not be empty")
+
+
+def _main_refusal(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, db_path: str, capsys: pytest.CaptureFixture[str]) -> str:
+    """Run `server.main()` in this process with DESK_DB_PATH set; it must end in SystemExit(4) with no traceback."""
+    monkeypatch.setenv("DESK_DB_PATH", db_path)
+    monkeypatch.setenv("DESK_PORT", "0")
+    with pytest.raises(SystemExit) as info:
+        server.main()
+    out = capsys.readouterr().out
+    assert info.value.code == 4, out
+    return out
+
+
+def test_a_db_path_that_is_an_existing_folder_exits_4_with_no_path_and_no_lock_file(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    folder = tmp_path / "adir"
+    folder.mkdir()
+    out = _main_refusal(monkeypatch, tmp_path, str(folder), capsys)
+    assert out.startswith("the desk refuses to start: DESK_DB_PATH names a folder"), out
+    assert str(folder) not in out
+    assert not Path(f"{folder}.lock").exists()  # refused before the lock step
+
+
+def test_a_db_path_that_ends_in_a_dot_exits_4(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    (tmp_path / "adir").mkdir()
+    out = _main_refusal(monkeypatch, tmp_path, str(tmp_path / "adir" / "."), capsys)
+    assert "DESK_DB_PATH names a folder" in out
+
+
+def test_a_db_path_whose_parent_is_a_file_exits_4(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    in_the_way = tmp_path / "a-file"
+    in_the_way.write_text("x", encoding="utf-8")
+    out = _main_refusal(monkeypatch, tmp_path, str(in_the_way / "d.sqlite3"), capsys)
+    assert "DESK_DB_PATH sits inside something that is a file" in out
+    assert str(in_the_way) not in out
+
+
+def test_a_db_path_deeper_below_a_file_exits_4_and_the_folder_is_not_made(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    in_the_way = tmp_path / "a-file"
+    in_the_way.write_text("x", encoding="utf-8")
+    out = _main_refusal(monkeypatch, tmp_path, str(in_the_way / "sub" / "deeper" / "d.sqlite3"), capsys)
+    assert "DESK_DB_PATH sits inside something that is a file" in out
+    assert str(in_the_way) not in out
+
+
+def test_book_problem_is_the_one_place_for_the_db_path_rules(tmp_path: Path) -> None:
+    f = tmp_path / "a-file"
+    f.write_text("x", encoding="utf-8")
+    assert book_problem(":memory:") == MEMORY_BOOK_PROBLEM
+    assert book_problem(Path("")) is not None and "folder" in str(book_problem(Path("")))
+    assert book_problem(tmp_path) is not None
+    assert book_problem(f / "b.db") is not None
+    assert book_problem(tmp_path / "new" / "deeper" / "b.db") is None  # a folder that can still be made
+    assert book_problem(f) is None  # an existing file is the lead book itself
+
+
+def test_a_db_folder_that_cannot_be_made_ends_the_desk_with_exit_4_and_no_path(tmp_path: Path, fakes_url: str) -> None:
+    in_the_way = tmp_path / "a-file"
+    in_the_way.write_text("x", encoding="utf-8")
+    target = in_the_way / "sub" / "d.sqlite3"
+    _refused_any(_run(tmp_path, fakes_url, {"DESK_DB_PATH": str(target)}), "DESK_DB_PATH", str(in_the_way))
+
+
+@pytest.mark.skipif(os.geteuid() == 0, reason="root ignores folder permissions: an unwritable folder cannot be tested as root")
+def test_an_unwritable_db_parent_exits_4(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    ro = tmp_path / "ro"
+    ro.mkdir()
+    ro.chmod(0o500)
+    try:
+        out = _main_refusal(monkeypatch, tmp_path, str(ro / "sub" / "d.sqlite3"), capsys)
+    finally:
