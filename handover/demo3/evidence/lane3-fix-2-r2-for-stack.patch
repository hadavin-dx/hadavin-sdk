+        return True
+    return all(name.rstrip(".").split("."))  # no empty part (`a..b`, `.a`)
+
+
+def _is_ipv6(text: str) -> bool:
+    try:
+        return ipaddress.ip_address(text).version == 6
+    except ValueError:
