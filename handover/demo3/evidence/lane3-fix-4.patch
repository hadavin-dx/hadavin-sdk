@@ -0,0 +1,57 @@
+"""The email key lower-cases with Python's `lower()`, not full case folding. Two letters differ, and the documents
+must say so. If the code ever changes to case folding, this file fails until the documents are changed too.
+Made-up data only (example.com)."""
+
+from __future__ import annotations
+
+import pytest
+from support import REPO, call, lead, post_lead
+
+from lead_desk.identity import check_payload, normalise_email
+
+SHARP_S = "straße@example.com"  # straße
+SHARP_S_UPPER = "STRASSE@example.com"
+DOTLESS_I = "ıstanbul@example.com"  # ıstanbul
+DOTLESS_I_UPPER = "ISTANBUL@example.com"
+LONG_S = "\u017fam@example.com"  # ſam (long s, a rare letter)
+LONG_S_UPPER = "SAM@example.com"
+SAME_AFTER_CASE = [  # upper case and lower case give one key
+    ("émile@example.com", "ÉMILE@example.com"),  # é
+    ("müller@example.com", "MÜLLER@example.com"),  # ü
+    ("özil@example.com", "ÖZIL@example.com"),  # ö
+    ("françois@example.com", "FRANÇOIS@example.com"),  # ç
+    ("ada@example.com", "ADA@Example.COM"),
+]
+DOCS = ("README.md", "docs/limits.md")
+
+
+@pytest.mark.parametrize(("lower", "upper"), [(SHARP_S, SHARP_S_UPPER), (DOTLESS_I, DOTLESS_I_UPPER), (LONG_S, LONG_S_UPPER)])
+def test_sharp_s_and_dotless_i_in_capitals_are_other_keys(lower: str, upper: str) -> None:
+    assert normalise_email(lower) != normalise_email(upper)
+    for e in (lower, upper):  # both are accepted as valid addresses, so each one becomes a lead
+        assert check_payload({"name": "Ada", "email": e}).kind == "ok"
+
+
+@pytest.mark.parametrize(("lower", "upper"), SAME_AFTER_CASE)
+def test_ordinary_and_accented_letters_give_one_key(lower: str, upper: str) -> None:
+    assert normalise_email(lower) == normalise_email(upper)
+
+
+@pytest.mark.parametrize(("lower", "upper"), [(SHARP_S, SHARP_S_UPPER), (DOTLESS_I, DOTLESS_I_UPPER)])
+def test_real_desk_round_makes_two_leads(env, lower: str, upper: str) -> None:
+    """The cost of the rule, shown on the real desk: two `new` verdicts, two leads."""
+    rig = env.rig()
+    base = env.serve(rig)
+    one = post_lead(base, "form", "r1", lead(email=lower))
+    two = post_lead(base, "form", "r2", lead(email=upper))
+    assert (one[0], one[1]["verdict"]) == (201, "new")
+    assert (two[0], two[1]["verdict"]) == (201, "new")
+    assert rig.leads() == 2
+    assert call(base, "GET", "/counts")[0] == 200
+
+
+@pytest.mark.parametrize("doc", DOCS)
+def test_documents_say_lower_is_python_lower_and_name_the_two_letters(doc: str) -> None:
+    text = (REPO / doc).read_text(encoding="utf-8")
+    for fact in ("lower()", "ß", "ı", "STRASSE", "ISTANBUL"):
+        assert fact in text, f"{doc} must mention {fact!r}: the code lower-cases with Python's lower()"
