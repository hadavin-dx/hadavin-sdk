+        assert status in OK, (status, data)
+        assert _memory_settled(store, _run_id(SENDER, KEY)) == FINAL
+    finally:
+        runner.close()
+    assert seen == (["reserve_spend"] if RESERVES else []), (
+        f"RESERVES={RESERVES} but the loop made {len(seen)} reserve_spend call(s)"
