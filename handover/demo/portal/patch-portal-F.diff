+def test_stub_loader_broken(env: Env, monkeypatch: pytest.MonkeyPatch) -> None:
+    desk = env.rig().desk
+    real = importlib.import_module
+
+    def broken(name: str, package: str | None = None) -> Any:
+        if name == "demo_only.portal_demo":
+            raise ModuleNotFoundError("No module named 'some_other_thing'", name="some_other_thing")
+        return real(name, package)
+
+    monkeypatch.setattr(importlib, "import_module", broken)
+    with pytest.raises(ModuleNotFoundError):
+        stub_load_demo_portal(desk)
+    monkeypatch.setattr(importlib, "import_module", lambda *a, **k: (_ for _ in ()).throw(ImportError("boom")))
+    with pytest.raises(ImportError):
+        stub_load_demo_portal(desk)
