+def test_slot_survives_every_end(live, monkeypatch) -> None:
+    """Many connections that end in every possible way: no place leaks, the cap is never passed, nothing is left
+    waiting to be picked up by a thread."""
+    cap(monkeypatch, 3)
+    for i in range(60):
