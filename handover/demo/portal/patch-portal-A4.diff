+def test_requeue_age_boundary_direct(env) -> None:
+    """desk.py _requeue_sending: updated_at <= older_than. A row exactly on the line is requeued, one second newer
+    is not."""
+    rig = env.rig()
+    on, newer = new_lead(rig, "b1"), new_lead(rig, "b2")
+    line = rig.clock.t - 100
+    set_follow(rig, on, state="sending", attempts=1, auto_attempts=1, updated_at=line)
