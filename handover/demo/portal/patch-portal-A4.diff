+def test_requeue_age_boundary_in_reaper(env) -> None:
+    """The reaper pass: a sending row exactly send timeout + grace old is put back; one second younger is not."""
+    rig = env.rig()
+    age = stuck_age(rig)
+    assert age == 25, "default send timeout 5 s plus 4 busy waits of 5 s"
+    on, younger = new_lead(rig, "b3"), new_lead(rig, "b4")
+    set_follow(rig, on, state="sending", attempts=1, auto_attempts=1, updated_at=rig.clock.t - age)
+    set_follow(rig, younger, state="sending", attempts=1, auto_attempts=1, updated_at=rig.clock.t - age + 1)
+    rig.desk.reap_once()
+    assert follow(rig, on, "state, last_error") == ("pending", "crash_while_sending")
+    assert follow(rig, younger, "state") == ("sending",)
