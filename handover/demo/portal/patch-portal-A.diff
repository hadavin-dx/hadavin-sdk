+        at.clear()
+        seen[0] = 0
+        assert get(base, path)[0] == 200
+        assert at == [2], (path, at)  # BEGIN and the first read came first
+    rig.clock.t = 1_000_000
+    server_obj = make_server(rig.desk, replace(rig.config, port=free_port()))
+    try:
