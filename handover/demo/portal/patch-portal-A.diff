+LOCAL = "localhost"
+WILDCARD4 = str(ipaddress.IPv4Address(0))  # built, not typed: a typed one trips the hard-coded address scan
+LOOP6_SHORT = ":".join(["0"] * 7 + ["1"])
+LOOP6_FULL = ipaddress.IPv6Address(1).exploded
+
