+# -- the Host and Origin gate
+def raw(base: str, request_line: str, *headers: str, body: bytes = b"") -> tuple[int, Any]:
+    head = "\r\n".join([request_line, *headers, "Connection: close", ""])
+    return raw_exchange(base, head.encode() + b"\r\n" + body)
+
