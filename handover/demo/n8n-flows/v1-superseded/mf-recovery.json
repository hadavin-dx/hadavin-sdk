{
 "name": "Lead desk main frame: recovery (every 30 s)",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "seconds",
       "secondsInterval": 30
      }
     ]
    }
   },
   "name": "Every30s",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET updated_at=now() WHERE lead_key IN (SELECT lead_key FROM mf_leads WHERE state NOT IN ('done','unknown') AND updated_at < now() - interval '20 seconds' ORDER BY created_at LIMIT 20 FOR UPDATE SKIP LOCKED) RETURNING lead_key, email, name, mail_sent, state;",
    "options": {}
   },
   "name": "ClaimStuck",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    220,
    0
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": false
  },
  {
   "parameters": {
    "assignments": {
     "assignments": [
      {
       "id": "lead_key",
       "name": "lead_key",
       "value": "={{ $json.lead_key }}",
       "type": "string"
      },
      {
       "id": "email",
       "name": "email",
       "value": "={{ $json.email }}",
       "type": "string"
      },
      {
       "id": "mail_sent",
       "name": "mail_sent",
       "value": "={{ $json.mail_sent }}",
       "type": "boolean"
      }
     ]
    },
    "options": {}
   },
   "name": "RItem",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    440,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $env.MF_STAGE_URL }}/qualify",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ { lead_key: $('RItem').item.json.lead_key, email: $('RItem').item.json.email } }}",
    "options": {
     "timeout": 15000
    }
   },
   "name": "RQualify",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    660,
    0
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 1000
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET label=$2, updated_at=now() WHERE lead_key=$1 RETURNING lead_key;",
    "options": {
     "queryReplacement": "={{ [$('RItem').item.json.lead_key, $json.label] }}"
    }
   },
   "name": "RSaveLabel",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    880,
    0
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $env.MF_CRM_URL }}/search",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ { lead_key: $('RItem').item.json.lead_key } }}",
    "options": {
     "timeout": 15000
    }
   },
   "name": "RCrmSearch",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1100,
    0
   ],
   "retryOnFail": true,
   "maxTries": 3,
   "waitBetweenTries": 1000
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.results.length }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "name": "RCrmNone",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1320,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "={{ $env.MF_CRM_URL }}/create",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ { lead_key: $('RItem').item.json.lead_key, email: $('RItem').item.json.email, label: $('RQualify').item.json.label } }}",
    "options": {
     "timeout": 15000
    }
   },
   "name": "RCrmCreate",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    1540,
    -80
   ]
  },
  {
   "parameters": {},
   "name": "RCrmExists",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    1540,
    80
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET state='crm_done', updated_at=now() WHERE lead_key=$1 RETURNING lead_key;",
    "options": {
     "queryReplacement": "={{ [$('RItem').item.json.lead_key] }}"
    }
   },
   "name": "RSetCrm",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    1760,
    0
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $('RItem').item.json.mail_sent }}",
       "rightValue": null,
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "name": "RMailAlready",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1980,
    0
   ]
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET state='unknown', updated_at=now() WHERE lead_key=$1 RETURNING lead_key;",
    "options": {
     "queryReplacement": "={{ [$('RItem').item.json.lead_key] }}"
    }
   },
   "name": "RMarkUnknown",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    2200,
    120
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET mail_sent=true, updated_at=now() WHERE lead_key=$1 RETURNING lead_key;",
    "options": {
     "queryReplacement": "={{ [$('RItem').item.json.lead_key] }}"
    }
   },
   "name": "RMarkMailSent",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    2200,
    -60
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": true
  },
  {
   "parameters": {
    "fromEmail": "desk@example.test",
    "toEmail": "={{ $('RItem').item.json.email }}",
    "subject": "={{ 'Thanks, ref ' + $('RItem').item.json.lead_key }}",
    "emailFormat": "text",
    "text": "made-up thank-you text",
    "options": {
     "appendAttribution": false
    }
   },
   "name": "RSendMail",
   "type": "n8n-nodes-base.emailSend",
   "typeVersion": 2.1,
   "position": [
    2420,
    -60
   ],
   "credentials": {
    "smtp": {
     "id": "SMTP_CREDENTIAL_ID",
     "name": "mf-mail-smtp"
    }
   }
  },
  {
   "parameters": {
    "operation": "executeQuery",
    "query": "UPDATE mf_leads SET state='done', updated_at=now() WHERE lead_key=$1 RETURNING lead_key;",
    "options": {
     "queryReplacement": "={{ [$('RItem').item.json.lead_key] }}"
    }
   },
   "name": "RMarkDone",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    2640,
    -60
   ],
   "credentials": {
    "postgres": {
     "id": "PG_CREDENTIAL_ID",
     "name": "n8n-publish-pg"
    }
   },
   "alwaysOutputData": true
  }
 ],
 "connections": {
  "Every30s": {
   "main": [
    [
     {
      "node": "ClaimStuck",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "ClaimStuck": {
   "main": [
