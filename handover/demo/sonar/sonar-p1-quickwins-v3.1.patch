+def test_the_scan_of_one_very_long_line_is_linear() -> None:
+    """A line of 150 000 `<<` took 86 s when each `<<` looked back along the line for `((`. A bound far above the
+    linear time (0.01 to 3 s here) and far below the old one."""
+    import time
+
+    for text in ("<<" * 150_000, "<<EOF " * 100_000, "[[ " * 200_000, "$(" * 20_000 + ")" * 20_000, "[ " * 200_000):
+        started = time.monotonic()
+        _single_bracket_lines(text)
+        assert time.monotonic() - started < 20, text[:12]
+
+
+def _run_blocks(workflow: Path) -> list[str]:
+    doc = yaml.safe_load(workflow.read_text(encoding="utf-8"))
+    return [
+        step["run"]
+        for job in doc.get("jobs", {}).values()
+        for step in job.get("steps", [])
+        if isinstance(step.get("run"), str)
+    ]
+
+
+def _workflow_shell_problems(name: str, doc: dict[str, Any]) -> list[str]:
+    """A `run:` block is read as bash: a `shell:` key (job default or step) naming another shell is a problem."""
+    problems: list[str] = []
+    for job in doc.get("jobs", {}).values():
+        if job.get("defaults", {}).get("run", {}).get("shell", "bash") != "bash":
+            problems.append(f"{name}: job default shell")
+        problems += [
+            f"{name}: step {step.get('name')}" for step in job.get("steps", []) if step.get("shell", "bash") != "bash"
+        ]
+    return problems
+
+
+_NL = chr(10)  # joined, not written as escapes: a letter, colon and backslash would read as a drive path to the scan
+_STEP = ["    steps:", "      - name: x", "        run: echo hi"]
+_DEFAULT_SH = ["    defaults:", "      run:", "        shell: sh"]
+_WORKFLOWS = [
+    (["jobs:", "  a:", *_STEP], 0),
+    (["jobs:", "  a:", *_STEP, "        shell: bash"], 0),
+    (["jobs:", "  a:", *_STEP, "        shell: sh"], 1),
+    (["jobs:", "  a:", *_STEP, "        shell: pwsh"], 1),
+    (["jobs:", "  a:", *_DEFAULT_SH, *_STEP], 1),
+    (["jobs:", "  a:", *_DEFAULT_SH, *_STEP, "  b:", *_STEP, "        shell: dash"], 2),
+]
+
+
+@pytest.mark.parametrize(("lines", "problems"), _WORKFLOWS)
+def test_a_workflow_shell_key_other_than_bash_is_found(lines: list[str], problems: int) -> None:
+    doc = yaml.safe_load(_NL.join(lines) + _NL)
+    assert len(_workflow_shell_problems("w.yml", doc)) == problems, lines
+
+
+def test_sh_scripts_and_workflow_run_blocks_use_double_brackets_for_tests() -> None:
+    """bash's [[ ]] does not split words or expand patterns inside the test (SonarCloud rule shell:S7688). Every
+    tracked .sh file starts with a bash shebang, and a workflow `run:` block runs under bash (the runner default on
+    Linux; a `shell:` key other than bash would fail this test)."""
+    names = [n for n in _git(REPO, "ls-files", "*.sh").splitlines() if n]
+    assert names, "no shell scripts found: the test would prove nothing"
+    bad: list[str] = []
+    for n in names:
+        text = (REPO / n).read_text(encoding="utf-8")
+        assert text.startswith("#!/usr/bin/env bash\n"), f"{n}: not a bash script"
+        assert not _scan(text)[1], f"{n}: the scan ends inside a quote: its result cannot be trusted"
+        bad += [f"{n}:{i}" for i in _single_bracket_lines(text)]
+    flows = sorted((REPO / ".github" / "workflows").glob("*.yml"))
+    assert flows, "no workflow files found: the test would prove nothing"
+    blocks = 0
+    for flow in flows:
+        doc = yaml.safe_load(flow.read_text(encoding="utf-8"))
+        assert not _workflow_shell_problems(flow.name, doc), f"{flow.name}: a shell other than bash"
+        for block in _run_blocks(flow):
+            blocks += 1
+            assert not _scan(block)[1], f"{flow.name}: a run block ends inside a quote: the scan cannot be trusted"
+            bad += [f"{flow.name} run-block line {i}" for i in _single_bracket_lines(block)]
+    assert blocks, "no run blocks found: the test would prove nothing"
+    assert not bad, f"single-bracket test in: {bad}"
