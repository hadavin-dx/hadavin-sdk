+
+
+# the Unicode direction controls that can make source code read differently from how it runs ("Trojan Source"):
+# U+202A..U+202E (embeddings, overrides), U+2066..U+2069 (isolates), U+200E, U+200F and U+061C (direction marks)
+_BIDI = re.compile("[\u202a-\u202e\u2066-\u2069\u200e\u200f\u061c]")
+
+
+def test_no_tracked_file_holds_a_raw_direction_control_character() -> None:
+    """A test that needs such a character builds it from an escape (\\u202e) so the file itself holds none
+    (SonarCloud rule text:S6389; the same attack as CVE-2021-42574)."""
+    offenders = []
+    for rel in _git(REPO, "ls-files").splitlines():
+        path = REPO / rel
+        if not rel or not path.is_file():
+            continue
+        try:
+            text = path.read_text(encoding="utf-8")
+        except UnicodeDecodeError:
+            continue  # a binary file (image, font): not text
+        offenders += [
+            f"{rel}:{n}" for n, line in enumerate(text.split("\n"), 1) if _BIDI.search(line)
+        ]  # split on \n only: splitlines() also cuts at U+2028
+    assert not offenders, f"raw direction control characters in: {offenders}"
+
+
+def test_the_direction_control_pattern_sees_each_character() -> None:
+    for code in (0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069, 0x200E, 0x200F, 0x061C):
+        assert _BIDI.search("a" + chr(code) + "b"), hex(code)
+    assert not _BIDI.search("plain text \u200d joiner and \u200b space are not direction controls")
+
+
+# a heredoc operator `<<` or `<<-`, then one shell word: any run of characters that are not blanks or the
+# operators ; & | ( ) >, with '..', ".." and \x pieces (their quote marks are not part of the delimiter).
+# `<<<` (a here-string) is never a heredoc and is skipped before this is tried.
+_HEREDOC = re.compile(r"<<(-?)[ \t]*((?:'[^']*'|\"[^\"]*\"|\\.|[^\s;&|()>'\"\\])+)")
+_QUOTE_MARKS = re.compile(r"'([^']*)'|\"([^\"]*)\"|\\(.)")
+
+
+def _scan(text: str) -> tuple[str, bool]:
+    """Shell text with quoted strings, # comments and heredoc bodies blanked (newlines kept), and whether the text
+    ends inside an open quote or command substitution. Code inside "$( ... )" and `...` stays visible. A character
+    scanner, not a shell parser: it knows ' " \\ $'..' $( ) ` # and << WORD (the word is any shell word, quotes
+    removed); `<<<` is a here-string and `$(( 1 << n ))` a shift, neither is a heredoc. Quoted text is blanked to `_`,
+    not to a blank, so `["a"]` stays `[___]` and is not read as `[ ` followed by a blank. The flag is also set when a
+    heredoc end line is never found, because everything after it was blanked."""
+    out: list[str] = []
+    stack: list[list[object]] = [["code", 0]]  # [mode, parenthesis depth inside a $( )]
+    pending: list[tuple[str, bool]] = []  # heredoc (delimiter, tabs allowed before it) waiting for the end of the line
+    i, n = 0, len(text)
+    line_start = 0
+    next_dparen = text.find("((")  # position of the next `((` at or after this line: found once per line, not per `<<`
+    unended = False
+    while i < n:
+        ch = text[i]
+        mode, depth = stack[-1]
+        if ch == "\n":
+            out.append("\n")
+            i += 1
+            line_start = i
+            if pending and mode == "code":  # blank the heredoc body, up to and including its end line
+                while pending:
+                    word, tabs = pending.pop(0)
+                    found_end = False
+                    while i < n:
+                        end = text.find("\n", i)
+                        end = n if end < 0 else end
+                        line = text[i:end]
+                        out.append(" " * len(line) + ("\n" if end < n else ""))
+                        i = min(end + 1, n)
+                        line_start = i
+                        if (line.lstrip("\t") if tabs else line) == word:
+                            found_end = True
+                            break
+                    unended = unended or not found_end
+            continue
+        if mode == "sq":
+            if ch == "'":
+                stack.pop()
+            out.append("_")
+        elif mode == "ansic":  # $'...' honours backslash escapes
+            if ch == "\\" and i + 1 < n and text[i + 1] != "\n":
+                out.append("  ")
+                i += 2
+                continue
+            if ch == "'":
+                stack.pop()
+            out.append("_")
+        elif mode == "dq":
+            if ch == "\\" and i + 1 < n and text[i + 1] != "\n":
+                out.append("__")
+                i += 2
+                continue
+            if ch == '"':
+                stack.pop()
+                out.append("_")
+            elif text.startswith("$(", i) and not text.startswith("$((", i):
+                stack.append(["code", 1])
+                out.append("_(")
+                i += 2
+                continue
+            elif ch == "`":
+                stack.append(["bt", 0])
+                out.append("`")
+            else:
+                out.append("_")
+        else:  # code, command substitution ("code" with a depth) or backticks ("bt")
+            if ch == "\\" and i + 1 < n and text[i + 1] != "\n":
+                out.append("  ")
+                i += 2
+                continue
+            if ch == "'":
+                stack.append(["sq", 0])
+                out.append("_")
+            elif text.startswith("$'", i):
+                stack.append(["ansic", 0])
+                out.append("__")
+                i += 2
+                continue
+            elif ch == '"':
+                stack.append(["dq", 0])
+                out.append("_")
+            elif ch == "#" and (i == line_start or text[i - 1] in " \t;"):
+                end = text.find("\n", i)
+                end = n if end < 0 else end
+                out.append(" " * (end - i))
+                i = end
+                continue
+            elif ch == "`" and mode == "bt":
+                stack.pop()
+                out.append("`")
+            elif text.startswith("$(", i) and not text.startswith("$((", i):
+                stack.append(["code", 1])
+                out.append("$(")
+                i += 2
+                continue
+            elif ch == "(" and depth:
+                stack[-1][1] = int(depth) + 1  # type: ignore[call-overload]
+                out.append(ch)
+            elif ch == ")" and depth:
+                if depth == 1:
+                    stack.pop()
+                else:
+                    stack[-1][1] = int(depth) - 1  # type: ignore[call-overload]
+                out.append(ch)
+            elif text.startswith("<<<", i):  # a here-string: all three characters, never a heredoc
+                out.append("<<<")
+                i += 3
+                continue
+            elif text.startswith("<<", i):
+                if next_dparen != -1 and next_dparen < line_start:
+                    next_dparen = text.find("((", line_start)
+                found = _HEREDOC.match(text, i)
+                if found and not (next_dparen != -1 and next_dparen + 2 <= i):  # no `((` earlier on this line
+                    delimiter = _QUOTE_MARKS.sub(lambda m: m.group(1) or m.group(2) or m.group(3) or "", found.group(2))
+                    pending.append((delimiter, found.group(1) == "-"))
+                out.append("<<")
+                i += 2
+                continue
+            else:
+                out.append(ch)
+        i += 1
+    return "".join(out), len(stack) > 1 or unended or bool(pending)
+
+
+def _code_only(text: str) -> str:
+    return _scan(text)[0]
+
+
+# a single `[` followed by a blank, where a command can start: line start, after ; & | { ( ` or a `)` that is not
+# the end of `))`, after the words if, then, elif, else, while, until, do, command, time, exec, optionally after `!`.
+# `[[`, `]]`, arrays and `[1]` do not match. `test ...` is not looked for (see NOTES: the rule is about `[`).
+_SINGLE_BRACKET = re.compile(
+    r"(?:^|[;&|{(`]|(?<!\))\)|\b(?:if|then|elif|else|while|until|do|command|time|exec))[ \t]*(?:![ \t]*)?\[[ \t]",
+    re.MULTILINE,
+)
+
+
+# the inside of a `[[ ... ]]` (no `;`, at most 400 characters, so a missing `]]` cannot hide the rest of the file):
+# a regular expression there may hold `|[ ]` or `[ ]`, which is not a test
+_DOUBLE_BRACKET = re.compile(r"\[\[[ \t][^;]{0,400}?[ \t]\]\]")
+
+
+def _single_bracket_lines(shell_text: str) -> list[int]:
+    """Line numbers of a `[ ` test. A line that continues the one before (the previous code line ends in a backslash)
+    is read as part of it: `echo a \\` then `  [ -e x ]` is an argument, `cmd && \\` then `[ -e x ]` is a test."""
+    code = _DOUBLE_BRACKET.sub(lambda m: re.sub(r"[^\n]", " ", m.group(0)), _code_only(shell_text))
+    flat_parts: list[str] = []
+    starts: list[int] = []  # offset in the joined text where each physical line begins
+    pos = 0
+    for line in code.split("\n"):
+        starts.append(pos)
+        part = line[:-1] + " " if line.endswith("\\") else line + "\n"
+        flat_parts.append(part)
+        pos += len(part)
+    flat = "".join(flat_parts)
+    lines: set[int] = set()
+    for m in _SINGLE_BRACKET.finditer(flat):
+        bracket = flat.index("[", m.start(), m.end())
+        lines.add(bisect.bisect_right(starts, bracket))
+    return sorted(lines)
+
+
+@pytest.mark.parametrize(
+    ("snippet", "caught"),
+    [
+        ("if [ -e x ]; then echo y; fi", True),
+        ("[ -e x ] && echo y", True),
+        ("echo a; [ -e x ]", True),
+        ('while [ "$i" -lt 3 ]; do :; done', True),
+        ('for f in a b; do [ -e "$f" ] || echo "$f"; done', True),
+        ("case x in a) [ -e y ];; esac", True),
+        ("if [\t-e x ]; then :; fi", True),
+        ("! [ -e x ]", True),
+        ("x=$( [ -e y ] && echo 1 )", True),
+        ('x="$( [ -e y ] && echo 1 )"', True),  # inside double quotes
+        ('echo "$(if [ -e x ]; then echo 1; fi)"', True),
+        ('echo "a $(echo "b $( [ -e x ] )" )"', True),  # nested
+        ("x=`[ -e y ]`", True),
+        ('x="`[ -e y ]`"', True),
+        ("command [ -e x ]", True),
+        ("time [ -e x ]", True),
+        ("echo it\\'s ; [ -e x ]", True),  # an escaped quote does not open a string
+        ('echo "a \\" b" ; [ -e x ]', True),
+        ("echo $'it\\'s' ; [ -e x ]", True),
+        ("x=$(( 1 + 2 )); [ -e x ]", True),
+        ("then [ -e x ]", True),
+        ("else [ -e x ]", True),
+        ("if [[ -e x ]]; then :; fi", False),
+        ('[[ -e x ]] && [[ -n "$y" ]]', False),
+        ('for f in a b; do [[ -e "$f" ]] || echo "$f"; done', False),
+        ('arr=(a [1]=b); echo "${arr[1]}" "${a[ 2 ]}"', False),
+        ("grep -E 'a|[ ]b' file", False),
+        ('sed -e "s/[ \t]*$//" file', False),
+        ("awk '/^[ ]*#/ {print}' file", False),
+        ("echo hi  # if [ -e x ] is the old way", False),
+        ('echo "write [ -e x ] as [[ -e x ]]"', False),
+        ("cat <<EOF\n[ -e x ]\nEOF\n[[ -e x ]]", False),  # heredoc body
+        ("cat <<-'EOF'\n\t[ -e x ]\n\tEOF", False),
+        ("cat <<EOF\n[ -e x ]\nEOF\n[ -e y ]", True),  # code after the heredoc is scanned again
+        ('echo "a\n[ -e x ]\nb"', False),  # a multi-line string
+        ("x=$(( 1 + 2 )) [ ", False),  # `)` of `))` is not a command start
+        ("echo $(( 1 << 2 )); [ -e x ]", True),  # a shift is not a heredoc
+        ("echo 'a' 'b [ -e x ] c'", False),
+        ("exec [ -e x ]", True),
+        # here-strings are not heredocs: the lines after them are still scanned
+        ('grep -q a <<< "abc"\n[ -e x ]\n', True),
+        ('grep -q a <<<"abc"\n[ -e x ]\n', True),
+        ("grep -q a <<< 'abc'\n[ -e x ]\n", True),
+        ("cat <<< abc\n[ -e x ]\n", True),
+        ("cat <<<abc\n[ -e x ]\n", True),
+        ('x=$(cat <<< "abc")\n[ -e x ]\n', True),
+        ("cat <<< 'x' <<EOF\nb\nEOF\n[ -e x ]", True),  # a here-string, then a real heredoc
+        ("cat <<< 'x' <<EOF\n[ -e x ]\nEOF\n[[ -e x ]]", False),
+        # heredoc delimiters are any shell word
+        ("cat <<'E-1'\n[ -e x ]\nE-1\n[ -e y ]", True),
+        ("cat <<E.1\n[ -e x ]\nE.1\n[ -e y ]", True),
+        ('cat <<"E 1"\n[ -e x ]\nE 1\n[ -e y ]', True),
+        ("cat <<\\E-1\n[ -e x ]\nE-1\n[ -e y ]", True),
+        ("cat <<-E.1\n\t[ -e x ]\n\tE.1\n[ -e y ]", True),
+        ("cat <<1\n[ -e x ]\n1\n[ -e y ]", True),
+        ("cat <<E-1\n[ -e x ]\nE-1\n[[ -e y ]]", False),
+        ("cat <<EOF\n[ -e x ]\n  EOF\nEOF\n[ -e y ]", True),  # an end line is exact: leading blanks do not end it
+        ("cat <<-EOF\n[ -e x ]\n\t\tEOF\n[ -e y ]", True),  # `<<-` strips leading tabs only
+        # quoted text is not a test, and is not turned into blanks that look like one
+        ('declare -A m=(["a"]=1 ["b c"]=2)', False),
+        ('m=(\n  ["k"]=v\n)', False),
+        ("declare -A m=(['a']=1 ['b c']=2)", False),
+        ("declare -A m=([$'a b']=1)", False),
+        ("[[ $x =~ a|[ ]b ]]", False),
+        ("[[ $x =~ 'a'|[ ] ]]", False),
+        ("[[ $x =~ a|[ ]b ]] && [ -e y ]", True),  # a real test after the [[ ]] is still seen
+        ("echo a \\\n  [ -e x ]", False),  # a continuation line that starts with `[ ` is an argument
+        ("cmd && \\\n  [ -e x ]", True),  # but after && it is a test
+        ("if \\\n  [ -e x ]; then :; fi", True),
+    ],
+)
