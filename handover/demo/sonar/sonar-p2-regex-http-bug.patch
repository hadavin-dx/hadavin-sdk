diff --git a/src/lead_desk/urls.py b/src/lead_desk/urls.py
new file mode 100644
index 0000000..4ca46ef
--- /dev/null
+++ b/src/lead_desk/urls.py
@@ -0,0 +1,19 @@
+"""The one place that writes the address of the desk or of its stand-ins.
+
+The desk and the stand-ins speak plain HTTP on purpose: they run on this computer and listen on a loopback address
+(`Config.public_bind_problem` refuses a public bind when a real service is in use; `Config.problem` refuses a stand-ins
+host that is not loopback). Nothing is sent over a network, so there is nothing to encrypt. The scheme is therefore
+named once here, with this reason, and every address is built from it; no file writes the clear-text scheme as a
+literal, so a clear-text address elsewhere in the code stands out as a mistake."""
+
+from __future__ import annotations
+
+from typing import Final
+
+DESK_SCHEME: Final = "http"  # loopback only: see the module text
+
+
+def desk_origin(host: str, port: int | str) -> str:
+    """scheme://host:port with no path. `host` is a bind or stand-ins host as the configuration holds it (an IPv6
+    address keeps its brackets)."""
+    return f"{DESK_SCHEME}://{host}:{port}"
diff --git a/tests/test_sonar_p2_choke_points.py b/tests/test_sonar_p2_choke_points.py
new file mode 100644
index 0000000..e40ec51
--- /dev/null
+++ b/tests/test_sonar_p2_choke_points.py
@@ -0,0 +1,309 @@
+"""Sonar fixes, patch P2: patterns that cost n squared steps on a long text (S8786), clear-text addresses written as
+literals (S5332), a request address taken from the command line (S8703), and a flag filled by an inner function
+(S2583). Timing tests use a long text that took seconds on the old pattern and take milliseconds on the new one, with
+a bound of half a second; equivalence tests compare the new pattern with the old one on every short text of a small
+alphabet. Every address and e-mail value is built from parts. Made-up data only."""
+
+from __future__ import annotations
+
+import importlib
+import ipaddress
+import itertools
+import re
+import socket
+import sys
+import time
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import FakeClock, lead
+from test_mirror_gate import _Crm, _flow, _sql, _tries
+
+from lead_desk import identity, server, urls
+from lead_desk.config import Config
+from lead_desk.constants import LOOPBACK_HOSTS
+from lead_desk.desk import _StageMove
+from tools import scrub_n8n_export as scrub
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+rrc = importlib.import_module("run_real_check")
+feed = importlib.import_module("feed")
+
+LONG = 40_000  # the old patterns took 3 to 30 seconds here
+BOUND_SECONDS = 0.5
+AT = "@"
+DOT = "."
+
+# the patterns as they were before the patch (the reference for the equivalence tests)
+OLD_ADDRESS = re.compile(r"[^\s,;:<>\"']+@[^\s,;<>\"']+")
+OLD_PLAIN = re.compile(r'^[^\s<>\r\n\x00,;"()]+@[^\s<>\r\n\x00,;"()]+$')
+OLD_EMAIL = re.compile(r"[^@\s<>\",;]+@[^@\s<>\"',;]+\.[^@\s<>\"',;]+")
+OLD_MAIL = re.compile(
+    r"(?<![\w.%+-])[\w.%+-]+[@＠](?!(?:[\w-]+\.)*example\.(?:com|test|invalid)(?![\w-]|\.[\w-]))[\w.-]+"
+)
+
+
+def _seconds(fn: Callable[[], object]) -> float:
+    start = time.perf_counter()
+    fn()
+    return time.perf_counter() - start
+
+
+# -- S8786: time ---------------------------------------------------------------------------------------------
+
+
+def test_run_real_check_address_pattern_is_linear_on_a_long_run_without_an_at_sign() -> None:
+    assert _seconds(lambda: rrc._ADDRESS.sub("x", "a" * LONG)) < BOUND_SECONDS
+    assert _seconds(lambda: rrc._ADDRESS.sub("x", ("a" + AT) * LONG)) < BOUND_SECONDS
+
+
+def test_plain_address_pattern_is_linear_when_the_text_ends_in_a_blank() -> None:
+    assert _seconds(lambda: identity.PLAIN_ADDRESS.fullmatch(("a" + AT) * (LONG // 2) + " ")) < BOUND_SECONDS
+    assert _seconds(lambda: identity.PLAIN_ADDRESS.fullmatch(AT * LONG + " ")) < BOUND_SECONDS
+
+
+def test_email_pattern_is_linear_on_a_domain_with_many_dots_and_a_bad_end() -> None:
+    domain = "b" + DOT
+    assert _seconds(lambda: identity._EMAIL_RE.fullmatch("a" + AT + domain * (LONG // 2) + " ")) < BOUND_SECONDS
+    assert _seconds(lambda: identity._EMAIL_RE.fullmatch("a" * LONG + AT + "b" * LONG)) < BOUND_SECONDS
+
+
+def test_scrub_mail_pattern_stays_linear() -> None:
+    """The old pattern was already fast on every text tried (no slow input was found); this pins the new one."""
+    labels = "a" + DOT
+    texts = [
+        "a" + AT + labels * (LONG // 2) + " ",
+        ("a" + AT + labels * 200 + "example" + DOT + "com" + DOT + " ") * (LONG // 400),
+        "a" + AT + ("example" + DOT) * (LONG // 8) + "x",
+        ("a" + AT) * LONG,
+    ]
+    for text in texts:
+        assert _seconds(lambda text=text: scrub.MAIL.sub("x", text)) < BOUND_SECONDS
+
+
+# -- S8786: same results -------------------------------------------------------------------------------------
+
+
+def _same(old: re.Pattern[str], new: re.Pattern[str], how: str, alphabet: list[str], longest: int) -> int:
+    seen = 0
+    for n in range(longest + 1):
+        for parts in itertools.product(alphabet, repeat=n):
+            text = "".join(parts)
+            if how == "fullmatch":
+                a, b = bool(old.fullmatch(text)), bool(new.fullmatch(text))
+            else:
+                a, b = old.sub("<>", text), new.sub("<>", text)
+            assert a == b, (text, a, b)
+            seen += 1
+    return seen
+
+
+def test_run_real_check_address_pattern_finds_the_same_addresses() -> None:
+    alphabet = ["a", AT, DOT, " ", ":", ",", "\n"]
+    assert _same(OLD_ADDRESS, rrc._ADDRESS, "sub", alphabet, 7) > 100_000
+
+
+def test_plain_address_pattern_accepts_the_same_texts() -> None:
+    alphabet = ["a", AT, DOT, " ", "(", "\n"]
+    assert _same(OLD_PLAIN, identity.PLAIN_ADDRESS, "fullmatch", alphabet, 7) > 50_000
+
+
+def test_email_pattern_accepts_the_same_texts() -> None:
+    alphabet = ["a", AT, DOT, " ", "'", ","]
+    assert _same(OLD_EMAIL, identity._EMAIL_RE, "fullmatch", alphabet, 7) > 50_000
+
+
+def test_scrub_mail_pattern_replaces_the_same_texts() -> None:
+    alphabet = ["a", AT, DOT, "-", "example" + DOT, "com", "test", " ", "＠"]
+    assert _same(OLD_MAIL, scrub.MAIL, "sub", alphabet, 5) > 50_000
+    for text in (
+        "x" + AT + "example" + DOT + "com",  # the allowed name: left alone
+        "x" + AT + "a" + DOT + "example" + DOT + "invalid",  # a sub-domain of it: left alone
+        "x" + AT + "example" + DOT + "com" + DOT + "evil",  # the allowed name as a front part of another: replaced
+        "x" + AT + "notexample" + DOT + "com",  # a different name that ends the same: replaced
+        "x" + AT + "example" + DOT + "com" + DOT,  # a trailing dot: left alone
+        "first" + DOT + "last" + AT + "corp" + DOT + "test, and y" + AT + "example" + DOT + "test",
+    ):
+        assert OLD_MAIL.sub("<>", text) == scrub.MAIL.sub("<>", text)
+
+
+def test_ordinary_addresses_still_match() -> None:
+    mail = "jane" + DOT + "doe" + AT + "corp" + DOT + "test"
+    assert rrc._ADDRESS.sub("<address>", "write to " + mail + ", thanks") == "write to <address>, thanks"
+    assert identity.PLAIN_ADDRESS.fullmatch(mail) and identity._EMAIL_RE.fullmatch(mail)
+    assert not identity._EMAIL_RE.fullmatch("jane" + AT + "corp") and not identity.PLAIN_ADDRESS.fullmatch("jane")
+
+
+# -- S5332: one place writes the clear-text scheme -----------------------------------------------------------
+
+
+def test_no_source_file_writes_a_clear_text_address_with_a_host_in_braces() -> None:
+    """An f-string address that starts with the clear-text scheme and names its host in braces is how a public host
+    could slip in unseen; lead_desk.urls is the one place that writes the scheme."""
+    pattern = re.compile("f[\"']" + "http" + "://" + r"\{")
+    hits = [
+        f"{path.relative_to(REPO)}:{n}"
+        for folder in ("src", "scripts", "tools")
+        for path in sorted((REPO / folder).rglob("*.py"))
+        for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1)
+        if pattern.search(line)
+    ]
+    assert hits == []
+
+
+def test_desk_origin_and_the_addresses_built_from_it() -> None:
+    assert urls.desk_origin("127.0.0.1", 8765) == "http" + "://127.0.0.1:8765"
+    assert urls.desk_origin("[::1]", "80") == "http" + "://[::1]:80"
+    cfg = Config(fakes_host="127.0.0.1", fakes_port=5001)
+    assert cfg.fakes_url == urls.desk_origin("127.0.0.1", 5001)
+
+
+# -- S5332 on the HTTP server: the bind rule lives in its own class ------------------------------------------
+
+
+def test_the_windows_exclusive_bind_is_set_before_the_http_server_binds(monkeypatch: pytest.MonkeyPatch) -> None:
+    assert server._Server.__mro__.index(server._ExclusiveBind) < server._Server.__mro__.index(
+        server.ThreadingHTTPServer
+    )
+    calls: list[tuple[int, int, int]] = []
+    option = 0x7FFF0001  # not a real option on this computer: the recorder takes it and does not pass it on
+    real = socket.socket.setsockopt
+
+    def record(self: socket.socket, level: int, name: int, value: Any, *rest: Any) -> None:
+        if name == option:
+            calls.append((level, name, value))
+            return
+        real(self, level, name, value, *rest)  # type: ignore[call-overload]
+
+    monkeypatch.setattr(socket.socket, "setsockopt", record)
+    monkeypatch.setattr(socket, "SO_EXCLUSIVEADDRUSE", option, raising=False)
+    monkeypatch.setattr(server.sys, "platform", "win32")
+    srv = server._Server(("127.0.0.1", 0), server._Handler)
+    try:
+        assert calls == [(socket.SOL_SOCKET, option, 1)]
+        assert srv.server_address[1] > 0 and srv.server_name  # the HTTP server's own bind step still ran
+    finally:
+        srv.server_close()
+
+
+def test_the_exclusive_bind_is_not_set_off_windows() -> None:
+    srv = server._Server(("127.0.0.1", 0), server._Handler)
+    try:
+        assert srv.server_address[1] > 0
+    finally:
+        srv.server_close()
