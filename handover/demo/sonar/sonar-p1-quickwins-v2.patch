+
+
+# the Unicode direction controls that can make source code read differently from how it runs ("Trojan Source"):
+# U+202A..U+202E (embeddings, overrides), U+2066..U+2069 (isolates), U+200E, U+200F and U+061C (direction marks)
+_BIDI = re.compile("[\u202a-\u202e\u2066-\u2069\u200e\u200f\u061c]")
+
+
+def test_no_tracked_file_holds_a_raw_direction_control_character() -> None:
+    """A test that needs such a character builds it from an escape (\\u202e) so the file itself holds none
+    (SonarCloud rule text:S6389; the same attack as CVE-2021-42574)."""
+    offenders = []
+    for rel in _git(REPO, "ls-files").splitlines():
+        path = REPO / rel
+        if not rel or not path.is_file():
+            continue
+        try:
+            text = path.read_text(encoding="utf-8")
+        except UnicodeDecodeError:
+            continue  # a binary file (image, font): not text
+        offenders += [
+            f"{rel}:{n}" for n, line in enumerate(text.split("\n"), 1) if _BIDI.search(line)
+        ]  # split on \n only: splitlines() also cuts at U+2028
+    assert not offenders, f"raw direction control characters in: {offenders}"
+
+
+def test_the_direction_control_pattern_sees_each_character() -> None:
+    for code in (0x202A, 0x202B, 0x202C, 0x202D, 0x202E, 0x2066, 0x2067, 0x2068, 0x2069, 0x200E, 0x200F, 0x061C):
+        assert _BIDI.search("a" + chr(code) + "b"), hex(code)
+    assert not _BIDI.search("plain text \u200d joiner and \u200b space are not direction controls")
+
+
+def _code_only(text: str) -> str:
+    """Shell text with quoted strings blanked and # comments removed, line by line (a crude scan, enough to tell a
+    test command from a regex character class inside quotes). Heredoc bodies are not recognised."""
+    out = []
+    for line in text.split("\n"):
+        kept, quote = [], ""
+        for i, ch in enumerate(line):
+            if quote:
+                if ch == quote:
+                    quote = ""
+                kept.append(" ")
+            elif ch in "'\"":
+                quote = ch
+                kept.append(" ")
+            elif ch == "#" and (i == 0 or line[i - 1] in " \t;"):
+                break
+            else:
+                kept.append(ch)
+        out.append("".join(kept))
+    return "\n".join(out)
+
+
+# a single `[` followed by a blank, where a command can start: line start, after ; & | { ( ) (a case pattern or a
+# group), after the words if/then/elif/else/while/until/do, optionally after `!`.
+# `[[`, `]]`, arrays and `[1]` do not match.
+_SINGLE_BRACKET = re.compile(r"(?:^|[;&|{()]|\b(?:if|then|elif|else|while|until|do))[ \t]*(?:![ \t]*)?\[[ \t]")
+
+
+def _single_bracket_lines(shell_text: str) -> list[int]:
+    return [n for n, line in enumerate(_code_only(shell_text).split("\n"), 1) if _SINGLE_BRACKET.search(line)]
+
+
+@pytest.mark.parametrize(
+    ("snippet", "caught"),
+    [
+        ("if [ -e x ]; then echo y; fi", True),
+        ("[ -e x ] && echo y", True),
+        ("echo a; [ -e x ]", True),
+        ('while [ "$i" -lt 3 ]; do :; done', True),
+        ('for f in a b; do [ -e "$f" ] || echo "$f"; done', True),
+        ("case x in a) [ -e y ];; esac", True),
+        ("if [\t-e x ]; then :; fi", True),
+        ("! [ -e x ]", True),
+        ("x=$( [ -e y ] && echo 1 )", True),
+        ("then [ -e x ]", True),
+        ("else [ -e x ]", True),
+        ("if [[ -e x ]]; then :; fi", False),
+        ('[[ -e x ]] && [[ -n "$y" ]]', False),
+        ('for f in a b; do [[ -e "$f" ]] || echo "$f"; done', False),
+        ('arr=(a [1]=b); echo "${arr[1]}" "${a[ 2 ]}"', False),
+        ("grep -E 'a|[ ]b' file", False),
+        ('sed -e "s/[ \t]*$//" file', False),
+        ("awk '/^[ ]*#/ {print}' file", False),
+        ("echo hi  # if [ -e x ] is the old way", False),
+        ('echo "write [ -e x ] as [[ -e x ]]"', False),
+    ],
+)
+def test_the_single_bracket_pattern_catches_real_tests_and_nothing_else(snippet: str, caught: bool) -> None:
+    assert bool(_single_bracket_lines(snippet)) is caught, snippet
+
+
+def _run_blocks(workflow: Path) -> list[str]:
+    doc = yaml.safe_load(workflow.read_text(encoding="utf-8"))
+    return [
+        step["run"]
+        for job in doc.get("jobs", {}).values()
+        for step in job.get("steps", [])
+        if isinstance(step.get("run"), str)
+    ]
+
+
+def test_sh_scripts_and_workflow_run_blocks_use_double_brackets_for_tests() -> None:
+    """bash's [[ ]] does not split words or expand patterns inside the test (SonarCloud rule shell:S7688). Every
+    tracked .sh file starts with a bash shebang, and a workflow `run:` block runs under bash (the runner default on
+    Linux; a `shell:` key other than bash would fail this test)."""
+    names = [n for n in _git(REPO, "ls-files", "*.sh").splitlines() if n]
+    assert names, "no shell scripts found: the test would prove nothing"
+    bad: list[str] = []
+    for n in names:
+        text = (REPO / n).read_text(encoding="utf-8")
+        assert text.startswith("#!/usr/bin/env bash\n"), f"{n}: not a bash script"
+        bad += [f"{n}:{i}" for i in _single_bracket_lines(text)]
+    flows = sorted((REPO / ".github" / "workflows").glob("*.yml"))
+    assert flows, "no workflow files found: the test would prove nothing"
+    blocks = 0
+    for flow in flows:
+        doc = yaml.safe_load(flow.read_text(encoding="utf-8"))
+        for job in doc.get("jobs", {}).values():
+            assert job.get("defaults", {}).get("run", {}).get("shell", "bash") == "bash", flow.name
+            for step in job.get("steps", []):
+                assert step.get("shell", "bash") == "bash", f"{flow.name}: {step.get('name')}"
+        for block in _run_blocks(flow):
+            blocks += 1
+            bad += [f"{flow.name} run-block line {i}" for i in _single_bracket_lines(block)]
+    assert blocks, "no run blocks found: the test would prove nothing"
+    assert not bad, f"single-bracket test in: {bad}"
