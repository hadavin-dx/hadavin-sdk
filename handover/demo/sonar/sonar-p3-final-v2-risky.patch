+def _fake_listing(monkeypatch: pytest.MonkeyPatch, entries: list[Any]) -> None:
+    """Make ``os.scandir`` (as the helper sees it) return these entries, as a context manager like the real one."""
+
+    class Listing:
+        def __enter__(self) -> list[Any]:
+            return entries
+
+        def __exit__(self, *exc: object) -> None:
+            return None
+
+    monkeypatch.setattr(pc.os, "scandir", lambda path=".": Listing())
