+def test_a_written_file_is_never_found_by_its_loose_name_so_a_new_nfc_name_cannot_overwrite_an_nfd_file(
+    jail: tuple[Path, Path],
+) -> None:
+    """Decision (rv34 NIT-6): on Linux the NFC and the NFD spelling are two different files; a NEW name typed in one
+    form must not write into the file stored in the other. A written file must be named as the listing shows it."""
+    inside, _ = jail
+    nfd = unicodedata.normalize("NFD", "café.json")
+    nfc = unicodedata.normalize("NFC", "café.json")
+    try:
+        (inside / nfd).write_text("keep me", encoding="utf-8")
+        folds = (inside / nfc).exists()
+    except OSError:
+        pytest.skip("this file system cannot store these names")
+    if folds:
+        pytest.skip("this file system folds the two Unicode forms itself")
+    with pytest.raises(pc.PathRefused, match="differs only in Unicode form or case"):
+        pc.confine(inside / nfc, what="--facts")
+    assert pc.confine(inside / nfd, what="--facts") == inside.resolve() / nfd  # the exact name still works
+    assert (inside / nfd).read_text(encoding="utf-8") == "keep me" and not (inside / nfc).exists()
+    assert pc.confine_existing(inside / nfc, what="--facts") == inside.resolve() / nfd  # a read finds it
+    nfd_dir = unicodedata.normalize("NFD", "dossié")
+    (inside / nfd_dir).mkdir()  # a FOLDER on the way is still found loosely: nothing is overwritten by that
+    typed_dir = unicodedata.normalize("NFC", "dossié")
+    assert pc.confine(inside / typed_dir / "new.json", what="--facts") == inside.resolve() / nfd_dir / "new.json"
+
+
