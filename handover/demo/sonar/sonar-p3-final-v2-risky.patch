+    _fake_listing(monkeypatch, [_entry(nfd, "/x/" + nfd)])
+    with pytest.raises(pc.PathRefused, match="differs only"):
+        pc._locate("/x", [nfc], "f")
+    assert pc._locate_existing("/x", [nfc], "f") == "/x/" + nfd
+    _fake_listing(monkeypatch, [_entry(nfd, "/x/" + nfd), _entry(nfc, "/x/" + nfc)])
+    assert pc._locate("/x", [nfc], "f") == "/x/" + nfc  # the exact name exists too: it wins and is accepted
+
