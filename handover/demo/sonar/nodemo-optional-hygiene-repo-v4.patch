     left = hygiene.pipeline(REPO, patterns, exceptions)
     assert not left, "hardcoded literals found (file:line:match):\n" + "\n".join(left[:50])
     # 3. gitleaks (release binary; CI installs it with a checked SHA-256)
@@ -478,3 +480,40 @@ def test_a_gitleaks_bin_path_that_does_not_exist_is_a_clear_error_naming_the_var
         with pytest.raises(ValueError, match=GITLEAKS_ENV) as e:
             _gitleaks_exe()
         assert "does not exist" in str(e.value)
+
+
+def test_git_work_tree_skip_is_for_this_repository_only_and_accepts_a_git_file(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The skip fires only when REPO has no `.git` at all and only for calls about REPO. `.git` may be a folder (a
+    clone) or a FILE (a git worktree or a submodule): both are work trees. The temp repositories the other tests build
+    are never skipped. Pinned with REPO pointed at folders made here, so it holds in a copy with or without .git."""
+    import _repo_root  # the module itself, to point its REPO at the folders made here
+
+    bare = tmp_path / "archive"
+    bare.mkdir()
+    folder = tmp_path / "clone"
+    (folder / ".git").mkdir(parents=True)
+    other = tmp_path / "other"  # a repository a test builds: not REPO
+    other.mkdir()
+    # the set-up below runs with a REPO that has a .git, so no skip can get in its way
+    monkeypatch.setattr(_repo_root, "REPO", folder)
+    # a real linked worktree: its .git is a file that points at the main repository
+    main = tmp_path / "main"
+    main.mkdir()
+    ident = ["-c", "user.name=t", "-c", "user.email=t@example.test"]
+    _git(main, "init", "-q")
+    _git(main, *ident, "commit", "-q", "--allow-empty", "-m", "m")
+    linked = tmp_path / "linked"
+    _git(main, "worktree", "add", "-q", str(linked))
+    assert (linked / ".git").is_file()
+
+    monkeypatch.setattr(_repo_root, "REPO", bare)
+    assert skipped(need_git_work_tree)
+    assert skipped(_git, bare, "--version")  # about REPO and REPO has no repository: skipped by name
+    assert not skipped(_git, other, "--version")  # not about REPO: runs even though REPO has no .git
+    monkeypatch.setattr(_repo_root, "REPO", folder)
+    assert not skipped(need_git_work_tree)
+    monkeypatch.setattr(_repo_root, "REPO", linked)
+    assert not skipped(need_git_work_tree)  # .git as a file is a work tree
+    assert not skipped(_git, linked, "ls-files")  # and git really works there
