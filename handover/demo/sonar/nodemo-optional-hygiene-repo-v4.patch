diff --git a/tests/_repo_root.py b/tests/_repo_root.py
new file mode 100644
index 0000000..c21c3ef
--- /dev/null
+++ b/tests/_repo_root.py
@@ -0,0 +1,35 @@
+"""The repository folder, found from this file, and the git work-tree check the hygiene tests share.
+
+`support.py` needs the demo_only folder, which a client copy does not have, so the two hygiene test files take the
+repository folder from here instead. A copy made from an archive (or with .git removed) has no repository: the tests
+that list this repository's files with git are skipped by name there, not failed."""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+REPO = Path(__file__).resolve().parent.parent
+
+
+def need_git_work_tree() -> None:
+    """Skip the running test when REPO has no `.git` (a folder in a clone, a file in a worktree or a submodule)."""
+    if not (REPO / ".git").exists():
+        pytest.skip("not a git work tree (a source archive): git cannot list the files")
+
+
+def need_git_work_tree_for(cwd: Path) -> None:
+    """The same skip, only when the git call is about REPO itself: the temp repositories the tests build are not."""
+    if cwd == REPO:
+        need_git_work_tree()
+
+
+def skipped(call: Any, *args: Any) -> bool:
+    """True when calling it ends the test as skipped (the skip exception is caught here, for the tests of the skip)."""
+    try:
+        call(*args)
+    except pytest.skip.Exception:
+        return True
+    return False
