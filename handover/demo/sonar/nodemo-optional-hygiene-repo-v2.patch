+REPO = Path(__file__).resolve().parent.parent  # not from support, which needs demo_only/
+
 SRC = REPO / "src"
@@ -42,7 +43,16 @@ def _gitleaks_exe() -> str | None:
     return path
 
 
+def _need_git_work_tree() -> None:
+    """A copy made from an archive (or with .git removed) has no repository: the tests that list this repository's files
+    with git are skipped by name there, not failed."""
+    if not (REPO / ".git").exists():
+        pytest.skip("not a git work tree (a source archive): git cannot list the files")
+
+
 def _git(cwd: Path, *args: str) -> str:
+    if cwd == REPO:
+        _need_git_work_tree()
     p = subprocess.run(  # noqa: S603
         ["git", *args],  # noqa: S607
         cwd=cwd,
@@ -137,6 +147,7 @@ def test_hygiene_scan_public(tmp_path: Path) -> None:
     for pat in hygiene.read_lines(patterns):  # every rule in the file must have a canary that it matches
         assert any(re.search(pat, v) for v in hygiene.CANARIES.values()), f"rule without a canary: {pat}"
     # 2. the real tree
+    _need_git_work_tree()  # the canaries above need no repository; the scan of this tree does
     left = hygiene.pipeline(REPO, patterns, exceptions)
     assert not left, "hardcoded literals found (file:line:match):\n" + "\n".join(left[:50])
     # 3. gitleaks (release binary; CI installs it with a checked SHA-256)
