+++ b/tests/test_probe_p3b.py
@@ -0,0 +1,92 @@
+"""PROBE B: the path guard in check_invariants.read_jsonl (the first S8707 site). Made-up data only.
+Each test below fails on the code before the probe (the reader opened whatever it was given)."""
+
+from __future__ import annotations
+
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from load_tools import check_invariants as ci
+
+ROOTS_ENV = "LEAD_DESK_PATH_ROOTS"
+SECRET = '{"made_up": "outside text"}\n'
+
+
+@pytest.fixture
+def jail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> tuple[Path, Path]:
+    """(inside, outside): the only allowed folder is ``inside``; ``outside`` is next to it and is not allowed."""
+    inside, outside = tmp_path / "inside", tmp_path / "outside"
+    inside.mkdir()
+    outside.mkdir()
+    monkeypatch.chdir(inside)
+    monkeypatch.setattr(tempfile, "tempdir", str(inside))
+    monkeypatch.setattr(ci, "REPO_ROOT", inside, raising=False)  # the repository folder is not allowed here
+    monkeypatch.delenv(ROOTS_ENV, raising=False)
+    return inside, outside
+
+
+def test_reads_an_inside_file_relative_nested_and_odd_names(jail: tuple[Path, Path]) -> None:
+    inside, _ = jail
+    (inside / "sub").mkdir()
+    (inside / "a.jsonl").write_text('{"a": 1}\n', encoding="utf-8")
+    (inside / "sub" / "b?x#y.jsonl").write_text('{"b": 2}\n', encoding="utf-8")
+    assert ci.read_jsonl(Path("a.jsonl")) == [{"a": 1}]
+    assert ci.read_jsonl(inside / "sub" / "b?x#y.jsonl") == [{"b": 2}]
+    assert ci.read_jsonl(Path("sub/../a.jsonl")) == [{"a": 1}]
+
+
+def test_dot_dot_and_absolute_escape_are_refused(jail: tuple[Path, Path]) -> None:
+    _, outside = jail
+    (outside / "secret.jsonl").write_text(SECRET, encoding="utf-8")
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_jsonl(Path("../outside/secret.jsonl"))
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_jsonl(outside / "secret.jsonl")
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="creating a symbolic link needs a privilege on Windows")
+def test_a_link_that_leaves_the_folder_is_refused(jail: tuple[Path, Path]) -> None:
+    inside, outside = jail
+    (outside / "secret.jsonl").write_text(SECRET, encoding="utf-8")
+    (inside / "link.jsonl").symlink_to(outside / "secret.jsonl")
+    (inside / "dirlink").symlink_to(outside, target_is_directory=True)
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_jsonl(inside / "link.jsonl")
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_jsonl(inside / "dirlink" / "secret.jsonl")
+
+
+def test_a_prefix_sibling_folder_is_not_inside(jail: tuple[Path, Path]) -> None:
+    inside, _ = jail
+    evil = inside.parent / (inside.name + "-evil")
+    evil.mkdir()
+    (evil / "f.jsonl").write_text(SECRET, encoding="utf-8")
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_jsonl(evil / "f.jsonl")
+
+
+@pytest.mark.parametrize("bad", ["", "   ", "a\x00b.jsonl", "a\nb.jsonl", "a" * 5000])
+def test_odd_input_is_an_input_error_not_a_crash(jail: tuple[Path, Path], bad: str) -> None:
+    with pytest.raises(ci.InputError):
+        ci.read_jsonl(Path(bad))
+
+
+def test_missing_file_and_folder_are_input_errors(jail: tuple[Path, Path]) -> None:
+    inside, _ = jail
+    (inside / "d").mkdir()
+    with pytest.raises(ci.InputError, match="cannot read"):
+        ci.read_jsonl(inside / "nope.jsonl")
+    with pytest.raises(ci.InputError, match="cannot read"):
+        ci.read_jsonl(inside / "d")
+    with pytest.raises(ci.InputError, match="cannot read"):
+        ci.read_jsonl(inside / "nope" / "x.jsonl")
+
+
+def test_extra_folder_from_the_environment(jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch) -> None:
+    _, outside = jail
+    (outside / "ok.jsonl").write_text('{"ok": 1}\n', encoding="utf-8")
+    monkeypatch.setenv(ROOTS_ENV, str(outside))
+    assert ci.read_jsonl(outside / "ok.jsonl") == [{"ok": 1}]
