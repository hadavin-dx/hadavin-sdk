+def _replace_nth(text: str, old: str, new: str, nth: int) -> str:
+    pieces = text.split(old)
+    assert len(pieces) > nth + 1, (old, "not found in the source: update this mutant table")
+    return old.join(pieces[: nth + 1]) + new + old.join(pieces[nth + 1 :])
+
+
+@pytest.mark.parametrize(
+    ("rel", "func", "helpers", "old", "new", "nth"),
+    _REAL_MUTANTS,
+    ids=[f"{m[0]}:{m[1]}:{m[3][:24]}" for m in _REAL_MUTANTS],
+)
+def test_the_real_sites_changed_to_drop_or_discard_the_helper_result_are_caught(
+    rel: str, func: str, helpers: set[str], old: str, new: str, nth: int
+) -> None:
+    source = (REPO / rel).read_text(encoding="utf-8")
+    assert _unused_result_sinks(_function(source, func), helpers)[1] == [], "the real code must pass first"
+    mutated = _replace_nth(source, old, new, nth)
+    assert mutated != source
+    _, bad = _unused_result_sinks(_function(mutated, func), helpers)
+    assert bad, (rel, func, "a file operation that does not use the helper result went unnoticed")
+
