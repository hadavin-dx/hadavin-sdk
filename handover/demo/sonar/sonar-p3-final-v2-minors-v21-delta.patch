+_FORMAT_NAMES = ("rtl\u202eover.db", "zero\u200bwidth.db", "bom\ufeffhere.db", "sep\u2028line.db")
+_PLACEHOLDER = "(a name with a special character)"
+
+
+def test_a_file_that_passed_the_helper_is_never_named_with_a_special_character(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The helper refuses control characters in a file that is read only; a right-to-left override, a zero-width or a
+    byte-order character passes it, so every message that echoes the base name of a file that exists goes through the
+    same printable check. One case per message."""
+    inside, _ = jail
+    real_read_text = Path.read_text
+
+    def unreadable(self: Path, *args: Any, **kwargs: Any) -> str:
+        if self.name.endswith("unreadable.dat"):
+            raise PermissionError("made up")
+        return real_read_text(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "read_text", unreadable)
+    for name in ("rtl\u202eover", "zero\u200bwidth", "bom\ufeffhere"):
+        cases: list[tuple[str, str, Any]] = [  # (file name, content, the call)
+            ("json.dat", "not json\n", ci.read_jsonl),  # "<name> line 1: not JSON"
+            ("object.dat", "[1]\n", ci.read_jsonl),  # "<name> line 1: not a JSON object"
+            ("unreadable.dat", "x", ci.read_jsonl),  # "cannot read <name>: PermissionError"
+            ("crm-bad.dat", "{", ci.read_crm),  # "cannot read CRM dump <name>"
+            ("crm-shape.dat", "5", ci.read_crm),  # "<name>: expected a list of rows ..."
+            ("book.dat", "not a database", ci.read_book),  # "cannot read book <name>"
+            ("facts.dat", "not json", ci._intended),  # "cannot read the driver facts <name>"
+            ("drain.dat", "not json", ci._drain_marker),  # "cannot read drain marker <name>"
+        ]
+        for suffix, content, call in cases:
+            target = inside / f"{name}-{suffix}"
+            try:
+                target.write_text(content, encoding="utf-8")
+            except OSError:  # a file system that cannot hold this name: nothing to check there
+                break
+            with pytest.raises(ci.InputError) as err:
+                call(target)
+            text = str(err.value)
+            assert text.isprintable() and not {"\u202e", "\u200b", "\ufeff"} & set(text), (suffix, repr(text))
+            assert _PLACEHOLDER in text, (suffix, repr(text))
+        if hasattr(os, "mkfifo"):  # a name that exists but is not a file: "no such book: <name>"
+            fifo = inside / f"{name}-pipe.dat"
+            os.mkfifo(fifo)
+            with pytest.raises(ci.InputError, match="no such book") as err:
+                ci.read_book(fifo)
+            assert _PLACEHOLDER in str(err.value) and str(err.value).isprintable(), repr(str(err.value))
+    for target, call, words in (  # a printable name, accents included, is still named
+        (inside / "plain.dat", ci.read_jsonl, "plain.dat line 1: not JSON"),
+        (inside / "caf\u00e9.dat", ci.read_jsonl, "caf\u00e9.dat line 1: not JSON"),
+    ):
+        target.write_text("not json\n", encoding="utf-8")
+        with pytest.raises(ci.InputError, match=words):
+            call(target)
+
