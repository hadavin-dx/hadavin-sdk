+
+
+# ---------- the call sites: the file operation must USE the helper's RESULT (by AST, flow-sensitive) ----------
+# Dominance (above) proves a helper call ran before the operation. It does not prove the operation uses what the helper
+# returned: ``confine_existing(src)`` as a bare statement followed by ``Path(src).read_text()`` is dominated and still
+# hands the raw argument to the open. This walk follows, statement by statement, which names certainly hold a value that
+# came out of a helper call (or was derived from one: a method, an attribute, a ``/`` join, ``Path(str(x))``), and
+# requires the operation's receiver (or its first argument, for ``open(...)`` and ``connect(...)``) to be rooted in
+# such a name, or in a helper call written inside the operation itself, on EVERY path to it.
+# Limits, on purpose: a call of any other function is read as "derived from its first argument or its receiver"; the
+# right operand of ``/`` is not checked; a name captured by a nested function is read at the definition.
+
+_State = frozenset[str] | None  # None: the point cannot be reached (after a return or a raise)
+
+
+def _join(a: _State, b: _State) -> _State:
+    return b if a is None else a if b is None else a & b
+
+
+def _is_clean(e: ast.AST | None, state: frozenset[str], helpers: set[str]) -> bool:
+    """True when the value of ``e`` is the result of a helper call or is derived from one held in ``state``."""
+    if e is None:
+        return False
+    if isinstance(e, ast.Name):
+        return e.id in state
+    if isinstance(e, (ast.Attribute, ast.Subscript, ast.Starred)):
+        return _is_clean(e.value, state, helpers)
+    if isinstance(e, ast.NamedExpr):
+        return _is_clean(e.value, state, helpers)
+    if isinstance(e, ast.BinOp):
+        return _is_clean(e.left, state, helpers)
+    if isinstance(e, ast.IfExp):
+        return _is_clean(e.body, state, helpers) and _is_clean(e.orelse, state, helpers)
+    if isinstance(e, ast.BoolOp):
+        return all(_is_clean(v, state, helpers) for v in e.values)
+    if isinstance(e, (ast.List, ast.Tuple, ast.Set)):
+        return bool(e.elts) and all(_is_clean(x, state, helpers) for x in e.elts)
+    if isinstance(e, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+        inner = set(state)
+        for gen in e.generators:
+            _bind_names(gen.target, _is_clean(gen.iter, frozenset(inner), helpers), inner)
+        return _is_clean(e.elt, frozenset(inner), helpers)
+    if isinstance(e, ast.Call):
+        if isinstance(e.func, ast.Name) and e.func.id in helpers:
+            return True
+        if isinstance(e.func, ast.Attribute) and _is_clean(e.func.value, state, helpers):
+            return True  # a method of a clean path: with_name, resolve, glob, ...
+        return bool(e.args) and _is_clean(e.args[0], state, helpers)  # Path(x), str(x), readonly_sqlite_uri(x)
+    return False
+
+
+def _names_of(target: ast.AST) -> list[str]:
+    if isinstance(target, ast.Name):
+        return [target.id]
+    if isinstance(target, (ast.Tuple, ast.List)):
+        return [n for t in target.elts for n in _names_of(t)]
+    if isinstance(target, ast.Starred):
+        return _names_of(target.value)
+    return []
+
+
+def _bind(target: ast.AST, value: ast.AST | None, state: set[str], helpers: set[str]) -> None:
+    """Record, in ``state``, which names ``target`` now holds clean values for after ``target = value``."""
+    if isinstance(target, (ast.Tuple, ast.List)) and isinstance(value, (ast.Tuple, ast.List)):
+        plain = len(target.elts) == len(value.elts) and not any(
+            isinstance(x, ast.Starred) for x in (*target.elts, *value.elts)
+        )
+        if plain:
+            parts = [(t, v) for t, v in zip(target.elts, value.elts, strict=True)]
+            clean_now = {id(t): _is_clean(v, frozenset(state), helpers) for t, v in parts}  # all read BEFORE any write
+            for t, _ in parts:
+                _bind_names(t, clean_now[id(t)], state)
+            return
+    _bind_names(target, _is_clean(value, frozenset(state), helpers), state)
+
+
+def _bind_names(target: ast.AST, clean: bool, state: set[str]) -> None:
+    for name in _names_of(target):
+        (state.add if clean else state.discard)(name)
+
+
+_SUPPRESSORS = frozenset({"suppress"})  # contextlib.suppress: the body may stop half way and the code after it runs
+
+
+def _is_sink(n: ast.AST) -> ast.AST | None:
+    """The expression that names the file in a file operation ``n`` (receiver or first argument), else None."""
+    if not isinstance(n, ast.Call):
+        return None
+    if isinstance(n.func, ast.Name) and n.func.id == "open":
+        return n.args[0] if n.args else n
+    if isinstance(n.func, ast.Attribute) and n.func.attr in _SINK_ATTRS:
+        return n.args[0] if n.func.attr == "connect" and n.args else n.func.value
+    return None
+
+
+def _is_exit_call(stmt: ast.stmt) -> bool:
+    """``sys.exit(...)`` as a statement: the code after it does not run."""
+    return (
+        isinstance(stmt, ast.Expr)
+        and isinstance(stmt.value, ast.Call)
+        and isinstance(stmt.value.func, ast.Attribute)
+        and stmt.value.func.attr == "exit"
+    )
+
+
+class _UseWalk:
+    """Walks one function, keeping the set of names that certainly hold a helper result, and collects the file
+    operations whose path expression is not rooted in one."""
+
+    def __init__(self, helpers: set[str]) -> None:
+        self.helpers = helpers
+        self.count = 0
+        self.bad: list[int] = []
+
+    def expr(self, node: ast.AST | None, state: set[str], *, certain: bool = True) -> None:
+        """Visit in evaluation order: bind walrus names (only when certain to run) and check file operations."""
+        if node is None:
+            return
+        if isinstance(node, ast.IfExp):
+            self.expr(node.test, state, certain=certain)
+            self.expr(node.body, set(state), certain=False)
+            self.expr(node.orelse, set(state), certain=False)
+            return
+        if isinstance(node, ast.BoolOp):
+            self.expr(node.values[0], state, certain=certain)
+            for v in node.values[1:]:
+                self.expr(v, set(state), certain=False)
+            return
+        if isinstance(node, ast.Lambda):
+            inner = set(state) - {a.arg for a in ast.walk(node.args) if isinstance(a, ast.arg)}
+            self.expr(node.body, inner, certain=False)
+            return
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)):
+            inner = set(state)
+            for i, gen in enumerate(node.generators):
+                self.expr(gen.iter, state if i == 0 and certain else inner, certain=certain and i == 0)
+                _bind_names(gen.target, _is_clean(gen.iter, frozenset(inner), self.helpers), inner)
+                for cond in gen.ifs:
+                    self.expr(cond, inner, certain=False)
+            parts = [node.key, node.value] if isinstance(node, ast.DictComp) else [node.elt]
+            for p in parts:
+                self.expr(p, inner, certain=False)
+            return
+        for child in ast.iter_child_nodes(node):
+            self.expr(child, state, certain=certain)
+        if isinstance(node, ast.NamedExpr) and certain:
+            _bind(node.target, node.value, state, self.helpers)
+        sink = _is_sink(node)
+        if sink is not None:
+            self.count += 1
+            if not _is_clean(sink, frozenset(state), self.helpers):
+                self.bad.append(getattr(node, "lineno", 0))
+
+    def block(self, body: list[ast.stmt], state: _State) -> _State:
+        for stmt in body:
+            if state is None:
+                return None  # the rest cannot run
+            state = self.stmt(stmt, state)
+        return state
+
+    def loop(self, stmt: ast.For | ast.AsyncFor | ast.While, state: frozenset[str]) -> _State:
+        if isinstance(stmt, ast.While):
+            self.expr(stmt.test, set(state), certain=True)
+        else:
+            self.expr(stmt.iter, set(state), certain=True)
+        entry: _State = state
+        for _ in range(2):  # the second pass sees what the first pass left for the next round
+            start = set(entry) if entry is not None else set()
+            if not isinstance(stmt, ast.While):
+                _bind_names(stmt.target, _is_clean(stmt.iter, frozenset(start), self.helpers), start)
+            out = self.block(stmt.body, frozenset(start))
+            entry = _join(state, out)
+        after = _join(state, entry)  # the body may not run at all
+        if stmt.orelse and after is not None:
+            after = _join(after, self.block(stmt.orelse, after))
+        return after
+
+    def stmt(self, stmt: ast.stmt, state: frozenset[str]) -> _State:
+        s = set(state)
+        if isinstance(stmt, ast.Assign):
+            self.expr(stmt.value, s)
+            for t in stmt.targets:
+                self.expr(t, s)
+                _bind(t, stmt.value, s, self.helpers)
+            return frozenset(s)
+        if isinstance(stmt, ast.AnnAssign):
+            self.expr(stmt.value, s)
+            if stmt.value is not None:
+                _bind(stmt.target, stmt.value, s, self.helpers)
+            return frozenset(s)
+        if isinstance(stmt, ast.AugAssign):
+            self.expr(stmt.value, s)
+            _bind_names(stmt.target, _is_clean(stmt.target, frozenset(s), self.helpers), s)  # p /= "x" stays derived
+            return frozenset(s)
+        if isinstance(stmt, (ast.Return, ast.Raise)):
+            for child in ast.iter_child_nodes(stmt):
+                self.expr(child, s)
+            return None
+        if isinstance(stmt, ast.If):
+            self.expr(stmt.test, s)
+            a = self.block(stmt.body, frozenset(s))
+            b = self.block(stmt.orelse, frozenset(s))
+            return _join(a, b)
+        if isinstance(stmt, (ast.For, ast.AsyncFor, ast.While)):
+            return self.loop(stmt, state)
+        if isinstance(stmt, (ast.With, ast.AsyncWith)):
+            for item in stmt.items:
+                self.expr(item.context_expr, s)
+                if item.optional_vars is not None:
+                    _bind(item.optional_vars, item.context_expr, s, self.helpers)
+            out = self.block(stmt.body, frozenset(s))
+            swallows = any(
+                isinstance(i.context_expr, ast.Call)
+                and (
+                    (isinstance(i.context_expr.func, ast.Name) and i.context_expr.func.id in _SUPPRESSORS)
+                    or (isinstance(i.context_expr.func, ast.Attribute) and i.context_expr.func.attr in _SUPPRESSORS)
+                )
+                for i in stmt.items
+            )
+            return _join(frozenset(s), out) if swallows else out
+        if isinstance(stmt, ast.Try):
+            body = self.block(stmt.body, state)
+            after = self.block(stmt.orelse, body) if body is not None else None
+            for h in stmt.handlers:  # a handler may start after any part of the body: only what held on entry counts
+                after = _join(after, self.block(h.body, state))
+            if (
+                stmt.finalbody
+            ):  # runs after a normal end and after a raise: only what held on entry counts for the latter
+                fin = self.block(stmt.finalbody, _join(after, state) if after is not None else state)
+                return None if after is None else _join(after, fin)
+            return after
+        if isinstance(stmt, ast.Match):
+            self.expr(stmt.subject, s)
+            out: _State = frozenset(s)  # no case may match
+            for case in stmt.cases:
+                out = _join(out, self.block(case.body, frozenset(s)))
+            return out
+        if isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            inner = set(state) - {a.arg for a in ast.walk(stmt.args) if isinstance(a, ast.arg)}
+            self.block(stmt.body, frozenset(inner))
+            _bind_names(ast.Name(id=stmt.name), False, s)
+            return frozenset(s)
+        if isinstance(stmt, ast.ClassDef):
+            return state
+        if isinstance(stmt, ast.Assert):
+            self.expr(stmt.test, s, certain=False)  # python -O strips it: nothing it binds can be relied on
+            return state
+        for child in ast.iter_child_nodes(stmt):  # Expr, Delete, Global, Import, Pass, ...
+            if isinstance(child, ast.expr):
+                self.expr(child, s)
+        if _is_exit_call(stmt):
+            return None
+        return frozenset(s)
+
+
+def _unused_result_sinks(func: ast.FunctionDef, helpers: set[str]) -> tuple[int, list[int]]:
+    """(number of file operations in ``func``, the line numbers of those whose path is NOT rooted in a helper result
+    on every path to them). Parameters start unclean."""
+    walk = _UseWalk(helpers)
+    walk.block(func.body, frozenset())
+    return walk.count, walk.bad
+
+
+@pytest.mark.parametrize(("rel", "func", "helpers"), SITES)
+def test_each_flagged_function_opens_the_value_the_helper_returned(rel: str, func: str, helpers: set[str]) -> None:
+    node = _function((REPO / rel).read_text(encoding="utf-8"), func)
+    count, bad = _unused_result_sinks(node, helpers)
+    assert count > 0, (rel, func, "no file operation found: the test would check nothing")
+    assert not bad, (rel, func, "file operation at these lines does not use a helper result on every path", bad)
+
+
+# (name, source, expected number of file operations whose path is not rooted in a helper result)
