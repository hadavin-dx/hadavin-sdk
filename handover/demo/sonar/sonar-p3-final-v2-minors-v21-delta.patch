+def test_n8n_api_does_not_echo_a_special_character_from_the_workflow_file_name(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    inside, _ = jail
+    (inside / "key.txt").write_text("made-up-key-for-the-test\n", encoding="utf-8")
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(inside / "key.txt"))
+    monkeypatch.setenv("N8N_URL", "http://127.0.0.1:1")
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    mod = importlib.import_module("n8n_api")
+    monkeypatch.setattr(mod, "call", lambda *a, **k: (200, {}))
+    bad = inside / "wf\u202eevil.json"
+    try:
+        bad.write_text("not json", encoding="utf-8")
+    except OSError:
+        pytest.skip("this file system cannot hold the name")
+    with pytest.raises(SystemExit, match="cannot read a workflow from") as err:
+        mod.main(["n8n_api.py", "import", str(bad)])  # passes the helper, then fails to parse
+    text = str(err.value)
+    assert "\u202e" not in text and _PLACEHOLDER in text and "(JSONDecodeError)" in text, repr(text)
+    (inside / "wf.json").write_text("not json", encoding="utf-8")
+    with pytest.raises(SystemExit, match="cannot read a workflow from .*wf.json"):  # a plain path is still shown
+        mod.main(["n8n_api.py", "import", str(inside / "wf.json")])
+    (inside / "wf\u00e9.json").write_text("not json", encoding="utf-8")
+    with pytest.raises(SystemExit, match="cannot read a workflow from .*wf\u00e9.json"):  # accents are printable
+        mod.main(["n8n_api.py", "import", str(inside / "wf\u00e9.json")])
