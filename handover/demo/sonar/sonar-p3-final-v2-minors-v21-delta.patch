+    for q in parts:
+        q.unlink()
+"""),
+        0,
+    ),
+    (
+        "tuple unpack that keeps the result for the opened name",
+        textwrap.dedent("""
+def f(src):
+    a, b = confine(src), 1
+    return a.read_text()
+"""),
+        0,
+    ),
+    # --- not fine: the helper ran (dominance may even hold) but the operation does not use its result ---
+    (
+        "E9: result discarded, raw name used",
+        textwrap.dedent("""
+def f(p):
+    confine(p)
+    return Path(p).read_text()
+"""),
+        1,
+    ),
+    (
+        "result discarded (bare expression)",
+        textwrap.dedent("""
+def f(src):
+    confine_existing(src)
+    return Path(src).read_text()
+"""),
+        1,
+    ),
+    (
+        "result assigned, a different variable used",
+        textwrap.dedent("""
+def f(p):
+    q = confine(p)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "result used on one branch only",
+        textwrap.dedent("""
+def f(p, a):
+    if a:
+        p = confine(p)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "helper called on a copy of the path",
+        textwrap.dedent("""
+def f(p):
+    c = p
+    c = confine(c)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "variable reassigned after the helper",
+        textwrap.dedent("""
+def f(p, src):
+    p = confine(p)
+    p = Path(src)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "sink on the original argument via a tuple unpack",
+        textwrap.dedent("""
+def f(src):
+    a, b = confine(src), src
+    return b.read_text()
+"""),
+        1,
+    ),
+    (
+        "tuple unpack, sides swapped",
+        textwrap.dedent("""
+def f(src):
+    a, b = src, confine(src)
+    return a.read_text()
+"""),
+        1,
+    ),
+    (
+        "result tuple holds the raw name next to it",
+        textwrap.dedent("""
+def f(src):
+    return (confine(src), Path(src))[1].read_text()
+"""),
+        1,
+    ),
+    (
+        "helper only under an if-expression",
+        textwrap.dedent("""
+def f(p, a):
+    q = confine(p) if a else p
+    return q.read_text()
+"""),
+        1,
+    ),
+    (
+        "helper after an and",
+        textwrap.dedent("""
+def f(p, a):
+    ok = a and confine(p)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "walrus only under an and",
+        textwrap.dedent("""
+def f(p, a):
+    ok = a and (q := confine(p))
+    return q.read_text()
+"""),
+        1,
+    ),
+    (
+        "helper in a loop that may not run",
+        textwrap.dedent("""
+def f(p, xs):
+    for x in xs:
+        p = confine(p)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "loop body replaces the clean name for the next round",
+        textwrap.dedent("""
+def f(p, xs):
+    p = confine(p)
+    for x in xs:
+        p.read_text()
+        p = Path(x)
+"""),
+        1,
+    ),
+    (
+        "handler falls through without the result",
+        textwrap.dedent("""
+def f(p):
+    try:
+        p = confine(p)
+    except E:
+        pass
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "contextlib.suppress around the helper",
+        textwrap.dedent("""
+def f(p):
+    with suppress(E):
+        p = confine(p)
+    return p.read_text()
+"""),
+        1,
+    ),
+    (
+        "assert is stripped by python -O",
+        textwrap.dedent("""
+def f(p):
+    assert (q := confine(p))
+    return q.read_text()
+"""),
+        1,
+    ),
+    (
+        "operation before the helper",
+        textwrap.dedent("""
+def f(p):
+    x = p.read_text()
+    p = confine(p)
+    return x
+"""),
+        1,
+    ),
+    (
+        "an unrelated name from the parameters",
+        textwrap.dedent("""
+def f(p, other):
+    p = confine(p)
+    return other.read_text()
+"""),
+        1,
+    ),
+]
