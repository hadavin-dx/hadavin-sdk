diff --git a/tests/test_client_copy.py b/tests/test_client_copy.py
new file mode 100644
index 0000000..6f3f3f3
--- /dev/null
+++ b/tests/test_client_copy.py
@@ -0,0 +1,230 @@
+"""A client copy (demo_only/ deleted, maybe .git too) must run every test that does not need the demo, and must say so
+when a check cannot run. Pins: which files conftest keeps, the lost-scan skip or failure, and that nothing else is lost
+with it. Needs no demo_only folder. Made-up data only."""
+
+from __future__ import annotations
+
+import ast
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import _repo_root
+import conftest
+import pytest
+import test_hygiene
+
+TESTS = Path(__file__).resolve().parent
+REPO = TESTS.parent
+
+# Files that need only the repository folder or plain helpers: they must stay runnable in a client copy. If one of them
+# gains an import of demo_only or a use of the demo's rig, move that part out (tests/_plain.py, tests/_repo_root.py)
+# instead of letting the whole file fall back to the one placeholder skip.
+PLAIN_FILES = [
+    "test_hygiene.py",
+    "test_no_placeholders.py",
+    "test_raw_bidi_chars.py",
+    "test_shell_single_bracket.py",
+    "test_bind_refusals.py",
+    "test_codeant_hygiene.py",
+    "test_gitleaks_exceptions.py",
+    "test_hubspot_probe.py",
+    "test_n8n_api_url.py",
+    "test_reset_scripts.py",
+    "test_server_stop_guard.py",
+    "test_client_copy.py",
+]
+OPTIONAL_HERE = [  # files another patch of the series adds or rewrites
+    "test_no" + "semgrep_form.py",
+    "test_gitleaks_semgrep_lock.py",
+    "test_path_confinement.py",
+]
+
+
+@pytest.mark.parametrize("name", PLAIN_FILES + [n for n in OPTIONAL_HERE if (TESTS / n).is_file()])
+def test_a_file_that_needs_no_demo_is_not_replaced_by_the_placeholder_skip(name: str) -> None:
+    assert not conftest._needs_demo(TESTS / name), f"{name} would be one skipped item in a client copy"
+
+
+def test_needs_demo_reads_what_a_file_really_needs(tmp_path: Path) -> None:
+    def needs(text: str) -> bool:
+        path = tmp_path / "test_probe.py"
+        path.write_text(text, encoding="utf-8")
+        conftest._needs_demo.cache_clear()
+        return conftest._needs_demo(path)
+
+    assert not needs("from support import REPO, lead, free_port\n")
+    assert not needs("from _repo_root import REPO\nfrom test_hygiene import GITLEAKS_ENV\n")
+    assert not needs("def test_a(env):\n    env.stop_on_close(print)\n")
+    assert not needs("def test_a():\n    import demo_only.fakes  # a missing demo is a skip of this one test\n")
+    assert needs("from demo_only.fakes import FakeCrm\n")
+    assert needs("from edge_case_helpers import mk_desk\n")
+    assert needs("from support import build_rig\n")
+    assert needs("from support import DEMO_LEADFLOW\n")
+    assert needs("def test_a(env):\n    env." + "rig()\n")
+    assert needs("def test_a(env):\n    env." + "fakes()\n")
+    assert needs("from test_flow import retry_twice_body\n")  # test_flow needs the demo: so does this file
+    conftest._needs_demo.cache_clear()
+
+
+def test_support_can_be_read_without_the_demo_folder() -> None:
+    """tests/support.py is imported by a client copy: it must not import demo_only at its top level."""
+    tree = ast.parse((TESTS / "support.py").read_text(encoding="utf-8"))
+    for node in tree.body:
+        if isinstance(node, ast.ImportFrom | ast.Import):
+            mods = [node.module or ""] if isinstance(node, ast.ImportFrom) else [a.name for a in node.names]
+            assert not any(m.split(".")[0] == "demo_only" for m in mods), ast.dump(node)
+
+
+def test_the_repository_folder_comes_from_the_file_not_from_the_current_folder(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.chdir(tmp_path)
+    assert _repo_root.REPO == REPO
+    assert (_repo_root.REPO / "tests" / "_repo_root.py").is_file()
+
+
+def _bare_git(folder: Path, *args: str) -> None:
+    ident = ["-c", "user.name=t", "-c", "user.email=t@example.test"]
+    subprocess.run(["git", *ident, *args], cwd=folder, check=True, capture_output=True)  # noqa: S603, S607
+
+
+def test_the_scan_gap_asks_git_what_it_lists_not_whether_dot_git_exists(tmp_path: Path) -> None:
+    """Measured: a folder with no .git, a `git init` with nothing added (it has a .git, lists nothing, and a scan would
+    pass on no files) and a sub-folder its parent repository does not track all lose the scan; a clone, a linked
+    worktree (its .git is a FILE) and a sub-folder its parent repository tracks keep it."""
+
+    def folder(name: str, parent: Path = tmp_path) -> Path:
+        path = parent / name
+        path.mkdir()
+        (path / _repo_root.MARKER).write_text("x\n", encoding="utf-8")
+        return path
+
+    gap = _repo_root.repo_scan_gap
+    assert gap(folder("archive")), "no .git at all"
+    initial = folder("init_only")
+    _bare_git(initial, "init", "-q")
+    assert (initial / ".git").is_dir()
+    assert gap(initial), "a .git with an empty index lists nothing"
+    _bare_git(initial, "add", "-A")
+    _bare_git(initial, "commit", "-q", "-m", "m")
+    assert gap(initial) is None, "a clone"
+    linked = tmp_path / "linked"
+    _bare_git(initial, "worktree", "add", "-q", str(linked))
+    assert (linked / ".git").is_file()
+    assert gap(linked) is None, ".git as a file is a work tree"
+    parent = tmp_path / "parent"
+    parent.mkdir()
+    _bare_git(parent, "init", "-q")
+    inner = folder("inner", parent)
+    assert gap(inner), "inside another repository that does not track it"
+    _bare_git(parent, "add", "-A")
+    assert gap(inner) is None, "inside another repository that tracks it"
+    text = gap(folder("archive2")) or ""
+    for must in ("NOT run", "git add -A", _repo_root.REQUIRE_SCAN_ENV, "failure"):
+        assert must in text, (must, text)  # what was lost, how to run it, and that CI fails instead
+    assert _repo_root.REQUIRE_SCAN_ENV == test_hygiene.REQUIRE_SCAN_ENV
+
+
+ADDED_BY_OTHER_PATCHES = {"test_sh_blobs_no_cr", "test_the_secret_scan_files_have_no_carriage_return"}  # crlf-guard
+
+
+def test_every_registered_scan_test_exists() -> None:
+    for fname, test in _repo_root.SCAN_TESTS:
+        path = TESTS / fname
+        if not path.is_file() or test in ADDED_BY_OTHER_PATCHES:
+            continue
+        defs = {n.name for n in ast.walk(ast.parse(path.read_text(encoding="utf-8"))) if isinstance(n, ast.FunctionDef)}
+        assert test in defs, f"{fname}::{test} is registered as a repository scan but is not a test there"
+
+
+def test_the_canary_checks_still_run_where_only_the_repository_scan_is_lost(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """test_hygiene_scan_public checks its canaries before it reads the repository: with git out of reach it must get
+    that far (a canary that no rule matches fails it) and only then end as a skip, or as a failure in CI."""
+    gap = "GAP-TEXT: the scan was NOT run"
+    monkeypatch.setattr(test_hygiene, "repo_scan_gap", lambda *_: gap)
+    monkeypatch.delenv(test_hygiene.REQUIRE_SCAN_ENV, raising=False)
+    with pytest.raises(pytest.skip.Exception, match="GAP-TEXT"):
+        test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "a"))
+    monkeypatch.setenv(test_hygiene.REQUIRE_SCAN_ENV, "1")
+    with pytest.raises(pytest.fail.Exception, match="GAP-TEXT"):
+        test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "b"))
+    # a rule that stopped matching its canary is still found before the skip
+    monkeypatch.delenv(test_hygiene.REQUIRE_SCAN_ENV)
+    monkeypatch.setitem(test_hygiene.hygiene.CANARIES, "never matched", "zz-no-rule-matches-this-zz")
+    try:
+        with pytest.raises(AssertionError, match="canary not found"):
+            test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "c"))
+    except pytest.skip.Exception:
+        pytest.fail("the test ended as a skip before its canary checks ran")
+
+
+def _fresh(base: Path, name: str) -> Path:
+    (base / name).mkdir()
+    return base / name
+
+
+CLIENT_FILES = ["tests/conftest.py", "tests/support.py", "tests/_repo_root.py", "tests/_plain.py"]
+
+
+def _client_copy(dest: Path) -> Path:
+    """A minimal copy of this repository without demo_only and without .git, with the tests that scan it."""
+    for sub in ("src", "tools"):
+        shutil.copytree(REPO / sub, dest / sub, ignore=shutil.ignore_patterns("__pycache__"))
+    (dest / "tests").mkdir()
+    for rel in [*CLIENT_FILES, "tests/test_raw_bidi_chars.py", "pyproject.toml"]:
+        shutil.copy(REPO / rel, dest / rel)
+    return dest
+
+
+def _pytest_in(
+    copy: Path, cwd: Path, test: str = "test_raw_bidi_chars.py", **env: str
+) -> subprocess.CompletedProcess[str]:
+    base = {k: v for k, v in os.environ.items() if not k.startswith(("DPLD_", "DESK_", "PYTEST_"))}
+    return subprocess.run(  # noqa: S603 (our own interpreter, a copy made here)
+        [sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider", "-rsf", "--rootdir", str(copy),
+         "-c", str(copy / "pyproject.toml"), str(copy / "tests" / test)],
+        cwd=cwd, env={**base, **env}, capture_output=True, text=True, check=False, timeout=300,
+    )  # fmt: skip
+
+
+def test_a_client_copy_without_git_skips_a_lost_scan_loudly_and_fails_it_under_the_ci_setting(tmp_path: Path) -> None:
+    """End to end, from ANOTHER current folder: the real conftest in a copy with no demo_only and no .git."""
+    copy = _client_copy(tmp_path / "client")
+    elsewhere = tmp_path / "elsewhere"
+    elsewhere.mkdir()
+    skipped = _pytest_in(copy, elsewhere)
+    assert skipped.returncode == 0, skipped.stdout + skipped.stderr
+    assert "NOT run" in skipped.stdout and "git add -A" in skipped.stdout, skipped.stdout
+    assert "test_raw_bidi_chars.py:" in skipped.stdout, "the skip names the test file, not a helper"
+    assert "_repo_root.py:" not in skipped.stdout
+    failed = _pytest_in(copy, elsewhere, DPLD_REQUIRE_SCAN="1")
+    assert failed.returncode == 1, failed.stdout + failed.stderr
+    assert "NOT run" in failed.stdout and "1 failed" in failed.stdout, failed.stdout
+    _bare_git(copy, "init", "-q")
+    _bare_git(copy, "add", "-A")
+    scanned = _pytest_in(copy, elsewhere, DPLD_REQUIRE_SCAN="1")
+    assert scanned.returncode == 0 and "NOT run" not in scanned.stdout, scanned.stdout
+    (copy / "src" / "planted.txt").write_text("a" + chr(0x202E) + "b\n", encoding="utf-8")
+    _bare_git(copy, "add", "-A")
+    planted = _pytest_in(copy, elsewhere, DPLD_REQUIRE_SCAN="1")
+    assert planted.returncode == 1 and "planted.txt" in planted.stdout, planted.stdout
+
+
+def test_a_test_that_reads_a_file_of_the_missing_demo_folder_is_a_skip_not_a_failure(tmp_path: Path) -> None:
+    """A test file with no import of the demo can still reach it at run time (a script reading its data file)."""
+    copy = _client_copy(tmp_path / "client")
+    (copy / "tests" / "test_reads_demo_file.py").write_text(
+        "from pathlib import Path\n\n\ndef test_reads_it():\n"
+        '    Path("demo_only/canned_leads.json").read_text(encoding="utf-8")\n\n\n'
+        "def test_other_error_still_fails():\n"
+        '    Path("nowhere/else.json").read_text(encoding="utf-8")\n',
+        encoding="utf-8",
+    )
+    done = _pytest_in(copy, copy, "test_reads_demo_file.py")
+    assert "1 failed, 1 skipped" in done.stdout, done.stdout
+    assert "test_other_error_still_fails" in done.stdout and "test_reads_it" not in done.stdout.split("short test")[-1]
