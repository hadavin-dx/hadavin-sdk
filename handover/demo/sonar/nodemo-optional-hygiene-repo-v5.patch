+        if any(m.split(".")[0] in _DEMO_MODULES for m in modules) or any(n in DEMO_BOUND_NAMES for n in names):
+            return True
+        for m in modules:  # a test file imported by this one: it needs the demo if that one does
+            other = _TESTS / (m.split(".")[0] + ".py")
+            if other.name.startswith("test_") and other != path and other.is_file() and _needs_demo(other):
+                return True
