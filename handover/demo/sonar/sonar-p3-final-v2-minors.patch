+# ---------- the call sites: the helper must DOMINATE every file operation of the function (by AST) ----------
+
+_SINK_ATTRS = frozenset({"read_text", "write_text", "read_bytes", "write_bytes", "open", "touch", "connect", "unlink"})
+
+
+def _calls(node: ast.AST, names: frozenset[str] | set[str], *, certain: bool) -> list[ast.Call]:
+    """The calls of ``names`` (a function called by plain name) inside ``node``. With ``certain`` only the calls that
+    run whenever the node runs: nothing under a conditional expression's branches, the later operands of ``and``/``or``,
+    a lambda or a comprehension."""
+    found: list[ast.Call] = []
+
+    def visit(n: ast.AST) -> None:
+        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id in names:
+            found.append(n)
+        if certain and isinstance(n, (ast.Lambda, ast.ListComp, ast.SetComp, ast.DictComp, ast.GeneratorExp)):
+            return
+        if certain and isinstance(n, ast.IfExp):
+            visit(n.test)
+            return
+        if certain and isinstance(n, ast.BoolOp):
+            visit(n.values[0])
+            return
+        for child in ast.iter_child_nodes(n):
+            visit(child)
+
+    visit(node)
+    return found
+
+
+def _ends_the_function(handler: ast.ExceptHandler) -> bool:
+    """True when the handler never falls through to the statements after the ``try``: raise, return or sys.exit."""
+    if not handler.body:
+        return False
+    last = handler.body[-1]
+    exits = (  # sys.exit(...)
+        isinstance(last, ast.Expr)
+        and isinstance(last.value, ast.Call)
+        and isinstance(last.value.func, ast.Attribute)
+        and last.value.func.attr == "exit"
+    )
+    return exits or isinstance(last, (ast.Raise, ast.Return))
+
+
+def _establishes(stmt: ast.stmt, helpers: set[str]) -> bool:
+    """True when, after ``stmt`` has run to its end, a helper call has certainly run (on every path through it)."""
+    if isinstance(stmt, ast.Try):
+        return any(_establishes(b, helpers) for b in stmt.body) and all(_ends_the_function(h) for h in stmt.handlers)
+    if isinstance(stmt, ast.With):
+        return any(_establishes(b, helpers) for b in stmt.body)
+    if isinstance(stmt, ast.If):
+        return any(_establishes(b, helpers) for b in stmt.body) and any(_establishes(b, helpers) for b in stmt.orelse)
+    if isinstance(stmt, (ast.For, ast.While, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+        return False
+    return bool(_calls(stmt, helpers, certain=True))
+
+
+def _parents(root: ast.AST) -> dict[ast.AST, ast.AST]:
+    return {child: parent for parent in ast.walk(root) for child in ast.iter_child_nodes(parent)}
+
+
+def _undominated_sinks(func: ast.FunctionDef, helpers: set[str]) -> tuple[int, list[int]]:
+    """(number of file operations in ``func``, the line numbers of those NOT dominated by a helper call). A file
+    operation is dominated when, in its own block or in an enclosing one, a statement BEFORE it establishes a helper
+    call, or when the helper call is part of the operation's own expression (``confine(x).read_text()``)."""
+    parents = _parents(func)
+    sinks = [
+        n
+        for n in ast.walk(func)
+        if isinstance(n, ast.Call)
+        and (
+            (isinstance(n.func, ast.Attribute) and n.func.attr in _SINK_ATTRS)
+            or (isinstance(n.func, ast.Name) and n.func.id == "open")
+        )
+    ]
+    bad = []
+    for sink in sinks:
+        if _calls(sink, helpers, certain=True):
+            continue  # the helper call is inside the operation's own expression: it runs first
+        node: ast.AST = sink
+        ok = False
+        while node is not func and not ok:
+            parent = parents[node]
+            for field in ("body", "orelse", "finalbody", "handlers"):
+                block = getattr(parent, field, None)
+                if isinstance(block, list) and node in block:
+                    before = block[: block.index(node)]
+                    ok = any(isinstance(b, ast.stmt) and _establishes(b, helpers) for b in before)
+            node = parent
+        if not ok:
+            bad.append(sink.lineno)
+    return len(sinks), bad
+
+
+def _function(source: str, name: str) -> ast.FunctionDef:
+    return next(n for n in ast.walk(ast.parse(source)) if isinstance(n, ast.FunctionDef) and n.name == name)
+
