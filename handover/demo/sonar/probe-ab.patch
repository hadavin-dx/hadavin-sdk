@@ -0,0 +1,122 @@
+"""PROBE AB: path guards on a few of the flagged functions, two shapes at once (see the note next to the patch).
+Helper shape: read_jsonl, _intended, load_driver.run, scrub_n8n_export.main. Inline shape: read_crm, _facts_say_live,
+_drain_marker, n8n_api import. Made-up data only; each refusal test fails on the code before the probe."""
+
+from __future__ import annotations
+
+import importlib
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+from load_tools import check_invariants as ci
+from load_tools import load_driver
+from tools import scrub_n8n_export
+
+REPO = Path(__file__).resolve().parent.parent
+ROOTS_ENV = "LEAD_DESK_PATH_ROOTS"
+
+
+@pytest.fixture
+def jail(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> tuple[Path, Path]:
+    """(inside, outside): the only allowed folder is ``inside``; ``outside`` is next to it."""
+    inside, outside = tmp_path / "inside", tmp_path / "outside"
+    inside.mkdir()
+    outside.mkdir()
+    monkeypatch.chdir(inside)
+    monkeypatch.setattr(tempfile, "tempdir", str(inside))
+    monkeypatch.setattr("tools.pathconfine.REPO_ROOT", inside)
+    monkeypatch.delenv(ROOTS_ENV, raising=False)
+    monkeypatch.setattr(ci, "REPO_ROOT", inside, raising=False)
+    # the inline shape finds the repository from __file__: point the allowed list at the jail only
+    monkeypatch.setattr(ci, "_probe_roots", lambda: [str(inside.resolve())], raising=False)
+    return inside, outside
+
+
+def test_jsonl_and_intended_helper_shape(jail: tuple[Path, Path]) -> None:
+    inside, outside = jail
+    (inside / "a.jsonl").write_text('{"a": 1}\n', encoding="utf-8")
+    (inside / "f.json").write_text(json.dumps({"intended_requests": 3}), encoding="utf-8")
+    (outside / "a.jsonl").write_text('{"a": 1}\n', encoding="utf-8")
+    (outside / "f.json").write_text(json.dumps({"intended_requests": 3}), encoding="utf-8")
+    assert ci.read_jsonl(Path("a.jsonl")) == [{"a": 1}]
+    assert ci._intended(inside / "f.json") == 3
+    for bad in (outside / "a.jsonl", Path("../outside/a.jsonl")):
+        with pytest.raises(ci.InputError, match="outside"):
+            ci.read_jsonl(bad)
+    with pytest.raises(ci.InputError, match="outside"):
+        ci._intended(outside / "f.json")
+
+
+def test_crm_facts_live_and_drain_inline_shape(jail: tuple[Path, Path]) -> None:
+    inside, outside = jail
+    for folder in (inside, outside):
+        (folder / "crm.json").write_text('[{"lead_id": "L1"}]', encoding="utf-8")
+        (folder / "facts.json").write_text(json.dumps({"qualifier": "live_claude"}), encoding="utf-8")
+        (folder / "drain.json").write_text(json.dumps({"drained_ts": 7}), encoding="utf-8")
+    assert ci.read_crm(inside / "crm.json") == [{"lead_id": "L1"}]
+    assert ci._facts_say_live(inside / "facts.json") is True
+    assert ci._drain_marker(inside / "drain.json") == 7.0
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_crm(outside / "crm.json")
+    assert ci._facts_say_live(outside / "facts.json") is False  # refused: never read (the file says live)
+    with pytest.raises(ci.InputError, match="outside"):
+        ci._drain_marker(Path("../outside/drain.json"))
+
+
+def test_inline_shape_refuses_a_link_out_and_a_prefix_sibling(jail: tuple[Path, Path]) -> None:
+    inside, outside = jail
+    (outside / "crm.json").write_text("[]", encoding="utf-8")
+    evil = inside.parent / (inside.name + "-evil")
+    evil.mkdir()
+    (evil / "crm.json").write_text("[]", encoding="utf-8")
+    if sys.platform != "win32":
+        (inside / "link.json").symlink_to(outside / "crm.json")
+        with pytest.raises(ci.InputError, match="outside"):
+            ci.read_crm(inside / "link.json")
+    with pytest.raises(ci.InputError, match="outside"):
+        ci.read_crm(evil / "crm.json")
+
+
+def test_load_driver_run_helper_shape(jail: tuple[Path, Path]) -> None:
+    inside, outside = jail
+    with pytest.raises(Exception, match="outside"):
+        load_driver.run("http://127.0.0.1:1", "burst:1", outside / "l.jsonl", inside / "f.json", 1, 1, 1, "p")
+    with pytest.raises(Exception, match="outside"):
+        load_driver.run("http://127.0.0.1:1", "burst:1", inside / "l.jsonl", outside / "f.json", 1, 1, 1, "p")
+    assert not list(outside.iterdir())
+
+
+def test_scrub_helper_shape(jail: tuple[Path, Path], capsys: pytest.CaptureFixture[str]) -> None:
+    inside, outside = jail
+    wf = json.dumps({"name": "w", "nodes": []})
+    (inside / "in.json").write_text(wf, encoding="utf-8")
+    (outside / "in.json").write_text(wf, encoding="utf-8")
+    assert scrub_n8n_export.main(["x", str(outside / "in.json"), "out.json"]) == 2
+    assert scrub_n8n_export.main(["x", "in.json", str(outside / "out.json")]) == 2
+    assert not (outside / "out.json").exists() and "refused" in capsys.readouterr().out
+    assert scrub_n8n_export.main(["x", "in.json", "out.json"]) == 0
+    assert (inside / "out.json").is_file()
+
+
+def test_n8n_api_import_inline_shape(jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch) -> None:
+    inside, outside = jail
+    (inside / "wf.json").write_text(json.dumps({"name": "made-up"}), encoding="utf-8")
+    (outside / "wf.json").write_text(json.dumps({"name": "made-up"}), encoding="utf-8")
+    (inside / "key.txt").write_text("made-up-key-for-the-test\n", encoding="utf-8")
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(inside / "key.txt"))
+    monkeypatch.setenv("N8N_URL", "http://127.0.0.1:1")
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    mod = importlib.import_module("n8n_api")
+    monkeypatch.setattr(mod, "_probe_roots", lambda: [str(inside.resolve())], raising=False)
+    sent: list[str] = []
+    monkeypatch.setattr(mod, "call", lambda *a, **k: sent.append("call") or (200, {}))
+    with pytest.raises(SystemExit, match="cannot read a workflow"):
+        mod.main(["n8n_api.py", "import", str(outside / "wf.json")])
+    assert sent == []
+    assert mod.main(["n8n_api.py", "import", "wf.json"]) == 0
+    assert sent == ["call"]
diff --git a/tools/pathconfine.py b/tools/pathconfine.py
new file mode 100644
index 0000000..0a55951
--- /dev/null
+++ b/tools/pathconfine.py
@@ -0,0 +1,166 @@
+"""One place that decides whether a file path typed on a command line may be opened. Standard library only.
+
+Class of bug: a command-line tool opened whatever path it was given (``Path(argv[2]).read_text()``), so a path written
+by a faulty script or by an AI agent that drives the tool (``../../secret``, an absolute path, a link that points out
+of the work folder) was read or overwritten. Standard cure (CWE-22, OWASP "Path Traversal"): resolve the path to its
+real location (``os.path.realpath`` follows links and removes ``..``) and refuse unless that location lies inside a
+folder the tool is allowed to use. ``confine`` is that check; every tool calls it on the argument and uses ONLY the
+returned path afterwards, never the original text.
+
+How the returned path is made: after the check, the file is looked up BY NAME in a directory listing, one folder level
+at a time, starting at the allowed folder (which comes from this module, not from the argument). The returned text is
+the listing's own entry. So the text that gets opened is never the argument's text, only something the file system
+itself reported. A name that is not in the listing yet (an output file that does not exist) is rebuilt character by
+character from a table of allowed characters (letters, digits, ``.``, ``_``, ``-``); any other character in a NEW
+file's name is refused (an existing file may have any name).
+
+Allowed folders (the same words everywhere): the folder the tool was started in, the repository folder, and the
+operating system's temporary folder (so a test or a scratch run works). A person who keeps logs elsewhere lists the
+extra folders in ``LEAD_DESK_PATH_ROOTS`` (folders separated by ``os.pathsep``). The list is read on every call.
+``anywhere=True`` is for a file the operator names on purpose (the settings file of a real run, which the
+documentation says to keep outside the repository): the checks on the text, the link resolution and the listing
+still apply, but every folder of the machine counts as allowed. That fences nothing; it only makes the result a path
+that exists as the listing reports it.
+
+What is refused, each with a message that names the argument and never prints the value: not text or a path; empty;
+a NUL or another control character; longer than ``MAX_PATH_CHARS``; a path that cannot be resolved; a link loop (a
+link that still is a link after resolution); a folder on the path that does not exist or cannot be listed; a path
+whose real location is outside every allowed folder (``..``, absolute path, link that leaves the folder, other drive).
+
+What this is NOT: a defence against a person or an agent that controls the shell (it can start the tool in another
+folder or set ``LEAD_DESK_PATH_ROOTS``). It fences a wrong argument. It also does not defend against a second local
+process that swaps a folder for a link between the check and the open (two steps; the tools are single-user command
+lines). On a case-insensitive file system that is not Windows (macOS default) the folders of a path must be written
+in the case the file system reports.
+
+``readonly_sqlite_uri`` builds the connection string for a read-only SQLite file: the path, percent-encoded by
+``Path.as_uri`` (a ``?`` or ``#`` in a file name cannot start a new option), plus the fixed option ``mode=ro``. It does
+not check the place: ``confine`` the path first.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import string
+import tempfile
+from collections.abc import Sequence
+from pathlib import Path
+
+MAX_PATH_CHARS = 4096  # a whole path, in characters (the usual Linux limit; Windows allows less)
+MAX_NAME_CHARS = 255  # one file name of a NEW file
+ROOTS_ENV = "LEAD_DESK_PATH_ROOTS"
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+# C0 (U+0000-U+001F), DEL and C1 (U+0080-U+009F): NUL ends a name early in C code, the rest reorder or hide text
+_CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")
+# the characters a NEW file's name may use, as a table: each character of the name is looked up here and the table's
+# own value is used, so the new name is built from this table and not copied from the argument
+_NAME_CHARS = {c: c for c in string.ascii_letters + string.digits + "._-"}
+
+
+class PathRefused(ValueError):
+    """A path argument was refused. The text names the argument and the rule, never the value."""
+
+
+def allowed_roots() -> tuple[str, ...]:
+    """The real locations of the allowed folders: current folder, repository, temporary folder, and the extra
+    folders in ``LEAD_DESK_PATH_ROOTS``. A listed folder that is empty text is ignored."""
+    extra = [p for p in os.environ.get(ROOTS_ENV, "").split(os.pathsep) if p]
+    candidates = [os.getcwd(), str(REPO_ROOT), tempfile.gettempdir(), *extra]
+    return tuple(dict.fromkeys(os.path.realpath(c) for c in candidates))
+
+
+def _anchors() -> tuple[str, ...]:
+    """The top of the file system (the current drive, and every drive that exists on Windows)."""
+    tops = [os.path.abspath(os.sep)]
+    if os.name == "nt":
+        tops += [f"{d}:\\" for d in string.ascii_uppercase if os.path.isdir(f"{d}:\\")]
+    return tuple(dict.fromkeys(tops))
+
+
+def _inside(real: str, root: str) -> bool:
+    """True when ``real`` is ``root`` or lies below it. Compared with ``os.path.commonpath`` after ``normcase``
+    (Windows ignores case); a path on another drive makes commonpath raise, which counts as outside."""
+    try:
+        return os.path.commonpath([os.path.normcase(real), os.path.normcase(root)]) == os.path.normcase(root)
+    except ValueError:
+        return False
+
+
+def _new_name(name: str, what: str) -> str:
+    """A file name that is not in the listing yet, rebuilt from the table of allowed characters."""
+    if len(name) > MAX_NAME_CHARS or not name.strip("."):
+        raise PathRefused(f"{what}: not usable as the name of a new file")
+    try:
+        return "".join(_NAME_CHARS[c] for c in name)
+    except KeyError:
+        raise PathRefused(f"{what}: the name of a new file may only use letters, digits, '.', '_' and '-'") from None
+
+
+def _locate(root: str, parts: list[str], what: str) -> str:
+    """Walk ``parts`` below ``root`` through directory listings; the result is the listing's own path text."""
+    current = root
+    for index, part in enumerate(parts):
+        last = index == len(parts) - 1
+        try:
+            with os.scandir(current) as listing:
+                entry = next((e for e in listing if os.path.normcase(e.name) == os.path.normcase(part)), None)
+        except OSError:
+            raise PathRefused(f"{what}: a folder on the path cannot be listed") from None
+        if entry is None:
+            if not last:
+                raise PathRefused(f"{what}: a folder on the path does not exist")
+            return os.path.join(current, _new_name(part, what))
+        if entry.is_symlink():  # resolution removed every link that works: what is left is a loop
+            raise PathRefused(f"{what}: a link on the path does not resolve (a loop)")
+        if not last and not entry.is_dir(follow_symlinks=False):
+            raise PathRefused(f"{what}: a folder on the path is not a folder")
+        current = entry.path
+    return current
+
+
+def confine(
+    path: str | os.PathLike[str],
+    *,
+    what: str,
+    roots: Sequence[str | os.PathLike[str]] | None = None,
+    anywhere: bool = False,
+) -> Path:
+    """The real location of ``path``, refused unless it lies inside an allowed folder (``roots``, or the defaults in
+    ``allowed_roots``; ``anywhere`` allows every folder). ``what`` names the argument in the error, for example
+    ``"--log"``. The file itself need not exist (an output file is confined the same way); links in the path are
+    followed, so a link that leaves the folder is refused. Returns a ``Path`` built from the directory listing (see
+    the module text), never from the argument."""
+    if not isinstance(path, (str, os.PathLike)):
+        raise PathRefused(f"{what}: not a path")
+    text = os.fspath(path)
+    if not isinstance(text, str) or not text.strip():
+        raise PathRefused(f"{what}: empty path")
+    if _CONTROL.search(text):
+        raise PathRefused(f"{what}: contains a control character")
+    if len(text) > MAX_PATH_CHARS:
+        raise PathRefused(f"{what}: path too long")
+    if anywhere:
+        allowed: tuple[str, ...] = _anchors()
+    elif roots is None:
+        allowed = allowed_roots()
+    else:
+        allowed = tuple(os.path.realpath(r) for r in roots)
+    try:
+        real = os.path.realpath(text)  # follows links, removes "..", makes it absolute
+    except (OSError, RuntimeError, ValueError) as exc:  # a link loop, a NUL, an unreadable folder
+        raise PathRefused(f"{what}: cannot be resolved") from exc
+    for root in allowed:
+        if _inside(real, root):
+            relative = os.path.relpath(real, root)
+            return Path(_locate(root, [] if relative == os.curdir else relative.split(os.sep), what))
+    raise PathRefused(f"{what}: path is outside the allowed folders (add a folder with {ROOTS_ENV})")
+
+
+def readonly_sqlite_uri(path: str | os.PathLike[str]) -> str:
+    """``file:`` connection string that opens an existing SQLite file read-only. The path is made absolute and
+    percent-encoded by ``Path.as_uri`` (a ``?`` or ``#`` in a file name cannot start a new option); the only text added
+    is the fixed option, never a value from the caller. It does not check WHERE the file is: the caller confines the
+    path first (``confine``) when it came from a command line."""
+    return Path(path).absolute().as_uri() + "?mode=ro"
