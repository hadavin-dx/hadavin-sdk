+# ---- writes2 (the second push): the facts write of load_driver is INLINE, the scrub output is the HELPER ----
+
+
+def test_writes2_inline_facts_write_and_helper_scrub_write(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    inside, outside = jail
+    for bad in (outside / "f.json", Path("../outside/f.json"), Path("a\x00b")):
+        with pytest.raises(ValueError, match="outside"):
+            load_driver.run("http://127.0.0.1:1", "burst:1", inside / "l.jsonl", bad, 1, 1, 1, "p")
+    assert not list(outside.iterdir()) and not list(inside.iterdir())
+    wf = json.dumps({"name": "w", "nodes": []})
+    (inside / "in.json").write_text(wf, encoding="utf-8")
+    assert scrub_n8n_export.main(["x", "in.json", "new name.json"]) == 2  # the helper's new-name rule
