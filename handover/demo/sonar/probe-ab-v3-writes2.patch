+    assert scrub_n8n_export.main(["x", "in.json", "o.json"]) == 0
+    monkeypatch.setenv(ROOTS_ENV, str(outside))
+    assert scrub_n8n_export.main(["x", "in.json", str(outside / "o.json")]) == 0
