+def _present(rows: list[tuple[object, ...]]) -> list[object]:
+    """The rows as pytest params. Only a row about a file under demo_only/ can be skipped, and only when that whole
+    folder was deleted (a client copy). A product row, a typo in a path, or one demo file missing while the folder is
+    there is not skipped: it runs and fails with FileNotFoundError."""
+    demo_gone = not (REPO / DEMO_DIR).is_dir()
+    return [
+        pytest.param(
+            *r,
+            id=_ids([r])[0],
+            marks=pytest.mark.skipif(
+                demo_gone and str(r[0]).startswith(DEMO_DIR + "/"), reason=f"{r[0]}: {DEMO_DIR}/ was removed"
+            ),
+        )
+        for r in rows
+    ]
+
+
