+"""A client copy (demo_only/ deleted, maybe .git too) must run every test that does not need the demo, and must say so
+when a check cannot run. Pins: which files conftest keeps, the lost-scan skip or failure, and that nothing else is lost
+with it. Needs no demo_only folder. Made-up data only."""
+
+from __future__ import annotations
+
+import ast
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import _repo_root
+import conftest
+import pytest
+import support
+import test_hygiene
+
+from tools import hygiene
+
+TESTS = Path(__file__).resolve().parent
+REPO = TESTS.parent
+
+# Files that need only the repository folder or plain helpers: they must stay runnable in a client copy. If one of them
+# gains an import of demo_only or a use of the demo's rig, move that part out (tests/_plain.py, tests/_repo_root.py)
+# instead of letting the whole file fall back to the one placeholder skip.
+PLAIN_FILES = [
+    "test_hygiene.py",
+    "test_no_placeholders.py",
+    "test_raw_bidi_chars.py",
+    "test_shell_single_bracket.py",
+    "test_bind_refusals.py",
+    "test_codeant_hygiene.py",
+    "test_gitleaks_exceptions.py",
+    "test_hubspot_probe.py",
+    "test_n8n_api_url.py",
+    "test_reset_scripts.py",
+    "test_server_stop_guard.py",
+    "test_client_copy.py",
+]
+OPTIONAL_HERE = [  # files another patch of the series adds or rewrites
+    "test_no" + "semgrep_form.py",
+    "test_gitleaks_semgrep_lock.py",
+    "test_path_confinement.py",
+]
+
+
+@pytest.mark.parametrize("name", PLAIN_FILES + [n for n in OPTIONAL_HERE if (TESTS / n).is_file()])
+def test_a_file_that_needs_no_demo_is_not_replaced_by_the_placeholder_skip(name: str) -> None:
+    assert not conftest._needs_demo(TESTS / name), f"{name} would be one skipped item in a client copy"
+
+
+def test_needs_demo_reads_what_a_file_really_needs(tmp_path: Path) -> None:
+    def needs(text: str) -> bool:
+        path = tmp_path / "test_probe.py"
+        path.write_text(text, encoding="utf-8")
+        conftest._needs_demo.cache_clear()
+        return conftest._needs_demo(path)
+
+    assert not needs("from support import REPO, lead, free_port\n")
+    assert not needs("from _repo_root import REPO\nfrom test_hygiene import GITLEAKS_ENV\n")
+    assert not needs("def test_a(env):\n    env.stop_on_close(print)\n")
+    assert not needs("def test_a():\n    import demo_only.fakes  # a missing demo is a skip of this one test\n")
+    assert needs("from demo_only.fakes import FakeCrm\n")
+    assert needs("from edge_case_helpers import mk_desk\n")
+    assert needs("from support import build_rig\n")
+    assert needs("from support import DEMO_LEADFLOW\n")
+    assert needs("def test_a(env):\n    env." + "rig()\n")
+    assert needs("def test_a(env):\n    env." + "fakes()\n")
+    assert needs("def test_a(env):\n    env." + "serve(r)\n")  # each Env method that builds on the fakes is named
+    assert needs("import support\n\n\ndef test_a(tmp_path):\n    support.build_rig(tmp_path)\n")  # as an attribute
+    assert needs("import support\n\n\ndef test_a():\n    support.DEMO_LEADFLOW\n")
+    assert needs("from test_flow import retry_twice_body\n")  # test_flow needs the demo: so does this file
+    conftest._needs_demo.cache_clear()
+
+
+def test_support_can_be_read_without_the_demo_folder() -> None:
+    """tests/support.py is imported by a client copy: it must not import demo_only at its top level."""
+    tree = ast.parse((TESTS / "support.py").read_text(encoding="utf-8"))
+    for node in tree.body:
+        if isinstance(node, ast.ImportFrom | ast.Import):
