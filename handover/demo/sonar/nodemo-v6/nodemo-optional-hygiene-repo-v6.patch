+def _client_copy(dest: Path, extra_tests: tuple[str, ...] = (), stub_demo: bool = False) -> Path:
+    """A minimal copy of this repository without demo_only and without .git, with the tests that scan it. With
+    stub_demo a demo_only folder that holds nothing but the names conftest imports is put in: "the demo is here"."""
+    for sub in ("src", "tools"):
+        shutil.copytree(REPO / sub, dest / sub, ignore=shutil.ignore_patterns("__pycache__"))
+    (dest / "tests").mkdir()
+    for rel in [*CLIENT_FILES, "tests/test_raw_bidi_chars.py", "pyproject.toml", *extra_tests]:
+        shutil.copy(REPO / rel, dest / rel)
+    if stub_demo:
+        (dest / "demo_only").mkdir()
+        (dest / "demo_only" / "__init__.py").write_text("", encoding="utf-8")
+        (dest / "demo_only" / "fakes_server.py").write_text(STUB_FAKES_SERVER, encoding="utf-8")
+        (dest / "demo_only" / "leadflow.json").write_text("{}", encoding="utf-8")
+    return dest
