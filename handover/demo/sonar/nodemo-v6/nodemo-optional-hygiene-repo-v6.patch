+def _pytest_in(
+    copy: Path, cwd: Path, test: str = "test_raw_bidi_chars.py", **env: str
+) -> subprocess.CompletedProcess[str]:
+    base = {k: v for k, v in os.environ.items() if not k.startswith(("DPLD_", "DESK_", "PYTEST_"))}
+    args = ["-m", "pytest", "-q", "-p", "no:cacheprovider", "-rsf", "--rootdir", str(copy)]
+    proc = support.start_proc(
+        [*args, "-c", str(copy / "pyproject.toml"), str(copy / "tests" / test)], {**base, **env}, cwd
+    )
+    try:
+        out, _ = proc.communicate(timeout=300)  # stdout and stderr are one stream
+    finally:
+        if proc.poll() is None:
+            proc.kill()
+            proc.wait()
+    return subprocess.CompletedProcess(proc.args, proc.returncode, out.decode("utf-8", "replace"), "")
+
