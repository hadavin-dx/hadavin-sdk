@@ -0,0 +1,71 @@
+"""The repository folder, found from this file, and the check the repository scans share. Needs no demo_only folder.
+
+Many test files only need the repository folder (the Trojan-Source scan, the shell and Semgrep form checks, the
+gitleaks tests); they must run in a client copy, where demo_only/ is deleted, so they take it from here and not from a
+file that imports the demo. A client copy may also come without `.git` (a source archive): the tests that list this
+repository's tracked files with git then cannot scan anything. That is a lost check, not a pass: it is a skip that says
+so and how to run the scan, and with DPLD_REQUIRE_SCAN=1 (the setting CI uses) it is a failure."""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+REQUIRE_SCAN_ENV = "DPLD_REQUIRE_SCAN"  # the same variable as tests/test_hygiene.py: set (CI) = a lost scan fails
+MARKER = "pyproject.toml"  # a file every copy of this repository tracks: if git does not list it, git lists nothing
+
+
+def _scan_gap(repo: Path) -> str | None:
+    from tools import hygiene  # here, not at the top: a copy that holds only this folder's helpers has no tools/
+
+    try:
+        listed = hygiene._git_text(repo, "ls-files", "--", MARKER)
+    except subprocess.CalledProcessError as e:
+        said = " ".join((e.stderr or "").split())  # git's own words: the real cause (not a git folder, ownership ...)
+        if "not a git repository" in said:
+            return f"this folder is not a git work tree (a source archive or a copy without .git); git says: {said}"
+        return f"git refused to list the tracked files (exit {e.returncode}); git says: {said or '(nothing)'}"
+    except (OSError, subprocess.SubprocessError) as e:
+        return f"git cannot be run here ({type(e).__name__})"
+    if listed.strip() != MARKER:
+        return f"git lists no tracked {MARKER} here (no .git of its own, or `git add` was never run)"
+    return None
+
+
+def repo_scan_gap(repo: Path | None = None) -> str | None:
+    """None when git lists this repository's tracked files (a clone, a linked worktree, a submodule, a sub-folder
+    that its parent repository tracks); else the lost-scan message: what is wrong, what was lost, how to run it.
+    This asks git, not `.git`: a `git init` with nothing added has a `.git` and lists nothing, so a scan would pass
+    on no files (measured, a planted address literal is not found there)."""
+    why = _scan_gap(repo or REPO)
+    if why is None:
+        return None
+    return (
+        f"the scan of this repository's tracked files was NOT run: {why}. A client copy without .git cannot run it. "
+        f"To run it: use a git clone, or run `git init && git add -A` in {repo or REPO}. "
+        f"With {REQUIRE_SCAN_ENV}=1 (as CI sets it) this is a failure, not a skip."
+    )
+
+
+def scan_required() -> bool:
+    """True when DPLD_REQUIRE_SCAN is set (not empty): a lost scan must fail, as tests/test_hygiene.py does for a
+    missing gitleaks program."""
+    return bool(os.environ.get(REQUIRE_SCAN_ENV))
+
+
+# The tests that list this repository's tracked files with git. tests/conftest.py ends each of them as a skip that
+# says the scan was lost (or, with DPLD_REQUIRE_SCAN set, as a failure) when git lists nothing; one place, so a test
+# file that another patch adds needs no edit. (tests/test_client_copy.py checks every name here is a real test.)
+SCAN_TESTS = frozenset(
+    {
+        ("test_hygiene.py", "test_no_control_characters_in_markdown"),
+        ("test_hygiene.py", "test_sh_blobs_no_cr"),
+        ("test_hygiene.py", "test_the_secret_scan_files_have_no_carriage_return"),
+        ("test_no_placeholders.py", "test_no_placeholder_text_ships"),
+        ("test_no" + "semgrep_form.py", "test_no_bare_no" + "semgrep_comment"),
+        ("test_raw_bidi_chars.py", "test_no_tracked_file_holds_a_raw_direction_control_character"),
+        ("test_shell_single_bracket.py", "test_no_tracked_script_or_workflow_run_block_holds_a_single_bracket_test"),
+    }
+)
