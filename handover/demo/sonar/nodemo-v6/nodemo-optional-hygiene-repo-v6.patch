+def test_the_scan_gap_asks_git_what_it_lists_not_whether_dot_git_exists(tmp_path: Path) -> None:
+    """Measured: a folder with no .git, a `git init` with nothing added (it has a .git, lists nothing, and a scan would
+    pass on no files) and a sub-folder its parent repository does not track all lose the scan; a clone, a linked
+    worktree (its .git is a FILE) and a sub-folder its parent repository tracks keep it."""
+
+    def folder(name: str, parent: Path = tmp_path) -> Path:
+        path = parent / name
+        path.mkdir()
+        (path / _repo_root.MARKER).write_text("x\n", encoding="utf-8")
+        return path
+
+    gap = _repo_root.repo_scan_gap
+    assert gap(folder("archive")), "no .git at all"
+    initial = folder("init_only")
+    _bare_git(initial, "init", "-q")
+    assert (initial / ".git").is_dir()
+    assert gap(initial), "a .git with an empty index lists nothing"
+    _bare_git(initial, "add", "-A")
+    _bare_git(initial, "commit", "-q", "-m", "m")
+    assert gap(initial) is None, "a clone"
+    linked = tmp_path / "linked"
+    _bare_git(initial, "worktree", "add", "-q", str(linked))
+    assert (linked / ".git").is_file()
+    assert gap(linked) is None, ".git as a file is a work tree"
+    parent = tmp_path / "parent"
+    parent.mkdir()
+    _bare_git(parent, "init", "-q")
+    inner = folder("inner", parent)
+    assert gap(inner), "inside another repository that does not track it"
+    _bare_git(parent, "add", "-A")
+    assert gap(inner) is None, "inside another repository that tracks it"
+    text = gap(folder("archive2")) or ""
+    for must in ("NOT run", "git add -A", _repo_root.REQUIRE_SCAN_ENV, "failure"):
+        assert must in text, (must, text)  # what was lost, how to run it, and that CI fails instead
+    assert _repo_root.REQUIRE_SCAN_ENV == test_hygiene.REQUIRE_SCAN_ENV
+
