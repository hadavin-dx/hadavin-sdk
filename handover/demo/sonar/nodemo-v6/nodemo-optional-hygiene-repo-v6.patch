+def test_the_canary_checks_still_run_where_only_the_repository_scan_is_lost(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """test_hygiene_scan_public checks its canaries before it reads the repository: with git out of reach it must get
+    that far (a canary that no rule matches fails it) and only then end as a skip, or as a failure in CI."""
+    gap = "GAP-TEXT: the scan was NOT run"
+    monkeypatch.setattr(test_hygiene, "repo_scan_gap", lambda *_: gap)
+    monkeypatch.delenv(test_hygiene.REQUIRE_SCAN_ENV, raising=False)
+    with pytest.raises(pytest.skip.Exception, match="GAP-TEXT"):
+        test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "a"))
+    monkeypatch.setenv(test_hygiene.REQUIRE_SCAN_ENV, "1")
+    with pytest.raises(pytest.fail.Exception, match="GAP-TEXT"):
+        test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "b"))
+    # a rule that stopped matching its canary is still found before the skip
+    monkeypatch.delenv(test_hygiene.REQUIRE_SCAN_ENV)
+    monkeypatch.setitem(test_hygiene.hygiene.CANARIES, "never matched", "zz-no-rule-matches-this-zz")
+    try:
+        with pytest.raises(AssertionError, match="canary not found"):
+            test_hygiene.test_hygiene_scan_public(_fresh(tmp_path, "c"))
+    except pytest.skip.Exception:
+        pytest.fail("the test ended as a skip before its canary checks ran")
