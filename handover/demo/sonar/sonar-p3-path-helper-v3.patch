+    cfg = outside / "a" / "b" / "cfg.env"
+    cfg.parent.mkdir(parents=True)
+    cfg.write_text("A=1\n", encoding="utf-8")
+    _scandir_refusing(monkeypatch, outside / "a")
+    assert pc.confine(cfg, what="--config", anywhere=True) == cfg.resolve()  # like an unchecked open()
+    with pytest.raises(pc.PathRefused, match="cannot be listed"):  # inside the allowed folders it stays a refusal
+        pc.confine(outside / "a" / "b" / "cfg.env", what="--config", roots=[outside])
+    with pytest.raises(pc.PathRefused, match="no such file"):  # a missing file is still refused
+        pc.confine(outside / "a" / "b" / "nope.env", what="--config", anywhere=True)
