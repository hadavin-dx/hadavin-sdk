+def test_only_the_top_of_a_file_system_and_the_home_folder_are_wide(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """A folder ABOVE the home folder is allowed as the working folder: the rule names exactly two wide folders."""
+    home = tmp_path / "home" / "me"
+    home.mkdir(parents=True)
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setenv("USERPROFILE", str(home))
+    monkeypatch.chdir(home.parent)
+    assert str(home.parent.resolve()) in pc.allowed_roots()
+    for text in (
+        (REPO / "docs" / "settings.md").read_text(encoding="utf-8"),
+        (REPO / "load_tools" / "README.md").read_text(encoding="utf-8"),
+    ):
+        assert "Only these two count as wide" in text and "`/home`" in text
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="creating a symbolic link needs a privilege on Windows")
+def test_a_home_folder_that_is_a_link_is_compared_by_its_real_location(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """``HOME`` is a link to the folder the tool was started in: the home folder is compared by its real location."""
+    real, link = tmp_path / "real-home", tmp_path / "home-link"
+    real.mkdir()
+    link.symlink_to(real, target_is_directory=True)
+    monkeypatch.setenv("HOME", str(link))
+    monkeypatch.setenv("USERPROFILE", str(link))
+    monkeypatch.chdir(real)
+    assert str(real.resolve()) not in pc.allowed_roots()
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="creating a symbolic link needs a privilege on Windows")
+def test_a_working_folder_that_is_a_link_to_the_home_folder_is_compared_by_its_real_location(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """The folder the tool was started in is reported as a link to the home folder: links are followed first."""
+    home, link = tmp_path / "home2", tmp_path / "cwd-link"
+    home.mkdir()
+    link.symlink_to(home, target_is_directory=True)
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setenv("USERPROFILE", str(home))
+    monkeypatch.setattr(os, "getcwd", lambda: str(link))
+    assert str(home.resolve()) not in pc.allowed_roots()
+    assert str(link) not in pc.allowed_roots()
+
+
+def test_a_wide_folder_named_in_the_roots_variable_is_taken_as_written(
+    jail: tuple[Path, Path], monkeypatch: pytest.MonkeyPatch, tmp_path: Path
+) -> None:
+    """``LEAD_DESK_PATH_ROOTS`` may name the top of a file system or the home folder: a person's own choice."""
+    home = tmp_path / "home3"
+    home.mkdir()
+    (home / "f.json").write_text("{}", encoding="utf-8")
+    monkeypatch.setenv("HOME", str(home))
+    monkeypatch.setenv("USERPROFILE", str(home))
+    top = os.path.realpath(os.path.abspath(os.sep))
+    monkeypatch.chdir(tmp_path)
+    for named in (str(home), top):
+        monkeypatch.setenv(pc.ROOTS_ENV, named)
+        assert os.path.realpath(named) in pc.allowed_roots()
+    monkeypatch.setenv(pc.ROOTS_ENV, str(home))
+    assert pc.confine_existing(home / "f.json", what="f") == home.resolve() / "f.json"
+
+
