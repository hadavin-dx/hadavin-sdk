@@ -0,0 +1,52 @@
+"""n8n/proof.json: the result line says PASS only when all ten requests got a verdict AND one email and one CRM row
+exist. The expression is cut out of the file and run in node with stand-in node outputs (n8n itself is not run)."""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+PROOF = Path(__file__).resolve().parents[1] / "n8n" / "proof.json"
+needs_node = pytest.mark.skipif(shutil.which("node") is None, reason="node is not installed")
+TEN_OK = ",".join(["new"] + ["duplicate"] * 9)
+
+
+def _expression() -> str:
+    flow = json.loads(PROOF.read_text(encoding="utf-8"))
+    node = next(n for n in flow["nodes"] if n["name"] == "Show the result")
+    value = next(a["value"] for a in node["parameters"]["assignments"]["assignments"] if a["name"] == "result")
+    assert value.startswith("={{ ") and value.endswith(" }}")
+    return value[4:-3]
+
+
+def _result(statuses: str, emails: int, crm: int) -> str:
+    data = {
+        "Wait for the desk to finish": {"statuses": statuses},
+        "Read the demo outbox": {"count": emails},
+        "Read the demo CRM": {"count": crm},
+    }
+    js = (
+        "const data = JSON.parse(process.argv[1]); const $ = (n) => ({ item: { json: data[n] } }); console.log("
+        + _expression()
+        + ");"
+    )
+    done = subprocess.run(["node", "-e", js, json.dumps(data)], capture_output=True, text=True, check=True)  # noqa: S603, S607
+    return done.stdout.strip()
+
+
+@needs_node
+def test_pass_needs_all_ten_answers_and_one_email_and_one_crm_row() -> None:
+    assert _result(TEN_OK, 1, 1) == "PASS"
+    assert _result(TEN_OK, 2, 1) == "MISMATCH"
+    assert _result(TEN_OK, 1, 0) == "MISMATCH"
+
+
+@needs_node
+def test_nine_lost_requests_are_not_a_pass() -> None:
+    nine_lost = ",".join(["new"] + ["no verdict"] * 9)
+    assert _result(nine_lost, 1, 1) == "MISMATCH"
+    assert _result("new,duplicate", 1, 1) == "MISMATCH"  # fewer than ten answers at all
