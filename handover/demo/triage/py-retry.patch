diff --git a/tests/test_except_clause_hierarchy.py b/tests/test_except_clause_hierarchy.py
new file mode 100644
index 0000000..04728ee
--- /dev/null
+++ b/tests/test_except_clause_hierarchy.py
@@ -0,0 +1,45 @@
+"""Pins the class relationships that the shortened `except` clauses rely on (made-up data only).
+
+Several clauses used to name both a class and its parent (UnicodeError and ValueError, TimeoutError and OSError, ...)
+or re-raised one class by hand just before a broader clause. They were shortened because the parent already catches
+the child and the re-raised class is not caught by the broader clause. If a class below ever moves, these tests
+fail and the clauses must be looked at again."""
+
+import http.client
+import socket
+import ssl
+import urllib.error
+
+import pytest
+
+from lead_desk import crm_hubspot, live_claude
+
+
+def test_children_are_caught_by_the_parent_named_in_the_shortened_clauses() -> None:
+    assert issubclass(UnicodeError, ValueError)  # config.py, smtp_outbox.py, smtp_provider.py
+    assert issubclass(TimeoutError, OSError)  # smtp_outbox.py, smtp_provider.py, load_tools/catcher.py
+    assert issubclass(urllib.error.URLError, OSError)  # live_claude.py
+    assert issubclass(socket.timeout, OSError)  # live_claude.py
+    assert issubclass(ssl.SSLError, OSError)  # demo_only/fake_imap.py, demo_only/fake_smtp_tls.py
+
+
+@pytest.mark.parametrize("error", [crm_hubspot.CrmError, live_claude.LiveCapReached])
+def test_the_handed_on_errors_are_not_caught_by_the_broader_clause_after_them(error: type[BaseException]) -> None:
+    broader = {
+        crm_hubspot.CrmError: (OSError, ValueError, http.client.HTTPException),
+        live_claude.LiveCapReached: (
+            ValueError,
+            KeyError,
+            TypeError,
+            ArithmeticError,
+            RecursionError,
+            OSError,
+            MemoryError,
+        ),
+    }[error]
+    assert not issubclass(error, broader)
+    with pytest.raises(error):
+        try:
+            raise error("x")
+        except broader:  # would swallow the error if the classes were related
+            pytest.fail("the broader clause caught it")
