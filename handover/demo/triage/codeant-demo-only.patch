+++ b/tests/test_codeant_demo_only.py
@@ -0,0 +1,85 @@
+"""Findings about demo_only/ from the CodeAnt review: the demo extension learns the desk's real port when the desk
+listens on port 0. Made-up data, loopback only."""
+
+from __future__ import annotations
+
+from dataclasses import replace
+from typing import Any
+
+import pytest
+from test_portal_demo import wired
+
+from lead_desk import server
+
+
+def test_the_demo_extension_gets_the_real_port_when_the_desk_listens_on_port_zero(env: Any) -> None:
+    _, furl = env.fakes("blind", "keyed")
+    rig = wired(env, furl)
+    srv = server.make_server(rig.desk, replace(rig.desk.config, port=0, bind="127.0.0.1"))
+    try:
+        demo = srv.demo
+        assert demo is not None
+        assert demo.desk_url == f"http://127.0.0.1:{srv.server_address[1]}"
+    finally:
+        srv.server_close()
+
+
+def test_a_fixed_port_keeps_the_address_from_the_settings(env: Any) -> None:
+    _, furl = env.fakes("blind", "keyed")
+    rig = wired(env, furl)
+    from demo_only.portal_demo import make
+
+    d = make(rig.desk)
+    d.desk_url = "http://127.0.0.1:1"
+    d.set_bound_address("127.0.0.1", 55555)
+    assert d.desk_url == "http://127.0.0.1:1"  # an address that is already known is never replaced
+
+
+def test_the_burst_summary_counts_slots_that_got_no_http_answer() -> None:
+    """demo_only/portal_demo.js `describe` is cut out of the file and run in node: a slot that ended as 'timeout' or
+    'error' (a word, not a status number) must show in the pills, not vanish."""
+    import json
+    import re
+    import shutil
+    import subprocess
+    from pathlib import Path
+
+    if shutil.which("node") is None:
+        pytest.skip("node is not installed")
+    src = (Path(__file__).resolve().parents[1] / "demo_only" / "portal_demo.js").read_text(encoding="utf-8")
+    start = src.index("  function describe(r, label) {")
+    end = src.index("\n  }\n", start) + 4
+    answers = [
+        {"ref": "a", "status": 201, "verdict": "new", "replayed": False},
+        {"ref": "b", "status": 200, "verdict": "duplicate", "replayed": False},
+        {"ref": "c", "status": "timeout", "verdict": None, "replayed": False},
+        {"ref": "d", "status": "error", "verdict": None, "replayed": False},
+        {"ref": "e", "status": 400, "verdict": None, "replayed": False},
+    ]
+    js = (
+        "function h(tag, attrs) { const k = []; for (let i = 2; i < arguments.length; i++) { const x = arguments[i];"
+        " if (Array.isArray(x)) k.push(...x); else if (x !== null && x !== undefined) k.push(x); } return { tag, k,"
+        " appendChild(x) { k.push(x); return x; } }; }\n"
+        "const P = { icon: () => '', shownRef: (r) => r };\n"
+        + src[start:end]
+        + "\nconst text = (n) => typeof n === 'string' ? n : (n && n.k ? n.k.map(text).join(' ') : '');\n"
+        "const out = describe({ data: { answers: JSON.parse(process.argv[1]) } }, 'x');\n"
+        "console.log(JSON.stringify(text(out.k[1])));\n"
+    )
+    done = subprocess.run(["node", "-e", js, json.dumps(answers)], capture_output=True, text=True, check=True)  # noqa: S603, S607
+    pills = re.sub(r"\s+", " ", json.loads(done.stdout))
+    assert "1 refused" in pills and "2 without an answer" in pills, pills
+
+
+def test_every_request_of_the_double_press_check_frees_the_button_when_it_gets_no_answer() -> None:
+    """Source check, not a browser run: each P.api call inside the double-press click handler (the two presses, the
+    desk summary poll and the demo state read) must have a rejection handler that frees the button (dblFail)."""
+    from pathlib import Path
+
+    src = (Path(__file__).resolve().parents[1] / "demo_only" / "portal_demo.js").read_text(encoding="utf-8")
+    block = src[src.index("dbl.addEventListener('click'") :]
+    block = block[: block.index("\n      });\n") + 1]
+    assert block.count("P.api(") == 4  # the two presses (one Promise.all), the summary poll, the state read
+    assert block.count(", dblFail)") == 3, block.count(
+        ", dblFail)"
+    )  # the Promise.all, the summary poll, the state read
diff --git a/tests/test_codeant_fakes.py b/tests/test_codeant_fakes.py
new file mode 100644
index 0000000..16938a2
--- /dev/null
+++ b/tests/test_codeant_fakes.py
@@ -0,0 +1,165 @@
+"""Findings about the stand-in servers of demo_only/ (made-up data, loopback only): the fake HubSpot changes and reads
+its contacts under one lock; its fault counters count exactly; the fake AI server answers a bad control value without
+crashing and starts "mixed" with hot."""
+
+from __future__ import annotations
+
+import json
+import sys
+import threading
+import urllib.error
+import urllib.request
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from demo_only import fake_hubspot as fh
+from demo_only import fake_model_server as fm
+
+KEY = "k" + "e" * 15 + "-for-tests-0002"  # built from parts; not a real key
+OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+SEARCH = {"filterGroups": [{"filters": [{"propertyName": "hadavin_lead_id", "operator": "EQ", "value": "L1"}]}]}
+
+
+def _post(url: str, body: Any, key: str = KEY) -> tuple[int, Any]:
+    req = urllib.request.Request(  # noqa: S310 (loopback)
+        url, json.dumps(body).encode(), {"Content-Type": "application/json", "Authorization": "Bearer " + key}
+    )
+    try:
+        with OPENER.open(req, timeout=10) as r:
+            return r.status, json.loads(r.read() or b"null")
+    except urllib.error.HTTPError as e:
+        return e.code, None
+
+
+class _WatchedDict(dict):  # type: ignore[type-arg]
+    """A dict that notes when it is read or changed while its owner's lock is NOT held."""
+
+    def __init__(self, state: fh.HubspotState) -> None:
+        super().__init__()
+        self.state, self.unlocked_reads = state, 0
+
+    def items(self):  # type: ignore[no-untyped-def]
+        if not self.state.lock.locked():
+            self.unlocked_reads += 1
+        return super().items()
+
+
+def test_the_search_reads_the_contacts_under_the_lock() -> None:
+    state = fh.HubspotState(KEY, "ok")
+    watched = _WatchedDict(state)
+    state.contacts = watched
+    srv, th, url = fh.serve(state, "127.0.0.1")
+    try:
+        state.create_if_absent({"email": "a@example.test", "hadavin_lead_id": "L1"})
+        status, body = _post(url + "/crm/v3/objects/contacts/search", SEARCH)
+        assert status == 200 and body["total"] == 1
+        assert watched.unlocked_reads == 0
+    finally:
+        fh.stop(srv, th, state)
+
+
+def test_a_fault_mode_counts_exactly_the_configured_number_of_faults_for_threads_that_arrive_together() -> None:
+    old = sys.getswitchinterval()
+    sys.setswitchinterval(1e-6)
+    try:
+        for _ in range(200):
+            state = fh.HubspotState(KEY, "r429")
+            state.times = 2
+            took: list[bool] = []
+            gate = threading.Barrier(12)
+
+            def one(state: fh.HubspotState = state, took: list[bool] = took, gate: threading.Barrier = gate) -> None:
+                gate.wait()
+                took.append(state.take_failure())
+
+            threads = [threading.Thread(target=one) for _ in range(12)]
+            for t in threads:
+                t.start()
+            for t in threads:
+                t.join()
+            assert took.count(True) == 2 and state.failed == 2
+    finally:
+        sys.setswitchinterval(old)
+
+
+def test_only_one_create_hangs_in_timeout_after_create_mode() -> None:
+    state = fh.HubspotState(KEY, "timeout_after_create")
+    takes = []
+    gate = threading.Barrier(16)
+
+    def one() -> None:
+        gate.wait()
+        takes.append(state.take_hang())
+
+    threads = [threading.Thread(target=one) for _ in range(16)]
+    for t in threads:
+        t.start()
+    for t in threads:
+        t.join()
+    assert takes.count(True) == 1
+
+
+def _ai_call(url: str) -> tuple[int, Any]:
+    body = {"messages": [{"role": "user", "content": "lead id: L1\ne-mail: x@example.test\nAnswer?"}]}
+    req = urllib.request.Request(  # noqa: S310 (loopback)
+        url + "/v1/messages", json.dumps(body).encode(), {"x-api-key": "fake", "Content-Type": "application/json"}
+    )
+    with OPENER.open(req, timeout=10) as r:
+        return r.status, json.loads(r.read())
+
+
+def _control(url: str, body: Any) -> int:
+    req = urllib.request.Request(url + "/control", json.dumps(body).encode(), {"Content-Type": "application/json"})  # noqa: S310
+    try:
+        with OPENER.open(req, timeout=10) as r:
+            return int(r.status)
+    except urllib.error.HTTPError as e:
+        return e.code
+
+
+@pytest.fixture
+def ai(tmp_path: Path):
+    srv, state = fm.make_model_server(control_file=tmp_path / "mode.json")
+    th = threading.Thread(target=srv.serve_forever, daemon=True)
+    th.start()
+    yield f"http://127.0.0.1:{srv.server_address[1]}", state, tmp_path / "mode.json"
+    state.stop.set()
+    srv.shutdown()
+    srv.server_close()
+    th.join(5)
+
+
+def test_a_list_as_mode_in_the_control_file_falls_back_to_the_port_mode(ai: Any) -> None:
+    url, state, control_file = ai
+    control_file.write_text('{"mode": []}', encoding="utf-8")
+    assert state.current_mode() == state.mode
+    assert _ai_call(url)[0] == 200  # the request is answered, not dropped
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        {"mode": []},
+        {"mode": {"a": 1}},
+        {"slow_seconds": "3"},
+        {"hang_seconds": None},
+        {"slow_seconds": -1},
+        {"hang_seconds": True},
+    ],
+)
+def test_a_control_value_of_the_wrong_kind_is_a_400_not_a_dropped_connection(ai: Any, bad: dict[str, Any]) -> None:
+    url, state, _ = ai
+    assert _control(url, bad) == 400
+    assert isinstance(state.slow_seconds, float) and isinstance(state.hang_seconds, float)
+
+
+def test_mixed_mode_starts_with_hot(ai: Any) -> None:
+    url, state, _ = ai
+    assert _control(url, {"mode": "mixed"}) == 200
+    labels = []
+    for _ in range(4):
+        _, answer = _ai_call(url)
+        labels.append(next(c["text"] for c in answer["content"] if c["type"] == "text"))
+    assert labels == ["hot", "warm", "cold", "hot"]
