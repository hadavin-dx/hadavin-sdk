+                if c["properties"].get("hadavin_lead_id") == want
+                and (self.mode != "search_lag" or now - self.created_at[i] >= self.lag)
+            ]
+
+    def patch(self, email: str, props: dict[str, str]) -> dict[str, Any] | None:
