+        on_this_computer = host == "localhost"
+    if parts.scheme.lower() == "http" and on_this_computer:
+        return url.rstrip("/")
+    raise SystemExit("N8N_URL must be an https address, or http to this computer (127.0.0.1, ::1, localhost)")
