diff --git a/tests/test_n8n_api_url.py b/tests/test_n8n_api_url.py
new file mode 100644
index 0000000..3efac04
--- /dev/null
+++ b/tests/test_n8n_api_url.py
@@ -0,0 +1,59 @@
+"""scripts/n8n_api.py sends the n8n API key in a header: it must only go to https, or to http on this computer."""
+
+from __future__ import annotations
+
+import importlib
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def _load(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, url: str | None):
+    key = tmp_path / "key.txt"
+    key.write_text("made-up-key-for-the-test\n", encoding="utf-8")
+    monkeypatch.setenv("N8N_API_KEY_FILE", str(key))
+    if url is None:
+        monkeypatch.delenv("N8N_URL", raising=False)
+    else:
+        monkeypatch.setenv("N8N_URL", url)
+    monkeypatch.syspath_prepend(str(REPO / "scripts"))
+    sys.modules.pop("n8n_api", None)
+    return importlib.import_module("n8n_api")
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        None,
+        "http://127.0.0.1:5679/",
+        "http://localhost:5678",
+        "http://[::1]:5678",
+        "https://n8n.example.test",
+        "HTTPS://N8N.EXAMPLE.TEST/x/",
+    ],
+)
+def test_these_addresses_are_accepted(monkeypatch: pytest.MonkeyPatch, tmp_path: Path, url: str | None) -> None:
+    mod = _load(monkeypatch, tmp_path, url)
+    assert not mod.BASE.endswith("/")
+
+
+@pytest.mark.parametrize(
+    "url",
+    [
+        "http://n8n.example.test:5678",
+        "http://10.0.0.5",
+        "http://localhost.example.test",
+        "ftp://127.0.0.1",
+        "file:///x",
+        "n8n.example.test",
+        "",
+    ],
+)
+def test_these_addresses_are_refused_before_the_key_is_used(
+    monkeypatch: pytest.MonkeyPatch, tmp_path: Path, url: str
+) -> None:
+    with pytest.raises(SystemExit, match="N8N_URL must be"):
+        _load(monkeypatch, tmp_path, url)
diff --git a/tests/test_reset_ps1_links.py b/tests/test_reset_ps1_links.py
new file mode 100644
index 0000000..df907a2
--- /dev/null
+++ b/tests/test_reset_ps1_links.py
@@ -0,0 +1,44 @@
+"""scripts/reset.ps1 must judge the database folder by its REAL path (a symlink or a Windows junction inside data/ that
+points elsewhere must be refused), like scripts/reset.sh does with realpath. PowerShell is not run here: the Python
+check that reset.ps1 hands to `python -c` is cut out of the file and run on a symlink."""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def _check_code() -> str:
+    text = (REPO / "scripts" / "reset.ps1").read_text(encoding="utf-8")
+    assert "GetFullPath" not in text, "reset.ps1 still compares paths that were not resolved"
+    found = re.search(r'\$inside = python -c "(?P<code>[^"]+)" \$dataDir', text)
+    assert found, "reset.ps1 has no real-path check"
+    return found.group("code")
+
+
+def _inside(folder: Path, cwd: Path) -> str:
+    done = subprocess.run(  # noqa: S603 (our own snippet and a path made by the test)
+        [sys.executable, "-c", _check_code(), str(folder)], cwd=cwd, capture_output=True, text=True, check=True
+    )
+    return done.stdout.strip()
+
+
+def test_the_real_path_check_accepts_a_folder_inside_data_and_refuses_a_link_out_of_it(tmp_path: Path) -> None:
+    (tmp_path / "data" / "run").mkdir(parents=True)
+    outside = tmp_path / "elsewhere"
+    outside.mkdir()
+    assert _inside(tmp_path / "data" / "run", tmp_path) == "True"
+    assert _inside(Path("data") / "run", tmp_path) == "True"
+    try:
+        os.symlink(outside, tmp_path / "data" / "link", target_is_directory=True)
+    except (OSError, NotImplementedError):
+        pytest.skip("this computer cannot make a symbolic link")
+    assert _inside(tmp_path / "data" / "link", tmp_path) == "False"
+    assert _inside(outside, tmp_path) == "False"
