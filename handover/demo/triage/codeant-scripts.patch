@@ -0,0 +1,34 @@
+"""tools/scrub_n8n_export.py: URLs of any scheme and look-alike e-mail domains must not survive the scrub."""
+
+from __future__ import annotations
+
+import pytest
+
+from tools.scrub_n8n_export import _clean
+
+KEPT = [
+    "write to a@example.com",
+    "a@sub.example.test",
+    "end of sentence a@example.invalid.",
+    "http://localhost:5678/webhook/x",
+    "https://127.0.0.1/x",
+]
+GONE = [
+    ("ftp://user:secretword@files.corp.example.org/in/x.csv", ["corp.example.org", "secretword", "in/x.csv"]),
+    ("file:///home/someone/.ssh/id_rsa", ["someone", "id_rsa"]),
+    ("postgres://app:pw1234@db.internal.corp:5432/leads", ["pw1234", "db.internal.corp"]),
+    ("wss://stream.vendor.net/live", ["vendor.net"]),
+    ("mail bob@example.com.au and jane@example.com.evil.net", ["example.com.au", "evil.net", "bob@", "jane@"]),
+    ("x@example.comx.org", ["comx.org"]),
+]
+
+
+@pytest.mark.parametrize("text", KEPT)
+def test_allowed_values_are_kept(text: str) -> None:
+    assert _clean(text) == text
+
+
+@pytest.mark.parametrize(("text", "must_not_remain"), GONE)
+def test_other_schemes_and_lookalike_domains_are_replaced(text: str, must_not_remain: list[str]) -> None:
+    out = _clean(text)
+    assert not [w for w in must_not_remain if w in out], out
