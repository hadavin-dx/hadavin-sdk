+def checked_base(url: str) -> str:
+    """The n8n address, only when the API key may travel to it: https, or http to this computer (127.0.0.1, ::1,
+    localhost). Plain http to another host would send the key unencrypted: refused before anything is read or sent."""
+    parts = urlsplit(url)
