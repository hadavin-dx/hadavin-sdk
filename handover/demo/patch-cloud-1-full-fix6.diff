+# ============================== F9: load. one fair line for writers, a bounded number of requests in flight
+def _burst(desk: Desk, refs_emails: list[tuple[str, str]]) -> list[Any]:
+    out: list[Any] = [None] * len(refs_emails)
+    start = threading.Barrier(len(refs_emails) + 1, timeout=60)
+
+    def one(i: int) -> None:
+        ref, email = refs_emails[i]
+        try:
+            start.wait()
+            r = desk.handle("form", ref, lead(email=email))
+            out[i] = (r.status, r.body)
+        except Exception as e:  # recorded, asserted below
+            out[i] = ("exc", repr(e))
+        finally:
+            desk.close()
+
+    threads = [threading.Thread(target=one, args=(i,)) for i in range(len(refs_emails))]
+    for t in threads:
+        t.start()
+    start.wait()
+    for t in threads:
+        t.join(180)
+    return out
+
