+def windows_acquire(monkeypatch: pytest.MonkeyPatch, path: Path) -> Any:
+    monkeypatch.setattr(sys, "platform", "win32")
+    try:
+        return lockfile.acquire(path)
+    finally:
+        monkeypatch.undo()
+
