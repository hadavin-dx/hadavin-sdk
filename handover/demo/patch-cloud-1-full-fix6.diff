+def sql_exec(db_path: Path, sql: str, args: tuple[Any, ...] = ()) -> None:
+    con = sqlite3.connect(db_path, timeout=10)
+    try:
+        con.execute(sql, args)
+        con.commit()
+    finally:
+        con.close()
