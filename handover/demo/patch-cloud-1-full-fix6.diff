+# =====
+# m5 a second drive that failed step 1 cannot add a second automatic try
+# =====
+def test_m5_stale_defer_changes_nothing(env) -> None:
+    rig = env.rig()
+    lid = new_lead(rig, "c10")
+    set_row(rig, lid, state="pending", auto_attempts=1)
+    rig.desk._defer_pending(lid, "internal:X", 0)  # a drive that read the count before another drive moved it
+    assert rig.query("SELECT auto_attempts FROM followups")[0][0] == 1
+    rig.desk._defer_pending(lid, "internal:X", 1)
+    assert rig.query("SELECT auto_attempts FROM followups")[0][0] == 2
+
