+def fake_msvcrt(monkeypatch: pytest.MonkeyPatch, code: int) -> None:
+    class Fake:
+        LK_NBLCK = 2
+
+        @staticmethod
+        def locking(fd: int, mode: int, nbytes: int) -> None:
+            raise OSError(code, "scripted")
+
+    monkeypatch.setitem(sys.modules, "msvcrt", Fake)
