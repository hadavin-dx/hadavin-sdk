+def set_row(rig: Any, lid: str, **cols: Any) -> None:
+    sets = ", ".join(f"{k}=?" for k in cols)
+    con = sqlite3.connect(rig.db_path, timeout=10)
+    try:
+        con.execute(f"UPDATE followups SET {sets} WHERE lead_id=?", (*cols.values(), lid))  # noqa: S608
+        con.commit()
+    finally:
+        con.close()
+
