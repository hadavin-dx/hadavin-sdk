+def reaper_rig(env, bg, **kw: Any) -> Rig:
+    """A rig whose desk runs the reaper; started in the documented order (start_background, then startup)."""
+    rig = env.rig(start=False, **kw)
+    bg(rig.desk)
+    rig.desk.startup()
+    return rig
