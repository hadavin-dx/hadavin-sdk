+def _new_api(obj: Any, name: str, *args: Any, **kw: Any) -> Any:
+    """Call obj.name(...) when the tree has it; a no-op returning None on the baseline."""
+    fn = getattr(obj, name, None)
+    return None if fn is None else fn(*args, **kw)
