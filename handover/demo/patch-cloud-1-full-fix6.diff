+def test_a_lead_ref_with_lone_surrogate_is_not_found(env) -> None:
+    rig = env.rig()
+    assert rig.desk.retry("F\ud800x").status == 404
+    assert rig.desk.resolve("F\x00x", "sent").status == 404
