+def hold_write_lock(db_path: Path, seconds: float) -> None:
+    """Another writer: BEGIN IMMEDIATE on its own connection, released after `seconds`."""
+    con = sqlite3.connect(db_path, timeout=10, isolation_level=None, check_same_thread=False)
+    con.execute("BEGIN IMMEDIATE")
+
+    def release() -> None:
+        try:
+            con.execute("ROLLBACK")
+        finally:
+            con.close()
+
+    threading.Timer(seconds, release).start()
