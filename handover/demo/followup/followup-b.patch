+_SANITIZERS = frozenset({"confine", "confine_existing", "confine_anywhere", "_confined"})
+_FILE_METHODS = frozenset({"open", "read_text", "write_text", "read_bytes", "write_bytes", "touch", "unlink", "mkdir"})
+_FLAGGED_SITES = (
