+        [3],
+    ),
+    "via a name": (
+        [
+            "def main(argv):",
+            "    out = argv[1]",
+            "    with open(out) as fh:",
+            "        return fh",
+        ],
+        [3],
+    ),
+    "walrus": (
+        [
+            "def main(a):",
+            "    if (p := a.out):",
+            "        open(p)",
+        ],
+        [3],
+    ),
+    "walrus that cannot clean": (
+        [
+            "def main(a):",
+            "    p = a.out",
+            "    x = a and (p := confine(p, what='x'))",
+            "    open(p)",
+        ],
+        [4],
+    ),
+    "for over argv": (
+        [
+            "def main():",
+            "    for x in sys.argv[1:]:",
+            "        open(x)",
+        ],
+        [3],
+    ),
+    "with as": (
+        [
+            "def main(a):",
+            "    with ctx(a.out) as q:",
+            "        open(q)",
+        ],
+        [3],
+    ),
+    "comprehension": (
+        [
+            "def main(a):",
+            "    return [open(p) for p in a.paths]",
+        ],
+        [2],
+    ),
+    "parameter not named path": (
+        [
+            "def _w(target):",
