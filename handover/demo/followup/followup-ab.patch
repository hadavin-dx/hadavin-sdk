+def _is_sanitizer_call(node: ast.AST) -> bool:
+    if not isinstance(node, ast.Call):
+        return False
+    f = node.func
+    return (isinstance(f, ast.Name) and f.id in _SANITIZERS) or (isinstance(f, ast.Attribute) and f.attr in _SANITIZERS)
+
+
+def _tainted(expr: ast.AST, env: set[str]) -> bool:
+    """True when ``expr`` uses a name that holds raw command-line text (outside a call of a path helper, whose result is
+    the checked path). ``sys.argv`` and ``parse_args`` results count as raw too."""
+    if _is_sanitizer_call(expr):
+        return False
+    if isinstance(expr, ast.IfExp):  # the condition picks a value; it does not become the value
+        return _tainted(expr.body, env) or _tainted(expr.orelse, env)
+    if isinstance(expr, ast.Name):
+        return expr.id in env
+    if isinstance(expr, ast.Attribute) and expr.attr == "argv":
+        return True
+    if isinstance(expr, ast.Call) and isinstance(expr.func, ast.Attribute) and expr.func.attr == "parse_args":
+        return True
+    return any(_tainted(c, env) for c in ast.iter_child_nodes(expr))
+
+
+def _is_file_sink(call: ast.Call) -> bool:
+    f = call.func
+    if isinstance(f, ast.Name):
+        return f.id == "open"
+    return isinstance(f, ast.Attribute) and (
+        f.attr in _FILE_METHODS or (f.attr == "connect" and "sqlite" in ast.dump(f))
+    )
+
+
+def _raw_opens(tree: ast.Module) -> list[tuple[int, str]]:
+    """(line, text) of every file operation whose path or receiver is raw command-line text, found in source order.
+    Raw: the parameters of ``main`` and ``path``, the result of ``parse_args``, ``sys.argv``, and anything assigned
+    from those; a name assigned from a path helper is clean again."""
+    found: list[tuple[int, str]] = []
+
+    def visit(node: ast.AST, env: set[str]) -> None:
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            params = (*node.args.args, *node.args.kwonlyargs)
+            inner = set(env) | {x.arg for x in params if node.name == "main" or x.arg == "path"}
+            for stmt in node.body:
+                visit(stmt, inner)
+            return
+        if isinstance(node, ast.Call) and _is_file_sink(node):
+            parts = [*node.args, *[k.value for k in node.keywords], node.func]
+            if any(_tainted(x, env) for x in parts):
+                found.append((node.lineno, ast.unparse(node)))
+        if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)) and node.value is not None:
+            targets = node.targets if isinstance(node, ast.Assign) else [node.target]
+            raw = _tainted(node.value, env)
+            for n in (n for t in targets for n in ast.walk(t) if isinstance(n, ast.Name)):
+                (env.add if raw else env.discard)(n.id)
+        for child in ast.iter_child_nodes(node):
+            visit(child, env)
+
+    visit(tree, set())
+    return found
+
+
+def test_the_open_finder_sees_a_raw_open_and_passes_a_checked_one() -> None:
+    raw = ast.parse("def main(argv):\n    a = ap.parse_args(argv)\n    return Path(a.out).read_text()\n")
+    assert [line for line, _ in _raw_opens(raw)] == [3]
+    via_name = ast.parse(
+        "\n".join(["def main(argv):", "    out = argv[1]", "    with open(out) as fh:", "        return fh"])
+    )
+    assert [line for line, _ in _raw_opens(via_name)] == [3]
+    checked = ast.parse("def main(argv):\n    out = confine(argv[1], what='x')\n    return open(out)\n")
+    assert _raw_opens(checked) == []
+    redone = ast.parse("def read(path):\n    path = confine_existing(path, what='x')\n    return path.read_text()\n")
+    assert _raw_opens(redone) == []
+    unchecked = ast.parse("def read(path):\n    return path.read_text()\n")
+    assert [line for line, _ in _raw_opens(unchecked)] == [2]
