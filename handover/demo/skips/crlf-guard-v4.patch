+def test_the_carriage_return_check_flags_crlf_and_skips_ps1_scripts(tmp_path: Path) -> None:
+    (tmp_path / "a.txt").write_bytes(b"x=1" + CRLF)
+    (tmp_path / "b.txt").write_bytes(b"x=1" + bytes([10]))
+    (tmp_path / "c.ps1").write_bytes(b"x" + CRLF)
+    (tmp_path / "D.PS1").write_bytes(b"x" + CRLF)  # a file name is not case sensitive on Windows
+    (tmp_path / "e.txt").write_bytes(b"x=1" + LONE_CR + b"y=2")  # a lone CR counts
+    names = ["a.txt", "b.txt", "c.ps1", "D.PS1", "e.txt", "missing.txt"]
+    assert _files_with_cr(tmp_path, names) == ["a.txt", "e.txt"]
+    assert CRLF_HINT in _crlf_note(tmp_path, ["a.txt"])
+    assert _crlf_note(tmp_path, ["b.txt", "c.ps1", "D.PS1"]) == ""
