+@pytest.mark.parametrize("line_end", [CRLF, LONE_CR], ids=["crlf", "lone-cr"])
+def test_every_cure_in_the_message_works(tmp_path: Path, monkeypatch: pytest.MonkeyPatch, line_end: bytes) -> None:
+    """Takes the commands (between backticks) out of the real failure message, runs each one on a fresh planted file
+    and checks that the guard then passes and the file is the LF text again. `python` is run as this interpreter."""
+    msg = _guard_message(_planted_tree(tmp_path / "msg", line_end), monkeypatch)
+    cures = re.findall(r"`([^`]+)`", msg)
+    assert [c.split()[0] for c in cures] == ["git", "python"], cures
+    for i, cure in enumerate(cures):
+        tree = _planted_tree(tmp_path / f"cure{i}", line_end)
+        argv = shlex.split(cure.replace("<file>", "sonar-project.properties"))
+        argv[0] = sys.executable if argv[0] == "python" else argv[0]
+        subprocess.run(argv, cwd=tree, check=True, capture_output=True)  # noqa: S603
+        assert _scan_files_with_cr(tree) == [], cure
+        lf = (REPO / "sonar-project.properties").read_bytes().replace(b"\r", b"")
+        assert (tree / "sonar-project.properties").read_bytes() == lf, cure
+
