+@pytest.mark.parametrize("line_end", [CRLF, LONE_CR], ids=["crlf", "lone-cr"])
+def test_end_to_end_a_cr_file_gives_a_failure_message_with_the_name_and_the_cure(
+    tmp_path: Path, line_end: bytes
+) -> None:
+    """The whole message path without gitleaks: a gitleaks-style report names the planted file, and the message built
+    from it holds the file name, the values-are-redacted note and both cures, and does not recommend `--renormalize`
+    (it only changes the index)."""
+    tree = _planted_tree(tmp_path, line_end)
+    report = tmp_path / "r.json"
+    report.write_text(
+        json.dumps([{"File": "./sonar-project.properties", "RuleID": "generic-api-key"}]), encoding="utf-8"
+    )
+    msg = _scan_failure_message("dir", _flagged_files(report), tree)
+    assert "(values are redacted); files: ['sonar-project.properties']" in msg
+    assert "sonar-project.properties: this file has Windows line endings" in msg
+    assert "git checkout --" in msg
+    assert "python -c" in msg
+    assert "renormalize" not in msg
+    lf_tree = _planted_tree(tmp_path / "lf", bytes([10]))  # a clean LF copy gives no hint
+    assert _crlf_note(lf_tree, ["sonar-project.properties"]) == ""
+
