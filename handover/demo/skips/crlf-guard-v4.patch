+CRLF_HINT = (  # the two commands between backticks are run by test_every_cure_in_the_message_works
+    "this file has Windows line endings (CRLF) or a lone carriage return; the repository stores LF (.gitattributes). "
+    "Cure 1, on every system, throws away your edits to the file: `git checkout -- <file>`. "
+    "Cure 2 keeps your edits and needs Python (write python3 on macOS or Linux): "
+    '`python -c "import sys, pathlib; p = pathlib.Path(sys.argv[1]); '
+    "p.write_bytes(p.read_bytes().replace(b'\\r\\n', b'\\n').replace(b'\\r', b'\\n'))\" <file>`"
+)
+CRLF_BY_DESIGN = (".ps1",)  # the only CRLF file kind in .gitattributes (*.ps1 text eol=crlf); .bat and .cmd get LF
+# The files whose exact text the secret-scan exceptions name (sonar-project.properties key line) or that hold the scan
+# rules and lock files: a CR in any of them makes `gitleaks dir` report the key line, with no word about line endings.
+LF_ONLY_FILES = ("sonar-project.properties", ".gitleaks.toml", "exceptions.txt", "patterns.txt", "requirements-*.txt")
+
+
+def _gitleaks_common(toml: Path) -> list[str]:
+    return ["--no-banner", "--redact", "--ignore-gitleaks-allow", "--config", str(toml)]
+
+
+def _gitleaks_scan(exe: str, sub: str, toml: Path, target: Path, report: Path) -> str:
+    """One gitleaks scan run from the root of target, like lint.yml: "" when it found nothing, else the failure text."""
+    fmt = ["--report-format", "json", "--report-path", str(report)]
+    p = subprocess.run(  # noqa: S603
+        [exe, sub, *_gitleaks_common(toml), *fmt, "--exit-code", "1", "."], cwd=target, capture_output=True, check=False
+    )
+    return _scan_failure_message(sub, _flagged_files(report), target) if p.returncode else ""
+
+
+def _files_with_cr(root: Path, names: list[str]) -> list[str]:
+    """The names (relative to root) whose file holds a carriage return; .ps1 scripts are CRLF by design and skipped."""
+    out = []
+    for n in names:
+        f = root / n
+        if n.lower().endswith(CRLF_BY_DESIGN) or not f.is_file():
+            continue
+        if b"\r" in f.read_bytes():
+            out.append(n)
+    return out
+
+
+def _crlf_note(root: Path, names: list[str]) -> str:
+    """A plain hint for a failure message: empty when none of the named files holds a carriage return. It reads the
+    current working copy, so for a `gitleaks git` finding it shows the file as it is now, not the old blob."""
+    bad = _files_with_cr(root, names)
+    return f"\n{', '.join(bad)}: {CRLF_HINT}" if bad else ""
+
+
+def _flagged_files(report: Path) -> list[str]:
+    """File names from a gitleaks JSON report (values are redacted, the names are not secret)."""
+    try:
+        rows = json.loads(report.read_text(encoding="utf-8") or "[]")
+    except (OSError, ValueError):
+        return []
+    return sorted({str(x.get("File", "")).replace(chr(92), "/").removeprefix("./") for x in rows if x.get("File")})
+
+
+def _scan_failure_message(sub: str, flagged: list[str], root: Path) -> str:
+    """The text of a failed gitleaks scan: the flagged file names (values stay redacted) plus the CRLF hint when one of
+    those files holds a carriage return. One function so the test of the message and the scan share the same text."""
+    return f"gitleaks {sub} reported findings (values are redacted); files: {flagged}" + _crlf_note(root, flagged)
+
+
+def _scan_files_with_cr(root: Path) -> list[str]:
+    """The tracked scan files (LF_ONLY_FILES) under root, a git work tree, that hold a carriage return."""
+    names = [n for n in _git(root, "ls-files").splitlines() if any(fnmatch.fnmatch(n, g) for g in LF_ONLY_FILES)]
+    assert "sonar-project.properties" in names, "the list of files to check is empty: the test would prove nothing"
+    return _files_with_cr(root, names)
+
