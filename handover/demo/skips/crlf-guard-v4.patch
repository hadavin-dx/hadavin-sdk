+def _planted_tree(tmp_path: Path, line_end: bytes, name: str = "sonar-project.properties") -> Path:
+    """A git work tree like a Windows checkout: the index holds LF, the work copy of `name` (and nothing else) has
+    line_end instead. Both files hold the real sonar-project.properties text."""
+    tree = tmp_path / "planted"
+    tree.mkdir(parents=True)
+    lf = (REPO / "sonar-project.properties").read_bytes().replace(b"\r", b"")
+    for n in {"sonar-project.properties", name}:
+        (tree / n).write_bytes(lf)
+    for cmd in (["init", "-q"], ["add", "."]):
+        subprocess.run(["git", *cmd], cwd=tree, check=True, capture_output=True)  # noqa: S603, S607
+    (tree / name).write_bytes(lf.replace(b"\n", line_end))
+    return tree
+
+
+def _guard_message(tree: Path, monkeypatch: pytest.MonkeyPatch) -> str:
+    """The text of the failure of the real guard test run against the tree (it must fail)."""
+    monkeypatch.setattr(sys.modules[__name__], "REPO", tree)
+    with pytest.raises(AssertionError) as exc:
+        test_the_secret_scan_files_have_no_carriage_return()
+    return str(exc.value)
+
