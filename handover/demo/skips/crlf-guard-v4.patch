+def test_the_scan_failure_names_the_flagged_file_and_the_crlf_fix(tmp_path: Path) -> None:
+    (tmp_path / "sonar-project.properties").write_bytes(b"k=v" + CRLF)
+    report = tmp_path / "r.json"
+    report.write_text(json.dumps([{"File": "./sonar-project.properties", "RuleID": "x"}]), encoding="utf-8")
+    flagged = _flagged_files(report)
+    assert flagged == ["sonar-project.properties"]
+    assert CRLF_HINT in _crlf_note(tmp_path, flagged)
+    report.write_text("{not json", encoding="utf-8")  # a broken or empty report is "nothing named", never an error
+    assert _flagged_files(report) == []
+    report.write_text("", encoding="utf-8")
+    assert _flagged_files(report) == []
+    assert _flagged_files(tmp_path / "missing.json") == []
