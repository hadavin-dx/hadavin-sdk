     return p.stdout
 
 
+CRLF_HINT = (
+    "this file has Windows line endings (CRLF); the repository stores LF (.gitattributes); "
+    "save it with LF, or discard your edits to it with: git checkout -- <file>"
+)
+CRLF_BY_DESIGN = (".ps1",)  # the only CRLF file kind in .gitattributes (*.ps1 text eol=crlf); .bat and .cmd get LF
+# The files whose exact text the secret-scan exceptions name (sonar-project.properties key line) or that hold the scan
+# rules and lock files: a CR in any of them makes `gitleaks dir` report the key line, with no word about line endings.
+LF_ONLY_FILES = ("sonar-project.properties", ".gitleaks.toml", "exceptions.txt", "patterns.txt", "requirements-*.txt")
+
+
+def _files_with_cr(root: Path, names: list[str]) -> list[str]:
+    """The names (relative to root) whose file holds a carriage return; .ps1 scripts are CRLF by design and skipped."""
+    out = []
+    for n in names:
+        f = root / n
+        if n.lower().endswith(CRLF_BY_DESIGN) or not f.is_file():
+            continue
+        if b"\r" in f.read_bytes():
+            out.append(n)
+    return out
+
+
+def _crlf_note(root: Path, names: list[str]) -> str:
+    """A plain hint for a failure message: empty when none of the named files holds a carriage return. It reads the
+    current working copy, so for a `gitleaks git` finding it shows the file as it is now, not the old blob."""
+    bad = _files_with_cr(root, names)
+    return f"\n{', '.join(bad)}: {CRLF_HINT}" if bad else ""
+
+
+def _flagged_files(report: Path) -> list[str]:
+    """File names from a gitleaks JSON report (values are redacted, the names are not secret)."""
+    try:
+        rows = json.loads(report.read_text(encoding="utf-8") or "[]")
+    except (OSError, ValueError):
+        return []
+    return sorted({str(x.get("File", "")).replace(chr(92), "/").removeprefix("./") for x in rows if x.get("File")})
+
+
