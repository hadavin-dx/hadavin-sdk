+def test_the_secret_scan_files_have_no_carriage_return() -> None:
+    """A CR in a root-level file the scan exceptions name makes `gitleaks dir` report it; fail early and say why."""
+    names = [n for n in _git(REPO, "ls-files").splitlines() if any(fnmatch.fnmatch(n, g) for g in LF_ONLY_FILES)]
+    assert "sonar-project.properties" in names, "the list of files to check is empty: the test would prove nothing"
+    bad = _files_with_cr(REPO, names)
+    assert not bad, f"{', '.join(bad)}: {CRLF_HINT}"
+
+
+def test_the_carriage_return_check_flags_crlf_and_skips_ps1_scripts(tmp_path: Path) -> None:
+    (tmp_path / "a.txt").write_bytes(b"x=1" + bytes([13, 10]))
+    (tmp_path / "b.txt").write_bytes(b"x=1" + bytes([10]))
+    (tmp_path / "c.ps1").write_bytes(b"x" + bytes([13, 10]))
+    assert _files_with_cr(tmp_path, ["a.txt", "b.txt", "c.ps1", "missing.txt"]) == ["a.txt"]
+    assert CRLF_HINT in _crlf_note(tmp_path, ["a.txt"])
+    assert _crlf_note(tmp_path, ["b.txt", "c.ps1"]) == ""
+
+
+def test_the_scan_failure_names_the_flagged_file_and_the_crlf_fix(tmp_path: Path) -> None:
+    (tmp_path / "sonar-project.properties").write_bytes(b"k=v" + bytes([13, 10]))
+    report = tmp_path / "r.json"
