diff --git a/tests/test_portal_phone_layout.py b/tests/test_portal_phone_layout.py
new file mode 100644
index 0000000..7ed343f
--- /dev/null
+++ b/tests/test_portal_phone_layout.py
@@ -0,0 +1,55 @@
+"""At phone width (390 px) and at 700 px the portal keeps its icon-only rail and its page margin, and no page is wider
+than the window. The 860 px rules come before the 1200 px rules in app.css, so the later rules used to win and the
+wide rail and margin stayed (the page then ran 60 to 240 px out of the window). Real browser (skipped when playwright
+or its browser is missing). Made-up data only."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+from test_portal_lead_pages import _browse, _flow_rig, _seed_names
+
+PAGES = {
+    "overview": '[data-testid="feed-item"]',
+    "leads": "[data-lead-id]",
+    "needs": '[data-testid="needs-card"]',
+    "log": "table tbody tr",
+    "data": "#main .card",
+}
+
+
+@pytest.mark.parametrize("scheme", ["light", "dark"])
+@pytest.mark.parametrize("page_name", list(PAGES))
+def test_no_page_is_wider_than_a_phone_window(env: Any, scheme: str, page_name: str) -> None:
+    rig, base = _flow_rig(env)
+    _seed_names(rig)
+
+    def body(page: Any, base: str) -> None:
+        page.goto(base + f"/ui/#/{page_name}")
+        page.wait_for_selector(PAGES[page_name])
+        page.wait_for_timeout(300)  # the lists draw in two steps
+        m = page.evaluate(
+            "() => ({ page: document.documentElement.scrollWidth, window: document.documentElement.clientWidth })"
+        )
+        assert m["page"] <= m["window"], m  # no sideways scroll of the page (a wide table scrolls inside its card)
+
+    _browse(base, body, width=390, scheme=scheme)
+
+
+@pytest.mark.parametrize("width, rail", [(390, 64), (700, 64), (860, 64), (861, 208), (1200, 208), (1201, 240)])
+def test_the_rail_is_icon_only_up_to_860_px_and_the_page_margin_follows(env: Any, width: int, rail: int) -> None:
+    rig, base = _flow_rig(env)
+
+    def body(page: Any, base: str) -> None:
+        page.goto(base + "/ui/#/overview")
+        page.wait_for_selector("#main")
+        m = page.evaluate(
+            """() => ({ rail: parseFloat(getComputedStyle(document.querySelector('.shell')).gridTemplateColumns),
+              margin: parseFloat(getComputedStyle(document.querySelector('.page')).paddingLeft) })"""
+        )
+        assert m["rail"] == rail, m
+        if width <= 860:
+            assert m["margin"] == 16, m  # the 860 px page margin (16 px), not the 24 px of the 1200 px rule
+
+    _browse(base, body, width=width)
