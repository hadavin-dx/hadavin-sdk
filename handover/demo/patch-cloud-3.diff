+# =====
+# Lens 1 N1: the in-flight limit is first come, first served
+# =====
+def test_l1n1_inflight_places_go_in_arrival() -> None:
+    sem = gate.FairSemaphore(1)
+    assert sem.acquire(timeout=1)
+    order: list[int] = []
+
+    def waiter(i: int) -> None:
+        if sem.acquire(timeout=5):
+            order.append(i)
+            sem.release()
+
+    threads = []
+    for i in range(5):
+        t = threading.Thread(target=waiter, args=(i,))
+        t.start()
+        threads.append(t)
+        time.sleep(0.05)  # arrival order is fixed
+    sem.release()
+    for t in threads:
+        t.join(5)
+    assert order == [0, 1, 2, 3, 4]
+
+
+def test_l1n1_a_late_arrival_cannot_take_a() -> None:
+    sem = gate.FairSemaphore(1)
+    sem.acquire(timeout=1)
+    got: list[str] = []
+    t = threading.Thread(target=lambda: got.append("old") if sem.acquire(timeout=5) else None)
+    t.start()
+    time.sleep(0.1)
+    sem.release()  # handed to the old waiter at once
+    assert sem.acquire(timeout=0.05) is False, "a late arrival barged in"
+    t.join(5)
+    assert got == ["old"]
+
