+# =====
+# Lens 3 N7: adapters read a bounded reply and follow no redirect
+# =====
+def test_l3n7_a_redirect_is_not_followed_an() -> None:
+    import http.server
+    import socketserver
+
+    from lead_desk.adapters import _exchange
+    from lead_desk.constants import REPLY_MAX_BYTES
+
+    hits: list[str] = []
+
+    class H(http.server.BaseHTTPRequestHandler):
+        def log_message(self, *a: Any) -> None:
+            pass
+
+        def do_POST(self) -> None:
+            hits.append(self.path)
+            self.rfile.read(int(self.headers.get("Content-Length", 0)))
+            if self.path == "/redir":
+                self.send_response(302)
+                self.send_header("Location", "/target")
+                self.end_headers()
+            else:
+                body = b'{"a":"' + b"x" * (REPLY_MAX_BYTES + 10) + b'"}'
+                self.send_response(200)
+                self.send_header("Content-Length", str(len(body)))
+                self.end_headers()
+                self.wfile.write(body)
+
+        do_GET = do_POST
+
+    with socketserver.TCPServer(("127.0.0.1", 0), H) as srv:
+        port = srv.server_address[1]
+        t = threading.Thread(target=srv.serve_forever, daemon=True)
+        t.start()
+        try:
+            import urllib.error
+
+            with pytest.raises(urllib.error.HTTPError):
+                _exchange(f"http://127.0.0.1:{port}/redir", {"a": 1}, 5)
+            assert hits == ["/redir"], "the redirect was followed"
+            with pytest.raises(ValueError):
+                _exchange(f"http://127.0.0.1:{port}/big", {"a": 1}, 5)
+        finally:
+            srv.shutdown()
