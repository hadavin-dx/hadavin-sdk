+# =====
+# Lens 1 N2: follow-up drives cannot crowd out request writes
+# =====
+def test_l1n2_a_request_write_is_served_bef() -> None:
+    g = gate.FairGate()
+    g.acquire(1)
+    served: list[str] = []
+
+    def take(name: str, low: bool) -> None:
+        g.acquire(5, low=low)
+        served.append(name)
+        g.release()
+
+    t1 = threading.Thread(target=take, args=("drive", True))
+    t1.start()
+    time.sleep(0.1)
+    t2 = threading.Thread(target=take, args=("request", False))
+    t2.start()
+    time.sleep(0.1)
+    g.release()
+    t1.join(5)
+    t2.join(5)
+    assert served == ["request", "drive"]
+
