+# =====
+# F7: the CRM call runs once per lead even with a blind CRM
+# =====
+class BlindCrm:
+    """A CRM that cannot say 'already there': every put adds a row (the fakes server in crm blind mode)."""
+
+    def __init__(self, delay: float = 0.0) -> None:
+        self.rows: list[str] = []
+        self.delay = delay
+        self._lock = threading.Lock()
+
+    @property
+    def count(self) -> int:
+        return len(self.rows)
+
+    def put(self, lead_id: str, record: Any) -> str:
+        if self.delay:
+            time.sleep(self.delay)
+        with self._lock:
+            self.rows.append(lead_id)
+        return "PUT"
+
+
