{
  "name": "mf-table-screen",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "demo-table",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Receive",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "demo-table-wh"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT lead_key, state, attempts, mail_sent, alert_sent, alert_attempts, updated_at FROM mf_leads ORDER BY updated_at DESC LIMIT 50;",
        "options": {}
      },
      "name": "ReadLeads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "PG_CREDENTIAL_ID",
          "name": "n8n-publish-pg"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "html",
              "name": "html",
              "value": "={{ '<!doctype html><html><head><meta charset=\"utf-8\"><meta http-equiv=\"refresh\" content=\"5\"><title>Lead table</title><style>body{font-family:sans-serif;margin:24px}table{border-collapse:collapse}th,td{border:1px solid #888;padding:6px 12px;text-align:left}th{background:#eee}</style></head><body><h2>mf_leads</h2><table><tr><th>lead_key</th><th>state</th><th>attempts</th><th>mail_sent</th><th>alert_sent</th><th>alert_attempts</th><th>updated_at</th></tr>' + $input.all().filter(i => i.json.lead_key).map(i => '<tr>' + ['lead_key','state','attempts','mail_sent','alert_sent','alert_attempts','updated_at'].map(k => '<td>' + String(i.json[k] === undefined || i.json[k] === null ? '' : i.json[k]).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</td>').join('') + '</tr>').join('') + '</table></body></html>' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "BuildHtml",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      },
      "name": "ReplyHtml",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Receive": {
      "main": [
        [
          {
            "node": "ReadLeads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ReadLeads": {
      "main": [
        [
          {
            "node": "BuildHtml",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "BuildHtml": {
      "main": [
        [
          {
            "node": "ReplyHtml",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  }
}