+# =====
+# m1 failure count is cleared when the receipt ends as unstorable
+# =====
+def test_m1_failure_count_cleared_after_unstorable(env, monkeypatch: pytest.MonkeyPatch) -> None:
+    rig = env.rig()
+    real = Desk._decide_once
+    calls = [0]
+
+    def flaky(self: Desk, rid: int) -> Any:
+        calls[0] += 1
+        if calls[0] == 1:
+            raise RuntimeError("plain")
+        raise sqlite3.IntegrityError("cannot store")
+
+    monkeypatch.setattr(Desk, "_decide_once", flaky)
+    assert rig.desk.process("form", "c8", lead()).status == 500
+    assert rig.desk.process("form", "c8", lead()).status == 202
+    monkeypatch.setattr(Desk, "_decide_once", real)
+    assert rig.desk._decide_failures == {}
+
