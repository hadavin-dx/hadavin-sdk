   "parameters": {
    "method": "POST",
    "url": "={{ $env.DESK_URL }}/qualify",
    "sendBody": true,
    "contentType": "json",
    "specifyBody": "json",
    "jsonBody": "={{ { lead_key: $('SubIn').first().json.lead_key, email: $('SubIn').first().json.email } }}",
    "options": {
     "timeout": "={{ Number($env.DESK_TIMEOUT_MS || 10000) }}"
    }
   },
   "name": "Qualify",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    220,
    0
   ],
