+    model = [{"ts": T0, "lead_id": k, "mode": "ok", "status": 200} for k in LEADS]
+    model.append({"ts": T0, "lead_id": "L2", "mode": "rate_limit", "status": 429})
+    return {"reqs": reqs, "mail": mail, "crm": crm, "model": model, "leads": dict(LEADS), "drained_ts": T0 + 8.0}
