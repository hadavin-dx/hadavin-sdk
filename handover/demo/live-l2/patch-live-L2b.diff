+"""The seven checks run after a campaign scenario has drained. Formats: live_l2/README-L2.md.
+
+Run: python -m live_l2.check_invariants --requests req.jsonl --book desk.sqlite3 --catcher mail.jsonl
+         --crm crm.json --model-log model.jsonl [--drain drain.json] [--json out.json]
+Exit code 0 only when all seven checks hold; 1 when a check fails; 2 when an input file cannot be read."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sqlite3
+import sys
+from collections import Counter
+from collections.abc import Iterable, Mapping
+from pathlib import Path
+from typing import Any
+
+# ---- config block (the only place for numbers and words) ----
+FIRST_N = 10  # offending ids listed per check
+DEFAULT_MODEL_CALL_BOUND = 3  # check 5: most model calls allowed for one lead
+DEFAULT_MAX_DRAIN_SECONDS = 120.0  # check 7: ceiling from the last intended send to "nothing pending or sending"
+ACK_CODES = (200, 201, 202)  # reply codes that carry a receipt number (contract.md, HTTP table)
+BUSY_CODE = 503
+OPEN_STATES = ("pending", "sending")
+STATES = ("pending", "sending", "sent", "failed", "unknown")
+MESSAGE_FREE_STATES = ("failed", "unknown")  # follow-ups allowed (and required) to have no message
+CRM_INTENT_MARK = 2  # followups.crm_done: a put was started and its end is not known
+CRM_DONE = 1
+EXIT_OK, EXIT_FAIL, EXIT_INPUT = 0, 1, 2
+CHECK_NAMES = {
+    1: "every request id has a receipt",
+    2: "follow-up states add up and nothing is left pending",
+    3: "at most one message per send key; no message only for failed or unknown",
+    4: "CRM rows match the leads marked done, plus the listed unknowns",
+    5: "model calls per lead are within the bound",
+    6: "503 rate reported (fails only above a set ceiling)",
+    7: "drain time within the ceiling",
+}
+
+
+class InputError(Exception):
+    """An input file is missing or not in the documented format."""
+
+
+def read_jsonl(path: Path) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as e:
+        raise InputError(f"cannot read {path}: {e}") from e
+    for n, line in enumerate(text.splitlines(), 1):
+        if not line.strip():
+            continue
+        try:
+            obj = json.loads(line)
+        except ValueError as e:
+            raise InputError(f"{path} line {n}: not JSON") from e
+        if not isinstance(obj, dict):
+            raise InputError(f"{path} line {n}: not a JSON object")
+        rows.append(obj)
+    return rows
+
+
+def read_crm(path: Path) -> list[dict[str, Any]]:
+    """Accepts the fakes server reply {"count", "rows": [...]} or a bare list of rows (each has lead_id)."""
+    try:
+        obj = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError) as e:
+        raise InputError(f"cannot read CRM dump {path}: {e}") from e
+    rows = obj.get("rows") if isinstance(obj, dict) else obj
+    if not isinstance(rows, list) or not all(isinstance(r, dict) and "lead_id" in r for r in rows):
+        raise InputError(f"{path}: expected a list of rows or an object with a rows list; each row needs lead_id")
+    return rows
+
+
+def read_book(path: Path) -> dict[str, Any]:
+    """Read-only look at the desk's SQLite book."""
+    if not path.is_file():
+        raise InputError(f"no such book: {path}")
+    try:
+        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+        try:
+            receipts = {
+                (s, r): int(i) for i, s, r in conn.execute("SELECT receipt_id, source, source_ref FROM receipts")
+            }
+            leads = [r[0] for r in conn.execute("SELECT lead_id FROM leads")]
+            followups = {
+                lid: (state, int(done), int(upd))
+                for lid, state, done, upd in conn.execute("SELECT lead_id, state, crm_done, updated_at FROM followups")
+            }
+        finally:
+            conn.close()
+    except sqlite3.Error as e:
+        raise InputError(f"cannot read book {path}: {e}") from e
+    return {"receipts": receipts, "leads": leads, "followups": followups}
+
+
+def _result(n: int, ok: bool, detail: str, offenders: Iterable[str], values: Mapping[str, Any]) -> dict[str, Any]:
+    bad = sorted(set(offenders))
+    return {
+        "id": n,
+        "name": CHECK_NAMES[n],
+        "ok": ok,
+        "detail": detail,
+        "offender_count": len(bad),
+        "offenders": bad[:FIRST_N],
+        "values": dict(values),
+    }
+
+
+def _rid(line: Mapping[str, Any]) -> str:
+    return f"{line.get('door')}:{line.get('request_id')}"
+
+
+def check_receipts(reqs: list[dict[str, Any]], book: Mapping[str, Any]) -> dict[str, Any]:
+    receipts: Mapping[tuple[str, str], int] = book["receipts"]
+    lost: list[str] = []
+    mismatch: list[str] = []
+    unacked_stored = 0
+    unique = {(str(r.get("door")), str(r.get("request_id"))) for r in reqs}
+    for door, ref in unique:
+        if (door, ref) not in receipts:
+            lost.append(f"{door}:{ref}")
+    for r in reqs:
+        key = (str(r.get("door")), str(r.get("request_id")))
+        acked = r.get("final_status") in ACK_CODES
+        if key in receipts and not acked:
+            unacked_stored += 1
+        if acked and key in receipts and r.get("receipt_id") is not None and r["receipt_id"] != receipts[key]:
+            mismatch.append(_rid(r))
+    bad = lost + mismatch
+    detail = (
+        f"{len(unique)} distinct request ids, {len(lost)} without a receipt, "
+        f"{len(mismatch)} with a wrong receipt number"
+    )
+    return _result(
+        1,
+        not bad,
+        detail,
+        bad,
+        {
+            "distinct_requests": len(unique),
+            "lines": len(reqs),
+            "lost": len(lost),
+            "stored_but_client_unacked": unacked_stored,
+        },
+    )
+
+
+def check_partition(book: Mapping[str, Any]) -> dict[str, Any]:
+    followups: Mapping[str, tuple[str, int, int]] = book["followups"]
+    leads: list[str] = book["leads"]
+    counts = Counter(state for state, _, _ in followups.values())
+    total = sum(counts[s] for s in STATES)
+    no_row = [lid for lid in leads if lid not in followups]
+    open_ids = [lid for lid, (state, _, _) in followups.items() if state in OPEN_STATES]
+    ok = total == len(leads) and len(followups) == len(leads) and not open_ids
+    values = {s: counts[s] for s in STATES} | {"leads": len(leads), "sum": total, "followup_rows": len(followups)}
+    detail = " + ".join(f"{s} {counts[s]}" for s in STATES) + f" = {total}; leads {len(leads)}"
+    return _result(2, ok, detail, no_row + open_ids, values)
+
+
+def check_messages(book: Mapping[str, Any], mail: list[dict[str, Any]]) -> dict[str, Any]:
+    followups: Mapping[str, tuple[str, int, int]] = book["followups"]
+    per_key = Counter(str(m.get("send_key")) for m in mail)
+    doubled = [k for k, n in per_key.items() if n > 1]
+    stray = [k for k in per_key if k not in followups]
+    settled = {lid for lid, (state, _, _) in followups.items() if state not in OPEN_STATES}
+    silent = {lid for lid in settled if per_key.get(lid, 0) == 0}
+    must_be_silent = {lid for lid in settled if followups[lid][0] in MESSAGE_FREE_STATES}
+    lost_mail = sorted(silent - must_be_silent)  # sent, but no message at the catcher
+    unexpected = sorted(must_be_silent - silent)  # failed or unknown, yet a message arrived
+    bad = doubled + stray + lost_mail + unexpected
+    detail = (
+        f"{len(mail)} messages; {len(doubled)} keys more than once, {len(lost_mail)} sent without a message, "
+        f"{len(unexpected)} failed/unknown with a message, {len(stray)} keys of no lead"
+    )
+    values = {
+        "messages": len(mail),
+        "keys": len(per_key),
+        "max_per_key": max(per_key.values(), default=0),
+        "silent_followups": len(silent),
+        "failed_or_unknown": len(must_be_silent),
+    }
+    return _result(3, not bad, detail, bad, values)
+
+
+def check_crm(book: Mapping[str, Any], crm_rows: list[dict[str, Any]]) -> dict[str, Any]:
+    """Expected = leads with crm_done=1 (must be present) plus unknowns (may be present): leads with crm_done=2
+    (a put was started, its end unknown) or a follow-up in state unknown. A row for any other lead, a lead_id twice,
+    or a missing crm_done=1 row fails."""
+    followups: Mapping[str, tuple[str, int, int]] = book["followups"]
+    leads = set(book["leads"])
+    done = {lid for lid, (_, d, _) in followups.items() if d == CRM_DONE}
+    unknown = {lid for lid, (s, d, _) in followups.items() if d == CRM_INTENT_MARK or s == "unknown"} - done
+    ids = Counter(str(r["lead_id"]) for r in crm_rows)
+    present = set(ids)
+    missing = sorted(done - present)
+    extra = sorted(present - done - unknown)
+    twice = sorted(k for k, n in ids.items() if n > 1)
+    not_leads = sorted(present - leads)
+    bad = missing + extra + twice + not_leads
+    lo, hi = len(done), len(done) + len(unknown)
+    detail = (
+        f"{len(crm_rows)} CRM rows; allowed {lo} to {hi} (done {lo} + up to {len(unknown)} unknown); "
+        f"{len(missing)} missing, {len(extra)} not allowed, {len(twice)} twice"
+    )
+    values = {
+        "crm_rows": len(crm_rows),
+        "leads_crm_done": lo,
+        "listed_unknowns": len(unknown),
+        "unknowns_present": len(present & unknown),
+        "missing": len(missing),
+        "extra": len(extra),
+        "twice": len(twice),
+    }
+    return _result(4, not bad, detail, bad, values)
+
+
+def check_model_calls(model_rows: list[dict[str, Any]], bound: int) -> dict[str, Any]:
+    per_lead = Counter(str(r.get("lead_id")) for r in model_rows)
+    over = [lid for lid, n in per_lead.items() if n > bound]
+    by_status = Counter(str(r.get("status")) for r in model_rows)
+    values = {
+        "bound": bound,
+        "calls": len(model_rows),
+        "leads_called": len(per_lead),
+        "max_calls_one_lead": max(per_lead.values(), default=0),
+        "calls_by_status": dict(by_status),
+    }
+    most = values["max_calls_one_lead"]
+    detail = f"{len(model_rows)} calls for {len(per_lead)} leads; most for one lead {most}; bound {bound}"
+    return _result(5, not over, detail, over, values)
+
+
+def check_rate_503(reqs: list[dict[str, Any]], ceiling: float | None) -> dict[str, Any]:
+    attempts = [a for r in reqs for a in (r.get("attempts") or [])]
+    n503 = sum(1 for a in attempts if a.get("code") == BUSY_CODE)
+    rate = n503 / len(attempts) if attempts else 0.0
+    saw = [_rid(r) for r in reqs if any(a.get("code") == BUSY_CODE for a in (r.get("attempts") or []))]
+    final = [_rid(r) for r in reqs if r.get("final_status") == BUSY_CODE]
+    ok = ceiling is None or rate <= ceiling
+    values = {
+        "attempts": len(attempts),
+        "responses_503": n503,
+        "rate": round(rate, 6),
+        "requests": len(reqs),
+        "requests_that_saw_503": len(saw),
+        "requests_ending_on_503": len(final),
+        "ceiling": ceiling,
+    }
+    detail = (
+        f"{n503} of {len(attempts)} attempts got 503 (rate {rate:.4f}); {len(saw)} of {len(reqs)} requests saw one; "
+        f"{len(final)} ended on 503; ceiling {'none (report only)' if ceiling is None else ceiling}"
+    )
+    return _result(6, ok, detail, [] if ok else final or saw, values)
+
+
+def check_drain(
+    reqs: list[dict[str, Any]], book: Mapping[str, Any], drained_ts: float | None, ceiling: float
+) -> dict[str, Any]:
+    intended = [float(r["intended_ts"]) for r in reqs if r.get("intended_ts") is not None]
+    last_send = max(intended, default=None)
+    source = "marker"
+    if drained_ts is None:  # fall back to the book: whole-second times, so only as exact as one second
+        updates = [u for _, _, u in book["followups"].values()]
+        drained_ts = float(max(updates)) if updates else None
+        source = "book updated_at (whole seconds)"
+    if last_send is None or drained_ts is None:
+        return _result(7, False, "no intended send time or no drain moment", [], {"source": source})
+    seconds = max(0.0, drained_ts - last_send)
+    ok = seconds <= ceiling
+    values = {
+        "drain_seconds": round(seconds, 3),
+        "ceiling_seconds": ceiling,
+        "last_intended_send_ts": last_send,
+        "drained_ts": drained_ts,
+        "source": source,
+    }
+    return _result(
+        7, ok, f"{seconds:.2f} s from the last intended send to drained (ceiling {ceiling} s; {source})", [], values
+    )
+
+
+def run_checks(
+    reqs: list[dict[str, Any]],
+    book: Mapping[str, Any],
+    mail: list[dict[str, Any]],
+    crm_rows: list[dict[str, Any]],
+    model_rows: list[dict[str, Any]],
+    drained_ts: float | None = None,
+    model_bound: int = DEFAULT_MODEL_CALL_BOUND,
+    max_503_rate: float | None = None,
+    max_drain_seconds: float = DEFAULT_MAX_DRAIN_SECONDS,
+) -> dict[str, Any]:
+    checks = [
+        check_receipts(reqs, book),
+        check_partition(book),
+        check_messages(book, mail),
+        check_crm(book, crm_rows),
+        check_model_calls(model_rows, model_bound),
+        check_rate_503(reqs, max_503_rate),
+        check_drain(reqs, book, drained_ts, max_drain_seconds),
+    ]
+    return {"ok": all(c["ok"] for c in checks), "checks": checks}
+
+
+def render_table(result: Mapping[str, Any]) -> str:
+    lines = ["#  result  check", "-  ------  -----"]
+    for c in result["checks"]:
+        lines.append(f"{c['id']}  {'PASS' if c['ok'] else 'FAIL':<6}  {c['name']}")
+        lines.append(f"            {c['detail']}")
+        if c["offender_count"]:
+            lines.append(
+                f"            first {len(c['offenders'])} of {c['offender_count']}: {', '.join(c['offenders'])}"
+            )
+    lines.append("ALL 7 CHECKS HOLD" if result["ok"] else "AT LEAST ONE CHECK FAILED")
+    return "\n".join(lines)
+
+
+def _drain_marker(path: Path | None) -> float | None:
+    if path is None:
+        return None
+    try:
+        obj = json.loads(path.read_text(encoding="utf-8"))
+        value = obj.get("drained_ts")
+    except (OSError, ValueError, AttributeError) as e:
+        raise InputError(f"cannot read drain marker {path}: {e}") from e
+    return None if value is None else float(value)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(prog="live_l2.check_invariants")
+    ap.add_argument("--requests", type=Path, required=True, help="client request log (JSONL)")
+    ap.add_argument("--book", type=Path, required=True, help="desk SQLite file (opened read-only)")
+    ap.add_argument("--catcher", type=Path, required=True, help="SMTP catcher log (JSONL)")
+    ap.add_argument("--crm", type=Path, required=True, help="CRM dump (JSON)")
+    ap.add_argument("--model-log", type=Path, required=True, help="fake model call log (JSONL)")
+    ap.add_argument("--drain", type=Path, help='drain marker JSON {"drained_ts": epoch seconds}')
+    ap.add_argument("--model-bound", type=int, default=DEFAULT_MODEL_CALL_BOUND)
+    ap.add_argument("--max-503-rate", type=float, default=None)
+    ap.add_argument("--max-drain-seconds", type=float, default=DEFAULT_MAX_DRAIN_SECONDS)
+    ap.add_argument("--json", type=Path, help="write the JSON result here (default: print it after the table)")
+    a = ap.parse_args(argv)
+    try:
+        result = run_checks(
+            read_jsonl(a.requests),
+            read_book(a.book),
+            read_jsonl(a.catcher),
+            read_crm(a.crm),
+            read_jsonl(a.model_log),
+            _drain_marker(a.drain),
+            a.model_bound,
+            a.max_503_rate,
+            a.max_drain_seconds,
+        )
+    except InputError as e:
+        print(f"INPUT ERROR: {e}", file=sys.stderr)
+        return EXIT_INPUT
+    print(render_table(result))
+    text = json.dumps(result, indent=2, sort_keys=True)
+    if a.json:
+        a.json.write_text(text + "\n", encoding="utf-8")
+    else:
+        print(text)
+    return EXIT_OK if result["ok"] else EXIT_FAIL
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/live_l2/fake_model.py b/live_l2/fake_model.py
new file mode 100644
index 0000000..5e8cacb
--- /dev/null
+++ b/live_l2/fake_model.py
@@ -0,0 +1,197 @@
+"""A fake model endpoint for the campaign. Standard library only, loopback only, never a real model.
+Run: python -m live_l2.fake_model --port 8767 --call-log model.jsonl [--control-file mode.txt] [--mode ok]
+Routes: POST /v1/qualify {"lead_id","email_key"} -> {"label": ...}; GET /__mode; POST /__mode {"mode": "slow"}.
+A control file (one mode word, or {"mode": ...}) is read on every call and wins over POST /__mode when it exists."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from typing import Any
+
+# ---- config block ----
+MODES = ("ok", "slow", "timeout", "rate_limit", "malformed_json", "malformed_label", "refusal", "server_error")
+DEFAULT_PORT = 8767
+BIND = "127.0.0.1"
+SLOW_SECONDS = 3.0  # "slow" mode delay before an ok answer
+TIMEOUT_HOLD_SECONDS = 15.0  # "timeout" mode holds the call this long (longer than any client timeout)
+RETRY_AFTER_SECONDS = 1
+LABELS = ("hot", "warm", "cold")
+QUALIFY_PATH = "/v1/qualify"
+MODE_PATH = "/__mode"
+MAX_BODY_BYTES = 65536
+STATUS_CLIENT_GONE = 499  # logged when the client left before the answer was written
+STATUS_OK, STATUS_BAD_REQUEST, STATUS_NOT_FOUND, STATUS_RATE, STATUS_SERVER = 200, 400, 404, 429, 503
+
+
+def label_for(email_key: str) -> str:
+    """Same key, same label: a fixed spread over the three labels."""
+    return LABELS[hashlib.sha256(email_key.encode()).digest()[0] % len(LABELS)]
+
+
+class FakeModel:
+    def __init__(
+        self,
+        call_log: Path,
+        control_file: Path | None = None,
+        mode: str = "ok",
+        slow_seconds: float = SLOW_SECONDS,
+        hold_seconds: float = TIMEOUT_HOLD_SECONDS,
+    ) -> None:
+        if mode not in MODES:
+            raise ValueError(f"unknown mode {mode!r}")
+        self.call_log = call_log
+        self.control_file = control_file
+        self._mode = mode
+        self.slow_seconds = slow_seconds
+        self.hold_seconds = hold_seconds
+        self.stop = threading.Event()
+        self._lock = threading.Lock()
+
+    @property
+    def mode(self) -> str:
+        if self.control_file is not None:
+            try:
+                text = self.control_file.read_text(encoding="utf-8").strip()
+                word = json.loads(text).get("mode") if text.startswith("{") else text
+                if word in MODES:
+                    return str(word)
+            except (OSError, ValueError, AttributeError):
+                pass
+        return self._mode
+
+    def set_mode(self, mode: str) -> None:
+        if mode not in MODES:
+            raise ValueError(f"unknown mode {mode!r}")
+        self._mode = mode
+
+    def log(self, lead_id: str, mode: str, status: int) -> None:
+        line = json.dumps({"ts": time.time(), "lead_id": lead_id, "mode": mode, "status": status})
+        with self._lock, self.call_log.open("a", encoding="utf-8") as f:
+            f.write(line + "\n")
+
+
+def make_handler(model: FakeModel) -> type[BaseHTTPRequestHandler]:
+    class Handler(BaseHTTPRequestHandler):
+        protocol_version = "HTTP/1.1"
+
+        def log_message(self, format: str, *args: Any) -> None:  # noqa: A002
+            return
+
+        def _reply(self, status: int, body: bytes, headers: dict[str, str] | None = None) -> int:
+            try:
+                self.send_response(status)
+                self.send_header("Content-Type", "application/json")
+                self.send_header("Content-Length", str(len(body)))
+                self.send_header("Connection", "close")
+                for k, v in (headers or {}).items():
+                    self.send_header(k, v)
+                self.end_headers()
+                self.wfile.write(body)
+                self.wfile.flush()
+            except OSError:
+                return STATUS_CLIENT_GONE
+            return status
+
+        def _json(self, status: int, obj: Any, headers: dict[str, str] | None = None) -> int:
+            return self._reply(status, json.dumps(obj).encode(), headers)
+
+        def _read(self) -> dict[str, Any] | None:
+            try:
+                n = int(self.headers.get("Content-Length", "0"))
+                obj = json.loads(self.rfile.read(min(n, MAX_BODY_BYTES)) or b"{}")
+            except (ValueError, OSError):
+                return None
+            return obj if isinstance(obj, dict) else None
+
+        def do_GET(self) -> None:  # noqa: N802
+            if self.path == MODE_PATH:
+                self._json(STATUS_OK, {"mode": model.mode, "modes": list(MODES)})
+            else:
+                self._json(STATUS_NOT_FOUND, {"error": "not_found"})
+
+        def do_POST(self) -> None:  # noqa: N802
+            body = self._read()
+            if self.path == MODE_PATH:
+                mode = body.get("mode") if body else None
+                if mode not in MODES:
+                    self._json(STATUS_BAD_REQUEST, {"error": "bad_mode", "modes": list(MODES)})
+                    return
+                model.set_mode(str(mode))
+                self._json(STATUS_OK, {"mode": mode})
+            elif self.path == QUALIFY_PATH:
+                self._qualify(body)
+            else:
+                self._json(STATUS_NOT_FOUND, {"error": "not_found"})
+
+        def _qualify(self, body: dict[str, Any] | None) -> None:
+            """Plan the answer, write the log line, then answer, so a client that has its answer can already find its
+            line. Only "timeout" logs after the write (the client has gone by then: status 499)."""
+            lead_id = str((body or {}).get("lead_id", ""))
+            email_key = str((body or {}).get("email_key", ""))
+            mode = model.mode
+            headers: dict[str, str] = {}
+            raw: bytes
+            if body is None or not lead_id:
+                status, raw = STATUS_BAD_REQUEST, json.dumps({"error": "bad_request"}).encode()
+            elif mode == "rate_limit":
+                status, raw = STATUS_RATE, json.dumps({"error": "rate_limited"}).encode()
+                headers = {"Retry-After": str(RETRY_AFTER_SECONDS)}
+            elif mode == "server_error":
+                status, raw = STATUS_SERVER, json.dumps({"error": "unavailable"}).encode()
+            elif mode == "malformed_json":
+                status, raw = STATUS_OK, b'{"label": "ho'
+            elif mode == "malformed_label":
+                status, raw = STATUS_OK, json.dumps({"label": "lukewarm"}).encode()
+            elif mode == "refusal":
+                status, raw = STATUS_OK, json.dumps({"refusal": "I can not help with that request."}).encode()
+            else:  # ok, slow, timeout: the label answer, after a wait in the last two
+                status, raw = STATUS_OK, json.dumps({"label": label_for(email_key)}).encode()
+                if mode in ("slow", "timeout"):
+                    model.stop.wait(model.slow_seconds if mode == "slow" else model.hold_seconds)
+            if mode == "timeout":
+                model.log(lead_id, mode, self._reply(status, raw, headers))
+            else:
+                model.log(lead_id, mode, status)
+                self._reply(status, raw, headers)
+
+    return Handler
+
+
+class _Server(ThreadingHTTPServer):
+    daemon_threads = True
+    request_queue_size = 1024
+
+
+def serve(model: FakeModel, port: int = DEFAULT_PORT) -> _Server:
+    """Bind (port 0 = any free port) and return the server; the caller runs serve_forever."""
+    return _Server((BIND, port), make_handler(model))
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(prog="live_l2.fake_model")
+    ap.add_argument("--port", type=int, default=DEFAULT_PORT)
+    ap.add_argument("--call-log", type=Path, required=True)
+    ap.add_argument("--control-file", type=Path)
+    ap.add_argument("--mode", choices=MODES, default="ok")
+    a = ap.parse_args(argv)
+    model = FakeModel(a.call_log, a.control_file, a.mode)
+    server = serve(model, a.port)
+    print(f"fake model listening on http://{BIND}:{server.server_address[1]}", flush=True)
+    try:
+        server.serve_forever()
+    except KeyboardInterrupt:
+        pass
+    finally:
+        model.stop.set()
+        server.server_close()
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
