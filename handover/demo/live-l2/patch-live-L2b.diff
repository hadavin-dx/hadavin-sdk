+def run_world(tmp_path: Path, w: dict[str, Any], **kw: Any) -> dict[str, Any]:
+    db = tmp_path / "desk.sqlite3"
+    if db.exists():
+        db.unlink()
+    make_book(db, w["leads"])
+    book = ci.read_book(db)
+    return ci.run_checks(w["reqs"], book, w["mail"], w["crm"], w["model"], w["drained_ts"], **kw)
