+def test_mode_switch_over_http_and_file(model: Any, tmp_path: Path) -> None:
+    import urllib.request
+
+    req = urllib.request.Request(  # noqa: S310
+        model.url + "/__mode", b'{"mode": "refusal"}', {"Content-Type": "application/json"}
+    )
+    with urllib.request.urlopen(req, timeout=2) as r:  # noqa: S310
+        assert json.loads(r.read())["mode"] == "refusal"
+    with pytest.raises(http_qualifier.QualifierRefused):
+        http_qualifier.HttpQualifier(model.url, 2.0).qualify("L6", "f@example.test")
+    ctl = tmp_path / "mode.txt"
+    ctl.write_text("server_error", encoding="utf-8")
+    model.control_file = ctl
+    with pytest.raises(http_qualifier.QualifierServerError):
+        http_qualifier.HttpQualifier(model.url, 2.0).qualify("L6", "f@example.test")
+    ctl.write_text(json.dumps({"mode": "ok"}), encoding="utf-8")
+    assert http_qualifier.HttpQualifier(model.url, 2.0).qualify("L6", "f@example.test") in fake_model.LABELS
+
+
