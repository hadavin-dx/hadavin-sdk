+def test_rate_limit_carries_retry_after(model: Any) -> None:
+    model.set_mode("rate_limit")
+    with pytest.raises(http_qualifier.QualifierRateLimited) as info:
+        http_qualifier.HttpQualifier(model.url, 2.0).qualify("L3", "c@example.test")
+    assert info.value.retry_after == fake_model.RETRY_AFTER_SECONDS
+
+
+def test_slow_is_slow_but_answers(model: Any) -> None:
+    model.set_mode("slow")
+    t0 = time.monotonic()
+    assert http_qualifier.HttpQualifier(model.url, 3.0).qualify("L4", "d@example.test") in fake_model.LABELS
+    assert time.monotonic() - t0 >= 0.4
+    with pytest.raises(http_qualifier.QualifierTimeout):
+        http_qualifier.HttpQualifier(model.url, 0.1).qualify("L4", "d@example.test")
+
+
+def test_timeout_mode_never_answers_in_time(model: Any) -> None:
+    model.set_mode("timeout")
+    with pytest.raises(http_qualifier.QualifierTimeout):
+        http_qualifier.HttpQualifier(model.url, 0.3).qualify("L5", "e@example.test")
+    model.stop.set()  # release the held call: the client is gone, so the line says 499
+    deadline = time.monotonic() + 3
+    while time.monotonic() < deadline and not (model.call_log.exists() and calls(model)):
+        time.sleep(0.05)
+    assert [(c["mode"], c["lead_id"], c["status"]) for c in calls(model)] == [("timeout", "L5", 499)]
+
