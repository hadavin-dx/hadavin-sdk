+# ---------- fake_model and HttpQualifier ----------
+@pytest.fixture
+def model(tmp_path: Path) -> Any:
+    fm = fake_model.FakeModel(tmp_path / "calls.jsonl", slow_seconds=0.4, hold_seconds=3.0)
+    srv = fake_model.serve(fm, 0)
+    threading.Thread(target=srv.serve_forever, daemon=True).start()
+    fm.url = f"http://127.0.0.1:{srv.server_address[1]}"  # type: ignore[attr-defined]
+    yield fm
+    fm.stop.set()
+    srv.shutdown()
+    srv.server_close()
+
+
+def calls(fm: Any) -> list[dict[str, Any]]:
+    return [json.loads(x) for x in fm.call_log.read_text(encoding="utf-8").splitlines()]
+
+
+def test_mode_ok_gives_a_label(model: Any) -> None:
+    q = http_qualifier.HttpQualifier(model.url, 2.0)
+    assert q.qualify("L1", "a@example.test") in ("hot", "warm", "cold")
+    assert q.qualify("L1", "a@example.test") == q.qualify("L1", "a@example.test")  # same key, same label
+    assert [c["status"] for c in calls(model)] == [200, 200, 200]
+    assert calls(model)[0]["lead_id"] == "L1"
+    assert calls(model)[0]["mode"] == "ok"
+
+
+@pytest.mark.parametrize(
+    ("mode", "error"),
+    [
+        ("rate_limit", http_qualifier.QualifierRateLimited),
+        ("malformed_json", http_qualifier.QualifierBadReply),
+        ("malformed_label", http_qualifier.QualifierBadReply),
+        ("refusal", http_qualifier.QualifierRefused),
+        ("server_error", http_qualifier.QualifierServerError),
+    ],
+)
+def test_bad_modes_raise_their_error(model: Any, mode: str, error: type[Exception]) -> None:
+    model.set_mode(mode)
+    with pytest.raises(error):
+        http_qualifier.HttpQualifier(model.url, 2.0).qualify("L2", "b@example.test")
+    row = calls(model)[-1]
+    assert (row["mode"], row["lead_id"]) == (mode, "L2")
+    assert row["status"] in (200, 429, 503)
+
