+    assert ob.send("K-2", TO, SUBJECT, BODY, BUDGET) == "SENT"
+    assert ob.send("K-2", TO, SUBJECT, BODY, BUDGET) == "SENT"
+    recs = catch.records()
+    assert [r["send_key"] for r in recs] == ["K-2", "K-2"]
+    assert recs[0]["message_id"] == recs[1]["message_id"]
