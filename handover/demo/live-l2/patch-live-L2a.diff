+def test_catcher_takes_200_connections(catch: Catch) -> None:
+    held = []
+    try:
+        for _ in range(200):
+            s = socket.create_connection((HOST, catch.port), timeout=5)
+            held.append(s)
+        assert all(s.recv(4).startswith(b"220") for s in held)
+    finally:
+        for s in held:
+            s.close()
