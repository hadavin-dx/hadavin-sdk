diff --git a/tests/conftest.py b/tests/conftest.py
index 2635950..0de910f 100644
--- a/tests/conftest.py
+++ b/tests/conftest.py
@@ -122,3 +122,44 @@ def env(tmp_path: Path) -> Iterator[Env]:
         yield e
     finally:
         e.close()
+
+
+# Parallel runs (pytest -n N --dist loadgroup, see docs/tests.md): the real-browser tests are load-sensitive, so they
+# all go to ONE worker (the same group name); everything else is spread freely. Without -n this changes nothing.
+# pytest 9.2 keeps node ids in a structured item._id, but pytest-xdist 3.8.0 still writes its group suffix into the
+# old item._nodeid, which pytest 9.2 ignores: loadgroup then groups nothing and the tests spread over all workers
+# (measured 2026-11-12: 86 browser tests on gw0 28, gw1 31, gw2 27). So the suffix that the scheduler reads is set here.
+_BROWSER_FILES = {"test_portal_browser", "test_portal_look", "test_portal_ui4", "test_portal_wpd"}
+_GROUP = "browser"
+# the reset-script tests share ONE fixed folder (data/reset-guard-test): they run on one worker, or the files collide
+_RESET_FILES = {"test_reset_scripts"}
+
+
+@pytest.hookimpl(trylast=True)
+def pytest_collection_modifyitems(config: pytest.Config, items: list[pytest.Item]) -> None:
+    import inspect
+
+    from _pytest.nodeid import NodeId
+
+    grouping = bool(getattr(config.option, "loadgroup", False))  # set only inside an xdist worker run with loadgroup
+    for item in items:
+        fn = getattr(item, "function", None)
+        try:
+            src = inspect.getsource(fn) if fn is not None else ""
+        except (OSError, TypeError):
+            src = ""
+        group = ""
+        if item.module.__name__ in _RESET_FILES:
+            group = "reset"
+        elif item.module.__name__ in _BROWSER_FILES or "sync_playwright" in src:
+            group = _GROUP
+        if group:
+            item.add_marker(pytest.mark.xdist_group(group))
+            if grouping and not item.nodeid.endswith("@" + group):
+                item._id = NodeId.parse(item.nodeid + "@" + group)  # the scheduler splits the group off the last "@"
+
+
+def pytest_configure(config: pytest.Config) -> None:
+    # pytest-xdist workers get COLUMNS=80, a serial run has none. With it `ps -o args=` in scripts/reset.sh cuts the
+    # command line at 80 characters, the desk is not recognised and the reset refuses. Removed.
+    os.environ.pop("COLUMNS", None)
