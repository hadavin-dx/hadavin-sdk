+def check_columns_mapped(rig: Any, mapping_by_table: dict[str, dict[str, str]]) -> None:
+    listed = {r["field"] for r in portal_api._data_map(rig.desk)["stored"]}
+    tables = {r[0] for r in rig.query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")}
+    assert tables == set(mapping_by_table), tables ^ set(mapping_by_table)
+    used: set[str] = set()
+    for table, mapping in mapping_by_table.items():
+        columns = {r[1] for r in rig.query(f"PRAGMA table_info({table})")}
+        assert columns == set(mapping), (table, columns ^ set(mapping))
+        for col, stands in mapping.items():
+            if stands.startswith("internal: "):
+                assert (table, col) in _INTERNAL_ALLOWED, f"{table}.{col} is not an allowed internal column"
+            else:
+                assert stands in listed, (table, col, stands)
+                used.add(stands)
+    assert used <= listed
+    assert listed <= used, f"listed fields no column stands for: {listed - used}"  # the reverse check
