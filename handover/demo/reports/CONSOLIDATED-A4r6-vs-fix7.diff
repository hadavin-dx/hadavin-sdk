+def test_refusals_are_not_paced_by_the_drain() -> None:
+    """40 silent clients: the old refusal waited QUIET_DRAIN_SECONDS (0.05 s) for each, 2 s in all."""
+    pairs = [_tcp_pair() for _ in range(40)]
+    try:
+        t0 = time.monotonic()
+        for _, srv_side in pairs:
+            server._Server._refuse_busy(_Refuser(), srv_side)  # type: ignore[arg-type]
+        took = time.monotonic() - t0
+        assert took < 40 * constants.QUIET_DRAIN_SECONDS / 4, took
+        c = pairs[0][0]
+        assert c.recv(4096).startswith(b"HTTP/1.0 503")
+    finally:
+        for c, _ in pairs:
+            c.close()
+
