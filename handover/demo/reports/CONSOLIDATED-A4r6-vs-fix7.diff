+def raw_lead(con: sqlite3.Connection, lead_id: str, receipt_id: int, key: str) -> None:
+    con.execute(
+        "INSERT INTO leads(lead_id, receipt_id, source, name, email, email_key, created_at)"
+        " VALUES(?,?,'form','Ada',?,?,1)",
