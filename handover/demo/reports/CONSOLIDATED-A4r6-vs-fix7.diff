+# -- a refusal never waits for a silent client
+def _tcp_pair() -> tuple[socket.socket, socket.socket]:
+    ls = socket.socket()
+    ls.bind((HOST, 0))
+    ls.listen(1)
+    c = socket.create_connection(ls.getsockname(), timeout=8)
+    s, _ = ls.accept()
+    ls.close()
+    return c, s
+
