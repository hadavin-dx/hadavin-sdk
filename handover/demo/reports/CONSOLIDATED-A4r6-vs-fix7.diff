+def _describe(
+    item: dict[str, Any], stall_seconds: int, maybe_sent: bool = False, crm_open: bool = False
+) -> dict[str, Any]:
+    """tab, title, reason_text and actions of one item, from the fixed table in the design (section 2.3)."""
+    kind, reason, item_id = str(item["kind"]), str(item["reason"] or ""), str(item["item_id"])
+    tab, actions = "action", []
+    if kind == "failed":
+        if reason in _PERSON_TEXT:  # the words of the person's own decision come first
+            title, text = (_PERSON_TEXT_CRM if crm_open and reason in _PERSON_TEXT_CRM else _PERSON_TEXT)[reason]
+        # "nothing was sent" only when the reason says so AND no earlier send may have left (ambiguous_prior)
+        elif not maybe_sent and (reason in _NOTHING_SENT_TEXT or reason.startswith("internal")):
+            title = "Follow-up failed; nothing was sent"
+            text = _NOTHING_SENT_TEXT.get(reason, _NOTHING_SENT_INTERNAL)
+        else:  # ambiguous, crash_while_sending, anything else: the email may have left
+            title, text = "Follow-up did not finish", _DID_NOT_FINISH_TEXT
+        actions = [_action(_RETRY, item_id, "retry")]
+    elif kind == "unknown" and reason == "crm_unconfirmed":
+        title, text = "UNKNOWN: the CRM may or may not hold this lead", _UNKNOWN_TEXT[reason]
+        actions = [
+            _action(_RETRY, item_id, "retry"),  # the desk answers 409 unknown_needs_person; the page shows its words
+            _action(
+                {"id": "resolve_crm_present", "label": "The CRM row is there", "confirm": _CRM_PRESENT_CONFIRM},
+                item_id,
+                "resolve",
