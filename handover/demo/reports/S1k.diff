+def test_blind_retry_waits_for_old_send(env, quick) -> None:
+    """A person marks a blind send `not sent` while the abandoned send is still running: Retry must not ask the sender
+    a second time (it is given back, `send_busy`), and once the old send has ended the person's choice stands."""
+    outbox = hang_outbox(BlindOutbox)
+    rig = rig_with(env, outbox=outbox)
+    lid = new_lead(rig, "k5")
+    outbox.hang_ids.add(lid)
