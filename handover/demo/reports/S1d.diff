+def ensure_descriptor_budget(max_threads: int = MAX_HANDLER_THREADS, res: Any = None) -> None:
+    """Check at start-up that the open-file limit (RLIMIT_NOFILE) covers MAX_HANDLER_THREADS handler threads at
