+class _RefusingSocket:
+    """Records the timeout each connect attempt was given; every connect is refused."""
+
+    timeouts: list[float] = []  # noqa: RUF012
+
+    def __init__(self, *a: object, **k: object) -> None:
+        pass
+
+    def settimeout(self, value: float) -> None:
+        self.timeouts.append(value)
+
+    def connect(self, addr: object) -> None:
+        raise ConnectionRefusedError
+
+    def close(self) -> None:
+        pass
+
+
+def test_address_gets_budget_share(monkeypatch: pytest.MonkeyPatch) -> None:
+    """m1: the first of two addresses may use half of what is left, never all of it."""
+    _RefusingSocket.timeouts = []
+    ob = SmtpOutbox(SmtpSettings(host=HOST, port=free_port()))
+    monkeypatch.setattr(SmtpOutbox, "_addresses", lambda self: [(socket.AF_INET, HOST)] * 2)
+    monkeypatch.setattr(smtp_outbox.socket, "socket", _RefusingSocket)
+    with pytest.raises(SendUnreachable):
+        ob.send("K-r3", TO, SUBJECT, BODY, 4.0)
+    first, second = _RefusingSocket.timeouts
+    assert first <= 2.0 + 0.05
+    assert second > first
+
+
+def test_one_address_gets_the_whole_budget(monkeypatch: pytest.MonkeyPatch) -> None:
+    _RefusingSocket.timeouts = []
+    ob = SmtpOutbox(SmtpSettings(host=HOST, port=free_port()))
+    monkeypatch.setattr(smtp_outbox.socket, "socket", _RefusingSocket)
+    with pytest.raises(SendUnreachable):
+        ob.send("K-r4", TO, SUBJECT, BODY, 4.0)
+    assert len(_RefusingSocket.timeouts) == 1
+    assert 3.9 < _RefusingSocket.timeouts[0] <= 4.0
