+def test_worker_survives_write_fail(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    """The old thread died on the first failed write and left the rest of its queue unsent."""
+    items = load_driver.build_schedule("burst:4", time.time() - 1, "k", 1)
+    sent: list[str] = []
+
+    def fake_send(url: str, item: dict[str, Any]) -> dict[str, Any]:
+        sent.append(item["request_id"])
+        return {"request_id": item["request_id"], "final_status": 201}
+
+    class Flaky:
+        n = 0
+
+        def write(self, text: str) -> None:
+            Flaky.n += 1
+            if Flaky.n == 2:
+                raise OSError("disk full")
+
+        def flush(self) -> None:
+            pass
+
+        def close(self) -> None:
+            pass
+
+    class Part:
+        def open(self, *a: Any, **k: Any) -> Flaky:
+            return Flaky()
+
+    monkeypatch.setattr(load_driver, "send_with_retries", fake_send)
+    load_driver._worker((0, "http://127.0.0.1:1/leads", items, 1, Part()))  # type: ignore[arg-type]
+    assert sorted(sent) == sorted(it["request_id"] for it in items)
