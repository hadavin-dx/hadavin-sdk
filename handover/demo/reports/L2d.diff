+# -- M1: replies the HTTP library cannot read are failed tries, never a dropped item
+class _RawDesk:
+    """A raw TCP stand-in: writes `reply` to the first `bad` connections, then answers 201."""
+
+    def __init__(self, reply: bytes, bad: int) -> None:
+        import socket as _socket
+
+        self.reply, self.bad, self.count = reply, bad, 0
+        self.sock = _socket.socket()
+        self.sock.bind(("127.0.0.1", 0))
+        self.sock.listen(8)
+        self.port = int(self.sock.getsockname()[1])
+        self.stop = False
+        threading.Thread(target=self._serve, daemon=True).start()
+
+    def _serve(self) -> None:
+        while not self.stop:
+            try:
+                conn, _ = self.sock.accept()
+            except OSError:
+                return
+            threading.Thread(target=self._one, args=(conn,), daemon=True).start()
+
+    def _one(self, conn: Any) -> None:
+        with conn:
+            conn.settimeout(5)
+            data = b""
+            try:
+                while b"\r\n\r\n" not in data:
+                    data += conn.recv(4096)
+                head, _, rest = data.partition(b"\r\n\r\n")
+                want = int(
+                    next(x.split(b":")[1] for x in head.split(b"\r\n") if x.lower().startswith(b"content-length"))
+                )
+                while len(rest) < want:
+                    rest += conn.recv(4096)
+                self.count += 1
+                if self.count <= self.bad:
+                    conn.sendall(self.reply)
+                else:
+                    body = b'{"receipt_id": 7, "verdict": "new"}'
+                    conn.sendall(
+                        b"HTTP/1.1 201 Created\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s" % (len(body), body)
+                    )
+            except OSError:
+                return
+
+    def close(self) -> None:
+        self.stop = True
+        self.sock.close()
+
+
+CUT_REPLIES = {
+    "BadStatusLine": b"GARBAGE NOT HTTP\r\n\r\n",
+    "LineTooLong": b"HTTP/1.1 200 " + b"x" * 70000,
+    "IncompleteRead": b'HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\n{"rec',
+}
+
+
+@pytest.mark.parametrize("error", sorted(CUT_REPLIES))
+def test_unreadable_reply_is_a_failed_try(monkeypatch: pytest.MonkeyPatch, error: str) -> None:
+    monkeypatch.setattr(load_driver, "BACKOFF_SECONDS", 0.0)
+    srv = _RawDesk(CUT_REPLIES[error], bad=10**6)
+    try:
+        item = load_driver.build_schedule("burst:1", time.time(), "cut", 1)[0]
+        line = load_driver.send_with_retries(f"http://127.0.0.1:{srv.port}/leads", item)
+    finally:
+        srv.close()
+    assert line["final_status"] in (error, "RemoteDisconnected", "ConnectionResetError")
+    assert len(line["attempts"]) == load_driver.MAX_RETRIES + 1  # every try was recorded, none raised out
+
+
