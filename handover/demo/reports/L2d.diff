+def model_bound_for(sc: Scenario) -> int:
+    """Most model calls one lead may cause in this scenario (check 5). Model never down: one call, plus the slack when a
+    desk kill can lose a call. Model down at any time in the run: one call per automatic try, plus the slack."""
+    modes = {sc.model_mode} | {e[2] for e in sc.events if e[1] == "model"}
+    killed = any(e[1] == "crash" for e in sc.events)
+    if modes & MODEL_DOWN_MODES:
+        return SEND_MAX_ATTEMPTS + MODEL_CALL_SLACK
+    return MODEL_CALLS_WHEN_UP + (MODEL_CALL_SLACK if killed else 0)
 
 
