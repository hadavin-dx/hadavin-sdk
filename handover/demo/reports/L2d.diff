+def make_lost_book(path: Path, outcome: str | None, refs: list[str] | None = None, payload: str = "{}") -> None:
+    """Every request has a receipt and NOTHING else: no lead, no follow-up. `outcome` is the verdict on each receipt."""
+    conn = sqlite3.connect(path)
+    conn.executescript(SCHEMA.read_text(encoding="utf-8"))
+    for n, ref in enumerate(LOST_REFS if refs is None else refs):
+        door = ("form", "webhook")[n % 2]
+        if outcome is None:
+            conn.execute(
+                "INSERT INTO receipts(source, source_ref, received_at, payload) VALUES (?, ?, ?, ?)",
+                (door, ref, int(T0), payload),
+            )
+        else:
+            conn.execute(
+                "INSERT INTO receipts(source, source_ref, received_at, payload, outcome, outcome_reason, decided_at)"
+                " VALUES (?, ?, ?, ?, ?, 'planted', ?)",
+                (door, ref, int(T0), payload, outcome, int(T0)),
+            )
+    conn.commit()
+    conn.close()
+
+
+def lost_request_log() -> list[dict[str, Any]]:
