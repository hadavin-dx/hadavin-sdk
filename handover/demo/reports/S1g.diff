+            self.timeout_seconds = timeout
+
+    Desk(rig.config, rig.crm, rig.outbox, Declares(rig.replies_path, limit)).close()  # exactly at the limit: fine
+    with pytest.raises(ValueError, match="timeout_seconds"):
+        Desk(rig.config, rig.crm, rig.outbox, Declares(rig.replies_path, limit + 1))
+    longer = replace(rig.config, send_timeout_seconds=rig.config.send_timeout_seconds + 10)
+    Desk(longer, rig.crm, rig.outbox, Declares(rig.replies_path, limit + 1)).close()  # a longer grace allows more
