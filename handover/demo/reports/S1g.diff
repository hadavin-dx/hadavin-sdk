+# =====
+# Nit 4: the give-back retries, and an empty file table on the CRM put is not "unknown"
+# =====
+class NoHandleOutbox(BlindOutbox):
+    def __init__(self) -> None:
+        super().__init__()
+        self.armed = False
+
+    def send(self, *a: Any, **k: Any) -> Any:
+        self.armed = True
+        raise SendNoDescriptors("EMFILE")
