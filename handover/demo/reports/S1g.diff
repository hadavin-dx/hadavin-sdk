+def test_stamp_before_send_lock_gives_back(env, monkeypatch) -> None:
+    """Sibling: a real lock on the second stamp, the one that also writes the send mark. The CRM row is made, the
+    email is not, and the try comes back."""
+    rig = env.rig()
+    lid = new_lead(rig, "g4")
+    real = rig.desk._locked_retry
+    stamps = {"n": 0}
+
+    def retry(fn: Any) -> Any:
+        if "_touch" in fn.__qualname__:
+            stamps["n"] += 1
+            if stamps["n"] == 2:
+                raise sqlite3.OperationalError(LOCKED)
