+def test_odd_error_after_text_ambiguous(catch: Catch, monkeypatch: pytest.MonkeyPatch) -> None:
+    def boom(*a: object, **k: object) -> int:
+        raise RuntimeError("odd")
+
+    real = smtp_outbox._read_reply
+    calls = {"n": 0}
+
+    def late(sock: socket.socket, budget: object, buf: bytearray) -> int:
+        calls["n"] += 1
+        if calls["n"] == 6:  # greeting, EHLO, MAIL, RCPT, DATA, then the final reply
+            return boom()
+        return real(sock, budget, buf)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(smtp_outbox, "_read_reply", late)
+    with pytest.raises(SendAmbiguous):
+        catch.outbox().send("K-26", TO, SUBJECT, BODY, BUDGET)
+    wait_until(lambda: len(catch.records()) == 1, 3.0)
+
