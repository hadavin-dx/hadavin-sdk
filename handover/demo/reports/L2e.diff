+def load_numbers(sc: Scenario) -> tuple[float, float, int]:
+    """(requests per second, seconds the load lasts, leads) of the scenario's load. A burst is one moment (rate = N)."""
+    name, nums = parse_scenario(sc.load)
+    if name == "burst":
+        return nums[0], 1.0, int(nums[0])
+    if name == "rate":
+        return nums[0], nums[1], int(nums[0] * nums[1])
+    total = int(nums[0])
+    repeats = min(round(total * nums[1]), total - 1)
+    rate = nums[2] if len(nums) > 2 else 200.0  # noqa: PLR2004 (load_driver.DUPMIX_DEFAULT_RATE)
+    return rate, (total - repeats) / rate, total - repeats
+
