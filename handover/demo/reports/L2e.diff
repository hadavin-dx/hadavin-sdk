+def derive_max_failed(sc: Scenario) -> int:
+    """Ceiling on `failed` follow-ups for a scenario whose model or mail server is down for a while. A lead can only
+    fail when all SEND_MAX_ATTEMPTS automatic tries fall inside a down window, so it must have been submitted inside the
+    window: ceiling = ceil(rate x (total window seconds + FAULT_MARGIN_SECONDS per window)), at most all leads.
+    Worked values are in README-L2.md (generated from this function)."""
+    rate, _, leads = load_numbers(sc)
+    windows = static_windows(sc, "model", lambda m: is_model_down(m, sc.model_timeout)) + static_windows(
+        sc, "catcher", lambda m: m.split()[0] == "down"
+    )
+    if not windows:
+        return 0
+    seconds = sum(b - a for a, b in windows) + FAULT_MARGIN_SECONDS * len(windows)
+    return min(leads, math.ceil(rate * seconds))
+
+
+def failed_arithmetic(sc: Scenario) -> str:
+    rate, _, leads = load_numbers(sc)
+    windows = static_windows(sc, "model", lambda m: is_model_down(m, sc.model_timeout)) + static_windows(
+        sc, "catcher", lambda m: m.split()[0] == "down"
+    )
+    if not windows:
+        return "0 (no window)"
+    total = sum(b - a for a, b in windows)
+    return (
+        f"min({leads}, ceil({rate:g} x ({total:g} s + {len(windows)} x {FAULT_MARGIN_SECONDS:g} s))) = "
+        f"{derive_max_failed(sc)}"
+    )
+
+
