+def run_custom(
+    tmp_path: Path, w: dict[str, Any], sql: list[str] | None = None, drop_keys: tuple[str, ...] = (), **kw: Any
+) -> dict[str, Any]:
+    db = tmp_path / "custom.sqlite3"
+    if db.exists():
+        db.unlink()
+    sync_receipt_ids(w)
+    make_book(db, w["leads"])
+    if sql:
+        import sqlite3
+
+        conn = sqlite3.connect(db)
+        for stmt in sql:
+            conn.execute(stmt)
+        conn.commit()
+        conn.close()
+    book = ci.read_book(db)
+    for k in drop_keys:
+        book.pop(k)
+    kw.setdefault("intended", w["intended"])
+    return ci.run_checks(w["reqs"], book, w["mail"], w["crm"], w["model"], w["drained_ts"], **kw)
