+def test_odd_error_before_text_unreachable(script: Callable[[str], Script], monkeypatch: pytest.MonkeyPatch) -> None:
+    real = smtp_outbox._command
+
+    def boom(sock: socket.socket, budget: object, buf: bytearray, line: str) -> int:
+        if line.startswith("RCPT"):
+            raise RuntimeError("odd")
+        return real(sock, budget, buf, line)  # type: ignore[arg-type]
+
+    monkeypatch.setattr(smtp_outbox, "_command", boom)
