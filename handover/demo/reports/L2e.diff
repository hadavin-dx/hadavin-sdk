+def static_windows(sc: Scenario, kind: str, down: Any) -> list[tuple[float, float]]:
+    """(start, end) seconds after the load start in which the model (kind "model") or the mail server (kind "catcher")
+    is down per `down(mode)`, from the scenario's first mode and its events. An unrecovered fault ends with the load."""
+    _, seconds, _ = load_numbers(sc)
+    first = sc.model_mode if kind == "model" else sc.catcher_mode
+    timeline = [(0.0, first)] + sorted((e[0], e[2]) for e in sc.events if e[1] == kind)
+    windows: list[tuple[float, float]] = []
+    for i, (at, mode) in enumerate(timeline):
+        end = timeline[i + 1][0] if i + 1 < len(timeline) else max(seconds, at)
+        if down(mode) and end > at:
+            windows.append((at, end))
+    return windows
+
