+        except Exception as e:  # noqa: BLE001 (known and unknown alike: the text began to go out, maybe sent)
             raise SendAmbiguous(type(e).__name__) from e
         if code // 100 != _POSITIVE_DONE:
             raise SendAmbiguous(f"final reply {code}")
