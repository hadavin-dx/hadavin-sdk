+def handler_with_failing_write(exc: BaseException) -> Any:
+    h = object.__new__(server._Handler)
+    h.request_version, h.command, h.requestline = "HTTP/1.0", "GET", "GET / HTTP/1.0"
+    h.wfile = _Boom(exc)
+    h.connection = _Conn()
+    h.close_connection = False
+
+    class NoSlot:
+        def release(self) -> None:
+            pass
+
+    h._slot = NoSlot()
+    return h
