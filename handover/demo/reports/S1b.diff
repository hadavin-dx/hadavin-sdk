+def parse_reply(raw: bytes) -> tuple[int, dict[str, str], Any]:
+    """(status, lower-case headers, parsed JSON body) of a complete reply; fails on a partial one."""
+    head, sep, body = raw.partition(b"\r\n\r\n")
