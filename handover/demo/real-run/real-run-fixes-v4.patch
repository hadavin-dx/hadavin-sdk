+def test_a_clean_self_test_deletes_its_folder_too(own_tempdir: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    """The success path: no --keep, every check passes, exit 0, and the folder is gone (not only after a failure)."""
+    assert rrc.main(["--dry-fakes", "--assume-yes"]) == 0
+    out = capsys.readouterr().out
+    assert list(own_tempdir.glob("real-dry-*")) == []
+    assert "is deleted when the script ends" in out and "result file:" not in out
