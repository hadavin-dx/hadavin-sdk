+
+def test_the_live_key_file_is_not_looked_at_without_the_live_flag(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    cfg = _valid_config(tmp_path, **_live_lines(tmp_path, tmp_path / "no-such-live-key"))
+    monkeypatch.setattr("builtins.input", lambda prompt="": "n")
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_STOPPED  # reaches the question: the recorded model needs no key
