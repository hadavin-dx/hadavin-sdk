+
+# -- the own_tempdir fixture really moves the temporary folders (a no-op fixture must fail a test) ---------------------
+
+
+def test_own_tempdir_puts_temporary_folders_under_the_test_folder(own_tempdir: Path) -> None:
+    made = Path(tempfile.mkdtemp(prefix="real-dry-"))
+    assert made.parent == own_tempdir and Path(tempfile.gettempdir()) == own_tempdir
+
+
+def test_every_keep_self_test_in_the_suite_uses_its_own_temp_folder() -> None:
+    """A test that runs the self-test with --keep leaves a folder behind: it must use the own_tempdir fixture (or set
+    tempfile.tempdir itself). A new test that forgets this fails here, so the system temp folder stays clean."""
+    found = 0
+    for path in sorted((REPO / "tests").glob("test_*.py")):
+        leaks, n = keep_self_tests_that_leak(path.read_text(encoding="utf-8"))
+        found += n
+        assert leaks == [], f"{path.name}: {leaks} run the keep self-test without own_tempdir: they leave a folder"
+    assert found >= 5  # the suite does have these tests; a scan that finds none proves nothing
+
+
+_FIXTURE_USER = "def test_a(own_tempdir):\n    main({args})\n"
+
+
+@pytest.mark.parametrize(
+    "args",
+    [
+        '["--dry-fakes", "--keep"]',
+        "['--dry-fakes', '--keep']",
+        "'--dry-fakes --keep'.split()",
+        '["--dry-fakes", "--kee"]',
+        '["--dry-f", "--keep", "--assume-yes"]',
+        '["--keep=1", "--dry-fakes"]',
+    ],
+)
+def test_the_scan_sees_every_spelling_of_the_keep_self_test(args: str) -> None:
+    leaks, found = keep_self_tests_that_leak("def test_a():\n    main(" + args + ")\n")
+    assert (leaks, found) == (["test_a"], 1)
+    assert keep_self_tests_that_leak(_FIXTURE_USER.format(args=args)) == ([], 1)  # the fixture itself is enough
