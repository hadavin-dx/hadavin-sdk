@@ -0,0 +1,509 @@
+"""The take scripts refuse a bad key file, `:memory:` and a non-UTF-8 config BEFORE the y/N question, print no byte
+value, leave no stray folder; run_live_check.py ends without a traceback and with a non-zero exit when its calls
+failed. Loopback only, made-up data only."""
+
+from __future__ import annotations
+
+import subprocess  # noqa: S404
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+import run_real_check as rrc  # noqa: E402
+from keep_scan import keep_self_tests_that_leak  # noqa: E402
+from test_real_check_dry import _valid_config  # noqa: E402
+
+from lead_desk.desk import book_problem  # noqa: E402
+
+KEY = "made-up-" + "key-0002"  # built from parts
+
+
+def _no_question(prompt: str = "") -> str:
+    raise AssertionError("the y/N question was asked")
+
+
+@pytest.mark.parametrize(
+    "content", [None, KEY + "\n" + KEY + "\n", "short", b"\xff\xfe" + b"k\x00" * 9, b"\xc3\x28" * 9], ids=str
+)
+def test_a_bad_hubspot_key_file_is_refused_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, content: str | bytes | None
+) -> None:
+    key = tmp_path / "bad.key"
+    if isinstance(content, str):
+        key.write_text(content, encoding="utf-8")
+    elif content is not None:
+        key.write_bytes(content)
+    cfg = _valid_config(tmp_path, DESK_HUBSPOT_KEY_FILE=str(key))
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "refused: DESK_HUBSPOT_KEY_FILE" in out and KEY not in out and "bad.key" not in out
+
+
+def test_memory_book_is_refused_like_the_desk_and_leaves_no_file(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(_valid_config(tmp_path, DESK_DB_PATH=":memory:"))]) == rrc.EXIT_BOOK_REFUSED == 4
+    assert str(book_problem(":memory:")) in capsys.readouterr().out
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["c.env", "hub.key", "mail.pw"]  # no desk-1.log, no new folder
+
+
+def test_a_config_that_is_not_utf8_is_refused_without_a_byte_value(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    cfg = tmp_path / "bin.env"
+    cfg.write_bytes(b"\xff\xfe\x00DESK_DB_PATH=x\n")
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "not UTF-8" in out and "0xff" not in out and "position" not in out
+
+
+def test_dry_fakes_folder_is_deleted_also_when_the_self_test_fails(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    class Broken:
+        def __init__(self, folder: Path, *_a: object) -> None:
+            (folder / "fakes").mkdir()
+            raise ValueError("the openssl program is needed for --dry-fakes")
+
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    monkeypatch.setattr(rrc, "DryFakes", Broken)
+    assert rrc.main(["--dry-fakes", "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert "refused" in capsys.readouterr().out
+    assert list(tmp_path.glob("real-dry-*")) == []
+    monkeypatch.setattr(rrc, "DryFakes", Broken)
+    assert rrc.main(["--dry-fakes", "--keep", "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert len(list(tmp_path.glob("real-dry-*"))) == 1  # --keep keeps it
+
+
+def test_the_readback_note_says_plainly_when_no_contact_was_created(tmp_path: Path) -> None:
+    class A:
+        cleanup = False
+        dry_fakes = False
+        keep = False
+
+    env = {"REAL_RESULT_FILE": str(tmp_path / "r.json")}
+    code = rrc._readback_failed(A(), tmp_path, env, rrc.CrmError("x"), 0, {"created": 0})  # type: ignore[arg-type]
+    text = (tmp_path / "r.json").read_text(encoding="utf-8")
+    assert code == rrc.EXIT_FAILED and "no contact" in text and "by hand" not in text
+
+
+# -- scripts/run_live_check.py (loopback, nothing listens there) -----------------------------------------------------
+
+
+def _live(
+    tmp_path: Path, key: Path, stdin: int | str | None, ledger: Path | None = None
+) -> subprocess.CompletedProcess[str]:
+    cmd = [
+        sys.executable,
+        str(REPO / "scripts" / "run_live_check.py"),
+        "--key-file",
+        str(key),
+        "--base-url",
+        "http://127.0.0.1:1",
+        "--ledger",
+        str(ledger or tmp_path / "ledger.jsonl"),
+        "--cap-run",
+        "1",
+        "--cap-total",
+        "3",
+        "--price-date",
+        "2026-01-01",
+        "--model",
+        "fake-a=2,10",
+        "--leads",
+        "1",
+        "--runs",
+        "1",
+    ]
+    kw: dict[str, object] = {"stdin": stdin} if stdin == subprocess.DEVNULL else {"input": stdin}
+    return subprocess.run(cmd, capture_output=True, text=True, timeout=60, check=False, **kw)  # type: ignore[call-overload]  # noqa: S603
+
+
+def test_live_check_without_a_terminal_stops_with_one_line_not_a_traceback(tmp_path: Path) -> None:
+    key = tmp_path / "k"
+    key.write_text(KEY, encoding="utf-8")
+    r = _live(tmp_path, key, subprocess.DEVNULL)
+    assert r.returncode == 1 and "Traceback" not in r.stderr and "no terminal" in r.stdout
+
+
+def test_live_check_exits_non_zero_when_every_call_failed(tmp_path: Path) -> None:
+    key = tmp_path / "k"
+    key.write_text(KEY, encoding="utf-8")
+    r = _live(tmp_path, key, "y\n")
+    assert r.returncode == 3, r.stdout[-400:]
+    assert "LiveTransport" in r.stdout and KEY not in r.stdout + r.stderr
+
+
+@pytest.mark.parametrize("content", [None, "short"], ids=["missing", "short"])
+def test_live_check_refuses_a_bad_key_file_before_the_question(tmp_path: Path, content: str | None) -> None:
+    key = tmp_path / "k"
+    if content is not None:
+        key.write_text(content, encoding="utf-8")
+    r = _live(tmp_path, key, "y\n")  # a "y" is ready, but must never be read
+    assert r.returncode == 2 and "refused" in r.stdout and "Start?" not in r.stdout
+    assert str(tmp_path) not in r.stdout + r.stderr
+
+
+def test_keep_without_the_self_test_is_refused(tmp_path: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    assert rrc.main(["--config", str(_valid_config(tmp_path)), "--keep"]) == rrc.EXIT_REFUSED
+    assert "--keep is only for the self-test" in capsys.readouterr().out
+
+
+def test_the_closing_line_of_a_self_test_tells_how_to_keep_the_logs(tmp_path: Path) -> None:
+    class A:
+        dry_fakes = True
+        keep = False
+
+    assert "--keep" in rrc.result_line(A(), tmp_path / "r.json")  # type: ignore[arg-type]
+    A.keep = True
+    assert rrc.result_line(A(), tmp_path / "r.json") == f"result file: {tmp_path / 'r.json'}"  # type: ignore[arg-type]
+
+
+# -- every secret file the run will open is checked before the question (sibling of the HubSpot key file) -----------
+
+_BAD_SECRET_FILES = [None, KEY + "\n" + KEY + "\n", "abc", b"\xff\xfe" + b"k\x00" * 9]
+_BAD_IDS = ["missing", "two-lines", "too-short", "utf16"]
+
+
+def _write(path: Path, content: str | bytes | None) -> None:
+    if isinstance(content, str):
+        path.write_text(content, encoding="utf-8")
+    elif content is not None:
+        path.write_bytes(content)
+
+
+@pytest.mark.parametrize("content", _BAD_SECRET_FILES, ids=_BAD_IDS)
+@pytest.mark.parametrize(
+    "setting", ["DESK_SMTPP_PASSWORD_FILE", "REAL_IMAP_1_PASSWORD_FILE", "REAL_IMAP_2_PASSWORD_FILE"]
+)
+def test_a_bad_mail_password_file_is_refused_before_the_question(
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+    monkeypatch: pytest.MonkeyPatch,
+    setting: str,
+    content: str | bytes | None,
+) -> None:
+    bad = tmp_path / "bad.pw"
+    _write(bad, content)
+    cfg = _valid_config(tmp_path, **{setting: str(bad)})
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert f"refused: {setting}" in out and KEY not in out and "bad.pw" not in out and str(tmp_path) not in out
+    assert not (tmp_path / "run").exists()  # nothing was started
+
+
+def _live_lines(tmp_path: Path, key: Path) -> dict[str, str]:
+    return {
+        "DESK_LIVE_MODEL": "model-x",
+        "DESK_LIVE_KEY_FILE": str(key),
+        "DESK_LIVE_PRICE_IN_PER_MTOK": "1",
+        "DESK_LIVE_PRICE_OUT_PER_MTOK": "5",
+        "DESK_LIVE_PRICE_DATE": "2026-01-01",
+        "DESK_LIVE_CAP_RUN_USD": "1.25",
+        "DESK_LIVE_CAP_TOTAL_USD": "3",
+        "DESK_LIVE_LEDGER_PATH": str(tmp_path / "ledger"),
+        "DESK_LIVE_RUN_ID": "r1",
+    }
+
+
+@pytest.mark.parametrize("content", [None, "abc", ""], ids=["missing", "too-short", "empty"])
+def test_a_bad_live_model_key_file_is_refused_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, content: str | None
+) -> None:
+    key = tmp_path / "bad.livekey"
+    _write(key, content)
+    cfg = _valid_config(tmp_path, **_live_lines(tmp_path, key))
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(cfg), "--live-model"]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "refused: DESK_LIVE_KEY_FILE" in out and "bad.livekey" not in out and str(tmp_path) not in out
