+"""The scan behind `test_every_keep_self_test_in_the_suite_uses_its_own_temp_folder`. It lives in its own file, whose
+name does not start with `test_`, so the scan never reads its own flag names and reports them as a leaking test."""
+
+from __future__ import annotations
+
+import ast
+
+
+def _words(node: ast.AST) -> list[str]:
+    """Every word of every string constant under `node`, whatever the quotes or how the list is built (a plain list,
+    an f-string part, `"--dry-fakes --keep".split()`)."""
+    return [
+        w for n in ast.walk(node) if isinstance(n, ast.Constant) and isinstance(n.value, str) for w in n.value.split()
+    ]
+
+
+def _is_flag(word: str, full: str, shortest: int) -> bool:
+    """`word` is the flag `full` or an unambiguous abbreviation of it (argparse accepts `--kee` for `--keep`)."""
+    name = word.split("=", 1)[0]
+    return len(name) >= shortest and full.startswith(name)
+
+
+def _runs_keep_self_test(node: ast.AST) -> bool:
+    words = _words(node)
+    return any(_is_flag(w, "--dry-fakes", len("--dry-f")) for w in words) and any(
+        _is_flag(w, "--keep", len("--k")) for w in words
+    )
+
+
+def _uses_own_tempdir(fn: ast.FunctionDef) -> bool:
+    """True only for the real thing: the `own_tempdir` fixture (a parameter or `usefixtures`), or an explicit
+    `monkeypatch.setattr(tempfile, "tempdir", ...)` in the body. The mere word `tempfile` does not count."""
+    if "own_tempdir" in {a.arg for a in fn.args.args}:
+        return True
+    for d in fn.decorator_list:
+        if any(isinstance(n, ast.Constant) and n.value == "own_tempdir" for n in ast.walk(d)):
+            return True
+    for n in ast.walk(fn):
+        if (
+            isinstance(n, ast.Call)
+            and isinstance(n.func, ast.Attribute)
+            and n.func.attr == "setattr"
+            and len(n.args) >= 2
+            and isinstance(n.args[0], ast.Name)
+            and n.args[0].id == "tempfile"
+            and isinstance(n.args[1], ast.Constant)
+            and n.args[1].value == "tempdir"
+        ):
+            return True
+    return False
+
+
+def keep_self_tests_that_leak(source: str) -> tuple[list[str], int]:
+    """(names of the functions that run the `--dry-fakes --keep` self-test without their own temp folder, how many
+    functions run it at all). Also reported: a keep self-test spelled in a module-level value (it cannot be tied to a
+    fixture), and a helper function that is not a test (the test that calls it cannot be seen from here)."""
+    tree = ast.parse(source)
+    leaks: list[str] = []
+    found = 0
+    for node in ast.walk(tree):
+        if isinstance(node, ast.FunctionDef) and _runs_keep_self_test(node):
+            found += 1
+            if not node.name.startswith("test_") or not _uses_own_tempdir(node):
+                leaks.append(node.name)
+    for top in tree.body:
+        if not isinstance(top, ast.FunctionDef | ast.ClassDef) and _runs_keep_self_test(top):
+            found += 1
+            leaks.append("<module level>")
+    return leaks, found
