+def test_the_scan_refuses_what_it_cannot_tie_to_a_fixture() -> None:
+    assert keep_self_tests_that_leak('ARGS = ["--dry-fakes", "--keep"]\n')[0] == ["<module level>"]
+    helper = 'def run_it(own_tempdir):\n    main(["--dry-fakes", "--keep"])\n'
+    assert keep_self_tests_that_leak(helper)[0] == ["run_it"]  # not a test: the caller's fixture is out of sight
+    assert keep_self_tests_that_leak('def test_b():\n    main(["--dry-fakes"])\n') == ([], 0)  # no --keep: fine
