+def test_valid_files_of_every_kind_reach_the_question(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """Control: the same checks pass good files, so the refusals above are not a check that refuses everything."""
+    files = {"flow.json": _LEADFLOW_OK, "approvers.json": _APPROVERS_OK, "replies.json": _REPLIES_OK}
+    for name, text in files.items():
+        (tmp_path / name).write_text(text, encoding="utf-8")
+    cfg = _valid_config(
+        tmp_path,
+        DESK_LEADFLOW_FILE=str(tmp_path / "flow.json"),
+        DESK_NUDGE_TO="a@example.test",
+        DESK_LATER_MODE="approval",
+        DESK_APPROVERS_FILE=str(tmp_path / "approvers.json"),
+        DESK_REPLIES_PATH=str(tmp_path / "replies.json"),
+    )
+    asked: list[str] = []
+    monkeypatch.setattr("builtins.input", lambda prompt="": asked.append(prompt) or "n")
+    code = rrc.main(["--config", str(cfg)])
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_STOPPED and asked == ["Start? [y/N] "], out
