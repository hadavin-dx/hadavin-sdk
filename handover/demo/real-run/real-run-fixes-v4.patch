+    for setting, extra, flags in (
+        ("DESK_HUBSPOT_KEY_FILE", {}, []),
+        ("DESK_SMTPP_PASSWORD_FILE", {}, []),
+        ("REAL_IMAP_1_PASSWORD_FILE", {}, []),
+        ("DESK_LIVE_KEY_FILE", _live_lines(tmp_path, short), ["--live-model"]),
