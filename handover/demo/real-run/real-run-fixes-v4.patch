+def test_the_scan_wants_the_fixture_not_just_the_word_tempfile() -> None:
+    mention = 'def test_a():\n    # tempfile\n    import tempfile\n    main(["--dry-fakes", "--keep"])\n'
+    assert keep_self_tests_that_leak(mention) == (["test_a"], 1)
+    own = (
+        "def test_a(monkeypatch):\n"
+        '    monkeypatch.setattr(tempfile, "tempdir", "x")\n'
+        '    main(["--dry-fakes", "--keep"])\n'
+    )
+    assert keep_self_tests_that_leak(own) == ([], 1)
+    marked = '@pytest.mark.usefixtures("own_tempdir")\ndef test_a():\n    main(["--dry-fakes", "--keep"])\n'
+    assert keep_self_tests_that_leak(marked) == ([], 1)
+    wrong = 'def test_a(monkeypatch):\n    monkeypatch.setattr(os, "tempdir", 1)\n    main(["--dry-fakes", "--keep"])\n'
+    assert keep_self_tests_that_leak(wrong) == (["test_a"], 1)
