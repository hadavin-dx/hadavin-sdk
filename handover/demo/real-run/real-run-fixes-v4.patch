+def _refused_before_the_question(
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+    monkeypatch: pytest.MonkeyPatch,
+    setting: str,
+    bad_name: str,
+    **over: str,
+) -> str:
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(_valid_config(tmp_path, **over))]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert f"refused: {setting}: " in out, out
+    assert bad_name not in out and str(tmp_path) not in out and "Traceback" not in out
+    assert not (tmp_path / "run").exists()  # nothing was started, no folder made
+    return out
+
