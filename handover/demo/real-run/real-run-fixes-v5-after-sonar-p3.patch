+    r = _live(tmp_path, key, subprocess.DEVNULL)
+    assert r.returncode == 1 and "Traceback" not in r.stderr and "no terminal" in r.stdout
+
+
+def test_live_check_exits_non_zero_when_every_call_failed(tmp_path: Path) -> None:
+    key = tmp_path / "k"
+    key.write_text(KEY, encoding="utf-8")
+    r = _live(tmp_path, key, "y\n")
+    assert r.returncode == 3, r.stdout[-400:]
+    assert "LiveTransport" in r.stdout and KEY not in r.stdout + r.stderr
+
+
+@pytest.mark.parametrize("content", [None, "short"], ids=["missing", "short"])
+def test_live_check_refuses_a_bad_key_file_before_the_question(tmp_path: Path, content: str | None) -> None:
+    key = tmp_path / "k"
+    if content is not None:
+        key.write_text(content, encoding="utf-8")
+    r = _live(tmp_path, key, "y\n")  # a "y" is ready, but must never be read
+    assert r.returncode == 2 and "refused" in r.stdout and "Start?" not in r.stdout
+    assert str(tmp_path) not in r.stdout + r.stderr
+
