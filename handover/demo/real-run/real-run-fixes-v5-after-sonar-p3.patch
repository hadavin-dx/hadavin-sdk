diff --git a/tests/keep_scan.py b/tests/keep_scan.py
new file mode 100644
index 0000000..17e0d1f
--- /dev/null
+++ b/tests/keep_scan.py
@@ -0,0 +1,173 @@
+"""The scan behind `test_every_keep_self_test_in_the_suite_uses_its_own_temp_folder`. It lives in its own file, and the
+test that runs it reads every `.py` file under `tests/` (also conftest.py and helpers, sub-folders too) except this one.
+
+What it finds: the `--dry-fakes --keep` self-test run by a function, a method, an async test, a class attribute, a
+module-level value or a helper. The flags may be written as one string, a list, `"--dry-fakes --keep".split()`, an
+abbreviation argparse accepts, bytes, pieces joined by `+` or `join`, or the pieces of an f-string: the scan reads
+every string piece of one place and searches the pieces glued together (with and without a space).
+
+What it demands: the real `own_tempdir` fixture (a parameter without a default, or
+`@pytest.mark.usefixtures("own_tempdir")`), or a real `monkeypatch.setattr(tempfile, "tempdir", <not None>)` as a plain
+statement of the test (not under `if`, `try` or a loop, and `tempfile` not rebound); and for a run through a child
+program, which does not see a patch made in this process, a temp folder named in the test (TMPDIR, TEMP or TMP) or the
+fixture.
+
+Known holes, not closable cheaply (written in FIXES.md): flags that are not in any string of the place (read from
+`os.environ` or a file, or built by arithmetic), the two flags split over two different places (for example one in a
+helper and one in the test), and a fixture that is named `own_tempdir` but does nothing (the companion test
+`test_own_tempdir_puts_temporary_folders_under_the_test_folder` catches that)."""
+
+from __future__ import annotations
+
+import ast
+import re
+
+_DRY = re.compile(r"--dry-f(?:a(?:k(?:e(?:s)?)?)?)?(?![A-Za-z])")  # `--dry-f` and the longer prefixes of `--dry-fakes`
+_KEEP = re.compile(r"--k(?:e(?:e(?:p)?)?)?(?![A-Za-z])")  # `--k`, `--ke`, `--kee`, `--keep`
+_FUNCS = (ast.FunctionDef, ast.AsyncFunctionDef)
+_CHILD_ENV = re.compile(r"TMPDIR|TEMP|TMP")  # where a child program finds its temp folder
+_CHILD_NAMES = {"subprocess", "system", "Popen", "popen", "spawn"}
+
+
+def _pieces(node: ast.AST) -> list[str]:
+    """Every string or bytes piece under `node`, in source order, docstrings left out (a docstring that talks about the
+    flags is not a run)."""
+    skip: set[int] = set()
+    for n in ast.walk(node):
+        if isinstance(n, (*_FUNCS, ast.ClassDef, ast.Module)):
+            first = n.body[0] if n.body else None
+            if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant):
+                skip.add(id(first.value))
+    out: list[str] = []
+    for n in ast.walk(node):
+        if isinstance(n, ast.Constant) and id(n) not in skip:
+            if isinstance(n.value, str):
+                out.append(n.value)
+            elif isinstance(n.value, bytes):
+                out.append(n.value.decode("latin-1"))
+    return out
+
+
+def _runs_keep_self_test(node: ast.AST) -> bool:
+    """Both flags are in the pieces of `node`: written whole, abbreviated, or built from pieces."""
+    pieces = _pieces(node)
+    return any(_DRY.search(t) and _KEEP.search(t) for t in ("".join(pieces), " ".join(pieces)))
+
+
+def _own_statements(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> list[ast.stmt]:
+    """The statements that always run: the body and the `with` bodies (not `if`, `try`, loops, nested defs)."""
+    out: list[ast.stmt] = []
+    todo = list(fn.body)
+    while todo:
+        st = todo.pop(0)
+        out.append(st)
+        if isinstance(st, ast.With | ast.AsyncWith):
+            todo.extend(st.body)
+    return out
+
+
+def _is_tempdir_patch(call: ast.Call) -> bool:
+    """`monkeypatch.setattr(tempfile, "tempdir", X)` or `monkeypatch.setattr("tempfile.tempdir", X)`, X not None."""
+    f = call.func
+    if not (isinstance(f, ast.Attribute) and f.attr == "setattr" and isinstance(f.value, ast.Name)):
+        return False
+    if f.value.id != "monkeypatch":
+        return False
+    args = call.args
+    if len(args) >= 3 and isinstance(args[0], ast.Name) and args[0].id == "tempfile":
+        named = isinstance(args[1], ast.Constant) and args[1].value == "tempdir"
+        return named and not (isinstance(args[2], ast.Constant) and args[2].value is None)
+    if len(args) >= 2 and isinstance(args[0], ast.Constant) and args[0].value == "tempfile.tempdir":
+        return not (isinstance(args[1], ast.Constant) and args[1].value is None)
+    return False
+
+
+def _rebinds_tempfile(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """The function gives the name `tempfile` another meaning (a parameter or a local variable): a patch on it proves
+    nothing."""
+    params = [*fn.args.posonlyargs, *fn.args.args, *fn.args.kwonlyargs]
+    if any(a.arg == "tempfile" for a in params):
+        return True
+    return any(isinstance(n, ast.Name) and n.id == "tempfile" and isinstance(n.ctx, ast.Store) for n in ast.walk(fn))
+
+
+def _has_fixture(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """`own_tempdir` as a parameter without a default, or named by `usefixtures(...)` in a decorator."""
+    plain = fn.args.posonlyargs + fn.args.args
+    defaulted = {a.arg for a in plain[len(plain) - len(fn.args.defaults) :]} if fn.args.defaults else set()
+    defaulted |= {a.arg for a, d in zip(fn.args.kwonlyargs, fn.args.kw_defaults, strict=True) if d is not None}
+    names = {a.arg for a in [*plain, *fn.args.kwonlyargs]}
+    if "own_tempdir" in names and "own_tempdir" not in defaulted:
+        return True
+    for d in fn.decorator_list:
+        if isinstance(d, ast.Call):
+            name = d.func.attr if isinstance(d.func, ast.Attribute) else getattr(d.func, "id", "")
+            if name == "usefixtures" and any(isinstance(a, ast.Constant) and a.value == "own_tempdir" for a in d.args):
+                return True
+    return False
+
+
+def _has_own_temp_folder(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """True only for the real thing (see the module text). The word `tempfile` or `own_tempdir` alone does not count."""
+    if _has_fixture(fn):
+        return True
+    if _rebinds_tempfile(fn):
+        return False
+    return any(
+        isinstance(st, ast.Expr) and isinstance(st.value, ast.Call) and _is_tempdir_patch(st.value)
+        for st in _own_statements(fn)
+    )
+
+
+def _runs_a_child(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """The function starts a child program (subprocess, os.system and kin)."""
+    return any(
+        isinstance(n, ast.Name | ast.Attribute) and (n.id if isinstance(n, ast.Name) else n.attr) in _CHILD_NAMES
+        for n in ast.walk(fn)
+    )
+
+
+def _is_leak(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    if not fn.name.startswith("test_"):
+        return True  # a helper: the test that calls it cannot be seen from here
+    if not _has_own_temp_folder(fn):
+        return True
+    # a child program does not see a patch made in this process: the test must name the temp folder in its environment
+    if _runs_a_child(fn) and not _has_fixture(fn):
+        return not any(_CHILD_ENV.search(t) for t in _pieces(fn))
+    return False
+
+
+def keep_self_tests_that_leak(source: str) -> tuple[list[str], int]:
+    """(names of the places that run the `--dry-fakes --keep` self-test without their own temp folder, how many places
+    run it at all). Places: every function and method (a helper that is not a test is reported: the test that calls it
+    cannot be seen from here), every class attribute (`<class Name>`), every module-level statement (`<module level>`).
+    A nested function inside a test is part of that test."""
+    tree = ast.parse(source)
+    leaks: list[str] = []
+    found = 0
+    module_text = _pieces(tree)
+    module_has_dry = any(_DRY.search(t) for t in ("".join(module_text), " ".join(module_text)))
+
+    def keep_alone(st: ast.AST) -> bool:
+        """The keep flag by itself in a place that is not a test, in a module that also has the self-test flag: the two
+        flags may be put together somewhere else (a helper that returns one of them)."""
+        text = _pieces(st)
+        return module_has_dry and any(_KEEP.search(t) for t in ("".join(text), " ".join(text)))
+
+    def visit(body: list[ast.stmt], in_class: str | None) -> None:
+        nonlocal found
+        for st in body:
+            if isinstance(st, _FUNCS):
+                if _runs_keep_self_test(st) or (not st.name.startswith("test_") and keep_alone(st)):
+                    found += 1
+                    if _is_leak(st):
+                        leaks.append(st.name)
+            elif isinstance(st, ast.ClassDef):
+                visit(st.body, st.name)
+            elif _runs_keep_self_test(st) or keep_alone(st):
+                found += 1
+                leaks.append(f"<class {in_class}>" if in_class else "<module level>")
+
+    visit(tree.body, None)
+    return leaks, found
diff --git a/tests/keep_scan_cases.txt b/tests/keep_scan_cases.txt
new file mode 100644
index 0000000..fad0b27
--- /dev/null
+++ b/tests/keep_scan_cases.txt
@@ -0,0 +1,153 @@
+Sample sources for the keep scan (tests/keep_scan.py). They are in a .txt file on purpose: the scan reads every .py file
+under tests/, and these samples must not look like real runs of the self-test. Format: a line "### name | the places
+reported, comma separated, or - | how many places run it", then the source, until the next "###" line.
+
+### plain list, no fixture | test_a | 1
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### single quotes | test_a | 1
+def test_a():
+    main(['--dry-fakes', '--keep'])
+### split on spaces | test_a | 1
+def test_a():
+    main("--dry-fakes --keep".split())
+### abbreviated keep | test_a | 1
+def test_a():
+    main(["--dry-fakes", "--kee"])
+### abbreviated self-test | test_a | 1
+def test_a():
+    main(["--dry-f", "--keep", "--assume-yes"])
+### keep with a value | test_a | 1
+def test_a():
+    main(["--keep=1", "--dry-fakes"])
+### fixture as parameter | - | 1
+def test_a(own_tempdir):
+    main(["--dry-fakes", "--keep"])
+### flags built by plus | test_a | 1
+def test_a():
+    main(["--dry-" + "fakes", "--" + "keep"])
+### flags built by an f-string | test_a | 1
+def test_a():
+    x = "ep"
+    main(["--dry-fakes", f"--ke{x}"])
+### flags built by join | test_a | 1
+def test_a():
+    main(["".join(["--dry-", "fakes"]), "--".join(["", "keep"])])
+### bytes | test_a | 1
+def test_a():
+    main([b"--dry-fakes", b"--keep"])
+### class attribute | <class T> | 1
+class T:
+    ARGS = ["--dry-fakes", "--keep"]
+### method without fixture | test_m | 1
+class T:
+    def test_m(self):
+        main(["--dry-fakes", "--keep"])
+### method with fixture | - | 1
+class T:
+    def test_m(self, own_tempdir):
+        main(["--dry-fakes", "--keep"])
+### module level | <module level> | 1
+ARGS = ["--dry-fakes", "--keep"]
+### helper with the fixture still counts as a leak | run_it | 1
+def run_it(own_tempdir):
+    main(["--dry-fakes", "--keep"])
+### helper that returns only the keep flag | _flag | 1
+def _flag():
+    return "--keep"
+def test_a():
+    main(["--dry-fakes", _flag()])
+### async test without fixture | test_a | 1
+async def test_a():
+    main(["--dry-fakes", "--keep"])
+### async test with fixture | - | 1
+async def test_a(own_tempdir):
+    main(["--dry-fakes", "--keep"])
+### usefixtures | - | 1
+@pytest.mark.usefixtures("own_tempdir")
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### decorator that only contains the word | test_a | 1
+@pytest.mark.parametrize("x", ["own_tempdir"])
+def test_a(x):
+    main(["--dry-fakes", "--keep"])
+### another marker that names the word as an argument | test_a | 1
+@pytest.mark.parametrize("own_tempdir", [1])
+def test_a(own_tempdir_value):
+    main(["--dry-fakes", "--keep"])
+### skipif reason that only contains the word | test_a | 1
+@pytest.mark.skipif(False, reason="own_tempdir")
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### parameter with a default | test_a | 1
+def test_a(own_tempdir=None):
+    main(["--dry-fakes", "--keep"])
+### only the word tempfile | test_a | 1
+def test_a():
+    # tempfile
+    import tempfile
+    main(["--dry-fakes", "--keep"])
+### real setattr | - | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(tempfile, "tempdir", "x")
+    main(["--dry-fakes", "--keep"])
+### real setattr by dotted name | - | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr("tempfile.tempdir", "x")
+    main(["--dry-fakes", "--keep"])
+### real setattr inside with | - | 1
+def test_a(monkeypatch):
+    with something():
+        monkeypatch.setattr(tempfile, "tempdir", "x")
+    main(["--dry-fakes", "--keep"])
+### setattr of another module | test_a | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(os, "tempdir", 1)
+    main(["--dry-fakes", "--keep"])
+### setattr to None is a no-op | test_a | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(tempfile, "tempdir", None)
+    main(["--dry-fakes", "--keep"])
+### setattr on a local object called tempfile | test_a | 1
+def test_a(monkeypatch):
+    tempfile = Obj()
+    monkeypatch.setattr(tempfile, "tempdir", "x")
+    main(["--dry-fakes", "--keep"])
+### setattr under if False | test_a | 1
+def test_a(monkeypatch):
+    if False:
+        monkeypatch.setattr(tempfile, "tempdir", "x")
+    main(["--dry-fakes", "--keep"])
+### setattr under try | test_a | 1
+def test_a(monkeypatch):
+    try:
+        monkeypatch.setattr(tempfile, "tempdir", "x")
+    finally:
+        pass
+    main(["--dry-fakes", "--keep"])
+### child program with the setattr only | test_a | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(tempfile, "tempdir", "x")
+    subprocess.run([PY, "s.py", "--dry-fakes", "--keep"])
+### child program with the setattr and its own environment | - | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(tempfile, "tempdir", "x")
+    subprocess.run([PY, "s.py", "--dry-fakes", "--keep"], env={"TMPDIR": "x"})
+### child program with the fixture | - | 1
+def test_a(own_tempdir):
+    subprocess.run([PY, "s.py", "--dry-fakes", "--keep"])
+### a nested helper belongs to its test | - | 1
+def test_a(own_tempdir):
+    def go():
+        main(["--dry-fakes", "--keep"])
+    go()
+### a docstring that talks about the flags | - | 0
+def test_a():
+    """Runs --dry-fakes without --keep ... or with --keep."""
+    main(["--dry-fakes"])
+### the self-test without keep | - | 0
+def test_b():
+    main(["--dry-fakes"])
+### keep refused without the self-test, in a test | - | 0
+def test_c():
+    main(["--config", "x", "--keep"])
