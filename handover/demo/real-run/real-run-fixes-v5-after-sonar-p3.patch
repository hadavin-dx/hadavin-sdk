+def test_keep_without_the_self_test_is_refused(tmp_path: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    assert rrc.main(["--config", str(_valid_config(tmp_path)), "--keep"]) == rrc.EXIT_REFUSED
+    assert "refused: --keep: only for the self-test" in capsys.readouterr().out
+
+
+def test_the_closing_line_of_a_self_test_tells_how_to_keep_the_logs(tmp_path: Path) -> None:
+    class A:
+        dry_fakes = True
+        keep = False
+
+    assert "--keep" in rrc.result_line(A(), tmp_path / "r.json")  # type: ignore[arg-type]
+    A.keep = True
+    assert rrc.result_line(A(), tmp_path / "r.json") == f"result file: {tmp_path / 'r.json'}"  # type: ignore[arg-type]
