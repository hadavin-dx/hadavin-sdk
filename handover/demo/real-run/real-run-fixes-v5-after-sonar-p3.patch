+def test_every_keep_self_test_in_the_suite_uses_its_own_temp_folder() -> None:
+    """A test that runs the self-test with --keep leaves a folder behind: it must use the own_tempdir fixture (or set
+    tempfile.tempdir itself). A new test that forgets this fails here, so the system temp folder stays clean."""
+    found = 0
+    for path in sorted(p for p in (REPO / "tests").rglob("*.py") if p.name != "keep_scan.py"):
+        leaks, n = keep_self_tests_that_leak(path.read_text(encoding="utf-8"))
+        found += n
+        assert leaks == [], f"{path.name}: {leaks} run the keep self-test without own_tempdir: they leave a folder"
+    assert found >= 5  # the suite does have these tests; a scan that finds none proves nothing
