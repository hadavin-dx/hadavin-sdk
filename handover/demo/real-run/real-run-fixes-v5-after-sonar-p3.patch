+"""The take scripts refuse a bad key file, `:memory:` and a non-UTF-8 config BEFORE the y/N question, print no byte
+value, leave no stray folder; run_live_check.py ends without a traceback and with a non-zero exit when its calls
+failed. Loopback only, made-up data only."""
+
+from __future__ import annotations
+
+import re
+import subprocess  # noqa: S404
+import sys
+import tempfile
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+import run_real_check as rrc  # noqa: E402
+from keep_scan import keep_self_tests_that_leak  # noqa: E402
+from test_real_check_dry import _valid_config  # noqa: E402
+
+from lead_desk.desk import book_problem  # noqa: E402
+
+KEY = "made-up-" + "key-0002"  # built from parts
+ALL_ADDRESSES = ".".join(["0"] * 4)  # the all-addresses bind, built from parts
+
+
+def _no_question(prompt: str = "") -> str:
+    raise AssertionError("the y/N question was asked")
+
+
+@pytest.mark.parametrize(
+    "content", [None, KEY + "\n" + KEY + "\n", "short", b"\xff\xfe" + b"k\x00" * 9, b"\xc3\x28" * 9], ids=str
+)
+def test_a_bad_hubspot_key_file_is_refused_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, content: str | bytes | None
+) -> None:
+    key = tmp_path / "bad.key"
+    if isinstance(content, str):
+        key.write_text(content, encoding="utf-8")
+    elif content is not None:
+        key.write_bytes(content)
+    cfg = _valid_config(tmp_path, DESK_HUBSPOT_KEY_FILE=str(key))
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "refused: DESK_HUBSPOT_KEY_FILE" in out and KEY not in out and "bad.key" not in out
+
+
+def test_memory_book_is_refused_like_the_desk_and_leaves_no_file(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.chdir(tmp_path)
+    monkeypatch.setattr("builtins.input", _no_question)
+    assert rrc.main(["--config", str(_valid_config(tmp_path, DESK_DB_PATH=":memory:"))]) == rrc.EXIT_BOOK_REFUSED == 4
+    assert str(book_problem(":memory:")) in capsys.readouterr().out
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["c.env", "hub.key", "mail.pw"]  # no desk-1.log, no new folder
+
+
+def test_a_config_that_is_not_utf8_is_refused_without_a_byte_value(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    cfg = tmp_path / "bin.env"
+    cfg.write_bytes(b"\xff\xfe\x00DESK_DB_PATH=x\n")
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "not UTF-8" in out and "0xff" not in out and "position" not in out
+
+
+def test_dry_fakes_folder_is_deleted_also_when_the_self_test_fails(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    class Broken:
+        def __init__(self, folder: Path, *_a: object) -> None:
+            (folder / "fakes").mkdir()
+            raise ValueError("the openssl program is needed for --dry-fakes")
+
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    monkeypatch.setattr(rrc, "DryFakes", Broken)
+    assert rrc.main(["--dry-fakes", "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert "refused" in capsys.readouterr().out
+    assert list(tmp_path.glob("real-dry-*")) == []
+    monkeypatch.setattr(rrc, "DryFakes", Broken)
+    assert rrc.main(["--dry-fakes", "--keep", "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert len(list(tmp_path.glob("real-dry-*"))) == 1  # --keep keeps it
+
