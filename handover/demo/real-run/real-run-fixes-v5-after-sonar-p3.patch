+def _scan_cases() -> list[tuple[str, list[str], int, str]]:
+    """(name, places reported, places found, source) from tests/keep_scan_cases.txt."""
+    text = (REPO / "tests" / "keep_scan_cases.txt").read_text(encoding="utf-8")
+    cases = []
+    for block in text.split("\n### ")[1:]:
+        head, _, source = block.partition("\n")
+        name, leaks, found = (x.strip() for x in head.split("|"))
+        cases.append((name, [] if leaks == "-" else [x.strip() for x in leaks.split(",")], int(found), source))
+    return cases
+
+
+@pytest.mark.parametrize(("name", "leaks", "found", "source"), _scan_cases(), ids=[c[0] for c in _scan_cases()])
+def test_the_scan_judges_every_sample_source(name: str, leaks: list[str], found: int, source: str) -> None:
+    assert keep_self_tests_that_leak(source) == (leaks, found), name
+
+
+def test_the_sample_file_has_all_its_cases() -> None:
+    assert (
+        len(_scan_cases()) == 40
+    )  # a broken split would leave few or none, and the scan tests above would prove nothing
+
