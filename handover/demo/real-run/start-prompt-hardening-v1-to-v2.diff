+    "read -p": 'read -p "ok? " x',
+    "read -p with a quoted prompt and no option": 'read "x"',
+    "read -r in a loop": "while read -r line; do echo $line; done",
+    "read after then": "if true; then read x; fi",
+    "read after a semicolon": "echo a; read x",
+    "read in a pipe": "echo a | read x",
+    "select": "select o in a b; do break; done",
+    "/dev/tty": "exec </dev/tty",
+    "Read-Host": "$a = Read-Host 'ok?'",
+    "Console.ReadLine": "[Console]::ReadLine()",
+    "Host.UI.Prompt": "$Host.UI.PromptForChoice('a','b',$c,0)",
+    "Get-Credential": "Get-Credential",
+    "pause": "echo off\npause",
+    "set /p": "set /p a=ok?",
+}
+SHELL_DOES_NOT = {
+    "a word in a message": 'echo "mode must be keyed or blind; read the docs"',
+    "readonly": "readonly x=1",
+    "a comment": "# read -p is not used here",
+    "a path": "cat data/readme.txt",
+}
+
+
+@pytest.mark.parametrize("name", sorted(READS))
+def test_the_guard_finds_every_way_python_can_read_a_person(name: str) -> None:
+    assert reads_a_person(READS[name]), name
+
+
+@pytest.mark.parametrize("name", sorted(DOES_NOT_READ))
+def test_the_guard_does_not_cry_wolf(name: str) -> None:
+    assert reads_a_person(DOES_NOT_READ[name]) == [], name
+
+
+@pytest.mark.parametrize("name", sorted(SHELL_READS))
+def test_the_shell_guard_finds_a_prompt(name: str) -> None:
+    assert shell_reads_a_person(SHELL_READS[name]), name
+
+
+@pytest.mark.parametrize("name", sorted(SHELL_DOES_NOT))
+def test_the_shell_guard_does_not_cry_wolf(name: str) -> None:
+    assert shell_reads_a_person(SHELL_DOES_NOT[name]) == [], name
+
+
+_SKIP_DIRS = {".git", "tests", "data", "node_modules", "__pycache__"}
+
+
+def _repo_files(*suffixes: str) -> list[Path]:
+    out = []
+    for path in sorted(REPO.rglob("*")):
+        rel = path.relative_to(REPO).parts
+        if (
+            path.is_file()
+            and path.suffix in suffixes
+            and not (set(rel[:-1]) & _SKIP_DIRS)
+            and not rel[0].startswith(".")
+        ):
+            out.append(path)
+    return out
+
+
+def _call_lines(tree: ast.AST, name: str) -> list[int]:
+    return sorted(
+        n.lineno
+        for n in ast.walk(tree)
+        if isinstance(n, ast.Call) and (getattr(n.func, "id", None) == name or getattr(n.func, "attr", None) == name)
+    )
+
+
+def test_only_the_terminal_guard_reads_a_person_in_the_whole_repository() -> None:
+    """Every Python file outside tests/ (scripts, load_tools, tools, src, demo_only and anything else, root files
+    included): the only one that may read a person is scripts/terminal_guard.py, whose question refuses a stdin that
+    is not a terminal. A new question anywhere else fails here: route it through ask_to_start. A module or code
+    chosen at run time cannot be checked: only src/lead_desk/loader.py does that (its names are fixed in the code:
+    the kind modules and demo_only.*, never a setting)."""
+    asking: dict[str, list[str]] = {}
+    dynamic: set[str] = set()
+    for path in _repo_files(".py"):
+        found = reads_a_person(path.read_text(encoding="utf-8"))
+        name = path.relative_to(REPO).as_posix()
+        if any("chosen at run time" in why for why in found):
+            dynamic.add(name)
+        if any("chosen at run time" not in why for why in found):
+            asking[name] = found
+    assert set(asking) == {"scripts/terminal_guard.py"}, asking
+    assert dynamic == {"src/lead_desk/loader.py"}, dynamic
+
+
+def test_no_shell_script_asks_a_question() -> None:
+    files = _repo_files(".sh", ".ps1", ".bat", ".cmd")
+    assert files, "the scan found no shell scripts: the walk is broken"
+    asking = {p.name: shell_reads_a_person(p.read_text(encoding="utf-8")) for p in files}
+    assert {k: v for k, v in asking.items() if v} == {}
+
+
+def test_a_caller_checks_for_a_terminal_before_it_asks_and_the_guard_does_too() -> None:
+    for name in ("scripts/run_real_check.py", "scripts/run_live_check.py"):
+        tree = ast.parse((REPO / name).read_text(encoding="utf-8"))
+        asks, checks = _call_lines(tree, "ask_to_start"), _call_lines(tree, "stdin_is_terminal")
+        assert asks and checks and checks[0] < asks[0], name  # the early refusal comes before the question
+    guard = ast.parse((REPO / "scripts/terminal_guard.py").read_text(encoding="utf-8"))
+    fn = next(n for n in ast.walk(guard) if isinstance(n, ast.FunctionDef) and n.name == "ask_to_start")
+    assert _call_lines(fn, "stdin_is_terminal")[0] < _call_lines(fn, "input")[0]  # the question checks itself too
