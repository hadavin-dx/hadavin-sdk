+++ b/tests/test_start_prompt_hardening.py
@@ -0,0 +1,264 @@
+"""The start question of the check scripts needs a person at a terminal, and no key goes to a default vendor address.
+
+Two classes (the incident of 2026-11-13: a `y` came in through a pipe and a valid synthetic config made the desk try
+52 real network calls toward the vendor's default address with a made-up key):
+  1. a y/N question that reads a pipe, a file or a closed stdin as an answer;
+  2. an address that falls back to the vendor's default when the settings do not name it.
+Nothing here starts a desk, opens a connection or answers y: `input` raises if it is reached, `Desk`, `DryFakes` and
+`run_model` raise if they are reached, and every socket connect raises."""
+
+from __future__ import annotations
+
+import ast
+import io
+import socket
+import sys
+from pathlib import Path
+from typing import Any, NoReturn
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+for _p in (str(REPO / "src"), str(REPO / "scripts"), str(REPO)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import run_live_check as rlc  # noqa: E402
+import run_real_check as rrc  # noqa: E402
+
+from lead_desk.constants import HUBSPOT_BASE_URL, LIVE_DEFAULT_BASE_URL, MAIL_IMAP_DEFAULT_HOST  # noqa: E402
+
+FILLER = "x"
+
+
+class _Pipe(io.StringIO):
+    """What a pipe or a file looks like to the script: readable text, not a terminal."""
+
+    def isatty(self) -> bool:
+        return False
+
+
+class _Terminal(io.StringIO):
+    def isatty(self) -> bool:
+        return True
+
+
+class Reached(AssertionError):
+    """A thing that must not happen was reached."""
+
+
+def _boom(*_a: Any, **_k: Any) -> NoReturn:
+    raise Reached
+
+
+@pytest.fixture(autouse=True)
+def _nothing_can_start_or_connect(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("builtins.input", lambda prompt="": _boom())
+    monkeypatch.setattr(socket.socket, "connect", _boom)
+    monkeypatch.setattr(rrc, "Desk", _boom)
+    monkeypatch.setattr(rrc, "DryFakes", _boom)
+    monkeypatch.setattr(rlc, "run_model", _boom)
+
+
+def _config(tmp_path: Path, drop: tuple[str, ...] = (), **over: str) -> Path:
+    values = dict.fromkeys(rrc.REQUIRED, FILLER) | {
+        "DESK_DB_PATH": str(tmp_path / "run" / "desk.db"),
+        "DESK_HUBSPOT_MAX_CALLS": "5",
+        "REAL_HUBSPOT_READBACK_MAX_CALLS": "5",
+        "DESK_SMTPP_HOST": "localhost",
+        "DESK_HUBSPOT_BASE_URL": HUBSPOT_BASE_URL,  # named on purpose: allowed (the check is that it is NAMED)
+        "REAL_IMAP_1_HOST": "localhost",
+        "REAL_IMAP_2_HOST": "localhost",
+        "DESK_SMTPP_FROM": "a@example.test",
+        "DESK_SMTPP_RECIPIENTS": "a@example.test,b@example.test",
+        "REAL_IMAP_1_USER": "a@example.test",
+        "REAL_IMAP_2_USER": "b@example.test",
+        "DESK_SMTPP_MAX_SENDS": "5",
+    }
+    values = {k: v for k, v in (values | over).items() if k not in drop}
+    cfg = tmp_path / "c.env"
+    cfg.write_text("\n".join(f"{k}={v}" for k, v in values.items()), encoding="utf-8")
+    return cfg
+
+
+# -- class 1: the question needs a terminal (run_real_check.py) -------------------------------------------------------
+@pytest.mark.parametrize("piped", ["y\n", "yes\n", "n\n", ""])
+def test_real_check_refuses_a_stdin_that_is_not_a_terminal(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, piped: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(piped))
+    assert rrc.main(["--config", str(_config(tmp_path))]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "needs a person at a terminal" in out and "nothing was started" in out and "Start?" not in out
+    assert not (tmp_path / "run").exists()  # nothing was made
+
+
+def test_real_check_dry_fakes_without_assume_yes_also_needs_a_terminal(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe("y\n"))
+    assert rrc.main(["--dry-fakes"]) == rrc.EXIT_REFUSED  # DryFakes is not even constructed (it raises)
+    assert "needs a person at a terminal" in capsys.readouterr().out
+
+
+def test_real_check_assume_yes_with_dry_fakes_is_the_one_scripted_use(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(""))
+    with pytest.raises(Reached):  # it got past the terminal check and went on to start the local fakes
+        rrc.main(["--dry-fakes", "--assume-yes"])
+
+
+def test_real_check_a_real_run_never_takes_assume_yes(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert rrc.main(["--config", str(_config(tmp_path)), "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert "self-test" in capsys.readouterr().out
+
+
+def test_a_terminal_reaches_the_question_and_n_stops(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    monkeypatch.setattr("builtins.input", lambda prompt="": "n")
+    assert rrc.main(["--config", str(_config(tmp_path))]) == rrc.EXIT_STOPPED
+    assert "stopped, nothing was called" in capsys.readouterr().out
+
+
+class _Odd:
+    def __init__(self, error: type[Exception] | None) -> None:
+        self.error = error
+
+    def isatty(self) -> bool:
+        if self.error is not None:
+            raise self.error
+        return False
+
+
+@pytest.mark.parametrize("stdin", [None, object(), _Odd(ValueError), _Odd(OSError), _Pipe("y\n")])
+def test_stdin_is_a_terminal_only_when_it_says_so(monkeypatch: pytest.MonkeyPatch, stdin: object) -> None:
+    monkeypatch.setattr(sys, "stdin", stdin)
+    assert rrc.stdin_is_terminal() is False and rlc.stdin_is_terminal() is False
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert rrc.stdin_is_terminal() is True and rlc.stdin_is_terminal() is True
+
+
+# -- class 1: the same for run_live_check.py --------------------------------------------------------------------------
+def _live_args(tmp_path: Path, *extra: str) -> list[str]:
+    key = tmp_path / "k.txt"
+    key.write_text("sk-" + "fake-" + "key-" + "0123456789abcdef\n", encoding="utf-8")
+    return [
+        *("--key-file", str(key), "--ledger", str(tmp_path / "l.jsonl"), "--price-date", "2026-01-01"),
+        *("--model", "m=1,2", "--cap-run", "1", "--cap-total", "3", "--leads", "1", "--runs", "1", *extra),
+    ]
+
+
+@pytest.mark.parametrize("piped", ["y\n", "yes\n", "n\n", ""])
+def test_live_check_refuses_a_stdin_that_is_not_a_terminal(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, piped: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(piped))
+    assert rlc.main(_live_args(tmp_path, "--base-url", "http://127.0.0.1:9")) == rlc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "needs a person at a terminal" in out and "Start?" not in out and "MAXIMUM" not in out
+
+
+def test_live_check_assume_yes_is_for_a_loopback_address_only(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(""))
+    for bad in (
+        LIVE_DEFAULT_BASE_URL,
+        "https://" + "model-host" + ".example.test",
+        "http://[::1",
+        "http://" + "10.0.0." + "5:9",
+    ):
+        assert rlc.main(_live_args(tmp_path, "--base-url", bad, "--assume-yes")) == rlc.EXIT_REFUSED
+        assert "loopback" in capsys.readouterr().out
+    with pytest.raises(Reached):  # loopback + --assume-yes: past both checks, on to the (blocked) first call
+        rlc.main(_live_args(tmp_path, "--base-url", "http://127.0.0.1:9", "--assume-yes"))
+
+
+def test_live_check_has_no_default_address(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert rlc.main(_live_args(tmp_path)) == rlc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "--base-url" in out and "not given" in out and "Start?" not in out
+
+
+def test_live_check_a_closed_terminal_is_a_stop_not_a_traceback(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    def closed(prompt: str = "") -> str:
+        raise EOFError
+
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    monkeypatch.setattr("builtins.input", closed)
+    assert rlc.main(_live_args(tmp_path, "--base-url", "http://127.0.0.1:9")) == 1
+    assert "no terminal" in capsys.readouterr().out
