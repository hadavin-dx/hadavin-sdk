+# -- class 2: no address falls back to a vendor default (run_real_check.py) ------------------------------------------
+@pytest.mark.parametrize("name", ["DESK_HUBSPOT_BASE_URL", "REAL_IMAP_1_HOST", "REAL_IMAP_2_HOST"])
+@pytest.mark.parametrize("how", ["absent", "blank"])
+def test_real_check_refuses_an_address_the_settings_do_not_name(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, name: str, how: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())  # a person is there: the refusal is about the address
+    cfg = _config(tmp_path, drop=(name,) if how == "absent" else (), **({name: "  "} if how == "blank" else {}))
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert out.startswith(f"refused: {name}: not named in the settings") and "Start?" not in out
+
+
+def test_real_check_the_live_model_address_must_be_named_too(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert rrc.main(["--config", str(_config(tmp_path)), "--live-model"]) == rrc.EXIT_REFUSED
+    assert capsys.readouterr().out.startswith("refused: DESK_LIVE_BASE_URL: not named in the settings")
