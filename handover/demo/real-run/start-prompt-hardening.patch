+def test_unnamed_remote_default_unit() -> None:
+    named = {
+        "DESK_HUBSPOT_BASE_URL": HUBSPOT_BASE_URL,  # the vendor's own address, named on purpose: allowed
+        "REAL_IMAP_1_USER": "u",
+        "REAL_IMAP_1_HOST": MAIL_IMAP_DEFAULT_HOST,
+        "DESK_LIVE_BASE_URL": LIVE_DEFAULT_BASE_URL,
+    }
+    assert rrc.unnamed_remote_default(named, True) is None
+    assert rrc.unnamed_remote_default({}, False) == "DESK_HUBSPOT_BASE_URL"
+    assert rrc.unnamed_remote_default({k: v for k, v in named.items() if k != "REAL_IMAP_1_HOST"}, False) == (
+        "REAL_IMAP_1_HOST"
+    )
+    no_live = {k: v for k, v in named.items() if k != "DESK_LIVE_BASE_URL"}
+    assert rrc.unnamed_remote_default(no_live, False) is None  # the live model is only looked at with --live-model
+    assert rrc.unnamed_remote_default(no_live, True) == "DESK_LIVE_BASE_URL"
+    for hs in ("", " ", "\t"):
+        assert rrc.unnamed_remote_default({**named, "DESK_HUBSPOT_BASE_URL": hs}, False) == "DESK_HUBSPOT_BASE_URL"
+
+
+# -- sibling sweep: every question in product and tool code is guarded ------------------------------------------------
+def _reads_a_person(tree: ast.AST) -> bool:
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Call):
+            f = node.func
+            if isinstance(f, ast.Name) and f.id in {"input", "getpass"}:
+                return True
+            if isinstance(f, ast.Attribute) and f.attr in {"getpass", "readline", "read", "readlines"}:
+                if isinstance(f.value, ast.Attribute) and f.value.attr == "stdin":
+                    return True
+    return False
