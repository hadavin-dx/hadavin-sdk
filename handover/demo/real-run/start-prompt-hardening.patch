+        return False
+
+
+def unnamed_remote_default(env: dict[str, str], live_model: bool) -> str | None:
+    """The name of the first setting whose address would fall back to a default that is not this computer, or None.
+    The defaults are the vendor's public addresses (HubSpot, the mailbox host, the live model): a made-up or real
+    key must never go there without the settings naming the address on purpose. A loopback value needs no care."""
+    wanted = [("DESK_HUBSPOT_BASE_URL", HUBSPOT_BASE_URL)]
+    n = 1
+    while env.get(f"REAL_IMAP_{n}_USER"):
+        wanted.append((f"REAL_IMAP_{n}_HOST", MAIL_IMAP_DEFAULT_HOST))
+        n += 1
+    if live_model:
+        wanted.append(("DESK_LIVE_BASE_URL", LIVE_DEFAULT_BASE_URL))
+    for name, default in wanted:
+        if env.get(name, "").strip():
+            continue
+        host = urlsplit(default).hostname if "://" in default else default
+        if not is_loopback_host(host or ""):
+            return name
+    return None
+
