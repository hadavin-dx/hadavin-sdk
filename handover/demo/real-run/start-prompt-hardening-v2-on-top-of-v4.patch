+# -- sibling sweep: nothing reads a person except scripts/terminal_guard.py, and the callers check first ---------------
+# What counts as reading a person. A tripwire, not a proof: it names the ways standard input, a terminal or a prompt
+# library can be reached from Python text. Not caught (stated): a file descriptor held in a variable (`os.read(fd, n)`
+# with fd = 0 set elsewhere), a read through a name built at run time, and a child process that reads our stdin through
+# a command it builds from data. Tests, which fake `input` with strings, are not walked: they are not entry points.
+_PROMPT_MODULES = frozenset(
+    "getpass fileinput readline cmd code pdb curses termios tty pty click typer prompt_toolkit questionary inquirer "
+    "pexpect wexpect".split()
+)
+_STDIN_NAMES = frozenset({"stdin", "__stdin__"})
+_KEY_PRESS = frozenset({"getch", "getche", "getwch", "getwche", "kbhit", "ungetch", "ungetwch"})
+_DYNAMIC = frozenset({"__import__", "import_module", "eval", "exec"})
+_FD_ZERO_CALLS = frozenset({"read", "readv", "pread", "fdopen", "dup", "dup2", "open"})
+_TERMINAL_PATHS = frozenset({"/dev/stdin", "/dev/tty", "/proc/self/fd/0", "CON", "CONIN$"})
+_SHELL_READ = re.compile(r"(?:^|[;&|(]\s*)read\s+-\w", re.MULTILINE)
+
+
+def _names_bound_to(tree: ast.AST, module: str) -> set[str]:
+    out = set()
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Import):
+            out |= {a.asname or a.name for a in n.names if a.name == module}
+    return out
+
+
+def reads_a_person(source: str) -> list[str]:
+    """The reasons (empty: none) why this Python text may read a person, a terminal or standard input."""
+    tree = ast.parse(source)
+    parents = {child: parent for parent in ast.walk(tree) for child in ast.iter_child_nodes(parent)}
+    sys_names, builtins_names, msvcrt_names = (_names_bound_to(tree, m) for m in ("sys", "builtins", "msvcrt"))
+    why: list[str] = []
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Import):
+            why += [f"import {a.name}" for a in n.names if a.name.split(".")[0] in _PROMPT_MODULES]
+            why += ["import rich.prompt" for a in n.names if a.name.startswith("rich.prompt")]
+        elif isinstance(n, ast.ImportFrom):
+            mod = n.module or ""
+            if mod.split(".")[0] in _PROMPT_MODULES or mod.startswith("rich.prompt"):
+                why.append(f"from {mod}")
+            if mod == "sys" and any(a.name in _STDIN_NAMES for a in n.names):
+                why.append("from sys import stdin")
+            if mod == "builtins" and any(a.name in {"input", "raw_input"} for a in n.names):
+                why.append("from builtins import input")
+            if mod == "msvcrt" and any(a.name in _KEY_PRESS for a in n.names):
+                why.append("from msvcrt import a key press")
+        elif isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) and n.id in {"input", "raw_input", "breakpoint"}:
+            why.append(f"the name {n.id} (a call, an alias or a callback)")
+        elif isinstance(n, ast.Attribute):
+            base = n.value.id if isinstance(n.value, ast.Name) else None
+            if base in sys_names and n.attr in _STDIN_NAMES and not _is_isatty(parents.get(n), n):
+                why.append(f"{base}.{n.attr}")
+            if base in (builtins_names | {"__builtins__"}) and n.attr in {"input", "raw_input"}:
+                why.append(f"{base}.{n.attr}")
+            if base in msvcrt_names and n.attr in _KEY_PRESS:
+                why.append(f"msvcrt.{n.attr}")
+        elif isinstance(n, ast.Call):
+            why += _call_reasons(n)
+        elif isinstance(n, ast.Constant) and isinstance(n.value, str) and _SHELL_READ.search(n.value):
+            why.append("a shell `read -x` inside a string")
+    return why
+
+
+def _is_isatty(parent: ast.AST | None, node: ast.AST) -> bool:
+    return isinstance(parent, ast.Attribute) and parent.value is node and parent.attr == "isatty"
+
+
+def _call_reasons(n: ast.Call) -> list[str]:
+    f = n.func
+    name = f.id if isinstance(f, ast.Name) else f.attr if isinstance(f, ast.Attribute) else ""
+    args = [a.value for a in n.args if isinstance(a, ast.Constant)]
+    why = []
+    if name in _DYNAMIC:
+        why.append(f"{name}(): code or a module chosen at run time cannot be checked")
+    if name == "getattr" and any(isinstance(a, str) and a in {"input", "stdin", "__stdin__", "getpass"} for a in args):
+        why.append("getattr of input or stdin")
+    if name in _FD_ZERO_CALLS and args[:1] == [0] and not isinstance(args[0], bool):
+        why.append(f"{name}(0): file descriptor 0 is standard input")
+    if any(isinstance(a, str) and a in _TERMINAL_PATHS for a in args):
+        why.append("a path of standard input or the terminal")
+    return why
+
+
+# Python text that reads a person (every line must be found), and text that does not (no line may be).
+READS = {
+    "input": "x = input('a')",
+    "sys.stdin.readline": "import sys\nsys.stdin.readline()",
+    "sys.stdin.read": "import sys\nsys.stdin.read()",
+    "getpass.getpass": "import getpass\nx = getpass.getpass()",
+    "from getpass import getpass as g": "from getpass import getpass as g\ng()",
+    "import getpass as gp": "import getpass as gp\ngp.getpass()",
+    "builtins.input": "import builtins\nbuiltins.input('a')",
+    "alias of input": "ask = input\nask('a')",
+    "input as a callback": "import functools\np = functools.partial(input, 'a')\np()",
+    "from builtins import input as i": "from builtins import input as i\ni()",
+    "from sys import stdin": "from sys import stdin\nstdin.readline()",
+    "sys.stdin.buffer.read": "import sys\nsys.stdin.buffer.read()",
+    "for line in sys.stdin": "import sys\nlines = [x for x in sys.stdin]",
+    "import sys as s": "import sys as s\ns.stdin.read()",
+    "sys.__stdin__": "import sys\nsys.__stdin__.read()",
+    "open(0)": "open(0).read()",
+    "io.open(0)": "import io\nio.open(0).read()",
+    "open('/dev/stdin')": "open('/dev/stdin').read()",
+    "open CONIN$": "open('CONIN$').read()",
+    "os.read(0, n)": "import os\nos.read(0, 1)",
+    "os.fdopen(0)": "import os\nos.fdopen(0).read()",
+    "fileinput": "import fileinput\nfileinput.input()",
+    "click.confirm": "import click\nclick.confirm('a')",
+    "typer.prompt": "import typer\ntyper.prompt('a')",
+    "rich prompt": "from rich.prompt import Confirm\nConfirm.ask('a')",
+    "msvcrt.getch": "import msvcrt\nmsvcrt.getch()",
+    "from msvcrt import getwch": "from msvcrt import getwch\ngetwch()",
+    "breakpoint": "breakpoint()",
+    "pdb": "import pdb\npdb.set_trace()",
+    "importlib": "import importlib\nimportlib.import_module('getpass')",
+    "__import__": "__import__('getpass').getpass()",
+    "getattr": "import builtins\ngetattr(builtins, 'input')('a')",
+    "eval": "eval('inp' + 'ut()')",
+    "shell read in a string": "import subprocess\nsubprocess.run(['bash', '-c', 'read -p ok x'])",
+}
+DOES_NOT_READ = {
+    "isatty only": "import sys\nsys.stdin.isatty()",
+    "a child's pipe": "import subprocess\np = subprocess.Popen(['x'], stdin=subprocess.PIPE)\np.stdin.write(b'a')",
+    "no stdin for the child": "import subprocess\nsubprocess.run(['x'], stdin=subprocess.DEVNULL)",
+    "a word": "print('input')\ninputs = [1]\ndef input_ok():\n    return 'read the docs'",
+    "an option name": "import argparse\nargparse.ArgumentParser().add_argument('--input')",
+    "a descriptor in a variable": "import os\nfd = 3\nos.read(fd, 10)",
+    "select on sockets": "import select\nselect.select([], [], [], 1)",
+    "msvcrt locking": "import msvcrt\nmsvcrt.locking(1, msvcrt.LK_NBLCK, 1)",
+    "stdout and stderr": "import sys\nsys.stdout.write('a')\nsys.stderr.write('b')",
+    "an attribute named input": "a = type('T', (), {'input': 1})\na.input",
+}
+
+_SHELL_PATTERNS = [
+    (re.compile(r"(?:^|[;&|({!]|\b(?:then|do|else|if|while|until|elif))\s*read\b(?![-\w.])", re.MULTILINE), "read"),
+    (re.compile(r"\bselect\s+\w+\s+in\b"), "select ... in"),
+    (re.compile(r"/dev/(?:tty|stdin)\b"), "/dev/tty or /dev/stdin"),
+    (re.compile(r"\bRead-Host\b|\[Console\]::(?:ReadLine|ReadKey|In\b|OpenStandardInput)", re.IGNORECASE), "Read-Host"),
+    (re.compile(r"\$Host\.UI\.(?:Prompt|ReadLine|PromptForChoice|RawUI\.ReadKey)", re.IGNORECASE), "$Host.UI prompt"),
+    (re.compile(r"\bGet-Credential\b|\$input\b", re.IGNORECASE), "Get-Credential or $input"),
+    (re.compile(r"^\s*pause\s*$|\bset\s+/p\b|\bchoice\b", re.IGNORECASE | re.MULTILINE), "pause, set /p or choice"),
+]
+
+
+def shell_reads_a_person(text: str) -> list[str]:
+    """Quoted text is blanked first (a sentence in an echo is not a command); a `read` inside quotes, as in
+    `bash -c 'read x'`, is therefore not seen (stated limit)."""
+    bare = re.sub(r"\"[^\"\n]*\"|'[^'\n]*'", '""', text)
+    return [why for pattern, why in _SHELL_PATTERNS if pattern.search(bare)]
+
+
+SHELL_READS = {
+    "read -p": 'read -p "ok? " x',
+    "read -p with a quoted prompt and no option": 'read "x"',
+    "read -r in a loop": "while read -r line; do echo $line; done",
+    "read after then": "if true; then read x; fi",
+    "read after a semicolon": "echo a; read x",
+    "read in a pipe": "echo a | read x",
+    "select": "select o in a b; do break; done",
+    "/dev/tty": "exec </dev/tty",
+    "Read-Host": "$a = Read-Host 'ok?'",
+    "Console.ReadLine": "[Console]::ReadLine()",
+    "Host.UI.Prompt": "$Host.UI.PromptForChoice('a','b',$c,0)",
+    "Get-Credential": "Get-Credential",
+    "pause": "echo off\npause",
+    "set /p": "set /p a=ok?",
+}
+SHELL_DOES_NOT = {
+    "a word in a message": 'echo "mode must be keyed or blind; read the docs"',
+    "readonly": "readonly x=1",
+    "a comment": "# read -p is not used here",
+    "a path": "cat data/readme.txt",
+}
