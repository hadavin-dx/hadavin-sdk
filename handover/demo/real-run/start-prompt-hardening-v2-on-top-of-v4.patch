--- /dev/null
+++ b/tests/test_start_prompt_hardening.py
@@ -0,0 +1,723 @@
+"""The start question of the check scripts needs a person at a terminal, is answered by typing the destination host, and
+no key goes to a default vendor address.
+
+Two classes (the incident of 2026-11-13: a `y` came in through a pipe and a valid synthetic config made the desk try
+52 real network calls toward the vendor's default address with a made-up key):
+  1. a start question that reads a pipe, a file, NUL or a closed stdin as an answer, or takes a bare y;
+  2. an address that falls back to the vendor's default when the settings do not name it.
+Nothing here starts a desk, opens a connection or sends an answer that starts a run: `input` raises if it is reached
+(except where a test supplies the answer on purpose, and then `Desk`, `DryFakes` and `run_model` raise if reached), and
+every socket connect raises."""
+
+from __future__ import annotations
+
+import ast
+import io
+import os
+import re
+import socket
+import sys
+from pathlib import Path
+from typing import Any, NoReturn
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+for _p in (str(REPO / "src"), str(REPO / "scripts"), str(REPO)):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import run_live_check as rlc  # noqa: E402
+import run_real_check as rrc  # noqa: E402
+import terminal_guard as tg  # noqa: E402
+
+from lead_desk.constants import HUBSPOT_BASE_URL, LIVE_DEFAULT_BASE_URL, MAIL_IMAP_DEFAULT_HOST  # noqa: E402
+
+SCHEME = "http" + "://"  # a scheme, built from parts so that no address literal sits in this file
+FILLER = "x-value-" + "0001"  # a made-up setting value, built from parts
+FILLER_KEY_FILE = "keys" + "/made-up-key.txt"  # a made-up path (the scripts do not read it in these tests)
+CRM_HOST = "api." + "hubapi" + ".com"  # what the banner shows for HUBSPOT_BASE_URL (derived below, asserted equal)
+REAL_CONSOLE_INPUT = tg._console_input  # the real function, kept before any test stands in for it
+
+
+class _Pipe(io.StringIO):
+    """What a pipe or a file looks like to the script: readable text, not a terminal."""
+
+    def isatty(self) -> bool:
+        return False
+
+
+class _Terminal(io.StringIO):
+    def isatty(self) -> bool:
+        return True
+
+
+class Reached(AssertionError):
+    """A thing that must not happen was reached."""
+
+
+def _boom(*_a: Any, **_k: Any) -> NoReturn:
+    raise Reached
+
+
+@pytest.fixture(autouse=True)
+def _nothing_can_start_or_connect(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("builtins.input", lambda prompt="": _boom())
+    monkeypatch.setattr(socket.socket, "connect", _boom)
+    monkeypatch.setattr(rrc, "Desk", _boom)
+    monkeypatch.setattr(rrc, "DryFakes", _boom)
+    monkeypatch.setattr(rlc, "run_model", _boom)
+    monkeypatch.setattr(tg, "_console_input", lambda *_a, **_k: True)  # a Terminal stand-in is a console on any host
+
+
+def _config(tmp_path: Path, drop: tuple[str, ...] = (), **over: str) -> Path:
+    values = dict.fromkeys(rrc.REQUIRED, FILLER) | {
+        "DESK_DB_PATH": str(tmp_path / "run" / "desk.db"),
+        "DESK_HUBSPOT_KEY_FILE": FILLER_KEY_FILE,
+        "DESK_HUBSPOT_MAX_CALLS": "5",
+        "REAL_HUBSPOT_READBACK_MAX_CALLS": "5",
+        "DESK_SMTPP_HOST": "localhost",
+        "DESK_HUBSPOT_BASE_URL": HUBSPOT_BASE_URL,  # named on purpose: allowed (the check is that it is NAMED)
+        "REAL_IMAP_1_HOST": "localhost",
+        "REAL_IMAP_2_HOST": "localhost",
+        "DESK_SMTPP_FROM": "a@example.test",
+        "DESK_SMTPP_RECIPIENTS": "a@example.test,b@example.test",
+        "REAL_IMAP_1_USER": "a@example.test",
+        "REAL_IMAP_2_USER": "b@example.test",
+        "DESK_SMTPP_MAX_SENDS": "5",
+    }
+    values = {k: v for k, v in (values | over).items() if k not in drop}
+    keys = tmp_path / "keys"  # a one-line made-up key file for every file setting (a later check reads them)
+    keys.mkdir(exist_ok=True)
+    for name, value in values.items():
+        if name.endswith(("_KEY_FILE", "_PASSWORD_FILE")) and value in (FILLER, FILLER_KEY_FILE):
+            (keys / name).write_text("made-up-" + "key-0002\n", encoding="utf-8")
+            values[name] = str(keys / name)
+    cfg = tmp_path / "c.env"
+    cfg.write_text("\n".join(f"{k}={v}" for k, v in values.items()), encoding="utf-8")
+    return cfg
+
+
+def _answer(monkeypatch: pytest.MonkeyPatch, text: str) -> list[str]:
+    """Supply one typed answer to the start question; returns the prompts shown."""
+    shown: list[str] = []
+
+    def fake_input(prompt: str = "") -> str:
+        shown.append(prompt)
+        return text
+
+    monkeypatch.setattr("builtins.input", fake_input)
+    return shown
+
+
+# -- class 1: the question needs a terminal (run_real_check.py) -------------------------------------------------------
+@pytest.mark.parametrize("piped", ["y\n", "yes\n", "n\n", "", CRM_HOST + "\n"])
+def test_real_check_refuses_a_stdin_that_is_not_a_terminal(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, piped: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(piped))
+    assert rrc.main(["--config", str(_config(tmp_path))]) == rrc.EXIT_REFUSED == 2  # the exit code is part of the rule
+    out = capsys.readouterr().out
+    assert "needs a person at a terminal" in out and "nothing was started" in out and "To start" not in out
+    assert not (tmp_path / "run").exists()  # nothing was made
+
+
+def test_real_check_dry_fakes_without_assume_yes_also_needs_a_terminal(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
