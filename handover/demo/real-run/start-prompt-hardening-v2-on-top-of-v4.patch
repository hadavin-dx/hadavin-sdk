+
+def test_an_unreplaced_or_odd_mailbox_host_is_refused_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    for bad in ("<IMAP_HOST>", "mail host", "mail.example.test/x", "-mail.example.test", "mail@example.test", "é.test"):
+        assert rrc.main(["--config", str(_config(tmp_path, REAL_IMAP_2_HOST=bad))]) == rrc.EXIT_REFUSED, bad
+        out = capsys.readouterr().out
+        assert "REAL_IMAP_2_HOST is required and must be a host name" in out and "To start" not in out
+    with pytest.raises(ValueError, match="REAL_IMAP_1_HOST is required"):  # no fallback inside imap_settings either
+        rrc.imap_settings({"REAL_IMAP_1_USER": "u", "REAL_IMAP_1_PASSWORD_FILE": "p"})
+
+
+# -- the terminal test itself (scripts/terminal_guard.py) -------------------------------------------------------------
+class _Odd:
+    def __init__(self, error: type[Exception] | None) -> None:
+        self.error = error
+
+    def isatty(self) -> bool:
+        if self.error is not None:
+            raise self.error
+        return False
+
+
+@pytest.mark.parametrize("stdin", [None, object(), _Odd(ValueError), _Odd(OSError), _Pipe("y\n")])
+def test_stdin_is_a_terminal_only_when_it_says_so(monkeypatch: pytest.MonkeyPatch, stdin: object) -> None:
+    monkeypatch.setattr(sys, "stdin", stdin)
+    assert tg.stdin_is_terminal() is False and rrc.stdin_is_terminal() is False and rlc.stdin_is_terminal() is False
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert tg.stdin_is_terminal() is True and rrc.stdin_is_terminal() is True and rlc.stdin_is_terminal() is True
+
+
+def test_real_streams_that_are_not_terminals(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
+    """The real thing: /dev/null (NUL on Windows), a file holding a y and a pipe are not terminals."""
+    monkeypatch.setattr(tg, "_console_input", REAL_CONSOLE_INPUT)
+    answers = tmp_path / "answers.txt"
+    answers.write_text("y\n", encoding="utf-8")
+    read_end, write_end = os.pipe()
+    os.write(write_end, b"y\n")
+    os.close(write_end)
+    for stream in (open(os.devnull, encoding="utf-8"), answers.open(encoding="utf-8"), os.fdopen(read_end)):
+        with stream:
+            monkeypatch.setattr(sys, "stdin", stream)
+            assert tg.stdin_is_terminal() is False
+
+
+def test_a_real_pseudo_terminal_is_a_terminal_on_linux(monkeypatch: pytest.MonkeyPatch) -> None:
+    pty = pytest.importorskip("pty")  # not on Windows
+    monkeypatch.setattr(tg, "_console_input", REAL_CONSOLE_INPUT)
+    master, slave = pty.openpty()
+    try:
+        with os.fdopen(slave, "r", closefd=False) as stream:
+            monkeypatch.setattr(sys, "stdin", stream)
+            assert tg.stdin_is_terminal() is True
+    finally:
+        os.close(master)
+        os.close(slave)
+
+
+def test_windows_needs_a_console_not_just_isatty() -> None:
+    """The Windows rule, with a stand-in for GetConsoleMode (the real call was not run: no Windows machine here).
+    isatty on the NUL device was not verified on the owner's Python; the console test makes that not matter."""
+    nul = _Terminal()  # a stream whose isatty says True, as the C runtime has answered for NUL
+    calls: list[object] = []
+
+    def not_a_console(stream: object) -> bool:
+        calls.append(stream)
+        return False
+
+    def a_console(stream: object) -> bool:
+        return True
+
+    assert REAL_CONSOLE_INPUT(nul, windows=True, probe=not_a_console) is False and calls == [nul]
+    assert REAL_CONSOLE_INPUT(nul, windows=True, probe=a_console) is True
+    assert REAL_CONSOLE_INPUT(nul, windows=False, probe=not_a_console) is True  # off Windows isatty alone stands
+    assert len(calls) == 1  # the probe is not asked off Windows
+    if sys.platform != "win32":
+        assert tg._windows_console_input(nul) is False  # fails closed off Windows (and never imports msvcrt there)
+
+
+def test_a_failing_console_probe_is_not_a_terminal(monkeypatch: pytest.MonkeyPatch) -> None:
+    for error in (OSError, ValueError, AttributeError):
+
+        def broken(*_a: object, _error: type[Exception] = error, **_k: object) -> bool:
+            raise _error
+
+        monkeypatch.setattr(sys, "stdin", _Terminal())
+        monkeypatch.setattr(tg, "_console_input", broken)
+        assert tg.stdin_is_terminal() is False
+
+
+def test_ask_to_start_never_reads_what_is_not_a_terminal_and_never_takes_y(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe("host.example.test\n"))
+    with pytest.raises(tg.NoTerminal):
+        tg.ask_to_start("host.example.test", "q: ")  # input would raise Reached: it is not read
+    monkeypatch.setattr(sys, "stdin", _Terminal())
