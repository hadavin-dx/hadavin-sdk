+
+
+def test_the_banner_shows_the_model_host_with_the_live_model(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    live = {
+        "DESK_LIVE_MODEL": "m",
+        "DESK_LIVE_KEY_FILE": FILLER_KEY_FILE,
+        "DESK_LIVE_PRICE_DATE": "2026-01-01",
+        "DESK_LIVE_PRICE_IN_PER_MTOK": "1",
+        "DESK_LIVE_PRICE_OUT_PER_MTOK": "2",
+        "DESK_LIVE_CAP_RUN_USD": "1.25",
+        "DESK_LIVE_CAP_TOTAL_USD": "3",
+        "DESK_LIVE_LEDGER_PATH": str(tmp_path / "ledger"),
+        "DESK_LIVE_RUN_ID": "r1",
+        "DESK_LIVE_BASE_URL": LIVE_DEFAULT_BASE_URL,
+    }
+    _answer(monkeypatch, "")
+    assert rrc.main(["--config", str(_config(tmp_path, **live)), "--live-model"]) == rrc.EXIT_STOPPED
+    assert f"model key           -> {rrc.host_of(LIVE_DEFAULT_BASE_URL)}" in capsys.readouterr().out
