+    assert rrc.main(["--dry-fakes"]) == rrc.EXIT_REFUSED  # DryFakes is not even constructed (it raises)
+    assert "needs a person at a terminal" in capsys.readouterr().out
+
+
+def test_real_check_assume_yes_with_dry_fakes_is_the_one_scripted_use(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(sys, "stdin", _Pipe(""))
+    with pytest.raises(Reached):  # it got past the terminal check and went on to start the local fakes
+        rrc.main(["--dry-fakes", "--assume-yes"])
+
+
+def test_real_check_a_real_run_never_takes_assume_yes(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    assert rrc.main(["--config", str(_config(tmp_path)), "--assume-yes"]) == rrc.EXIT_REFUSED
+    assert "self-test" in capsys.readouterr().out
+
+
+def test_a_terminal_reaches_the_question_and_a_wrong_answer_stops(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    shown = _answer(monkeypatch, "n")
+    assert rrc.main(["--config", str(_config(tmp_path))]) == rrc.EXIT_STOPPED
+    assert "stopped, nothing was called" in capsys.readouterr().out
+    assert shown == [f"To start, type the HubSpot host ({CRM_HOST}) and press Enter; anything else stops: "]
+
+
+@pytest.mark.parametrize("typed", ["y", "Y", "yes", "", " ", "n", "yes\ty", CRM_HOST + ".evil.test", "x." + CRM_HOST])
+def test_only_the_destination_host_starts_the_real_check_never_a_y(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, typed: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    _answer(monkeypatch, typed)
+    assert rrc.main(["--config", str(_config(tmp_path))]) == rrc.EXIT_STOPPED  # Desk raises if a run were started
+    assert "stopped, nothing was called" in capsys.readouterr().out
+
+
+@pytest.mark.parametrize("typed", [CRM_HOST, "  " + CRM_HOST.upper() + " "])
+def test_typing_the_destination_host_starts_the_run(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, typed: str
+) -> None:
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    _answer(monkeypatch, typed)
+    with pytest.raises(Reached):  # past the question, on to the (blocked) start of the first desk
+        rrc.main(["--config", str(_config(tmp_path))])
+
+
+def test_the_banner_shows_where_each_key_goes_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    assert rrc.host_of(HUBSPOT_BASE_URL) == CRM_HOST
+    monkeypatch.setattr(sys, "stdin", _Terminal())
+    cfg = _config(tmp_path, DESK_SMTPP_HOST="smtp.example.test", REAL_IMAP_1_HOST="mail1.example.test")
+    cfg.write_text(cfg.read_text(encoding="utf-8") + "\nREAL_IMAP_2_HOST=mail2.example.test\n", encoding="utf-8")
+    shown = _answer(monkeypatch, "")
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_STOPPED
+    out = capsys.readouterr().out
+    for line in (
+        f"HubSpot key         -> {CRM_HOST}",
+        "mail sending login  -> smtp.example.test",
+        "mailbox 1 login    -> mail1.example.test",
+        "mailbox 2 login    -> mail2.example.test",
+        "model key           -> none (recorded replies)",
+    ):
+        assert line in out, line
