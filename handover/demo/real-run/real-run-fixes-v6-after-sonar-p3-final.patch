+### the patch names the system temp folder by gettempdir | test_a | 1
+def test_a(monkeypatch):
+    monkeypatch.setattr(tempfile, "tempdir", tempfile.gettempdir())
+    main(["--dry-fakes", "--keep"])
+### the patch names a folder built from tmp_path | - | 1
+def test_a(monkeypatch, tmp_path):
+    here = tmp_path / "t"
+    monkeypatch.setattr(tempfile, "tempdir", str(here))
+    main(["--dry-fakes", "--keep"])
+### the patch names a folder from the tmp_path_factory | - | 1
+def test_a(monkeypatch, tmp_path_factory):
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path_factory.mktemp("x")))
+    main(["--dry-fakes", "--keep"])
+### the patch names a name that has nothing to do with tmp_path | test_a | 1
+def test_a(monkeypatch, tmp_path):
+    other = "/tmp"
+    monkeypatch.setattr(tempfile, "tempdir", other)
+    main(["--dry-fakes", "--keep"])
+### usefixtures by the mark spelling | - | 1
+@mark.usefixtures("own_tempdir")
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### a decorator called usefixtures on any object | test_a | 1
+@anyname.usefixtures("own_tempdir")
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### a bare function called usefixtures | test_a | 1
+@usefixtures("own_tempdir")
+def test_a():
+    main(["--dry-fakes", "--keep"])
+### a local object called monkeypatch | test_a | 1
+def test_a(tmp_path):
+    monkeypatch = Fake()
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    main(["--dry-fakes", "--keep"])
+### monkeypatch is not a parameter at all | test_a | 1
+def test_a(tmp_path):
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    main(["--dry-fakes", "--keep"])
+### monkeypatch rebound by a with | test_a | 1
+def test_a(monkeypatch, tmp_path):
+    with Fake() as monkeypatch:
+        monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    main(["--dry-fakes", "--keep"])
+### monkeypatch rebound by an import | test_a | 1
+def test_a(monkeypatch, tmp_path):
+    from fakes import monkeypatch
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+    main(["--dry-fakes", "--keep"])
+### flags in two lists that are added together | test_a | 1
+def test_a():
+    first = ["--dry-", "fakes"]
+    second = ["--ke", "ep"]
+    main(first + second)
