+def _live_argv(key_path: str, ledger_path: str, **over: str | None) -> list[str]:
+    """A good command line (loopback address, nothing listens there) with some options replaced or (None) removed."""
+    opts: dict[str, str | None] = {
+        "--key-file": key_path,
+        "--ledger": ledger_path,
+        "--base-url": "http://127.0.0.1:1",
+        "--cap-run": "1",
+        "--cap-total": "3",
+        "--price-date": "2026-01-01",
+        "--model": "fake-a=2,10",
+        "--leads": "1",
+        "--runs": "1",
+        "--assume-yes": "",
+    }
+    for k, v in over.items():
+        opts["--" + k.replace("_", "-")] = v
+    out: list[str] = []
+    for k, v in opts.items():
+        if v is not None:
+            out += [k] if v == "" else [k, v]
+    return out
