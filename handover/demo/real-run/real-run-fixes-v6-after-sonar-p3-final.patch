+def test_every_refusal_before_the_question_has_the_same_form(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setattr("builtins.input", _no_question)
+    ok = _valid_config(tmp_path)
+    bad_line = tmp_path / "bad-line.env"
+    bad_line.write_text("not a pair\n", encoding="utf-8")
+    cases: list[tuple[list[str], dict[str, str], str]] = [
+        (["--assume-yes"], {}, "--assume-yes"),
+        (["--keep"], {}, "--keep"),
+        ([], {}, "--config"),  # no --config
+        (["--config", str(tmp_path / "nope.env")], {}, "--config"),
+        (["--config", str(bad_line)], {}, "--config"),
+        (["--config"], {"REAL_PERSONS": "3"}, "REAL_PERSONS"),
+        (["--config"], {"DESK_BIND": ALL_ADDRESSES}, "DESK_BIND"),
+        (["--config"], {"DESK_SEND_TIMEOUT_SECONDS": "abc"}, "DESK_SEND_TIMEOUT_SECONDS"),
+        (["--config"], {"DESK_HUBSPOT_BASE_URL": "http://" + "hs.example" + ".org"}, "DESK_HUBSPOT_BASE_URL"),
+        (["--config"], {"DESK_SMTPP_PORT": "99999"}, "DESK_SMTPP_PORT"),
+        (["--config"], {"REAL_IMAP_1_PORT": "99999"}, "REAL_IMAP_1_PORT"),
+        (["--config"], {"DESK_SMTPP_RECIPIENTS": "a@example.test"}, "REAL_IMAP_n_USER"),
+        (["--config"], {"REAL_DRAIN_SECONDS": "0"}, "REAL_DRAIN_SECONDS"),
+        (["--config"], {"DESK_HUBSPOT_KEY_FILE": str(tmp_path / "no-key")}, "DESK_HUBSPOT_KEY_FILE"),
+        (["--config"], {"DESK_NUDGE_TO": "a@example.test"}, "DESK_NUDGE_TO"),
+    ]
+    for args, over, setting in cases:
+        monkeypatch.chdir(tmp_path)
+        if args == ["--config"]:
+            argv = ["--config", str(_valid_config(tmp_path, **over))]
+        elif args in (["--keep"], ["--assume-yes"]):
+            argv = ["--config", str(ok), *args]
+        else:
+            argv = args
+        out = _one_refusal(rrc.main(argv), capsys)
+        assert out.startswith(f"refused: {setting}: "), (setting, out)
+    # the missing-names refusal names the names, then says what is wrong with them
+    empty = tmp_path / "empty.env"
+    empty.write_text("DESK_PORT=1\n", encoding="utf-8")
+    assert _one_refusal(rrc.main(["--config", str(empty)]), capsys).endswith(": not set in the config file\n")
+    # an existing book and the memory book (exit code 4 stays)
+    (tmp_path / "run").mkdir()
+    (tmp_path / "run" / "desk.db").write_text("x", encoding="utf-8")
+    assert _one_refusal(rrc.main(["--config", str(ok)]), capsys).startswith("refused: DESK_DB_PATH: names a file")
+    mem = _valid_config(tmp_path, DESK_DB_PATH=":memory:")
+    assert _one_refusal(rrc.main(["--config", str(mem)]), capsys, 4).startswith("refused: DESK_DB_PATH: the lead book")
