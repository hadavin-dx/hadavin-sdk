+def test_a_result_file_that_fails_after_a_whole_dry_run_still_cleans_up_and_exits_3(
+    own_tempdir: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The v4 gap, end to end on the loopback fakes only (--dry-fakes: no real service, made-up data): the result
+    write fails after the run. Before v5 this was a traceback that skipped the clean-up."""
+    real = rrc.write_result
+    monkeypatch.setattr(rrc, "write_result", lambda out, payload: real(own_tempdir, payload))  # a folder: fails
+    code = rrc.main(["--dry-fakes", "--assume-yes", "--cleanup"])
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED and "could not be written" in out and "Traceback" not in out
+    assert "clean-up:" in out and "contacts archived" in out  # the clean-up still ran
+    assert "result file:" not in out
+
