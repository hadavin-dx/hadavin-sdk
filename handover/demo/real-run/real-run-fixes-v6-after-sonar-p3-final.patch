+@pytest.mark.parametrize(
+    ("error", "line"),
+    [
+        (OSError("/secret/place/file"), "refused: the settings: a file or folder cannot be used (OSError)\n"),
+        (ValueError("a text without a setting name"), "refused: the settings: a text without a setting name\n"),
+        (ValueError("REAL_X_Y is wrong"), "refused: REAL_X_Y: is wrong\n"),
+    ],
+    ids=["os-error-no-path", "no-name", "name-split"],
+)
+def test_an_unexpected_error_before_the_question_keeps_the_form_and_leaks_no_path(
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+    monkeypatch: pytest.MonkeyPatch,
+    error: Exception,
+    line: str,
+) -> None:
+    def boom(_env: dict[str, str]) -> list[object]:
+        raise error
+
+    monkeypatch.setattr("builtins.input", _no_question)
+    monkeypatch.setattr(rrc, "imap_settings", boom)
+    assert rrc.main(["--config", str(_valid_config(tmp_path))]) == rrc.EXIT_REFUSED
+    assert capsys.readouterr().out == line
