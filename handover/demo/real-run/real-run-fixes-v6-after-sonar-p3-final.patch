new file mode 100644
index 0000000..1a4c226
--- /dev/null
+++ b/scripts/precheck.py
@@ -0,0 +1,50 @@
+"""Looks at a path BEFORE a script opens it: without writing anything and without blocking. Used by
+scripts/run_real_check.py and scripts/run_live_check.py for every file they open before their start question.
+
+Why: opening a pipe (FIFO) with no writer, a device or a socket can wait for ever, so a script that opens a file path
+named by a typo or a bad setting could hang before it asks anything. Only `os.stat` is used here (it never opens)."""
+
+from __future__ import annotations
+
+import os
+import stat
+from pathlib import Path
+
+
+def is_special_file(path: str | os.PathLike[str]) -> bool:
+    """True when the path exists and is a pipe (FIFO), a socket or a device: opening one may block, and none of the
+    files the scripts read is one of these. A missing path, a folder and a regular file are False (the normal readers
+    say what is wrong with those); a path that cannot be looked at (too long, a NUL character) is False too."""
+    try:
+        mode = os.stat(path).st_mode
+    except (OSError, ValueError):
+        return False
+    return stat.S_ISFIFO(mode) or stat.S_ISSOCK(mode) or stat.S_ISCHR(mode) or stat.S_ISBLK(mode)
+
+
+def folder_part_is_a_file(path: str | os.PathLike[str]) -> bool:
+    """True when the folder of `path` cannot be made because a part of it that exists is not a folder (a regular file, a
+    link to nothing, a pipe...). Walks up from the folder to the first part that exists: it must be a folder."""
+    try:
+        here = Path(os.path.abspath(path)).parent
+        while True:
+            if os.path.lexists(here):
+                return not here.is_dir()
+            if here.parent == here:
+                return False
+            here = here.parent
+    except (OSError, ValueError):
+        return False
+
+
+def same_file(a: str | os.PathLike[str], b: str | os.PathLike[str]) -> bool:
+    """True when both paths name the same file: the same path after links are followed, or (both exist) the same file
+    on disk (a hard link). Looks only."""
+    try:
+        return os.path.samefile(a, b)
+    except (OSError, ValueError):
+        pass
+    try:
+        return os.path.realpath(a) == os.path.realpath(b)
+    except (OSError, ValueError):
+        return False
