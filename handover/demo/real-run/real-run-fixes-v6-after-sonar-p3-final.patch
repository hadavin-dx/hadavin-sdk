@@ -0,0 +1,308 @@
+"""The scan behind `test_every_keep_self_test_in_the_suite_uses_its_own_temp_folder`. It lives in its own file, and the
+test that runs it reads every `.py` file under `tests/` (also conftest.py and helpers, sub-folders too) except this one.
+
+What it finds: the `--dry-fakes --keep` self-test run by a function, a method, an async test, a class attribute, a
+module-level value or a helper. The flags may be written as one string, a list, `"--dry-fakes --keep".split()`, an
+abbreviation argparse accepts, bytes, pieces joined by `+` or `join`, or the pieces of an f-string: the scan reads
+every string piece of one place and searches the pieces glued together (with and without a space).
+
+What it demands: the real `own_tempdir` fixture (a parameter without a default, or
+`@pytest.mark.usefixtures("own_tempdir")` / `@mark.usefixtures(...)`: the decorator must end in `mark.usefixtures`,
+not any function that happens to be called usefixtures), or a real `monkeypatch.setattr(tempfile, "tempdir", X)` as a
+plain statement of the test that stands BEFORE the line that runs the self-test (not under `if`, `try` or a loop, not
+after the run), where `monkeypatch` is the test's own fixture parameter (not rebound), `tempfile` is not rebound and X
+is built from one of the test's folder fixtures (`tmp_path`, `tmp_path_factory`, `tmpdir`, `tmpdir_factory`, or a name
+assigned from one of them): `None`, a literal such as "/tmp" and `tempfile.gettempdir()` are the system temp folder or a
+no-op and do not count. For a run through a child program, which does not see a patch made in this process, a temp
+folder named in the test (TMPDIR, TEMP or TMP) or the fixture is also needed.
+
+Spellings read: the flags written whole or abbreviated (as argparse accepts them), in bytes, in one string or in a list,
+`.split()`, pieces joined by `+`, `%`, `.format`, `join` or an f-string, also when a piece is first assigned to a name
+(`word = "keep"` ... `"--" + word`): every string piece of the place is searched alone, glued in SOURCE order (format
+placeholders removed) and as the text a small constant folder makes of each such expression (names resolved from the
+assignments of the place, of its class and of the module).
+
+Known holes, not closable cheaply (written in FIXES.md): flags that are not in any string of the place (read from
+`os.environ` or a file), flags built by arithmetic (`chr`, `bytes([...])`, a reversed slice), the two flags split over
+two different places (for example one in a helper and one in the test), and a fixture that is named `own_tempdir` but
+does nothing (the companion test `test_own_tempdir_puts_temporary_folders_under_the_test_folder` catches that)."""
+
+from __future__ import annotations
+
+import ast
+import re
+
+_DRY = re.compile(r"--dry-f(?:a(?:k(?:e(?:s)?)?)?)?(?![A-Za-z])")  # `--dry-f` and the longer prefixes of `--dry-fakes`
+_KEEP = re.compile(r"--k(?:e(?:e(?:p)?)?)?(?![A-Za-z])")  # `--k`, `--ke`, `--kee`, `--keep`
+_FUNCS = (ast.FunctionDef, ast.AsyncFunctionDef)
+_CHILD_ENV = re.compile(r"TMPDIR|TEMP|TMP")  # where a child program finds its temp folder
+_CHILD_NAMES = {"subprocess", "system", "Popen", "popen", "spawn"}
+
+
+_PLACEHOLDER = re.compile(r"\{[^{}]*\}|%[-+ #0]*[0-9]*(?:\.[0-9]+)?[sdrifxXo]")  # a format field or a %-field
+
+
+def _pieces(node: ast.AST) -> list[tuple[int, str]]:
+    """Every string or bytes piece under `node` as (line, text) in SOURCE order (line, then column), docstrings left
+    out (a docstring that talks about the flags is not a run)."""
+    skip: set[int] = set()
+    for n in ast.walk(node):
+        if isinstance(n, (*_FUNCS, ast.ClassDef, ast.Module)):
+            first = n.body[0] if n.body else None
+            if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant):
+                skip.add(id(first.value))
+    found: list[tuple[int, int, str]] = []
+    for n in ast.walk(node):
+        if isinstance(n, ast.Constant) and id(n) not in skip:
+            if isinstance(n.value, str):
+                found.append((n.lineno, n.col_offset, n.value))
+            elif isinstance(n.value, bytes):
+                found.append((n.lineno, n.col_offset, n.value.decode("latin-1")))
+    return [(line, text) for line, _, text in sorted(found)]
+
+
+def _texts(node: ast.AST) -> list[str]:
+    return [t for _, t in _pieces(node)]
+
+
+def _assigned_strings(*scopes: ast.AST) -> dict[str, str]:
+    """name -> the text it is assigned (`word = "keep"`, `flag = "--" + word`), from every assignment in the scopes."""
+    env: dict[str, str] = {}
+    for _ in range(3):  # a name may be built from an earlier name
+        for scope in scopes:
+            for n in ast.walk(scope):
+                if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
+                    value = _fold(n.value, env)
+                    if value:
+                        env[n.targets[0].id] = value
+    return env
+
+
+def _fold(node: ast.AST, env: dict[str, str]) -> str:
+    """The text of a string expression made of constants, names assigned a constant text, `+`, `%`, `.format`, `join`
+    and f-strings; anything it cannot know is left out (so the result is a lower bound of the real text)."""
+    if isinstance(node, ast.Constant):
+        if isinstance(node.value, str):
+            return node.value
+        return node.value.decode("latin-1") if isinstance(node.value, bytes) else ""
+    if isinstance(node, ast.Name):
+        return env.get(node.id, "")
+    if isinstance(node, ast.Attribute):  # self.WORD, cls.WORD, T.WORD: the class attribute of that name
+        return env.get(node.attr, "")
+    if isinstance(node, ast.JoinedStr):
+        return "".join(_fold(v.value if isinstance(v, ast.FormattedValue) else v, env) for v in node.values)
+    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
+        return _fold(node.left, env) + _fold(node.right, env)
+    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Mod):
+        left = _fold(node.left, env)
+        args = node.right.elts if isinstance(node.right, ast.Tuple) else [node.right]
+        try:
+            return left % tuple(_fold(a, env) for a in args)
+        except (TypeError, ValueError):
+            return _PLACEHOLDER.sub("", left)
+    if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+        base = _fold(node.func.value, env)
+        if node.func.attr == "format":
+            try:
+                return base.format(*(_fold(a, env) for a in node.args))
+            except (IndexError, KeyError, ValueError):
+                return _PLACEHOLDER.sub("", base)
+        if node.func.attr == "join" and node.args and isinstance(node.args[0], ast.List | ast.Tuple):
+            return base.join(_fold(e, env) for e in node.args[0].elts)
+    return ""
+
+
+def _values(node: ast.AST, scopes: tuple[ast.AST, ...]) -> list[tuple[int, str]]:
+    """Every text under `node` that could hold a flag, with the line it stands on: each piece alone, and each string
+    expression folded (`"--" + word`, `"--%s" % "keep"`, `"--{}".format("keep")`, joins, f-strings). Not the glued
+    text: that has no line (see `_glued`)."""
+    env = _assigned_strings(*scopes, node)
+    out = list(_pieces(node))
+    for n in ast.walk(node):
+        if isinstance(n, ast.BinOp | ast.JoinedStr | ast.Call | ast.Name | ast.Attribute):
+            folded = _fold(n, env)
+            if folded:
+                out.append((n.lineno, folded))
+    return out
+
+
+def _glued(node: ast.AST) -> list[str]:
+    """The pieces glued in source order, with and without a space, format fields removed."""
+    texts = [_PLACEHOLDER.sub("", t) for t in _texts(node)]
+    return ["".join(texts), " ".join(texts)]
+
+
+def _run_line(node: ast.AST, scopes: tuple[ast.AST, ...]) -> int | None:
+    """The line where `node` runs the `--dry-fakes --keep` self-test (both flags found in its texts), or None. The line
+    is that of the keep flag (the self-test flag also stands in messages). When only the glued text shows both flags,
+    the line of the LAST piece (a patch must stand before it)."""
+    vals = _values(node, scopes)
+    texts = [t for _, t in vals]
+    has_dry = any(_DRY.search(t) for t in texts)
+    has_keep = any(_KEEP.search(t) for t in texts)
+    glued_both = any(_DRY.search(t) and _KEEP.search(t) for t in _glued(node))
+    if not ((has_dry and has_keep) or glued_both):
+        return None
+    lines = [line for line, t in vals if _KEEP.search(t)]  # the keep flag is what leaves the folder behind
+    return min(lines) if lines else max((line for line, _ in _pieces(node)), default=0)
+
+
+def _own_statements(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> list[ast.stmt]:
+    """The statements that always run: the body and the `with` bodies (not `if`, `try`, loops, nested defs)."""
+    out: list[ast.stmt] = []
+    todo = list(fn.body)
+    while todo:
+        st = todo.pop(0)
+        out.append(st)
+        if isinstance(st, ast.With | ast.AsyncWith):
+            todo.extend(st.body)
+    return out
+
+
+def _is_tempdir_patch(call: ast.Call, folders: set[str]) -> bool:
+    """`monkeypatch.setattr(tempfile, "tempdir", X)` or `monkeypatch.setattr("tempfile.tempdir", X)` where X is built
+    from one of the test's own folder fixtures (`folders`): not None, not a literal, not gettempdir()."""
+    f = call.func
+    if not (isinstance(f, ast.Attribute) and f.attr == "setattr" and isinstance(f.value, ast.Name)):
+        return False
+    if f.value.id != "monkeypatch":
+        return False
+    args = call.args
+
+    def from_a_test_folder(x: ast.expr) -> bool:
+        return any(isinstance(n, ast.Name) and n.id in folders for n in ast.walk(x))
+
+    if len(args) >= 3 and isinstance(args[0], ast.Name) and args[0].id == "tempfile":
+        named = isinstance(args[1], ast.Constant) and args[1].value == "tempdir"
+        return named and from_a_test_folder(args[2])
+    if len(args) >= 2 and isinstance(args[0], ast.Constant) and args[0].value == "tempfile.tempdir":
+        return from_a_test_folder(args[1])
+    return False
+
+
+_FOLDER_FIXTURES = {"tmp_path", "tmp_path_factory", "tmpdir", "tmpdir_factory"}
+
+
+def _params(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> list[ast.arg]:
+    return [*fn.args.posonlyargs, *fn.args.args, *fn.args.kwonlyargs]
+
+
+def _test_folder_names(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> set[str]:
+    """The test's own folder fixtures (parameters) and the names assigned from them."""
+    names = {a.arg for a in _params(fn)} & _FOLDER_FIXTURES
+    for _ in range(3):
+        for n in ast.walk(fn):
+            if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
+                if any(isinstance(x, ast.Name) and x.id in names for x in ast.walk(n.value)):
+                    names.add(n.targets[0].id)
+    return names
+
+
+def _rebinds(fn: ast.FunctionDef | ast.AsyncFunctionDef, name: str, own_parameter_ok: bool) -> bool:
+    """The function gives `name` another meaning: a parameter (unless it is the fixture we expect), a variable, an
+    import, a nested function's parameter. A patch made on such a name proves nothing."""
+    own = {id(a) for a in _params(fn)}
+    for n in ast.walk(fn):
+        if isinstance(n, ast.arg) and n.arg == name and not (own_parameter_ok and id(n) in own):
+            return True
+        if isinstance(n, ast.Name) and n.id == name and isinstance(n.ctx, ast.Store | ast.Del):
+            return True
+        if isinstance(n, ast.Import | ast.ImportFrom) and any((a.asname or a.name) == name for a in n.names):
+            return True
+    return False
+
+
+def _dotted(node: ast.AST) -> str:
+    """`pytest.mark.usefixtures` for the attribute chain, "" when it is not a plain chain of names."""
+    parts: list[str] = []
+    while isinstance(node, ast.Attribute):
+        parts.append(node.attr)
+        node = node.value
+    return ".".join([node.id, *reversed(parts)]) if isinstance(node, ast.Name) else ""
+
+
+def _has_fixture(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """`own_tempdir` as a parameter without a default, or named by `pytest.mark.usefixtures(...)` (or `mark.`) in a
+    decorator. A function that is only CALLED usefixtures does not count."""
+    plain = fn.args.posonlyargs + fn.args.args
+    defaulted = {a.arg for a in plain[len(plain) - len(fn.args.defaults) :]} if fn.args.defaults else set()
+    defaulted |= {a.arg for a, d in zip(fn.args.kwonlyargs, fn.args.kw_defaults, strict=True) if d is not None}
+    names = {a.arg for a in [*plain, *fn.args.kwonlyargs]}
+    if "own_tempdir" in names and "own_tempdir" not in defaulted:
+        return True
+    for d in fn.decorator_list:
+        if isinstance(d, ast.Call) and _dotted(d.func).endswith("mark.usefixtures"):
+            if any(isinstance(a, ast.Constant) and a.value == "own_tempdir" for a in d.args):
+                return True
+    return False
+
+
+def _has_own_temp_folder(fn: ast.FunctionDef | ast.AsyncFunctionDef, run_line: int) -> bool:
+    """True only for the real thing (see the module text). The word `tempfile` or `own_tempdir` alone does not count."""
+    if _has_fixture(fn):
+        return True
+    if _rebinds(fn, "tempfile", own_parameter_ok=False) or _rebinds(fn, "monkeypatch", own_parameter_ok=True):
+        return False
+    if "monkeypatch" not in {a.arg for a in _params(fn)}:  # a patch made through an object that is not the fixture
+        return False
+    folders = _test_folder_names(fn)
+    return any(
+        isinstance(st, ast.Expr)
+        and isinstance(st.value, ast.Call)
+        and _is_tempdir_patch(st.value, folders)
+        and st.lineno < run_line
+        for st in _own_statements(fn)
+    )
+
+
+def _runs_a_child(fn: ast.FunctionDef | ast.AsyncFunctionDef) -> bool:
+    """The function starts a child program (subprocess, os.system and kin)."""
+    return any(
+        isinstance(n, ast.Name | ast.Attribute) and (n.id if isinstance(n, ast.Name) else n.attr) in _CHILD_NAMES
+        for n in ast.walk(fn)
+    )
+
+
+def _is_leak(fn: ast.FunctionDef | ast.AsyncFunctionDef, run_line: int) -> bool:
+    if not fn.name.startswith("test_"):
+        return True  # a helper: the test that calls it cannot be seen from here
+    if not _has_own_temp_folder(fn, run_line):
+        return True
+    # a child program does not see a patch made in this process: the test must name the temp folder in its environment
+    if _runs_a_child(fn) and not _has_fixture(fn):
+        return not any(_CHILD_ENV.search(t) for t in _texts(fn))
+    return False
+
+
+def keep_self_tests_that_leak(source: str) -> tuple[list[str], int]:
+    """(names of the places that run the `--dry-fakes --keep` self-test without their own temp folder, how many places
+    run it at all). Places: every function and method (a helper that is not a test is reported: the test that calls it
+    cannot be seen from here), every class attribute (`<class Name>`), every module-level statement (`<module level>`).
+    A nested function inside a test is part of that test."""
+    tree = ast.parse(source)
+    leaks: list[str] = []
+    found = 0
+    module_has_dry = any(_DRY.search(t) for _, t in _values(tree, ()))
+
+    def keep_alone(st: ast.AST, scopes: tuple[ast.AST, ...]) -> bool:
+        """The keep flag by itself in a place that is not a test, in a module that also has the self-test flag: the two
+        flags may be put together somewhere else (a helper that returns one of them)."""
+        return module_has_dry and any(_KEEP.search(t) for _, t in _values(st, scopes))
+
+    def visit(body: list[ast.stmt], scopes: tuple[ast.AST, ...], in_class: str | None) -> None:
+        nonlocal found
+        for st in body:
+            if isinstance(st, _FUNCS):
+                run_line = _run_line(st, scopes)
+                if run_line is not None or (not st.name.startswith("test_") and keep_alone(st, scopes)):
+                    found += 1
+                    if _is_leak(st, run_line or 0):
+                        leaks.append(st.name)
+            elif isinstance(st, ast.ClassDef):
+                visit(st.body, (*scopes, st), st.name)
+            elif _run_line(st, scopes) is not None or keep_alone(st, scopes):
+                found += 1
+                leaks.append(f"<class {in_class}>" if in_class else "<module level>")
+
+    visit(tree.body, (tree,), None)
+    return leaks, found
