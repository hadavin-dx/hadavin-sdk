diff --git a/tests/test_real_run_v6.py b/tests/test_real_run_v6.py
new file mode 100644
index 0000000..e788fcf
--- /dev/null
+++ b/tests/test_real_run_v6.py
@@ -0,0 +1,478 @@
+"""v6 of the real-run fixes: what the fresh safety read of v5 found, each with a test that fails on the v5 code.
+
+* a book path whose folder is a regular file is refused BEFORE the start question (nothing is written);
+* the result file must not be a key file, a password file, the book, the ledger or the config file (also through a
+  symlink or a hard link), must not be blank, and must not be a pipe or a device;
+* no file setting may name a pipe, a device or a socket (opening one blocks): the real script refuses it before it
+  opens anything, and so does the live script (key file, ledger);
+* every refusal of `scripts/run_live_check.py` is ONE line `refused: <OPTION>: <fixed text>` (also the argparse errors,
+  which no longer echo the value), exit 2;
+* `--leads` and `--runs` have an upper limit.
+Loopback only, made-up data only: nothing here calls a service; nothing answers the start question."""
+
+from __future__ import annotations
+
+import os
+import re
+import socket
+import stat
+import sys
+import threading
+from collections.abc import Callable
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+import precheck  # noqa: E402
+import run_live_check as rlc  # noqa: E402
+import run_real_check as rrc  # noqa: E402
+from test_real_check_dry import _valid_config  # noqa: E402
+from test_take_script_refusals import _live_lines, _no_question  # noqa: E402
+
+KEY = "made-up-" + "key-0002"  # built from parts
+CANARY = "ZQcanary7"  # never allowed in any output
+LIVE_LINE = re.compile(r"refused: (--[a-z][a-z-]*(, --[a-z][a-z-]*)*|the arguments|standard input): [^\n]+\n")
+FIFO_SKIP = pytest.mark.skipif(not hasattr(os, "mkfifo"), reason="no named pipes on this platform")
+
+
+@pytest.fixture(autouse=True)
+def _a_person_at_a_terminal(a_terminal: None) -> None:
+    """The scripts refuse a stdin that is not a terminal; these in-process tests mock `input` themselves."""
+
+
+def _tree(root: Path) -> list[str]:
+    return sorted(str(p.relative_to(root)) for p in root.rglob("*"))
+
+
+def _within(seconds: float, fn: Callable[[], object], unblock: Path | None = None) -> bool:
+    """Run `fn` in a thread; True when it ends within `seconds`. A named pipe that blocks the open is released at the
+    end (opened for read and write, which counts as a writer), so a failing test does not leave a thread behind."""
+    done = threading.Event()
+
+    def go() -> None:
+        try:
+            fn()
+        finally:
+            done.set()
+
+    threading.Thread(target=go, daemon=True).start()
+    ok = done.wait(seconds)
+    if not ok and unblock is not None:
+        os.close(os.open(unblock, os.O_RDWR))
+        done.wait(5)
+    return ok
+
+
+# -- precheck.py (the helpers) --
+
+
+@FIFO_SKIP
+def test_precheck_knows_pipes_sockets_and_devices_and_leaves_files_and_folders_alone(tmp_path: Path) -> None:
+    fifo = tmp_path / "p"
+    os.mkfifo(fifo)
+    sock_path = tmp_path / "s"
+    with socket.socket(socket.AF_UNIX) as s:
+        s.bind(str(sock_path))
+        assert precheck.is_special_file(sock_path)
+    (tmp_path / "f").write_text("x", encoding="utf-8")
+    assert precheck.is_special_file(fifo)
+    assert not precheck.is_special_file(tmp_path / "f") and not precheck.is_special_file(tmp_path)
+    assert not precheck.is_special_file(tmp_path / "missing") and not precheck.is_special_file("\0bad")
+    assert not precheck.is_special_file("x" * 5000)
+    if Path(os.devnull).exists() and stat.S_ISCHR(os.stat(os.devnull).st_mode):
+        assert precheck.is_special_file(os.devnull)
+
+
+def test_precheck_folder_part_is_a_file(tmp_path: Path) -> None:
+    (tmp_path / "f").write_text("x", encoding="utf-8")
+    (tmp_path / "d").mkdir()
+    assert precheck.folder_part_is_a_file(tmp_path / "f" / "desk.db")
+    assert precheck.folder_part_is_a_file(tmp_path / "f" / "a" / "b" / "desk.db")
+    assert not precheck.folder_part_is_a_file(tmp_path / "d" / "desk.db")
+    assert not precheck.folder_part_is_a_file(tmp_path / "d" / "new" / "deeper" / "desk.db")
+    assert not precheck.folder_part_is_a_file(tmp_path / "desk.db")
+    assert not precheck.folder_part_is_a_file("\0bad")
+    try:
+        (tmp_path / "dangling").symlink_to(tmp_path / "nowhere")
+    except OSError:
+        return  # no symbolic links here
+    assert precheck.folder_part_is_a_file(tmp_path / "dangling" / "desk.db")  # mkdir would fail on it
+
+
+def test_precheck_same_file_by_path_link_and_hard_link(tmp_path: Path) -> None:
+    a = tmp_path / "a"
+    a.write_text("x", encoding="utf-8")
+    (tmp_path / "b").write_text("x", encoding="utf-8")
+    assert precheck.same_file(a, tmp_path / "." / "a") and not precheck.same_file(a, tmp_path / "b")
+    assert precheck.same_file(tmp_path / "new", tmp_path / "x" / ".." / "new")  # neither exists: same path
+    assert not precheck.same_file(a, tmp_path / "missing") and not precheck.same_file("\0", a)
+    try:
+        os.link(a, tmp_path / "hard")
+        (tmp_path / "soft").symlink_to(a)
+    except OSError:
+        return
+    assert precheck.same_file(a, tmp_path / "hard") and precheck.same_file(a, tmp_path / "soft")
+
+
+# -- Minor 2: a book path whose folder is a file --
+
+
+@pytest.mark.parametrize("tail", ["desk.db", "sub/desk.db", "sub/deeper/desk.db"], ids=["direct", "sub", "deeper"])
+def test_a_book_path_below_a_regular_file_is_refused_before_the_question(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, tail: str
+) -> None:
+    monkeypatch.setattr("builtins.input", _no_question)
+    afile = tmp_path / "afile"
+    afile.write_text("not a folder", encoding="utf-8")
+    cfg = _valid_config(tmp_path, DESK_DB_PATH=str(afile / tail))
+    before = _tree(tmp_path)
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert (
+        out
+        == "refused: DESK_DB_PATH: a part of the folder path is a file, not a folder: the run folder cannot be made\n"
+    )
+    assert _tree(tmp_path) == before and afile.read_text(encoding="utf-8") == "not a folder"  # nothing written
+    assert str(tmp_path) not in out
+
+
+def test_a_book_path_below_a_dangling_link_is_refused_and_a_new_folder_is_fine(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    try:
+        (tmp_path / "lnk").symlink_to(tmp_path / "nowhere")
+    except OSError:
