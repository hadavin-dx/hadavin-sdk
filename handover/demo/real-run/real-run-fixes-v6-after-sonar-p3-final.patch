diff --git a/scripts/terminal_guard.py b/scripts/terminal_guard.py
new file mode 100644
index 0000000..1bf1502
--- /dev/null
+++ b/scripts/terminal_guard.py
@@ -0,0 +1,76 @@
+"""The start question of the check scripts: only a person at a terminal may answer it, and the answer is the address
+the keys go to, not a bare y.
+
+Why: on 2026-11-13 a `y` came in through a pipe and a valid made-up config made the desk try real network calls toward
+the vendor's default address. Two rules follow, both kept here so that no script has its own copy:
+  1. `stdin_is_terminal()` is True only for an interactive terminal. A pipe, a file, /dev/null, a closed stdin and (on
+     Windows) the NUL device are not one. It fails closed: any doubt is "not a terminal".
+  2. `ask_to_start(word, prompt)` never reads a stream that is not a terminal, and it is True only when the person typed
+     `word` (the destination host); `y`, `yes`, an empty line or anything else is a stop. A blind `yes |` stops here.
+     Limit (the same for every isatty check): a program that drives a pseudo-terminal and parses the banner can still
+     type the host; the real protection for a real account is an approval made by the owner outside the session.
+
+Windows, what is known and what is not (no Windows machine was available when this was written):
+  - KNOWN (Microsoft documentation): GetConsoleMode succeeds only for a console handle and fails for a pipe, a file and
+    the NUL device. libuv and the Rust standard library (`IsTerminal`) use it for the same purpose.
+  - NOT VERIFIED: what `sys.stdin.isatty()` returns for `< NUL` on the owner's Python 3.13. The C runtime's isatty has
+    historically answered True for any character device, and NUL is one; whether the Python in use corrects that is
+    not measured here. So on Windows `isatty()` alone is never trusted: the handle must also pass GetConsoleMode.
+  - NOT RUN: the GetConsoleMode call itself (`_windows_console_input`); only its logic around it is tested, with a
+    stand-in for the call (tests/test_start_prompt_hardening.py).
+"""
+
+from __future__ import annotations
+
+import sys
+from collections.abc import Callable
+from typing import Any
+
+_ON_WINDOWS = sys.platform == "win32"
+_NO_ANSWER_WORDS = frozenset({"", "y", "yes", "n", "no"})
+
+
+class NoTerminal(Exception):
+    """Standard input is not an interactive terminal: the question was not asked and nothing was read."""
+
+
+def _windows_console_input(stream: Any) -> bool:
+    """Windows: True only when the stream is a console input handle (GetConsoleMode works on it)."""
+    if sys.platform != "win32":
+        return False
+    import ctypes  # only here: the module is needed on Windows only
+    import msvcrt
+
+    handle = msvcrt.get_osfhandle(stream.fileno())
+    mode = ctypes.c_uint32()
+    return bool(ctypes.windll.kernel32.GetConsoleMode(ctypes.c_void_p(handle), ctypes.byref(mode)))
+
+
+def _console_input(
+    stream: Any, windows: bool = _ON_WINDOWS, probe: Callable[[Any], bool] = _windows_console_input
+) -> bool:
+    """The platform part of the terminal test. Off Windows the isatty answer stands; on Windows the console test must
+    pass too (see the module text)."""
+    return probe(stream) if windows else True
+
+
+def stdin_is_terminal() -> bool:
+    """True only when standard input is an interactive terminal. Fails closed: a closed, missing or odd stdin is no
+    terminal, so a piped `y` is never an answer."""
+    try:
+        stream = sys.stdin
+        return bool(stream.isatty()) and _console_input(stream)
+    except (AttributeError, ValueError, OSError):
+        return False
+
+
+def ask_to_start(word: str, prompt: str) -> bool:
+    """Ask `prompt` and return True only when the person typed `word` (case does not matter). Raises NoTerminal, without
+    reading anything, when standard input is not a terminal; an EOFError (the terminal closed under the question)
+    passes through to the caller, who must read it as a stop. `word` must be the destination host, never y or n."""
+    expected = word.strip().lower()
+    if expected in _NO_ANSWER_WORDS:
+        raise ValueError("the word to type must name the destination, not y or n")
+    if not stdin_is_terminal():
+        raise NoTerminal
+    return input(prompt).strip().lower() == expected
