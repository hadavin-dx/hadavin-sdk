+def test_windows_needs_a_console_not_just_isatty() -> None:
+    """The Windows rule, with a stand-in for GetConsoleMode (the real call was not run: no Windows machine here).
+    isatty on the NUL device was not verified on the owner's Python; the console test makes that not matter."""
+    nul = _Terminal()  # a stream whose isatty says True, as the C runtime has answered for NUL
+    calls: list[object] = []
+
+    def not_a_console(stream: object) -> bool:
+        calls.append(stream)
+        return False
+
+    def a_console(stream: object) -> bool:
+        return True
+
+    assert REAL_CONSOLE_INPUT(nul, windows=True, probe=not_a_console) is False and calls == [nul]
+    assert REAL_CONSOLE_INPUT(nul, windows=True, probe=a_console) is True
+    assert REAL_CONSOLE_INPUT(nul, windows=False, probe=not_a_console) is True  # off Windows isatty alone stands
+    assert len(calls) == 1  # the probe is not asked off Windows
+    if sys.platform != "win32":
+        assert tg._windows_console_input(nul) is False  # fails closed off Windows (and never imports msvcrt there)
