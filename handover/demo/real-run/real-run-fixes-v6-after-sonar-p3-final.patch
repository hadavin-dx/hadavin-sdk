+def _live_refusal(argv: list[str], capsys: pytest.CaptureFixture[str]) -> str:
+    try:
+        code = rlc.main(argv)
+    except SystemExit as e:  # an argparse error: still the one line, exit 2
+        code = e.code if isinstance(e.code, int) else -1
+    captured = capsys.readouterr()
+    assert code == rlc.EXIT_REFUSED == 2, (argv, captured.out, captured.err)
+    assert LIVE_LINE.fullmatch(captured.out), (argv, captured.out)  # exactly one line: refused: <OPTION>: <text>
+    assert captured.err == "" and "Traceback" not in captured.out
+    assert CANARY not in captured.out  # the value that was typed is never repeated
+    assert "DESK_" not in captured.out  # this script has no settings: the desk's setting names are shown as options
+    return captured.out
