+# -- the percent sign (the review's nit 7): the vendor-domain check and urllib must read the same host ---------------
+@pytest.mark.parametrize("sign", ["%2f", "%2e", "%25", "%40"])
+def test_a_percent_sign_in_the_host_is_refused_so_the_two_readers_cannot_differ(sign: str) -> None:
+    suffix = HUBSPOT_HOST_SUFFIXES[0]
+    hub = "https://" + "evil.test" + sign + "." + suffix
+    with pytest.raises(ValueError, match="no percent sign"):
+        HubspotSettings(Path("k"), 1, base_url=hub)
+    own = (LIVE_DEFAULT_BASE_URL.split("//", 1)[1]).split("/")[0]
+    live = "https://" + "evil.test" + sign + "." + own
+    kw: dict[str, Any] = {
+        "model": "m",
+        "key_file": Path("k"),
+        "price_in_per_mtok": 1,
+        "price_out_per_mtok": 1,
+        "price_date": "d",
+        "cap_run_usd": 1,
+        "cap_total_usd": 2,
+        "ledger_path": Path("l"),
+        "run_id": "r",
+        "base_url": live,
+    }
+    from decimal import Decimal
+
+    kw |= {k: Decimal(kw[k]) for k in ("price_in_per_mtok", "price_out_per_mtok", "cap_run_usd", "cap_total_usd")}
+    with pytest.raises(ValueError, match="no percent sign"):
+        LiveSettings(**kw)
+    with pytest.raises(ValueError, match="no percent sign"):  # also with the opt-out: it is never a host
+        HubspotSettings(Path("k"), 1, base_url=hub, allow_any_base_url=True)
+
