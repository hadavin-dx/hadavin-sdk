+# -- the desk process itself ----------------------------------------------------------------------------------------
+_BLOCKER = """
+import ipaddress, os, socket
+def _lo(h):
+    if isinstance(h, bytes):
+        h = h.decode()
+    if h in ("localhost", None, ""):
+        return True
+    try:
+        return ipaddress.ip_address(str(h).strip("[]")).is_loopback
+    except ValueError:
+        return False
+def _log(what, target):
+    with open(os.environ["BLOCK_LOG"], "a") as f:
+        f.write(what + " " + repr(target) + "\\n")
+_gai = socket.getaddrinfo
+def getaddrinfo(host, *a, **k):
+    if not _lo(host):
+        _log("lookup", host)
+        raise OSError("blocked")
+    return _gai(host, *a, **k)
+socket.getaddrinfo = getaddrinfo
+_c = socket.socket.connect
+def connect(self, addr):
+    if not (isinstance(addr, str) or _lo(addr[0])):
+        _log("connect", addr)
+        raise OSError("blocked")
+    return _c(self, addr)
+socket.socket.connect = connect
+"""
+
+
+def _run_desk(tmp_path: Path, extra: dict[str, str]) -> tuple[subprocess.CompletedProcess[str], list[str]]:
+    """`python -m lead_desk.server` as a child with a made-up key, a blocker for every non-loopback connection or name
+    lookup, and no DESK_* name from the shell. Returns the result and what the blocker logged (must stay empty)."""
+    block = tmp_path / "block"
+    block.mkdir()
+    (block / "sitecustomize.py").write_text(_BLOCKER, encoding="utf-8")
+    key = tmp_path / "key.txt"
+    key.write_text("made-up-" + "key-0123456789\n", encoding="utf-8")
+    log = tmp_path / "blocked.log"
+    env = {k: v for k, v in os.environ.items() if not k.startswith("DESK_")}
+    env |= {
+        "PYTHONPATH": os.pathsep.join([str(block), str(REPO / "src"), str(REPO)]),
+        "BLOCK_LOG": str(log),
+        "DESK_DB_PATH": str(tmp_path / "data" / "desk.db"),
+        "DESK_PORT": "0",
+        "DESK_ADAPTERS": "demo",
+        **extra,
+    }
+    done = subprocess.run(  # noqa: S603 (our own interpreter and module)
+        [sys.executable, "-m", "lead_desk.server"],
+        env=env,
+        cwd=REPO,
+        capture_output=True,
+        text=True,
+        timeout=60,
+        check=False,
+        stdin=subprocess.DEVNULL,
+    )
+    return done, (log.read_text(encoding="utf-8").splitlines() if log.exists() else [])
+
+
+def test_the_desk_process_refuses_hubspot_without_an_address_and_connects_nowhere(tmp_path: Path) -> None:
+    key = tmp_path / "k.txt"
+    done, blocked = _run_desk(
+        tmp_path, {"DESK_CRM": "hubspot", "DESK_HUBSPOT_KEY_FILE": str(key), "DESK_HUBSPOT_MAX_CALLS": "5"}
+    )
+    assert done.returncode == 4, done.stdout + done.stderr  # EXIT_DESK_SETTING_REFUSED: a plain refusal
+    assert "the desk refuses a setting: DESK_HUBSPOT_BASE_URL is required for the hubspot CRM" in done.stdout
+    assert "Traceback" not in done.stdout + done.stderr and blocked == []
+
+
+def test_the_desk_process_refuses_the_live_model_without_an_address_and_connects_nowhere(tmp_path: Path) -> None:
+    live = {k: v for k, v in LIVE.items() if k != "DESK_QUALIFIER"} | {
+        "DESK_LIVE_KEY_FILE": str(tmp_path / "k.txt"),
+        "DESK_LIVE_LEDGER_PATH": str(tmp_path / "ledger.jsonl"),
+    }
+    done, blocked = _run_desk(tmp_path, {"DESK_QUALIFIER": "live_claude", **live})
+    assert done.returncode == 4, done.stdout + done.stderr
+    assert "the desk refuses a setting: DESK_LIVE_BASE_URL is required for the live model" in done.stdout
+    assert "Traceback" not in done.stdout + done.stderr and blocked == []
+
+
+# -- sibling sweep: no vendor address is a default anywhere in src --------------------------------------------------
+_VENDOR_ADDRESS_NAMES = {"HUBSPOT_BASE_URL", "LIVE_DEFAULT_BASE_URL", "MAIL_IMAP_DEFAULT_HOST"}
+
+
+def test_no_vendor_address_constant_is_used_as_a_default_in_src() -> None:
+    """The three vendor addresses live in constants.py. The only use in src/ is the live settings' check that a key goes
+    to the provider's own host (config.py). Any other use (a dataclass default, a `.get(name, VENDOR)`) fails here."""
+    used: dict[str, set[str]] = {}
+    for path in sorted((REPO / "src").rglob("*.py")):
+        if path.name == "constants.py":
+            continue
+        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+            names = {a.name for a in node.names} if isinstance(node, ast.ImportFrom) else set()
+            if isinstance(node, ast.Name):
+                names.add(node.id)
+            hit = names & _VENDOR_ADDRESS_NAMES
+            if hit:
+                used.setdefault(path.name, set()).update(hit)
+    assert used == {"config.py": {"LIVE_DEFAULT_BASE_URL"}}, used
+
+
