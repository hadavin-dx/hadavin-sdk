diff --git a/tests/test_desk_address_required.py b/tests/test_desk_address_required.py
new file mode 100644
index 0000000..db97e67
--- /dev/null
+++ b/tests/test_desk_address_required.py
@@ -0,0 +1,249 @@
+"""The desk never fills in the address a key is sent to (HubSpot, the live model): the settings must name it.
+
+The class (the incident of 2026-11-13, and the review of the start-prompt patch): `python -m lead_desk.server` with
+DESK_CRM=hubspot, a key file and a call cap but NO DESK_HUBSPOT_BASE_URL posted one lead and then tried the vendor's own
+address; DESK_QUALIFIER=live_claude without DESK_LIVE_BASE_URL did the same toward the model vendor. The default address
+was the vendor's own, so it passed the "vendor's own domain" check by omission. Now an absent or blank address is a
+refusal that names the setting, in the env readers and in the dataclasses (no default field). A loopback address, or the
+vendor's own address named on purpose, still works. Every test here runs without any network."""
+
+from __future__ import annotations
+
+import ast
+import dataclasses
+import os
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from lead_desk.config import Config, LiveSettings
+from lead_desk.constants import HUBSPOT_BASE_URL, HUBSPOT_HOST_SUFFIXES, LIVE_DEFAULT_BASE_URL
+from lead_desk.crm_hubspot import HubspotSettings, make_crm
+
+REPO = Path(__file__).resolve().parents[1]
+LOOPBACK = "http://127.0.0.1:9"
+HUBSPOT = {"DESK_HUBSPOT_KEY_FILE": "k.txt", "DESK_HUBSPOT_MAX_CALLS": "5"}
+LIVE = {
+    "DESK_QUALIFIER": "live_claude",
+    "DESK_LIVE_MODEL": "m",
+    "DESK_LIVE_KEY_FILE": "k.txt",
+    "DESK_LIVE_PRICE_DATE": "2026-01-01",
+    "DESK_LIVE_LEDGER_PATH": "l.jsonl",
+    "DESK_LIVE_RUN_ID": "r",
+    "DESK_LIVE_PRICE_IN_PER_MTOK": "1",
+    "DESK_LIVE_PRICE_OUT_PER_MTOK": "2",
+    "DESK_LIVE_CAP_RUN_USD": "1",
+    "DESK_LIVE_CAP_TOTAL_USD": "3",
+}
+BLANKS = ["", " ", "\t", "\n"]
+
+
+# -- HubSpot: the env reader ------------------------------------------------------------------------------------------
+def test_hubspot_from_env_refuses_an_address_that_is_not_named() -> None:
+    with pytest.raises(ValueError, match="DESK_HUBSPOT_BASE_URL is required for the hubspot CRM") as e:
+        HubspotSettings.from_env(HUBSPOT)
+    assert "never filled in by a default" in str(e.value)
+    for blank in BLANKS:
+        with pytest.raises(ValueError, match="DESK_HUBSPOT_BASE_URL is required"):
+            HubspotSettings.from_env({**HUBSPOT, "DESK_HUBSPOT_BASE_URL": blank})
+
+
+def test_hubspot_from_env_accepts_the_vendors_own_address_named_on_purpose_and_a_loopback_one() -> None:
+    assert HubspotSettings.from_env({**HUBSPOT, "DESK_HUBSPOT_BASE_URL": HUBSPOT_BASE_URL}).base_url == HUBSPOT_BASE_URL
+    loop = {**HUBSPOT, "DESK_HUBSPOT_BASE_URL": LOOPBACK, "DESK_HUBSPOT_ALLOW_ANY_BASE_URL": "yes"}
+    assert HubspotSettings.from_env(loop).base_url == LOOPBACK  # the documented test path
+    with pytest.raises(ValueError, match="vendor's own domains"):  # a named loopback https still needs the opt-out
+        HubspotSettings.from_env({**HUBSPOT, "DESK_HUBSPOT_BASE_URL": "https://127.0.0.1"})
+
+
+def test_hubspot_settings_have_no_default_address_in_code_either() -> None:
+    field = next(f for f in dataclasses.fields(HubspotSettings) if f.name == "base_url")
+    assert field.default is dataclasses.MISSING and field.default_factory is dataclasses.MISSING
+    with pytest.raises(TypeError):
+        HubspotSettings(Path("k"), 1)  # type: ignore[call-arg]
+
+
+def test_make_crm_the_desks_own_entry_point_refuses_before_anything_connects(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    import socket
+
+    def boom(*_a: Any, **_k: Any) -> Any:
+        raise AssertionError("a connection or a name lookup was tried")
+
+    monkeypatch.setattr(socket.socket, "connect", boom)
+    monkeypatch.setattr(socket, "getaddrinfo", boom)
+    for name, value in HUBSPOT.items():
+        monkeypatch.setenv(name, value)
+    monkeypatch.delenv("DESK_HUBSPOT_BASE_URL", raising=False)
+    with pytest.raises(ValueError, match="DESK_HUBSPOT_BASE_URL is required"):
+        make_crm(Config(crm="hubspot"))
+
+
+# -- live model: the env reader ---------------------------------------------------------------------------------------
+def test_live_settings_from_env_refuse_an_address_that_is_not_named() -> None:
+    with pytest.raises(ValueError, match="DESK_LIVE_BASE_URL is required for the live model") as e:
+        Config.from_env(LIVE)
+    assert "never filled in by a default" in str(e.value)
+    for blank in BLANKS:
+        with pytest.raises(ValueError, match="DESK_LIVE_BASE_URL is required"):
+            Config.from_env({**LIVE, "DESK_LIVE_BASE_URL": blank})
+
+
+def test_live_settings_from_env_accept_the_providers_own_address_named_and_a_loopback_one() -> None:
+    live = Config.from_env({**LIVE, "DESK_LIVE_BASE_URL": LIVE_DEFAULT_BASE_URL}).live
+    assert live is not None and live.base_url == LIVE_DEFAULT_BASE_URL
+    live = Config.from_env({**LIVE, "DESK_LIVE_BASE_URL": LOOPBACK}).live
