+def workflow_files(folder: Path) -> list[Path]:
+    return sorted(p for ext in ("*.yml", "*.yaml") for p in folder.glob(ext))
+
+
+WORKFLOWS = workflow_files(REPO / ".github" / "workflows")
+STEP_KEYS = set("name id if uses run with env shell working-directory continue-on-error timeout-minutes".split())
+JOB_KEYS = set(
+    "name runs-on steps needs if env permissions timeout-minutes strategy defaults outputs services container "
+    "concurrency continue-on-error environment uses with secrets".split()
+)
+
+
+def problems(doc: Any) -> list[str]:
+    """What is wrong with a parsed workflow document, as plain sentences; an empty list means the shape is fine."""
+    if not isinstance(doc, dict):
+        return ["the top level must be a mapping"]
+    out = []
+    if "on" not in doc and True not in doc:  # PyYAML (YAML 1.1) turns the key `on` into True
+        out.append("no top-level `on` (nothing would trigger this workflow)")
+    jobs = doc.get("jobs")
+    if not isinstance(jobs, dict) or not jobs:
+        return [*out, "no jobs"]
+    for name, job in jobs.items():
+        if not isinstance(job, dict):
+            out.append(f"job {name} is not a mapping")
+            continue
+        unknown_job = sorted(str(k) for k in job if k not in JOB_KEYS)
+        if unknown_job:
+            out.append(f"job {name} has unknown keys {unknown_job}")
+        if "uses" in job:  # a reusable workflow call: it has no steps of its own
+            continue
+        if "runs-on" not in job:
+            out.append(f"job {name} has no `runs-on` (and no `uses`)")
+        steps = job.get("steps")
+        if not isinstance(steps, list) or not steps:
+            out.append(f"job {name} has no steps")
+            continue
+        for i, step in enumerate(steps, start=1):
+            where = f"job {name}, step {i}"
+            if not isinstance(step, dict):
+                out.append(f"{where} is not a mapping")
+                continue
+            if ("run" in step) == ("uses" in step):
+                out.append(f"{where} must have exactly one of `run` or `uses`")
+            unknown = sorted(str(k) for k in step if k not in STEP_KEYS)
+            if unknown:
+                out.append(f"{where} has unknown keys {unknown}")
+    return out
 
 
