+GOOD = """
+name: x
+on: [push]
+jobs:
+  a:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: s
+        run: echo hi
+        shell: bash
+  b:
+    uses: ./.github/workflows/other.yml
+"""
+
+
+def _mutated(old: str, new: str) -> Any:
+    assert old in GOOD
+    return yaml.safe_load(GOOD.replace(old, new, 1))
+
+
+def test_the_shape_check_accepts_a_good_file_and_a_reusable_workflow_job() -> None:
+    assert problems(yaml.safe_load(GOOD)) == []
+
+
+@pytest.mark.parametrize(
+    ("old", "new", "expect"),
+    [
+        ("runs-on: ubuntu-latest", "run-on: ubuntu-latest", "no `runs-on`"),
+        ("uses: actions/checkout@v4", "use: actions/checkout@v4", "exactly one of"),
+        ("on: [push]", "no: [push]", "no top-level `on`"),
+        ("run: echo hi", "run: echo hi\n        usess: x", "unknown keys ['usess']"),
+        ("shell: bash", "shel: bash", "unknown keys ['shel']"),
+        ("run: echo hi", "run: echo hi\n        uses: x/y@v1", "exactly one of"),
+    ],
+    ids=["runs-on-typo", "uses-typo", "no-on", "extra-step-key", "shell-typo", "run-and-uses"],
+)
+def test_the_shape_check_rejects_each_typo(old: str, new: str, expect: str) -> None:
+    found = problems(_mutated(old, new))
+    assert any(expect in f for f in found), found
+
+
+@pytest.mark.parametrize(
+    ("doc", "expect"),
+    [
+        (["a list"], "top level must be a mapping"),
+        ({"on": 1, "jobs": {}}, "no jobs"),
+        ({"on": 1, "jobs": {"a": "text"}}, "job a is not a mapping"),
+        ({"on": 1, "jobs": {"a": {"runs-on": "x", "steps": []}}}, "job a has no steps"),
+        ({"on": 1, "jobs": {"a": {"runs-on": "x", "steps": ["just a string"]}}}, "step 1 is not a mapping"),
+        (
+            {"on": 1, "jobs": {"a": {"runs-on": "x", "timeout-minute": 5, "steps": [{"run": "x"}]}}},
+            "unknown keys ['timeout-minute']",
+        ),
+    ],
+    ids=["list-on-top", "no-jobs", "job-not-a-mapping", "empty-steps", "step-not-a-mapping", "job-key-typo"],
+)
+def test_the_shape_check_reaches_every_branch(doc: Any, expect: str) -> None:
+    assert any(expect in f for f in problems(doc)), problems(doc)
+
