+++ b/tests/test_gitleaks_exceptions.py
@@ -0,0 +1,120 @@
+"""The SonarQube project-key exception is exact: only the one real line in sonar-project.properties is let through;
+every near-miss planted in a temporary copy is still reported, by the scan for hardcoded literals (tools/hygiene.py)
+and by gitleaks. Values are built from the repository's own key at run time: no key-shaped literal in this file."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+from support import REPO
+
+from tools import hygiene
+
+GITLEAKS_ENV = "GITLEAKS_BIN"
+REQUIRE_SCAN_ENV = "DPLD_REQUIRE_SCAN"  # when set (CI), a missing gitleaks program fails instead of skipping
+FILE = "sonar-project.properties"
+NAME = "sonar.project" + "Key="
+
+
+def _real_key() -> str:
+    for line in (REPO / FILE).read_text(encoding="utf-8").splitlines():
+        if line.startswith(NAME):
+            return line[len(NAME) :]
+    raise AssertionError(f"{FILE} has no {NAME} line")
+
+
+def _variants() -> dict[str, tuple[str, str]]:
+    """name -> (file name, line) for a near-miss of the allowed line."""
+    key = _real_key()
+    other = key.split("_")[0] + "_other-project-" + "a" * 22  # another project, all lowercase, same prefix
+    ok = NAME + key
+    return {
+        "other project": (FILE, NAME + other),
+        "last character changed": (FILE, ok[:-1] + "x"),
+        "dash suffix": (FILE, ok + "-x"),
+        "equals suffix": (FILE, ok + "=x"),
+        "space suffix": (FILE, ok + " x"),
+        "dot suffix": (FILE, ok + ".x"),
+        "upper-case value": (FILE, NAME + key.upper()),
+        "capital first letter": (FILE, NAME + key.capitalize()),
+        "lower-case name": (FILE, ok.replace("Key", "key")),
+        "upper-case name": (FILE, ok.replace("projectKey", "PROJECTKEY")),
+        "text before the name": (FILE, "x" + ok),
+        "look-alike file name": ("old-" + FILE, ok),
+        "other folder and name": ("docs/x.properties", ok),
+        "readme": ("README.md", ok),
+    }
+
+
+# The scan for hardcoded literals looks at the matched run of characters, so a space or a dot after the key ends the
+# run (the text equals the allowed key again) and text before the name is not part of the run; gitleaks sees those.
+ONLY_GITLEAKS = {"space suffix", "dot suffix", "text before the name"}
+# gitleaks 8.30.1 does not flag a lowercase value after a key of this shape (docs/tests.md, quality checks): the
+# literal scan is the only guard for another lowercase project key, so that case is not asserted on gitleaks.
+ONLY_LITERAL_SCAN = {"other project"}
+
+
+def _plant(root: Path, files: dict[str, str]) -> Path:
+    root.mkdir(parents=True, exist_ok=True)
+    for rel, line in files.items():
+        (root / rel).parent.mkdir(parents=True, exist_ok=True)
+        (root / rel).write_text("a=b" + chr(10) + line + chr(10), encoding="utf-8")
+    subprocess.run(["git", "init", "-q"], cwd=root, check=True)  # noqa: S603, S607
+    subprocess.run(["git", "add", "."], cwd=root, check=True)  # noqa: S603, S607
+    return root
+
+
+def _literal_hits(root: Path) -> set[str]:
+    left = hygiene.pipeline(root, REPO / "patterns.txt", REPO / "exceptions.txt")
+    return {ln.split(":", 1)[0] for ln in left}
+
+
+def _gitleaks_exe() -> str:
+    raw = os.environ.get(GITLEAKS_ENV) or "gitleaks"
+    exe = raw if os.path.dirname(raw) else (shutil.which(raw) or "")
+    if not exe or not os.path.exists(exe):
+        if os.environ.get(REQUIRE_SCAN_ENV):
+            pytest.fail(f"gitleaks binary not found: put it on PATH or set {GITLEAKS_ENV}")
+        pytest.skip(f"no gitleaks program (set {GITLEAKS_ENV}); set {REQUIRE_SCAN_ENV}=1 to make this a failure")
+    return os.path.abspath(exe)
+
+
+def _gitleaks_hits(root: Path) -> set[str]:
+    report = root.parent / (root.name + ".json")  # the report goes outside the planted folder
+    cmd = [_gitleaks_exe(), "dir", "--no-banner", "--redact", "--ignore-gitleaks-allow"]
+    cmd += ["--config", str(REPO / ".gitleaks.toml"), "--report-format", "json", "--report-path", str(report), "."]
+    subprocess.run(cmd, cwd=root, capture_output=True, check=False)  # noqa: S603
+    rows = json.loads(report.read_text(encoding="utf-8") or "[]")
+    return {x["File"].replace(chr(92), "/") for x in rows}
+
+
+VARIANTS = _variants()
+
+
+def test_the_exact_line_is_allowed(tmp_path: Path) -> None:
+    root = _plant(tmp_path / "t", {FILE: NAME + _real_key()})
+    assert _literal_hits(root) == set()  # without this control, "reported" below would prove nothing
+    assert _gitleaks_hits(root) == set()
+
+
+@pytest.mark.parametrize("name", [n for n in VARIANTS if n not in ONLY_GITLEAKS])
+def test_a_near_miss_is_reported_by_the_literal_scan(tmp_path: Path, name: str) -> None:
+    rel, line = VARIANTS[name]
+    assert _literal_hits(_plant(tmp_path / "t", {rel: line})) == {rel}
+
+
+@pytest.mark.parametrize("name", [n for n in VARIANTS if n not in ONLY_LITERAL_SCAN])
+def test_a_near_miss_is_reported_by_gitleaks(tmp_path: Path, name: str) -> None:
+    rel, line = VARIANTS[name]
+    assert _gitleaks_hits(_plant(tmp_path / "t", {rel: line})) == {rel}
+
+
+def test_the_exact_line_in_a_sub_folder_is_reported_by_the_literal_scan(tmp_path: Path) -> None:
+    # gitleaks lets it through (its path rule has a folder part; harmless: the text is the public key)
+    rel = "sub/" + FILE
+    assert _literal_hits(_plant(tmp_path / "t", {rel: NAME + _real_key()})) == {rel}
