+def route_prices_above_zero(route: Route) -> bool:
+    """The one price rule (audit C-01): both prices of a live model route must be above 0. A price of 0 or below
+    makes every reply cost 0 or less, so no spend limit could fire. Used by the pilot and prod load check below and
+    by the replay command (`k1b/replay.py`). NaN and Infinity never get here (pydantic's Decimal field refuses them)."""
+    return route.input_usd_per_mtok > 0 and route.output_usd_per_mtok > 0
+
+
+def _route_refusals(routes: dict[str, Route], max_route_tokens: int) -> list[str]:
+    """Route problems for pilot and prod, one text each. No exemption for the recorded `fake` model: `fake` is
+    dev-only and is refused in pilot and prod before this matters. `max_tokens` may not pass `max_route_tokens`."""
+    out: list[str] = []
+    for name, r in sorted(routes.items()):
+        if not route_prices_above_zero(r):
+            out.append(f"route {name}: a live model needs a price above 0")
+        if r.max_tokens > max_route_tokens:
+            out.append(f"route {name}: max_tokens {r.max_tokens} above max_route_tokens")
+    return out
+
+
 class Backends(_Strict):
