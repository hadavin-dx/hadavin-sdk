diff --git a/tests/test_c01_minimal_route_limits.py b/tests/test_c01_minimal_route_limits.py
new file mode 100644
index 0000000..13a16a1
--- /dev/null
+++ b/tests/test_c01_minimal_route_limits.py
@@ -0,0 +1,96 @@
+"""Audit C-01 (minimal): in pilot and prod a live model needs prices above 0 and max_tokens within the ceiling.
+
+A price of 0 makes every reply cost 0, so no spend limit could fire. The boundary numbers are literals on purpose:
+a test that read the constant from defaults.py would follow any change to it."""
+
+import pytest
+import yaml
+
+from hadavin_sdk.config import load_config
+from hadavin_sdk.errors import ConfigError
+from tests.test_k3_pilot_env import pilot_cfg
+
+
+def _route(**over):
+    return {
+        "routes": {
+            "default": {
+                "model_id": "m",
+                "input_usd_per_mtok": "3.00",
+                "output_usd_per_mtok": "15.00",
+                "max_tokens": 1024,
+                **over,
+            }
+        }
+    }
+
+
+@pytest.mark.parametrize("env", ["pilot", "prod"])
+@pytest.mark.parametrize("field", ["input_usd_per_mtok", "output_usd_per_mtok"])
+@pytest.mark.parametrize("price", ["0", "0.00", "-1"])
+def test_a_zero_or_negative_price_is_refused(tmp_path, env, field, price):
+    with pytest.raises(ConfigError, match="needs a price above 0"):
+        load_config(pilot_cfg(tmp_path, env=env, config=_route(**{field: price})))
+
+
+@pytest.mark.parametrize("env", ["pilot", "prod"])
+@pytest.mark.parametrize("tokens", [200_001, 2_000_000])
+def test_max_tokens_over_the_ceiling_is_refused(tmp_path, env, tokens):
+    with pytest.raises(ConfigError, match="above max_route_tokens"):
+        load_config(pilot_cfg(tmp_path, env=env, config=_route(max_tokens=tokens)))
+
+
+def test_the_ceiling_itself_and_a_tiny_price_load_in_pilot(tmp_path):
+    cfg = load_config(
+        pilot_cfg(tmp_path, config=_route(max_tokens=200_000, input_usd_per_mtok="0.000001"))
+    )
+    assert cfg.routes["default"].max_tokens == 200_000
+
+
+def test_a_good_route_adds_no_refusal_in_prod(tmp_path):
+    # The prod fixture is refused for an unrelated reason (a key file); the route must not be one of them.
+    with pytest.raises(ConfigError) as err:
+        load_config(pilot_cfg(tmp_path, env="prod", config=_route(max_tokens=200_000)))
+    assert "route" not in str(err.value)
+
+
+def test_the_ceiling_comes_from_config(tmp_path):
+    cfg_ok = pilot_cfg(tmp_path, config={**_route(max_tokens=5000), "max_route_tokens": 5000})
+    assert load_config(cfg_ok).max_route_tokens == 5000
+    with pytest.raises(ConfigError, match="above max_route_tokens"):
+        load_config(
+            pilot_cfg(tmp_path / "b", config={**_route(max_tokens=5001), "max_route_tokens": 5000})
+        )
+
+
+def test_route_refusals_are_listed_together_with_the_environment_refusals(tmp_path):
+    # Guards the `refused +=` joins: a route problem must not drop, or be dropped by, an environment refusal.
+    root = pilot_cfg(tmp_path, config=_route(input_usd_per_mtok="0"))
+    path = root / "config.yaml"
+    raw = yaml.safe_load(path.read_text(encoding="utf-8"))
+    raw["allow_insecure_loopback"] = True
+    path.write_text(yaml.safe_dump(raw), encoding="utf-8")
+    with pytest.raises(ConfigError) as err:
+        load_config(root)
+    text = str(err.value)
+    assert "allow_insecure_loopback" in text
+    assert "needs a price above 0" in text
+
+
+def test_dev_is_not_changed(tmp_path):
+    # Dev keeps loading a zero price; this patch is a pilot and prod rule only (stated in the README).
+    root = pilot_cfg(
+        tmp_path, env="dev", config=_route(input_usd_per_mtok="0", max_tokens=2_000_000)
+    )
+    try:
+        load_config(root)
+    except (
+        ConfigError
+    ) as exc:  # dev refuses the pilot-style kinds for other reasons; the route must not be one
+        assert "price" not in str(exc) and "max_route_tokens" not in str(exc)
+
+
+def test_pydantic_still_refuses_a_non_finite_price_so_the_rule_needs_no_nan_branch(tmp_path):
+    for bad in ("NaN", "Infinity", "-Infinity"):
+        with pytest.raises(ConfigError):
+            load_config(pilot_cfg(tmp_path / bad, config=_route(input_usd_per_mtok=bad)))
