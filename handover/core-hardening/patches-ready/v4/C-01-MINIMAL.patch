+def _route_refusals(routes: dict[str, Route], llm_kind: str, max_route_tokens: int) -> list[str]:
+    """Route problems for pilot and prod, one text each (audit C-01, minimal). A live model (any kind but the
+    recorded `fake`) needs both prices above 0: a price of 0 makes every reply cost 0, so no spend limit could
+    fire. `max_tokens` may not pass `Config.max_route_tokens`. NaN and Infinity never get here (pydantic's
+    Decimal field refuses them when the route is built)."""
+    out: list[str] = []
+    for name, r in sorted(routes.items()):
+        if llm_kind != "fake" and not (r.input_usd_per_mtok > 0 and r.output_usd_per_mtok > 0):
+            out.append(f"route {name}: a live model needs a price above 0")
+        if r.max_tokens > max_route_tokens:
+            out.append(f"route {name}: max_tokens {r.max_tokens} above max_route_tokens")
+    return out
+
+
 class Backends(_Strict):
     """One validated settings model per capability (built by `parse_backends`, never from raw YAML)."""
 
