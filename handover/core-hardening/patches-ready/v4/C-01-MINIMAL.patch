     routes: dict[str, Route]
+    # Most tokens one reply may be allowed to run to (pilot and prod); default and reason are in defaults.py.
+    max_route_tokens: int = Field(default=defaults.MAX_ROUTE_TOKENS, gt=0)
     backends: Backends
     golden_dir: Path
     inputs_dir: Path
@@ -368,6 +384,7 @@ class Config(_Strict):
                 f"{c}: {s.kind}" for c, s in self.backends.entries() if (c, s.kind) in DEV_ONLY
             ]
             refused += ["allow_insecure_loopback"] if self.allow_insecure_loopback else []
+            refused += _route_refusals(self.routes, self.backends.llm.kind, self.max_route_tokens)
         refused += _anchor_refusals(self.environment, self.backends)
         if refused:
             raise ValueError(f"environment {self.environment}: refused: {', '.join(refused)}")
