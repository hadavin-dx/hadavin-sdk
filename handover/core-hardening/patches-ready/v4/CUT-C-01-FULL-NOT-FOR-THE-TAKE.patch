+"""Audit C-01: a route with a zero, negative or non-finite price, or an absurd max_tokens, is refused at load.
+
+A price of 0 makes every reply cost 0, so no spend limit (per run, per day, per month) could ever fire. Each test
+loads the fixture config with one change and expects the load to fail with a ConfigError that names the problem.
+The numbers in the boundary tests are written out as literals on purpose: a test that reads the constant from
+defaults.py follows any change to it (mutation lane, survivors 12 to 14)."""
+
+from decimal import Decimal
+
+import pytest
+import yaml
+
+from hadavin_sdk.config import ConfigError, Route, _price_ok, load_config, price_problems
+from tests.test_k3_pilot_env import pilot_cfg
+
+LIVE_LLM = {"kind": "anthropic", "api_key_secret_name": "a", "platform": "api"}
+LOCAL_LLM = {"kind": "openai_compat", "base_url": "http://127.0.0.1:11434/v1"}
+LOCAL_WITH_KEY = {
+    "kind": "openai_compat",
+    "base_url": "https://localhost/v1",
+    "api_key_secret_name": "a",
+}
+REMOTE_NO_KEY = {"kind": "openai_compat", "base_url": "https://models.example.com/v1"}
+
+
+def _load(cfg_dir, *, llm=None, top=None, **route):
+    path = cfg_dir / "config.yaml"
+    raw = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if llm is not None:
+        raw["backends"]["llm"] = llm
+    raw.update(top or {})
+    raw["routes"]["default"].update(route)
+    path.write_text(yaml.safe_dump(raw), encoding="utf-8")
+    return load_config(cfg_dir)
+
+
+@pytest.mark.parametrize("field", ["input_usd_per_mtok", "output_usd_per_mtok"])
+@pytest.mark.parametrize("price", ["0", "0.00", "-1", "-0"])
+def test_a_zero_or_negative_price_is_refused_for_a_live_model(cfg_dir, field, price):
+    with pytest.raises(ConfigError, match="needs a price above 0"):
+        _load(cfg_dir, llm=LIVE_LLM, **{field: price})
+
+
+@pytest.mark.parametrize("field", ["input_usd_per_mtok", "output_usd_per_mtok"])
+@pytest.mark.parametrize("price", ["NaN", "sNaN", "Infinity", "-Infinity"])
+@pytest.mark.parametrize("llm", [None, LIVE_LLM])
+def test_nan_and_infinity_are_a_clean_config_error_never_a_crash(cfg_dir, field, price, llm):
+    # Fake kind included: a non-finite price is never meaningful.
+    with pytest.raises(ConfigError, match="finite number"):
+        _load(cfg_dir, llm=llm, **{field: price})
+
+
+@pytest.mark.parametrize("price", ["NaN", "sNaN", "Infinity", "-Infinity"])
+def test_pydantic_itself_refuses_a_non_finite_price_and_this_is_what_the_patch_relies_on(price):
+    # Run on pydantic 2.14.1 (raw/nan-probe-*.txt): the field refuses it as a validation error, so load_config
+    # wraps it as a ConfigError and nothing crashes. If a pydantic update ever changed that, this test fails
+    # and the total predicate below becomes the only guard.
+    with pytest.raises(ValueError, match="finite"):
+        Route(model_id="m", input_usd_per_mtok=price, output_usd_per_mtok="1", max_tokens=1)
+
+
+def test_the_price_predicate_is_total_even_where_pydantic_is_bypassed():
+    # Decimal("NaN") > 0 raises InvalidOperation; the predicate must answer False instead.
+    for bad in ("NaN", "sNaN", "Infinity", "-Infinity", "0", "-0.5"):
+        assert _price_ok(Decimal(bad), zero_ok=False) is False
+    assert _price_ok(Decimal(0), zero_ok=True) is True
+    assert _price_ok(Decimal(-1), zero_ok=True) is False
+    assert _price_ok(Decimal("NaN"), zero_ok=True) is False
