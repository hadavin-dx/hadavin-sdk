+def _price_ok(price: Decimal, *, zero_ok: bool) -> bool:
+    """Total over every Decimal (NaN, Infinity, negative zero): never raises. Only a finite price above 0 passes,
+    or exactly 0 when `zero_ok`. Defence in depth: pydantic already refuses NaN and Infinity when a Route is
+    built from config (a test pins that), but a Route copied with `model_copy` skips that check."""
+    return price.is_finite() and (price > 0 or (zero_ok and price == 0))
+
+
+def price_problems(route: Route, *, keyless_loopback: bool) -> list[str]:
+    """THE rule for the price of a live model (every kind except `fake`), used by the config load and by replay.
+
+    A price of 0 makes every reply cost 0, so no spend limit could ever fire. Exactly 0 is allowed only when the
+    route sets `price_is_zero_by_design` AND the model is keyless loopback (a local model with no key, on this
+    machine; the scheme does not matter, so a local address over https counts). Returns one text per problem, empty if fine."""
+    out: list[str] = []
+    if route.price_is_zero_by_design and not keyless_loopback:
+        out.append("price_is_zero_by_design needs a keyless loopback model")
+    zero_ok = route.price_is_zero_by_design and keyless_loopback
+    if not (
+        _price_ok(route.input_usd_per_mtok, zero_ok=zero_ok)
+        and _price_ok(route.output_usd_per_mtok, zero_ok=zero_ok)
+    ):
+        out.append(
+            "a live model needs a price above 0 (a zero price would stop every cost limit; a local "
+            "keyless model may set price_is_zero_by_design: true)"
+        )
+    return out
+
+
+def _route_refusals(
+    routes: dict[str, Route], llm: KindSettings, max_route_tokens: int
+) -> list[str]:
+    """Every route problem as one text each, so they join the load's single `refused` list (audit C-01)."""
+    live = llm.kind != "fake"  # the recorded fake never spends, so it needs no price
+    local_free = bool(getattr(llm, "keyless_loopback", False))
+    out: list[str] = []
+    for name, r in sorted(routes.items()):
+        if live:
+            out += [f"route {name}: {p}" for p in price_problems(r, keyless_loopback=local_free)]
+        if r.max_tokens > max_route_tokens:
+            out.append(f"route {name}: max_tokens {r.max_tokens} above max_route_tokens")
+    return out
 
 
