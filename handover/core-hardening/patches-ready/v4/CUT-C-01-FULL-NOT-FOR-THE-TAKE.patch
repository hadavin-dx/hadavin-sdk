+def test_the_one_rule_is_shared_and_answers_both_ways():
+    r = Route(model_id="m", input_usd_per_mtok="0", output_usd_per_mtok="0", max_tokens=1)
+    flagged = r.model_copy(update={"price_is_zero_by_design": True})
+    assert price_problems(r, keyless_loopback=True)  # no flag: refused even on a local model
+    assert price_problems(r, keyless_loopback=False)
+    assert price_problems(flagged, keyless_loopback=True) == []
+    # flag on a model that is not keyless loopback: the flag is refused AND the zero price still counts as a zero
+    # price (the flag cannot excuse it), so the person sees both problems in one round
+    assert len(price_problems(flagged, keyless_loopback=False)) == 2
+    nan = flagged.model_copy(update={"input_usd_per_mtok": Decimal("NaN")})  # copy skips pydantic
+    assert price_problems(nan, keyless_loopback=True)  # total: refused, never raises
