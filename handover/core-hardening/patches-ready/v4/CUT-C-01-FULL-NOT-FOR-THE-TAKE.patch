+def _local_zero(reg, *, flag, llm=LOCAL, **update):
+    """The registry's route priced 0 (copy, so pydantic is skipped) on a configured local or other model."""
+    from hadavin_sdk.backends.table import OpenAICompatSettings
+
+    update = {"input_usd_per_mtok": Decimal(0), "output_usd_per_mtok": Decimal(0), **update}
+    route = reg.config.routes["default"].model_copy(
+        update={"price_is_zero_by_design": flag, **update}
+    )
+    backends = reg.config.backends.model_copy(update={"llm": OpenAICompatSettings(**llm)})
+    cfg = reg.config.model_copy(update={"routes": {"default": route}, "backends": backends})
+    return dataclasses.replace(reg, config=cfg)
+
