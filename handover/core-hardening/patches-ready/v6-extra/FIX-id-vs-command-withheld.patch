@@ -0,0 +1,73 @@
+"""G4 must never withhold a Hadavin id (`<prefix>-<32 hex digits>`) or a plan hash.
+
+Bug class: a pattern written for readable names (here the cloud-cmdlet shape `Verb-<module><Noun>`, for example
+`Remove-EC2Instance`) also matches a random token made of the same letters. A Hadavin id is a lowercase word, a hyphen,
+then 32 random hex digits (`models.new_id`). When the first digits spell `ec2` and the fourth is one of `a`-`f`, the id
+read as a cmdlet and the approval card showed `[command withheld (G4)]` instead of the id (1 id in about 10,900; a test
+that builds four ids failed about once in 2,700 runs). The fix is at the one place all callers go through
+(`gate._WRITE_SHAPES`, used by `withhold_commands` and so by `channel.clean`). The tests below do not depend on luck:
+they walk every possible first four hex digits."""
+
+from __future__ import annotations
+
+import hashlib
+
+import pytest
+
+from hadavin_sdk.approvals.channel import clean
+from hadavin_sdk.approvals.gate import WITHHELD, withhold_commands
+from hadavin_sdk.models import new_id
+
+_PREFIXES = ("run", "pln", "apr", "evt")
+
+
+def test_a_known_id_that_reads_like_a_cloud_cmdlet_is_kept():
+    ident = "pln-ec2a" + "0" * 28
+    assert withhold_commands(ident) == ident
+    assert clean(f"plan {ident} waits") == f"plan {ident} waits"
+
+
+@pytest.mark.parametrize("prefix", _PREFIXES)
+def test_no_id_is_withheld_for_any_first_four_hex_digits(prefix):
+    tail = "0123456789abcdef" * 2  # 32 digits; the first four are replaced below
+    bad = []
+    for n in range(16**4):
+        ident = f"{prefix}-{n:04x}{tail[4:]}"
+        if withhold_commands(ident) != ident:
+            bad.append(ident)
+    assert not bad, bad[:5]
+
+
+def test_pseudo_random_ids_and_plan_hashes_are_never_withheld():
+    # digits come from sha256 of a counter: the same 20,000 texts every run, no random generator needed
+    for i in range(20000):
+        d = [hashlib.sha256(f"g4-{i}-{k}".encode()).hexdigest() for k in range(3)]
+        text = " ".join(f"{p}-{d[0][j * 8 : j * 8 + 32]}" for j, p in enumerate(_PREFIXES))
+        text += f" plan {d[1]}{d[2]}"[:72]
+        assert WITHHELD not in withhold_commands(text), text
+
+
+def test_real_new_id_values_are_not_withheld():
+    for _ in range(2000):
+        ident = new_id("pln")
+        assert withhold_commands(ident) == ident
+
+
+@pytest.mark.parametrize(
+    "command",
+    [
+        "Remove-EC2Instance -InstanceId i-123",
+        "remove-ec2instance -InstanceId i-123",
+        "Remove-ec2a1 -x",
+        "Stop-S3Object -Bucket b",
+        "Remove-AzResourceGroup -Name rg",
+        "Delete-ec2a" + "0" * 28 + "x",  # hex then a letter that is not hex: still a command name
+    ],
+)
+def test_real_cloud_cmdlets_are_still_withheld(command):
+    assert WITHHELD in withhold_commands(command)
+
+
+def test_a_name_that_is_not_all_hex_digits_is_never_mistaken_for_an_id():
+    # a name that is not all hex digits is never mistaken for an id, even if it begins like one
+    assert WITHHELD in withhold_commands("Remove-ec2abcdef0123456789abcdef0123456789Instance")
