@@ -0,0 +1,158 @@
+"""Audit C-01: a route with a zero, negative or non-finite price, or an absurd max_tokens, is refused at load.
+
+A price of 0 makes every reply cost 0, so no spend limit (per run, per day, per month) could ever fire. Each test
+loads the fixture config with one change and expects the load to fail with a ConfigError that names the problem.
+The numbers in the boundary tests are written out as literals on purpose: a test that reads the constant from
+defaults.py follows any change to it (mutation lane, survivors 12 to 14)."""
+
+from decimal import Decimal
+
+import pytest
+import yaml
+
+from hadavin_sdk.config import ConfigError, Route, _price_ok, load_config
+
+LIVE_LLM = {"kind": "anthropic", "api_key_secret_name": "a", "platform": "api"}
+LOCAL_LLM = {"kind": "openai_compat", "base_url": "http://127.0.0.1:11434/v1"}
+LOCAL_WITH_KEY = {
+    "kind": "openai_compat",
+    "base_url": "https://localhost/v1",
+    "api_key_secret_name": "a",
+}
+REMOTE_NO_KEY = {"kind": "openai_compat", "base_url": "https://models.example.com/v1"}
+
+
+def _load(cfg_dir, *, llm=None, top=None, **route):
+    path = cfg_dir / "config.yaml"
+    raw = yaml.safe_load(path.read_text(encoding="utf-8"))
+    if llm is not None:
+        raw["backends"]["llm"] = llm
+    raw.update(top or {})
+    raw["routes"]["default"].update(route)
+    path.write_text(yaml.safe_dump(raw), encoding="utf-8")
+    return load_config(cfg_dir)
+
+
+@pytest.mark.parametrize("field", ["input_usd_per_mtok", "output_usd_per_mtok"])
+@pytest.mark.parametrize("price", ["0", "0.00", "-1", "-0"])
+def test_a_zero_or_negative_price_is_refused_for_a_live_model(cfg_dir, field, price):
+    with pytest.raises(ConfigError, match="needs a price above 0"):
+        _load(cfg_dir, llm=LIVE_LLM, **{field: price})
+
+
+@pytest.mark.parametrize("field", ["input_usd_per_mtok", "output_usd_per_mtok"])
+@pytest.mark.parametrize("price", ["NaN", "sNaN", "Infinity", "-Infinity"])
+@pytest.mark.parametrize("llm", [None, LIVE_LLM])
+def test_nan_and_infinity_are_a_clean_config_error_never_a_crash(cfg_dir, field, price, llm):
+    # Fake kind included: a non-finite price is never meaningful.
+    with pytest.raises(ConfigError):
+        _load(cfg_dir, llm=llm, **{field: price})
+
+
+def test_the_price_predicate_is_total_even_where_pydantic_is_bypassed():
+    # Decimal("NaN") > 0 raises InvalidOperation; the predicate must answer False instead.
+    for bad in ("NaN", "sNaN", "Infinity", "-Infinity", "0", "-0.5"):
+        assert _price_ok(Decimal(bad), zero_ok=False) is False
+    assert _price_ok(Decimal(0), zero_ok=True) is True
+    assert _price_ok(Decimal(-1), zero_ok=True) is False
+    assert _price_ok(Decimal("NaN"), zero_ok=True) is False
+
+
+def test_a_tiny_positive_price_is_accepted_on_purpose(cfg_dir):
+    # There is no floor above 0: any floor would be an invented number. The spend limits still see a cost > 0.
+    cfg = _load(cfg_dir, llm=LIVE_LLM, input_usd_per_mtok="0.000000000001")
+    assert cfg.routes["default"].input_usd_per_mtok > 0
+
+
+def test_a_priced_live_route_still_loads(cfg_dir):
+    cfg = _load(cfg_dir, llm=LIVE_LLM)
+    assert cfg.routes["default"].input_usd_per_mtok > 0
+
+
+def test_the_fake_model_may_cost_nothing(cfg_dir):
+    # kind "fake" never spends: the recorded replies need no price, so the check does not apply to it.
+    cfg = _load(cfg_dir, input_usd_per_mtok="0", output_usd_per_mtok="0")
+    assert cfg.routes["default"].output_usd_per_mtok == 0
+
+
+def test_zero_by_design_works_only_on_a_keyless_loopback_model(cfg_dir):
+    cfg = _load(
+        cfg_dir,
+        llm=LOCAL_LLM,
+        input_usd_per_mtok="0",
+        output_usd_per_mtok="0",
+        price_is_zero_by_design=True,
+    )
+    assert cfg.routes["default"].price_is_zero_by_design is True
+
+
+def test_a_local_model_with_price_0_but_no_flag_is_refused(cfg_dir):
+    with pytest.raises(ConfigError, match="needs a price above 0"):
+        _load(cfg_dir, llm=LOCAL_LLM, input_usd_per_mtok="0", output_usd_per_mtok="0")
+
+
+@pytest.mark.parametrize("llm", [LIVE_LLM, LOCAL_WITH_KEY, REMOTE_NO_KEY])
+def test_the_flag_is_refused_when_the_model_is_not_keyless_loopback(cfg_dir, llm):
+    with pytest.raises(ConfigError, match="price_is_zero_by_design needs a keyless loopback"):
+        _load(cfg_dir, llm=llm, price_is_zero_by_design=True)
+
+
+def test_the_flag_never_lets_a_negative_or_non_finite_price_through(cfg_dir):
+    with pytest.raises(ConfigError, match="needs a price above 0"):
+        _load(cfg_dir, llm=LOCAL_LLM, input_usd_per_mtok="-1", price_is_zero_by_design=True)
+
+
+def test_the_flag_defaults_to_false_and_does_not_change_the_agent_hash_input(cfg_dir):
+    route = _load(cfg_dir).routes["default"]
+    assert route.price_is_zero_by_design is False
+    # config_hash dumps with exclude_defaults, so existing agents stay qualified.
+    assert "price_is_zero_by_design" not in route.model_dump(mode="json", exclude_defaults=True)
+
+
+def test_every_route_refusal_is_reported_at_once(cfg_dir):
+    path = cfg_dir / "config.yaml"
+    raw = yaml.safe_load(path.read_text(encoding="utf-8"))
+    raw["backends"]["llm"] = LIVE_LLM
+    raw["routes"]["default"].update(input_usd_per_mtok="0", max_tokens=200_001)
+    raw["routes"]["second"] = {**raw["routes"]["default"], "input_usd_per_mtok": "1"}
+    path.write_text(yaml.safe_dump(raw), encoding="utf-8")
+    with pytest.raises(ConfigError) as err:
+        load_config(cfg_dir)
+    text = str(err.value)
+    assert "route default: a live model needs a price above 0" in text
+    assert "route default: max_tokens 200001 above max_route_tokens" in text
+    assert "route second: max_tokens 200001 above max_route_tokens" in text
+
+
+@pytest.mark.parametrize("tokens", [200_001, 2_000_000])
+def test_max_tokens_above_the_ceiling_is_refused(cfg_dir, tokens):
+    with pytest.raises(ConfigError, match="above max_route_tokens"):
+        _load(cfg_dir, max_tokens=tokens)
+
+
+def test_max_tokens_at_the_ceiling_loads(cfg_dir):
+    assert _load(cfg_dir, max_tokens=200_000).routes["default"].max_tokens == 200_000
+
+
+def test_the_ceiling_is_a_config_field_and_can_be_lowered(cfg_dir):
+    assert _load(cfg_dir, top={"max_route_tokens": 2000}, max_tokens=2000).max_route_tokens == 2000
+    with pytest.raises(ConfigError, match="above max_route_tokens"):
+        _load(cfg_dir, top={"max_route_tokens": 2000}, max_tokens=2001)
+
+
+def test_the_ceiling_field_itself_must_be_above_zero(cfg_dir):
+    with pytest.raises(ConfigError):
+        _load(cfg_dir, top={"max_route_tokens": 0})
+
+
+def test_max_tokens_boundary_at_the_bottom(cfg_dir):
+    assert _load(cfg_dir, max_tokens=1).routes["default"].max_tokens == 1
+    with pytest.raises(ConfigError):
+        _load(cfg_dir, max_tokens=0)
+    with pytest.raises(ConfigError):
+        _load(cfg_dir, max_tokens=-1)
+
+
+def test_route_is_still_frozen_and_strict():
+    with pytest.raises(ValueError):
+        Route(model_id="m", input_usd_per_mtok="1", output_usd_per_mtok="1", max_tokens=1, extra=1)
