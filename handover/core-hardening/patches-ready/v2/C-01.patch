+def _price_ok(price: Decimal, *, zero_ok: bool) -> bool:
+    """Total over every Decimal (NaN, Infinity, negative zero): never raises. Only a finite price above 0 passes,
+    or exactly 0 when `zero_ok`."""
+    return price.is_finite() and (price > 0 or (zero_ok and price == 0))
+
