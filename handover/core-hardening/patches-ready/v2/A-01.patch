--- a/tests/test_a01_audit_reconcile.py
+++ b/tests/test_a01_audit_reconcile.py
@@ -0,0 +1,264 @@
+"""Audit A-01: nothing drained the audit outbox, and a failed audit write left no log line.
+
+The tick step `audit_drain` calls the audit kind's `reconcile`, logs drained, remaining and corrupt counts, and
+FAILS when events are still waiting (so `tick_state.last_ok_at` stops advancing). Both audit kinds log a warning
+(error type and event id only, never the event body or the error text) when an outcome goes to the outbox."""
+
+import logging
+
+import pytest
+
+from hadavin_sdk.actions.secrets import FakeSecretProvider
+from hadavin_sdk.app import build
+from hadavin_sdk.approvals import FakeChannel
+from hadavin_sdk.audit import chain as audit
+from hadavin_sdk.audit.local_dir import LocalDirSink
+from hadavin_sdk.audit.protocol import DuplicateEvent
+from hadavin_sdk.models import AuditEvent
+from hadavin_sdk.runtime import tick
+from hadavin_sdk.runtime.tick import TickContext, run_tick
+
+ERROR_DETAIL = "disk-detail-xyz"
+
+
+def _event(i: int = 0) -> AuditEvent:
+    return AuditEvent(
+        run_id=f"run-{i}",
+        domain="run",
+        operation="state",
+        principal="system:test",
+        source="test",
+        result="OK",
+    )
+
+
+class _FakeApp:
+    def __init__(self, audit_sink):
+        self.audit = audit_sink
+
+
+def _ctx(sink) -> TickContext:
+    return TickContext(_FakeApp(sink), now=None)
+
+
+def _down(event):
+    raise OSError(ERROR_DETAIL)
+
+
+def _chain_with_outbox(monkeypatch, *events):
+    log = audit.ChainAudit(audit._Db.memory())
+    monkeypatch.setattr(log, "_append", _down)
+    for e in events:
+        assert log.write_outcome(e) is None
+    monkeypatch.undo()
+    return log
+
+
+@pytest.fixture
+def app(cfg_dir):
+    return build(
+        cfg_dir,
+        [],
+        secrets=FakeSecretProvider({"fixture-token": "tok" + "-a01"}),
+        channel=FakeChannel("sig" + "-a01"),
+    )
+
+
+# --- the step is wired right ---------------------------------------------------------------------------------
+
+
+def test_the_step_entry_points_at_the_right_function_and_runs_every_tick():
+    (step,) = [s for s in tick.STEPS if s.name == "audit_drain"]
+    assert step.fn is tick.audit_drain
+    assert step.every_s == 0 and step.interval is None
+    assert tick.STEPS[-1] is step  # append-only contract
+
+
+def test_the_tick_function_does_not_share_a_name_with_the_approvals_reconcile():
+    assert tick.audit_drain is not tick.reconcile
+    assert "audit_reconcile" not in [s.name for s in tick.STEPS]
+
+
+# --- chain kind ----------------------------------------------------------------------------------------------
+
+
+def test_the_step_drains_the_outbox_and_logs_the_counts(caplog, monkeypatch):
+    first = _event(1)
+    log = _chain_with_outbox(monkeypatch, first)
+    assert log._db.run("SELECT event_id FROM audit_outbox") == [(first.event_id,)]
+    caplog.set_level(logging.INFO, logger="hadavin_sdk.tick")
+    tick.audit_drain(_ctx(log))
+    assert "audit_drain drained=1 remaining=0 corrupt=0" in caplog.text
+    assert log._db.run("SELECT event_id FROM audit_outbox") == []
+    assert [e.event_id for e in log.events()] == [first.event_id]
+
+
+def test_an_empty_outbox_is_green_and_says_zero(caplog):
+    caplog.set_level(logging.INFO, logger="hadavin_sdk.tick")
+    tick.audit_drain(_ctx(audit.ChainAudit(audit._Db.memory())))
+    assert "audit_drain drained=0 remaining=0 corrupt=0" in caplog.text
+
+
+def test_a_bad_row_is_skipped_logged_counted_and_the_good_row_behind_it_is_drained(
+    caplog, monkeypatch
+):
+    good = _event(2)
+    log = _chain_with_outbox(monkeypatch, good)
+    # sorts before the good one, so it is read first
+    log._db.run("INSERT INTO audit_outbox (event_id, body) VALUES (?, ?)", ("0-bad", "{not json"))
+    caplog.set_level(logging.INFO)
+    assert log.reconcile() == 1
+    assert log.last_corrupt == 1
+    assert [e.event_id for e in log.events()] == [good.event_id]
+    assert "ValidationError" in caplog.text and "0-bad" in caplog.text
+    assert "not json" not in caplog.text
+    assert log.backlog() == 1  # the damaged row stays: a person must look
+
+
+def test_a_damaged_row_fails_the_step_every_tick_but_never_blocks_the_rows_behind_it(monkeypatch):
+    good = _event(3)
+    log = _chain_with_outbox(monkeypatch, good)
+    log._db.run("INSERT INTO audit_outbox (event_id, body) VALUES (?, ?)", ("0-bad", "{"))
+    with pytest.raises(RuntimeError, match="still waiting: 1 .corrupt 1"):
+        tick.audit_drain(_ctx(log))
+    assert [e.event_id for e in log.events()] == [good.event_id]
+
+
+def test_a_database_that_stays_down_leaves_the_step_failing(caplog, monkeypatch):
+    log = _chain_with_outbox(monkeypatch, _event(4))
+    monkeypatch.setattr(log, "_append", _down)
+    with pytest.raises(RuntimeError, match="still waiting: 1"):
+        tick.audit_drain(_ctx(log))
+    assert log.backlog() == 1
+
+
+def test_an_unreadable_outbox_table_fails_the_step_not_a_green_zero(monkeypatch):
+    log = _chain_with_outbox(monkeypatch, _event(5))
+
+    def table_down(*a, **k):
+        raise OSError("table down")
+
+    monkeypatch.setattr(log._db, "run", table_down)
+    with pytest.raises(OSError, match="table down"):
+        tick.audit_drain(_ctx(log))
+
+
+def test_events_held_in_memory_count_as_remaining(monkeypatch):
+    log = audit.ChainAudit(audit._Db.memory())
+    log._pending.append(_event(6))
+    monkeypatch.setattr(log, "_append", _down)
+    assert log.reconcile() == 0
+    assert log.backlog() == 1
+
+
+def test_a_duplicate_outcome_returns_the_event_id_and_logs_nothing(caplog):
+    log = audit.ChainAudit(audit._Db.memory())
+    ev = _event(7)
+    assert log.write_outcome(ev) == ev.event_id
+    with caplog.at_level(logging.WARNING):
+        assert log.write_outcome(ev) == ev.event_id  # DuplicateEvent path
+    assert caplog.text == ""
+    assert log._db.run("SELECT event_id FROM audit_outbox") == []
+
+
+def test_a_failed_outcome_write_logs_type_and_id_but_never_the_body(caplog, monkeypatch):
+    log = audit.ChainAudit(audit._Db.memory())
+    monkeypatch.setattr(log, "_append", _down)
+    ev = _event(8)
+    with caplog.at_level(logging.WARNING, logger="hadavin_sdk.audit.chain"):
+        log.write_outcome(ev)
+    assert "OSError" in caplog.text and ev.event_id in caplog.text
+    assert ERROR_DETAIL not in caplog.text and "run-8" not in caplog.text
+    assert [r.levelno for r in caplog.records] == [logging.WARNING]
+
+
+def test_when_the_outbox_table_also_fails_an_error_line_is_logged(caplog, monkeypatch):
+    log = audit.ChainAudit(audit._Db.memory())
+    monkeypatch.setattr(log, "_append", _down)
+
+    def broken_run(*a, **k):
+        raise OSError("table down")
+
+    monkeypatch.setattr(log._db, "run", broken_run)
+    with caplog.at_level(logging.ERROR, logger="hadavin_sdk.audit.chain"):
+        log.write_outcome(_event(9))
+    assert "held in memory only" in caplog.text and len(log._pending) == 1
+
+
+# --- local_dir kind ------------------------------------------------------------------------------------------
+
+
+def test_the_local_dir_kind_logs_one_warning_with_type_and_id_never_the_error_text(
+    caplog, tmp_path, monkeypatch
+):
+    sink = LocalDirSink(tmp_path)
+    monkeypatch.setattr(sink, "_write", _down)
+    ev = _event(10)
+    with caplog.at_level(logging.DEBUG, logger="hadavin_sdk.audit.local_dir"):
+        assert sink.write_outcome(ev) is None
+    warnings = [r for r in caplog.records if r.levelno == logging.WARNING]
+    assert len(warnings) == 1
+    assert "OSError" in caplog.text and ev.event_id in caplog.text
+    assert ERROR_DETAIL not in caplog.text and "run-10" not in caplog.text
+
+
+def test_the_local_dir_duplicate_path_logs_nothing(caplog, tmp_path):
+    sink = LocalDirSink(tmp_path)
+    ev = _event(11)
+    sink.write_intent(ev)
+    with caplog.at_level(logging.WARNING):
+        assert sink.write_outcome(ev) == f"{ev.event_id}.json"
+    assert caplog.text == ""
+    with pytest.raises(DuplicateEvent):
+        sink.write_intent(ev)
+
+
+def test_the_real_local_dir_kind_drains_through_the_tick_step(app, caplog, monkeypatch):
+    sink = app.audit
+    assert isinstance(sink, LocalDirSink)
+    ev = _event(12)
+    monkeypatch.setattr(sink, "_write", _down)
+    assert sink.write_outcome(ev) is None
+    assert len(list(sink.outbox.glob("*.json"))) == 1
+    monkeypatch.undo()
+    caplog.set_level(logging.INFO, logger="hadavin_sdk.tick")
+    assert run_tick(app) == 0
+    assert "audit_drain drained=1 remaining=0 corrupt=0" in caplog.text
+    assert list(sink.outbox.glob("*.json")) == []
+    assert [e.event_id for e in sink.events("run-12")] == [ev.event_id]
+    assert app.store.get_tick_state("audit_drain").last_ok_at is not None
+
+
+def test_a_stuck_outbox_stops_last_ok_at_from_advancing_and_exits_1(app, monkeypatch):
+    sink = app.audit
+    monkeypatch.setattr(sink, "_write", _down)
+    sink.write_outcome(_event(13))
+    assert run_tick(app) == 1
+    state = app.store.get_tick_state("audit_drain")
+    assert state.last_ok_at is None  # never green while events wait
+    assert state.last_error is not None and "still waiting: 1" in state.last_error
+    assert ERROR_DETAIL not in state.last_error
+    # the other steps still ran and stayed green
+    assert app.store.get_tick_state("sweep").last_ok_at is not None
+
+
+def test_local_dir_corrupt_outbox_file_is_moved_aside_counted_and_logged(caplog, tmp_path):
+    sink = LocalDirSink(tmp_path)
+    sink.outbox.mkdir(parents=True)
+    (sink.outbox / "0-bad.json").write_text("{nope", encoding="utf-8")
+    caplog.set_level(logging.INFO)
+    tick.audit_drain(_ctx(sink))  # moved aside, so nothing remains: green
+    assert sink.last_corrupt == 1
+    assert (sink.outbox / "corrupt" / "0-bad.json").exists()
+    assert "audit_drain drained=0 remaining=0 corrupt=1" in caplog.text
+    assert "nope" not in caplog.text
+
+
