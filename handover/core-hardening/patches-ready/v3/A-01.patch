+"""A durable local spill folder for audit events the audit database could not take (audit A-01, option a).
+
+Order for an outcome event in the `chain` kind: the chain, then the outbox table, then (only when a spill folder is
+configured) one file per event here, then memory. Each file is written to a temp name, flushed to disk and renamed
+into place, so a reader never sees half a file and a writer and a reader never touch the same bytes. The tick step
+`audit_drain` reads the folder, writes the events into the chain and deletes each file after its event is safe.
+A file that cannot be read is moved to ``corrupt/`` and stays counted until a person deals with it.
+
+Limit: the tick can only drain this folder when it runs on the same machine (or volume) as the serving process.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from pathlib import Path
+
+from hadavin_sdk.models import AuditEvent
+
+_LOG = logging.getLogger("hadavin_sdk.audit.spill")
+
+
+class Spill:
+    def __init__(self, root: Path) -> None:
+        self.root = Path(root)
+        self.corrupt = self.root / "corrupt"
+
+    def put(self, event: AuditEvent) -> None:
+        """Raises OSError when the folder cannot be written (the caller then keeps the event in memory)."""
+        self.root.mkdir(parents=True, exist_ok=True)
+        tmp = self.root / f".tmp-{event.event_id}"
+        try:
+            with open(tmp, "w", encoding="utf-8") as f:
+                f.write(event.model_dump_json())
+                f.flush()
+                os.fsync(f.fileno())
+            os.replace(tmp, self.root / f"{event.event_id}.json")
+        except OSError:
+            tmp.unlink(missing_ok=True)  # no half file is left behind
+            raise
+        self._fsync_dir()
+
+    def _fsync_dir(self) -> None:
+        """Make the new name durable (POSIX). Windows cannot open a folder for fsync: best effort, like local_dir."""
+        try:
+            fd = os.open(self.root, os.O_RDONLY)
+        except OSError:
+            return
+        try:
+            os.fsync(fd)
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+
+    def waiting(self) -> list[Path]:
+        return sorted(self.root.glob("*.json")) if self.root.exists() else []
+
+    def quarantined(self) -> int:
+        return len(list(self.corrupt.glob("*.json"))) if self.corrupt.exists() else 0
+
+    def read(self, path: Path) -> AuditEvent | None:
+        """The event in the file, or None after moving a damaged file to ``corrupt/`` (type and name logged)."""
+        try:
+            return AuditEvent.model_validate_json(path.read_text(encoding="utf-8"))
+        except ValueError as exc:
+            self.corrupt.mkdir(exist_ok=True)
+            os.replace(path, self.corrupt / path.name)
+            _LOG.error(
+                "audit spill file not readable (%s): %s moved to corrupt",
+                type(exc).__name__,
+                path.name,
+            )
+            return None
+
+    def count(self) -> int:
+        """Files waiting plus files moved aside: all of them need action."""
+        return len(self.waiting()) + self.quarantined()
