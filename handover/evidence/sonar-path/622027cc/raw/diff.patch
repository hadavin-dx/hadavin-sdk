+ROOT = Path(__file__).resolve().parents[1]
+TEST = "tests/test_pathguard.py"
+PIN = "tests/test_pathguard::"
+PG = "src/hadavin_sdk/pathguard.py"
+AT = "src/hadavin_sdk/k1b/atomic.py"
+CFG = "src/hadavin_sdk/config.py"
