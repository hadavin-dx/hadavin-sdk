+
+    for name, words in OPERATOR_NAMES.items():
+        (tmp_path / name).write_text("value-1", encoding="utf-8")
+        (tmp_path / name).chmod(0o400)
+        said = _said(MountedFileProvider(tmp_path, 1).get, name)
