+    _must_refuse("R11", "operator_dir on a file", pathguard.operator_dir, tmp_path / "f", what="x")
+    _must_refuse(
+        "R11", "operator_file on a folder", pathguard.operator_file, tmp_path / "d", what="x"
+    )
+    _must_refuse(
+        "R11",
+        "operator_dir must_exist False on a file",
