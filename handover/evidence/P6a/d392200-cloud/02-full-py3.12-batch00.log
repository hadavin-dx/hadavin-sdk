            connect(
                dsn, iam_auth=iam_auth, region=region, sslmode=sslmode, sslrootcert=sslrootcert
            ) as db,
            db.transaction(),
        ):
            db.execute("SELECT pg_advisory_xact_lock(%s)", (_LOCK,))
            db.execute(
