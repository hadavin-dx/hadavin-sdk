        with tempfile.TemporaryDirectory() as tmp:
            copy = Path(tmp) / "renewed"
            copy.mkdir()
            for name in ("src", "tests", "tools", "docs", ".github"):
                shutil.copytree(
                    root / name, copy / name, ignore=shutil.ignore_patterns("__pycache__", "*.pyc")
