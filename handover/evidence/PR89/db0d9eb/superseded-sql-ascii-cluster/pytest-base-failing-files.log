        a.create_run(run)
        results, gate = [], threading.Barrier(2)
    
        def race(store):
            gate.wait()
            try:
                store.transition(run.run_id, RunState.RECEIVED, RunState.WORKING)
                results.append("won")
            except StaleState:
                results.append("stale")
    
        threads = [threading.Thread(target=race, args=(s,)) for s in (a, b)]
        for t in threads:
