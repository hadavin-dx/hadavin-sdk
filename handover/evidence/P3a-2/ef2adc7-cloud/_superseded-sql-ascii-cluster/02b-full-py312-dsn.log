    def test_a_transient_connect_failure_is_retried_once_and_a_second_failure_is_reported(
        db, monkeypatch
    ):
        real, calls = psycopg.connect, []
    
        def flaky(*args, **kwargs):
            calls.append(1)
            if len(calls) == 1:
