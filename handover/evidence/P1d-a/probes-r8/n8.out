== /tmp/p9
'`a\nevil.com` b evil.com' -> '`a\nevil[.]com` b evil[.]com'
'x `evil.com\ny` z evil.com' -> 'x `evil[.]com\ny` z evil[.]com'
'see `a` and evil.com' -> 'see `a` and evil[.]com'
'`a evil.com password=4xKp2Vb9Lr3NcW8dYh6uJs` b' -> '`a evil.com password=4xKp2Vb9Lr3NcW8dYh6uJs` b'
'see ``note `evil.com` x`` now' -> 'see ``note `evil[.]com` x`` now'
'```\nevil.com\n```\nthen evil.com' -> '```\nevil.com\n```\nthen evil[.]com'
'a ` b\nevil.com ` c' -> 'a ` b\nevil[.]com ` c'
'use \\`evil.com\\` now' -> 'use \\`evil[.]com\\` now'
'`x` ` y\nevil.com' -> '`x` ` y\nevil[.]com'
'run `curl db01.corp.example.com` now' -> 'run `curl db01.corp.example.com` now'
