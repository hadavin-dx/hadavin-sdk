diff --git a/tests/test_a01_audit_reconcile.py b/tests/test_a01_audit_reconcile.py
new file mode 100644
index 0000000..bc1ad54
--- /dev/null
+++ b/tests/test_a01_audit_reconcile.py
@@ -0,0 +1,92 @@
+"""Audit A-01: nothing drained the audit outbox, and a failed audit write left no log line.
+
+The tick step `audit_reconcile` calls the audit kind's `reconcile` and logs how many events it wrote. The chain
+kind logs a warning (error type and event id only, never the event body) when an outcome goes to the outbox."""
+
+import logging
+
+from hadavin_sdk.audit import chain as audit
+from hadavin_sdk.audit.local_dir import LocalDirSink
+from hadavin_sdk.models import AuditEvent
+from hadavin_sdk.runtime import tick
+from hadavin_sdk.runtime.tick import TickContext
+
+
+def _event(i: int = 0) -> AuditEvent:
+    return AuditEvent(
+        run_id=f"run-{i}",
+        domain="run",
+        operation="state",
+        principal="system:test",
+        source="test",
+        result="OK",
+    )
+
+
+class _FakeApp:
+    def __init__(self, audit_sink):
+        self.audit = audit_sink
+
+
+def test_the_step_is_in_the_tick_list():
+    assert "audit_reconcile" in [s.name for s in tick.STEPS]
+
+
+def test_the_step_drains_the_outbox_and_logs_the_count(caplog):
+    log = audit.ChainAudit(audit._Db.memory())
+    real = log._append
+    log._append = lambda e: (_ for _ in ()).throw(OSError("down"))
+    first = _event(1)
+    assert log.write_outcome(first) is None
+    assert log._db.run("SELECT event_id FROM audit_outbox") == [(first.event_id,)]
+    log._append = real
+    caplog.set_level(logging.INFO, logger="hadavin_sdk.tick")
+    tick.audit_reconcile(TickContext(_FakeApp(log), now=None))
+    assert "audit_reconcile drained=1" in caplog.text
+    assert log._db.run("SELECT event_id FROM audit_outbox") == []
+
+
+def test_a_kind_without_reconcile_is_skipped(caplog):
+    caplog.set_level(logging.INFO, logger="hadavin_sdk.tick")
+    tick.audit_reconcile(TickContext(_FakeApp(object()), now=None))
+    assert "audit_reconcile" not in caplog.text
+
+
+def test_a_failed_outcome_write_logs_type_and_id_but_never_the_body(caplog):
+    log = audit.ChainAudit(audit._Db.memory())
+    log._append = lambda e: (_ for _ in ()).throw(OSError("secret-looking detail"))
+    ev = _event(2)
+    with caplog.at_level(logging.WARNING, logger="hadavin_sdk.audit.chain"):
+        log.write_outcome(ev)
+    assert "OSError" in caplog.text and ev.event_id in caplog.text
+    assert "secret-looking detail" not in caplog.text and "run-2" not in caplog.text
+
+
+def test_when_the_outbox_table_also_fails_an_error_line_is_logged(caplog):
+    log = audit.ChainAudit(audit._Db.memory())
+    log._append = lambda e: (_ for _ in ()).throw(OSError("down"))
+
+    def broken_run(*a, **k):
+        raise OSError("table down")
+
+    log._db.run = broken_run
+    with caplog.at_level(logging.ERROR, logger="hadavin_sdk.audit.chain"):
+        log.write_outcome(_event(3))
+    assert "held in memory only" in caplog.text and len(log._pending) == 1
+
+
+def test_local_dir_sink_logs_a_warning_and_then_an_error_when_the_outbox_fails_too(
+    tmp_path, caplog
+):
+    sink = LocalDirSink(tmp_path / "audit")
+    sink.root.mkdir(parents=True, exist_ok=True)
+    blocker = sink.root / "outbox"
+    blocker.write_text("a file where the outbox folder should be", encoding="utf-8")
+    sink._write = lambda e: (_ for _ in ()).throw(OSError("secret-looking detail"))
+    ev = _event(4)
+    with caplog.at_level(logging.WARNING, logger="hadavin_sdk.audit.local_dir"):
+        assert sink.write_outcome(ev) is None
+    assert "goes to the outbox" in caplog.text and "held in memory only" in caplog.text
+    assert ev.event_id in caplog.text and "OSError" in caplog.text
+    assert "secret-looking detail" not in caplog.text and "run-4" not in caplog.text
+    assert len(sink._pending) == 1
