 # the key=value rule masks V. Over-redaction (an ARN segment that looks like `...token=`) is the accepted price.
 _KV_WORD = r"(?:password|passwd|pwd|secret|token|api[_\-]?key|apikey|access[_\-]?key|private[_\-]?key|credential|auth)"
 ARN_CHAR = r"(?:(?![\w.\-*+@]{0,40}?" + _KV_WORD + r"[\w.\-]{0,20}=)" + ARN_TAIL + ")"
+# (G11) A value that sits inside a run of 40 or more token characters that HIGHENTROPY would mask is left to HIGHENTROPY.
+_TOKCH = r"[A-Za-z0-9_\-+/]"
+
+
+def _has(cls: str) -> str:
+    # `cls` somewhere in the run: from the match start on (128), or in the 64 characters before it (fixed-width look-behinds)
+    left = "|".join(rf"(?<={cls}{_TOKCH}{{{k}}})" for k in range(64))
+    return rf"(?:(?={_TOKCH}{{0,128}}{cls})|{left})"
+
+
+_IN_LONG_RUN = (
+    r"(?!(?=(?:"
+    + "|".join(rf"(?<={_TOKCH}{{{l}}})(?={_TOKCH}{{{40 - l}}})" for l in range(41))
+    + "))(?=" + _has("[A-Z]") + ")(?=" + _has("[a-z]") + ")(?=" + _has("[0-9]") + "))"
+)
