+"""Survivor R20 (scripts/run_real_check.py): a config file that exists but cannot be read.
+
+A missing file or a folder is refused earlier, by the path check in `load_env`. The
+`except OSError` arm of `main` is reached only when the read itself fails (no permission,
+a disk error). Its text must hold no path and no error name. The read is made to fail here,
+because the tests may run as a user who can read every file."""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+import run_real_check as rrc  # noqa: E402
+from test_real_check_dry import _valid_config  # noqa: E402
+
+
+def test_a_config_file_whose_read_fails_is_refused_with_one_fixed_line(
+    tmp_path: Path,
+    capsys: pytest.CaptureFixture[str],
+    monkeypatch: pytest.MonkeyPatch,
+    a_terminal: None,
+) -> None:
+    cfg = _valid_config(tmp_path)
+    real_read_text = Path.read_text
+
+    def read_text(self: Path, *args: object, **kwargs: object) -> str:
+        if self.name == cfg.name:
+            raise PermissionError(13, "denied", str(self))  # the OS error text holds the path
+        return real_read_text(self, *args, **kwargs)  # type: ignore[arg-type]
+
+    def no_question(prompt: str = "") -> str:
+        raise AssertionError("the start question was asked")
+
+    monkeypatch.setattr(Path, "read_text", read_text)
+    monkeypatch.setattr("builtins.input", no_question)
+    assert rrc.main(["--config", str(cfg)]) == rrc.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert out == "refused: --config: the config file cannot be read\n"
+    assert cfg.name not in out and "Error" not in out and "denied" not in out
