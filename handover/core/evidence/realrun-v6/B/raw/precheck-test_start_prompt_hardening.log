    def test_only_the_terminal_guard_reads_a_person_in_the_whole_repository() -> None:
        """Every Python file outside tests/ (scripts, load_tools, tools, src, demo_only and anything else, root files
        included): the only one that may read a person is scripts/terminal_guard.py, whose question refuses a stdin that
        is not a terminal. A new question anywhere else fails here: route it through ask_to_start. A module or code
        chosen at run time cannot be checked: only src/lead_desk/loader.py does that (its names are fixed in the code:
