diff -ruN a/tests/test_r7u_b_findings.py b/tests/test_r7u_b_findings.py
--- a/tests/test_r7u_b_findings.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_r7u_b_findings.py	2026-11-14 16:25:42.553177761 +0000
@@ -0,0 +1,283 @@
+"""Round 7U, builder B: tests for the independent r7t review, findings m7 (the mail counter), m8 (the loopback table)
+and m5 (the weak counter test). Made-up data only, loopback only; no real service, no spend, no sleep, no real kill.
+
+Result on a plain copy of r7t: see out/R7U-B/RESULTS-B.md. FAILS = fails on the r7t sources. PIN = the r7t code was
+already right; the test passes on both and exists to kill a named mutant or to state a rule.
+
+  b7   m7  the mail counter is read with the checked reader: one unreadable counter file is "not known", never a
+           smaller number (FAILS: 4); a missing counter, a counter without `sent`, a readable counter (PIN)
+  b8   m8  an address the shared loopback rule accepts is not thereby a listener: the table says, for each of
+           LOCALHOST, [::1] and ::ffff:127.0.0.1, what the rule says and what a real bind did            (PIN, design)
+  b5   m5  a hidden contact AND a counter file that cannot be read (the case the r7t test
+           t9_a_counter_the_desk_could_not_write... does not reach)                    (PIN: r7t code is right)
+
+m8, stated as design (the rule is `lead_desk.config.is_loopback_host`, used through
+`demo_only.bad_request.require_loopback_host`): the rule answers ONE question, "is this name this computer?". The
+answer is yes for `localhost` in any letter case, for 127.x.x.x, for ::1 and for ::ffff:127.x.x.x (brackets allowed).
+`LOCALHOST` is accepted ON PURPOSE (host names are not case sensitive). The rule does NOT promise that a listener can
+be started on that spelling: the stand-in servers are IPv4 sockets (ThreadingHTTPServer, address family AF_INET), so
+`[::1]` passes the rule and then fails to bind. A bind that fails is a loud error at start, never a listener on
+another computer's interface, which is the only thing the rule guards. b8 pins each of the two answers separately.
+
+m7, stated honestly (the longer text is in RESULTS-B.md): `attempts` is written BEFORE the connection and `sent` AFTER
+the server's final reply (smtp_provider.send). A desk stopped hard between the server's reply and that write leaves a
+mail the desk's `sent` does not count; if the mailbox has not shown the mail yet either, both counters miss it. The
+floor F4 allows `leads + unknown`, and a lead that was in flight at the kill ends `unknown`, so one such mail per
+in-flight send is inside the allowance. `attempts` can bound the number of mails that could exist (a mail needs an
+attempt) but cannot prove that more mails exist than allowed (an attempt that failed before the network step is also
+counted), so it is not turned into a failing check; see RESULTS-B.md.
+"""
+
+from __future__ import annotations
+
+import json
+import socket
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import script_module
+
+rrc = script_module("run_real_check")
+
+DRY = ["--dry-fakes", "--assume-yes", "--cleanup"]
+
+
+# -- b7 (m7): the mail counter ---------------------------------------------------------------------------------------
+
+
+def _capture_results(monkeypatch: pytest.MonkeyPatch) -> list[dict[str, Any]]:
+    """Every payload handed to write_result, copied at that moment (the file holds exactly this)."""
+    real = rrc.write_result
+    seen: list[dict[str, Any]] = []
+
+    def spy(out: Path, payload: dict[str, Any]) -> bool:
+        seen.append(json.loads(json.dumps(payload, default=str)))
+        return real(out, payload)
+
+    monkeypatch.setattr(rrc, "write_result", spy)
+    return seen
+
+
+def _change_smtp_read(monkeypatch: pytest.MonkeyPatch, change: Any) -> list[Any]:
+    """Wrap the checked reader: the mail counter (.smtp.json) read is passed through `change(read)`; every other read
+    (the HubSpot counter) is the real one. Returns the list of the real reads of the mail counter."""
+    real = rrc.read_counter_files_checked
+    reads: list[Any] = []
+
+    def reader(run_dir: Path, suffix: str, tag: str) -> Any:
+        read = real(run_dir, suffix, tag)
+        if suffix != ".smtp.json":
+            return read
+        reads.append(read)
+        return change(read)
+
+    monkeypatch.setattr(rrc, "read_counter_files_checked", reader)
+    return reads
+
+
+def _f4(payload: dict[str, Any]) -> dict[str, Any]:
+    return next(c for c in payload["checks"]["checks"] if c["id"] == "F4")
+
+
+def test_b7_a_run_with_a_readable_mail_counter_ends_with_zero(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Control: the real run, nothing changed. Also kills a change that makes the counter always unknown."""
+    seen = _capture_results(monkeypatch)
+    reads = _change_smtp_read(monkeypatch, lambda read: read)
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert code == 0, out[-1500:]
+    (payload,) = seen
+    assert payload["checks"]["ok"] is True and _f4(payload)["ok"] is True
+    assert reads and reads[0].files >= 1 and reads[0].unreadable == 0 and "sent" in reads[0].totals, reads
+
+
+def test_b7_one_unreadable_mail_counter_file_is_not_a_smaller_number_it_fails_closed(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """One of the desks' mail counter files cannot be read, the other one gave a number. r7t summed what it could read
+    (a smaller number than the truth) and floor F4 could hold with a mail missing from it. Now: the mail count is not
+    known, F4 fails, the result is not ok and the exit code is not 0."""
+    from dataclasses import replace
+
+    seen = _capture_results(monkeypatch)
+    _change_smtp_read(monkeypatch, lambda read: replace(read, files=read.files + 1, unreadable=read.unreadable + 1))
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED, out[-1500:]
+    (payload,) = seen
+    assert payload["checks"]["ok"] is False and _f4(payload)["ok"] is False, _f4(payload)
+
+
+def test_b7_a_real_mail_counter_file_cut_in_half_fails_closed(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The same with the real file: the first desk's mail counter file is cut after the desks stopped (a write that
+    did not finish) and read with the real reader. The other desk's file still holds a number."""
+    seen = _capture_results(monkeypatch)
+    real = rrc.read_counter_files_checked
+    files_seen: list[int] = []
+
+    def reader(run_dir: Path, suffix: str, tag: str) -> Any:
+        if suffix == ".smtp.json":
+            files = sorted(run_dir.glob(f"desk-{tag}-*{suffix}"))
+            files_seen.append(len(files))
+            files[0].write_text(files[0].read_text(encoding="utf-8")[:9], encoding="utf-8")  # '{"attemp'
+        return real(run_dir, suffix, tag)
+
+    monkeypatch.setattr(rrc, "read_counter_files_checked", reader)
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert files_seen and files_seen[0] >= 1, files_seen
+    assert code == rrc.EXIT_FAILED, out[-1500:]
+    (payload,) = seen
+    assert payload["checks"]["ok"] is False and _f4(payload)["ok"] is False
+
+
+@pytest.mark.parametrize(
+    "make",
+    [
+        lambda read: rrc.CounterRead({}, 0, 0),  # no file at all
+        lambda read: rrc.CounterRead({"attempts": 3}, 1, 0),  # a file without the number of sent mails
+        lambda read: rrc.CounterRead({}, 1, 1),  # one file, unreadable
+    ],
+    ids=["no-file", "no-sent-number", "only-unreadable"],
+)
+def test_b7_a_missing_or_incomplete_mail_counter_fails_closed(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, make: Any
+) -> None:
+    """PIN: r7t already failed here (floor F4 reads `sent` as None and fails). Kept so that a change which makes a
+    missing counter read as 0 is caught."""
+    seen = _capture_results(monkeypatch)
+    _change_smtp_read(monkeypatch, make)
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED, out[-1500:]
+    (payload,) = seen
+    assert payload["checks"]["ok"] is False and _f4(payload)["ok"] is False
+
+
+def test_b7_the_mail_counter_rule_needs_a_file_no_unreadable_file_and_the_sent_number() -> None:
+    known = rrc.smtp_counter_is_known
+    assert known(rrc.CounterRead({"sent": 0, "attempts": 0}, 1, 0)) is True
+    assert known(rrc.CounterRead({"sent": 7}, 2, 0)) is True
+    assert known(rrc.CounterRead({"attempts": 3}, 1, 0)) is False  # no number of sent mails
+    assert known(rrc.CounterRead({"sent": 3}, 0, 0)) is False  # no file found
+    assert known(rrc.CounterRead({"sent": 3}, 2, 1)) is False  # one file of two cannot be read
+    assert known(rrc.CounterRead({}, 0, 0)) is False
+
+
+def test_b7_the_run_says_in_words_that_the_mail_count_is_not_known(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    _change_smtp_read(monkeypatch, lambda read: rrc.CounterRead(read.totals, read.files + 1, 1))
+    rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert "mail counter cannot be trusted" in out, out[-2500:]
+
+
+# -- b8 (m8): accepted by the rule is not the same as bound and listening --------------------------------------------
+
+
+def _bound_address(host: str) -> tuple[str, int] | None:
+    """The address a real stand-in server got for `host`, or None if the bind failed with an OSError (a name the
+    system cannot resolve for an IPv4 socket). Closed again at once."""
+    from demo_only.fakes_server import make_fakes_server
+
+    try:
+        srv = make_fakes_server(host=host)
+    except OSError:  # includes socket.gaierror
+        return None
+    try:
+        addr = srv.server_address
+        return str(addr[0]), int(addr[1])
+    finally:
+        srv.server_close()
+
+
+def test_b8_the_rule_accepts_these_spellings_by_design_and_a_bind_is_a_separate_fact() -> None:
+    """The table. For each spelling: what the shared rule says (a yes for all three) and what a real bind of the
+    stand-in server did (measured here, on this computer: see the expected column)."""
+    from demo_only.bad_request import require_loopback_host
+
+    # (spelling, rule accepts, a real bind works, the address it got when it works)
+    expected: list[tuple[str, bool, bool, str | None]] = [
+        ("LOCALHOST", True, True, "127.0.0.1"),  # accepted ON PURPOSE; resolves to the IPv4 loopback address
+        ("[::1]", True, False, None),  # accepted, but an IPv4 socket cannot be bound to it: not a listener
+        ("::ffff:127.0.0.1", True, True, "127.0.0.1"),  # accepted; the system reads it as the IPv4 address
+    ]
+    table = []
+    for host, rule_yes, bind_ok, address in expected:
+        assert require_loopback_host(host) == host, host  # the rule says yes (returns the host unchanged)
+        got = _bound_address(host)
+        table.append((host, rule_yes, got is not None, None if got is None else got[0]))
+        if got is not None:
+            assert got[1] > 0 and socket.inet_aton(got[0]) == socket.inet_aton("127.0.0.1"), (host, got)
+    assert table == [(h, r, b, a) for h, r, b, a in expected], table
+
+
+@pytest.mark.parametrize("host", ["LOCALHOST", "[::1]", "::ffff:127.0.0.1"])
+def test_b8_whatever_the_bind_does_it_never_listens_beyond_this_computer(host: str) -> None:
+    """The one thing the rule guards. A bind that works is on 127.x; a bind that does not work raises (a start that
+    fails loudly), it never ends on another address."""
+    got = _bound_address(host)
+    assert got is None or got[0].startswith("127."), (host, got)
+
+
+# -- b5 (m5): a hidden contact AND an unreadable counter file --------------------------------------------------------
+
+
+def _cut_hubspot_counters(monkeypatch: pytest.MonkeyPatch) -> list[int]:
+    """Cut the first HubSpot counter file of the run in half at the moment the run reads it (the contacts and the
+    counter were really written by the real desk processes before). Returns the `created` numbers that were in the
+    file before it was cut, so the test can show that contacts really existed."""
+    real = rrc.read_counter_files_checked
+    before: list[int] = []
+
+    def reader(run_dir: Path, suffix: str, tag: str) -> Any:
+        if suffix == ".hubspot.json":
+            files = sorted(run_dir.glob(f"desk-{tag}-*{suffix}"))
+            before.append(real(run_dir, suffix, tag).totals.get("created", 0))
+            if files:
+                text = files[0].read_text(encoding="utf-8")
+                files[0].write_text(text[: max(1, len(text) // 2)], encoding="utf-8")
+        return real(run_dir, suffix, tag)
+
+    monkeypatch.setattr(rrc, "read_counter_files_checked", reader)
+    return before
+
+
+def test_b5_control_a_hidden_contact_with_a_readable_counter_is_reported(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The hidden contact of the test below is real: with an intact counter the run reports it."""
+    from test_r7t_findings import _hiding_crm
+
+    monkeypatch.setattr(rrc, "HubspotCrm", _hiding_crm(1))
+    monkeypatch.setattr(rrc, "floor_checks", lambda *_a, **_k: [])
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert "may be left in HubSpot" in out and "counter cannot be trusted" not in out, out[-2000:]
+    assert code == rrc.EXIT_FAILED, out[-2000:]
+
+
+def test_b5_a_hidden_contact_and_a_counter_file_that_cannot_be_read_ends_as_failed(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """What the r7t test t9_a_counter_the_desk_could_not_write_ends_the_real_run_as_failed says it tests and does not:
+    there the desk's counter write failed BEFORE any create (the create is stopped, nothing exists, nothing is hidden).
+    Here the contacts and the counter exist; then the counter file is cut. The run must say the counter cannot be
+    trusted and end failed. (PIN: the r7t code already does; the test is not vacuous because the contacts exist
+    (`created` read before the cut is at least 1) and the control above shows the hidden contact is reported.)"""
+    from test_r7t_findings import _hiding_crm
+
+    monkeypatch.setattr(rrc, "HubspotCrm", _hiding_crm(1))
+    monkeypatch.setattr(rrc, "floor_checks", lambda *_a, **_k: [])
+    created_before = _cut_hubspot_counters(monkeypatch)
+    code = rrc.main(DRY)
+    out = capsys.readouterr().out
+    assert created_before and created_before[0] >= 1, created_before
+    assert "counter cannot be trusted" in out, out[-2000:]
+    assert code == rrc.EXIT_FAILED, out[-2000:]
