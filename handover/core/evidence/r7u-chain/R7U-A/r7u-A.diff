--- a/tests/test_r7u_a_findings.py	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/test_r7u_a_findings.py	2026-11-14 16:44:06.328486723 +0000
@@ -0,0 +1,454 @@
+"""Round 7U, builder A: tests for the independent r7t review findings M1 (the cap hid a contact), m1 (an over-count that
+is stated and pinned), m2 (counter values), m3 (the saved result and the table) and m4 (the read-back-failed note).
+Made-up data only, loopback only; no real service, no spend, no sleep, no real kill.
+
+Result on a plain copy of r7t: see out/R7U-A/RESULTS-A.md. FAILS = fails on the r7t sources. PIN = the r7t code was
+already right; the test passes on both and exists to state a rule or to kill a named mutant.
+
+  a1   M1  `created` is never capped, only the open part is; public function, brute-force oracle, main-level exit
+           code and message for an out-of-book contact and for a duplicate create under list lag                 FAILS
+  a1b  m1  a create that ended unknown and was retried by another desk process is an over-count by one in the SAFE
+           direction, and only when some lead has no contact; with every lead holding its contact: exit 0       PIN
+  a2   m2  counter values: only a whole number from 0 (type int); ArithmeticError is an unreadable file          FAILS
+  a3   m3  counter_known and unseen_contacts are in the result BEFORE it is written; no "ALL CHECKS HOLD" and no
+           ok: true when the counter is unknown or contacts are unaccounted for                                 FAILS
+  a4   m4  the read-back-failed note uses the checked reader and shows open and unknown creates                 FAILS
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import script_module
+
+rrc = script_module("run_real_check")
+
+
+def _stats(path: Path) -> dict[str, int]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+# -- a1 (M1): the counting rule ---------------------------------------------------------------------------------------
+
+
+def _oracle(created: int, accounted: int, open_creates: int, leads: int) -> int:
+    """Brute force, no formula: a lead makes at most one contact, so at most max(created, leads) contacts can exist
+    (`created` is a count of 201 replies and is what it is); each open create made a contact or did not. The most
+    contacts that can exist is the largest created + x (x = open creates that made one) within that bound."""
+    bound = max(created, leads)
+    most = max(created + x for x in range(max(0, open_creates) + 1) if created + x <= bound)
+    return max(0, most - accounted)
+
+
+@pytest.mark.parametrize("n", [1, 2, 5, 9])
+def test_a1_one_more_created_than_leads_is_not_hidden_by_the_cap(n: int) -> None:
+    f = rrc.contacts_not_accounted_for
+    assert f(n + 1, n, 0, n) == 1  # r7t: min(n+1, n) - n = 0, a contact left and exit 0
+    assert f(n + 2, n, 0, n) == 2
+    assert f(n + 1, n, 1, n) == 1  # an open create on top does not add to a count that is already over the book
+    assert f(n + 1, 0, 0, n) == n + 1
+    assert f(n + 1, n + 1, 0, n) == 0  # every created contact shown: nothing is missing
+
+
+def test_a1_the_rule_equals_the_brute_force_oracle_on_every_small_input() -> None:
+    f = rrc.contacts_not_accounted_for
+    for created in range(0, 8):
+        for accounted in range(0, 9):
+            for open_creates in range(-1, 8):
+                for leads in range(0, 9):
+                    assert f(created, accounted, open_creates, leads) == _oracle(
+                        created, accounted, open_creates, leads
+                    ), (created, accounted, open_creates, leads)
+
+
+def test_a1_named_values_of_the_rule() -> None:
+    f = rrc.contacts_not_accounted_for
+    assert f(9, 9, 5, 9) == 0  # open creates retried by the next desk: only 9 leads
+    assert f(5, 5, 5, 9) == 4  # the open part is capped by the leads still without a created contact (9 - 5)
+    assert f(3, 3, 100, 5) == 2
+    assert f(3, 0, 100, 5) == 5
+    assert f(10, 0, 0, 9) == 10  # created is not capped
+    assert f(8, 8, 1, 9) == 1 and f(8, 9, 1, 9) == 0 and f(8, 8, 0, 9) == 0
+    assert f(9, 8, 1, 9) == 1
+    assert f(8, 4, -3, 9) == 4  # a negative open number never lowers the possible number
+    assert f(0, 0, 1, None) == 1  # no lead count given: created + open
+    assert f(12, 0, 3, None) == 15
+    assert f(2, 0, 0, 0) == 2  # an empty book: the created count still stands
+    assert f(0, 0, 4, 0) == 0  # an empty book allows no open create to have made a contact
+
+
+def _more_created(monkeypatch: pytest.MonkeyPatch, **more: int) -> None:
+    """The HubSpot counter of the real dry run reads higher by the given amounts (a contact made twice, or one the book
+    does not know)."""
+    real = rrc.read_counter_files_checked
+
+    def reader(run_dir: Path, suffix: str, tag: str) -> Any:
+        read = real(run_dir, suffix, tag)
+        if suffix != ".hubspot.json":
+            return read
+        totals = dict(read.totals)
+        for k, v in more.items():
+            totals[k] = totals.get(k, 0) + v
+        return rrc.CounterRead(totals, read.files, read.unreadable)
+
+    monkeypatch.setattr(rrc, "read_counter_files_checked", reader)
+
+
+def _hiding_crm(hidden: int, extra_rows: list[tuple[str, str]] | None = None) -> type:
+    class Hiding(rrc.HubspotCrm):
+        """A CRM whose LIST shows `hidden` contacts fewer than exist (list lag), and `extra_rows` more."""
+
+        def rows_with_prefix(self, prefix: str) -> list[tuple[str, str]]:
+            rows = super().rows_with_prefix(prefix)
+            return rows[: len(rows) - hidden] + list(extra_rows or [])
+
+    return Hiding
+
+
+def _quiet_floors(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Floor F3 (a lead marked CRM-done has a contact) is silent for these cases: only the counter rule can see them."""
+    monkeypatch.setattr(rrc, "floor_checks", lambda *_a, **_k: [])
+
+
+def test_a1_an_out_of_book_contact_ends_the_run_as_failed(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """One more contact was created than the book has leads: it carries an L id the book does not know, so the read-back
+    filter drops it and nothing archives it. r7s said 1; r7t said 0 (exit 0 with a contact left)."""
+    monkeypatch.setattr(rrc, "HubspotCrm", _hiding_crm(0, [("L-not-in-the-book", "999")]))
+    _quiet_floors(monkeypatch)
+    _more_created(monkeypatch, created=1)
+    code = rrc.main(["--dry-fakes", "--assume-yes", "--cleanup"])
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED and "1 contacts may be left" in out, out[-2000:]
+
+
+def test_a1_a_duplicate_create_under_list_lag_is_counted_whole(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """A lead got a second contact (one create too many) and the list hid one contact: two are not accounted for. r7t
+    said 1 (the cap cut the created number)."""
+    monkeypatch.setattr(rrc, "HubspotCrm", _hiding_crm(1))
+    _quiet_floors(monkeypatch)
+    _more_created(monkeypatch, created=1)
+    code = rrc.main(["--dry-fakes", "--assume-yes", "--cleanup"])
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED and "2 contacts may be left" in out, out[-2000:]
+
+
+# -- a1b (m1): a create that ended unknown and was retried -----------------------------------------------------------
+#
+# The rule (also in the docstring of contacts_not_accounted_for): a lead makes at most one contact, so the open part is
+# capped by the leads that have no created contact yet (leads - created). The counters carry no lead ids, so desk 2's
+# 201 for the lead whose create desk 1 left unknown counts twice (created 1 + unknown 1). That is an over-count by one
+# in the SAFE direction (a false alarm, never a miss), and it shows only when some other lead has no contact; when every
+# lead holds its contact the cap absorbs it and nothing is reported.
+
+
+def test_a1b_a_retried_unknown_create_is_absorbed_when_every_lead_has_its_contact() -> None:
+    f = rrc.contacts_not_accounted_for
+    for n in (1, 2, 9):
+        assert f(n, n, 1, n) == 0  # created n (one of them the retry) + unknown 1: capped by n leads
+        assert f(n, n, n, n) == 0  # every create unknown once and retried once: still nothing left
+    assert f(1, 1, 1, 2) == 1  # the stated residual: a lead with no contact makes the retry count visible (safe side)
+
+
+def test_a1b_the_over_count_is_never_a_false_alarm_when_the_list_shows_every_contact(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Main-level: the counter says one create ended unknown and was retried (created N + unknown 1), every contact is
+    in the list: exit 0 and no message about contacts left."""
+    seen = _capture_results(monkeypatch)
+    _more_created(monkeypatch, create_unknown=1)
+    code = rrc.main(["--dry-fakes", "--assume-yes", "--cleanup"])
+    out = capsys.readouterr().out
+    assert code == 0 and "may be left in HubSpot" not in out, out[-2000:]
+    assert seen[-1]["summary"]["unseen_contacts"] == 0
+
+
+def test_a1b_a_retry_in_another_desk_process_counts_twice_in_the_safe_direction(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """PIN with the real adapter: desk 1's create for lead L-1 ended unknown (nothing stored), desk 2's retry got a 201.
+    One contact exists; the sum of the counters says created 1 + unknown 1."""
+    from test_crm_hubspot import REC, Rig
+
+    from lead_desk.crm_hubspot import CrmError, HubspotCrm
+
+    rig = Rig(tmp_path)
+    try:
+        crm1 = rig.crm(stats_file=tmp_path / "desk-rabcdef-1.hubspot.json")
+        crm2 = rig.crm(stats_file=tmp_path / "desk-rabcdef-2.hubspot.json")
+        real = HubspotCrm._once
+        calls: list[int] = []
+
+        def once(self: Any, method: str, path: str, obj: Any, deadline: float, key: str) -> Any:
+            calls.append(1)
+            if len(calls) == 1:
+                raise CrmError("connection dropped")  # nothing stored, the reply is lost
+            return real(self, method, path, obj, deadline, key)
+
+        monkeypatch.setattr(HubspotCrm, "_once", once)
+        with pytest.raises(CrmError):
+            crm1.put("L-1", REC)
+        crm2.put("L-1", REC)
+        read = rrc.read_counter_files_checked(tmp_path, ".hubspot.json", "rabcdef")
+        assert (read.totals["created"], read.totals["create_unknown"]) == (1, 1), read.totals
+        assert len(rig.state.contacts) == 1
+        f = rrc.contacts_not_accounted_for
+        assert f(1, 1, 1, 1) == 0  # one lead, one contact shown: no false alarm
+        assert f(1, 1, 1, 2) == 1  # two leads, the second without a contact: reported (over-count, safe side)
+    finally:
+        rig.stop()
+
+
+@pytest.mark.parametrize("key", ["create_open", "create_unknown"])
+def test_a1c_a_create_with_no_known_outcome_counts_as_a_possible_contact_at_main_level(
+    capsys: pytest.CaptureFixture[str], monkeypatch: pytest.MonkeyPatch, key: str
+) -> None:
+    """A create was sent and its count was lost (created one lower), the outcome is open or unknown, and the list hides
+    one contact: the open part (capped by the leads still without a created contact) makes it one possible contact."""
+    monkeypatch.setattr(rrc, "HubspotCrm", _hiding_crm(1))
+    _quiet_floors(monkeypatch)
+    _more_created(monkeypatch, created=-1, **{key: 1})
+    code = rrc.main(["--dry-fakes", "--assume-yes", "--cleanup"])
+    out = capsys.readouterr().out
+    assert code == rrc.EXIT_FAILED and "1 contacts may be left" in out, out[-2000:]
+
+
+# -- a2 (m2): counter values ------------------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "value",
+    ["1e999", "-1", "0.9", "1.0", "true", "false", '"5"', "null", "[1]", "{}", "-1e999"],
+    ids=lambda v: v[:12],
+)
+def test_a2_a_counter_value_that_is_not_a_whole_number_from_zero_is_unreadable(tmp_path: Path, value: str) -> None:
+    (tmp_path / "desk-raaaaaa-1.hubspot.json").write_text('{"created": ' + value + "}", encoding="utf-8")
+    read = rrc.read_counter_files_checked(tmp_path, ".hubspot.json", "raaaaaa")
+    assert (read.files, read.unreadable) == (1, 1) and not rrc.counter_is_known(read)
+    assert read.totals == {}  # the file is taken whole or not at all
+
+
+def test_a2_whole_numbers_from_zero_are_read(tmp_path: Path) -> None:
+    (tmp_path / "desk-raaaaaa-1.hubspot.json").write_text('{"created": 0, "calls": 3, "big": 12345678901234567890}')
+    read = rrc.read_counter_files_checked(tmp_path, ".hubspot.json", "raaaaaa")
+    assert read.totals == {"created": 0, "calls": 3, "big": 12345678901234567890}
+    assert (read.files, read.unreadable) == (1, 0) and rrc.counter_is_known(read)
+
+
+def test_a2_one_bad_value_makes_the_whole_file_unreadable_and_adds_nothing(tmp_path: Path) -> None:
+    (tmp_path / "desk-raaaaaa-1.hubspot.json").write_text('{"calls": 3, "created": -2}', encoding="utf-8")
+    (tmp_path / "desk-raaaaaa-2.hubspot.json").write_text('{"calls": 4, "created": 2}', encoding="utf-8")
+    read = rrc.read_counter_files_checked(tmp_path, ".hubspot.json", "raaaaaa")
+    assert (read.totals, read.files, read.unreadable) == ({"calls": 4, "created": 2}, 2, 1)
+    assert not rrc.counter_is_known(read)
+
+
+@pytest.mark.parametrize("error", [OverflowError("x"), ZeroDivisionError("x"), ArithmeticError("x")], ids=repr)
+def test_a2_an_arithmetic_error_while_reading_is_an_unreadable_file_never_a_crash(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, error: ArithmeticError
+) -> None:
+    (tmp_path / "desk-raaaaaa-1.hubspot.json").write_text('{"created": 1}', encoding="utf-8")
+
+    def raising(*_a: Any, **_k: Any) -> Any:
