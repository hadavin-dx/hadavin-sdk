+def _plant(tmp_path: Path, source: str, folder: str = "scripts") -> Path:
+    for name in GUARDED_FOLDERS:
+        (tmp_path / name).mkdir(parents=True, exist_ok=True)
+    (tmp_path / folder / "planted.py").write_text(source + "\n", encoding="utf-8")
+    return tmp_path
+
