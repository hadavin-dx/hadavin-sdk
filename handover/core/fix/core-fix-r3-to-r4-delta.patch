+def test_the_guard_finds_each_planted_shape_on_its_own(tmp_path_factory: object) -> None:
+    missed = []
+    for shape, source in PLANTED.items():
+        root = _plant(tmp_path_factory.mktemp("shape"), source)  # type: ignore[attr-defined]
+        found = [p for p in _problems(root, {}, {}) if p.startswith("scripts/planted.py")]
+        if not found:
+            missed.append(shape)
+    assert not missed, f"the guard did not find: {missed}"
+
