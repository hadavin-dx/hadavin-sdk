+    "subprocess",
+    "shutil",
+    "fileinput",
+    "zipfile",
+    "tarfile",
+    "glob",
+    "importlib",
+    "tempfile",
+}
+# names of the form module.name that are hits (after alias resolution): the whole module, or the listed names
+HIT_QUALIFIED = {
