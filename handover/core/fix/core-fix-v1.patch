+# ---------------------------------------------------------------- the lead book itself
+@FIFO_SKIP
+@pytest.mark.parametrize("kind", KINDS)
+def test_the_desk_refuses_a_pipe_or_a_folder_as_its_lead_book_before_it_takes_the_lock(
+    tmp_path: Path, kind: str
+) -> None:
