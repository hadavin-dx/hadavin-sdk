+@FIFO_SKIP
+@pytest.mark.parametrize("flag", ["--call-log", "--key-file"])
+def test_fake_model_server_refuses_a_pipe_for_its_files_before_it_starts(tmp_path: Path, flag: str) -> None:
+    pytest.importorskip("demo_only.fake_model_server")
