+
+@FIFO_SKIP
+@pytest.mark.parametrize("kind", ["pipe", "link-to-pipe"])
+def test_scrub_catcher_and_burst_driver_refuse_a_pipe_as_their_output(tmp_path: Path, kind: str) -> None:
