+def require_verifying(ctx: ssl.SSLContext, setting_name: str) -> ssl.SSLContext:
+    """`ctx` itself when it checks the server's certificate chain AND its name (verify_mode CERT_REQUIRED and
+    check_hostname on); a CaFileRefused otherwise. Why: code that builds a sender or a mailbox reader may pass its own
+    context; one made with CERT_NONE (or without the name check) would send a mail login to anyone. No setting can
+    reach this path (a settings file only names a file of trusted certificates), so this guards code that builds the
+    classes itself."""
+    if ctx.verify_mode != ssl.CERT_REQUIRED or not ctx.check_hostname:
+        raise CaFileRefused(f"{setting_name}: the TLS context given does not check the server certificate and name")
+    return ctx
