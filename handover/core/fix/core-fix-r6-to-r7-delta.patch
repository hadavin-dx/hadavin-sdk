+def _raw(port: int, head: bytes, then: bytes = b"", wait: float = 0.0) -> bytes:
+    with socket.create_connection(("127.0.0.1", port), timeout=10) as s:
+        s.sendall(head)
+        if wait:
+            threading.Event().wait(wait)
+        if then:
+            s.sendall(then)
+        out = b""
+        while chunk := s.recv(4096):
+            out += chunk
+    return out
+
