--- tree-R6/tests/test_r7_class_names.py	1970-01-01 00:00:00.000000000 +0000
+++ tree-R7/tests/test_r7_class_names.py	2026-11-13 21:13:46.255591322 +0000
@@ -0,0 +1,141 @@
+"""F10 (round 7): where a class name of an error may be used. A name such as KeyError, URLError or a vendor's class
+tells a person nothing and may name a product or a place. Every use of `type(x).__name__` (and `x.__class__.__name__`,
+`__qualname__`) in scripts, tools, load_tools, demo_only and src is found by an ast walk and must be on the list below
+with its reason; a new use fails this test until someone writes the reason. The three uses that STORE a code for a
+person go through `error_code` (src/lead_desk/errcode.py)."""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+import pytest
+
+from lead_desk.errcode import error_code
+
+REPO = Path(__file__).resolve().parents[1]
+FOLDERS = ("scripts", "tools", "load_tools", "demo_only", "src")
+
+LOG = "operator log line: the class name only, never the text; the log is for the operator, not shown to a person"
+INNER = (
+    "the text of an adapter error (SendRefused, CrmError ...): it is never stored or printed; the desk records its own "
+    "fixed words (refused, unreachable, ambiguous) or error_code(); only the operator log may show it"
+)
+TRACE = (
+    "the operator timing file (stage, times, outcome): a class name, no text; read by the load tools, not by a person"
+)
+
+# file -> reason for every use in that file (the reason covers the file; the log/raise check below enforces the shape)
+ALLOWED = {
+    "src/lead_desk/desk.py": LOG,
+    "src/lead_desk/server.py": LOG,
+    "src/lead_desk/portal_api.py": LOG,
+    "src/lead_desk/trace.py": TRACE,
+    "src/lead_desk/smtp_provider.py": INNER,
+    "src/lead_desk/smtp_outbox.py": INNER,
+    "src/lead_desk/adapters.py": INNER,
+    "src/lead_desk/crm_hubspot.py": INNER,
+}
+SAFE_PARENTS = {"warning", "info", "error", "exception", "debug"}  # log.warning(...) and the like
+
+
+def _uses(path: Path) -> list[tuple[int, str]]:
+    """(line, kind) of every read of a class name (`type(x).__name__`): kind is "log", "raise", "assign" or "other"."""
+    tree = ast.parse(path.read_text(encoding="utf-8"))
+    parents = {id(c): n for n in ast.walk(tree) for c in ast.iter_child_nodes(n)}
+    found: list[tuple[int, str]] = []
+    for node in ast.walk(tree):
+        if not (isinstance(node, ast.Attribute) and node.attr in {"__name__", "__qualname__"}):
+            continue
+        inner = node.value
+        is_type_call = isinstance(inner, ast.Call) and isinstance(inner.func, ast.Name) and inner.func.id == "type"
+        is_class_attr = isinstance(inner, ast.Attribute) and inner.attr == "__class__"
+        if not (is_type_call or is_class_attr):
+            continue
+        up: ast.AST | None = parents.get(id(node))
+        kind = "other"
+        while up is not None:
+            if isinstance(up, ast.Call) and isinstance(up.func, ast.Attribute) and up.func.attr in SAFE_PARENTS:
+                kind = "log"
+                break
+            if isinstance(up, ast.Raise):
+                kind = "raise"
+                break
+            if isinstance(up, ast.Assign | ast.AnnAssign):
+                kind = "assign"
+                break
+            if isinstance(up, ast.JoinedStr | ast.FormattedValue | ast.Call | ast.Tuple | ast.Compare | ast.BoolOp):
+                up = parents.get(id(up))
+                continue
+            break
+        found.append((node.lineno, kind))
+    return found
+
+
+def _all_uses() -> dict[str, list[tuple[int, str]]]:
+    out: dict[str, list[tuple[int, str]]] = {}
+    for folder in FOLDERS:
+        for p in sorted((REPO / folder).rglob("*.py")):
+            if "__pycache__" in p.parts:
+                continue
+            uses = _uses(p)
+            if uses:
+                out[p.relative_to(REPO).as_posix()] = uses
+    return out
+
+
+def test_every_use_of_a_class_name_is_on_the_list_with_its_reason() -> None:
+    uses = _all_uses()
+    unknown = {f: u for f, u in uses.items() if f not in ALLOWED}
+    assert not unknown, f"a class name is used in a file with no written reason: {unknown}"
+    stale = [f for f in ALLOWED if f not in uses]
+    assert not stale, f"the list names files that no longer use a class name: {stale}"
+
+
+def test_the_shape_of_each_use_matches_its_reason() -> None:
+    """A log file may only log or raise an inner class name; the only "assign" is the trace outcome; nothing else."""
+    for f, uses in _all_uses().items():
+        for line, kind in uses:
+            if ALLOWED[f] == LOG:
+                assert kind == "log", f"{f}:{line} is a {kind} use in a file that is allowed to log only"
+            elif ALLOWED[f] == INNER:
+                assert kind == "raise", f"{f}:{line} is a {kind} use in a file that is allowed to raise only"
+            else:
+                assert (f, kind) == ("src/lead_desk/trace.py", "assign")
+
+
+def test_desk_log_files_keep_their_class_names_out_of_stored_text() -> None:
+    """Both files of the desk that LOG class names have no `internal:` code built from one: the stored codes use
+    error_code (the old shape f"internal:{type(e).__name__}" is gone)."""
+    for f in ("src/lead_desk/desk.py", "src/lead_desk/server.py"):
+        text = (REPO / f).read_text(encoding="utf-8")
+        assert 'f"internal:{type(' not in text and "internal:{type(" not in text
+    assert "error_code(" in (REPO / "src/lead_desk/desk.py").read_text(encoding="utf-8")
+
+
+class Mine(Exception):
+    __module__ = "lead_desk.somewhere"
+
+
+@pytest.mark.parametrize(
+    ("exc", "want"),
+    [
+        (KeyError("x"), "data"),
+        (ValueError("x"), "data"),
+        (LookupError("x"), "data"),
+        (IndexError("x"), "error"),  # a subclass of LookupError is NOT "data": the ranking pins the three exact classes
+        (OSError("x"), "error"),
+        (TimeoutError("x"), "error"),
+        (Mine("x"), "Mine"),
+    ],
+)
+def test_error_code_gives_the_class_name_only_for_this_package(exc: BaseException, want: str) -> None:
+    assert error_code(exc) == want
+
+
+def test_a_foreign_class_name_never_becomes_a_stored_code() -> None:
+    import http.client
+    import urllib.error
+
+    for exc in (urllib.error.URLError("secret-host.test"), http.client.IncompleteRead(b""), ConnectionResetError("p")):
+        assert error_code(exc) == "error"
diff -ruN '--exclude=__pycache__' '--exclude=.git' '--exclude=.ruff_cache' '--exclude=.pytest_cache' '--exclude=data' tree-R6/tests/test_r7_exit_codes.py tree-R7/tests/test_r7_exit_codes.py
--- tree-R6/tests/test_r7_exit_codes.py	1970-01-01 00:00:00.000000000 +0000
+++ tree-R7/tests/test_r7_exit_codes.py	2026-11-13 21:13:46.284391955 +0000
@@ -0,0 +1,251 @@
+"""Round 7: one test per exit site of scripts/n8n_api.py, each with the EXACT exit code, the one fixed line, and no
+traceback. The script runs as a real process against a scripted loopback n8n. Codes: 1 a check failed (n8n said
+no), 2 bad usage or a name that is not exactly one workflow, 3 n8n unreachable or answered something unusable,
+4 a setting or path that cannot be used."""
+
+from __future__ import annotations
+
+import json
+import os
+import threading
+from collections.abc import Iterator
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+
+import pytest
+from support import run_python
+
+from lead_desk import constants
+from lead_desk.constants import SCRIPT_REPLY_MAX_BYTES
+
+REPO = Path(__file__).resolve().parents[1]
+CANARY = "CANARY-" + "n8n-key-7f3a"
+SCRIPT = str(REPO / "scripts" / "n8n_api.py")
+
+
+class Scripted(ThreadingHTTPServer):
+    daemon_threads = True
+    status = 200
+    body = b"{}"
+
+
+class H(BaseHTTPRequestHandler):
+    def _go(self) -> None:
+        n = int(self.headers.get("Content-Length") or 0)
+        if n:
+            self.rfile.read(n)
+        self.send_response(self.server.status)
+        body: bytes = self.server.body
+        self.send_header("Content-Length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    do_GET = do_POST = _go
+
+    def log_message(self, *args: object) -> None:
+        pass
+
+
+@pytest.fixture
+def n8n() -> Iterator[Scripted]:
+    srv = Scripted(("127.0.0.1", 0), H)
+    th = threading.Thread(target=srv.serve_forever, daemon=True)
+    th.start()
+    yield srv
+    srv.shutdown()
+    srv.server_close()
+    th.join(5)
+
+
+def run(
+    tmp_path: Path, *args: str, url: str | None = None, key: str | None = "k-" + CANARY, **env: str
+) -> tuple[int, str, str]:
+    keyfile = tmp_path / "key.txt"
+    environ = {
+        "PATH": os.environ.get("PATH", ""),
+        "PYTHONPATH": str(REPO / "src"),
+        "LEAD_DESK_PATH_ROOTS": str(tmp_path),
+    }
+    if key is not None:
+        keyfile.write_text(key + "\n", encoding="utf-8")
+        environ["N8N_API_KEY_FILE"] = str(keyfile)
+    if url is not None:
+        environ["N8N_URL"] = url
+    environ.update(env)
+    done = run_python([SCRIPT, *args], environ, tmp_path)
+    return done.returncode, done.stdout, done.stderr
+
+
+def clean(rc_out_err: tuple[int, str, str]) -> None:
+    _, out, err = rc_out_err
+    assert "Traceback" not in out + err and CANARY not in out + err
+    assert "Error" not in (out + err).replace("MaxRetryError", "")  # no Python class name reaches a person
+    assert len((out + err).strip().splitlines()) <= 1
+
+
+def scripted(srv: Scripted, status: int, body: bytes) -> str:
+    srv.status, srv.body = status, body
+    return f"http://127.0.0.1:{srv.server_address[1]}"
+
+
+# -- 2: bad usage, a name that is not exactly one workflow ----------
+
+
+@pytest.mark.parametrize("args", [(), ("frob",), ("import",), ("activate",), ("deactivate",)])
+def test_bad_usage_is_exit_2_before_the_key_or_the_address_is_looked_at(tmp_path: Path, args: tuple[str, ...]) -> None:
+    got = run(tmp_path, *args, url="http://example.test:1", key=None)  # a bad address and no key: usage still wins
+    assert got[0] == constants.EXIT_REFUSED == 2 and got[2].startswith("usage:")
+    clean(got)
+
+
+@pytest.mark.parametrize("data", [[], [{"name": "a", "id": 1, "active": False}] * 2])
+def test_a_name_that_matches_none_or_two_workflows_is_exit_2(tmp_path: Path, n8n: Scripted, data: list[object]) -> None:
+    url = scripted(n8n, 200, json.dumps({"data": data}).encode())
+    got = run(tmp_path, "activate", "wanted", url=url)
+    assert got[0] == 2 and "exactly one is needed" in got[2]
+    clean(got)
+
+
+# -- 4: a setting or path that cannot be used ----------
+
+
+@pytest.mark.parametrize(
+    "url", ["http://example.test:9", "ftp://127.0.0.1", "http://user@127.0.0.1:1", "http://127.0.0.1:99999"]
+)
+def test_a_bad_n8n_address_is_exit_4(tmp_path: Path, url: str) -> None:
+    got = run(tmp_path, "list", url=url)
+    assert got[0] == constants.EXIT_BAD_SETTING_OR_PATH == 4
+    clean(got)
+
+
+def test_a_missing_key_setting_is_exit_4(tmp_path: Path) -> None:
+    got = run(tmp_path, "list", url="http://127.0.0.1:1", key=None)
+    assert got[0] == 4 and "N8N_API_KEY_FILE" in got[2]
+    clean(got)
+
+
+@pytest.mark.parametrize("key", ["short", "has space in it", "kéy-with-non-ascii-1234"])
+def test_a_key_file_that_is_not_one_plain_word_is_exit_4(tmp_path: Path, key: str) -> None:
+    got = run(tmp_path, "list", url="http://127.0.0.1:1", key=key)
+    assert got[0] == 4
+    clean(got)
+
+
+def test_a_workflow_file_that_is_missing_or_not_json_is_exit_4(tmp_path: Path, n8n: Scripted) -> None:
+    url = scripted(n8n, 200, b"{}")
+    assert run(tmp_path, "import", str(tmp_path / "nope.json"), url=url)[0] == 4
+    bad = tmp_path / "bad.json"
+    bad.write_text("not json", encoding="utf-8")
+    got = run(tmp_path, "import", str(bad), url=url)
+    assert got[0] == 4 and "cannot read a workflow" in got[2]
+
+
+def test_a_body_that_cannot_be_encoded_is_exit_4(tmp_path: Path) -> None:
+    """A file cannot reach this refusal (json.dumps escapes a lone surrogate), so call() is driven directly with a
+    body that json.dumps cannot encode (a list that contains itself)."""
+    keyfile = tmp_path / "key.txt"
+    keyfile.write_text("k-" + CANARY + "\n", encoding="utf-8")
+    code = (
+        "import sys; sys.path.insert(0, %r); import n8n_api; b = []; b.append(b); n8n_api.call('POST', '/workflows', b)"
+        % str(REPO / "scripts")
+    )
+    environ = {
+        "PATH": os.environ.get("PATH", ""),
+        "PYTHONPATH": str(REPO / "src") + os.pathsep + str(REPO),
+        "N8N_API_KEY_FILE": str(keyfile),
+        "LEAD_DESK_PATH_ROOTS": str(tmp_path),
+        "N8N_URL": "http://127.0.0.1:1",
+    }
+    done = run_python(["-c", code], environ, tmp_path)
+    assert done.returncode == 4 and "cannot encode the workflow as JSON" in done.stderr
+    assert "Traceback" not in done.stderr and CANARY not in done.stderr
+
+
+# -- 3: n8n cannot be reached, or answered something unusable ----------
+
+
+def test_nothing_listening_is_exit_3(tmp_path: Path) -> None:
+    got = run(tmp_path, "list", url="http://127.0.0.1:1")
+    assert got[0] == constants.EXIT_UNREACHABLE == 3
+    clean(got)
+
+
+@pytest.mark.parametrize(
+    ("status", "body", "words"),
+    [
+        (200, b"<html>not json</html>", "not JSON"),
+        (200, b"[" * 100_000, "nested too deeply"),
+        (200, b" " * (SCRIPT_REPLY_MAX_BYTES + 2), "too big"),
+        (500, b"{}", "answered 500 to the workflow list"),
+        (401, b'{"message":"x"}', "answered 401 to the workflow list"),
+        (200, b'{"nodata": []}', "unexpected body"),
+        (200, b'{"data": [3]}', "an entry without name"),
+        (200, b'{"data": [{"name": 5, "id": 1, "active": true}]}', "an entry without name"),
+    ],
