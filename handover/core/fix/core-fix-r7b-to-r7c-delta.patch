diff --git a/b/tests/tree_guard.py b/tests/tree_guard.py
new file mode 100644
index 0000000..42689e2
--- /dev/null
+++ b/tests/tree_guard.py
@@ -0,0 +1,68 @@
+"""The clean-tree guard of the test run: what the repository folder looked like before, and what changed.
+
+A test run must leave the repository folder as it found it. EVERYTHING is compared (files, folders also when empty,
+links, sizes and change times), except the short list below. Nothing else is hidden: `node_modules` and any other
+folder are compared like all the others.
+
+The list (each entry has its reason; adding one needs a reason here):
+- the contents of `.git/` (git changes its own files while tests call git; the folder itself is still compared);
+- a file ending in `.pyc` inside a folder named `__pycache__` (the interpreter writes these by itself; any OTHER file
+  in such a folder is a change);
+- the tool caches `.pytest_cache`, `.ruff_cache` and `.mypy_cache` (their tool writes them; a run may be started
+  without `-p no:cacheprovider`);
+- the coverage outputs `.coverage`, `.coverage.*` and `coverage.xml` (written by pytest-cov when a run asks for it)."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+
+GIT_FOLDER = ".git"
+TOOL_CACHES = frozenset({".pytest_cache", ".ruff_cache", ".mypy_cache"})
+COVERAGE_FILES = frozenset({".coverage", "coverage.xml"})
+PYCACHE = "__pycache__"
+
+Entry = tuple[str, int, int]  # (kind, size, modification time in ns); a folder is ("dir", 0, 0)
+
+
+def _ignored_file(parent_name: str, name: str) -> bool:
+    return (parent_name == PYCACHE and name.endswith(".pyc")) or name in COVERAGE_FILES or name.startswith(".coverage.")
+
+
+def snapshot(root: Path) -> dict[str, Entry]:
+    """Every entry under `root`: relative name -> (kind, size, modification time in ns)."""
+    found: dict[str, Entry] = {}
+    for folder, names, files in os.walk(root, followlinks=False):
+        here = Path(folder)
+        names[:] = sorted(n for n in names if n not in TOOL_CACHES)
+        for n in list(names):
+            full = here / n
+            rel = str(full.relative_to(root))
+            if full.is_symlink():  # a link to a folder is one entry, never followed
+                found[rel] = ("link", 0, 0)
+                names.remove(n)
+            else:
+                found[rel] = ("dir", 0, 0)
+                if n == GIT_FOLDER:
+                    names.remove(n)  # the folder itself is compared; its insides are the one skipped thing
+        for name in files:
+            if _ignored_file(here.name, name):
+                continue
+            full = here / name
+            try:
+                st = full.lstat()
+            except OSError:
+                continue
+            kind = "link" if full.is_symlink() else "file"
+            # wall-clock: the file change time, not a duration
+            found[str(full.relative_to(root))] = (kind, st.st_size, st.st_mtime_ns)
+    # a `__pycache__` folder that holds only ignored files was made by the interpreter: not a change by itself
+    for rel in [r for r, e in found.items() if e[0] == "dir" and Path(r).name == PYCACHE]:
+        if not any(r.startswith(rel + os.sep) for r in found):
+            del found[rel]
+    return found
+
+
+def changes(before: dict[str, Entry], after: dict[str, Entry]) -> list[str]:
+    """The names that appeared, vanished or changed, sorted."""
+    return sorted(k for k in set(before) | set(after) if before.get(k) != after.get(k))
