+        self._owner = owner
+        self._buf = bytearray()
+        self._eof = False
+
+    def _fill(self) -> None:
+        o = self._owner
+        left = o.deadline - time.monotonic()
+        if left <= 0:
+            raise ImapTotalTimeout(_TOTAL_TEXT)
+        o.sock.settimeout(min(o.step_seconds, left))
+        try:
+            piece = o.sock.recv(_RECV_PIECE)
+        except TimeoutError:
+            if time.monotonic() >= o.deadline:
+                raise ImapTotalTimeout(_TOTAL_TEXT) from None
+            raise
+        if not piece:
+            self._eof = True
+        self._buf += piece
+
+    def read(self, size: int = -1) -> bytes:
+        while not self._eof and (size < 0 or len(self._buf) < size):
+            self._fill()
+        n = len(self._buf) if size < 0 else min(size, len(self._buf))
+        out = bytes(self._buf[:n])
+        del self._buf[:n]
+        return out
+
+    def readline(self, limit: int = -1) -> bytes:
+        while True:
+            i = self._buf.find(b"\n")
+            if i >= 0:
+                end = i + 1
+                break
+            if (limit >= 0 and len(self._buf) >= limit) or self._eof:
+                end = len(self._buf)
+                break
+            self._fill()
+        if limit >= 0:
+            end = min(end, limit)
+        out = bytes(self._buf[:end])
+        del self._buf[:end]
+        return out
+
+    def close(self) -> None:
+        self._buf.clear()
