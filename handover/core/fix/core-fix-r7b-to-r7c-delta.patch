diff --git a/b/tests/test_r7c_program_helper_rejects.py b/tests/test_r7c_program_helper_rejects.py
new file mode 100644
index 0000000..29b6514
--- /dev/null
+++ b/tests/test_r7c_program_helper_rejects.py
@@ -0,0 +1,118 @@
+"""Round 7C, finding B: `checked_argv` / `popen_program` refuse what their docstring says they refuse.
+
+Found by the review of r7b: `git -ccore.pager=x` and `--config-env` were accepted, the keywords `executable=` and
+`shell=` were passed through, a path-prefixed look-alike (`/tmp/x/git`) passed on its basename, and the scan "no other
+file starts a program" missed `from subprocess import run`. Rejected samples first, then the allowed shapes."""
+
+from __future__ import annotations
+
+import ast
+import stat
+from pathlib import Path
+
+import pytest
+from support import RefusedProgram, checked_argv, popen_program
+
+HERE = Path(__file__).resolve().parent
+
+
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["git", "-ccore.pager=x", "log"],
+        ["git", "-c", "core.pager=x", "log"],
+        ["git", "-c", "alias.x=!id", "x"],
+        ["git", "--config-env=core.pager=X", "log"],
+        ["git", "--config-env", "core.pager=X", "log"],
+        ["git", "--exec-path=/" + "tmp/x", "log"],
+        ["git", "-C", ".", "-ccore.sshCommand=id", "fetch"],
+    ],
+)
+def test_git_settings_that_run_a_program_are_refused(argv: list[str]) -> None:
+    with pytest.raises(RefusedProgram):
+        checked_argv(argv)
+
+
+def test_git_user_settings_and_plain_commands_are_allowed() -> None:
+    assert checked_argv(["git", "-c", "user.name=a", "-c", "user.email=a@example.test", "log"])
+    assert checked_argv(["git", "-cuser.name=a", "log"])
+    assert checked_argv(["git", "-C", ".", "status", "--short"])
+
+
+def test_a_path_prefixed_look_alike_of_a_listed_tool_is_refused(tmp_path: Path) -> None:
+    fake = tmp_path / "git"
+    fake.write_text("#!/bin/sh\necho X\n", encoding="utf-8")
+    fake.chmod(fake.stat().st_mode | stat.S_IXUSR)
+    for name in ("git", "true", "ps"):
+        look_alike = tmp_path / name
+        look_alike.write_text("#!/bin/sh\necho X\n", encoding="utf-8")
+        with pytest.raises(RefusedProgram):
+            checked_argv([str(look_alike)])
+    with pytest.raises(RefusedProgram):
+        checked_argv([str(fake), "log"])
+
+
+@pytest.mark.parametrize("keyword", ["executable", "shell", "preexec_fn"])
+def test_keywords_that_start_something_else_are_refused_and_nothing_starts(keyword: str, tmp_path: Path) -> None:
+    marker = tmp_path / "ran"
+    value = {"executable": "/bin/sh", "shell": True, "preexec_fn": lambda: marker.write_text("x")}[keyword]
+    with pytest.raises(RefusedProgram):
+        popen_program(["true", "-c", f"echo X > {marker}"], **{keyword: value})
+    assert not marker.exists()
+
+
+_PROGRAM_START_NAMES = {"run", "Popen", "call", "check_output", "check_call", "getoutput", "getstatusoutput"}
+_OS_START_NAMES = {"system", "popen", "fork", "posix_spawn", "posix_spawnp"}
+
+
+def _starts_a_program(tree: ast.AST) -> list[int]:
+    """Lines that import a start-a-program name (any spelling), call one through `subprocess`, `os` or an alias."""
+    hits: list[int] = []
+    aliases: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for a in node.names:
+                if a.name == "subprocess" and a.asname:
+                    aliases.add(a.asname)
+                    hits.append(node.lineno)
+        elif isinstance(node, ast.ImportFrom):
+            names = {a.name for a in node.names}
+            if node.module == "subprocess" and names & _PROGRAM_START_NAMES:
+                hits.append(node.lineno)
+            if node.module == "os" and any(n in _OS_START_NAMES or n.startswith(("exec", "spawn")) for n in names):
+                hits.append(node.lineno)
+            if node.module in {"pty", "asyncio.subprocess"} or (
+                node.module == "asyncio" and any(n.startswith("create_sub") for n in names)
+            ):
+                hits.append(node.lineno)
+        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            f = node.func
+            base = f.value.id if isinstance(f.value, ast.Name) else ""
+            if (base in {"subprocess"} | aliases and f.attr in _PROGRAM_START_NAMES) or (
+                base == "os" and (f.attr in _OS_START_NAMES or f.attr.startswith(("exec", "spawn")))
+            ):
+                hits.append(node.lineno)
+    return hits
+
+
+def test_the_scan_notices_every_spelling_of_a_program_start() -> None:
+    for text in (
+        "from subprocess import run",
+        "from subprocess import Popen as P",
+        "import subprocess as sp\nsp.run(['x'])",
+        "import subprocess\nsubprocess.check_output(['x'])",
+        "from os import system",
+        "import os\nos.execv('x', [])",
+    ):
+        assert _starts_a_program(ast.parse(text)), text
+    assert not _starts_a_program(ast.parse("import subprocess\nsubprocess.TimeoutExpired\nx = subprocess.PIPE"))
+
+
+def test_no_other_file_of_tests_starts_a_program_in_any_spelling() -> None:
+    allowed = {"support.py", "test_file_call_guard.py", "test_r7b_program_helper.py", Path(__file__).name}
+    found = []
+    for path in sorted(HERE.glob("*.py")):
+        if path.name in allowed:
+            continue
+        found += [f"{path.name}:{n}" for n in _starts_a_program(ast.parse(path.read_text(encoding="utf-8")))]
+    assert found == [], found
diff --git a/b/tests/test_r7c_reset_exact_command.py b/tests/test_r7c_reset_exact_command.py
new file mode 100644
index 0000000..4a11907
--- /dev/null
+++ b/tests/test_r7c_reset_exact_command.py
@@ -0,0 +1,90 @@
+"""Round 7C, finding H: reset.sh and reset.ps1 stop a process only when its whole command line is the desk's or the demo
+server's, not when the text `lead_desk.server` appears anywhere in it. Real stand-in processes on this machine; the
+.ps1 is checked by its text only (it has not been run on Windows)."""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+from support import REPO, popen_program, run_program, start_standin, text_file, wait_until
+
+SH = (REPO / "scripts" / "reset.sh").read_text(encoding="utf-8")
+PS = (REPO / "scripts" / "reset.ps1").read_bytes().decode("utf-8")
+WAIT = "import os, time; open(os.environ['READY'], 'w').close(); time.sleep(60)"
+pytestmark = pytest.mark.skipif(sys.platform == "win32", reason="reset.sh is the non-Windows script")
+
+
+def _is_ours(pid: int, ps_text: str = "") -> bool:
+    """Run the is_ours function of reset.sh alone, in bash, with an EMPTY search path (so no `python` is needed)."""
+    start = SH.index("is_ours() {")
+    body = SH[start : SH.index("\nalive() {", start)]
+    script = text_file(body + f'\nis_ours {pid} "$1"\n', ".sh")
+    done = run_program(
+        [shutil.which("bash") or "bash", script, ps_text],
+        env={"PATH": "/nonexistent"},
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    return done.returncode == 0
+
+
+def _start(tmp: Path, module: str, args: tuple[str, ...] = ()) -> Any:
+    ready = tmp / "ready"
+    proc = start_standin(tmp / "standin", module, WAIT, ready, args)
+    wait_until(ready.exists, what="the stand-in runs")
+    return proc
+
+
+def test_the_exact_command_lines_are_accepted_and_the_look_alikes_are_not(tmp_path: Path) -> None:
+    good = [("lead_desk.server", ()), ("demo_only.fakes_server", ("--outbox", "keyed", "--port", "8123"))]
+    bad = [
+        ("lead_desk.server", ("--extra",)),
+        ("demo_only.fakes_server", ()),
+        ("demo_only.fakes_server", ("--outbox", "other", "--port", "8123")),
+        ("demo_only.fakes_server", ("--outbox", "blind", "--port", "x")),
+    ]
+    for module, args in good + bad:
+        folder = tmp_path / (module + "-".join(args))
+        folder.mkdir()
+        proc = _start(folder, module, args)
+        try:
+            assert _is_ours(proc.pid) == ((module, args) in good), (module, args)
+        finally:
+            proc.kill()
+            proc.wait()
+
+
+def test_a_program_that_only_mentions_the_desk_is_not_the_desk(tmp_path: Path) -> None:
+    ready = tmp_path / "r"
+    # the old text search matched this: a python script whose arguments hold the words lead_desk.server
+    proc = popen_program(
+        [sys.executable, text_file(WAIT), "lead_desk.server", "demo_only.fakes_server"],
+        env={**os.environ, "READY": str(ready)},
+    )
+    try:
+        wait_until(ready.exists, what="the look-alike runs")
+        assert _is_ours(proc.pid) is False
+    finally:
+        proc.kill()
+        proc.wait()
+
+
+def test_a_program_not_named_python_is_not_the_desk() -> None:
+    assert _is_ours(0, "sleep -m lead_desk.server") is False  # no /proc entry for pid 0: the ps text is used
+    assert _is_ours(0, "/usr" + "/bin/python3 -m lead_desk.server") is True
+    assert _is_ours(0, "python -m lead_desk.server extra") is False
+    assert _is_ours(0, "less lead_desk.server.log") is False
+
+
+def test_the_script_does_not_search_the_command_line_for_text() -> None:
+    assert "*lead_desk.server*" not in SH and "*demo_only.fakes_server*" not in SH
+    assert not re.search(r"-match 'lead_desk", PS)
+    assert "$ourCommandLine" in PS and "-imatch $ourCommandLine" in PS
+    assert "python[0-9.]*" in PS and "--outbox (keyed|blind) --port [0-9]+" in PS
