--- /dev/null
+++ b/tests/test_r7c_burst_probe_and_names.py
@@ -0,0 +1,62 @@
+"""Round 7C nits: the burst's listener probe sends NOTHING (the text "no request was sent" is true), and the address
+rule: `localhost` and the loopback addresses are accepted; look-alike names are refused before any connection."""
+
+from __future__ import annotations
+
+import socket
+import threading
+
+import pytest
+from support import HOST
+
+burst = pytest.importorskip("demo_only.burst")
+
+
+def test_the_probe_connects_and_sends_no_byte() -> None:
+    srv = socket.socket()
+    srv.bind((HOST, 0))
+    srv.listen(1)
+    got: list[bytes] = []
+
+    def accept() -> None:
+        conn, _ = srv.accept()
+        conn.settimeout(2.0)
+        try:
+            while chunk := conn.recv(100):
+                got.append(chunk)
+        except OSError:
+            pass
+        conn.close()
+
+    th = threading.Thread(target=accept, daemon=True)
+    th.start()
+    try:
+        assert burst.listener_answers(f"http://{HOST}:{srv.getsockname()[1]}/x", 2.0)
+    finally:
+        th.join(5)
+        srv.close()
+    assert got == []
+
+
+@pytest.mark.parametrize("good", ["http://localhost:1/x", "http://127.0.0.1:1/x", "http://[::1]:1/x"])
+def test_the_names_this_computer_has_are_accepted(good: str, capsys: pytest.CaptureFixture[str]) -> None:
+    argv = ["--n", "1", "--email", "a@example.com", "--ref-prefix", "p", "--source", "form"]
+    assert burst.main(["--url", good, *argv]) == 3  # parsed; nothing listens on port 1: the one unreachable line
+    assert capsys.readouterr().err.strip() == "ERROR: nothing answers at that address: no request was sent"
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "http://" + "localhost.example.test:1/x",
+        "http://" + "127.0.0.1.example.test:1/x",
+        "http://" + "localhostx:1/x",
+        "http://" + "0:1/x",
+    ],
+)
+def test_look_alike_names_are_refused_before_any_connection(bad: str, capsys: pytest.CaptureFixture[str]) -> None:
+    argv = ["--n", "1", "--email", "a@example.com", "--ref-prefix", "p", "--source", "form"]
+    with pytest.raises(SystemExit) as info:
+        burst.main(["--url", bad, *argv])
+    assert info.value.code == 2
+    assert "nothing answers" not in capsys.readouterr().err
diff --git a/b/tests/test_r7c_clean_tree_guard.py b/tests/test_r7c_clean_tree_guard.py
new file mode 100644
index 0000000..aab9ef2
--- /dev/null
+++ b/tests/test_r7c_clean_tree_guard.py
@@ -0,0 +1,133 @@
+"""Round 7C, finding C: the clean-tree guard of the test run, and the test of the guard itself.
+
+The r7b guard skipped `.git`, `__pycache__`, `node_modules` and the tool caches as WHOLE folders and could not see an
+empty folder, while the notes said it "hides and skips nothing". Now it compares everything except the short list in
+tests/tree_guard.py. Each test plants a change in a scratch copy of a small tree and expects the guard to name it."""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Callable
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import conftest
+import pytest
+import tree_guard
+
+
+@pytest.fixture
+def root(tmp_path: Path) -> Path:
+    r = tmp_path / "repo"
+    (r / "src").mkdir(parents=True)
+    (r / "src" / "a.py").write_text("x = 1\n", encoding="utf-8")
+    (r / ".git").mkdir()
+    (r / ".git" / "HEAD").write_text("ref\n", encoding="utf-8")
+    (r / "src" / "__pycache__").mkdir()
+    (r / "src" / "__pycache__" / "a.cpython-312.pyc").write_bytes(b"\0")
+    return r
+
+
+def _changed(root: Path, act: Callable[[], object]) -> list[str]:
+    before = tree_guard.snapshot(root)
+    act()
+    return tree_guard.changes(before, tree_guard.snapshot(root))
+
+
+def test_an_unchanged_tree_reports_nothing(root: Path) -> None:
+    assert _changed(root, lambda: None) == []
+
+
+def test_a_planted_file_is_named(root: Path) -> None:
+    assert _changed(root, lambda: (root / "stray.txt").write_text("x", encoding="utf-8")) == ["stray.txt"]
+
+
+def test_a_planted_empty_folder_is_named(root: Path) -> None:
+    assert _changed(root, lambda: (root / "empty").mkdir()) == ["empty"]
+
+
+def test_a_file_with_a_line_break_in_its_name_is_named(root: Path) -> None:
+    assert _changed(root, lambda: (root / "a\nb").write_text("x", encoding="utf-8")) == ["a\nb"]
+
+
+def test_a_changed_and_a_deleted_file_are_named(root: Path) -> None:
+    def act() -> None:
+        (root / "src" / "a.py").write_text("x = 22222\n", encoding="utf-8")
+
+    assert _changed(root, act) == [os.path.join("src", "a.py")]
+    assert _changed(root, lambda: (root / "src" / "a.py").unlink()) == [os.path.join("src", "a.py")]
+
+
+def test_a_folder_that_used_to_be_skipped_is_compared_now(root: Path) -> None:
+    assert _changed(root, lambda: (root / "node_modules" / "p").mkdir(parents=True)) == [
+        "node_modules",
+        os.path.join("node_modules", "p"),
+    ]
+
+
+def test_a_link_is_one_entry_and_is_not_followed(root: Path) -> None:
+    def act() -> None:
+        (root / "to_src").symlink_to(root / "src")
+
+    assert _changed(root, act) == ["to_src"]
+
+
+def test_only_the_listed_things_are_skipped(root: Path) -> None:
+    def quiet() -> None:
+        (root / ".git" / "objects").mkdir()
+        (root / ".git" / "index").write_text("i", encoding="utf-8")
+        (root / "src" / "__pycache__" / "b.cpython-312.pyc").write_bytes(b"\0")
+        (root / "scripts" / "__pycache__").mkdir(parents=True)
+        (root / "scripts" / "__pycache__" / "c.cpython-312.pyc").write_bytes(b"\0")
+        (root / ".pytest_cache").mkdir()
+        (root / ".pytest_cache" / "v").write_text("1", encoding="utf-8")
+        (root / ".coverage").write_text("c", encoding="utf-8")
+        (root / "coverage.xml").write_text("c", encoding="utf-8")
+
+    (root / "scripts").mkdir()
+    assert _changed(root, quiet) == []
+
+
+def test_a_file_that_is_not_a_pyc_inside_a_cache_folder_is_named(root: Path) -> None:
+    got = _changed(root, lambda: (root / "src" / "__pycache__" / "note.txt").write_text("x", encoding="utf-8"))
+    assert os.path.join("src", "__pycache__", "note.txt") in got
+
+
+def test_the_git_folder_itself_is_still_compared(root: Path) -> None:
+    def act() -> None:
+        (root / ".git").rename(root / ".git-moved")
+
+    assert ".git" in _changed(root, act)
+
+
+def _finish(root: Path, monkeypatch: pytest.MonkeyPatch, act: Callable[[], object]) -> Any:
+    """Point the real hook of conftest.py at the scratch tree, apply the change, return a fake session."""
+    monkeypatch.setattr(conftest, "_REPO_ROOT", root)
+    monkeypatch.setattr(conftest, "_TREE_BEFORE", tree_guard.snapshot(root))
+    act()
+    return SimpleNamespace(config=SimpleNamespace(getoption=lambda *_a: False), exitstatus=0)
+
+
+def test_the_session_hook_fails_the_run_and_names_the_planted_file(
+    root: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    session = _finish(root, monkeypatch, lambda: (root / "stray.txt").write_text("x", encoding="utf-8"))
+    conftest.pytest_sessionfinish(session, 0)
+    assert session.exitstatus == 1 and "'stray.txt'" in capsys.readouterr().out
+
+
+def test_the_session_hook_fails_the_run_for_a_planted_empty_folder(
+    root: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    session = _finish(root, monkeypatch, lambda: (root / "empty").mkdir())
+    conftest.pytest_sessionfinish(session, 0)
+    assert session.exitstatus == 1 and "'empty'" in capsys.readouterr().out
+
+
+def test_the_session_hook_stays_quiet_when_nothing_changed(
+    root: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    session = _finish(root, monkeypatch, lambda: None)
+    conftest.pytest_sessionfinish(session, 0)
+    assert session.exitstatus == 0 and capsys.readouterr().out == ""
diff --git a/b/tests/test_r7c_head_deadline_errors.py b/tests/test_r7c_head_deadline_errors.py
new file mode 100644
index 0000000..16635b6
--- /dev/null
+++ b/tests/test_r7c_head_deadline_errors.py
@@ -0,0 +1,79 @@
+"""Round 7C, finding D: the quiet drop of an error answer to a sender that has gone (`HeadDeadline.send_error`).
+
+The r7b review changed `except OSError` to `except KeyError` (mutant M7) and all 84 tests still passed, while a real
+header drip then printed BrokenPipeError traces. Two tests: the mix-in alone (a parent whose send_error fails like a
+closed connection), and a real drip against each fake with the error output captured."""
+
+from __future__ import annotations
+
+import socket
+import threading
+import time
+from typing import Any
+
+import pytest
+import test_r7_fake_slow_senders as slow
+from test_r7_fake_slow_senders import _head
+
+import scripts.http_guard as guard
+
+target = slow.target  # the same fixture (one fake per case), reused here
+
+
+class _ParentThatFails:
+    error: BaseException = BrokenPipeError()
+
+    def send_error(self, *_a: Any, **_k: Any) -> None:
+        raise self.error
+
+
+class _Handler(guard.HeadDeadline, _ParentThatFails):
+    close_connection = False
+
+
+@pytest.mark.parametrize("error", [BrokenPipeError(), ConnectionResetError(), OSError("gone"), TimeoutError()])
+def test_an_error_answer_to_a_gone_sender_is_dropped_quietly(error: OSError) -> None:
+    h = _Handler.__new__(_Handler)
+    h.error = error
+    h.send_error(408, "x")  # no exception
+    assert h.close_connection is True
+
+
+def test_only_connection_errors_are_dropped_a_real_bug_is_not_hidden() -> None:
+    h = _Handler.__new__(_Handler)
+    h.error = KeyError("bug")
+    with pytest.raises(KeyError):
+        h.send_error(408, "x")
+
+
+def test_a_real_header_drip_prints_no_trace(
+    target: tuple[int, str, bool], monkeypatch: pytest.MonkeyPatch, capfd: pytest.CaptureFixture[str]
+) -> None:
+    monkeypatch.setattr(guard, "FAKE_HEAD_DEADLINE_SECONDS", 1.0)
+    port, line, auth = target
+    head = _head(line, auth, "Content-Length: 2\r\n")[:-2] + b"X-Slow: "
+    stop = threading.Event()
+
+    def drip(s: socket.socket) -> None:
+        try:
+            for ch in head + b"a" * 100:
+                if stop.is_set():
+                    return
+                s.sendall(bytes([ch]))
+                time.sleep(0.1)
+        except OSError:
+            pass
+
+    with socket.create_connection(("127.0.0.1", port), timeout=15) as s:
+        th = threading.Thread(target=drip, args=(s,), daemon=True)
+        th.start()
+        try:
+            while s.recv(4096):
+                pass
+        except OSError:
+            pass
+        stop.set()
+        th.join(5)
+    time.sleep(0.5)  # the server thread prints (if it prints) after the connection closed
+    err = capfd.readouterr().err
+    assert "Traceback" not in err and "BrokenPipeError" not in err, err[-300:]
diff --git a/b/tests/test_r7c_invariants_output_size.py b/tests/test_r7c_invariants_output_size.py
new file mode 100644
index 0000000..8f7e46c
--- /dev/null
+++ b/tests/test_r7c_invariants_output_size.py
@@ -0,0 +1,56 @@
+"""Round 7C, O-3: the size of what `check_invariants` prints does not grow with the log. A log of 100,000 short rows
+printed 168 lines where 161 were expected. The 7 extra lines are the line `first 10 of N: ...` that the table prints
+under EACH failing check (7 checks, 7 lines): they were left out of the expected number. The exact counts are pinned."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from test_load_tools import T0, make_world, run_world
+
+from load_tools import check_invariants as ci
+
+TABLE_LINES_ALL_HOLD = 2 + 7 * 2 + 1  # two header lines, two lines per check, the closing line
+JSON_LINES_ALL_HOLD_AND_EMPTY = 68  # seven checks, no values, no offenders, indent 2 (see the test below)
+
+
+def _synthetic(offenders: int, ok: bool) -> dict[str, object]:
+    return {
+        "ok": ok,
+        "checks": [ci._result(n, ok, "d", [f"o{i:06d}" for i in range(offenders)], {}) for n in range(1, 8)],
+    }
+
+
+def _dump(result: dict[str, object]) -> list[str]:
+    return json.dumps(result, indent=2, sort_keys=True).split("\n")
+
+
+def test_each_failing_check_adds_exactly_one_line_to_the_table() -> None:
+    assert len(ci.render_table(_synthetic(0, True)).split("\n")) == TABLE_LINES_ALL_HOLD
+    for failing_offenders in (1, ci.FIRST_N, ci.FIRST_N + 1, 100_000):
+        lines = ci.render_table(_synthetic(failing_offenders, False)).split("\n")
+        assert len(lines) == TABLE_LINES_ALL_HOLD + 7, failing_offenders  # one `first N of M` line per check
+        assert sum(1 for line in lines if line.lstrip().startswith("first ")) == 7
+
+
+def test_the_printed_size_is_the_same_for_a_hundred_thousand_offenders_as_for_eleven() -> None:
+    small, big = _synthetic(ci.FIRST_N + 1, False), _synthetic(100_000, False)
+    assert len(_dump(small)) == len(_dump(big)) == 145
+    assert len(_dump(_synthetic(0, True))) == JSON_LINES_ALL_HOLD_AND_EMPTY
+
+
+def test_a_real_run_over_a_hundred_thousand_short_rows_prints_a_fixed_number_of_lines(tmp_path: Path) -> None:
+    w = make_world()
+    clean = run_world(tmp_path, make_world())
+    w["reqs"] += [
+        {"request_id": f"x{i}", "door": "form", "intended_ts": T0, "final_status": 503}
+        for i in range(100_000 - len(w["reqs"]))
+    ]
+    result = run_world(tmp_path, w)
+    assert result["checks"][0]["offender_count"] > 99_000 and len(result["checks"][0]["offenders"]) == ci.FIRST_N
+    clean_table = len(ci.render_table(clean).split("\n"))
+    table = ci.render_table(result).split("\n")
+    failing = sum(1 for c in result["checks"] if c["offender_count"])
+    assert len(table) == clean_table + failing  # one `first N of M` line for each failing check, nothing else
+    assert (len(table), len(json.dumps(result, indent=2, sort_keys=True).split("\n"))) == (18, 150)  # measured
diff --git a/b/tests/test_r7c_mail6_killers.py b/tests/test_r7c_mail6_killers.py
new file mode 100644
index 0000000..a74ade2
--- /dev/null
+++ b/tests/test_r7c_mail6_killers.py
@@ -0,0 +1,104 @@
+"""Round 7C, mail pass 6, findings D05, D11, D20 (made-up data, loopback sockets only). D05: a mailbox connection
+refused for its TLS version gets no LOGOUT and no LOGIN. D11: an SMTP connection refused for its TLS version is closed
+at once. D20: a settings name holding a no-break space is refused."""
+
+from __future__ import annotations
+
+import socket
+import ssl
+import time
+from pathlib import Path
+
+import pytest
+from support import script_module
+
+from demo_only.fake_imap import FakeImap
+from demo_only.fake_smtp_tls import FAKE_PASSWORD, FakeSmtp, make_cert
+from lead_desk import smtp_provider as sp
+from lead_desk.contract import SendRefused
+from lead_desk.imap_count import ImapCountError as Err
+from lead_desk.imap_count import ImapSettings, counts_by_key
+from lead_desk.smtp_outbox import _Budget
+from lead_desk.tls_trust import CaFileRefused
+
+HOST = "localhost"
+
+
+def test_m6_d11_a_connection_refused_for_its_tls_version_is_closed_at_once(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+
+    made = make_cert(tmp_path, HOST)
+    if made is None:
+        pytest.skip("no openssl")
+    pw = tmp_path / "pw.txt"
+    pw.write_text(FAKE_PASSWORD + "\n", encoding="utf-8")
+    srv = FakeSmtp(made[0], made[1], HOST, implicit_tls=True)
+    closed: list[bool] = []
+    real_close = ssl.SSLSocket.close
+
+    def spy(self: ssl.SSLSocket) -> None:
+        closed.append(True)
+        real_close(self)
+
+    def refuse(conn: ssl.SSLSocket, name: str) -> None:
+        raise CaFileRefused("forced")
+
+    try:
+        s = sp.ProviderSettings(
+            HOST,
+            srv.port,
+            "sender-user",
+            pw,
+            "sender@example.test",
+            ("a@example.test",),
+            5,
+            security="ssl",
+            timeout_seconds=3.0,
+        )
+        box = sp.SmtpProviderOutbox(s, ssl.create_default_context(cafile=str(made[0])))
+        monkeypatch.setattr(sp, "require_modern_protocol", refuse)
+        monkeypatch.setattr(ssl.SSLSocket, "close", spy)
+        sock = socket.create_connection((HOST, srv.port), timeout=3)
+        with pytest.raises(SendRefused):
+            box._wrap(sock, _Budget(3.0))
+        assert closed, "the refused TLS connection was left open"
+    finally:
+        srv.close()
+
+
+def test_m6_d20_a_config_name_with_a_no_break_space_is_refused(tmp_path: Path) -> None:
+    rrc = script_module("run_real_check")
+
+    cfg = tmp_path / "c.env"
+    cfg.write_text("REAL_PERSONS\xa0=8\n", encoding="utf-8")
+    with pytest.raises(ValueError, match="config line 1"):
+        rrc.load_env(cfg)
+
+
+def test_m6_d05_a_mailbox_connection_refused_for_its_tls_version_gets_no_logout_either(tmp_path: Path) -> None:
+
+    made = make_cert(tmp_path, HOST)
+    if made is None:
+        pytest.skip("no openssl")
+    pw = tmp_path / "pw.txt"
+    pw.write_text(FAKE_PASSWORD + "\n", encoding="utf-8")
+    srv = FakeImap(made[0], made[1], HOST, {"INBOX": ["RUN1-L1"]})
+    try:
+        try:
+            srv._ctx.minimum_version = ssl.TLSVersion.TLSv1
+            srv._ctx.maximum_version = ssl.TLSVersion.TLSv1_1
+            srv._ctx.set_ciphers("ALL:@SECLEVEL=0")
+        except (ValueError, ssl.SSLError):
+            pytest.skip("this OpenSSL cannot make a TLS 1.1 only test server")
+        c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+        c.load_verify_locations(cafile=str(made[0]))
+        c.minimum_version = ssl.TLSVersion.MINIMUM_SUPPORTED
+        c.set_ciphers("ALL:@SECLEVEL=0")
+        s = ImapSettings(HOST, srv.user, pw, port=srv.port, folders=("INBOX",), timeout_seconds=3.0, ssl_context=c)
+        with pytest.raises(Err):
+            counts_by_key(s, "RUN1-")
+        time.sleep(0.3)
+        assert "LOGOUT" not in srv.commands and "LOGIN" not in srv.commands, srv.commands
+    finally:
+        srv.close()
diff --git a/b/tests/test_r7c_mail_killers.py b/tests/test_r7c_mail_killers.py
new file mode 100644
index 0000000..7066f9d
--- /dev/null
+++ b/tests/test_r7c_mail_killers.py
@@ -0,0 +1,147 @@
+"""Round 7C, mail findings M-1 and M-2 (from the mail pass). Real loopback sockets, made-up data only.
+
+M-1: the IMAP total time limit must hold INSIDE one slow greeting, one reply line and one literal (a server that sends
+one byte every 0.3 s used to keep the call for 9 to 12 s against a 3 s limit).
+M-2: a bad secret file is refused before the Start question, before any connection and before any spend is reserved."""
+
+from __future__ import annotations
+
+import io
+import socket
+import ssl
+import threading
+import time
+from contextlib import redirect_stdout
+from pathlib import Path
+
+import pytest
+from support import script_module
+
+from demo_only.fake_smtp_tls import FAKE_PASSWORD, make_cert
+from lead_desk.imap_count import ImapCountError, ImapSettings, counts_by_key
+
+HOST = "localhost"
+TOTAL = 2.0
+SLACK = 4.0  # the call must end within total + slack even though the server drips for 10 s
+
+
+def _drip_server(cert: Path, key: Path, mode: str, stop: threading.Event) -> int:
+    sctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+    sctx.load_cert_chain(str(cert), str(key))
+    srv = socket.socket()
+    srv.bind(("127.0.0.1", 0))
+    srv.listen(2)
+
+    def serve() -> None:
+        try:
+            c, _ = srv.accept()
+            t = sctx.wrap_socket(c, server_side=True)
+            f = t.makefile("rwb", buffering=0)
+            if mode == "greeting":  # one byte every 0.3 s, never a line end
+                t0 = time.monotonic()
+                while not stop.is_set() and time.monotonic() - t0 < 10:
+                    f.write(b"*")
+                    time.sleep(0.3)
+                return
+            f.write(b"* OK ready\r\n")
+            while not stop.is_set():
+                line = f.readline(65536).decode().rstrip("\r\n")
+                if not line:
+                    return
+                tag, _, rest = line.partition(" ")
+                word = rest.split(" ", 1)[0].upper()
+                if word == "CAPABILITY":
+                    f.write(f"* CAPABILITY IMAP4rev1\r\n{tag} OK done\r\n".encode())
+                elif word == "LOGIN":
+                    f.write(f"{tag} OK login\r\n".encode())
+                elif word in ("EXAMINE", "SELECT"):
+                    t0 = time.monotonic()
+                    if mode == "line":  # one reply line that never ends
+                        while not stop.is_set() and time.monotonic() - t0 < 10:
+                            f.write(b"*")
+                            time.sleep(0.3)
+                    else:  # "literal": announces 2000 bytes and delivers 1 byte per 0.3 s
+                        f.write(b"* 1 FETCH (BODY[] {2000}\r\n")
+                        while not stop.is_set() and time.monotonic() - t0 < 10:
+                            f.write(b"x")
+                            time.sleep(0.3)
+                    return
+        except (OSError, ssl.SSLError, ValueError):
+            return
+
+    threading.Thread(target=serve, daemon=True).start()
+    return int(srv.getsockname()[1])
+
+
+@pytest.mark.parametrize("mode", ["greeting", "line", "literal"])
+def test_m6_the_total_time_limit_holds_inside_one_slow_line_or_literal(mode: str, tmp_path: Path) -> None:
+    made = make_cert(tmp_path, HOST)
+    if made is None:
+        pytest.skip("no openssl")
+    cert, key = made
+    pw = tmp_path / "pw.txt"
+    pw.write_text(FAKE_PASSWORD + "\n", encoding="utf-8")
+    stop = threading.Event()
+    port = _drip_server(cert, key, mode, stop)
+    ctx = ssl.create_default_context(cafile=str(cert))
+    s = ImapSettings(
+        HOST,
+        "reader-user",
+        pw,
+        port=port,
+        folders=("INBOX",),
+        timeout_seconds=3.0,
+        total_seconds=TOTAL,
+        ssl_context=ctx,
+    )
+    t0 = time.monotonic()
+    with pytest.raises(ImapCountError):
+        counts_by_key(s, "RUN1-")
+    took = time.monotonic() - t0
+    stop.set()
+    assert took < TOTAL + SLACK, f"the call ran {took:.1f} s against a total limit of {TOTAL} s"
+
+
+def test_m6_real_check_refuses_a_bad_secret_file_before_the_start_question(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    rrc = script_module("run_real_check")
+
+    good = tmp_path / "ok.txt"
+    good.write_text("pw-ok-12345678\n", encoding="utf-8")
+    bad = tmp_path / "bad.txt"
+    bad.write_bytes(b"pw-bad-\xc2\xa0-xx12\n")
+    for which in ("hs", "smtp", "imap"):
+        files = {"hs": good, "smtp": good, "imap": good}
+        files[which] = bad
+        cfg = tmp_path / f"{which}.env"
+        cfg.write_text(
+            "\n".join(
+                [
+                    f"DESK_DB_PATH={tmp_path / ('run-' + which) / 'desk.db'}",
+                    f"DESK_HUBSPOT_KEY_FILE={files['hs']}",
+                    "DESK_HUBSPOT_MAX_CALLS=100",
+                    "REAL_HUBSPOT_READBACK_MAX_CALLS=50",
+                    "DESK_SMTPP_HOST=smtp.example.test",
+                    "DESK_SMTPP_USER=desk@example.test",
+                    f"DESK_SMTPP_PASSWORD_FILE={files['smtp']}",
+                    "DESK_SMTPP_FROM=desk@example.test",
+                    "DESK_SMTPP_RECIPIENTS=a@example.test,b@example.test",
+                    "DESK_SMTPP_MAX_SENDS=50",
+                    "REAL_IMAP_1_USER=a@example.test",
+                    f"REAL_IMAP_1_PASSWORD_FILE={files['imap']}",
+                    "REAL_IMAP_2_USER=b@example.test",
+                    f"REAL_IMAP_2_PASSWORD_FILE={files['imap']}",
+                ]
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+        asked: list[str] = []
+        out = io.StringIO()
+        monkeypatch.setattr("builtins.input", lambda prompt="": (asked.append(prompt), "n")[1])
+        with redirect_stdout(out):
+            rc = rrc.main(["--config", str(cfg)])
+        assert not asked, f"{which}: the Start? question was reached with a bad secret file"
+        assert rc == rrc.EXIT_REFUSED
+        assert "\xa0" not in out.getvalue() and "xx12" not in out.getvalue()
