+    "os.path.getatime",
+    "os.path.getctime",
+    "os.path.exists",
+    "os.path.isfile",
+    "os.path.isdir",
+    "signal.pause",
+    "signal.sigwait",
+    "pdb.set_trace",
+    "pdb.post_mortem",
+    "pdb.run",
