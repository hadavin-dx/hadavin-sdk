+def weaken(ctx: ssl.SSLContext, how: str) -> None:
+    if how == "no_hostname":
+        ctx.check_hostname = False
+    elif how == "none":
+        ctx.check_hostname = False
+        ctx.verify_mode = ssl.CERT_NONE
+    else:  # "optional": the name check stays on, the chain check is weaker
+        ctx.verify_mode = ssl.CERT_OPTIONAL
+
