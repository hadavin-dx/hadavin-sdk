+def test_no_page_says_that_sending_a_request_again_changes_nothing() -> None:
+    """The desk gives the stored answer, but it also uses up one receipt number and adds one to that request's count
+    of arrivals (`receipts.attempts`), so "changes nothing" on a line about a repeated request is wrong."""
+    about_repeat = re.compile(r"replay|sent again|same request|comes again|came again|again gets", re.IGNORECASE)
+    claim = re.compile(r"changes? nothing|nothing changes", re.IGNORECASE)
+    bad = [(n, line[:80]) for n, line in _page_lines() if about_repeat.search(line) and claim.search(line)]
+    assert not bad, bad
+
+
+def test_the_pages_about_a_repeated_request_say_it_can_start_a_follow_up_that_is_due() -> None:
+    """desk.py `_verdict_reply` / `_pending_and_due`: a repeat of a request whose verdict is `new` starts the lead's
+    follow-up only when that is due (no automatic try yet, or the waiting time after the last try is over; a follow-up
+    just given back for lack of resources also waits 5 seconds), so repeats cannot use up the tries. contract.md says
+    so, with the 5 seconds, and names the tests that run the behaviour."""
+    from lead_desk import desk, gate
+
+    assert "elif self._pending_and_due(rec" in inspect.getsource(desk.Desk._verdict_reply)
+    assert gate.SEND_MAX_ATTEMPTS == 5  # the number the pages give
+    # `_pending_and_due` checks `wait_before_drive` first for these errors, so even with no automatic try used the row
+    # waits 5 seconds: "no automatic try yet" alone would be wrong for them
+    assert gate.wait_before_drive(0, gate.NO_DESCRIPTORS_ERROR) == 5
+    assert gate.wait_before_drive(0, gate.MODEL_BUSY_ERROR) == 5
+    assert "if row[3] in (NO_DESCRIPTORS_ERROR, *BUSY_ERRORS)" in inspect.getsource(desk.Desk._pending_and_due)
+    edge = (REPO / "tests" / "test_desk_http_edge_cases.py").read_text(encoding="utf-8")
+    assert "def test_replays_cannot_burn_the_cap(" in edge and "def test_replay_drives_once_due(" in edge
+    assert (
+        "drives the follow-up only if it is due: no automatic try yet, or its backoff is over (a follow-up given back "
+        "for lack of resources waits 5 seconds even with no try used)"
+    ) in CONTRACT
+    assert "If the lead's follow-up email is due and not yet sent, the replay starts it" in README
+
