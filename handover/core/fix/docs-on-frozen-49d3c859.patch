+"""Places where a page says what a command prints or needs, checked against the command itself.
+
+Class of bug: a sentence in the documentation that nobody checked against the tool (a start line that leaves out a
+needed folder, a receipt number that a repeated request uses up, a file that a script refuses). Each test below
+reads the sentence from the page and runs the real command or the real code, so the page and the tool cannot drift
+apart without a red test. Made-up data only."""
+
+from __future__ import annotations
+
+import inspect
+import ntpath
+import os
+import re
+import sys
+from pathlib import Path
+
+import pytest
+from support import HOST, REPO, call, child_env, free_port, lead, post_lead, stop_proc
+from test_http import launch
+
+from lead_desk.constants import EXIT_SIMULATED_KILL
+
+sys.path.insert(0, str(REPO / "scripts"))
+import hubspot_probe as hp  # noqa: E402
+import run_real_check as rrc  # noqa: E402
+
+README = (REPO / "README.md").read_text(encoding="utf-8")
+PROBE_PAGE = (REPO / "docs" / "hubspot-probe.md").read_text(encoding="utf-8")
+TESTS_PAGE = (REPO / "docs" / "tests.md").read_text(encoding="utf-8")
+SETTINGS_PAGE = (REPO / "docs" / "settings.md").read_text(encoding="utf-8")
+REAL_PAGE = (REPO / "docs" / "real-services.md").read_text(encoding="utf-8")
+CONTRACT = (REPO / "contract.md").read_text(encoding="utf-8")
+CRASH_SCRIPT = (REPO / "scripts" / "crash_desk.py").read_text(encoding="utf-8")
+
+
+def _documented_python_path(text: str) -> str:
+    found = {m.group(1) for m in re.finditer(r"PYTHONPATH=(\S+?)`? python scripts/crash_desk\.py", text)}
+    assert len(found) == 1, f"the text must name one PYTHONPATH for scripts/crash_desk.py, found {found}"
+    return found.pop()
+
+
+def test_the_two_texts_that_start_the_crash_script_name_the_same_path() -> None:
+    assert _documented_python_path(TESTS_PAGE) == _documented_python_path(CRASH_SCRIPT)
+
+
+def test_the_windows_form_is_the_linux_form_with_semicolons_and_is_said_to_be_unrun() -> None:
+    """The Windows form is not run here: the test pins only that its text is the Linux entries joined by `;` (the
+    separator of ntpath, which is what Windows uses) and that both texts say only the Linux form was run."""
+    entries = _documented_python_path(TESTS_PAGE).split(":")
+    windows = ";".join(entries)
+    assert ntpath.pathsep == ";" and windows == "src;."
+    assert f"(`{windows}`)" in TESTS_PAGE and f'$env:PYTHONPATH = "{windows}"' in CRASH_SCRIPT
+    assert "the Linux form was run, the Windows form was not run" in TESTS_PAGE
+    assert "only the Linux form was run" in CRASH_SCRIPT
+
+
+def test_the_crash_script_starts_with_the_path_the_page_gives(env, tmp_path: Path) -> None:
+    """Start it as the page says (relative path entries, the repository as the working folder), arm the flag file and
+    see the real stop at point D2. The old text said `PYTHONPATH=src`; then the desk stops with `the folder demo_only
+    is missing`, because a script started by its path does not see the repository folder."""
+    entries = _documented_python_path(TESTS_PAGE).split(":")
+    _, fakes_url = env.fakes("keyed")
+    replies = tmp_path / "replies.json"
+    replies.write_text("{}", encoding="utf-8")
+    port = free_port()
+    base = f"http://{HOST}:{port}"
+    env_vars = child_env(
+        DESK_DB_PATH=str(tmp_path / "desk.sqlite3"),
+        DESK_BIND=HOST,
+        DESK_PORT=str(port),
+        DESK_FAKES_URL=fakes_url,
+        DESK_REPLIES_PATH=str(replies),
+    )
+    env_vars["PYTHONPATH"] = os.pathsep.join(entries)  # exactly the entries the page names, nothing added
+    (tmp_path / "crash.flag").write_text("D2", encoding="utf-8")
+    p = launch([str(REPO / "scripts" / "crash_desk.py")], env_vars, base)
+    try:
+        status, _ = post_lead(base, "form", "sub-1", lead())
+        assert status == 201
+        p.wait(timeout=20)
+        out = stop_proc(p)
+        assert p.returncode == EXIT_SIMULATED_KILL, out.decode(errors="replace")[-400:]
+        assert b"simulate crash" in out
+        assert call(fakes_url, "GET", "/fake/outbox")[1]["count"] == 1
+    finally:
+        stop_proc(p)
+
+
+def test_a_repeat_uses_up_a_receipt_number(env) -> None:
+    """README, "Try it": the repeated request makes no lead and no mail, but the next new receipt is number 3."""
+    base = env.serve(env.rig())
+    first = post_lead(base, "form", "sub-1", lead())[1]
+    again = post_lead(base, "form", "sub-1", lead())[1]
+    other_door = post_lead(base, "webhook", "sub-1", lead())[1]
+    assert (first["receipt_id"], first["verdict"]) == (1, "new")
+    assert again["replayed"] is True and again["receipt_id"] == 1
+    assert (other_door["receipt_id"], other_door["verdict"]) == (3, "duplicate")  # number 2 was used up
+    assert call(base, "GET", "/counts")[1]["received"] == 2  # the count of receipts does not show the skip
+    # the README says it in the steps (both shells) and in the lists; the tests page names this test
+    assert README.count('"receipt_id": 3 (the repeat above took number 2)') == 2
+    assert "uses up a receipt number" in README and "they are never reused" in README
+    assert "uses up a receipt number" in TESTS_PAGE and "test_a_repeat_uses_up_a_receipt_number" in TESTS_PAGE
+    schema = (REPO / "src" / "lead_desk" / "schema.sql").read_text(encoding="utf-8")
+    assert "receipt_id INTEGER PRIMARY KEY AUTOINCREMENT" in schema  # why a number is never reused
+
+
+def test_the_probe_checks_the_token_variable_name_only_when_calls_are_confirmed(
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """docs/hubspot-probe.md: `--plan` does not look at the name; with `--yes-spend-calls` a bad name is refused and
+    never printed. No call is made in any of the three runs."""
+    bad = "qzx9 not-a-name 7kv"
+    assert hp.main(["--plan", "--token-env", bad]) == hp.EXIT_OK
+    assert hp.main(["--token-env", bad]) == hp.EXIT_REFUSED  # refused earlier, for the missing confirmation
+    assert hp.main(["--yes-spend-calls", str(hp.PLANNED_CALLS), "--token-env", bad]) == hp.EXIT_REFUSED
+    out = capsys.readouterr().out
+    assert "must be the NAME of an environment variable" in out and bad not in out
+    assert "`--plan` does not look at the name" in PROBE_PAGE
+    # the refusal for the name comes only after the count is right (hubspot_probe.py checks the count first)
+    assert "when you give `--yes-spend-calls 7` (the planned count" in PROBE_PAGE
+    assert hp.PLANNED_CALLS == 7
+    assert "with any other count it is refused for the count first" in PROBE_PAGE
+
+
+def test_a_config_file_with_a_byte_order_mark_is_refused_on_line_1_as_the_page_says(tmp_path: Path) -> None:
+    """docs/real-services.md step 1: a UTF-8 file with a byte-order mark (what Notepad can write) is refused on line 1,
+    even when line 1 is only a comment, and the message is the one the page quotes. The same file without the mark
+    loads."""
+    body = "# a comment\nDESK_DB_PATH=x\n"
+    marked = tmp_path / "marked.env"
+    marked.write_bytes(b"\xef\xbb\xbf" + body.encode())
+    plain = tmp_path / "plain.env"
+    plain.write_bytes(body.encode())
+    with pytest.raises(ValueError, match=r"^config line 1 is not NAME=VALUE with an upper-case name$"):
+        rrc.load_env(marked)
+    assert rrc.load_env(plain) == {"DESK_DB_PATH": "x"}
+    assert "`config line 1 is not NAME=VALUE with an upper-case name`" in REAL_PAGE
+    assert "without a byte-order mark" in REAL_PAGE
+
+
+def test_assume_yes_is_refused_without_the_self_test_as_the_real_services_page_says(
+    capsys: pytest.CaptureFixture[str],
+) -> None:
+    """docs/real-services.md step 3: `--assume-yes` is accepted only together with `--dry-fakes`; a real run always
+    asks. The refusal comes before any file, network or process is touched."""
+    assert rrc.main(["--assume-yes"]) == rrc.EXIT_REFUSED
+    assert "a real run always asks" in capsys.readouterr().out
+    assert (
+        "`--assume-yes`, which the script accepts only together with `--dry-fakes` (a real run always asks)"
+        in REAL_PAGE
+    )
+    assert "`Start? [y/N]`" in REAL_PAGE
+    assert 'input("Start? [y/N] ")' in inspect.getsource(rrc)
+
+
+def test_the_script_starts_the_desk_in_the_repository_folder_as_the_page_says_for_paths() -> None:
+    """docs/real-services.md step 1 tells the reader to write every path in the config as a full path, because the desk
+    process the script starts runs in the repository folder. Pinned: the start call names that folder (the page says
+    this was read from the code; no test starts the real run)."""
+    assert "cwd=REPO" in inspect.getsource(rrc)
+    assert "`cwd=REPO` in `scripts/run_real_check.py`" in REAL_PAGE
