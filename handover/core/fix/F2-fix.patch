+def folder_cannot_be_made(path: str | os.PathLike[str]) -> bool:
+    """True when the folder of `path` surely cannot be made or written to: the path holds a NUL character, or the
+    nearest part that exists is not a folder this process may write to (for example a read-only mount). Looks only: it
+    makes nothing. False means "no reason found", not a promise: the maker still has to handle its own failure."""
+    try:
+        if "\0" in os.fspath(path):
+            return True
+        here = Path(os.path.abspath(path)).parent
+        while not os.path.lexists(here) and here.parent != here:
+            here = here.parent
+        return not (here.is_dir() and os.access(here, os.W_OK | os.X_OK))
+    except (OSError, ValueError, TypeError):
+        return True
+
