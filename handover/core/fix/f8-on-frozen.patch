+"""Round F8: the input classes that the independent review of the v2 diff found still open at their choke points.
+
+* M1 (listen): a port out of range, a port in use and an unknown host name end the mail catcher, the model stand-in and
+  the fakes server with ONE refusal line and exit 2, never a Python traceback.
+* M2 (load scenario text): nan, infinity, 1e400, a schedule of 10**18 requests and full-width digits are refused.
+* M3 (reader on a pipe): every file reader refuses a named pipe (FIFO) at once instead of waiting for ever.
+* M4 (flag and key files): a flag file that is not UTF-8 text, or is too big, is the quiet "no flag" answer; a key file
+  that is too big or not text is refused with the one line.
+* m1 to m7: exit codes of a bad setting, invisible characters in an address, the output-file helper, the effort words,
+  the fake mail server's behaviour list, the probe script's wording, the crash script's printed path.
+Made-up data only. Subprocess tests run with a 20 second limit."""
+
+from __future__ import annotations
+
+import os
+import random
+import re
+import socket
+import subprocess  # noqa: S404
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+
+from demo_only import fake_model_server, fake_smtp_tls  # noqa: E402
+from lead_desk.config import Config  # noqa: E402
+from lead_desk.constants import (  # noqa: E402
+    EXIT_DESK_SETTING_REFUSED,
+    LIVE_EFFORTS,
+    PORT_MAX,
+    SECRET_FILE_MAX_BYTES,
+)
+from lead_desk.envnum import SettingRefused, split_url  # noqa: E402
+from lead_desk.hooks import FlagFileHooks  # noqa: E402
+from lead_desk.regfile import MAX_TEXT_BYTES  # noqa: E402
+from lead_desk.trace import CrashWindows  # noqa: E402
+from load_tools import catcher, load_driver  # noqa: E402
+from load_tools import check_invariants as ci  # noqa: E402
+from tools import pathconfine  # noqa: E402
+from tools.refusing_args import TCP_PORT_MAX, port_arg  # noqa: E402
+
+HTTP = "http" + "://"
+PY = sys.executable
+FIFO_SKIP = pytest.mark.skipif(not hasattr(os, "mkfifo"), reason="no named pipes on this platform")
+ONE_REFUSAL = re.compile(r"refused: [^\n]+\n")
+
+
+def _run(*args: str, env: dict[str, str] | None = None, cwd: Path = REPO) -> subprocess.CompletedProcess[str]:
+    e = {**os.environ, "PYTHONPATH": str(REPO / "src") + os.pathsep + str(REPO), "PYTHONDONTWRITEBYTECODE": "1"}
+    for name in ("DESK_BIND", "DESK_PORT"):
+        e.pop(name, None)
+    e.update(env or {})
+    return subprocess.run(  # noqa: S603 (our own interpreter, fixed arguments, made-up data)
+        [PY, *args], capture_output=True, text=True, timeout=20, cwd=cwd, env=e, check=False
+    )
+
+
+def _no_traceback(p: subprocess.CompletedProcess[str]) -> None:
+    assert "Traceback" not in p.stdout + p.stderr
+
+
+# ---------------------------------------------------------------- M1: listen
+
+
+def test_the_port_limit_is_the_desks_own_limit() -> None:
+    assert TCP_PORT_MAX == PORT_MAX
+
+
+def test_port_arg_accepts_every_port_and_refuses_everything_else() -> None:
+    import argparse
+
+    rng = random.Random(8)  # noqa: S311 (made-up inputs, not security)
+    for n in [0, 1, 80, 65535, *(rng.randrange(0, 65536) for _ in range(200))]:
+        assert port_arg(str(n)) == n
+    bad = [
+        "65536",
+        "70000",
+        "99999",
+        "100000",
+        "-1",
+        "+1",
+        " 1",
+        "1 ",
+        "1_0",
+        "１０",
+        "٣",
+        "1e3",
+        "0x10",
+        "",
+        "x",
+        "1.0",
+    ]
+    bad += [str(rng.randrange(65536, 10**12)) for _ in range(100)]
+    for text in bad:
+        with pytest.raises(argparse.ArgumentTypeError):
+            port_arg(text)
+
+
+@pytest.mark.parametrize(
