+def _fifo(tmp_path: Path, name: str = "pipe") -> Path:
+    path = tmp_path / name
+    os.mkfifo(path)
+    return path
+
+
+def _child(code: str, *args: str) -> subprocess.CompletedProcess[str]:
+    """Run `code` (with sys.argv[1:] = args) in a child; a reader that waits on a pipe hits the 20 second limit and the
+    test fails with TimeoutExpired."""
+    return _run("-c", code, *args)
+
