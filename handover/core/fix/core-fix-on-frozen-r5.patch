+    assert "Traceback" not in out, out
+    assert code == 4, (code, out)
+    assert out.strip() == (
+        "the desk refuses a setting: DESK_SMTPP_CA_FILE cannot be read as a file of trusted certificates"
+    ), out
+    assert "ca.pem" not in out and "SSL" not in out
