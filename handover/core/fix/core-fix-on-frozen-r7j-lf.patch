+@pytest.mark.parametrize("ciphers", ["NULL:@SECLEVEL=0", "aNULL:@SECLEVEL=0", "MD5:@SECLEVEL=0"])
+def test_f2_a_context_that_offers_a_null_or_md5_cipher_is_refused(ciphers: str) -> None:
