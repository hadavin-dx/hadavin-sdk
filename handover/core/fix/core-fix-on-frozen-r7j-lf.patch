+class _Hook:
+    def __init__(self, monkeypatch: pytest.MonkeyPatch) -> None:
+        self.calls: list[str] = []
+        monkeypatch.setattr(threading, "excepthook", lambda a: self.calls.append(a.exc_type.__name__))
+
+
+class _Stop(BaseException):
+    pass
