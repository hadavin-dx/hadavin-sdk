+    srv.bind(("127.0.0.1", 0))
+    srv.listen(1)
+    port = srv.getsockname()[1]
+    made: list[int] = []
+
+    def make(family: int, kind: int, proto: int = 0) -> socket.socket:
+        made.append(family)
+        if family == socket.AF_INET6:
