+++ b/tests/test_r7c_portal_view_size.py
@@ -0,0 +1,86 @@
+"""Round 7C, finding F: the size claim of the portal view is TRUE. The old comment said a row was about 400 bytes; the
+real worst row (longest name, e-mail and company, every character outside the Basic Multilingual Plane, which the
+fake prints as two 6-byte escapes) is far larger. This builds that worst row through the real fake server, checks it
+fits PORTAL_VIEW_ROW_BYTES, and checks that the portal's request (`?limit=`) keeps a 100,000-lead view under the cap."""
+
+from __future__ import annotations
+
+import http.client
+import json
+import urllib.parse
+
+import pytest
+
+from demo_only.fakes_server import serve_fakes_in_thread, stop_fakes
+from lead_desk.constants import (
+    COMPANY_MAX,
+    EMAIL_MAX,
+    NAME_MAX,
+    PORTAL_ROWS_MAX,
+    PORTAL_VIEW_REPLY_MAX_BYTES,
+    PORTAL_VIEW_ROW_BYTES,
+)
+
+portal_demo = pytest.importorskip("demo_only.portal_demo")
+ASTRAL = "\U0001f600"  # one character, printed as two \uXXXX escapes (12 bytes)
+
+
+def _worst_row(n: int) -> dict[str, object]:
+    record = {
+        "lead_id": f"L{n:012x}",
+        "name": ASTRAL * NAME_MAX,
+        "email": ASTRAL * EMAIL_MAX,
+        "company": ASTRAL * COMPANY_MAX,
+        "source": "webhook",
+        "ai_label": "needs_person",
+    }
+    return {"lead_id": record["lead_id"], "record": record}
+
+
+def _get(url: str) -> bytes:
+    parts = urllib.parse.urlsplit(url)
+    conn = http.client.HTTPConnection(parts.hostname or "", parts.port, timeout=20)
+    try:
+        conn.request("GET", parts.path + ("?" + parts.query if parts.query else ""))
+        return conn.getresponse().read()
+    finally:
+        conn.close()
+
+
+@pytest.fixture
+def fake() -> object:
+    srv, url, th = serve_fakes_in_thread()
+    yield srv, url
+    stop_fakes(srv, th)
+
+
+def test_the_worst_row_fits_the_row_size_and_a_limited_view_fits_the_cap(fake: tuple[object, str]) -> None:
+    srv, url = fake
+    with srv.state.lock:
+        for n in range(PORTAL_ROWS_MAX + 50):
+            row = _worst_row(n)
+            srv.state.crm.append(row)
+            srv.state.crm_fields[str(row["lead_id"])] = {"owner_id": "o" * 64, "status": "s" * 32}
+    one = json.dumps(_worst_row(0)).encode()
+    assert len(one) <= PORTAL_VIEW_ROW_BYTES, (len(one), PORTAL_VIEW_ROW_BYTES)
+    assert len(one) > PORTAL_VIEW_ROW_BYTES // 2  # the bound is not wildly loose
+    body = _get(url + "/fake/crm" + portal_demo.LIMIT_QUERY)
+    got = json.loads(body)
+    assert got["count"] == PORTAL_ROWS_MAX + 50 and len(got["rows"]) == PORTAL_ROWS_MAX
+    assert len(got["fields"]) == PORTAL_ROWS_MAX  # fields only for the rows shown
+    assert len(body) <= PORTAL_VIEW_REPLY_MAX_BYTES, (len(body), PORTAL_VIEW_REPLY_MAX_BYTES)
+    assert portal_demo._fetch_json(url + "/fake/crm" + portal_demo.LIMIT_QUERY, 20.0) is not None
+
+
+def test_limit_cuts_only_the_list_never_the_totals(fake: tuple[object, str]) -> None:
+    srv, url = fake
+    with srv.state.lock:
+        for n in range(7):
+            srv.state.outbox.append({"key": f"nudge:{n}" if n % 2 else f"k{n}", "to": "a@example.test", "subject": "s"})
+    whole = json.loads(_get(url + "/fake/outbox"))
+    cut = json.loads(_get(url + "/fake/outbox?limit=3"))
+    assert len(whole["messages"]) == 7 and len(cut["messages"]) == 3
+    assert cut["count"] == whole["count"] == 7 and cut["reminders"] == whole["reminders"]
+    for bad in ("limit=-1", "limit=x", "limit=%C2%B2", "limit=999999999999"):
+        assert len(json.loads(_get(url + "/fake/outbox?" + bad))["messages"]) == 7  # not a valid number: the whole list
+    assert json.loads(_get(url + "/fake/outbox?limit=0"))["messages"] == []
diff --git a/tests/test_r7c_program_helper_rejects.py b/tests/test_r7c_program_helper_rejects.py
new file mode 100644
index 0000000..07e85e3
--- /dev/null
+++ b/tests/test_r7c_program_helper_rejects.py
@@ -0,0 +1,130 @@
+"""Round 7C, finding B: `checked_argv` / `popen_program` refuse what their docstring says they refuse.
+
+Found by the review of r7b: `git -ccore.pager=x` and `--config-env` were accepted, the keywords `executable=` and
+`shell=` were passed through, a path-prefixed look-alike (`/tmp/x/git`) passed on its basename, and the scan "no other
+file starts a program" missed `from subprocess import run`. Rejected samples first, then the allowed shapes."""
+
+from __future__ import annotations
+
+import ast
+import stat
+from pathlib import Path
+
+import pytest
+from support import RefusedProgram, checked_argv, popen_program
+
+HERE = Path(__file__).resolve().parent
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+@pytest.mark.parametrize(
+    "argv",
+    [
+        ["git", "-ccore.pager=x", "log"],
+        ["git", "-c", "core.pager=x", "log"],
+        ["git", "-c", "alias.x=!id", "x"],
+        ["git", "--config-env=core.pager=X", "log"],
+        ["git", "--config-env", "core.pager=X", "log"],
+        ["git", "--exec-path=/" + "tmp/x", "log"],
+        ["git", "-C", ".", "-ccore.sshCommand=id", "fetch"],
+    ],
+)
+def test_git_settings_that_run_a_program_are_refused(argv: list[str]) -> None:
+    with pytest.raises(RefusedProgram):
+        checked_argv(argv)
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+def test_git_user_settings_and_plain_commands_are_allowed() -> None:
+    assert checked_argv(["git", "-c", "user.name=a", "-c", "user.email=a@example.test", "log"])
+    assert checked_argv(["git", "-cuser.name=a", "log"])
+    assert checked_argv(["git", "-C", ".", "status", "--short"])
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+def test_a_path_prefixed_look_alike_of_a_listed_tool_is_refused(tmp_path: Path) -> None:
+    fake = tmp_path / "git"
+    fake.write_text("#!/bin/sh\necho X\n", encoding="utf-8")
+    fake.chmod(fake.stat().st_mode | stat.S_IXUSR)
+    for name in ("git", "true", "ps"):
+        look_alike = tmp_path / name
+        look_alike.write_text("#!/bin/sh\necho X\n", encoding="utf-8")
+        with pytest.raises(RefusedProgram):
+            checked_argv([str(look_alike)])
+    with pytest.raises(RefusedProgram):
+        checked_argv([str(fake), "log"])
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+@pytest.mark.parametrize("keyword", ["executable", "shell", "preexec_fn"])
+def test_keywords_that_start_something_else_are_refused_and_nothing_starts(keyword: str, tmp_path: Path) -> None:
+    marker = tmp_path / "ran"
+    value = {"executable": "/bin/sh", "shell": True, "preexec_fn": lambda: marker.write_text("x")}[keyword]
+    with pytest.raises(RefusedProgram):
+        popen_program(["true", "-c", f"echo X > {marker}"], **{keyword: value})
+    assert not marker.exists()
+
+
+_PROGRAM_START_NAMES = {"run", "Popen", "call", "check_output", "check_call", "getoutput", "getstatusoutput"}
+_OS_START_NAMES = {"system", "popen", "fork", "posix_spawn", "posix_spawnp"}
+
+
+def _starts_a_program(tree: ast.AST) -> list[int]:
+    """Lines that import a start-a-program name (any spelling), call one through `subprocess`, `os` or an alias."""
+    hits: list[int] = []
+    aliases: set[str] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for a in node.names:
+                if a.name == "subprocess" and a.asname:
+                    aliases.add(a.asname)
+                    hits.append(node.lineno)
+        elif isinstance(node, ast.ImportFrom):
+            names = {a.name for a in node.names}
+            if node.module == "subprocess" and names & _PROGRAM_START_NAMES:
+                hits.append(node.lineno)
+            if node.module == "os" and any(n in _OS_START_NAMES or n.startswith(("exec", "spawn")) for n in names):
+                hits.append(node.lineno)
+            if node.module in {"pty", "asyncio.subprocess"} or (
+                node.module == "asyncio" and any(n.startswith("create_sub") for n in names)
+            ):
+                hits.append(node.lineno)
+        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            f = node.func
+            base = f.value.id if isinstance(f.value, ast.Name) else ""
+            if (base in {"subprocess"} | aliases and f.attr in _PROGRAM_START_NAMES) or (
+                base == "os" and (f.attr in _OS_START_NAMES or f.attr.startswith(("exec", "spawn")))
+            ):
+                hits.append(node.lineno)
+    return hits
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+def test_the_scan_notices_every_spelling_of_a_program_start() -> None:
+    for text in (
+        "from subprocess import run",
+        "from subprocess import Popen as P",
+        "import subprocess as sp\nsp.run(['x'])",
+        "import subprocess\nsubprocess.check_output(['x'])",
+        "from os import system",
+        "import os\nos.execv('x', [])",
+    ):
+        assert _starts_a_program(ast.parse(text)), text
+    assert not _starts_a_program(ast.parse("import subprocess\nsubprocess.TimeoutExpired\nx = subprocess.PIPE"))
+
+
+# CONTROL (r7e, with the r7c helper): passes on r7b, a pin; mutant NOT run, the intended one:
+# the helper or scan lets another program start.
+def test_no_other_file_of_tests_starts_a_program_in_any_spelling() -> None:
+    allowed = {"support.py", "test_file_call_guard.py", "test_r7b_program_helper.py", Path(__file__).name}
+    found = []
+    for path in sorted(HERE.glob("*.py")):
+        if path.name in allowed:
+            continue
+        found += [f"{path.name}:{n}" for n in _starts_a_program(ast.parse(path.read_text(encoding="utf-8")))]
+    assert found == [], found
