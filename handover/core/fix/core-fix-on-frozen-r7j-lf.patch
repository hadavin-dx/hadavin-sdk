+        w.start()
+    for w in workers:
+        w.join(30)
+    assert outcomes == [FIXED] * 20  # three timed out, seventeen were refused at once: the same text
+    assert len(calls) == 3 and peak[0] <= 3, (len(calls), peak[0])
+    assert hung_lookups() == 3
