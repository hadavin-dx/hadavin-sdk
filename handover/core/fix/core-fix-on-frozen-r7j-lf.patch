+def listener_answers(url: str, seconds: float) -> bool:
+    """True when something accepts a connection at the address of `url` within `seconds` (looked for about every
+    0.2 s: a desk that is only starting is waited for). Nothing is sent."""
+    parts = urllib.parse.urlsplit(url)
+    host, port = parts.hostname or "", parts.port or (443 if parts.scheme == "https" else 80)
+    end = time.monotonic() + seconds
+    while True:
+        try:
+            with socket.create_connection((host, port), timeout=max(0.2, min(1.0, end - time.monotonic()))):
+                return True
+        except OSError:
+            if time.monotonic() >= end:
+                return False
+            time.sleep(0.2)
