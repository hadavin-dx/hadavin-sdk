index 0000000..60c904a
--- /dev/null
+++ b/tests/test_r7b_program_helper.py
@@ -0,0 +1,213 @@
+"""The one place that starts a program from a test (`support.popen_program`, `run_program`, `checked_argv`).
+
+The S603 ruling: ONE inline marker, on the single start in `popen_program`, and a test that proves the helper refuses a
+command line that is tainted or not a literal list of strings. Here: what is refused (an interpreter given text to run
+with -c, -e, -p or --eval, a module outside this repository with -m, a shell name, an element that is not a plain str,
+a program that is not on the short list), what is allowed, that a refused line starts nothing, and that no other file
+of tests/ starts a program by itself. Made-up data only; nothing here touches a /dev path."""
+
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from support import REPO, RefusedProgram, checked_argv, popen_program, run_program, text_file
+
+PY = sys.executable
+HERE = Path(__file__).resolve().parent
+
+
+def _script(tmp_path: Path) -> str:
+    path = tmp_path / "ok.py"
+    path.write_text("print('hi')\n", encoding="utf-8")
+    return str(path)
+
+
+@pytest.mark.parametrize(
+    "tail",
+    [
+        ["-c", "print(1)"],
+        ["-I", "-c", "print(1)"],
+        ["-Ic", "print(1)"],
+        ["-m", "http.server"],
+        ["-m", "pip"],
+        ["-m", "lead_desk.server; id"],
+        ["-m", ""],
+        ["-m"],
+        ["-X", "dev", "x.py"],
+        ["-W", "ignore", "x.py"],
+        ["--command", "print(1)"],
+        [],
+        ["no_such_script.py"],
+    ],
+    ids=lambda t: " ".join(t) or "nothing",
+)
+def test_python_is_refused_with_text_to_run_a_foreign_module_or_no_script(tail: list[str]) -> None:
+    with pytest.raises(RefusedProgram):
+        checked_argv([PY, *tail])
+
+
+@pytest.mark.parametrize("flag", ["-e", "--eval", "-p", "--print", "-r", "-c"])
+def test_node_and_other_interpreters_are_refused_with_text_to_run(flag: str, tmp_path: Path) -> None:
+    for program in ("node", "perl", "ruby", "php"):
+        with pytest.raises(RefusedProgram):
+            checked_argv([program, flag, "1"])
+    with pytest.raises(RefusedProgram):
+        checked_argv(["node", flag, _script(tmp_path)])
+
+
+@pytest.mark.parametrize("program", ["sh", "bash", "dash", "zsh", "ksh", "cmd", "powershell", "pwsh", "/bin/sh"])
+def test_a_shell_name_is_refused_without_a_script_file(program: str) -> None:
+    for tail in ([], ["-c", "id"], ["-e", "-c", "id"], ["no_such_file.sh"], ["-x"]):
+        with pytest.raises(RefusedProgram):
+            checked_argv([program, *tail])
+
+
+def test_a_shell_is_refused_with_an_option_before_a_real_script(tmp_path: Path) -> None:
+    script = tmp_path / "s.sh"
+    script.write_text("echo hi\n", encoding="utf-8")
+    with pytest.raises(RefusedProgram):
+        checked_argv(["bash", "-x", str(script)])
+    assert checked_argv(["bash", str(script)]) == ["bash", str(script)]
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        "a string, not a list",
+        b"bytes",
+        None,
+        [],
+        (),
+        [PY, 5],
+        [PY, None],
+        [PY, b"x.py"],
+        [PY, Path("x.py")],
+        [Path(PY)],
+        [PY, "a\0b"],
+        ["git", ["nested"]],
+        [object()],
+    ],
+    ids=repr,
+)
+def test_a_command_line_that_is_not_a_literal_list_of_plain_strings_is_refused(bad: object) -> None:
+    with pytest.raises(RefusedProgram):
+        checked_argv(bad)
+
+
+def test_an_element_that_is_a_str_subclass_is_refused() -> None:
+    class Tainted(str):
+        pass
+
+    with pytest.raises(RefusedProgram):
+        checked_argv([PY, Tainted(str(HERE / "support.py"))])
+    with pytest.raises(RefusedProgram):
+        checked_argv([Tainted("git"), "status"])
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        ["curl", "http://127.0.0.1/"],
+        ["rm", "-rf", "x"],
+        ["sudo", "id"],
+        ["env", "id"],
+        ["xargs", "id"],
+        ["/usr/bin/python3-not-ours", "x.py"],
+        ["python3", "x.py"],
+        ["git", "-c", "core.sshCommand=id", "status"],
+        ["git", "-c", "alias.x=!id", "x"],
+        ["unshare", "-n", "-c", "id"],
+        ["unshare", "--mount", "true"],
+        ["unshare", "-n", "sh", "-c", "id"],
+        ["unshare", "-n", "curl", "x"],
+        ["unshare", "-n"],
+    ],
+    ids=lambda x: " ".join(x),
+)
+def test_a_program_that_is_not_on_the_short_list_or_is_given_a_loader_option_is_refused(line: list[str]) -> None:
+    with pytest.raises(RefusedProgram):
+        checked_argv(line)
+
+
+def test_the_shapes_the_tests_use_are_accepted(tmp_path: Path) -> None:
+    script = _script(tmp_path)
+    assert checked_argv([PY, script, "arg"]) == [PY, script, "arg"]
+    assert checked_argv((PY, "-I", script))
+    assert checked_argv([PY, "-m", "lead_desk.server"])
+    assert checked_argv([PY, "-m", "demo_only.fakes_server", "--outbox", "keyed"])
+    assert checked_argv([PY, "-m", "pytest", "-q"])
+    assert checked_argv([PY, text_file("print(1)")])
+    assert checked_argv(["node", text_file("1", ".js"), "x"])
+    assert checked_argv(["git", "-c", "user.name=a", "-c", "user.email=a@example.test", "init"])
+    assert checked_argv(["unshare", "-n", "true"])
+    assert checked_argv(["unshare", "-n", PY, script])
+    assert checked_argv(["ps", "-p", "1", "-o", "stat="])
+
+
+def test_a_refused_line_starts_nothing(tmp_path: Path) -> None:
+    mark = tmp_path / "started"
+    code = f"open({str(mark)!r}, 'w').close()"
+    with pytest.raises(RefusedProgram):
+        popen_program([PY, "-c", code])
+    with pytest.raises(RefusedProgram):
+        run_program([PY, "-c", code], capture_output=True)
+    with pytest.raises(RefusedProgram):
+        run_program(["sh", "-c", f"touch {mark}"], capture_output=True)
+    assert not mark.exists()
+
+
+def test_run_program_runs_a_script_file_and_text_goes_through_a_file(tmp_path: Path) -> None:
+    done = run_program(
+        [PY, text_file("import sys; print('x' + sys.argv[1]); sys.exit(3)"), "q"], capture_output=True, text=True
+    )
+    assert (done.returncode, done.stdout.strip()) == (3, "xq")
+    with pytest.raises(subprocess.CalledProcessError):
+        run_program([PY, text_file("import sys; sys.exit(2)")], capture_output=True, check=True)
+    with pytest.raises(subprocess.TimeoutExpired):
+        run_program([PY, text_file("import time; time.sleep(30)")], timeout=0.5)
+    fed = run_program(
+        [PY, text_file("import sys; print(sys.stdin.read().upper())")], input="abc", capture_output=True, text=True
+    )
+    assert fed.stdout.strip() == "ABC"
+
+
+def test_text_file_is_content_addressed_and_read_back_exactly() -> None:
+    a, b = text_file("print(1)\n"), text_file("print(1)\n")
+    assert a == b and Path(a).read_text(encoding="utf-8") == "print(1)\n"
+    assert text_file("1", ".js").endswith(".js") and text_file("1") != text_file("1", ".js")
+
+
+_START = re.compile(
+    r"\b(?:subprocess\s*\.\s*(?:run|Popen|call|check_output|check_call|getoutput|getstatusoutput)"
+    r"|os\s*\.\s*(?:system|popen|exec\w*|spawn\w*|posix_spawn\w*|fork)"
+    r"|create_subprocess_\w+|pty\s*\.\s*spawn)\b"
+)
+
+
+def test_no_other_file_of_tests_starts_a_program_by_itself() -> None:
+    """Every start goes through the helper; test_file_call_guard.py and this file only name the calls inside text."""
+    found = []
+    for path in sorted(HERE.glob("*.py")):
+        if path.name in {"support.py", "test_file_call_guard.py", "test_r7b_program_helper.py"}:
+            continue
+        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
+            if _START.search(line.split("#", 1)[0]):
+                found.append(f"{path.name}:{number}")
+    assert found == [], found
+
+
+def test_the_helper_line_is_the_only_s603_marker_in_tests() -> None:
+    marker = "noqa: " + "S603"
+    hits = [
+        p.name for p in HERE.glob("*.py") if marker in p.read_text(encoding="utf-8") and p.name != Path(__file__).name
+    ]
+    assert hits == ["support.py"], hits
+    assert (HERE / "support.py").read_text(encoding="utf-8").count(marker) == 1
+
+
+def test_this_repository_paths_exist_for_the_accepted_shapes() -> None:
+    assert (REPO / "src" / "lead_desk").is_dir() and (REPO / "demo_only").is_dir()
diff --git a/tests/test_r7m_new.py b/tests/test_r7m_new.py
new file mode 100644
index 0000000..16e2b8d
--- /dev/null
+++ b/tests/test_r7m_new.py
@@ -0,0 +1,232 @@
+"""REV7M: tests for what the round 7 review found (TLS floor on the real handshake, IMAP deadline against an endless
+run of untagged lines). Real classes, real loopback sockets; look at what the SERVER saw. Made-up data only."""
+
+from __future__ import annotations
+
+import socket
+import ssl
+import threading
+import time
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from demo_only.fake_imap import FakeImap
+from demo_only.fake_smtp_tls import FAKE_PASSWORD, FakeSmtp, make_cert
+from lead_desk.imap_count import ImapCountError, ImapSettings, ImapTotalTimeout, counts_by_key
+from lead_desk.smtp_provider import ProviderSettings, SmtpProviderOutbox
+
+HOST = "localhost"
+INBOXES = ("inbox-a@example.test",)
+
+
+@pytest.fixture
+def cert(tmp_path: Path) -> tuple[Path, Path]:
+    made = make_cert(tmp_path, HOST)
+    if made is None:
+        pytest.skip("the openssl program is not installed, so no test certificate can be made")
+    return made
+
+
+@pytest.fixture
+def pwfile(tmp_path: Path) -> Path:
+    p = tmp_path / "pw.txt"
+    p.write_text(FAKE_PASSWORD + "\n", encoding="utf-8")
+    return p
+
+
+def _old_only(server_ctx: ssl.SSLContext) -> None:
+    """Make a server context that speaks nothing newer than TLS 1.1 (skip when this OpenSSL cannot)."""
+    try:
+        server_ctx.minimum_version = ssl.TLSVersion.TLSv1
+        server_ctx.maximum_version = ssl.TLSVersion.TLSv1_1
+        server_ctx.set_ciphers("ALL:@SECLEVEL=0")
+    except (ValueError, ssl.SSLError):
+        pytest.skip("this OpenSSL cannot make a TLS 1.1 only test server")
+
+
+def _no_floor_client(cafile: Path) -> ssl.SSLContext:
+    """A caller context that checks chain and name, names NO minimum version and lowers the security level: the
+    library's own floor decides, and the security level cannot be read from a context."""
+    c = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
+    c.load_verify_locations(cafile=str(cafile))
+    c.minimum_version = ssl.TLSVersion.MINIMUM_SUPPORTED
+    try:
+        c.set_ciphers("ALL:@SECLEVEL=0")
+    except ssl.SSLError:
+        pytest.skip("this OpenSSL does not accept the security level 0 cipher list")
+    return c
+
+
+@pytest.mark.parametrize("security", ["ssl", "starttls"])
+def test_f1_smtp_login_never_goes_out_over_a_tls_version_below_1_2(
+    cert: tuple[Path, Path], pwfile: Path, security: str
+) -> None:
+    srv = FakeSmtp(cert[0], cert[1], HOST, implicit_tls=security == "ssl")
+    try:
+        _old_only(srv._ctx)
+        s = ProviderSettings(
+            HOST,
+            srv.port,
+            "sender-user",
+            pwfile,
+            "sender@example.test",
+            INBOXES,
+            5,
+            security=security,
+            timeout_seconds=3.0,
+        )
+        box = SmtpProviderOutbox(s, _no_floor_client(cert[0]))
+        with pytest.raises(Exception):  # noqa: B017, PT011  (any refusal; the server log below is the proof)
+            box.send("K-1", "ada@example.test", "Hi", "Body", 3.0)
+        assert "AUTH" not in srv.commands and srv.messages == []
+    finally:
+        srv.close()
+
+
+def test_f1_imap_login_never_goes_out_over_a_tls_version_below_1_2(cert: tuple[Path, Path], pwfile: Path) -> None:
+    srv = FakeImap(cert[0], cert[1], HOST, {"INBOX": ["RUN1-L1"]})
+    try:
+        _old_only(srv._ctx)
+        s = ImapSettings(
+            HOST,
+            srv.user,
+            pwfile,
+            port=srv.port,
+            folders=("INBOX",),
+            timeout_seconds=3.0,
+            ssl_context=_no_floor_client(cert[0]),
+        )
+        with pytest.raises(ImapCountError):
+            counts_by_key(s, "RUN1-")
+        assert srv.login_lines == [] and "LOGIN" not in srv.commands
+    finally:
+        srv.close()
+
+
+class Endless:
+    """A TLS server that logs in and then answers EXAMINE with an endless run of short untagged lines (no literal)."""
+
+    def __init__(self, cert: Path, key: Path) -> None:
+        self.ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        self.ctx.load_cert_chain(str(cert), str(key))
+        self.srv = socket.socket()
+        self.srv.bind(("127.0.0.1", 0))
+        self.srv.listen(4)
+        self.port = int(self.srv.getsockname()[1])
+        self.stop = threading.Event()
+        threading.Thread(target=self._loop, daemon=True).start()
+
+    def _loop(self) -> None:
+        while not self.stop.is_set():
+            try:
+                c, _ = self.srv.accept()
+            except OSError:
+                return
+            threading.Thread(target=self._serve, args=(c,), daemon=True).start()
+
+    def _serve(self, c: socket.socket) -> None:
+        try:
+            f = self.ctx.wrap_socket(c, server_side=True).makefile("rwb", buffering=0)
+            f.write(b"* OK ready\r\n")
+            while not self.stop.is_set():
+                tag, _, rest = f.readline(65536).decode().rstrip("\r\n").partition(" ")
+                word = rest.split(" ", 1)[0].upper()
+                if word == "CAPABILITY":
+                    f.write(f"* CAPABILITY IMAP4rev1\r\n{tag} OK done\r\n".encode())
+                elif word == "LOGIN":
+                    f.write(f"{tag} OK login\r\n".encode())
+                elif word in ("EXAMINE", "SELECT"):
+                    end = time.monotonic() + 8
+                    while not self.stop.is_set() and time.monotonic() < end:
+                        f.write(b"* 1 EXISTS\r\n" * 2000)
+                    return
+                elif not word:
+                    return
+        except (OSError, ssl.SSLError, ValueError):
+            return
+
+    def close(self) -> None:
+        self.stop.set()
+        self.srv.close()
+
+
+@pytest.fixture
+def endless(cert: tuple[Path, Path]) -> Iterator[Endless]:
+    e = Endless(cert[0], cert[1])
+    yield e
+    e.close()
+
+
+def test_f2_an_endless_run_of_untagged_lines_ends_at_the_total_time_limit(
+    cert: tuple[Path, Path], pwfile: Path, endless: Endless
+) -> None:
+    ctx = ssl.create_default_context(cafile=str(cert[0]))
+    s = ImapSettings(
+        HOST,
+        "reader-user",
+        pwfile,
+        port=endless.port,
+        folders=("INBOX",),
+        timeout_seconds=3.0,
+        total_seconds=1.0,
+        ssl_context=ctx,
+    )
+    t0 = time.monotonic()
+    with pytest.raises((ImapTotalTimeout, ImapCountError)):
+        counts_by_key(s, "RUN1-")
+    assert time.monotonic() - t0 < 4.0, "the call ran far past total_seconds"
+
