diff --git a/tests/test_r7b_burst_closed_port.py b/tests/test_r7b_burst_closed_port.py
new file mode 100644
index 0000000..ffccf1c
--- /dev/null
+++ b/tests/test_r7b_burst_closed_port.py
@@ -0,0 +1,64 @@
+"""Round 7B (hostile-driver result 3): `burst --url http://127.0.0.1:<closed port>` ran 30 s with 32 connect attempts
+and no output. Now it looks for a listener for at most BURST_START_LOOK_SECONDS, then ends with ONE line on the error
+output and exit code 3 (the thing it talks to cannot be reached); a listener that appears within that time is used."""
+
+from __future__ import annotations
+
+import socket
+import threading
+import time
+
+import pytest
+from support import HOST, free_port
+
+from lead_desk.constants import BURST_START_LOOK_SECONDS, EXIT_UNREACHABLE
+
+burst = pytest.importorskip("demo_only.burst")
+
+
+def test_a_closed_port_ends_fast_with_one_line_and_exit_3(capsys: pytest.CaptureFixture[str]) -> None:
+    port = free_port()  # nothing listens on it
+    t0 = time.monotonic()
+    code = burst.main(
+        [
+            "--url",
+            f"http://{HOST}:{port}/x",
+            "--n",
+            "5",
+            "--email",
+            "a@example.com",
+            "--ref-prefix",
+            "p",
+            "--source",
+            "form",
+        ]
+    )
+    took = time.monotonic() - t0
+    out = capsys.readouterr()
+    assert code == EXIT_UNREACHABLE, (code, out)
+    assert took < BURST_START_LOOK_SECONDS + 3, f"took {took:.1f} s"
+    assert out.out == "" and out.err.strip().splitlines() == [
+        "ERROR: nothing answers at that address: no request was sent"
+    ]
+
+
+def test_a_listener_that_starts_late_is_waited_for() -> None:
+    port = free_port()
+    srv = socket.socket()
+
+    def later() -> None:
+        time.sleep(1.0)
+        srv.bind((HOST, port))
+        srv.listen(1)
+
+    th = threading.Thread(target=later, daemon=True)
+    th.start()
+    try:
+        assert burst.listener_answers(f"http://{HOST}:{port}/", BURST_START_LOOK_SECONDS)
+    finally:
+        th.join(5)
+        srv.close()
+
+
+def test_the_look_gives_up_when_nothing_ever_listens() -> None:
+    assert burst.listener_answers(f"http://{HOST}:{free_port()}/", 0.5) is False
diff --git a/tests/test_r7b_fake_deep_and_head.py b/tests/test_r7b_fake_deep_and_head.py
new file mode 100644
index 0000000..bc03180
--- /dev/null
+++ b/tests/test_r7b_fake_deep_and_head.py
@@ -0,0 +1,119 @@
+"""Round 7B (lead N1, N2), at the one place every fake server's handler passes through.
+
+N1: a request body that nests about 100,000 levels deep made json.loads raise RecursionError in the fakes: a
+traceback on the error output and NO answer. Now `scripts.http_guard.loads_bounded` turns it into the same ValueError
+as any text that is not JSON, and `AnswersBadRequests` also shields RecursionError: one fixed 400 and no traceback,
+per fake.
+N2: the request line and the headers had no total time limit (the socket timeout restarts with every byte): a sender of
+one byte every few seconds held a handler thread for about 80 seconds. Now ONE timer per request
+(FAKE_HEAD_DEADLINE_SECONDS, shortened here) ends the connection. Each case is a raw request over a loopback socket."""
+
+from __future__ import annotations
+
+import socket
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+import test_r7_fake_slow_senders as slow
+from test_r7_fake_bad_requests import KEY
+from test_r7_fake_slow_senders import _head, _status
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
+import http_guard
+
+import scripts.http_guard as scripts_http_guard
+
+DEPTH = 100_000
+target = slow.target  # the same fixture (one fake per case), reused here
+
+
+def _post(port: int, line: str, auth: bool, body: bytes, extra: str = "") -> bytes:
+    head = _head(line, auth, f"Content-Length: {len(body)}\r\n{extra}")
+    with socket.create_connection(("127.0.0.1", port), timeout=20) as s:
+        s.sendall(head + body)
+        out = b""
+        while chunk := s.recv(4096):
+            out += chunk
+    return out
+
+
+@pytest.mark.parametrize("body", [b"[" * DEPTH, b'{"a":' * DEPTH, b"[" * DEPTH + b"]" * DEPTH])
+def test_a_body_nested_100000_deep_is_one_400_and_no_traceback(
+    target: tuple[int, str, bool], capfd: pytest.CaptureFixture[str], body: bytes
+) -> None:
+    port, line, auth = target
+    out = _post(port, line, auth, body)
+    assert _status(out) == 400, out[:80]
+    assert "Traceback" not in capfd.readouterr().err
+
+
+def test_the_model_fake_answers_a_deep_message_body_too(
+    target: tuple[int, str, bool], capfd: pytest.CaptureFixture[str]
+) -> None:
+    port, line, _ = target
+    if line != "POST /control":
+        pytest.skip("only the model fake has /v1/messages")
+    out = _post(port, "POST /v1/messages", False, b"[" * DEPTH, extra=f"x-api-key: {KEY}\r\n")
+    assert 200 <= _status(out) < 500, out[:80]
+    assert "Traceback" not in capfd.readouterr().err
+
+
+def test_loads_bounded_refuses_deep_text_like_any_other_bad_json() -> None:
+    for module in (http_guard, scripts_http_guard):
+        with pytest.raises(ValueError):
+            module.loads_bounded(b"[" * DEPTH)
+        assert module.loads_bounded(b'{"a": [1, 2]}') == {"a": [1, 2]}
+
+
+@pytest.mark.parametrize("pause", [1.0, 0.3])  # one byte per second (the lead's case), and a faster drip
+def test_a_header_drip_is_cut_off_at_the_head_deadline(
+    target: tuple[int, str, bool], monkeypatch: pytest.MonkeyPatch, pause: float
+) -> None:
+    for module in (http_guard, scripts_http_guard):
+        monkeypatch.setattr(module, "FAKE_HEAD_DEADLINE_SECONDS", 2.0)
+    port, line, auth = target
+    head = _head(line, auth, "Content-Length: 2\r\n")[:-2] + b"X-Slow: "  # an unfinished header line, then a drip
+    t0 = time.monotonic()
+    closed_after: list[float] = []
+
+    def drip(s: socket.socket) -> None:
+        try:
+            for ch in head + b"a" * 200:  # one byte per `pause` seconds, each well inside the socket timeout
+                s.sendall(bytes([ch]))
+                time.sleep(pause)
+        except OSError:
+            pass
+
+    with socket.create_connection(("127.0.0.1", port), timeout=15) as s:
+        th = threading.Thread(target=drip, args=(s,), daemon=True)
+        th.start()
+        try:
+            while True:
+                data = s.recv(4096)
+                if not data:
+                    break
+        except OSError:
+            pass
+        closed_after.append(time.monotonic() - t0)
+    assert closed_after[0] < 5.0, f"the server held the connection for {closed_after[0]:.1f} s"
+
+
+def test_a_normal_request_after_the_head_is_read_is_not_cut(
+    target: tuple[int, str, bool], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The timer ends when the headers are read: a slow ANSWER or a body inside its own deadline is not cut."""
+    for module in (http_guard, scripts_http_guard):
+        monkeypatch.setattr(module, "FAKE_HEAD_DEADLINE_SECONDS", 1.0)
+    port, line, auth = target
+    head = _head(line, auth, "Content-Length: 2\r\n")
+    with socket.create_connection(("127.0.0.1", port), timeout=15) as s:
+        s.sendall(head)
+        time.sleep(1.8)  # longer than the head deadline: the head is complete, the body is on its own deadline
+        s.sendall(b"{}")
+        out = b""
+        while chunk := s.recv(4096):
+            out += chunk
+    assert 200 <= _status(out) < 500, out[:80]
diff --git a/tests/test_r7b_guard_replant.py b/tests/test_r7b_guard_replant.py
new file mode 100644
index 0000000..5ca2ce2
--- /dev/null
+++ b/tests/test_r7b_guard_replant.py
@@ -0,0 +1,129 @@
+"""Round 7B (review part 2, M3): the file-and-socket call guard misses names it did not list: name lookups
+(getaddrinfo, gethostbyname), the event loop's own socket calls (sock_connect), a pool made from a context (ctx.Pool),
+a name given to getattr as a text, and a TLS context made by name (ssl.SSLContext). The shapes are planted again
+here, in a lot of spellings (module name, alias, `from` import, a method of any object, a `getattr` with the name as
+text), and EVERY one must be found. The count is printed with -s (and pinned: a shape taken out is a failure)."""
+
+from __future__ import annotations
+
+import pytest
+from test_file_call_guard import _plant, _problems
+
+MODULE_FUNCTIONS = {
+    "socket": [
+        "getaddrinfo",
+        "gethostbyname",
+        "gethostbyname_ex",
+        "gethostbyaddr",
+        "getnameinfo",
+        "getfqdn",
+        "create_connection",
+        "create_server",
+        "fromfd",
+        "socketpair",
+    ],
+    "ssl": ["wrap_socket", "get_server_certificate"],
+    "multiprocessing.pool": ["ThreadPool", "Pool"],
+    "multiprocessing.dummy": ["Pool"],
+}
+OBJECT_METHODS = [
+    "Pool",
+    "ThreadPool",
+    "sock_connect",
+    "sock_recv",
+    "sock_recv_into",
+    "sock_sendall",
+    "sock_accept",
+    "getaddrinfo",
+    "getnameinfo",
+    "gethostbyname",
+    "create_connection",
+    "create_server",
+    "create_datagram_endpoint",
+    "create_unix_connection",
+    "create_unix_server",
+    "connect_read_pipe",
+    "connect_write_pipe",
+    "add_reader",
+    "add_writer",
+    "wrap_socket",
+]
+LITERAL_NAMES = [
+    "open",
+    "read_text",
+    "read_bytes",
+    "write_text",
+    "write_bytes",
+    "system",
+    "popen",
+    "Popen",
+    "listdir",
+    "scandir",
+    "walk",
+    "unlink",
+    "mkdir",
+    "chmod",
+    "glob",
+    "rglob",
+    "iterdir",
+    "touch",
+    "eval",
+    "exec",
+    "compile",
+    "__import__",
+    "input",
+    "breakpoint",
+]
+
+
+def shapes() -> dict[str, str]:
+    out: dict[str, str] = {}
+    for mod, names in MODULE_FUNCTIONS.items():
+        for n in names:
+            out[f"{mod}.{n} by module name"] = f"import {mod}\n{mod}.{n}()"
+            out[f"{mod}.{n} by from-import alias"] = f"from {mod} import {n} as _f\n_f()"
+    for n in OBJECT_METHODS:
+        out[f"x.{n}(...) on any object"] = f"def f(x):\n    return x.{n}(1)"
+        out[f"loop.{n}(...) on the running loop"] = f"import asyncio\nasyncio.get_running_loop().{n}(1)"
+        out[f"await loop.{n}(...)"] = f"async def f(loop):\n    await loop.{n}(1)"
+    for n in LITERAL_NAMES:
+        out[f"getattr(o, {n!r})"] = f"def f(o):\n    return getattr(o, {n!r})"
+        out[f"getattr(os, {n!r}) called"] = f"import os\ngetattr(os, {n!r})('x')"
+    out["ssl.SSLContext(...)"] = "import ssl\nssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)"
+    out["SSLContext from-import alias"] = "from ssl import SSLContext as C\nC(1)"
+    out["ssl alias SSLContext"] = "import ssl as s\ns.SSLContext()"
+    out["ssl.SSLContext handed on as a value"] = "import ssl\nmake = ssl.SSLContext\nmake(1)"
+    out["setattr with a literal name"] = "def f(o, v):\n    setattr(o, 'open', v)"
+    out["hasattr with a literal name"] = "def f(o):\n    return hasattr(o, 'open')"
+    out["delattr with a literal name"] = "def f(o):\n    delattr(o, 'open')"
+    return out
+
+
+ALL = shapes()
+
+
+def test_the_count_of_replanted_shapes_is_pinned() -> None:
+    assert len(ALL) >= 140, len(ALL)
+    assert len(ALL) == 145, len(ALL)  # a shape taken out of the list shows here
+
+
+def test_every_replanted_shape_is_found(
+    tmp_path_factory: pytest.TempPathFactory, capsys: pytest.CaptureFixture[str]
+) -> None:
+    missed = []
+    for shape, source in ALL.items():
+        root = _plant(tmp_path_factory.mktemp("r7b"), source)
+        if not [p for p in _problems(root, {}, {}) if p.startswith("scripts/planted.py")]:
+            missed.append(shape)
+    with capsys.disabled():
+        print(f"\nREPLANT: {len(ALL) - len(missed)} of {len(ALL)} shapes found; missed: {missed}")
+    assert not missed, f"the guard did not find: {missed}"
+
+
+def test_a_type_name_in_a_signature_is_no_call(tmp_path_factory: pytest.TempPathFactory) -> None:
+    for source in (
+        "import ssl\ndef f(c: ssl.SSLContext | None = None) -> ssl.SSLContext:\n    return c",
+        "from ssl import SSLContext\nx: SSLContext | None = None",
+    ):
+        root = _plant(tmp_path_factory.mktemp("r7bn"), source)
+        assert [p for p in _problems(root, {}, {}) if p.startswith("scripts/planted.py")] == [], source
