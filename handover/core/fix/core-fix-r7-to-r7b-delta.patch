+def loads_bounded(raw: bytes | str) -> Any:
+    """json.loads for a request body: text that nests too deeply (a list of lists of ... 100,000 deep) raises ValueError
+    like any other text that is not JSON, never RecursionError (which the handlers did not expect: a traceback and no
+    answer). The ONE parse call of the fake servers."""
+    try:
