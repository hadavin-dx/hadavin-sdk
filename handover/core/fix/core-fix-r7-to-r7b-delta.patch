+    name = hashlib.sha256(text.encode("utf-8")).hexdigest()[:20] + suffix
+    path = Path(_TEXT_DIR[0]) / name
+    if not path.exists():
+        path.write_text(text, encoding="utf-8", newline="\n")
+    return str(path)
